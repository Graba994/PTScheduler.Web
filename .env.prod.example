# ── PTScheduler Production Environment ──────────────────────────────
# Copy to .env.prod and fill in your values:
#   cp .env.prod.example .env.prod
#
# Then deploy:
#   docker compose -f docker-compose.prod.yml up -d
#   docker compose -f docker-compose.prod.yml --profile build up --build tenant-image

# ── Portal Database ─────────────────────────────────────────────────
PORTAL_DB_NAME=ptportal
PORTAL_DB_USER=ptportal
PORTAL_DB_PASSWORD=CHANGE_ME_strong_password_here

# ── Portal ──────────────────────────────────────────────────────────
PORTAL_PORT=8081
# IP or hostname that tenant containers can reach the host on.
# On Linux: use the server's LAN IP (e.g. 192.168.1.100)
# On Docker Desktop: use host.docker.internal
FORWARD_HOST=192.168.1.100

# Path to the cloned repo on the host (for git pull + rebuild)
REPO_DIR=/opt/ptscheduler/repo

CONTACT_EMAIL=kontakt@ptscheduler.pl
SITE_NAME=PTScheduler

# Build metadata (set automatically by CI, or manually)
BUILD_COMMIT=unknown
BUILD_TIME=unknown
BUILD_BRANCH=main

# ── Nginx Proxy Manager (optional — auto-register tenant subdomains)
# NPM_URL=http://192.168.1.100:81
# NPM_USER=admin@example.com
# NPM_PASSWORD=changeme

# ── Stripe Billing (optional) ──────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Email / SMTP (optional) ────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=app_password_here
# SMTP_FROM=noreply@ptscheduler.pl
