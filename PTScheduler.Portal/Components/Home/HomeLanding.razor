    private static readonly (string Image, string Label)[] _clientScreens =
    [
        ("klient-start", "Start"), ("klient-trening", "Trening"), ("klient-postepy", "Postępy"), ("klient-medale", "Medale"),
        ("klient-statystyki", "Statystyki"), ("klient-pakiety", "Pakiety"), ("klient-pomiary", "Pomiary"),
    ];

    private RenderFragment DayMedia(DayStep step, bool stage) => __builder =>
    {
        <HomeScene Name="@step.Scene" Alt="@step.Alt" AssistantName="@_look.Name" Mascot="@Mascot" />
    };

    /// <summary>Na stronie: oczy za kursorem, sztuczki i reakcja na najechanie (o ile włączone w Panelu).</summary>
    private string PageFx => string.Join(",", _look.Effects.Split(',').Where(e => e is "look" or "tricks" or "hover"));

    /// <summary>Maskotka asystenta: animowany SVG (wbudowane ikony, animacja „Żywy”) albo ikona nastroju z Panelu.</summary>
    private RenderFragment Mascot(string mood) => __builder =>
    {
        if (_look.AnimatedSvg is { } svg)
        {
            <span class="hm-fx" data-hm-motion="@_look.Motion" data-hm-fx="@PageFx"><span class="hm-live st-idle md-@mood">@((MarkupString)svg)</span></span>
        }
        else
        {
            <img class="hm-anim-@_look.Animation" src="@_look.IconUrl(mood)" alt="" loading="lazy" />
        }
    };

    /// <summary>Publiczne demo włączone w Panelu (przycisk „Wypróbuj demo” → /demo).</summary>
    private bool DemoOn => _s(SiteSettingsService.Keys.DemoEnabled) == "true";

    /// <summary>Własny tytuł z Panelu (gdy ktoś go zmienił) — inaczej tytuł tego szablonu.</summary>
    private string? CustomTitle =>
        _settings.TryGetValue(SiteSettingsService.Keys.HeroTitle, out var t) && !string.IsNullOrWhiteSpace(t) && t != SiteSettingsService.DefaultHeroTitle ? t : null;

    private string HeroSubtitle
    {
        get
        {
            var custom = _s(SiteSettingsService.Keys.HeroSubtitle, "");
            const string oldDefault = "Grafik i rezerwacje online, karnety, płatności, czat z klientem i plany treningowe — w jednej aplikacji pod Twoją marką. Klienci instalują ją na telefonie jak zwykłą apkę.";
            return string.IsNullOrWhiteSpace(custom) || custom == oldDefault
                ? $"Grafik i zapisy online, płatności, plany treningowe i aplikacja dla Twoich klientów — wszystko pod Twoją marką. A asystent AI {_look.Name} codziennie mówi, kto czeka, kto zalega i kto może odejść."
                : custom;
        }
    }

    private static string PricePeriod(Plan plan) =>
        plan.MonthlyPrice == 0 ? $"{plan.TrialDays} dni za darmo"
        : plan.YearlyPrice is > 0 ? $"lub {plan.YearlyPrice:0} zł rocznie" + (plan.TrialDays > 0 ? $" · {plan.TrialDays} dni za darmo" : "")
        : plan.TrialDays > 0 ? $"{plan.TrialDays} dni za darmo na start" : "";

    private static string Initials(string author) =>
        string.Concat(author.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetter(w[0])).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    /// <summary>Po „Wyślij mi link”: /?link=wyslany (albo =blad) — komunikat zamiast formularza.</summary>
    [SupplyParameterFromQuery(Name = "link")] public string? LinkSent { get; set; }

    private string _s(string key, string fallback = "") =>
        _settings.TryGetValue(key, out var val) && !string.IsNullOrWhiteSpace(val) ? val : fallback;

    protected override async Task OnInitializedAsync()
    {
        try { _look = await Assistant.GetPublicLookAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or Npgsql.NpgsqlException) { } // strona działa też bez ustawień asystenta

        _settings = await Settings.GetAllAsync(
            SiteSettingsService.Keys.HeroTitle, SiteSettingsService.Keys.HeroSubtitle, SiteSettingsService.Keys.HeroCta,
            SiteSettingsService.Keys.HeroCtaUrl, SiteSettingsService.Keys.CtaTitle, SiteSettingsService.Keys.CtaSubtitle,
            SiteSettingsService.Keys.CtaButton, SiteSettingsService.Keys.DemoEnabled, SiteSettingsService.Keys.GarminEnabled);
        _garmin = _settings.GetValueOrDefault(SiteSettingsService.Keys.GarminEnabled) == "true";

        await using var db = DbFactory.CreateDbContext();
        _reviews = await db.AppFeedbacks.AsNoTracking()
            .Where(f => f.ShowOnHomepage && f.Text != null && f.Text != "")
            .OrderByDescending(f => f.Rating).ThenByDescending(f => f.CreatedAt)
            .Take(6).ToListAsync();
        _plans = await db.Plans.AsNoTracking().Where(p => p.IsActive).OrderBy(p => p.SortOrder).ToListAsync();
        _activeTrainers = await db.Tenants.CountAsync(t => t.Status == TenantStatus.Active);
    }
}
