@inject SiteSettingsService Settings
@inject IDbContextFactory<PortalDbContext> DbFactory
@inject AssistantService Assistant

@* Szablon „Nowa” strony głównej: sprzedażowa strona na prawdziwych ekranach i nagraniach z aplikacji
   (wwwroot/img/lp — zrzuty z danych demo „Pełny grafik”). Zachowanie: landing.js, wygląd: landing.css. *@
<PageTitle>Hantly — aplikacja dla trenerów personalnych z asystentem AI</PageTitle>
<HeadContent>
    <meta name="description" content="Grafik i zapisy online, płatności, plany treningowe i aplikacja dla klientów pod Twoją marką. Asystent AI mówi, kto czeka, kto zalega i kto może odejść. Zacznij za darmo." />
    <link rel="preload" as="image" href="/img/lp/trener-pulpit.webp" />
</HeadContent>

<div class="ld">

<!-- HERO -->
<section class="ld-hero">
    <div class="lp-container ld-hero-grid">
        <div class="ld-hero-copy">
            <a href="#ai" class="ld-pill">
                <span class="ld-pill-mascot">@Mascot("hello")</span>
                <span><b>Nowość:</b> @_look.Name — asystent AI, który pilnuje Twojego biznesu</span>
                <i class="bi bi-arrow-right"></i>
            </a>
            @if (CustomTitle is { } title)
            {
                <h1>@title</h1>
            }
            else
            {
                <h1>Ty prowadzisz treningi.<br /><span class="ld-under">Hantly prowadzi resztę.</span></h1>
            }
            <p class="ld-sub">@HeroSubtitle</p>
            <div class="ld-ctas">
                <a href="@_s("hero_cta_url", "/register")" class="lp-btn lp-btn-energy"><i class="bi bi-rocket-takeoff"></i>@_s("hero_cta", "Zbuduj swoją aplikację")</a>
                <a href="#dzien" class="lp-btn lp-btn-ghost"><i class="bi bi-play-circle"></i>Zobacz ją w akcji</a>
            </div>
            <ul class="ld-trust">
                <li><i class="bi bi-check-circle-fill"></i>Okres próbny za 0 zł</li>
                <li><i class="bi bi-check-circle-fill"></i>Bez umowy i wypowiedzenia</li>
                <li><i class="bi bi-check-circle-fill"></i>Klienci nic nie instalują ze sklepu</li>
                <li><i class="bi bi-check-circle-fill"></i>Dane na serwerach w Europie</li>
            </ul>
        </div>

        <div class="ld-hero-stage">
            <figure class="ld-browser ld-hero-laptop">
                <div class="ld-browser-bar" aria-hidden="true"><b></b><b></b><b></b><span>jan-kowalski.hantly.pl/app</span></div>
                <img src="/img/lp/trener-pulpit.webp" width="1600" height="1000" alt="Pulpit trenera w Hantly: karta „Na dziś od Hantly” z podpowiedziami, liczba sesji w tygodniu i wizyty na dziś" fetchpriority="high" />
            </figure>
            <figure class="ld-phone ld-hero-phone">
                <video data-ld-video muted loop playsinline preload="none" poster="/img/lp/film-klient-trening.webp" aria-label="Nagranie: klient odhacza serie w aplikacji i dostaje podsumowanie treningu z rekordem">
                    <source src="/img/lp/film-klient-trening.mp4" type="video/mp4" />
                    <source src="/img/lp/film-klient-trening.webm" type="video/webm" />
                </video>
            </figure>
            <div class="ld-toast ld-toast-1" aria-hidden="true"><span class="ld-toast-ic mint"><i class="bi bi-trophy-fill"></i></span><span><b>Nowy rekord klienta</b>Wiosłowanie hantlami — 29 kg</span></div>
            <div class="ld-toast ld-toast-2" aria-hidden="true"><span class="ld-toast-ic violet"><i class="bi bi-cash-coin"></i></span><span><b>Wpłata odhaczona</b>150 zł · gotówka</span></div>
            <div class="ld-toast ld-toast-3" aria-hidden="true"><span class="ld-toast-ic energy"><i class="bi bi-stars"></i></span><span><b>@_look.Name</b>3 osoby zwykle trenują o 16:00 — zaprosić?</span></div>
        </div>
    </div>

    <div class="lp-container">
        <ul class="ld-facts">
            @if (_activeTrainers >= 20)
            {
                <li><b data-ld-count="@_activeTrainers">@_activeTrainers</b><span>trenerów już pracuje z Hantly</span></li>
            }
            else
            {
                <li><b>1</b><span>aplikacja zamiast Excela, WhatsAppa i zeszytu</span></li>
            }
            <li><b>0 zł</b><span>prowizji od płatności Twoich klientów</span></li>
            <li><b>24/7</b><span>klienci zapisują się i płacą sami</span></li>
            <li><b>5 min</b><span>do pierwszego zaproszenia klienta</span></li>
        </ul>
    </div>
</section>

<!-- PROBLEM → ROZWIĄZANIE -->
<section class="ld-section" id="problem">
    <div class="lp-container">
        <div class="ld-head">
            <div class="lp-eyebrow">Brzmi znajomo?</div>
            <h2>Każda z tych rzeczy zabiera czas, za który nikt Ci nie płaci</h2>
        </div>
        <div class="ld-pains">
            @foreach (var p in _pains)
            {
                <article class="ld-pain" data-ld-reveal>
                    <span class="ld-pain-ic"><i class="bi @p.Icon"></i></span>
                    <p class="ld-pain-before"><s>@p.Before</s></p>
                    <p class="ld-pain-after"><i class="bi bi-arrow-return-right"></i>@p.After</p>
                </article>
            }
        </div>
    </div>
</section>

<!-- DZIEŃ Z HANTLY: prawdziwe ekrany, przewijana oś dnia -->
<section class="ld-day" id="dzien" aria-labelledby="ld-day-title">
    <div class="lp-container">
        <div class="ld-head ld-head-dark">
            <div class="lp-eyebrow">Jeden dzień z Hantly</div>
            <h2 id="ld-day-title">Tak wygląda Twój dzień, kiedy aplikacja pracuje razem z Tobą</h2>
            <p>Prawdziwe ekrany i nagrania z aplikacji trenera — bez makiet. Dane pochodzą z konta pokazowego.</p>
        </div>
        <div class="ld-day-grid" data-ld-story>
            <ol class="ld-steps">
                @for (var i = 0; i < _day.Length; i++)
                {
                    var step = _day[i];
                    <li class="ld-step @(i == 0 ? "is-active" : "")" data-ld-step="@i">
                        <div class="ld-step-time" aria-hidden="true"><i class="bi @step.Icon"></i></div>
                        <h3><span class="ld-step-clock">@step.Time</span>@step.Title</h3>
                        <p>@step.Text</p>
                        <div class="ld-step-media">@DayMedia(step, false)</div>
                    </li>
                }
            </ol>
            <div class="ld-stage" aria-hidden="true">
                <div class="ld-stage-inner">
                    @for (var i = 0; i < _day.Length; i++)
                    {
                        <div class="ld-stage-item @(i == 0 ? "is-active" : "")" data-ld-stage="@i">@DayMedia(_day[i], true)</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FUNKCJE: zakładki z prawdziwymi ekranami -->
<section class="ld-section" id="funkcje">
    <div class="lp-container">
        <div class="ld-head">
            <div class="lp-eyebrow">Funkcje</div>
            <h2>Wszystko, czego potrzebuje trener — w jednej aplikacji</h2>
            <p>Grafik, klienci, plany, pieniądze i statystyki rozmawiają ze sobą. Nic nie przepisujesz dwa razy.</p>
        </div>
        <div class="ld-tabs" data-ld-tabs>
            <div class="ld-tablist" role="tablist" aria-label="Funkcje aplikacji">
                @for (var i = 0; i < _features.Length; i++)
                {
                    var f = _features[i];
                    <button type="button" role="tab" id="@($"ld-tab-{i}")" aria-controls="@($"ld-panel-{i}")" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? 0 : -1)" class="ld-tab">
                        <i class="bi @f.Icon"></i>@f.Name
                    </button>
                }
            </div>
            @for (var i = 0; i < _features.Length; i++)
            {
                var f = _features[i];
                <div class="ld-panel" role="tabpanel" id="@($"ld-panel-{i}")" aria-labelledby="@($"ld-tab-{i}")" hidden="@(i != 0)">
                    <div class="ld-panel-copy">
                        <h3>@f.Title</h3>
                        <ul>
                            @foreach (var point in f.Points)
                            {
                                <li><i class="bi bi-check2"></i>@point</li>
                            }
                        </ul>
                    </div>
                    <figure class="ld-browser">
                        <div class="ld-browser-bar" aria-hidden="true"><b></b><b></b><b></b><span>@($"jan-kowalski.hantly.pl{f.Path}")</span></div>
                        <img src="@($"/img/lp/{f.Image}.webp")" width="1600" height="1000" alt="@f.Alt" loading="lazy" />
                    </figure>
                </div>
            }
        </div>
    </div>
</section>

<!-- ASYSTENT AI -->
<section class="ld-ai" id="ai" aria-labelledby="ld-ai-title">
    <div class="lp-container ld-ai-grid">
        <div class="ld-ai-copy">
            <div class="ld-ai-who">
                <span class="ld-ai-mascot">@Mascot("think")</span>
                <div class="lp-eyebrow">Asystent AI w Twojej aplikacji</div>
            </div>
            <h2 id="ld-ai-title">@_look.Name mówi Ci, co jest ważne dziś. <span class="ld-grad">Zanim o to zapytasz.</span></h2>
            <p>Asystent sam przegląda grafik, płatności, ankiety i treningi klientów. Każda podpowiedź ma przycisk, który od razu prowadzi do działania. Tak to wygląda na pulpicie trenera:</p>
            <figure class="ld-card-shot">
                <img src="/img/lp/zoom-hantly.webp" width="1392" height="666" alt="Karta „Na dziś od Hantly” na pulpicie trenera: rezerwacje do akceptacji, kończące się pakiety, zaległości i wolne okienko — każda z przyciskiem" loading="lazy" />
            </figure>
            <ul class="ld-ai-trust">
                <li><i class="bi bi-calculator"></i><span><b>AI nie zmyśla liczb.</b> Liczy je aplikacja, a każda liczba w tekście jest sprawdzana.</span></li>
                <li><i class="bi bi-incognito"></i><span><b>Imiona klientów zostają u Ciebie.</b> Do AI trafiają same liczby i fakty.</span></li>
                <li><i class="bi bi-hand-index-thumb"></i><span><b>AI podpowiada, Ty decydujesz.</b> Wszystko działa też bez AI — wyciszysz je jednym kliknięciem.</span></li>
            </ul>
        </div>
        <div class="ld-ai-media">
            <figure class="ld-browser" data-ld-reveal>
                <div class="ld-browser-bar" aria-hidden="true"><b></b><b></b><b></b><span>jan-kowalski.hantly.pl/trainer/retencja</span></div>
                <img src="/img/lp/trener-retencja.webp" width="1600" height="1000" alt="Ekran „Klienci, którzy mogą odejść”: ryzyko, powody i przycisk Napisz" loading="lazy" />
            </figure>
            <figure class="ld-browser ld-ai-media-2" data-ld-reveal>
                <div class="ld-browser-bar" aria-hidden="true"><b></b><b></b><b></b><span>jan-kowalski.hantly.pl/stats/business</span></div>
                <img src="/img/lp/trener-biznes.webp" width="1600" height="1000" alt="Statystyki biznesu: „Co się zmieniło” w trzech zdaniach, retencja i prognoza przychodu" loading="lazy" />
            </figure>
        </div>
    </div>
</section>

<!-- APLIKACJA KLIENTA -->
<section class="ld-section ld-client" id="klienci">
    <div class="lp-container ld-client-grid">
        <figure class="ld-phone ld-client-phone">
            <video data-ld-video muted loop playsinline preload="none" poster="/img/lp/film-klient-aplikacja.webp" aria-label="Nagranie: aplikacja klienta — start, medale i postępy">
                <source src="/img/lp/film-klient-aplikacja.mp4" type="video/mp4" />
                <source src="/img/lp/film-klient-aplikacja.webm" type="video/webm" />
            </video>
        </figure>
        <div class="ld-client-copy">
            <div class="lp-eyebrow">Aplikacja dla Twoich klientów</div>
            <h2>Klienci dostają aplikację z Twoim logo. I naprawdę do niej wracają.</h2>
            <ul class="ld-checks">
                <li><i class="bi bi-phone"></i><span><b>Bez sklepu z aplikacjami.</b> Link w SMS-ie, ikona na ekranie telefonu, powiadomienia — jak zwykła aplikacja.</span></li>
                <li><i class="bi bi-clipboard2-pulse"></i><span><b>Plan na dziś w kieszeni.</b> Ciężary z poprzedniego razu, filmy ćwiczeń, odhaczanie serii także bez internetu.</span></li>
                <li><i class="bi bi-trophy"></i><span><b>Motywacja, która przychodzi sama.</b> Rekordy po treningu, medale za regularność i podsumowanie „Twój miesiąc”.</span></li>
                <li><i class="bi bi-wallet2"></i><span><b>Rezerwacje i płatności w jednym miejscu.</b> Pakiety, karnety, BLIK i karta — klient wie, ile treningów mu zostało.</span></li>
            </ul>
        </div>
    </div>
    <div class="ld-screens" aria-label="Ekrany aplikacji klienta">
        <div class="ld-screens-track">
            @foreach (var copy in new[] { false, true })
            {
                @foreach (var (img, label) in _clientScreens)
                {
                    <figure class="ld-screen" aria-hidden="@(copy ? "true" : null)">
                        <img src="@($"/img/lp/{img}.webp")" width="720" height="1558" alt="@(copy ? "" : label)" loading="lazy" />
                        <figcaption>@label</figcaption>
                    </figure>
                }
            }
        </div>
    </div>
</section>

<!-- TWOJA MARKA: szablony stron -->
<section class="lp-section lp-section-alt" id="szablony">
    <div class="lp-container">
        <div class="ld-head">
            <div class="lp-eyebrow">Twoja marka, Twoja strona</div>
            <h2>Strona, która sprzedaje treningi za Ciebie</h2>
            <p>Wybierz szablon — oferta, opinie, wolne terminy i przycisk „Umów trening” pokazują się same, prosto z aplikacji. Najedź na podgląd (albo go dotknij), żeby przewinąć stronę.</p>
        </div>
        <div class="lp-tpls">
            @foreach (var t in HomeShared.Templates.Take(6))
            {
                <figure class="lp-tpl" tabindex="0">
                    <div class="lp-tpl-frame">
                        <div class="lp-tpl-bar"><b></b><b></b><b></b><span>@t.Url</span></div>
                        <div class="lp-tpl-shot">
                            <img src="@($"/img/templates/{t.Key}.jpg")" alt="@($"Szablon strony: {t.Name}")" loading="lazy" width="1280" height="3400" />
                        </div>
                    </div>
                    <figcaption>
                        <span class="lp-tpl-sw" style="--a:@t.Accent;--b:@t.Bg"></span>
                        <span><b>@t.Name</b><small>@t.For</small></span>
                    </figcaption>
                </figure>
            }
        </div>
        <p class="lp-tpls-more"><i class="bi bi-grid-1x2"></i>18 szablonów, 16 motywów kolorów i 16 widgetów, własne logo — a od planu Starter także własna domena z certyfikatem HTTPS.</p>
    </div>
</section>

@if (_reviews.Count > 0)
{
    <!-- OPINIE (tylko prawdziwe, z Panelu) -->
    <section class="ld-section" id="opinie">
        <div class="lp-container">
            <div class="ld-head">
                <div class="lp-eyebrow">Opinie trenerów</div>
                <h2>Co mówią trenerzy, którzy już pracują z Hantly</h2>
                <p><span class="lp-stars">★★★★★</span> średnio @_reviews.Average(r => r.Rating).ToString("0.0", Pl) z @_reviews.Count opinii w aplikacji</p>
            </div>
            <div class="lp-reviews-grid">
                @foreach (var f in _reviews.Take(6))
                {
                    var author = string.IsNullOrWhiteSpace(f.PublicAuthor) ? "Trener Hantly" : f.PublicAuthor;
                    <figure class="lp-review">
                        <div class="lp-stars" aria-label="@($"{f.Rating} na 5")">@(new string('★', f.Rating))<span class="off">@(new string('★', 5 - f.Rating))</span></div>
                        <blockquote>„@f.Text”</blockquote>
                        <figcaption><span class="lp-review-avatar">@Initials(author)</span>@author</figcaption>
                    </figure>
                }
            </div>
        </div>
    </section>
}

<!-- JAK ZACZĄĆ -->
<section class="ld-section ld-start">
    <div class="lp-container">
        <div class="ld-head">
            <div class="lp-eyebrow">Jak zacząć</div>
            <h2>Pierwszego klienta zaprosisz jeszcze dziś</h2>
        </div>
        <ol class="ld-howto">
            <li data-ld-reveal><span class="ld-howto-n">1</span><h3>Zbuduj aplikację</h3><p>Nazwa, specjalizacja, kolory i oferta. Kreator pokazuje podgląd na żywo — publikujesz jednym kliknięciem.</p></li>
            <li data-ld-reveal><span class="ld-howto-n">2</span><h3>Ustaw swoje zasady</h3><p>Godziny pracy, rodzaje treningów, pakiety i zasady odwołań. Klientów zaimportujesz z pliku.</p></li>
            <li data-ld-reveal><span class="ld-howto-n">3</span><h3>Wyślij link klientom</h3><p>Rezerwują, płacą i trenują w Twojej aplikacji. Ty widzisz wszystko w jednym grafiku.</p></li>
        </ol>
        <div class="ld-center"><a href="/register" class="lp-btn lp-btn-primary"><i class="bi bi-play-fill"></i>Zaczynam — krok 1</a></div>
    </div>
</section>

<!-- CENNIK -->
<section class="lp-section lp-section-alt" id="cennik">
    <div class="lp-container">
        <div class="ld-head">
            <div class="lp-eyebrow">Cennik</div>
            <h2>Płacisz za to, czego używasz. Bez umów.</h2>
            <p>Zacznij za darmo i przejdź na wyższy plan, gdy przybędzie klientów. Zmiana planu zajmuje minutę.</p>
        </div>
        <div class="lp-pricing">
            @foreach (var plan in _plans)
            {
                <div class="lp-price @(plan.IsFeatured ? "featured" : "")">
                    @if (plan.IsFeatured)
                    {
                        <div class="lp-price-badge">Najczęściej wybierany</div>
                    }
                    <h3>@plan.Name</h3>
                    <p class="lp-price-desc">@plan.Description</p>
                    <div class="lp-price-amount">@plan.MonthlyPrice.ToString("0") <small>@(plan.MonthlyPrice == 0 ? "zł" : "zł / mies.")</small></div>
                    <div class="lp-price-period">@PricePeriod(plan)</div>
                    <ul>
                        @foreach (var (label, included) in HomeShared.PlanFeatures(plan))
                        {
                            <li class="@(included ? "" : "off")"><i class="bi @(included ? "bi-check-circle-fill" : "bi-dash-circle")"></i>@label</li>
                        }
                    </ul>
                    <a href="/register?plan=@plan.Id" class="lp-btn @(plan.IsFeatured ? "lp-btn-primary" : "lp-btn-ghost")">
                        @(plan.MonthlyPrice == 0 ? "Zacznij za darmo" : $"Wybieram {plan.Name}")
                    </a>
                </div>
            }
        </div>
        <ul class="ld-guarantee">
            <li><i class="bi bi-credit-card-2-front"></i><span><b>Pierwsza opłata po okresie próbnym.</b> Przypominamy e-mailem kilka dni wcześniej.</span></li>
            <li><i class="bi bi-x-circle"></i><span><b>Rezygnujesz jednym kliknięciem.</b> Bez umów i okresu wypowiedzenia.</span></li>
            <li><i class="bi bi-box-arrow-down"></i><span><b>Dane klientów są Twoje.</b> Zawsze do pobrania, także po rezygnacji.</span></li>
        </ul>
    </div>
</section>

<!-- FAQ -->
<section class="lp-section" id="faq">
    <div class="lp-container">
        <div class="ld-head">
            <div class="lp-eyebrow">Pytania</div>
            <h2>Najczęstsze pytania</h2>
        </div>
        <div class="lp-faq">
            @for (var i = 0; i < HomeShared.Faqs.Length; i++)
            {
                var f = HomeShared.Faqs[i];
                <details open="@(i == 0)">
                    <summary>@f.Question<i class="bi bi-plus-lg"></i></summary>
                    <p>@f.Answer</p>
                </details>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="ld-cta">
    <div class="lp-container ld-cta-inner">
        <span class="ld-cta-mascot">@Mascot("celebrate")</span>
        <h2>@_s("cta_title", "Oddaj papierologię aplikacji. Wróć do trenowania.")</h2>
        <p>@_s("cta_subtitle", "Zbuduj aplikację w kilka minut i zaproś pierwszych klientów jeszcze dziś. Okres próbny jest za darmo.")</p>
        <a href="/register" class="lp-btn lp-btn-energy"><i class="bi bi-rocket-takeoff"></i>@_s("cta_button", "Zbuduj swoją aplikację")</a>
    </div>
</section>

<a href="/register" class="lp-sticky-cta"><i class="bi bi-rocket-takeoff"></i>Zbuduj swoją aplikację</a>

</div>

@code {
    private Dictionary<string, string> _settings = new();
    private List<Plan> _plans = [];
    private List<AppFeedback> _reviews = [];
    private int _activeTrainers;
    private AssistantService.PublicLook _look = new(AssistantService.DefaultName, "live", null, m => $"/assistant/mascot/{m}.png");

    private static readonly System.Globalization.CultureInfo Pl = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");

    private record Pain(string Icon, string Before, string After);

    private static readonly Pain[] _pains =
    [
        new("bi-whatsapp", "Zapisy na WhatsAppie o 23:00", "Klienci rezerwują sami — o każdej porze, w Twojej aplikacji."),
        new("bi-journal-x", "Zeszyt z tym, kto ile zapłacił", "Zaległości w jednym miejscu. Wpłatę odhaczasz jednym kliknięciem."),
        new("bi-person-dash", "Klient, który znika bez słowa", "Asystent widzi przerwy i spadek formy, zanim klient odejdzie."),
        new("bi-file-earmark-pdf", "Plany w PDF-ach i notatkach", "Plan w telefonie klienta, a ciężary zapisują się same."),
    ];

    /// <param name="Kind">„img” — zrzut w oknie przeglądarki, „video” — nagranie z komputera, „phone” — nagranie z telefonu.</param>
    private record DayStep(string Time, string Icon, string Title, string Text, string Kind, string Media, string Alt, string Path);

