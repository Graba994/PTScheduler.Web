@* Biała karta z nagłówkiem: kafelek z ikoną, tytuł, podtytuł i akcje po prawej. *@
<section class="pp-card @(Flush ? "pp-card-flush" : "") @Class">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="pp-card-head">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <div class="pp-icon @IconClass"><i class="bi @Icon"></i></div>
            }
            <div class="min-w-0">
                <h2 class="pp-card-title">@Title</h2>
                @if (!string.IsNullOrEmpty(Subtitle)) { <div class="pp-card-sub">@Subtitle</div> }
            </div>
            @if (Actions is not null) { <div class="pp-card-actions">@Actions</div> }
        </div>
    }
    @ChildContent
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    /// <summary>np. „pp-tone-ok”, „pp-icon-cyan” — kolor kafelka z ikoną.</summary>
    [Parameter] public string? IconClass { get; set; }
    [Parameter] public bool Flush { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
