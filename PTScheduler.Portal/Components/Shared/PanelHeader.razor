@* Nagłówek strony panelu: ikona, tytuł, jedno-dwuzdaniowe wyjaśnienie i akcje po prawej. *@
<header class="pp-head">
    @if (!string.IsNullOrEmpty(BackHref))
    {
        <a href="@BackHref" class="pp-back"><i class="bi bi-arrow-left"></i>@BackLabel</a>
    }
    <div class="pp-head-row">
        <div class="pp-head-icon @IconClass"><i class="bi @Icon"></i></div>
        <div class="pp-head-text">
            <h1 class="pp-title">@Title</h1>
            @if (Description is not null)
            {
                <p class="pp-sub">@Description</p>
            }
            else if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="pp-sub">@Subtitle</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="pp-head-actions">@Actions</div>
        }
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "bi-grid";
    [Parameter] public string? IconClass { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackLabel { get; set; } = "Wróć";
}
