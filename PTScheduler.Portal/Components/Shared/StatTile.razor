@* Kafelek liczby: etykieta, wartość, opis i ikona w kolorze tonu. *@
@if (string.IsNullOrEmpty(Href))
{
    <div class="pp-stat">@Body</div>
}
else
{
    <a class="pp-stat" href="@Href">@Body</a>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? Meta { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-circle";
    [Parameter] public string Tone { get; set; } = "info";
    [Parameter] public string? Href { get; set; }

    private RenderFragment Body => __builder =>
    {
        <div class="pp-stat-top">
            <span class="pp-stat-label">@Label</span>
            <span class="pp-icon pp-icon-sm pp-tone-@Tone"><i class="bi @Icon"></i></span>
        </div>
        <div class="pp-stat-value">@Value</div>
        @if (!string.IsNullOrEmpty(Meta)) { <div class="pp-stat-meta">@Meta</div> }
    };
}
