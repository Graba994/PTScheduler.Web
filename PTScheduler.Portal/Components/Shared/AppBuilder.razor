    private async Task GoTo(int n)
    {
        if (n > _maxStep || n == _step) return;
        _step = n;
        _error = null;
        await FocusStepAsync();
    }

    private async Task Back()
    {
        if (_step <= 1) return;
        _step--;
        _error = null;
        await FocusStepAsync();
    }

    private async Task Next()
    {
        if (!CanNext) return;
        switch (_step)
        {
            case 1:
                if (!AdminMode && _maxStep == 1) await Funnel.TrackAsync(FunnelKinds.Start);
                Flash("brand");
                AddLog("bi-badge-ad", $"Logo „{Mono}” wygenerowane z nazwy");
                AddLog("bi-globe2", $"Adres {AddressText} — wolny");
                break;
            case 3:
                AddLog("bi-phone", "Aplikacja na telefon gotowa do instalacji z Twoją ikoną");
                break;
            case 4:
                if (!AdminMode && _maxStep == 4) await Funnel.TrackAsync(FunnelKinds.Account);
                Flash("offers");
                var named = _offers.Count(o => !string.IsNullOrWhiteSpace(o.Name));
                _offers.RemoveAll(o => string.IsNullOrWhiteSpace(o.Name));
                AddLog("bi-cash-coin", $"Cennik: {named} {(named == 1 ? "pozycja" : "pozycje")}{(_withPackage ? " i pakiet" : "")} — klienci zapłacą online albo u Ciebie");
                AddLog("bi-hand-index", "Symulacja: klient klika na stronie, rezerwuje i płaci BLIK-iem");
                break;
        }
        _step++;
        _maxStep = Math.Max(_maxStep, _step);
        await SaveDraftAsync();
        await FocusStepAsync();
    }

    private async Task FocusStepAsync()
    {
        try { await JS.InvokeVoidAsync("ptBuilder.focus", _step == 1 ? "#bd-company" : _step == 5 ? "#bd-email" : ".bd-step button, .bd-step input"); }
        catch (JSException) { }
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _phase != Phase.Build) return;
        if (_step < 5 && CanNext) await Next();
    }

    private string? ClientIp()
    {
        var ctx = HttpAccessor.HttpContext;
        var forwarded = ctx?.Request.Headers["X-Forwarded-For"].ToString();
        if (!string.IsNullOrWhiteSpace(forwarded)) return forwarded.Split(',')[0].Trim();
        return ctx?.Connection.RemoteIpAddress?.ToString();
    }

    /// <summary>„Opublikuj”: sprawdzenie danych, potem kod z e-maila → karta → start albo kolejka. Admin: od razu start.</summary>
    private async Task Publish()
    {
        _error = null;
        if (!CanPublish || _publishing) return;
        _builtSeconds = _startedAt is { } s ? Math.Max(1, (int)(DateTime.UtcNow - s).TotalSeconds) : 0;

        // Bot wypełnił ukryte pole — udajemy, że wszystko gra, i nic nie zakładamy.
        if (!AdminMode && !string.IsNullOrEmpty(_website)) { _phase = Phase.Queued; return; }

        var email = _email.Trim().ToLowerInvariant();
        if (RegistrationGateService.IsDisposableEmail(email))
        {
            _error = "Ten adres wygląda na skrzynkę jednorazową. Podaj adres, z którego korzystasz na co dzień — przyjdą na niego ważne wiadomości o aplikacji.";
            return;
        }
        var domain = NormalizedDomain;
        if (domain is not null)
        {
            if (!ValidDomain(domain)) { _error = "Własna domena wygląda na niepoprawną — wpisz ją jak annafit.pl (bez https://)."; return; }
            if (domain.EndsWith("." + _mainDomain, StringComparison.OrdinalIgnoreCase) || domain == _mainDomain)
            { _error = $"Adres w {_mainDomain} dostajesz automatycznie — tu wpisz swoją domenę, np. annafit.pl."; return; }
            if (SelectedPlan is { CustomDomain: false })
            { _error = $"Własna domena jest dostępna od planu {CustomDomainPlanName ?? "Starter"}. Wybierz go albo odznacz własną domenę — dodasz ją później."; return; }
        }
        if (!AdminMode && !string.IsNullOrWhiteSpace(_inviteCode))
        {
            _invite = await Gates.FindInviteAsync(_inviteCode);
            if (_invite is null) { _error = "Ten kod zaproszenia jest nieważny albo został już wykorzystany. Usuń go, żeby kontynuować."; return; }
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            if (await db.Tenants.AnyAsync(t => t.OwnerEmail == email && t.Status != TenantStatus.Destroyed))
            {
                _error = AdminMode ? "Na ten adres jest już aplikacja (Panel → Trenerzy)." : "Na ten adres e-mail jest już aplikacja. Zaloguj się w niej albo użyj innego adresu.";
                return;
            }
        }

        if (AdminMode) { await PublishAsAdminAsync(); return; }

        if (!Launcher.TryRegisterAttempt(ClientIp()))
        {
            _error = "Za dużo prób z tego adresu. Spróbuj ponownie za godzinę albo napisz do nas.";
            return;
        }

        if (_emailVerified) { await CreateTenantAndCardAsync(); return; }
        await SendCodeAsync();
    }

    private async Task SendCodeAsync()
    {
        _error = null;
        if (_codeSends >= 5) { _error = "Wysłaliśmy już kilka kodów. Odczekaj chwilę albo napisz do nas."; return; }
        _publishing = true;
        try
        {
            var code = System.Security.Cryptography.RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("000000");
            var (sent, error) = await EmailSvc.SendAsync(_email.Trim(), $"{code} — kod do publikacji aplikacji", EmailSvc.VerificationCodeEmailBody(code));
            if (!sent)
            {
                // Bez skonfigurowanej poczty (instalacja testowa) nie da się wysłać kodu — przepuszczamy, żeby nie blokować.
                if (error?.Contains("SMTP nie skonfigurowany") == true)
                {
                    Log.LogWarning("SMTP nie jest skonfigurowany — publikacja z kreatora bez kodu e-mail.");
                    _emailVerified = true;
                    await CreateTenantAndCardAsync();
                    return;
                }
                _error = "Nie udało się wysłać kodu. Sprawdź adres e-mail i spróbuj ponownie.";
                return;
            }
            _codeHash = HashCode(code);
            _codeExpires = DateTime.UtcNow.AddMinutes(10);
            _codeSentAt = DateTime.UtcNow;
            _codeAttempts = 0;
            _codeSends++;
            _codeInput = "";
            _phase = Phase.Verify;
            AddLog("bi-envelope-check", $"Kod wysłany na {_email.Trim()}");
            try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); await JS.InvokeVoidAsync("ptBuilder.focus", "#bd-code"); } catch (JSException) { }
        }
        finally { _publishing = false; }
    }

    private string HashCode(string code) =>
        Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes($"{_email.Trim().ToLowerInvariant()}|{code}")));

    private async Task CodeTyped()
    {
        _error = null;
        _codeInput = new string(_codeInput.Where(char.IsDigit).ToArray());
        if (_codeInput.Length == 6) await ConfirmCode();
    }

    private async Task ConfirmCode()
    {
        if (_publishing || _codeHash is null) return;
        if (DateTime.UtcNow > _codeExpires) { _error = "Kod wygasł — wyślij nowy."; return; }
        if (++_codeAttempts > 5) { _error = "Za dużo błędnych prób — wyślij nowy kod."; _codeHash = null; return; }
        if (!System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(
                System.Text.Encoding.ASCII.GetBytes(HashCode(_codeInput.Trim())), System.Text.Encoding.ASCII.GetBytes(_codeHash)))
        {
            _error = "To nie ten kod. Sprawdź jeszcze raz.";
            return;
        }
        _emailVerified = true;
        AddLog("bi-patch-check", "E-mail potwierdzony");
        await CreateTenantAndCardAsync();
    }

    private void BackToAccount()
    {
        _phase = Phase.Build;
        _step = 5;
        _error = null;
        _codeHash = null;
    }

    private TenantSetupPayload BuildPayload(string email, string? passwordHash)
    {
        var (first, last) = TenantSetupPayload.SplitName(_fullName.Trim());
        return new TenantSetupPayload
        {
            CompanyName = _company.Trim(),
            OwnerEmail = email,
            OwnerFirstName = first,
            OwnerLastName = last,
            OwnerPhone = string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
            PasswordHash = passwordHash,
            SetupMode = "self",
            AppTheme = _color,
            SiteTemplate = _template,
            Offers = _offers.Where(o => !string.IsNullOrWhiteSpace(o.Name)).Select(o => new TenantSetupPayload.OfferItem
            {
                Name = o.Name.Trim(), DurationMinutes = o.Minutes, Price = o.Price > 0 ? o.Price : null, IsPair = o.IsPair, IsGroup = o.IsGroup
            }).ToList(),
            Package = _withPackage && _pkgCount > 1 && _pkgPrice > 0
                ? new TenantSetupPayload.PackageItem { Name = $"Pakiet {_pkgCount} treningów", SessionsCount = _pkgCount, Price = _pkgPrice, OfferIndex = 0 }
                : null
        };
    }

    /// <summary>Zapisuje zgłoszenie (bez instancji!) z danymi kreatora i zwraca je.</summary>
    private async Task<Tenant> CreateTenantAsync(string? passwordHash)
    {
        var email = _email.Trim().ToLowerInvariant();
        await using var db = await DbFactory.CreateDbContextAsync();
        var slug = await FreeSlugAsync(db, BaseSlug);
        var payload = BuildPayload(email, passwordHash);
        var tenant = await TenantSvc.CreateAsync(slug, $"{slug}.{_mainDomain}", _company.Trim(), _fullName.Trim(), email,
            payload.OwnerPhone, _planId, "self", payload.ToJson());

        var t = await db.Tenants.FindAsync(tenant.Id);
        if (t is not null)
        {
            t.BillingInterval = SelectedPlan is { } p && Yearly(p) ? "yearly" : "monthly";
            t.RegistrationKey = Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(18)).Replace('+', '-').Replace('/', '_').TrimEnd('=');
            t.InviteCode = _invite?.Code;
            if (_referrer is not null && !string.Equals(_referrer.OwnerEmail, email, StringComparison.OrdinalIgnoreCase))
                t.ReferredByTenantId = _referrer.Id;
            if (NormalizedDomain is { } dom) { t.CustomDomain = dom; t.CustomDomainStatus = "waiting"; t.CustomDomainSince = DateTime.UtcNow; }
            await db.SaveChangesAsync();
            tenant = t;
        }
        // Dowód akceptacji dokumentów (wersje, IP, przeglądarka). Przy „Zbuduj dla trenera” trener zaakceptuje je przy pierwszym logowaniu.
        if (!AdminMode && _consent)
            await Legal.RecordAsync(tenant.Id, email, LegalService.Docs.Select(d => d.Key), ClientIp(),
                HttpAccessor.HttpContext?.Request.Headers.UserAgent.ToString(), "kreator");
        _appHost = tenant.Domain;
        _slug = tenant.Slug;
        _pendingTenantId = tenant.Id;
        AddLog("bi-person-check", $"Zgłoszenie zapisane: {tenant.Domain}");
        return tenant;
    }

    private async Task CreateTenantAndCardAsync()
    {
        _publishing = true;
        try
        {
            if (_pendingTenantId is null)
            {
                await CreateTenantAsync(TenantSetupPayload.HashPassword(_password));
                _password = "";
            }
            await StartCardAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Publikacja z kreatora nie powiodła się.");
            _error = "Nie udało się zapisać zgłoszenia. Spróbuj jeszcze raz za chwilę.";
            _phase = Phase.Build;
        }
        finally { _publishing = false; }
    }

    /// <summary>Karta przez Stripe Checkout. Bez skonfigurowanego Stripe zgłoszenie czeka w kolejce.</summary>
    private async Task StartCardAsync()
    {
        if (_pendingTenantId is not { } tenantId) return;
        _error = null;
        _gateway = await Gates.RegistrationGatewayAsync();
        if (_gateway is null)
        {
            await QueueAsync(tenantId, "Żadna bramka płatności nie jest skonfigurowana (Stripe, Autopay, PayU, Przelewy24) — zgłoszenie bez weryfikacji.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var key = await db.Tenants.Where(t => t.Id == tenantId).Select(t => t.RegistrationKey).FirstOrDefaultAsync();
        var back = $"{Nav.BaseUri}register?wznow={Uri.EscapeDataString(key ?? "")}";
        if (!IsStripe)
        {
            var (payUrl, payError) = await Gates.StartVerificationPaymentAsync(tenantId, _gateway, back + "&platnosc=1", Nav.BaseUri);
            if (payUrl is null)
            {
                Log.LogWarning("Płatność weryfikacyjna {Gateway} nie wystartowała dla {TenantId}: {Error}", _gateway, tenantId, payError);
                await QueueAsync(tenantId, $"Nie udało się otworzyć płatności {RegistrationGateService.GatewayName(_gateway)}: {payError}");
                return;
            }
            try { await JS.InvokeVoidAsync("ptBuilder.clear"); } catch (JSException) { }
            Nav.NavigateTo(payUrl, forceLoad: true);
            return;
        }
        var (ok, url, error) = await StripeSvc.StartCardCheckoutAsync(tenantId, back + "&session_id={CHECKOUT_SESSION_ID}", back + "&karta=anulowana",
            ExtraDays);
        if (!ok || url is null)
        {
            Log.LogWarning("Stripe Checkout nie wystartował dla {TenantId}: {Error}", tenantId, error);
            await QueueAsync(tenantId, $"Nie udało się otworzyć płatności kartą: {error}");
            return;
        }
        try { await JS.InvokeVoidAsync("ptBuilder.clear"); } catch (JSException) { }
        Nav.NavigateTo(url, forceLoad: true);
    }

    /// <summary>Po powrocie z polskiej bramki: czekamy do minuty na potwierdzenie (ITN / webhook).</summary>
    private async Task WaitForPaymentAsync(int tenantId)
    {
        for (var i = 0; i < 30; i++)
        {
            await Task.Delay(2000);
            await using var db = await DbFactory.CreateDbContextAsync();
            var paid = await db.Tenants.AsNoTracking().Where(t => t.Id == tenantId).Select(t => t.RegistrationPaidAt).FirstOrDefaultAsync();
            if (paid is not null)
            {
                await InvokeAsync(async () =>
                {
                    _waitingPayment = false;
                    AddLog("bi-patch-check", "Płatność potwierdzona");
                    await GoLiveAsync(tenantId);
                    StateHasChanged();
                });
                return;
            }
        }
        await InvokeAsync(() =>
        {
            _waitingPayment = false;
            _error = "Nie dostaliśmy jeszcze potwierdzenia płatności. Jeśli płatność się udała, odświeżymy wszystko sami i damy znać e-mailem — możesz też spróbować ponownie.";
            StateHasChanged();
        });
    }

    /// <summary>Karta jest — bramki decydują: start od razu albo kolejka (z powodem dla admina).</summary>
    private async Task GoLiveAsync(int tenantId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tenant = await db.Tenants.AsNoTracking().FirstAsync(t => t.Id == tenantId);
        var decision = await Gates.DecideAsync(tenant);
        if (!decision.Launch)
        {
            await QueueAsync(tenantId, decision.QueueReason ?? "Czeka na akceptację.");
            return;
        }
        var invite = await Gates.FindInviteAsync(tenant.InviteCode);
        if (invite is not null) await Gates.ConsumeInviteAsync(invite.Code);
        var token = await Gates.PrepareWelcomeTokenAsync(tenantId);
        _launch = Launcher.Start(tenantId, token, invite is not null ? "invite" : "limit");
        _phase = Phase.Deploying;
        AddLog("bi-rocket-takeoff", "Publikacja rozpoczęta");
        try { await JS.InvokeVoidAsync("ptBuilder.clear"); await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch (Exception) { }
    }

    private async Task QueueAsync(int tenantId, string reason)
    {
        await Gates.QueueAsync(tenantId, reason);
        _phase = Phase.Queued;
        AddLog("bi-hourglass-split", "Zgłoszenie w kolejce do uruchomienia");
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var t = await db.Tenants.AsNoTracking().Include(x => x.Plan).FirstAsync(x => x.Id == tenantId);
            var (first, _) = TenantSetupPayload.SplitName(t.OwnerName);
            _ = EmailSvc.SendAsync(t.OwnerEmail, $"{t.CompanyName} — aplikacja w kolejce do uruchomienia", EmailSvc.AppQueuedEmailBody(first ?? t.OwnerName, t.CompanyName));
            var adminEmail = await Settings.GetAsync(SiteSettingsService.Keys.AdminNotificationEmail);
            if (!string.IsNullOrWhiteSpace(adminEmail))
                _ = EmailSvc.SendAsync(adminEmail, $"W kolejce: {t.CompanyName} — {reason}",
                    EmailSvc.AdminNewRegistrationEmailBody(t.OwnerName, t.OwnerEmail, t.CompanyName, t.Plan?.Name ?? t.PlanId, t.Phone ?? "", t.Id));
            await JS.InvokeVoidAsync("ptBuilder.clear");
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        catch (Exception ex) { Log.LogWarning(ex, "Powiadomienia o kolejce nie zostały wysłane."); }
    }

    /// <summary>„Zbuduj dla trenera”: zgłoszenie bez hasła i od razu start; trener ustawi hasło z linku w e-mailu.</summary>
    private async Task PublishAsAdminAsync()
    {
        _publishing = true;
        try
        {
            var tenant = await CreateTenantAsync(passwordHash: null);
            _launch = Launcher.Start(tenant.Id, null, null, builtByAdmin: true);
            _phase = Phase.Deploying;
            AddLog("bi-rocket-takeoff", "Uruchamiam aplikację trenera");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Budowanie aplikacji dla trenera nie powiodło się.");
            _error = $"Nie udało się zapisać: {ex.Message}";
        }
        finally { _publishing = false; }
    }

    private void OnLaunchChanged(Guid id)
    {
        if (_launch is null || id != _launch.Id) return;
        _ = InvokeAsync(async () =>
        {
            if (_launch.Done && !_celebrated)
            {
                _celebrated = true;
                _phase = _launch.Failed ? Phase.Queued : Phase.Done;
                if (!_launch.Failed)
                {
                    AddLog("bi-stars", AdminMode ? "Aplikacja trenera działa" : "Aplikacja działa — witaj na pokładzie!");
                    if (NormalizedDomain is { } dom) _serverIp = await ResolveServerIpAsync();
                    StateHasChanged();
                    try { await JS.InvokeVoidAsync("ptBuilder.confetti", new[] { Color.Hex, Color.Hex2, "#06D6A0", "#FFD166", "#FF6B9D", "#7C3AED" }, ".bd-phone"); }
                    catch (JSException) { }
                }
            }
            StateHasChanged();
        });
    }

    /// <summary>Publiczny adres serwera do rekordu A: z adresu trenera w domenie platformy albo z głównej domeny.</summary>
    private async Task<string?> ResolveServerIpAsync()
    {
        foreach (var host in new[] { _appHost, _mainDomain })
        {
            if (string.IsNullOrWhiteSpace(host)) continue;
            try
            {
                var ips = await System.Net.Dns.GetHostAddressesAsync(host).WaitAsync(TimeSpan.FromSeconds(4));
                var v4 = ips.FirstOrDefault(i => i.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork);
                if (v4 is not null) return v4.ToString();
            }
            catch (Exception) { }
        }
        return null;
    }

    public void Dispose()
    {
        Launcher.Changed -= OnLaunchChanged;
        _timer?.Dispose();
    }
}
