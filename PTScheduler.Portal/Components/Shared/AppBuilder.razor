    protected override async Task OnInitializedAsync()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        string? Q(string key) => query.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v.ToString() : null;
        Plan = Q("plan"); Nazwa = Q("nazwa"); KodQuery = Q("kod"); Wznow = Q("wznow"); SessionId = Q("session_id"); RefQuery = Q("ref");
        _cardCancelled = Q("karta") == "anulowana";

        await using var db = await DbFactory.CreateDbContextAsync();
        _plans = await db.Plans.AsNoTracking().Where(p => p.IsActive).OrderBy(p => p.SortOrder).ToListAsync();
        _planId = _plans.FirstOrDefault(p => p.Id == Plan)?.Id ?? _plans.FirstOrDefault()?.Id ?? "start";
        var md = await Settings.GetAsync(SiteSettingsService.Keys.MainDomain);
        if (!string.IsNullOrWhiteSpace(md)) _mainDomain = md.Trim();
        _gateway = await Gates.RegistrationGatewayAsync();
        _verifyAmount = await Gates.VerifyAmountAsync();
        Launcher.Changed += OnLaunchChanged;

        if (!AdminMode && Wznow is not null)
        {
            await ResumeAsync(Wznow);
            return;
        }

        if (!AdminMode && RefQuery is not null) _referrer = await Referrals.FindReferrerAsync(RefQuery);
        if (!string.IsNullOrWhiteSpace(KodQuery))
        {
            _inviteCode = KodQuery.Trim().ToUpperInvariant();
            _showInvite = true;
        }
        if (!string.IsNullOrWhiteSpace(Nazwa))
        {
            _company = Nazwa.Trim()[..Math.Min(60, Nazwa.Trim().Length)];
            _startedAt = DateTime.UtcNow;
            await CompanyChanged();
        }
        AddLog("bi-cpu", AdminMode ? "Kreator dla trenera — uzupełnij dane, a podgląd składa się na żywo" : "Kreator gotowy — buduj, a podgląd składa się na żywo");
    }

    /// <summary>Powrót z płatności kartą (albo odświeżenie strony po publikacji): wracamy do tego samego zgłoszenia.</summary>
    private async Task ResumeAsync(string key)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tenant = await db.Tenants.AsNoTracking().FirstOrDefaultAsync(t => t.RegistrationKey == key);
        if (tenant is null)
        {
            _error = "Nie znaleźliśmy tego zgłoszenia — zacznij od nowa albo napisz do nas.";
            return;
        }
        _pendingTenantId = tenant.Id;
        RestoreFromTenant(tenant);

        // Już uruchomiona / w trakcie: pokazujemy stan zamiast zaczynać od nowa.
        if (Launcher.FindByTenant(tenant.Id) is { } running)
        {
            _launch = running;
            _phase = running.Done ? (running.Failed ? Phase.Queued : Phase.Done) : Phase.Deploying;
            return;
        }
        if (tenant.Status is TenantStatus.Active or TenantStatus.Provisioning)
        {
            _phase = Phase.Queued;
            _alreadyActiveUrl = await TenantSvc.PublicUrlAsync(tenant);
            return;
        }
        if (!string.IsNullOrWhiteSpace(tenant.QueuedReason))
        {
            _phase = Phase.Queued;
            return;
        }

        if (tenant.RegistrationPaidAt is not null)
        {
            await GoLiveAsync(tenant.Id);
            return;
        }
        if (!string.IsNullOrEmpty(tenant.RegistrationPaymentId))
        {
            // Wróciliśmy z Autopay / PayU / Przelewy24 — potwierdzenie przychodzi z bramki, chwilę czekamy.
            _gateway = tenant.RegistrationPaymentGateway ?? _gateway;
            _waitingPayment = true;
            _phase = Phase.Card;
            _ = WaitForPaymentAsync(tenant.Id);
            return;
        }

        if (SessionId is not null)
        {
            var (ok, tenantId, error) = await StripeSvc.VerifyCardCheckoutAsync(SessionId);
            if (ok && tenantId == tenant.Id)
            {
                AddLog("bi-credit-card-2-front", "Karta podpięta — pierwsza opłata dopiero po okresie próbnym");
                await GoLiveAsync(tenant.Id);
                return;
            }
            _error = error;
        }
        _phase = Phase.Card;
    }

    private void RestoreFromTenant(Tenant tenant)
    {
        var payload = TenantSetupPayload.FromJson(tenant.SetupPayload);
        _company = tenant.CompanyName;
        _fullName = tenant.OwnerName;
        _email = tenant.OwnerEmail;
        _phone = tenant.Phone;
        _planId = tenant.PlanId;
        _interval = tenant.BillingInterval;
        _slug = tenant.Slug;
        _appHost = tenant.Domain;
        _inviteCode = tenant.InviteCode;
        if (!string.IsNullOrWhiteSpace(tenant.CustomDomain)) { _wantDomain = true; _customDomain = tenant.CustomDomain; }
        if (payload is not null)
        {
            _color = AppBuilderCatalog.ColorOf(payload.AppTheme).Key;
            _template = AppBuilderCatalog.TemplateOf(payload.SiteTemplate).Key;
            _spec = AppBuilderCatalog.Specializations.FirstOrDefault(sp => sp.Template == _template)?.Key ?? AppBuilderCatalog.Specializations[0].Key;
            _offers = payload.Offers.Select(o => new OfferRow { Name = o.Name, Minutes = o.DurationMinutes, Price = o.Price ?? 0, IsPair = o.IsPair, IsGroup = o.IsGroup }).ToList();
            if (payload.Package is { } pk) { _withPackage = true; _pkgCount = pk.SessionsCount; _pkgPrice = pk.Price; } else _withPackage = false;
        }
        else _spec ??= AppBuilderCatalog.Specializations[0].Key;
        _step = _maxStep = 5;
        _emailVerified = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _timer = new System.Threading.Timer(_ =>
        {
            if ((_startedAt is not null && _phase == Phase.Build) || _phase is Phase.Deploying or Phase.Verify)
                _ = InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        if (!AdminMode && Wznow is null) await Funnel.TrackAsync(FunnelKinds.View);
        if (!AdminMode && Wznow is null && _referrer is null)
        {
            try
            {
                if (await JS.InvokeAsync<string?>("ptBuilder.refCookie") is { } refCode && await Referrals.FindReferrerAsync(refCode) is { } r)
                {
                    _referrer = r;
                    StateHasChanged();
                }
            }
            catch (JSException) { }
        }
        if (string.IsNullOrWhiteSpace(Nazwa) && !AdminMode && Wznow is null)
        {
            try
            {
                var json = await JS.InvokeAsync<string?>("ptBuilder.load");
                if (!string.IsNullOrWhiteSpace(json) && System.Text.Json.JsonSerializer.Deserialize<Draft>(json) is { } d && !string.IsNullOrWhiteSpace(d.Company))
                {
                    RestoreDraft(d);
                    if (_referrer is null && d.Ref is not null) _referrer = await Referrals.FindReferrerAsync(d.Ref);
                    await CompanyChanged();
                    AddLog("bi-arrow-counterclockwise", "Przywrócono Twój szkic — możesz budować dalej");
                    StateHasChanged();
                }
            }
            catch (Exception ex) when (ex is JSException or System.Text.Json.JsonException) { }
        }
        if (_phase == Phase.Build) await JS.InvokeVoidAsync("ptBuilder.focus", _step == 1 ? "#bd-company" : ".bd-step input");
    }

    private void RestoreDraft(Draft d)
    {
        _company = d.Company ?? "";
        _fullName = d.FullName ?? "";
        if (d.Spec is not null && AppBuilderCatalog.Specializations.Any(s => s.Key == d.Spec)) _spec = d.Spec;
        if (d.Color is not null) _color = AppBuilderCatalog.ColorOf(d.Color).Key;
        if (d.Template is not null) _template = AppBuilderCatalog.TemplateOf(d.Template).Key;
        if (d.Offers is { Count: > 0 }) _offers = d.Offers.Take(3).ToList();
        _withPackage = d.WithPackage;
        if (d.PkgCount > 1) _pkgCount = d.PkgCount;
        if (d.PkgPrice > 0) _pkgPrice = d.PkgPrice;
        _email = d.Email ?? "";
        _phone = d.Phone;
        if (d.PlanId is not null && _plans.Any(p => p.Id == d.PlanId)) _planId = d.PlanId;
        if (d.Interval is "monthly" or "yearly") _interval = d.Interval;
        if (!string.IsNullOrWhiteSpace(d.CustomDomain)) { _wantDomain = true; _customDomain = d.CustomDomain; }
        _step = Math.Clamp(d.Step, 1, 5);
        _maxStep = _step;
        _startedAt = DateTime.UtcNow;
    }

    private async Task SaveDraftAsync()
    {
        var d = new Draft
        {
            Step = _step, Company = _company, FullName = _fullName, Spec = _spec, Color = _color, Template = _template,
            Offers = _offers, WithPackage = _withPackage, PkgCount = _pkgCount, PkgPrice = _pkgPrice,
            Email = _email, Phone = _phone, PlanId = _planId, Interval = _interval, CustomDomain = _wantDomain ? _customDomain : null,
            Ref = _referrer?.Slug
        };
        if (AdminMode) return;
        try { await JS.InvokeVoidAsync("ptBuilder.save", System.Text.Json.JsonSerializer.Serialize(d)); } catch (JSException) { }
    }

    private void Touch()
    {
        _startedAt ??= DateTime.UtcNow;
        _error = null;
    }

    private void AddLog(string icon, string text)
    {
        _log.Add(new LogLine(++_logId, icon, text));
        if (_log.Count > 12) _log.RemoveAt(0);
    }

    private async Task CompanyChanged()
    {
        Touch();
        var check = ++_slugCheck;
        var baseSlug = BaseSlug;
        if (string.IsNullOrWhiteSpace(_company)) { _slug = ""; _slugState = ""; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var free = await FreeSlugAsync(db, baseSlug);
        if (check != _slugCheck) return; // w międzyczasie wpisano kolejną literę
        _slug = free;
        _slugState = free == baseSlug ? "free" : "taken";
    }

    private static async Task<string> FreeSlugAsync(PortalDbContext db, string baseSlug)
    {
        var taken = await db.Tenants.AsNoTracking()
            .Where(t => t.Slug == baseSlug || t.Slug.StartsWith(baseSlug + "-"))
            .Select(t => t.Slug).ToListAsync();
        if (!taken.Contains(baseSlug) && !AppBuilderCatalog.ReservedSlugs.Contains(baseSlug)) return baseSlug;
        for (var i = 2; ; i++)
            if (!taken.Contains($"{baseSlug}-{i}")) return $"{baseSlug}-{i}";
    }

    private void PickSpec(AppBuilderCatalog.Specialization sp)
    {
        Touch();
        var changed = _spec != sp.Key;
        _spec = sp.Key;
        if (!changed) return;
        _template = sp.Template;
        _color = sp.Color;
        _offers = sp.Offers.Select(o => new OfferRow { Name = o.Name, Minutes = o.Minutes, Price = o.Price, IsPair = o.IsPair, IsGroup = o.IsGroup }).ToList();
        _pkgCount = sp.PackageCount;
        _pkgPrice = sp.PackagePrice;
        _withPackage = true;
        _colorVersion++;
        _siteVersion++;
        AddLog("bi-window-stack", $"Strona „{Template.Name}” złożona z {Template.Sections} sekcji");
        AddLog("bi-tags", $"Oferta: {_offers.Count} rodzaje treningów i pakiet {_pkgCount} treningów");
        AddLog("bi-palette", $"Kolor „{Color.Name}” dobrany do specjalizacji");
    }

