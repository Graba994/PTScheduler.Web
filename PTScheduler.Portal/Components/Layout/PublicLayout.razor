@inherits LayoutComponentBase

<nav class="pts-nav">
    <div class="pts-container pts-nav-inner">
        <a href="/" class="pts-nav-logo">
            <div class="pts-nav-logo-icon">
                <span class="material-symbols-rounded" style="font-size:20px">calendar_month</span>
            </div>
            PTScheduler
        </a>
        <div class="pts-nav-links">
            <a href="/#features" class="pts-nav-link">Funkcje</a>
            <a href="/#pricing" class="pts-nav-link">Cennik</a>
            <a href="/#faq" class="pts-nav-link">FAQ</a>
            <a href="/panel" class="pts-nav-link">
                <span class="material-symbols-rounded" style="font-size:18px;vertical-align:middle">login</span>
            </a>
            <a href="/register" class="pts-btn pts-btn-primary pts-btn-sm">Zacznij za darmo</a>
        </div>
    </div>
</nav>

<main>
    @Body
</main>

<footer class="pts-footer">
    <p>&copy; @DateTime.Now.Year PTScheduler — Platforma dla trenerów personalnych</p>
    <p style="margin-top:6px"><a href="mailto:kontakt@ptscheduler.pl">kontakt@ptscheduler.pl</a></p>
</footer>

<style>
    :root {
        --pts-primary: #7C3AED;
        --pts-primary-light: #A78BFA;
        --pts-primary-dark: #5B21B6;
        --pts-accent: #06D6A0;
        --pts-accent-dark: #05B88A;
        --pts-energy: #FF6B35;
        --pts-energy-dark: #E55A2B;
        --pts-bg: #FAFAFF;
        --pts-surface: #FFFFFF;
        --pts-surface-alt: #F3F1FA;
        --pts-text: #1A1625;
        --pts-text-secondary: #6E6882;
        --pts-border: #E8E5F0;
        --pts-dark-bg: #0D0B14;
        --pts-glow: rgba(124, 58, 237, 0.15);
        --pts-font-display: 'Sora', sans-serif;
        --pts-font-body: 'Plus Jakarta Sans', sans-serif;
        --pts-radius: 16px;
        --pts-radius-sm: 10px;
        --pts-shadow: 0 4px 24px rgba(13, 11, 20, 0.06);
        --pts-shadow-lg: 0 12px 48px rgba(13, 11, 20, 0.1);
    }

    .pts-nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        background: color-mix(in srgb, var(--pts-bg) 85%, transparent);
        backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--pts-border);
        padding: 14px 0;
    }
    .pts-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .pts-nav-inner {
        display: flex; align-items: center; justify-content: space-between;
    }
    .pts-nav-logo {
        display: flex; align-items: center; gap: 10px;
        font-family: var(--pts-font-display); font-weight: 700; font-size: 1.25rem;
        color: var(--pts-text); text-decoration: none;
    }
    .pts-nav-logo-icon {
        width: 36px; height: 36px; border-radius: 10px;
        background: linear-gradient(135deg, var(--pts-primary), var(--pts-accent));
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 18px;
    }
    .pts-nav-links { display: flex; align-items: center; gap: 8px; }
    .pts-nav-link {
        padding: 8px 16px; border-radius: 8px; font-size: 0.9rem; font-weight: 500;
        color: var(--pts-text-secondary); transition: all 0.2s; text-decoration: none;
    }
    .pts-nav-link:hover { color: var(--pts-text); background: var(--pts-surface-alt); }

    .pts-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 12px 24px; border-radius: 12px; font-size: 0.95rem;
        font-weight: 600; font-family: var(--pts-font-body);
        border: none; cursor: pointer; transition: all 0.25s;
        text-decoration: none;
    }
    .pts-btn-primary {
        background: var(--pts-primary); color: #fff;
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.35);
    }
    .pts-btn-primary:hover {
        background: var(--pts-primary-dark);
        box-shadow: 0 6px 24px rgba(124, 58, 237, 0.45);
        transform: translateY(-1px); color: #fff;
    }
    .pts-btn-sm { padding: 8px 18px; font-size: 0.85rem; border-radius: 8px; }

    .pts-footer {
        padding: 40px 0;
        background: var(--pts-dark-bg);
        text-align: center;
    }
    .pts-footer p { color: #9B95AD; font-size: 0.85rem; }
    .pts-footer a { color: var(--pts-primary-light); text-decoration: none; }

    @@media (max-width: 900px) {
        .pts-nav-link { display: none; }
    }
</style>
