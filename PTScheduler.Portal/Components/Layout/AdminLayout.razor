@inherits LayoutComponentBase
@inject PTScheduler.Portal.Services.UpdateNotifier UpdateNotifier
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<PTScheduler.Portal.Data.PortalDbContext> DbFactory

<div class="portal-shell">
    <!-- Pasek górny na telefonie -->
    <header class="portal-topbar">
        <button type="button" class="portal-icon-btn" onclick="ptNav.open()" aria-label="Otwórz menu">
            <i class="bi bi-list"></i>
        </button>
        <a href="/panel" class="portal-topbar-brand"><img src="/brand/hantly-mark.svg" alt="" width="26" height="26" /><span>Hantly</span></a>
    </header>
    <div class="portal-backdrop" onclick="ptNav.close()"></div>

    <aside class="portal-sidebar" aria-label="Menu panelu">
        <div class="portal-sidebar-head">
            <a href="/panel" class="portal-brand" title="Hantly">
                <img class="portal-brand-mark" src="/brand/hantly-mark.svg" alt="" width="30" height="30" />
                <span class="portal-label">Hantly</span>
            </a>
            <button type="button" class="portal-icon-btn portal-collapse-btn" onclick="ptNav.toggleCollapse()" aria-label="Zwiń lub rozwiń menu" title="Zwiń / rozwiń menu">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>
            <button type="button" class="portal-icon-btn portal-close-btn" onclick="ptNav.close()" aria-label="Zamknij menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <nav class="portal-nav" onclick="if (event.target.closest('a')) ptNav.close()">
            <NavLink href="/panel" Match="NavLinkMatch.All" class="portal-nav-item" title="Pulpit">
                <i class="bi bi-speedometer2"></i><span class="portal-label">Pulpit</span>
            </NavLink>
            <NavLink href="/panel/poczta" class="portal-nav-item" title="Poczta">
                <i class="bi bi-envelope"></i><span class="portal-label">Poczta</span>
                @if (_mail > 0)
                {
                    <span class="portal-dot" title="@($"Nieprzeczytane wątki: {_mail}")"></span>
                }
            </NavLink>
            <NavLink href="/panel/tenants" class="portal-nav-item" title="Trenerzy">
                <i class="bi bi-people"></i><span class="portal-label">Trenerzy</span>
            </NavLink>
            <NavLink href="/panel/ryzyko" class="portal-nav-item" title="Zagrożeni odejściem">
                <i class="bi bi-heart-pulse"></i><span class="portal-label">Zagrożeni odejściem</span>
            </NavLink>
            <NavLink href="/panel/leo" class="portal-nav-item" title="Leo — analiza">
                <i class="bi bi-graph-up-arrow"></i><span class="portal-label">Leo — analiza</span>
            </NavLink>
            <NavLink href="/panel/build" class="portal-nav-item" title="Zbuduj dla trenera">
                <i class="bi bi-magic"></i><span class="portal-label">Zbuduj dla trenera</span>
            </NavLink>

            <div class="portal-nav-section"><span class="portal-label">Sprzedaż</span></div>
            <NavLink href="/panel/invites" class="portal-nav-item" title="Kody zaproszeń">
                <i class="bi bi-ticket-perforated"></i><span class="portal-label">Kody zaproszeń</span>
            </NavLink>
            <NavLink href="/panel/spotkania" class="portal-nav-item" title="Spotkania z trenerami">
                <i class="bi bi-cup-hot"></i><span class="portal-label">Spotkania</span>
            </NavLink>
            <NavLink href="/panel/ankieta" class="portal-nav-item" title="Ankieta dla trenerów">
                <i class="bi bi-ui-checks"></i><span class="portal-label">Ankieta</span>
            </NavLink>
            <NavLink href="/panel/orders" class="portal-nav-item" title="Zgłoszenia">
                <i class="bi bi-bag-check"></i><span class="portal-label">Zgłoszenia</span>
                @if (_todo > 0)
                {
                    <span class="portal-dot" title="@($"Do zrobienia: {_todo}")"></span>
                }
            </NavLink>
            <NavLink href="/panel/finances" class="portal-nav-item" title="Finanse">
                <i class="bi bi-cash-stack"></i><span class="portal-label">Finanse</span>
            </NavLink>
            <NavLink href="/panel/billing" class="portal-nav-item" title="Rachunki">
                <i class="bi bi-receipt"></i><span class="portal-label">Rachunki</span>
            </NavLink>
            <NavLink href="/panel/ksiegowosc" class="portal-nav-item" title="Księgowość">
                <i class="bi bi-journal-check"></i><span class="portal-label">Księgowość</span>
                @if (_books > 0)
                {
                    <span class="portal-dot" title="@($"Dokumenty do uwagi: {_books}")"></span>
                }
            </NavLink>
            <NavLink href="/panel/bledy" class="portal-nav-item" title="Zgłoszenia błędów">
                <i class="bi bi-bug"></i><span class="portal-label">Zgłoszenia błędów</span>
                @if (_bugs > 0)
                {
                    <span class="portal-dot" title="@($"Nowe zgłoszenia: {_bugs}")"></span>
                }
            </NavLink>
            <NavLink href="/panel/feedback" class="portal-nav-item" title="Oceny aplikacji">
                <i class="bi bi-star-half"></i><span class="portal-label">Oceny aplikacji</span>
            </NavLink>

            <div class="portal-nav-section"><span class="portal-label">System</span></div>
            <NavLink href="/panel/updates" class="portal-nav-item" title="Aktualizacje">
                <i class="bi bi-cloud-arrow-down"></i><span class="portal-label">Aktualizacje</span>
                @if (UpdateNotifier.UpgradeAvailable)
                {
                    <span class="portal-dot" title="Dostępna aktualizacja"></span>
                }
            </NavLink>
            <NavLink href="/panel/backups" class="portal-nav-item" title="Kopie zapasowe">
                <i class="bi bi-hdd-stack"></i><span class="portal-label">Kopie zapasowe</span>
            </NavLink>
            <NavLink href="/panel/resources" class="portal-nav-item" title="Serwer i zasoby">
                <i class="bi bi-cpu"></i><span class="portal-label">Serwer i zasoby</span>
            </NavLink>
            <NavLink href="/panel/logs" class="portal-nav-item" title="Logi">
                <i class="bi bi-journal-text"></i><span class="portal-label">Logi</span>
            </NavLink>
            <NavLink href="/panel/alerts" class="portal-nav-item" title="Alarmy">
                <i class="bi bi-bell"></i><span class="portal-label">Alarmy</span>
            </NavLink>
            <NavLink href="/panel/administratorzy" class="portal-nav-item" title="Administratorzy">
                <i class="bi bi-people"></i><span class="portal-label">Administratorzy</span>
            </NavLink>

            <div class="portal-nav-section"><span class="portal-label">Strona</span></div>
            <NavLink href="/panel/homepage" class="portal-nav-item" title="Edycja strony">
                <i class="bi bi-pencil-square"></i><span class="portal-label">Edycja strony</span>
            </NavLink>
            <a href="/" class="portal-nav-item" target="_blank" rel="noopener" title="Strona publiczna">
                <i class="bi bi-box-arrow-up-right"></i><span class="portal-label">Strona publiczna</span>
            </a>
        </nav>

        <div class="portal-sidebar-footer">
            <NavLink href="/panel/setup" class="portal-nav-item" title="Konfiguracja platformy">
                <i class="bi bi-gear"></i><span class="portal-label">Konfiguracja platformy</span>
            </NavLink>
            <NavLink href="/panel/change-password" class="portal-nav-item" title="Konto">
                <i class="bi bi-person-circle"></i><span class="portal-label">Konto</span>
            </NavLink>
            <NavLink href="/panel/bezpieczenstwo" class="portal-nav-item" title="Bezpieczeństwo (2FA)">
                <i class="bi bi-shield-check"></i><span class="portal-label">Bezpieczeństwo</span>
            </NavLink>
            <a href="/api/account/logout" class="portal-nav-item" title="Wyloguj">
                <i class="bi bi-box-arrow-left"></i><span class="portal-label">Wyloguj</span>
            </a>
        </div>
    </aside>

    <main class="portal-main">
        <StatusBar @rendermode="InteractiveServer" />
        <div class="portal-content">
            @Body
        </div>
    </main>
    <LeoAssistant @rendermode="InteractiveServer" />
</div>

@code {
    private int _todo;
    private int _mail;
    private int _bugs;
    private int _books;

    // Zgłoszenia ze sklepu czekające na zespół (nowe, zaakceptowane, w realizacji).
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();
            _todo = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(db.ServiceOrders,
                o => o.Status == PTScheduler.Portal.Entities.ServiceOrderStatus.Pending
                  || o.Status == PTScheduler.Portal.Entities.ServiceOrderStatus.Accepted
                  || o.Status == PTScheduler.Portal.Entities.ServiceOrderStatus.InProgress);
        }
        catch { _todo = 0; } // menu nie może się wywrócić przez bazę
        try
        {
            await using var db = DbFactory.CreateDbContext();
            _mail = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(db.InboxThreads,
                t => t.Folder == PTScheduler.Portal.Entities.InboxFolder.Inbox && t.Unread > 0);
        }
        catch { _mail = 0; }
        try
        {
            await using var db = DbFactory.CreateDbContext();
            _bugs = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(db.BugReports,
                r => r.Status == PTScheduler.Portal.Entities.BugReportStatus.New);
        }
        catch { _bugs = 0; }
        try
        {
            await using var db = DbFactory.CreateDbContext();
            _books = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(db.SalesDocuments,
                d => d.Status == PTScheduler.Portal.Entities.SalesDocumentStatus.Pending);
        }
        catch { _books = 0; }
    }
}
