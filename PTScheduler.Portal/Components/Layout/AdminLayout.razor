@inherits LayoutComponentBase
@inject PTScheduler.Portal.Services.UpdateNotifier UpdateNotifier

<div class="portal-shell">
    <aside class="portal-sidebar">
        <a href="/panel" class="portal-brand">
            <i class="bi bi-calendar-heart"></i>
            <span>PTScheduler</span>
        </a>

        <nav class="portal-nav">
            <a href="/panel" class="portal-nav-item">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
            <a href="/panel/tenants" class="portal-nav-item">
                <i class="bi bi-building"></i><span>Trenerzy</span>
            </a>
            <a href="/panel/provision" class="portal-nav-item">
                <i class="bi bi-plus-circle"></i><span>Nowa instancja</span>
            </a>
            <a href="/panel/import" class="portal-nav-item">
                <i class="bi bi-box-arrow-in-down"></i><span>Import z Dockera</span>
            </a>
            <a href="/panel/plans" class="portal-nav-item">
                <i class="bi bi-tags"></i><span>Plany cenowe</span>
            </a>
            <a href="/panel/finances" class="portal-nav-item">
                <i class="bi bi-cash-stack"></i><span>Finanse</span>
            </a>
            <a href="/panel/system" class="portal-nav-item">
                <i class="bi bi-cpu"></i><span>System</span>
            </a>
            <a href="/panel/updates" class="portal-nav-item">
                <i class="bi bi-cloud-arrow-down"></i>
                <span>Aktualizacje</span>
                @if (UpdateNotifier.UpgradeAvailable)
                {
                    <span class="badge bg-warning text-dark ms-auto" style="font-size:.65rem">NEW</span>
                }
            </a>

            <div class="portal-nav-divider"></div>

            <a href="/panel/homepage" class="portal-nav-item">
                <i class="bi bi-pencil-square"></i><span>Edycja strony</span>
            </a>
            <a href="/panel/domain" class="portal-nav-item">
                <i class="bi bi-globe"></i><span>Domena</span>
            </a>
            <a href="/panel/npm" class="portal-nav-item">
                <i class="bi bi-diagram-3"></i><span>NPM Proxy</span>
            </a>
            <a href="/panel/email" class="portal-nav-item">
                <i class="bi bi-envelope-at"></i><span>E-mail / SMTP</span>
            </a>
            <a href="/" class="portal-nav-item" target="_blank">
                <i class="bi bi-box-arrow-up-right"></i><span>Strona publiczna</span>
            </a>

            <div class="portal-nav-divider"></div>

            <a href="/panel/login-logs" class="portal-nav-item">
                <i class="bi bi-journal-text"></i><span>Logi logowań</span>
            </a>
            <a href="/panel/change-password" class="portal-nav-item">
                <i class="bi bi-shield-lock"></i><span>Zmień hasło</span>
            </a>
        </nav>

        <div class="portal-sidebar-footer">
            <a href="/api/account/logout" class="portal-nav-item">
                <i class="bi bi-box-arrow-left"></i><span>Wyloguj</span>
            </a>
        </div>
    </aside>

    <main class="portal-main">
        <div class="portal-content">
            @Body
        </div>
    </main>
</div>

<style>
    .portal-shell {
        display: flex;
        min-height: 100vh;
    }
    .portal-sidebar {
        width: 240px;
        background: #1a1d23;
        color: #9ca3af;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
    }
    .portal-brand {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: 1.2rem 1.25rem;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
    }
    .portal-brand i { color: #6366f1; font-size: 1.3rem; }
    .portal-nav {
        flex: 1;
        padding: .5rem .75rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow-y: auto;
        min-height: 0;
    }
    .portal-nav::-webkit-scrollbar { width: 6px; }
    .portal-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 3px; }
    .portal-nav-item {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .55rem .75rem;
        border-radius: .5rem;
        color: #9ca3af;
        text-decoration: none;
        font-size: .875rem;
        transition: all .15s;
    }
    .portal-nav-item:hover { background: rgba(255,255,255,.08); color: #fff; }
    .portal-nav-item i { font-size: 1.05rem; width: 20px; text-align: center; }
    .portal-nav-divider {
        height: 1px;
        background: rgba(255,255,255,.1);
        margin: .75rem 0;
    }
    .portal-sidebar-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid rgba(255,255,255,.08);
    }
    .portal-main {
        flex: 1;
        background: #f4f5f7;
        min-height: 100vh;
    }
    .portal-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    @@media (max-width: 768px) {
        .portal-sidebar { display: none; }
        .portal-content { padding: 1rem; }
    }
</style>
