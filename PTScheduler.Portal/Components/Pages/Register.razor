@page "/register"
@layout PublicLayout
@inject TenantService TenantSvc
@inject IDbContextFactory<PortalDbContext> DbFactory
@inject EmailService EmailSvc
@inject StripeService StripeSvc
@inject SiteSettingsService Settings
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Rejestracja — PTScheduler</PageTitle>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                @if (_done)
                {
                    <div class="text-center py-4">
                        @if (_provisioned)
                        {
                            <div style="width:70px;height:70px;border-radius:50%;background:#198754;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:2rem" class="mb-3">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <h3 class="fw-bold">Instancja gotowa!</h3>
                            <p class="text-muted">
                                Twoja aplikacja PTScheduler jest uruchomiona.
                            </p>
                            <div class="alert alert-success text-start">
                                <div class="mb-2"><strong>Link do Twojej aplikacji:</strong></div>
                                <a href="@_instanceUrl" target="_blank" class="btn btn-success btn-sm">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Otwórz @_form.CompanyName
                                </a>
                                <div class="small mt-2 text-muted">
                                    @_instanceUrl
                                </div>
                            </div>
                            <div class="alert alert-info small text-start">
                                <i class="bi bi-info-circle me-1"></i>
                                Po otwarciu przejdź przez <strong>kreator konfiguracji</strong> — utworzysz w nim konto admina i skonfigurujesz aplikację.
                                Link wysłaliśmy też na <strong>@_form.Email</strong>.
                            </div>
                        }
                        else if (_pendingPayment)
                        {
                            <div style="width:70px;height:70px;border-radius:50%;background:#f59e0b;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:2rem" class="mb-3">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <h3 class="fw-bold">Rejestracja przyjęta</h3>
                            <p class="text-muted">
                                Wybrałeś plan <strong>@(_selectedPlan?.Name)</strong> (@(_selectedPlan?.MonthlyPrice.ToString("0")) zł/mies.).
                            </p>
                            <div class="alert alert-warning text-start">
                                <i class="bi bi-envelope me-1"></i>
                                Skontaktujemy się z Tobą w ciągu 24h na <strong>@_form.Email</strong> z linkiem do płatności.
                                Po opłaceniu Twoja instancja zostanie uruchomiona automatycznie.
                            </div>
                        }
                        else
                        {
                            <div style="width:70px;height:70px;border-radius:50%;background:#dc2626;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:2rem" class="mb-3">
                                <i class="bi bi-exclamation-triangle"></i>
                            </div>
                            <h3 class="fw-bold">Rejestracja zapisana</h3>
                            <p class="text-muted">
                                Twoje dane zostały zapisane, ale uruchomienie instancji nie powiodło się.
                                Nasz zespół skontaktuje się z Tobą.
                            </p>
                            @if (!string.IsNullOrEmpty(_provisionError))
                            {
                                <div class="alert alert-danger small text-start">
                                    <strong>Szczegóły:</strong> @_provisionError
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Załóż konto trenera</h2>
                        <p class="text-muted">Wypełnij formularz — instancja będzie gotowa w kilka minut</p>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <EditForm Model="_form" OnValidSubmit="Submit" FormName="register">
                                <DataAnnotationsValidator />

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Imię i nazwisko</label>
                                        <InputText class="form-control" @bind-Value="_form.FullName" placeholder="Jan Kowalski" />
                                        <ValidationMessage For="() => _form.FullName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Email</label>
                                        <InputText class="form-control" type="email" @bind-Value="_form.Email" placeholder="jan@email.pl" />
                                        <ValidationMessage For="() => _form.Email" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Nazwa studia / firmy</label>
                                        <InputText class="form-control" @bind-Value="_form.CompanyName" placeholder="FitStudio Jan" />
                                        <ValidationMessage For="() => _form.CompanyName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Telefon <span class="text-muted">(opcjonalnie)</span></label>
                                        <InputText class="form-control" @bind-Value="_form.Phone" placeholder="+48 600 123 456" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">Plan</label>
                                        <div class="row g-2">
                                            @foreach (var p in _plans)
                                            {
                                                <div class="col-md-4">
                                                    <div class="plan-option @(_form.PlanId == p.Id ? "selected" : "")" @onclick="() => _form.PlanId = p.Id">
                                                        <div class="fw-bold">@p.Name</div>
                                                        <div class="small text-muted">
                                                            @(p.MonthlyPrice == 0 ? "0 zł" : $"{p.MonthlyPrice:0} zł/mies.") — @(p.MaxClients == int.MaxValue ? "bez limitu" : $"{p.MaxClients}") klientów
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-semibold">Jak chcesz skonfigurować?</label>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <div class="plan-option @(_form.SetupMode == "self" ? "selected" : "")" @onclick='() => _form.SetupMode = "self"'>
                                                    <div class="fw-bold"><i class="bi bi-tools me-1"></i>Sam/sama</div>
                                                    <div class="small text-muted">Kreator krok po kroku — bezpłatnie</div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="plan-option @(_form.SetupMode == "admin" ? "selected" : "")" @onclick='() => _form.SetupMode = "admin"'>
                                                    <div class="fw-bold"><i class="bi bi-headset me-1"></i>Nasz zespół</div>
                                                    <div class="small text-muted">Wszystko robimy za Ciebie — płatne</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (_error is not null)
                                {
                                    <div class="alert alert-danger py-2 small mt-3">@_error</div>
                                }

                                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4" disabled="@_saving">
                                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    <i class="bi bi-rocket-takeoff me-2"></i>Zarejestruj się
                                </button>

                                <p class="text-muted text-center small mt-3 mb-0">
                                    Masz już konto? <a href="/panel">Zaloguj się</a>
                                </p>
                            </EditForm>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .plan-option {
        border: 2px solid #e5e7eb;
        border-radius: .6rem;
        padding: .75rem 1rem;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        text-align: center;
    }
    .plan-option:hover { border-color: #6366f1; }
    .plan-option.selected { border-color: #6366f1; background: rgba(99,102,241,.05); }
</style>

@code {
    [SupplyParameterFromQuery] public string? Plan { get; set; }

    private List<Plan> _plans = [];
    private bool _saving;
    private bool _done;
    private bool _provisioned;
    private bool _pendingPayment;
    private string? _error;
    private string? _provisionError;
    private string? _instanceUrl;
    private Plan? _selectedPlan;
    private string _mainDomain = "ptscheduler.pl";
    private RegisterForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        _plans = await db.Plans
            .AsNoTracking()
            .Where(p => p.IsActive)
            .OrderBy(p => p.SortOrder)
            .ToListAsync();

        if (!string.IsNullOrEmpty(Plan))
            _form.PlanId = Plan;
        else if (_plans.Count > 0)
            _form.PlanId = _plans[0].Id;

        var md = await Settings.GetAsync(SiteSettingsService.Keys.MainDomain);
        if (!string.IsNullOrWhiteSpace(md)) _mainDomain = md;
    }

    private async Task Submit()
    {
        _error = null;
        _saving = true;

        try
        {
            _selectedPlan = _plans.FirstOrDefault(p => p.Id == _form.PlanId);
            if (_selectedPlan is null) throw new InvalidOperationException("Wybierz plan.");

            var slug = GenerateSlug(_form.CompanyName);
            var domain = _selectedPlan.CustomDomain
                ? $"{slug}.{_mainDomain}"
                : $"{slug}.{_mainDomain}";

            var tenant = await TenantSvc.CreateAsync(
                slug, domain,
                _form.CompanyName.Trim(),
                _form.FullName.Trim(),
                _form.Email.Trim().ToLowerInvariant(),
                _form.Phone?.Trim(),
                _form.PlanId,
                _form.SetupMode);

            // For free plans — provision immediately and email the trainer
            if (_selectedPlan.MonthlyPrice == 0)
            {
                var (ok, output) = await TenantSvc.ProvisionAsync(tenant.Id);
                if (ok)
                {
                    _instanceUrl = $"http://192.168.0.220:{tenant.Port}";
                    _provisioned = true;

                    var body = EmailSvc.WelcomeEmailBody(
                        _form.FullName, domain, tenant.Port.ToString(), _selectedPlan.Name);
                    _ = EmailSvc.SendAsync(_form.Email, "Twoja instancja PTScheduler jest gotowa!", body);
                }
                else
                {
                    _provisionError = output;
                }
                _done = true;
                return;
            }

            // For paid plans — try Stripe checkout; if not configured, fall back to "we'll contact you"
            if (await StripeSvc.IsConfiguredAsync())
            {
                var (ok, checkoutUrl, err) = await StripeSvc.StartSubscriptionCheckoutAsync(tenant.Id, "monthly");
                if (ok && !string.IsNullOrEmpty(checkoutUrl))
                {
                    Nav.NavigateTo(checkoutUrl, forceLoad: true);
                    return;
                }
                _provisionError = err ?? "Nie udało się utworzyć sesji płatności.";
            }

            _pendingPayment = true;
            var body2 = EmailSvc.PendingPaymentEmailBody(
                _form.FullName, _selectedPlan.Name, _selectedPlan.MonthlyPrice);
            _ = EmailSvc.SendAsync(_form.Email, "PTScheduler — dziękujemy za rejestrację", body2);

            _done = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string GenerateSlug(string name)
    {
        var slug = name.ToLowerInvariant()
            .Replace("ą", "a").Replace("ć", "c").Replace("ę", "e")
            .Replace("ł", "l").Replace("ń", "n").Replace("ó", "o")
            .Replace("ś", "s").Replace("ź", "z").Replace("ż", "z");

        slug = global::System.Text.RegularExpressions.Regex.Replace(slug, @"[^a-z0-9]+", "-").Trim('-');

        if (slug.Length < 3) slug += "-pt";
        return slug;
    }

    private class RegisterForm
    {
        [global::System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        public string FullName { get; set; } = "";

        [global::System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        [global::System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Nieprawidłowy email")]
        public string Email { get; set; } = "";

        [global::System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        public string CompanyName { get; set; } = "";

        public string? Phone { get; set; }
        public string PlanId { get; set; } = "start";
        public string SetupMode { get; set; } = "self";
    }
}
