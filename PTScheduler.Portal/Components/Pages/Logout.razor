@page "/logout"
@layout PublicLayout
@inject SignInManager<IdentityUser> SignInMgr
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Wylogowanie — PTScheduler Portal</PageTitle>

<section class="py-5">
    <div class="container text-center">
        <h3 class="fw-bold mb-3">Wylogowano</h3>
        <p class="text-muted mb-4">Zostałeś wylogowany z panelu administracyjnego.</p>
        <a href="/login" class="btn btn-primary">Zaloguj się ponownie</a>
    </div>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        await SignInMgr.SignOutAsync();
    }
}
