@page "/"
@layout PublicLayout
@inject SiteSettingsService Settings
@inject IDbContextFactory<PortalDbContext> DbFactory
@using System.Text.Json

<PageTitle>PTScheduler — aplikacja dla trenerów personalnych</PageTitle>
<HeadContent>
    <meta name="description" content="Grafik, rezerwacje online, karnety, płatności, czat z klientem i plany treningowe w jednej aplikacji pod Twoją marką. Zacznij za darmo." />
</HeadContent>

<div class="lp">

<!-- HERO -->
<section class="lp-hero">
    <div class="lp-container lp-hero-inner">
        <div>
            <div class="lp-hero-badge"><i class="bi bi-lightning-charge-fill"></i>@_s("hero_badge", "Dla trenerów personalnych i małych studiów")</div>
            @if (_settings.TryGetValue("hero_title", out var customTitle) && !string.IsNullOrWhiteSpace(customTitle)
                 && customTitle != SiteSettingsService.DefaultHeroTitle)
            {
                <h1>@customTitle</h1>
            }
            else
            {
                <h1>Mniej papierologii.<br /><span class="lp-mark">Więcej treningów.</span></h1>
            }
            <p class="lp-hero-sub">
                @_s("hero_subtitle", "Grafik i rezerwacje online, karnety, płatności, czat z klientem i plany treningowe — w jednej aplikacji pod Twoją marką. Klienci instalują ją na telefonie jak zwykłą apkę.")
            </p>
            <div class="lp-hero-ctas">
                <a href="@_s("hero_cta_url", "/register")" class="lp-btn lp-btn-energy"><i class="bi bi-rocket-takeoff"></i>@_s("hero_cta", "Zacznij za darmo")</a>
                <a href="#funkcje" class="lp-btn lp-btn-ghost">Zobacz, co potrafi</a>
            </div>
            <div class="lp-hero-trust">
                <span><i class="bi bi-check-circle-fill"></i>Bez karty płatniczej</span>
                <span><i class="bi bi-check-circle-fill"></i>Gotowe w 5 minut</span>
                <span><i class="bi bi-check-circle-fill"></i>Rezygnujesz, kiedy chcesz</span>
            </div>
        </div>

        <div class="lp-stage" aria-hidden="true">
            <div class="lp-float-card lp-float-week">
                <div class="lp-float-title">Twój tydzień</div>
                <div class="lp-week">
                    @foreach (var (day, slots) in _weekPreview)
                    {
                        <div class="lp-week-col">
                            <div class="lp-week-day">@day</div>
                            @foreach (var s in slots)
                            {
                                <div class="lp-slot @s"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="lp-phone">
                <div class="lp-phone-screen">
                    <div class="lp-phone-notch"></div>
                    <div class="lp-phone-time">7:42</div>
                    <div class="lp-phone-date">wtorek, 14 października</div>
                    <div class="lp-notif">
                        <div class="lp-notif-icon" style="background:#7C3AED"><i class="bi bi-calendar-check"></i></div>
                        <div><div class="lp-notif-title">Nowa rezerwacja</div><div class="lp-notif-body">Marta K. — czwartek 18:00, trening personalny</div></div>
                        <div class="lp-notif-time">teraz</div>
                    </div>
                    <div class="lp-notif">
                        <div class="lp-notif-icon" style="background:#05B88A"><i class="bi bi-wallet2"></i></div>
                        <div><div class="lp-notif-title">Płatność przyjęta</div><div class="lp-notif-body">Karnet „8 treningów” — 640 zł, BLIK</div></div>
                        <div class="lp-notif-time">5 min</div>
                    </div>
                    <div class="lp-notif">
                        <div class="lp-notif-icon" style="background:#FF6B35"><i class="bi bi-chat-dots"></i></div>
                        <div><div class="lp-notif-title">Tomek W.</div><div class="lp-notif-body">Zrobione! Przysiad 100 kg 🔥</div></div>
                        <div class="lp-notif-time">12 min</div>
                    </div>
                </div>
            </div>

            <div class="lp-float-card lp-float-rev">
                <div class="lp-stars">★★★★★</div>
                <div style="font-size:.85rem;margin-top:4px">„Najlepsza inwestycja w formę od lat.”</div>
                <div style="font-size:.75rem;color:var(--pts-text-secondary);margin-top:4px">Ania P. — opinia na stronie trenera</div>
            </div>
        </div>
    </div>
</section>

<!-- KONIEC Z… -->
<div class="lp-pain">
    <div class="lp-container lp-pain-inner">
        <span class="lp-pain-label">Koniec z:</span>
        <s>grafikiem w Excelu</s>
        <s>przypominaniem na WhatsAppie</s>
        <s>liczeniem sesji w zeszycie</s>
        <s>gonieniem za przelewami</s>
    </div>
</div>

<!-- FUNKCJE WG ZADAŃ -->
<section class="lp-section" id="funkcje">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-eyebrow">Co zyskujesz</div>
            <h2 class="lp-section-title">@_s("section_title", "Wszystko, czego potrzebuje trener — w jednym miejscu")</h2>
            <p class="lp-section-sub">Zamiast pięciu aplikacji i arkusza: jedna, która pilnuje grafiku, pieniędzy i kontaktu z klientem za Ciebie.</p>
        </div>

        <div class="lp-job">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-calendar3"></i>Grafik</div>
                <h3>Grafik, który sam się pilnuje</h3>
                <p>Ustawiasz godziny pracy, a klienci rezerwują wolne terminy sami — z telefonu, o 23:00, bez pisania do Ciebie.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Rezerwacje online, serie stałych treningów i pierwsza wizyta z Twojej strony</li>
                    <li><i class="bi bi-check-circle-fill"></i>Przypomnienia e-mail, SMS i push — mniej nieobecności</li>
                    <li><i class="bi bi-check-circle-fill"></i>Polityka odwołań: późne odwołanie = sesja przepada, bez tłumaczenia się</li>
                    <li><i class="bi bi-check-circle-fill"></i>Wizyty w kalendarzu Google, Apple i Outlook</li>
                </ul>
            </div>
            <div class="lp-panel" aria-hidden="true">
                <div class="lp-panel-head"><span class="lp-panel-title">Tydzień 13–17 października</span><span class="lp-chip lp-chip-violet">12 sesji</span></div>
                <div class="lp-cal">
                    <div></div><div class="lp-cal-h">Pn</div><div class="lp-cal-h">Wt</div><div class="lp-cal-h">Śr</div><div class="lp-cal-h">Cz</div><div class="lp-cal-h">Pt</div>
                    <div class="lp-cal-t">7:00</div><div class="lp-cal-c a">Marta K.</div><div class="lp-cal-c"></div><div class="lp-cal-c a">Marta K.</div><div class="lp-cal-c"></div><div class="lp-cal-c b">Ola i Piotr</div>
                    <div class="lp-cal-t">17:00</div><div class="lp-cal-c b">Tomek W.</div><div class="lp-cal-c c">Online</div><div class="lp-cal-c"></div><div class="lp-cal-c b">Tomek W.</div><div class="lp-cal-c"></div>
                    <div class="lp-cal-t">18:00</div><div class="lp-cal-c"></div><div class="lp-cal-c a">Kasia L.</div><div class="lp-cal-c a">Nowy klient</div><div class="lp-cal-c a">Marta K.</div><div class="lp-cal-c c">Online</div>
                </div>
                <div class="lp-toast"><i class="bi bi-exclamation-circle-fill"></i><span>Odwołanie 3 h przed treningiem — sesja pobrana z pakietu.</span></div>
            </div>
        </div>

        <div class="lp-job flip">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-wallet2"></i>Pieniądze</div>
                <h3>Płacą z góry. Ty nie gonisz przelewów.</h3>
                <p>Pakiety sesji i karnety miesięczne opłacane online. Aplikacja sama liczy, ile treningów zostało, i przypomina o odnowieniu.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Pakiety i karnety cykliczne — co miesiąc ta sama liczba sesji za stałą cenę</li>
                    <li><i class="bi bi-check-circle-fill"></i>PayU i Przelewy24 (BLIK, karta, przelew) — pieniądze trafiają na Twoje konto</li>
                    <li><i class="bi bi-check-circle-fill"></i>Kupony rabatowe i sklep z pakietami na Twojej stronie</li>
                    <li><i class="bi bi-check-circle-fill"></i>Faktury PDF i wysyłka do KSeF</li>
                </ul>
            </div>
            <div class="lp-panel" aria-hidden="true">
                <div class="lp-panel-head"><span class="lp-panel-title">Ostatnie wpłaty</span><span class="lp-chip lp-chip-ok">+ 2 180 zł w tym tygodniu</span></div>
                <div class="lp-rows">
                    <div class="lp-row"><div class="lp-row-icon" style="background:#D1FAE5;color:#047857"><i class="bi bi-arrow-repeat"></i></div><div class="lp-row-main">Karnet „8 treningów”<small>Marta K. · odnowiony automatycznie</small></div><div class="lp-row-amount">640 zł</div></div>
                    <div class="lp-row"><div class="lp-row-icon" style="background:#EDE9FE;color:#5B21B6"><i class="bi bi-box-seam"></i></div><div class="lp-row-main">Pakiet 10 sesji<small>Tomek W. · BLIK</small></div><div class="lp-row-amount">1 100 zł</div></div>
                    <div class="lp-row"><div class="lp-row-icon" style="background:#FFEDD5;color:#C2410C"><i class="bi bi-receipt"></i></div><div class="lp-row-main">Faktura FV/10/2026<small>Wysłana do KSeF</small></div><span class="lp-chip lp-chip-ok"><i class="bi bi-check2"></i>przyjęta</span></div>
                </div>
            </div>
        </div>

        <div class="lp-job">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-people"></i>Klienci</div>
                <h3>Klient ma Cię w telefonie — a Ty widzisz jego postępy</h3>
                <p>Każdy klient dostaje aplikację z Twoim logo: grafik, plan treningowy, czat z Tobą i swoje wyniki w jednym miejscu.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Czat z powiadomieniami — koniec z mieszaniem pracy i prywatnego WhatsAppa</li>
                    <li><i class="bi bi-check-circle-fill"></i>Plany treningowe z katalogiem ćwiczeń, dziennik i rekordy klienta</li>
                    <li><i class="bi bi-check-circle-fill"></i>Pomiary i zdjęcia sylwetki przed/po — widoczne tylko dla Ciebie i klienta</li>
                    <li><i class="bi bi-check-circle-fill"></i>Ankieta zdrowotna zgodna z RODO i kursy wideo do sprzedaży</li>
                </ul>
            </div>
            <div class="lp-panel" aria-hidden="true">
                <div class="lp-panel-head"><span class="lp-panel-title">Tomek W.</span><span class="lp-chip lp-chip-violet"><i class="bi bi-graph-up-arrow"></i>−4,2 kg</span></div>
                <div class="lp-chat">
                    <div class="lp-bubble in">Dzisiaj na siłowni nowy rekord: przysiad 100 kg!</div>
                    <div class="lp-bubble out">Brawo! Od przyszłego tygodnia dokładamy 2,5 kg 💪</div>
                </div>
                <div class="lp-compare">
                    <div class="lp-compare-img"><span>1 sierpnia</span></div>
                    <div class="lp-compare-img after"><span>1 października</span></div>
                </div>
            </div>
        </div>

        <div class="lp-job flip">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-megaphone"></i>Rozwój</div>
                <h3>Nowi klienci z polecenia, nie z reklam</h3>
                <p>Zadowoleni klienci polecają Cię dalej — a aplikacja nagradza ich za to automatycznie i zbiera opinie na Twoją stronę.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Program poleceń: link dla klienta, nagroda po pierwszym treningu znajomego</li>
                    <li><i class="bi bi-check-circle-fill"></i>Prośba o opinię po kilku treningach i link do opinii w Google</li>
                    <li><i class="bi bi-check-circle-fill"></i>Twoja strona z ofertą, opiniami i rezerwacją pierwszej wizyty</li>
                </ul>
            </div>
            <div class="lp-panel" aria-hidden="true">
                <div class="lp-panel-head"><span class="lp-panel-title">Polecenia</span><span class="lp-chip lp-chip-ok">3 nowych klientów</span></div>
                <div class="lp-rows">
                    <div class="lp-row"><div class="lp-row-icon" style="background:#EDE9FE;color:#5B21B6"><i class="bi bi-gift"></i></div><div class="lp-row-main">Marta K. poleciła Julię<small>Nagroda: 1 darmowa sesja</small></div><span class="lp-chip lp-chip-ok">przyznana</span></div>
                    <div class="lp-row"><div class="lp-row-icon" style="background:#FFF7E6;color:#B45309"><i class="bi bi-star-fill"></i></div><div class="lp-row-main">„Trener, który naprawdę słucha”<small>Julia S. · ★★★★★ · na Twojej stronie</small></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WSZYSTKO W PAKIECIE -->
<section class="lp-section lp-section-alt">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-eyebrow">W pakiecie</div>
            <h2 class="lp-section-title">I jeszcze to wszystko</h2>
        </div>
        <div class="lp-all">
            @foreach (var f in _all)
            {
                <div class="lp-all-item"><i class="bi @f.Icon"></i><div><strong>@f.Title</strong><span>@f.Text</span></div></div>
            }
        </div>
    </div>
</section>

<!-- TWOJA MARKA -->
<section class="lp-section">
    <div class="lp-container lp-brand">
        <div>
            <div class="lp-eyebrow">Twoja marka</div>
            <h2 class="lp-section-title" style="text-align:left">Klienci widzą Ciebie, nie nas</h2>
            <p class="lp-section-sub">Własne logo, kolory i adres — a do tego gotowa strona z ofertą, opiniami i przyciskiem „Umów trening”. Możesz podpiąć własną domenę; certyfikat SSL ustawiamy automatycznie.</p>
            <div class="lp-brand-swatches" aria-hidden="true">
                <span style="background:#0F766E"></span><span style="background:#7C3AED"></span><span style="background:#E11D48"></span><span style="background:#EA580C"></span><span style="background:#1E293B"></span>
            </div>
            <ul class="lp-ticks">
                <li><i class="bi bi-check-circle-fill"></i>Adres <strong>twoja-nazwa.ptscheduler.pl</strong> albo własna domena</li>
                <li><i class="bi bi-check-circle-fill"></i>E-maile do klientów z nazwą Twojego studia</li>
                <li><i class="bi bi-check-circle-fill"></i>Bez konfigurowania serwerów, poczty i SMS-ów — to po naszej stronie</li>
            </ul>
        </div>
        <div class="lp-site" aria-hidden="true">
            <div class="lp-site-bar"><b></b><b></b><b></b><span class="lp-site-url">studio-kasi.pl</span></div>
            <div class="lp-site-hero">
                <h4>Studio Kasi — trening personalny</h4>
                <p>Siła, sylwetka i zdrowe plecy. Warszawa Mokotów i online.</p>
                <a href="#" tabindex="-1">Umów pierwszy trening</a>
            </div>
            <div class="lp-site-body"><div>Oferta i pakiety</div><div>★ 4,9 · 38 opinii</div><div>Kursy online</div></div>
        </div>
    </div>
</section>

<!-- JAK ZACZĄĆ -->
<section class="lp-section lp-section-alt">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-eyebrow">Jak zacząć</div>
            <h2 class="lp-section-title">Pierwszych klientów zaprosisz jeszcze dziś</h2>
        </div>
        <div class="lp-steps">
            <div class="lp-step"><h3>Załóż konto</h3><p>Imię, e-mail i nazwa studia. Dostajesz gotową aplikację pod własnym adresem — bez instalowania czegokolwiek.</p></div>
            <div class="lp-step"><h3>Ustaw swoje zasady</h3><p>Godziny pracy, typy treningów, pakiety i ceny, zasady odwołań. Kreator prowadzi krok po kroku.</p></div>
            <div class="lp-step"><h3>Wyślij link klientom</h3><p>Klienci zakładają konto, rezerwują i płacą online. Ty widzisz wszystko w jednym grafiku.</p></div>
        </div>
    </div>
</section>

<!-- CENNIK -->
<section class="lp-section" id="cennik">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-eyebrow">Cennik</div>
            <h2 class="lp-section-title">Płacisz za to, czego używasz. Bez umów.</h2>
            <p class="lp-section-sub">Zacznij za darmo i przejdź na wyższy plan, gdy przybędzie klientów. Zmiana planu zajmuje minutę.</p>
        </div>
        <div class="lp-pricing">
            @foreach (var plan in _plans)
            {
                <div class="lp-price @(plan.IsFeatured ? "featured" : "")">
                    @if (plan.IsFeatured)
                    {
                        <div class="lp-price-badge">Najczęściej wybierany</div>
                    }
                    <h3>@plan.Name</h3>
                    <p class="lp-price-desc">@plan.Description</p>
                    <div class="lp-price-amount">@plan.MonthlyPrice.ToString("0") <small>@(plan.MonthlyPrice == 0 ? "zł" : "zł / mies.")</small></div>
                    <div class="lp-price-period">
                        @if (plan.MonthlyPrice == 0) { @($"{plan.TrialDays} dni za darmo") }
                        else if (plan.YearlyPrice is > 0) { @($"lub {plan.YearlyPrice:0} zł rocznie") @(plan.TrialDays > 0 ? $" · {plan.TrialDays} dni za darmo" : "") }
                        else if (plan.TrialDays > 0) { @($"{plan.TrialDays} dni za darmo na start") }
                    </div>
                    <ul>
                        @foreach (var (label, included) in PlanFeatures(plan))
                        {
                            <li class="@(included ? "" : "off")"><i class="bi @(included ? "bi-check-circle-fill" : "bi-dash-circle")"></i>@label</li>
                        }
                    </ul>
                    <a href="/register?plan=@plan.Id" class="lp-btn @(plan.IsFeatured ? "lp-btn-primary" : "lp-btn-ghost")">
                        @(plan.MonthlyPrice == 0 ? "Zacznij za darmo" : $"Wybieram {plan.Name}")
                    </a>
                </div>
            }
        </div>
        <p class="lp-price-note">SMS-y i dodatkowe miejsce na wideo dokupujesz w aplikacji, tylko jeśli ich potrzebujesz. Ceny brutto.</p>
    </div>
</section>

@if (_trainers.Count > 0)
{
    <section class="lp-section lp-section-alt" style="padding:64px 0">
        <div class="lp-container">
            <div class="lp-section-head" style="margin-bottom:28px">
                <div class="lp-eyebrow">Z nami trenują</div>
            </div>
            <div class="lp-trainers">
                @foreach (var t in _trainers)
                {
                    <a class="lp-trainer" href="@(string.IsNullOrWhiteSpace(t.Instagram) ? "#" : $"https://instagram.com/{t.Instagram.TrimStart('@')}")" target="_blank" rel="noopener">
                        <span class="lp-trainer-avatar" style="background:@t.Color">@t.Initials</span>@t.Name
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- FAQ -->
<section class="lp-section" id="faq">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-eyebrow">Pytania</div>
            <h2 class="lp-section-title">Najczęstsze pytania</h2>
        </div>
        <div class="lp-faq">
            @for (var i = 0; i < _faqs.Length; i++)
            {
                var f = _faqs[i];
                <details open="@(i == 0)">
                    <summary>@f.Question<i class="bi bi-plus-lg"></i></summary>
                    <p>@f.Answer</p>
                </details>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="lp-cta">
    <div class="lp-container">
        <h2>@_s("cta_title", "Oddaj papierologię aplikacji. Wróć do trenowania.")</h2>
        <p>@_s("cta_subtitle", "Załóż konto w 5 minut i zaproś pierwszych klientów jeszcze dziś. Plan startowy jest za darmo.")</p>
        <a href="/register" class="lp-btn lp-btn-white"><i class="bi bi-rocket-takeoff"></i>@_s("cta_button", "Zacznij za darmo")</a>
    </div>
</section>

</div>

@code {
    private Dictionary<string, string> _settings = new();
    private List<Plan> _plans = [];
    private List<FeaturedTrainer> _trainers = [];

    private class FeaturedTrainer
    {
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
        public string Instagram { get; set; } = "";
        public string Color { get; set; } = "#7C3AED";
    }

    private static readonly (string Day, string[] Slots)[] _weekPreview =
    [
        ("Pn", ["s1", "", "s4", "s2"]),
        ("Wt", ["", "s3", "s1", ""]),
        ("Śr", ["s1", "s4", "", "s2"]),
        ("Cz", ["s2", "", "s1", "s4"]),
        ("Pt", ["s3", "s1", "", ""])
    ];

    private record Feature(string Icon, string Title, string Text);

    private static readonly Feature[] _all =
    [
        new("bi-phone", "Aplikacja na telefon", "Klienci instalują ją z przeglądarki — ikona, pełny ekran, powiadomienia."),
        new("bi-bell", "Przypomnienia", "E-mail, SMS i push przed treningiem. Treści edytujesz po polsku."),
        new("bi-arrow-repeat", "Karnety cykliczne", "Stała liczba sesji co miesiąc, rozliczana automatycznie."),
        new("bi-chat-dots", "Czat z klientem", "Wiadomości z powiadomieniami, historia w jednym miejscu."),
        new("bi-clipboard2-pulse", "Plany treningowe", "Katalog ćwiczeń po polsku, dziennik i rekordy klienta."),
        new("bi-camera", "Zdjęcia sylwetki", "Porównanie przed/po, prywatnie — tylko Ty i klient."),
