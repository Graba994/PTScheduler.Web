@page "/"
@layout PublicLayout
@inject SiteSettingsService Settings
@inject IDbContextFactory<PortalDbContext> DbFactory

<PageTitle>PTScheduler — Platforma dla trenerów personalnych</PageTitle>

<!-- Hero -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center" style="min-height:75vh">
            <div class="col-lg-6">
                <div class="hero-badge">@_s("hero_badge")</div>
                <h1 class="hero-title">@_s("hero_title")</h1>
                <p class="hero-sub">@_s("hero_subtitle")</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@_s("hero_cta_url")" class="btn btn-primary btn-lg">
                        <i class="bi bi-rocket-takeoff me-2"></i>@_s("hero_cta")
                    </a>
                    <a href="/pricing" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-tag me-2"></i>Zobacz cennik
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block text-center">
                <div class="hero-mockup">
                    <div class="mockup-header">
                        <span class="mockup-dot" style="background:#ff5f57"></span>
                        <span class="mockup-dot" style="background:#febc2e"></span>
                        <span class="mockup-dot" style="background:#28c840"></span>
                    </div>
                    <div class="mockup-body">
                        <div class="mockup-sidebar"></div>
                        <div class="mockup-content">
                            <div class="mockup-card"></div>
                            <div class="mockup-card" style="width:75%"></div>
                            <div class="mockup-card" style="width:50%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="py-5" style="background:#f8f9fa">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">@_s("section_title")</h2>
        <div class="row g-4">
            @foreach (var f in _features)
            {
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon" style="background:@f.BgColor;color:@f.IconColor">
                            <i class="bi @f.Icon"></i>
                        </div>
                        <h5 class="fw-bold">@f.Title</h5>
                        <p class="text-muted small mb-0">@f.Text</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Pricing -->
<section class="py-5" id="pricing">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Cennik</h2>
        <div class="row g-4 justify-content-center">
            @foreach (var p in _plans)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100 @(p.IsFeatured ? "border-primary border-2" : "")">
                        @if (p.IsFeatured)
                        {
                            <div class="text-center pt-2">
                                <span class="badge bg-primary">Najpopularniejszy</span>
                            </div>
                        }
                        <div class="card-body text-center p-4">
                            <h5 class="fw-bold">@p.Name</h5>
                            <p class="text-muted small">@p.Description</p>
                            <div class="my-3">
                                <span class="fs-2 fw-bold">@p.MonthlyPrice.ToString("0")</span>
                                <span class="text-muted">zł/mies.</span>
                            </div>
                            <ul class="list-unstyled text-start small">
                                <li class="mb-1"><i class="bi bi-check text-success me-1"></i>Max @(p.MaxClients == int.MaxValue ? "∞" : p.MaxClients.ToString()) klientów</li>
                                <li class="mb-1"><i class="bi @(p.PaymentsEnabled ? "bi-check text-success" : "bi-x text-muted") me-1"></i>Płatności online</li>
                                <li class="mb-1"><i class="bi @(p.CoursesEnabled ? "bi-check text-success" : "bi-x text-muted") me-1"></i>Kursy wideo</li>
                                <li class="mb-1"><i class="bi @(p.CustomDomain ? "bi-check text-success" : "bi-x text-muted") me-1"></i>Własna domena</li>
                                <li class="mb-1"><i class="bi @(p.PrioritySupport ? "bi-check text-success" : "bi-x text-muted") me-1"></i>Priorytetowe wsparcie</li>
                            </ul>
                            <a href="/register" class="btn @(p.IsFeatured ? "btn-primary" : "btn-outline-primary") w-100">
                                @(p.MonthlyPrice == 0 ? "Zacznij za darmo" : "Wybierz plan")
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- How it works -->
<section class="py-5" style="background:#f8f9fa">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Jak to działa?</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4 text-center">
                <div class="step-num">1</div>
                <h6 class="fw-bold">Załóż konto</h6>
                <p class="text-muted small">Rejestracja i wybór planu. Start jest bezpłatny.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="step-num">2</div>
                <h6 class="fw-bold">Skonfiguruj</h6>
                <p class="text-muted small">Sam lub z naszą pomocą — logo, kolory, płatności, domena.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="step-num">3</div>
                <h6 class="fw-bold">Zarabiaj</h6>
                <p class="text-muted small">Twoi klienci rezerwują, płacą i trenują. Ty zarządzasz z jednego miejsca.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section style="padding:4rem 0;background:linear-gradient(135deg,#6366f1,#4f46e5)">
    <div class="container text-center">
        <h2 class="fw-bold text-white mb-3">@_s("cta_title")</h2>
        <p class="text-white-50 mb-4">@_s("cta_subtitle")</p>
        <a href="/register" class="btn btn-light btn-lg fw-semibold">
            <i class="bi bi-rocket-takeoff me-2"></i>@_s("cta_button")
        </a>
    </div>
</section>

<style>
    .hero-section { padding:4rem 0 3rem; background:linear-gradient(135deg,#f8f9ff,#e8f0fe); }
    .hero-badge { display:inline-block; padding:.35rem .85rem; background:rgba(99,102,241,.1); color:#6366f1; border-radius:2rem; font-size:.8rem; font-weight:600; margin-bottom:1rem; }
    .hero-title { font-size:2.5rem; font-weight:800; line-height:1.15; margin-bottom:1.25rem; }
    .hero-sub { font-size:1.1rem; color:#6b7280; margin-bottom:2rem; max-width:500px; }
    .hero-mockup { background:#fff; border-radius:1rem; box-shadow:0 20px 60px rgba(0,0,0,.12); overflow:hidden; max-width:400px; margin:0 auto; }
    .mockup-header { background:#f1f3f5; padding:.6rem 1rem; display:flex; gap:6px; }
    .mockup-dot { width:10px; height:10px; border-radius:50%; }
    .mockup-body { display:flex; min-height:250px; }
    .mockup-sidebar { width:60px; background:#1a1d23; }
    .mockup-content { flex:1; padding:1rem; display:flex; flex-direction:column; gap:.75rem; }
    .mockup-card { height:40px; background:#e8f0fe; border-radius:.5rem; }
    .feature-card { background:#fff; border-radius:.75rem; padding:1.5rem; height:100%; box-shadow:0 1px 4px rgba(0,0,0,.06); transition:transform .2s,box-shadow .2s; }
    .feature-card:hover { transform:translateY(-3px); box-shadow:0 6px 20px rgba(0,0,0,.1); }
    .feature-icon { width:48px; height:48px; border-radius:.6rem; display:flex; align-items:center; justify-content:center; font-size:1.3rem; margin-bottom:1rem; }
    .step-num { width:48px; height:48px; border-radius:50%; background:#6366f1; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:1.2rem; font-weight:700; margin-bottom:.75rem; }
</style>

@code {
    private Dictionary<string, string> _settings = new();
    private List<Plan> _plans = [];

    private record FeatureInfo(string Icon, string Title, string Text, string BgColor, string IconColor);

    private readonly FeatureInfo[] _features =
    [
        new("bi-calendar-check", "Grafik i rezerwacje", "Kalendarz, dostępność, rezerwacje online. Serie treningów i sesje wstępne.", "rgba(13,110,253,.1)", "#0d6efd"),
        new("bi-credit-card", "Płatności online", "PayU, Przelewy24, Klarna, AutoPay — klienci płacą online, Ty dostajesz pieniądze.", "rgba(25,135,84,.1)", "#198754"),
        new("bi-collection-play", "Kursy i mentoring", "Sprzedawaj kursy wideo, materiały treningowe i plany dietetyczne.", "rgba(13,202,240,.1)", "#0dcaf0"),
        new("bi-box-seam", "Pakiety treningowe", "Pakiety sesji z automatycznym rozliczaniem. Klient kupuje online.", "rgba(255,193,7,.1)", "#ffc107"),
        new("bi-palette", "Twój branding", "Logo, kolory, domena, landing page — wygląda jak Twoja własna apka.", "rgba(220,53,69,.1)", "#dc3545"),
        new("bi-phone", "PWA — jak apka", "Klienci instalują aplikację na telefonie prosto z przeglądarki.", "rgba(108,117,125,.1)", "#6c757d"),
    ];

    protected override async Task OnInitializedAsync()
    {
        _settings = await Settings.GetAllAsync(
            SiteSettingsService.Keys.HeroBadge,
            SiteSettingsService.Keys.HeroTitle,
            SiteSettingsService.Keys.HeroSubtitle,
            SiteSettingsService.Keys.HeroCta,
            SiteSettingsService.Keys.HeroCtaUrl,
            SiteSettingsService.Keys.SectionTitle,
            SiteSettingsService.Keys.CtaTitle,
            SiteSettingsService.Keys.CtaSubtitle,
            SiteSettingsService.Keys.CtaButton);

        await using var db = DbFactory.CreateDbContext();
        _plans = await db.Plans
            .AsNoTracking()
            .Where(p => p.IsActive)
            .OrderBy(p => p.SortOrder)
            .ToListAsync();
    }

    private string _s(string key) => _settings.GetValueOrDefault(key, "");
}
