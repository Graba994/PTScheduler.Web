    .lp-price-features li:last-child { border-bottom: none; }
    .lp-pf-check { color: var(--pts-accent); font-size: 18px; }
    .lp-pf-x { color: var(--pts-text-secondary); opacity: 0.4; font-size: 18px; }
    .lp-price-cta { width: 100%; justify-content: center; }

    /* ===== FAQ ===== */
    .lp-faq-list { max-width: 720px; margin: 0 auto; }
    .lp-faq-item {
        border-bottom: 1px solid var(--pts-border);
        padding: 20px 0;
    }
    .lp-faq-q {
        font-family: var(--pts-font-display);
        font-weight: 600; font-size: 1.05rem;
