<script suppress-error="BL9992">
    (function() {
        function initReveal() {
            var sections = document.querySelectorAll('.lp-reveal');
            if (!sections.length) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                sections.forEach(function(s) { s.classList.add('lp-visible'); });
                document.querySelectorAll('.lp-reveal-child').forEach(function(c) { c.classList.add('lp-visible'); });
                return;
            }
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('lp-visible');
                        var children = entry.target.querySelectorAll('.lp-reveal-child');
                        children.forEach(function(child, i) {
                            setTimeout(function() { child.classList.add('lp-visible'); }, 80 + i * 90);
                        });
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
            sections.forEach(function(s) { observer.observe(s); });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initReveal);
        } else {
            initReveal();
        }
        document.addEventListener('enhanced-nav-end', initReveal);
    })();
</script>

