    @@media (max-width: 600px) {
        .lp-features-grid { grid-template-columns: 1fr; }
        .lp-video-storyboard { grid-template-columns: 1fr 1fr; }
        .lp-hero-ctas { flex-direction: column; }
        .lp-hero-ctas .lp-btn { width: 100%; justify-content: center; }
    }
