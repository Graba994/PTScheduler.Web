    }
    .lp-cta-inner p { color: rgba(255,255,255,0.7); font-size: 1.1rem; margin-bottom: 32px; }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 900px) {
        .lp-hero-inner { grid-template-columns: 1fr; gap: 40px; }
        .lp-hero-device { max-width: 500px; margin: 0 auto; }
