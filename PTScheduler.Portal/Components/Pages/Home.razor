@if (_reviews.Count > 0)
{
    <!-- OPINIE TRENERÓW -->
    <section class="lp-section lp-section-alt lp-reviews" id="opinie">
        <div class="lp-container">
            <div class="lp-section-head">
                <div class="lp-eyebrow">Opinie trenerów</div>
                <h2 class="lp-section-title">Co mówią trenerzy, którzy już z nami pracują</h2>
                <p class="lp-section-sub"><span class="lp-stars">★★★★★</span> średnio @_reviews.Average(r => r.Rating).ToString("0.0", Pl) z @_reviews.Count opinii w aplikacji</p>
            </div>
        </div>
        @if (_reviews.Count >= 3)
        {
            var rows = _reviews.Count >= 6 ? new[] { _reviews.Where((_, i) => i % 2 == 0).ToList(), _reviews.Where((_, i) => i % 2 == 1).ToList() } : new[] { _reviews };
            @for (var r = 0; r < rows.Length; r++)
            {
                var row = rows[r];
                <div class="lp-marquee @(r == 1 ? "reverse" : "")" style="--dur:@(Math.Max(30, row.Count * 9))s">
                    <div class="lp-marquee-track">
                        @foreach (var copy in new[] { false, true })
                        {
                            @foreach (var f in row)
                            {
                                @ReviewCard(f, copy)
                            }
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="lp-container">
                <div class="lp-reviews-grid">
                    @foreach (var f in _reviews) { @ReviewCard(f, false) }
                </div>
            </div>
        }
    </section>
}

