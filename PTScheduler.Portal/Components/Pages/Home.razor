@code {
    private Dictionary<string, string> _settings = new();
    private List<Plan> _plans = [];
    private int? _openFaq = 0;

    private record FeatureCard(string Icon, string Title, string Text, string BgColor, string IconColor);

    private readonly FeatureCard[] _featureCards =
    [
        new("group", "Zarządzanie klientami", "Profil, historia sesji, pomiary ciała, pakiety, notatki. Zatwierdzanie nowych klientów.", "rgba(59,130,246,0.1)", "#3B82F6"),
        new("payments", "Płatności online", "PayU, Przelewy24 — klienci płacą za pakiety i kursy jednym kliknięciem. Potwierdzenia automatycznie.", "rgba(6,214,160,0.1)", "#06D6A0"),
        new("confirmation_number", "Kupony i rabaty", "Kody procentowe i kwotowe. Limity użyć, daty ważności, przypisanie do konkretnych pakietów.", "rgba(245,158,11,0.1)", "#F59E0B"),
        new("monitoring", "Pomiary ciała", "Waga, obwody, BMI, tkanka tłuszczowa. Wykresy postępów dla klienta i trenera.", "rgba(236,72,153,0.1)", "#EC4899"),
        new("email", "Powiadomienia", "Przypomnienia email i SMS przed sesją. Edytowalne szablony wiadomości w języku polskim.", "rgba(124,58,237,0.1)", "#7C3AED"),
        new("video_call", "Google Meet", "Automatyczne tworzenie linków Meet dla sesji online. Klient dołącza jednym kliknięciem.", "rgba(34,197,94,0.1)", "#22C55E"),
        new("brush", "Branding", "Własne logo, kolory, favicon, domena. Aplikacja wygląda jak Twoja — klienci widzą Twoją markę.", "rgba(239,68,68,0.1)", "#EF4444"),
        new("bar_chart", "Raporty i analizy", "Przychody, frekwencja, popularność typów sesji. Eksport danych do CSV.", "rgba(99,102,241,0.1)", "#6366F1"),
        new("admin_panel_settings", "Role i uprawnienia", "Admin, Trener, Pracownik, Klient. Konfigurowalny dostęp do każdej funkcji. Audit log zmian.", "rgba(14,165,233,0.1)", "#0EA5E9"),
    ];

    private record FaqItem(string Question, string Answer);

    private readonly FaqItem[] _faqs =
    [
        new("Czy muszę mieć własny serwer?", "Nie. PTScheduler działa w chmurze — po rejestracji dostajesz gotową aplikację pod subdomeną (twoja-nazwa.ptscheduler.pl). Nie musisz niczego instalować."),
        new("Czy mogę podpiąć własną domenę?", "Tak. W panelu ustawień możesz podpiąć swoją domenę (np. app.moj-trener.pl). Certyfikat SSL konfiguruje się automatycznie."),
        new("Jak działają płatności online?", "Integrujesz PayU lub Przelewy24 w ustawieniach (wystarczy klucz API). Klienci płacą za pakiety i kursy online — pieniądze trafiają bezpośrednio na Twoje konto."),
        new("Co to jest PWA?", "Progressive Web App — Twoi klienci mogą „zainstalować" aplikację na telefonie prosto z przeglądarki (Dodaj do ekranu głównego). Wygląda i działa jak natywna aplikacja, ale nie wymaga App Store."),
        new("Czy mogę zacząć za darmo i potem przejść na Pro?", "Oczywiście. Plan Start jest darmowy bez limitu czasowego. Gdy będziesz potrzebować więcej klientów lub płatności online, przechodzisz na Pro jednym kliknięciem."),
        new("Czy dane moich klientów są bezpieczne?", "Każdy trener ma izolowaną bazę danych i osobny kontener aplikacji. Dane są szyfrowane w tranzycie (SSL) i przechowywane na serwerach w Europie."),
    ];

    protected override async Task OnInitializedAsync()
    {
        _settings = await Settings.GetAllAsync(
            SiteSettingsService.Keys.HeroBadge,
            SiteSettingsService.Keys.HeroTitle,
            SiteSettingsService.Keys.HeroSubtitle,
            SiteSettingsService.Keys.HeroCta,
            SiteSettingsService.Keys.HeroCtaUrl,
            SiteSettingsService.Keys.SectionTitle,
            SiteSettingsService.Keys.CtaTitle,
            SiteSettingsService.Keys.CtaSubtitle,
            SiteSettingsService.Keys.CtaButton);

        await using var db = DbFactory.CreateDbContext();
        _plans = await db.Plans
            .AsNoTracking()
            .Where(p => p.IsActive)
            .OrderBy(p => p.SortOrder)
            .ToListAsync();
    }

    private string _s(string key, string fallback = "") =>
        _settings.TryGetValue(key, out var val) && !string.IsNullOrWhiteSpace(val) ? val : fallback;

    private void ToggleFaq(int index) => _openFaq = _openFaq == index ? null : index;
}
