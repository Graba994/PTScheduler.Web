@page "/"
@layout PublicLayout
@inject SiteSettingsService Settings
@inject IDbContextFactory<PortalDbContext> DbFactory

<PageTitle>PTScheduler — aplikacja dla trenerów personalnych</PageTitle>
<HeadContent>
    <meta name="description" content="Grafik, rezerwacje online, karnety, płatności, czat z klientem i plany treningowe w jednej aplikacji pod Twoją marką. Zacznij za darmo." />
</HeadContent>

<div class="lp">

<!-- HERO -->
<section class="lp-hero">
    <div class="lp-container lp-hero-inner">
        <div>
            <div class="lp-hero-badge"><i class="bi bi-lightning-charge-fill"></i>@_s("hero_badge", "Dla trenerów personalnych i małych studiów")</div>
            @if (_settings.TryGetValue("hero_title", out var customTitle) && !string.IsNullOrWhiteSpace(customTitle)
                 && customTitle != SiteSettingsService.DefaultHeroTitle)
            {
                <h1>@customTitle</h1>
            }
            else
            {
                <h1>Mniej papierologii.<br /><span class="lp-mark">Więcej treningów.</span></h1>
            }
            <p class="lp-hero-sub">
                @_s("hero_subtitle", "Grafik i rezerwacje online, karnety, płatności, czat z klientem i plany treningowe — w jednej aplikacji pod Twoją marką. Klienci instalują ją na telefonie jak zwykłą apkę.")
            </p>
            <div class="lp-hero-ctas">
                <a href="@_s("hero_cta_url", "/register")" class="lp-btn lp-btn-energy"><i class="bi bi-rocket-takeoff"></i>@_s("hero_cta", "Zacznij za darmo")</a>
                <a href="#funkcje" class="lp-btn lp-btn-ghost">Zobacz, co potrafi</a>
            </div>
            <div class="lp-hero-trust">
                <span><i class="bi bi-check-circle-fill"></i>Pierwsze dni za darmo</span>
                <span><i class="bi bi-check-circle-fill"></i>Gotowe w 5 minut</span>
                <span><i class="bi bi-check-circle-fill"></i>Rezygnujesz, kiedy chcesz</span>
                <span><i class="bi bi-check-circle-fill"></i>Bez pobierania ze sklepu z aplikacjami</span>
            </div>
        </div>

        <div class="lp-stage" aria-hidden="true">
            <div class="lp-float-card lp-float-week">
                <div class="lp-float-title">Twój tydzień</div>
                <div class="lp-week">
                    @foreach (var (day, slots) in _weekPreview)
                    {
                        <div class="lp-week-col">
                            <div class="lp-week-day">@day</div>
                            @foreach (var s in slots)
                            {
                                <div class="lp-slot @s"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="lp-phone">
                <div class="lp-phone-screen">
                    <div class="lp-phone-notch"></div>
                    <div class="lp-phone-time">7:42</div>
                    <div class="lp-phone-date">wtorek, 14 października</div>
                    <div class="lp-notif">
                        <div class="lp-notif-icon" style="background:#7C3AED"><i class="bi bi-calendar-check"></i></div>
                        <div><div class="lp-notif-title">Nowa rezerwacja</div><div class="lp-notif-body">Marta K. — czwartek 18:00, trening personalny</div></div>
                        <div class="lp-notif-time">teraz</div>
                    </div>
                    <div class="lp-notif">
                        <div class="lp-notif-icon" style="background:#05B88A"><i class="bi bi-wallet2"></i></div>
                        <div><div class="lp-notif-title">Płatność przyjęta</div><div class="lp-notif-body">Karnet „8 treningów” — 640 zł, BLIK</div></div>
                        <div class="lp-notif-time">5 min</div>
                    </div>
                    <div class="lp-notif">
                        <div class="lp-notif-icon" style="background:#FF6B35"><i class="bi bi-chat-dots"></i></div>
                        <div><div class="lp-notif-title">Tomek W.</div><div class="lp-notif-body">Zrobione! Przysiad 100 kg 🔥</div></div>
                        <div class="lp-notif-time">12 min</div>
                    </div>
                </div>
            </div>

            <div class="lp-float-card lp-float-rev">
                <div class="lp-stars">★★★★★</div>
                <div style="font-size:.85rem;margin-top:4px">„Najlepsza inwestycja w formę od lat.”</div>
                <div style="font-size:.75rem;color:var(--pts-text-secondary);margin-top:4px">Ania P. — opinia na stronie trenera</div>
            </div>
        </div>
    </div>
</section>

<!-- KONIEC Z… -->
<div class="lp-pain">
    <div class="lp-container lp-pain-inner">
        <span class="lp-pain-label">Koniec z:</span>
        <s>grafikiem w Excelu</s>
        <s>przypominaniem na WhatsAppie</s>
        <s>liczeniem sesji w zeszycie</s>
        <s>gonieniem za przelewami</s>
    </div>
</div>

<!-- WSZYSTKO W JEDNYM: to, co inne aplikacje dzielą na kilka narzędzi -->
<section class="lp-allin" aria-labelledby="lp-allin-title">
    <div class="lp-container">
        <h2 id="lp-allin-title" class="lp-allin-title">Grafik, płatności, przypomnienia, plany treningowe i Twoja strona — <span class="lp-mark">w jednej aplikacji, pod Twoją marką</span></h2>
        <ul class="lp-allin-list">
            @foreach (var (icon, label) in _allInOne)
            {
                <li><i class="bi @icon"></i>@label</li>
            }
        </ul>
        <div class="lp-allin-pwa">
            <span class="lp-allin-pwa-icon"><i class="bi bi-phone-vibrate"></i></span>
            <div>
                <b>Klienci nie szukają Cię w sklepie z aplikacjami.</b>
                Otwierają Twój link i jednym kliknięciem dodają aplikację do ekranu telefonu — z Twoim logo, pełnym ekranem i powiadomieniami. Bez App Store, bez Google Play, bez czekania na aktualizacje.
            </div>
        </div>
    </div>
</section>

@if (_reviews.Count > 0 || _activeTrainers >= 3)
{
    <!-- DOWÓD SPOŁECZNY (tylko prawdziwe dane) -->
    <div class="lp-proof">
        <div class="lp-container lp-proof-inner">
            @if (_reviews.Count > 0)
            {
                <a href="#opinie" class="lp-proof-item"><span class="lp-stars">★★★★★</span><b>@_reviews.Average(r => r.Rating).ToString("0.0", Pl)</b> średnia ocena trenerów</a>
            }
            @if (_activeTrainers >= 3)
            {
                <span class="lp-proof-item"><i class="bi bi-people-fill"></i><b>@_activeTrainers</b> trenerów prowadzi już klientów w PTScheduler</span>
            }
            <span class="lp-proof-item"><i class="bi bi-shield-check"></i>Osobna baza dla każdego trenera · RODO</span>
        </div>
    </div>
}

<!-- ZBUDUJ W 60 SEKUND: wpisz nazwę i przejdź do kreatora z podglądem na żywo -->
<section class="lp-section lp-build" id="zbuduj">
    <div class="lp-container lp-build-inner">
        <div>
            <div class="lp-eyebrow">Wypróbuj bez zakładania konta</div>
            <h2 class="lp-section-title" style="text-align:left">Zbuduj swoją aplikację w 60 sekund</h2>
            <p class="lp-section-sub" style="text-align:left">Wpisz nazwę studia i patrz, jak na żywo powstaje Twoja aplikacja: logo, kolor, strona główna i cennik. Opublikujesz ją jednym kliknięciem — dopiero wtedy cokolwiek zakładamy.</p>
            <form action="/register" method="get" class="lp-build-form" data-enhance="false">
                <label class="visually-hidden" for="lp-build-name">Nazwa Twojego studia</label>
                <input id="lp-build-name" name="nazwa" placeholder="Nazwa Twojego studia" maxlength="60" required autocomplete="organization" />
                <button type="submit" class="lp-btn lp-btn-energy"><i class="bi bi-magic"></i>Buduj</button>
            </form>
            <div class="lp-hero-trust">
                <span><i class="bi bi-eye-fill"></i>Podgląd na żywo</span>
                <span><i class="bi bi-check-circle-fill"></i>Budujesz bez zakładania konta</span>
                <span><i class="bi bi-person-check-fill"></i>Dane wpisujesz tylko raz</span>
            </div>
        </div>
        <div class="lp-build-demo" aria-hidden="true">
            <div class="lp-build-phone">
                <div class="lp-build-row lp-b1"><span class="lp-build-mono">AF</span><b>Anna Fit Studio</b></div>
                <div class="lp-build-card lp-b2"><small>Najbliższy trening</small><b>czw. 18:00</b></div>
                <div class="lp-build-btn lp-b3">Umów trening</div>
                <div class="lp-build-offer lp-b4"><span>Trening personalny</span><b>150 zł</b></div>
                <div class="lp-build-offer lp-b5"><span>Pakiet 8 treningów</span><b>1 040 zł</b></div>
            </div>
            <ol class="lp-build-log">
                <li class="lp-b1"><i class="bi bi-check2"></i>Logo z nazwy studia</li>
                <li class="lp-b2"><i class="bi bi-check2"></i>Kolor w całej aplikacji</li>
                <li class="lp-b4"><i class="bi bi-check2"></i>Cennik i pakiet</li>
                <li class="lp-b5"><i class="bi bi-rocket-takeoff"></i>Gotowe do publikacji</li>
            </ol>
        </div>
    </div>
</section>

<!-- FUNKCJE WG ZADAŃ -->
<section class="lp-section" id="funkcje">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-eyebrow">Co zyskujesz</div>
            <h2 class="lp-section-title">@_s("section_title", "Wszystko, czego potrzebuje trener — w jednym miejscu")</h2>
            <p class="lp-section-sub">Zamiast pięciu aplikacji i arkusza: jedna, która pilnuje grafiku, pieniędzy i kontaktu z klientem za Ciebie.</p>
        </div>

        <div class="lp-job">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-calendar3"></i>Grafik</div>
                <h3>Grafik, który sam się pilnuje</h3>
                <p>Ustawiasz godziny pracy, a klienci rezerwują wolne terminy sami — z telefonu, o 23:00, bez pisania do Ciebie.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Rezerwacje online, serie stałych treningów i pierwsza wizyta z Twojej strony</li>
                    <li><i class="bi bi-check-circle-fill"></i>Przypomnienia e-mail, SMS i push — mniej nieobecności</li>
                    <li><i class="bi bi-check-circle-fill"></i>Polityka odwołań: późne odwołanie = sesja przepada, bez tłumaczenia się</li>
                    <li><i class="bi bi-check-circle-fill"></i>Dwukierunkowy kalendarz Google: wizyty trafiają do Twojego kalendarza, a prywatne terminy blokują grafik</li>
                </ul>
            </div>
            <div class="lp-panel lp-live" aria-hidden="true">
                <div class="lp-panel-head">
                    <span class="lp-panel-title">Tydzień 13–17 października</span>
                    <span class="lp-chip lp-chip-violet lp-swap"><span>12 sesji</span><span>13 sesji</span></span>
                </div>
                <div class="lp-cal">
                    <div></div><div class="lp-cal-h">Pn</div><div class="lp-cal-h">Wt</div><div class="lp-cal-h">Śr</div><div class="lp-cal-h">Cz</div><div class="lp-cal-h">Pt</div>
                    <div class="lp-cal-t">7:00</div><div class="lp-cal-c a">Marta K.</div><div class="lp-cal-c"></div><div class="lp-cal-c a">Marta K.</div><div class="lp-cal-c"></div><div class="lp-cal-c b">Ola i Piotr</div>
                    <div class="lp-cal-t">8:00</div><div class="lp-cal-c"></div><div class="lp-cal-c c">Online · Ewa</div><div class="lp-cal-c"></div><div class="lp-cal-c a">Kuba S.</div><div class="lp-cal-c"></div>
                    <div class="lp-cal-t">17:00</div><div class="lp-cal-c b">Tomek W.</div><div class="lp-cal-c c">Online</div><div class="lp-cal-c a">Kasia L.</div><div class="lp-cal-c b">Tomek W.</div><div class="lp-cal-c"></div>
                    <div class="lp-cal-t">18:00</div><div class="lp-cal-c a">Paweł M.</div><div class="lp-cal-c a">Kasia L.</div>
                    <div class="lp-cal-c lp-cal-target"><span class="lp-cal-new">Ola K.</span><span class="lp-ripple"></span><span class="lp-cursor"><i class="bi bi-hand-index-thumb-fill"></i></span></div>
                    <div class="lp-cal-c a">Marta K.</div><div class="lp-cal-c c">Online</div>
                    <div class="lp-cal-t">19:00</div><div class="lp-cal-c"></div><div class="lp-cal-c b">Grupa · 4 os.</div><div class="lp-cal-c"></div><div class="lp-cal-c"></div><div class="lp-cal-c a">Adam N.</div>
                </div>
                <div class="lp-toast lp-toast-live">
                    <i class="bi bi-bell-fill"></i>
                    <span><b>Ola K.</b> zarezerwowała środę 18:00<small>Przypomnienie SMS wyśle się samo dzień wcześniej</small></span>
                </div>
            </div>
        </div>

        <div class="lp-job flip">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-wallet2"></i>Pieniądze</div>
                <h3>Płacą z góry. Ty nie gonisz przelewów.</h3>
                <p>Pakiety sesji i karnety miesięczne opłacane online. Aplikacja sama liczy, ile treningów zostało, i przypomina o odnowieniu.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Pakiety i karnety cykliczne — co miesiąc ta sama liczba sesji za stałą cenę</li>
                    <li><i class="bi bi-check-circle-fill"></i>PayU i Przelewy24 (BLIK, karta, przelew) — pieniądze trafiają na Twoje konto</li>
                    <li><i class="bi bi-check-circle-fill"></i>Kupony rabatowe, bony podarunkowe w PDF i sklep z pakietami na Twojej stronie</li>
                    <li><i class="bi bi-check-circle-fill"></i>Faktury PDF i wysyłka do KSeF</li>
                </ul>
            </div>
            <div class="lp-panel lp-live" aria-hidden="true">
                <div class="lp-panel-head">
                    <span class="lp-panel-title">Ostatnie wpłaty</span>
                    <span class="lp-chip lp-chip-ok lp-swap lp-swap-money"><span>+ 1 540 zł w tym tygodniu</span><span>+ 2 180 zł w tym tygodniu</span></span>
                </div>
                <div class="lp-rows lp-rows-live">
                    <div class="lp-row lp-row-new">
                        <div class="lp-row-icon" style="background:#D1FAE5;color:#047857"><i class="bi bi-arrow-repeat"></i></div>
                        <div class="lp-row-main">Karnet „8 treningów”<small>Marta K. · BLIK · przed chwilą</small></div>
                        <div class="lp-row-amount">640 zł</div>
                        <span class="lp-chip lp-chip-ok lp-pop"><i class="bi bi-check2"></i>opłacone</span>
                    </div>
                    <div class="lp-row"><div class="lp-row-icon" style="background:#EDE9FE;color:#5B21B6"><i class="bi bi-box-seam"></i></div><div class="lp-row-main">Pakiet 10 sesji<small>Tomek W. · karta</small></div><div class="lp-row-amount">1 100 zł</div></div>
                    <div class="lp-row"><div class="lp-row-icon" style="background:#FFEDD5;color:#C2410C"><i class="bi bi-receipt"></i></div><div class="lp-row-main">Faktura FV/10/2026<small>Wysłana do KSeF</small></div><span class="lp-chip lp-chip-ok"><i class="bi bi-check2"></i>przyjęta</span></div>
                </div>
                <div class="lp-blik">
                    <div class="lp-blik-head"><span class="lp-blik-logo">BLIK</span>Studio Kasi</div>
                    <div class="lp-blik-amount">640,00 zł</div>
                    <div class="lp-blik-ok"><i class="bi bi-check-circle-fill"></i>Płatność zatwierdzona</div>
                </div>
            </div>
        </div>

        <div class="lp-job">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-people"></i>Klienci</div>
                <h3>Klient ma Cię w telefonie — a Ty widzisz jego postępy</h3>
                <p>Każdy klient dostaje aplikację z Twoim logo: grafik, plan treningowy, czat z Tobą i swoje wyniki w jednym miejscu.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Czat z powiadomieniami — koniec z mieszaniem pracy i prywatnego WhatsAppa</li>
                    <li><i class="bi bi-check-circle-fill"></i>Plany treningowe z podpowiedziami progresji („+2,5 kg”) na podstawie ocen wysiłku klienta</li>
                    <li><i class="bi bi-check-circle-fill"></i>Pomiary i zdjęcia sylwetki przed/po — widoczne tylko dla Ciebie i klienta</li>
                    <li><i class="bi bi-check-circle-fill"></i>Ankieta zdrowotna zgodna z RODO i kursy wideo do sprzedaży</li>
                </ul>
            </div>
            <div class="lp-panel lp-live" aria-hidden="true">
                <div class="lp-panel-head"><span class="lp-panel-title"><span class="lp-avatar-sm">TW</span>Tomek W.</span><span class="lp-chip lp-chip-violet"><i class="bi bi-graph-down-arrow"></i>−4,2 kg</span></div>
                <div class="lp-chat">
                    <div class="lp-bubble in lp-b1">Dzisiaj nowy rekord: przysiad 100 kg!</div>
                    <div class="lp-typing"><i></i><i></i><i></i></div>
                    <div class="lp-bubble out lp-b2">Brawo! Od przyszłego tygodnia dokładamy 2,5 kg 💪</div>
                    <div class="lp-bubble in lp-b3">Wchodzę w to 🔥</div>
                </div>
                <div class="lp-chart">
                    <div class="lp-chart-head"><span>Waga · 8 tygodni</span><b>88,0 → 83,8 kg</b></div>
                    <svg viewBox="-6 -6 312 102">
                        <defs><linearGradient id="lpChartFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#7C3AED" stop-opacity=".22" /><stop offset="1" stop-color="#7C3AED" stop-opacity="0" /></linearGradient></defs>
                        <path class="lp-chart-grid" d="M0 22H300M0 45H300M0 68H300" />
                        <path class="lp-chart-area" d="M0 12 L43 18 L86 22 L129 34 L172 40 L215 52 L258 60 L300 70 L300 90 L0 90Z" fill="url(#lpChartFill)" />
                        <path class="lp-chart-line" d="M0 12 L43 18 L86 22 L129 34 L172 40 L215 52 L258 60 L300 70" pathLength="100" />
                        <circle class="lp-chart-dot" cx="300" cy="70" r="5" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="lp-job flip">
            <div class="lp-job-text">
                <div class="lp-job-kicker"><i class="bi bi-megaphone"></i>Rozwój</div>
                <h3>Nowi klienci z polecenia, nie z reklam</h3>
                <p>Zadowoleni klienci polecają Cię dalej — a aplikacja nagradza ich za to automatycznie i zbiera opinie na Twoją stronę.</p>
                <ul class="lp-ticks">
                    <li><i class="bi bi-check-circle-fill"></i>Program poleceń: link dla klienta, nagroda po pierwszym treningu znajomego</li>
                    <li><i class="bi bi-check-circle-fill"></i>Prośba o opinię po kilku treningach i link do opinii w Google</li>
                    <li><i class="bi bi-check-circle-fill"></i>Twoja strona z ofertą, opiniami i rezerwacją pierwszej wizyty</li>
                </ul>
            </div>
            <div class="lp-panel lp-live" aria-hidden="true">
                <div class="lp-panel-head"><span class="lp-panel-title">Polecenia i opinie</span><span class="lp-chip lp-chip-ok lp-swap"><span>3 nowych klientów</span><span>4 nowych klientów</span></span></div>
                <div class="lp-rows">
                    <div class="lp-row lp-row-slide"><div class="lp-row-icon" style="background:#EDE9FE;color:#5B21B6"><i class="bi bi-gift"></i></div><div class="lp-row-main">Marta K. poleciła Julię<small>Julia zarezerwowała pierwszy trening</small></div><span class="lp-chip lp-chip-ok lp-pop">nagroda przyznana</span></div>
                    <div class="lp-row"><div class="lp-row-icon" style="background:#FFF7E6;color:#B45309"><i class="bi bi-star-fill"></i></div><div class="lp-row-main">„Trener, który naprawdę słucha”<small>Julia S. · na Twojej stronie</small></div><span class="lp-stars lp-stars-fill"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span></div>
                    <div class="lp-row"><div class="lp-row-icon" style="background:#E0F2FE;color:#0369A1"><i class="bi bi-google"></i></div><div class="lp-row-main">Prośba o opinię w Google<small>Wysłana automatycznie po 5. treningu</small></div><span class="lp-chip lp-chip-violet">auto</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- KALKULATOR CZASU -->
<section class="lp-section lp-calc-section" id="kalkulator">
    <div class="lp-container">
        <div class="lp-calc" data-lp-calc data-minutes="@CalcMinutesPerClient" data-plan="@_cheapestPaid.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <div class="lp-calc-text">
                <div class="lp-eyebrow">Policz</div>
                <h2 class="lp-section-title" style="text-align:left">Ile czasu odzyskasz w miesiącu?</h2>
                <p class="lp-section-sub">Przesuń suwaki. Umawianie terminów, przypomnienia, liczenie karnetów i pilnowanie wpłat robi za Ciebie aplikacja.</p>
                <label class="lp-calc-field">
                    <span>Liczba klientów <output data-calc-out="clients">@CalcClients</output></span>
                    <input type="range" min="3" max="80" step="1" value="@CalcClients" data-calc="clients" aria-label="Liczba klientów" />
                </label>
                <label class="lp-calc-field">
                    <span>Twoja stawka za godzinę <output data-calc-out="rate">@($"{CalcRate} zł")</output></span>
                    <input type="range" min="60" max="300" step="10" value="@CalcRate" data-calc="rate" aria-label="Stawka za godzinę" />
                </label>
                <p class="lp-calc-note">Szacunek: ok. @CalcMinutesPerClient minut miesięcznie na klienta — wiadomości o terminach, przypomnienia, rozliczanie karnetów i sprawdzanie przelewów.</p>
            </div>
            <div class="lp-calc-result" aria-live="polite">
                <div class="lp-calc-big"><span data-calc-out="hours">@CalcHours(CalcClients)</span> h</div>
                <div class="lp-calc-label">odzyskanego czasu co miesiąc</div>
