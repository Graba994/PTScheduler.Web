@page "/"
@layout PublicLayout
@inject SiteSettingsService Settings
@inject IDbContextFactory<PortalDbContext> DbFactory

<PageTitle>PTScheduler — Platforma dla trenerów personalnych</PageTitle>

<!-- HERO -->
<section class="lp-hero">
    <div class="lp-container lp-hero-inner">
        <div>
            <div class="lp-hero-badge">
                <span class="lp-hero-badge-dot"></span>
                @_s("hero_badge", "Nowa era zarządzania treningami")
            </div>
            <h1 class="lp-hero-h1">@_s("hero_title", "Twoja siłownia.")<br><span class="lp-gradient">Twoja aplikacja.</span></h1>
            <p class="lp-hero-sub">
                @_s("hero_subtitle", "Kompleksowa platforma dla trenerów personalnych. Grafik, płatności, pakiety, kursy wideo i dashboard klienta — wszystko pod Twoją marką, gotowe w 5 minut.")
            </p>
            <div class="lp-hero-ctas">
                <a href="@_s("hero_cta_url", "/register")" class="lp-btn lp-btn-energy lp-btn-lg">
                    <span class="material-symbols-rounded">rocket_launch</span>
                    @_s("hero_cta", "Wypróbuj za darmo")
                </a>
                <a href="#video" class="lp-btn lp-btn-outline lp-btn-lg">
                    <span class="material-symbols-rounded">play_circle</span>
                    Obejrzyj demo
                </a>
            </div>
            <div class="lp-hero-proof">
                <div class="lp-hero-proof-avatars">
                    <div class="lp-hero-proof-avatar" style="background:#7C3AED">PG</div>
                    <div class="lp-hero-proof-avatar" style="background:#06D6A0">MK</div>
                    <div class="lp-hero-proof-avatar" style="background:#FF6B35">AS</div>
                    <div class="lp-hero-proof-avatar" style="background:#3B82F6">JN</div>
                </div>
                <span>Dołącz do trenerów, którzy już testują PTScheduler</span>
            </div>
        </div>
        <div class="lp-hero-device">
            <div class="lp-device-frame">
                <div class="lp-device-bar">
                    <div class="lp-device-dot" style="background:#FF5F57"></div>
                    <div class="lp-device-dot" style="background:#FEBC2E"></div>
                    <div class="lp-device-dot" style="background:#28C840"></div>
                    <div class="lp-device-url">twoja-nazwa.ptscheduler.pl</div>
                </div>
                <div class="lp-screenshot-placeholder">
                    <div class="lp-screenshot-label">Dashboard Trenera</div>
                    <p class="lp-screenshot-desc">
                        Kalendarz tygodniowy z kolorowymi blokami sesji.
                        Menu: Grafik, Klienci, Pakiety, Finanse.
                        Na górze statystyki: sesje, klienci, przychód.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TRUST BAR -->
<section class="lp-trust">
    <div class="lp-container lp-trust-inner">
        <div class="lp-trust-item">
            <div class="lp-trust-icon"><span class="material-symbols-rounded">shield</span></div>
            <span>Szyfrowanie SSL</span>
        </div>
        <div class="lp-trust-item">
            <div class="lp-trust-icon"><span class="material-symbols-rounded">cloud_done</span></div>
            <span>Własna subdomena</span>
        </div>
        <div class="lp-trust-item">
            <div class="lp-trust-icon"><span class="material-symbols-rounded">smartphone</span></div>
            <span>PWA — jak aplikacja</span>
        </div>
        <div class="lp-trust-item">
            <div class="lp-trust-icon"><span class="material-symbols-rounded">palette</span></div>
            <span>Twoje logo i kolory</span>
        </div>
        <div class="lp-trust-item">
            <div class="lp-trust-icon"><span class="material-symbols-rounded">database</span></div>
            <span>Izolowane dane</span>
        </div>
    </div>
</section>

<!-- FEATURE SHOWCASES -->
<section class="lp-section" id="features">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-section-eyebrow">Funkcje</div>
            <h2 class="lp-section-title">Wszystko czego potrzebujesz,<br>w jednym miejscu</h2>
            <p class="lp-section-sub">Od rezerwacji po rozliczenia — PTScheduler zastępuje arkusze, kalendarze i notatniki jedną profesjonalną platformą.</p>
        </div>

        <!-- Grafik -->
        <div class="lp-showcase">
            <div class="lp-showcase-content">
                <div class="lp-showcase-icon" style="background: linear-gradient(135deg, #3B82F6, #1D4ED8)">
                    <span class="material-symbols-rounded">calendar_month</span>
                </div>
                <h3 class="lp-showcase-title">Inteligentny grafik</h3>
                <p class="lp-showcase-text">
                    Ustaw dostępność, a system sam wygeneruje sloty. Klienci rezerwują online
                    lub Ty planujesz za nich. Przerwy, blokady i serie treningów — automatycznie.
                </p>
                <ul class="lp-showcase-list">
                    <li><span class="lp-showcase-check">&#10003;</span> Reguły dostępności (cykliczne i jednorazowe)</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Rezerwacja online przez klientów</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Automatyczne przypomnienia email i SMS</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Integracja z Google Meet</li>
                </ul>
            </div>
            <div class="lp-showcase-screen">
                <div class="lp-screenshot-placeholder" style="aspect-ratio:4/3">
                    <div class="lp-screenshot-label">Kalendarz tygodniowy</div>
                    <p class="lp-screenshot-desc">
                        Kolorowe bloki sesji z imieniem klienta, typem treningu i statusem.
                        Przełącznik: Dzień / Tydzień / Miesiąc.
                    </p>
                </div>
            </div>
        </div>

        <!-- Pakiety -->
        <div class="lp-showcase lp-showcase-reverse">
            <div class="lp-showcase-content">
                <div class="lp-showcase-icon" style="background: linear-gradient(135deg, var(--pts-accent), var(--pts-accent-dark))">
                    <span class="material-symbols-rounded">inventory_2</span>
                </div>
                <h3 class="lp-showcase-title">Pakiety i rozliczenia</h3>
                <p class="lp-showcase-text">
                    Sprzedawaj pakiety sesji online. System automatycznie liczy zużyte sesje,
                    rozlicza anulacje i powiadamia gdy pakiet się kończy lub wygasa.
                </p>
                <ul class="lp-showcase-list">
                    <li><span class="lp-showcase-check">&#10003;</span> Automatyczne odliczanie sesji z paczki</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Kupony rabatowe i kody zniżkowe</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Płatności online PayU i Przelewy24</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Faktury i historia transakcji</li>
                </ul>
            </div>
            <div class="lp-showcase-screen">
                <div class="lp-screenshot-placeholder" style="aspect-ratio:4/3">
                    <div class="lp-screenshot-label">Lista pakietów klienta</div>
                    <p class="lp-screenshot-desc">
                        Pakiety z paskiem postępu, data wygaśnięcia, badge statusu.
                        Kalkulator ceny z polem na kod rabatowy.
                    </p>
                </div>
            </div>
        </div>

        <!-- Dashboard klienta -->
        <div class="lp-showcase">
            <div class="lp-showcase-content">
                <div class="lp-showcase-icon" style="background: linear-gradient(135deg, #F59E0B, #D97706)">
                    <span class="material-symbols-rounded">person</span>
                </div>
                <h3 class="lp-showcase-title">Dashboard klienta</h3>
                <p class="lp-showcase-text">
                    Każdy klient ma własny panel — widzi nadchodzące treningi, pakiet,
                    postępy wagi i może szybko zapisać pomiary. Instaluje jako aplikację na telefon.
                </p>
                <ul class="lp-showcase-list">
                    <li><span class="lp-showcase-check">&#10003;</span> Odliczanie do następnego treningu</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Wykres postępów wagi</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Historia wszystkich sesji</li>
                    <li><span class="lp-showcase-check">&#10003;</span> PWA — działa jak natywna aplikacja</li>
                </ul>
            </div>
            <div class="lp-showcase-screen">
                <div class="lp-screenshot-placeholder" style="aspect-ratio:9/16; max-width:280px; margin: 0 auto;">
                    <div class="lp-screenshot-label">Widok mobilny klienta</div>
                    <p class="lp-screenshot-desc">
                        Powitanie, odliczanie, karta treningu,
                        statystyki, mini-wykres wagi, szybki wpis.
                    </p>
                </div>
            </div>
        </div>

        <!-- Kursy -->
        <div class="lp-showcase lp-showcase-reverse">
            <div class="lp-showcase-content">
                <div class="lp-showcase-icon" style="background: linear-gradient(135deg, #EC4899, #BE185D)">
                    <span class="material-symbols-rounded">play_circle</span>
                </div>
                <h3 class="lp-showcase-title">Kursy wideo i mentoring</h3>
                <p class="lp-showcase-text">
                    Stwórz kursy treningowe, dietetyczne lub mentoringowe.
                    Lekcje wideo, materiały PDF, śledzenie postępu uczniów.
                    Sprzedawaj jako produkt cyfrowy lub dodawaj do pakietów.
                </p>
                <ul class="lp-showcase-list">
                    <li><span class="lp-showcase-check">&#10003;</span> Moduły z lekcjami wideo (YouTube / Bunny)</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Śledzenie postępu kursanta</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Sprzedaż online z płatnościami</li>
                    <li><span class="lp-showcase-check">&#10003;</span> Landing page kursu z opisem i ceną</li>
                </ul>
            </div>
            <div class="lp-showcase-screen">
                <div class="lp-screenshot-placeholder" style="aspect-ratio:4/3">
                    <div class="lp-screenshot-label">Strona kursu</div>
                    <p class="lp-screenshot-desc">
                        Landing page kursu z banerem, ceną, spisem modułów
                        i paskiem postępu kursanta.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ALL FEATURES GRID -->
<section class="lp-section lp-section-alt" id="all-features">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-section-eyebrow">Pełna lista</div>
            <h2 class="lp-section-title">Potężne narzędzia, proste w obsłudze</h2>
            <p class="lp-section-sub">Każda funkcja zaprojektowana z myślą o codziennej pracy trenera personalnego.</p>
        </div>
        <div class="lp-features-grid">
            @foreach (var f in _featureCards)
            {
                <div class="lp-feature-card">
                    <div class="lp-feature-card-icon" style="background:@f.BgColor;color:@f.IconColor">
                        <span class="material-symbols-rounded">@f.Icon</span>
                    </div>
                    <h4>@f.Title</h4>
                    <p>@f.Text</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- VIDEO CONCEPT -->
<section class="lp-video-section" id="video">
    <div class="lp-container lp-video-inner">
        <div class="lp-section-head">
            <div class="lp-section-eyebrow" style="color:var(--pts-accent)">Obejrzyj demo</div>
            <h2 class="lp-section-title" style="color:#F0EEF5">Zobacz PTScheduler w akcji</h2>
            <p class="lp-section-sub" style="color:#9B95AD">90-sekundowe demo pokazujące pełną ścieżkę — od dodania klienta po rozliczenie pakietu.</p>
        </div>
        <div class="lp-video-frame">
            <div class="lp-video-play">
                <span class="material-symbols-rounded" style="font-size:36px;margin-left:4px">play_arrow</span>
            </div>
            <div class="lp-video-label">Film promocyjny · 1:30 min</div>
        </div>
        <div class="lp-video-storyboard">
            <div class="lp-storyboard-item">
                <div class="lp-storyboard-num">1</div>
                <div class="lp-storyboard-title">Problem trenera</div>
                <div class="lp-storyboard-desc">Notes, Excel, WhatsApp. Chaos i pomyłki.</div>
            </div>
            <div class="lp-storyboard-item">
                <div class="lp-storyboard-num">2</div>
                <div class="lp-storyboard-title">Wejście PTScheduler</div>
                <div class="lp-storyboard-desc">Dashboard, dodanie klienta, rezerwacja przez telefon.</div>
            </div>
            <div class="lp-storyboard-item">
                <div class="lp-storyboard-num">3</div>
                <div class="lp-storyboard-title">Kluczowe funkcje</div>
                <div class="lp-storyboard-desc">Pakiety, płatności, kursy wideo, branding.</div>
            </div>
            <div class="lp-storyboard-item">
                <div class="lp-storyboard-num">4</div>
                <div class="lp-storyboard-title">Wezwanie do akcji</div>
                <div class="lp-storyboard-desc">„Zacznij za darmo — bez karty kredytowej."</div>
            </div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="lp-section">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-section-eyebrow">Jak zacząć</div>
            <h2 class="lp-section-title">Gotowe w 5 minut</h2>
            <p class="lp-section-sub">Żadnej konfiguracji serwerów. Rejestrujesz się, konfigurujesz i zarabiasz.</p>
        </div>
        <div class="lp-steps">
            <div class="lp-step">
                <div class="lp-step-num">1</div>
                <h4>Załóż konto</h4>
                <p>Wypełnij formularz — imię, email, nazwa studia. Wybierz plan lub zacznij za darmo.</p>
            </div>
            <div class="lp-step">
                <div class="lp-step-num">2</div>
                <h4>Skonfiguruj</h4>
                <p>Kreator przeprowadzi Cię krok po kroku — logo, kolory, typy sesji, dostępność, płatności.</p>
            </div>
            <div class="lp-step">
                <div class="lp-step-num">3</div>
                <h4>Zapraszaj klientów</h4>
                <p>Wyślij link. Klienci rejestrują się, rezerwują treningi i płacą online. Ty zarządzasz z jednego miejsca.</p>
            </div>
        </div>
    </div>
</section>

<!-- PRICING -->
<section class="lp-section lp-section-alt" id="pricing">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-section-eyebrow">Cennik</div>
            <h2 class="lp-section-title">Prosty cennik, zero ukrytych opłat</h2>
            <p class="lp-section-sub">Zacznij od darmowego planu. Ulepszaj gdy będziesz potrzebować więcej.</p>
        </div>
        <div class="lp-pricing-grid" style="@(_plans.Count == 2 ? "max-width:700px;margin:0 auto;grid-template-columns:repeat(2,1fr)" : _plans.Count == 1 ? "max-width:400px;margin:0 auto;grid-template-columns:1fr" : "")">
            @foreach (var plan in _plans)
            {
                <div class="lp-price-card @(plan.IsFeatured ? "lp-price-featured" : "")">
                    @if (plan.IsFeatured)
                    {
                        <div class="lp-price-badge">Najpopularniejszy</div>
                    }
                    <div class="lp-price-name">@plan.Name</div>
                    <div class="lp-price-desc">@(plan.Description ?? "")</div>
                    <div class="lp-price-amount">@plan.MonthlyPrice.ToString("0") <span style="font-size:1rem;font-weight:500">zł</span></div>
                    <div class="lp-price-period">
                        @(plan.MonthlyPrice == 0 ? "za darmo, na zawsze" : $"miesięcznie{(plan.TrialDays > 0 ? $" · {plan.TrialDays} dni za darmo" : "")}")
                    </div>
                    <ul class="lp-price-features">
                        <li>
                            <span class="material-symbols-rounded lp-pf-check">check</span>
                            @(plan.MaxClients >= 9999 ? "Nielimitowani klienci" : $"Do {plan.MaxClients} klientów")
                        </li>
                        <li>
                            <span class="material-symbols-rounded lp-pf-check">check</span>
                            Grafik i rezerwacje
                        </li>
                        @if (plan.EmailReminders)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                Przypomnienia email
                            </li>
                        }
                        @if (plan.BodyMeasurements)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                Pomiary ciała
                            </li>
                        }
                        @if (plan.PaymentsEnabled)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                Płatności online
                            </li>
                        }
                        else
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-x">close</span>
                                <span style="opacity:0.5">Płatności online</span>
                            </li>
                        }
                        @if (plan.CoursesEnabled)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                @(plan.MaxCourses >= 9999 ? "Nielimitowane kursy" : plan.MaxCourses > 0 ? $"{plan.MaxCourses} kursów wideo" : "Kursy wideo")
                            </li>
                        }
                        else
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-x">close</span>
                                <span style="opacity:0.5">Kursy wideo</span>
                            </li>
                        }
                        @if (plan.SmsReminders)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                SMS-y i push
                            </li>
                        }
                        @if (plan.Coupons)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                Kupony i rabaty
                            </li>
                        }
                        @if (plan.MaxTrainers > 1)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                @(plan.MaxTrainers >= 9999 ? "Nielimitowani trenerzy" : $"{plan.MaxTrainers} trenerów")
                            </li>
                        }
                        @if (plan.RoleBasedAccess)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                Role i uprawnienia
                            </li>
                        }
                        @if (plan.AuditLog)
                        {
                            <li>
                                <span class="material-symbols-rounded lp-pf-check">check</span>
                                Audit log
                            </li>
                        }
                    </ul>
                    <a href="/register" class="lp-btn @(plan.IsFeatured ? "lp-btn-primary" : "lp-btn-outline") lp-price-cta">
                        @(plan.MonthlyPrice == 0 ? "Zacznij za darmo" : $"Wybierz {plan.Name}")
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="lp-section" id="faq">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="lp-section-eyebrow">FAQ</div>
            <h2 class="lp-section-title">Najczęstsze pytania</h2>
        </div>
        <div class="lp-faq-list">
            @for (int i = 0; i < _faqs.Length; i++)
            {
                var idx = i;
                <div class="lp-faq-item @(_openFaq == idx ? "lp-faq-open" : "")">
                    <div class="lp-faq-q" @onclick="() => ToggleFaq(idx)">
                        @_faqs[idx].Question
                        <span class="material-symbols-rounded">expand_more</span>
                    </div>
                    <div class="lp-faq-a">@_faqs[idx].Answer</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- FINAL CTA -->
<section class="lp-cta-section">
    <div class="lp-container lp-cta-inner">
        <h2>@_s("cta_title", "Gotowy na profesjonalną platformę?")</h2>
        <p>@_s("cta_subtitle", "Dołącz do PTScheduler i zarządzaj treningami jak pro. Bez karty kredytowej, bez ryzyka.")</p>
        <a href="/register" class="lp-btn lp-btn-white lp-btn-lg">
            <span class="material-symbols-rounded">rocket_launch</span>
            @_s("cta_button", "Zacznij za darmo")
        </a>
    </div>
</section>

<style>
    /* ===== SHARED TOKENS (reuse from PublicLayout) ===== */
    .lp-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    .lp-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 12px 24px; border-radius: 12px; font-size: 0.95rem;
        font-weight: 600; font-family: var(--pts-font-body);
        border: none; cursor: pointer; transition: all 0.25s;
        text-decoration: none;
    }
    .lp-btn-primary {
        background: var(--pts-primary); color: #fff;
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.35);
    }
    .lp-btn-primary:hover {
        background: var(--pts-primary-dark); color: #fff;
        box-shadow: 0 6px 24px rgba(124, 58, 237, 0.45);
        transform: translateY(-1px);
    }
    .lp-btn-energy {
        background: var(--pts-energy); color: #fff;
        box-shadow: 0 4px 16px rgba(255, 107, 53, 0.35);
    }
    .lp-btn-energy:hover {
        background: var(--pts-energy-dark); color: #fff;
        transform: translateY(-1px);
    }
    .lp-btn-outline {
        background: transparent; color: var(--pts-text);
        border: 2px solid var(--pts-border);
    }
    .lp-btn-outline:hover { border-color: var(--pts-primary); color: var(--pts-primary); }
    .lp-btn-lg { padding: 16px 32px; font-size: 1.05rem; border-radius: 14px; }
    .lp-btn-white {
        background: #fff; color: var(--pts-primary);
        font-weight: 700;
        box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }
    .lp-btn-white:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.2); color: var(--pts-primary); }

    /* ===== HERO ===== */
    .lp-hero {
        padding: 140px 0 80px;
        position: relative;
        overflow: hidden;
        font-family: var(--pts-font-body);
        color: var(--pts-text);
        background: var(--pts-bg);
    }
    .lp-hero::before {
        content: '';
        position: absolute; top: -200px; right: -200px;
        width: 600px; height: 600px;
        background: radial-gradient(circle, var(--pts-glow) 0%, transparent 70%);
        pointer-events: none;
    }
    .lp-hero::after {
        content: '';
        position: absolute; bottom: -100px; left: -100px;
        width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(6, 214, 160, 0.08) 0%, transparent 70%);
