            new("Kiedy Excel naprawdę wystarczy", "Jeśli masz kilku stałych klientów w stałych godzinach i rozliczasz się gotówką, arkusz i czat w zupełności wystarczą. Aplikacja zaczyna się opłacać, gdy terminy się zmieniają, klientów przybywa albo chcesz sprzedawać pakiety."),
            [
                new("Czy klienci będą chcieli zapisywać się przez aplikację?", "Zwykle tak — zapis zajmuje kilka sekund, a przypomnienie przychodzi samo. Tym, którzy wolą pisać, nadal możesz wpisać trening ręcznie."),
                new("Czy mogę dalej rozmawiać z klientami na czacie?", "Tak. W aplikacji jest też czat z klientem, więc wiadomości o treningach są w jednym miejscu, oddzielone od prywatnych."),
                new("Ile czasu zajmuje przejście?", "Aplikację zbudujesz w kilka minut. Godziny pracy i oferta to kolejne kilkanaście minut — potem wysyłasz link."),
                new("Co jeśli klient nie ma smartfona?", "Wpiszesz jego treningi ręcznie, a przypomnienia mogą iść e-mailem albo SMS-em.")
            ],
            null),

        ["/porownanie/systemy-rezerwacji"] = new(
            "Aplikacja trenera czy system rezerwacji (np. Booksy)? | PTScheduler",
            "Czym różni się aplikacja dla trenera personalnego od ogólnego systemu rezerwacji wizyt, np. Booksy: marka, plany treningowe, pakiety, pomiary i to, skąd przychodzą klienci.",
            "Aplikacja trenera czy system rezerwacji",
            "Aplikacja trenera czy system rezerwacji wizyt?",
            "Ogólne systemy rezerwacji, np. Booksy, świetnie sprawdzają się w salonach i gabinetach. Trener potrzebuje czegoś więcej niż kalendarza: planów treningowych, pakietów, postępów klientów — i własnej marki.",
            "System rezerwacji wizyt",
            "", [],
            "Co jest inne",
            [
                new("Pod czyją marką", "Twoja aplikacja, ikona i strona — klient widzi tylko Ciebie", Mark.Partly, "Zwykle marka i aplikacja dostawcy, a w katalogu obok inne firmy"),
                new("Nowi klienci z katalogu", "Nie — nowych klientów zdobywasz we własnym zakresie, np. ze strony i social mediów", Mark.Yes, "Tak — to duża zaleta katalogów z ruchem", Mark.No),
                new("Plany treningowe i postępy", "Plany, ćwiczenia z wideo, historia treningów", Mark.No, "Zwykle brak — to narzędzia do umawiania wizyt"),
                new("Pakiety i karnety", "Pakiety treningów i karnety odliczają się same", Mark.Partly, "Zależy od dostawcy i planu"),
                new("Treningi w parach i grupach", "Wspólny trening dla dwojga i małe grupy z limitem miejsc", Mark.Partly, "Zależy od dostawcy"),
                new("Ankiety, pomiary, zdjęcia sylwetki", "Wywiad zdrowotny, pomiary i zdjęcia postępów", Mark.No, "Zwykle brak"),
                new("Strona internetowa", "Gotowe szablony dla trenerów, własna domena w wyższych planach", Mark.Partly, "Zwykle profil w katalogu dostawcy")
            ],
            "", [],
            new("Kiedy wybrać katalog, a kiedy własną aplikację", "Jeśli większość nowych klientów ma przychodzić z wyszukiwarki dostawcy, katalog ma sens. Jeśli klienci przychodzą z polecenia, Instagrama albo z Twojej strony i zostają na miesiące, liczy się prowadzenie ich treningów i Twoja marka — wtedy lepiej sprawdza się aplikacja dla trenera. Oba rozwiązania można też łączyć."),
            [
                new("Czy mogę mieć profil w katalogu i własną aplikację jednocześnie?", "Tak. Wielu trenerów zdobywa część nowych klientów z katalogów, a stałych prowadzi we własnej aplikacji — z planami, pakietami i postępami."),
                new("Czy klient musi zakładać konto u Was?", "Klient zakłada konto w Twojej aplikacji — pod Twoją nazwą i adresem. Nie widzi w niej innych trenerów."),
                new("Czy pobieracie prowizję od rezerwacji?", "Nie. Płacisz stały abonament za plan, a płatności klientów trafiają przez Twoją bramkę płatności na Twoje konto."),
                new("Czy przeniosę klientów z innego systemu?", "Klientów dodasz ręcznie, a przy większej liczbie napisz do nas — pomożemy z przeniesieniem.")
            ],
            "Nazwy innych firm służą wyłącznie do opisu rodzaju rozwiązania. Funkcje i ceny u innych dostawców się zmieniają — przed decyzją sprawdź ich aktualną ofertę.")
    };
}
