@page "/aplikacja-dla-trenera-personalnego"
@page "/porownanie/excel-i-whatsapp"
@page "/porownanie/systemy-rezerwacji"
@layout PublicLayout
@inject NavigationManager Nav
@inject IConfiguration Config

@* Strony pod wyszukiwarkę: „aplikacja dla trenera personalnego” i uczciwe porównania z tym, czego trenerzy
   używają dziś. Treść w Pages (niżej) — jedna strona = jeden wpis, ten sam układ. *@

<PageTitle>@P.Title</PageTitle>
<HeadContent>
    <meta name="description" content="@P.Description" />
    <link rel="canonical" href="@Canonical" />
    <meta property="og:title" content="@P.Title" />
    <meta property="og:description" content="@P.Description" />
    <meta property="og:type" content="website" />
    @((MarkupString)FaqJsonLd)
</HeadContent>

<section class="seo-hero">
    <div class="pts-container">
        <div class="seo-eyebrow">@P.Eyebrow</div>
        <h1>@P.H1</h1>
        <p class="seo-lead">@P.Lead</p>
        <div class="seo-ctas">
            <a href="/register" class="pts-btn pts-btn-primary">Zbuduj swoją aplikację w 60 sekund <i class="bi bi-arrow-right"></i></a>
            <a href="/#cennik" class="seo-link">Zobacz cennik</a>
        </div>
    </div>
</section>

@if (P.Features.Length > 0)
{
    <section class="seo-sec">
        <div class="pts-container">
            <h2>@P.FeaturesTitle</h2>
            <div class="seo-features">
                @foreach (var f in P.Features)
                {
                    <div class="seo-feature"><i class="bi @f.Icon"></i><h3>@f.Title</h3><p>@f.Text</p></div>
                }
            </div>
        </div>
    </section>
}

@if (P.Rows.Length > 0)
{
    <section class="seo-sec">
        <div class="pts-container">
            <h2>@P.TableTitle</h2>
            <div class="seo-table-wrap">
                <table class="seo-table">
                    <thead><tr><th scope="col"></th><th scope="col" class="us">PTScheduler</th><th scope="col">@P.Other</th></tr></thead>
                    <tbody>
                        @foreach (var r in P.Rows)
                        {
                            <tr>
                                <th scope="row">@r.Topic</th>
                                <td class="us"><i class="bi @Icon(r.UsMark)" aria-hidden="true"></i>@r.Us</td>
                                <td><i class="bi @Icon(r.Them)" aria-hidden="true"></i>@r.ThemText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}

@if (P.Steps.Length > 0)
{
    <section class="seo-sec">
        <div class="pts-container">
            <h2>@P.StepsTitle</h2>
            <ol class="seo-steps">
                @foreach (var s in P.Steps)
                {
                    <li><h3>@s.Title</h3><p>@s.Text</p></li>
                }
            </ol>
        </div>
    </section>
}

@if (P.Honest is { } honest)
{
    <section class="seo-sec">
        <div class="pts-container">
            <div class="seo-honest">
                <h2>@honest.Title</h2>
                <p>@honest.Text</p>
            </div>
        </div>
    </section>
}

<section class="seo-sec">
    <div class="pts-container">
        <h2>Częste pytania</h2>
        <div class="seo-faq">
            @foreach (var q in P.Faq)
            {
                <details><summary>@q.Q</summary><p>@q.A</p></details>
            }
        </div>
    </div>
</section>

<section class="seo-cta">
    <div class="pts-container">
        <h2>Zobacz swoją aplikację, zanim cokolwiek zapłacisz</h2>
        <p>Wpisz nazwę i specjalizację — podgląd składa się na żywo. Aplikacja powstaje dopiero po „Opublikuj”.</p>
        <a href="/register" class="pts-btn pts-btn-primary">Zacznij budować <i class="bi bi-arrow-right"></i></a>
        <nav class="seo-more" aria-label="Więcej">
            @foreach (var other in Pages.Where(x => x.Key != Path))
            {
                <a href="@other.Key">@other.Value.Eyebrow</a>
            }
        </nav>
        @if (P.Note is not null) { <p class="seo-note">@P.Note</p> }
    </div>
</section>

@code {
    private enum Mark { Yes, Partly, No }
    private sealed record Feature(string Icon, string Title, string Text);
    private sealed record Row(string Topic, string Us, Mark Them, string ThemText, Mark UsMark = Mark.Yes);
    private sealed record Step(string Title, string Text);
    private sealed record Faq(string Q, string A);
    private sealed record Box(string Title, string Text);
    private sealed record Page(string Title, string Description, string Eyebrow, string H1, string Lead, string Other,
        string FeaturesTitle, Feature[] Features, string TableTitle, Row[] Rows, string StepsTitle, Step[] Steps,
        Box? Honest, Faq[] Faqs, string? Note)
    {
        public Faq[] Faq => Faqs;
    }

    private static string Icon(Mark m) => m switch { Mark.Yes => "bi-check-circle-fill ok", Mark.Partly => "bi-dash-circle-fill mid", _ => "bi-x-circle-fill no" };

    private string Path => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
    private Page P => Pages.GetValueOrDefault(Path) ?? Pages.First().Value;

    private string Canonical =>
        (Config.GetValue<string>("Portal:PublicUrl")?.TrimEnd('/') is { Length: > 0 } pub ? pub : Nav.BaseUri.TrimEnd('/')) + Path;

    private string FaqJsonLd
    {
        get
        {
            var data = new Dictionary<string, object>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "FAQPage",
                ["mainEntity"] = P.Faq.Select(q => new Dictionary<string, object>
                {
                    ["@type"] = "Question",
                    ["name"] = q.Q,
                    ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = q.A }
                }).ToArray()
            };
            // </script> w treści nie przerwie bloku: JsonSerializer koduje < i > jako < / >.
            return $"<script type=\"application/ld+json\">{System.Text.Json.JsonSerializer.Serialize(data)}</script>";
        }
    }

    private static readonly Feature[] CoreFeatures =
    [
        new("bi-calendar2-check", "Zapisy 24/7", "Klient sam wybiera wolny termin z Twoich godzin pracy — bez wymiany wiadomości."),
        new("bi-credit-card", "Płatności online", "BLIK, karta albo przelew przy zapisie. Pakiety treningów odliczają się same."),
        new("bi-bell", "Przypomnienia", "E-mail, powiadomienie na telefonie albo SMS przed treningiem — mniej nieobecności."),
        new("bi-clipboard2-pulse", "Plany i postępy", "Plany treningowe, pomiary i zdjęcia sylwetki w aplikacji klienta."),
        new("bi-phone", "Twoja aplikacja", "Twoja nazwa, logo i kolor. Klient dodaje ją do ekranu telefonu jednym kliknięciem."),
        new("bi-window", "Strona internetowa", "Gotowe szablony dla różnych specjalizacji i własna domena w wyższych planach.")
    ];

    private static readonly Dictionary<string, Page> Pages = new()
    {
        ["/aplikacja-dla-trenera-personalnego"] = new(
            "Aplikacja dla trenera personalnego — zapisy, płatności i plany | PTScheduler",
            "Własna aplikacja i strona trenera personalnego: klienci sami zapisują się na treningi, płacą BLIK-iem i dostają przypomnienia. Zbudujesz ją w minutę, okres próbny za darmo.",
            "Aplikacja dla trenera personalnego",
            "Aplikacja dla trenera personalnego, która wygląda jak Twoja",
            "Zapisy, płatności, przypomnienia i plany treningowe w jednym miejscu — pod Twoją nazwą, logo i kolorem. Klienci mają ją na telefonie, a Ty przestajesz gonić ich o terminy i przelewy.",
            "",
            "Co dostajesz", CoreFeatures,
            "", [],
            "Jak to działa",
            [
                new("Budujesz w kreatorze", "Nazwa, specjalizacja, kolor i oferta — podgląd aplikacji i strony składa się na żywo."),
                new("Publikujesz", "Potwierdzasz e-mail, a aplikacja startuje zwykle w około minutę. Dane z kreatora są już na miejscu."),
                new("Wysyłasz link klientom", "Klienci zapisują się i płacą sami. Ty ustawiasz tylko godziny pracy.")
            ],
            null,
            [
                new("Czy klienci muszą pobierać aplikację ze sklepu?", "Nie. Aplikację otwiera się z linku i dodaje do ekranu telefonu jednym kliknięciem — działa jak zwykła aplikacja, z Twoją ikoną i powiadomieniami."),
                new("Ile to kosztuje?", "Jest plan darmowy dla kilku klientów i płatne plany z okresem próbnym. Abonament możesz rozliczać miesięcznie albo rocznie (taniej) i zrezygnować w każdej chwili."),
                new("Czy mogę mieć własną domenę, np. mojestudio.pl?", "Tak, w wyższych planach. Aplikacja działa od razu pod adresem w naszej domenie, a własną domenę podłączasz w dowolnym momencie."),
                new("Kto jest właścicielem danych klientów?", "Ty. Jesteś administratorem danych swoich klientów, a my przetwarzamy je wyłącznie na Twoje zlecenie, żeby aplikacja działała."),
                new("Czy nadaje się dla małego studia z kilkoma trenerami?", "Tak. Wyższe plany pozwalają dodać więcej trenerów, a każdy ma swój grafik i klientów.")
            ],
            null),

        ["/porownanie/excel-i-whatsapp"] = new(
            "Excel i WhatsApp czy aplikacja dla trenera? Porównanie | PTScheduler",
            "Grafik w Excelu i zapisy przez WhatsApp działają — do czasu. Porównanie z aplikacją dla trenera: zapisy, przypomnienia, płatności, pakiety i plany treningowe.",
            "Excel i WhatsApp czy aplikacja",
