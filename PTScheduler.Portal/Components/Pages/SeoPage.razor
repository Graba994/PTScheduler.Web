                new("Pakiety treningów", "Wejścia odliczają się same, klient widzi, ile zostało", Mark.Partly, "Liczenie w arkuszu, łatwo o pomyłkę"),
                new("Odwołania", "Twoje zasady odwołań pilnowane automatycznie", Mark.No, "Negocjacje na czacie"),
                new("Plany treningowe", "W aplikacji klienta, z postępami i historią", Mark.Partly, "PDF-y i zdjęcia gubiące się w czacie"),
                new("Wizerunek", "Twoja aplikacja i strona z logo", Mark.No, "Prywatny numer telefonu"),
                new("Koszt", "Plan darmowy na start, potem abonament", Mark.Yes, "Za darmo — płacisz swoim czasem")
