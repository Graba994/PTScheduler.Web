    {
        await Offsite.DisconnectDriveAsync();
        await LoadOffsite();
        Show("Odłączono Google Drive. Pliki już wysłane zostają na Dysku.", false);
    }

    private async Task ForgetFingerprint()
    {
        await Offsite.ForgetSftpFingerprintAsync();
        _sftpFingerprint = "";
        Show("Zapomniano klucz serwera — przy następnym połączeniu Portal zapamięta nowy.", false);
    }

    private async Task RemoveSftpKey()
    {
        await Offsite.SetSecretAsync(SiteSettingsService.Keys.BackupSftpPrivateKey, null);
        _hasSftpKey = false;
        Show("Usunięto klucz prywatny.", false);
    }

    private async Task RemoveEncPassword()
    {
        await Offsite.SetSecretAsync(SiteSettingsService.Keys.BackupOffsitePassword, null);
        _hasEncPassword = false;
        Show("Szyfrowanie wyłączone — kolejne kopie pójdą poza serwer jako zwykłe pliki .sql.gz.", false);
    }

    private void Show(string message, bool error)
    {
        _message = message;
        _msgError = error;
    }

    private async Task Load()
    {
        await using var db = DbFactory.CreateDbContext();
        _entries = await db.BackupEntries
            .AsNoTracking()
            .OrderByDescending(e => e.CreatedAt)
            .Take(500)
            .ToListAsync();
    }

    private async Task BackupAllNow()
    {
        _busy = true; _message = null;
        try
        {
            var (ok, fail, portalOk) = await BackupSvc.BackupAllAsync(BackupKind.Manual);
            _message = $"Zakończono. Trenerzy: {ok} OK / {fail} błąd. Portal: {(portalOk ? "OK" : "błąd")}.";
            _msgError = fail > 0 || !portalOk;
            await Load();
        }
        catch (Exception ex) { _message = ex.Message; _msgError = true; }
        _busy = false;
    }

    private async Task Cleanup()
    {
        _busy = true; _message = null;
        try
        {
            var removed = await BackupSvc.CleanupOldAsync();
            _message = $"Usunięto {removed} starych plików kopii.";
            _msgError = false;
            await Load();
        }
        catch (Exception ex) { _message = ex.Message; _msgError = true; }
        _busy = false;
    }

    private async Task SaveSettings()
    {
        await Settings.SetManyAsync(new Dictionary<string, string>
        {
            [SiteSettingsService.Keys.BackupDir] = _dir.Trim(),
            [SiteSettingsService.Keys.BackupSchedule] = _schedule,
            [SiteSettingsService.Keys.BackupRetentionDays] = _retentionDays.ToString(),
            [SiteSettingsService.Keys.BackupVerify] = _verify
        });
        _message = "Zapisano.";
        _msgError = false;
    }

    private static string Fmt(long bytes)
    {
        string[] suffix = { "B", "KB", "MB", "GB" };
        var i = 0;
        double n = bytes;
        while (n >= 1024 && i < suffix.Length - 1) { n /= 1024; i++; }
        return $"{n:0.#} {suffix[i]}";
    }
}
