@page "/panel/change-password"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<IdentityUser> UserMgr
@inject AuthenticationStateProvider AuthState
@rendermode InteractiveServer

<PageTitle>Zmiana hasła — PTScheduler Portal</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/panel" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h4 class="fw-bold mb-0"><i class="bi bi-shield-lock me-2 text-warning"></i>Zmiana hasła</h4>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <EditForm Model="_form" OnValidSubmit="Submit" FormName="changePassword">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Obecne hasło</label>
                        <InputText class="form-control" type="password" @bind-Value="_form.CurrentPassword" />
                        <ValidationMessage For="() => _form.CurrentPassword" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nowe hasło</label>
                        <InputText class="form-control" type="password" @bind-Value="_form.NewPassword" />
                        <ValidationMessage For="() => _form.NewPassword" />
                        <div class="form-text">Min. 8 znaków, wielka litera, cyfra, znak specjalny</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Powtórz nowe hasło</label>
                        <InputText class="form-control" type="password" @bind-Value="_form.ConfirmPassword" />
                        <ValidationMessage For="() => _form.ConfirmPassword" />
                    </div>

                    @if (_message is not null)
                    {
                        <div class="alert @(_isError ? "alert-danger" : "alert-success") py-2 small">
                            @_message
                        </div>
                    }

                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-check-lg me-1"></i>Zmień hasło
                    </button>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body">
                <h6 class="fw-bold"><i class="bi bi-info-circle me-2"></i>Wymagania hasła</h6>
                <ul class="small text-muted mb-0">
                    <li>Minimum 8 znaków</li>
                    <li>Przynajmniej jedna wielka litera</li>
                    <li>Przynajmniej jedna cyfra</li>
                    <li>Przynajmniej jeden znak specjalny</li>
                    <li>Nie może być takie samo jak obecne</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private PasswordForm _form = new();
    private string? _message;
    private bool _isError;
    private bool _saving;

    private async Task Submit()
    {
        _message = null;
        _saving = true;

        try
        {
            if (_form.NewPassword != _form.ConfirmPassword)
            {
                ShowMessage("Hasła nie są identyczne.", true);
                return;
            }

            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = await UserMgr.GetUserAsync(authState.User);
            if (user is null)
            {
                ShowMessage("Nie znaleziono użytkownika.", true);
                return;
            }

            var result = await UserMgr.ChangePasswordAsync(user, _form.CurrentPassword, _form.NewPassword);
            if (result.Succeeded)
            {
                ShowMessage("Hasło zostało zmienione.");
                _form = new();
            }
            else
            {
                var errors = string.Join(" ", result.Errors.Select(e => e.Description));
                ShowMessage($"Błąd: {errors}", true);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowMessage(string msg, bool isError = false)
    {
        _message = msg;
        _isError = isError;
    }

    private class PasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        public string CurrentPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Min. 8 znaków")]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        public string ConfirmPassword { get; set; } = "";
    }
}
