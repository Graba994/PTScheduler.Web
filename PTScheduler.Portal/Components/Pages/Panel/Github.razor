@page "/panel/github"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject SiteSettingsService Settings
@inject UpdateService UpdateSvc
@rendermode InteractiveServer

<PageTitle>GitHub — PTScheduler Portal</PageTitle>

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="bi bi-github me-2 text-primary"></i>GitHub</h4>
    <p class="text-muted small mb-0">Połączenie z repozytorium kodu — potrzebne do sprawdzania i pobierania aktualizacji</p>
</div>

@if (_saved)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-1"></i>Zapisano.
        <button type="button" class="btn-close" @onclick="() => _saved = false"></button>
    </div>
}

<EditForm Model="_form" OnValidSubmit="Save" FormName="github-config">
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">
            <i class="bi bi-folder2-open me-1"></i>Repozytorium
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Owner (użytkownik/organizacja)</label>
                    <input class="form-control font-monospace" @bind="_form.Owner" placeholder="graba994" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Nazwa repozytorium</label>
                    <input class="form-control font-monospace" @bind="_form.Repo" placeholder="ptscheduler.web" />
                </div>
            </div>
            <div class="mt-3">
                <label class="form-label small fw-semibold">Branch</label>
                <input class="form-control font-monospace" @bind="_form.Branch" placeholder="master" />
                <div class="form-text">Gałąź produkcyjna, z której pobierane są aktualizacje</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">
            <i class="bi bi-key me-1"></i>Personal Access Token
        </div>
        <div class="card-body">
            <div class="mb-0">
                <label class="form-label small fw-semibold">GitHub Token</label>
                <input type="password" class="form-control font-monospace" @bind="_form.Token" placeholder="ghp_... lub github_pat_..." />
                <div class="form-text">
                    Wymagany dla prywatnych repozytoriów. Utwórz w
                    <strong>GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)</strong>
                    z uprawnieniem <code>repo</code>.
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3">
        <button type="submit" class="btn btn-primary" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-floppy me-1"></i>Zapisz
        </button>

        <button type="button" class="btn btn-outline-secondary" @onclick="TestConnection" disabled="@_testing">
            @if (_testing)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-plug me-1"></i>Testuj połączenie
        </button>
    </div>
</EditForm>

@if (_testResult is not null)
{
    <div class="alert @(_testOk ? "alert-success" : "alert-danger") d-flex align-items-start gap-2">
        <i class="bi @(_testOk ? "bi-check-circle-fill" : "bi-x-circle-fill") fs-5 mt-1"></i>
        <div>
            <strong>@(_testOk ? "Połączenie OK" : "Błąd połączenia")</strong>
            <div class="small mt-1">@_testResult</div>
        </div>
    </div>
}

<div class="alert alert-info small">
    <i class="bi bi-info-circle me-1"></i>
    <strong>Jak to działa:</strong>
    Portal odpytuje GitHub API co 15 minut, żeby sprawdzić czy jest nowy commit.
    Jeśli tak — w menu pojawi się badge <span class="badge bg-warning text-dark" style="font-size:.65rem">NEW</span>
    przy <strong>Aktualizacje</strong>.
    Token nie jest wymagany dla publicznych repozytoriów.
</div>

@code {
    private GithubForm _form = new();
    private bool _saving, _saved;
    private bool _testing;
    private bool _testOk;
    private string? _testResult;

    private class GithubForm
    {
        public string Owner { get; set; } = "";
        public string Repo { get; set; } = "";
        public string Branch { get; set; } = "";
        public string Token { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var s = await Settings.GetAllAsync(
            SiteSettingsService.Keys.GithubOwner,
            SiteSettingsService.Keys.GithubRepo,
            SiteSettingsService.Keys.GithubBranch,
            SiteSettingsService.Keys.GithubToken);

        _form.Owner = s[SiteSettingsService.Keys.GithubOwner];
        _form.Repo = s[SiteSettingsService.Keys.GithubRepo];
        _form.Branch = s[SiteSettingsService.Keys.GithubBranch];
        _form.Token = s[SiteSettingsService.Keys.GithubToken];
    }

    private async Task Save()
    {
        _saving = true; _saved = false; _testResult = null;
        await Settings.SetManyAsync(new Dictionary<string, string>
        {
            [SiteSettingsService.Keys.GithubOwner] = _form.Owner.Trim(),
            [SiteSettingsService.Keys.GithubRepo] = _form.Repo.Trim(),
            [SiteSettingsService.Keys.GithubBranch] = _form.Branch.Trim(),
            [SiteSettingsService.Keys.GithubToken] = _form.Token.Trim()
        });
        _saving = false; _saved = true;
    }

    private async Task TestConnection()
    {
        _testing = true; _testResult = null;
        await Save();
        (_testOk, _testResult) = await UpdateSvc.TestConnectionAsync();
        _testing = false;
    }
}
