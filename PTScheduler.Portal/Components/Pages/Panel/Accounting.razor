            await LoadLedger();
            _o = await Acc.OverviewAsync();
        }
        finally { _busy = false; }
    }

    // ── Koszty ──

    private async Task LoadExpenses() => _expenses = await Acc.ExpensesAsync(new DateOnly(_expYear, 1, 1), new DateOnly(_expYear, 12, 31));

    private async Task PickProof(InputFileChangeEventArgs e)
    {
        _exp.Attachment = null; _proofName = null;
        if (e.File.Size > AccountingService.MaxAttachmentBytes) { Flash("Plik może mieć najwyżej 10 MB.", ""); return; }
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(AccountingService.MaxAttachmentBytes).CopyToAsync(ms);
        _exp.Attachment = ms.ToArray();
        _exp.AttachmentName = Path.GetFileName(e.File.Name);
        _exp.AttachmentType = e.File.ContentType;
        _proofName = _exp.AttachmentName;
    }

    private async Task AddExpense()
    {
        _busy = true;
        try
        {
            var error = await Acc.AddExpenseAsync(_exp, _actor);
            Flash(error, "Dodano koszt.");
            if (error is null) { _exp = NewExpense(); _proofName = null; }
            await LoadExpenses();
            _o = await Acc.OverviewAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteExpense(Expense e)
    {
        var error = await Acc.DeleteExpenseAsync(e.Id, _deleteExpReason ?? "", _actor);
        Flash(error, "Koszt usunięty (zostaje w historii zmian).");
        if (error is null) _deleteExpId = null;
        await LoadExpenses();
        _o = await Acc.OverviewAsync();
    }

    // ── Eksport ──

    private void ExportPreset(string preset)
    {
        _exportPreset = preset;
        var t = Today;
        var month = new DateOnly(t.Year, t.Month, 1);
        (_eFrom, _eTo) = preset switch
        {
            "month" => (month, t),
            "quarter" => LedgerQuarter(),
            "year" => (new DateOnly(t.Year, 1, 1), t),
            "prevyear" => (new DateOnly(t.Year - 1, 1, 1), new DateOnly(t.Year - 1, 12, 31)),
            _ => (month.AddMonths(-1), month.AddDays(-1))
        };
    }

    // ── Ustawienia ──

    private void FillForm()
    {
        var s = _s!;
        _form = new SettingsForm
        {
            SellerName = s.SellerName, SellerAddress = s.SellerAddress, SellerEmail = s.SellerEmail, SellerTaxId = s.SellerTaxId,
            SellerRegon = s.SellerRegon, SellerBank = s.SellerBank, VatNote = s.VatNote, AutoIssue = s.AutoIssue, EmailDocs = s.EmailDocs,
            Provider = s.Provider, FakturowniaDomain = s.FakturowniaDomain, PrefixReceipt = s.PrefixReceipt, PrefixInvoice = s.PrefixInvoice,
            PrefixCorrection = s.PrefixCorrection
        };
        _fMode = s.Mode;
        _fUnregSince = s.UnregisteredSince;
        _fStart = s.Start;
        _fBizSince = s.BusinessSince;
        _fVat = s.Vat;
        _fQuarterLimit = s.QuarterLimit?.ToString("0.00", FinanceRules.Pl);
        _fVatLimit = s.VatLimit?.ToString("0.00", FinanceRules.Pl);
        _fReserve = s.TaxReservePct.ToString("0.#", FinanceRules.Pl);
        if (string.IsNullOrWhiteSpace(_swName)) _swName = s.SellerName;
        if (string.IsNullOrWhiteSpace(_swAddress)) _swAddress = s.SellerAddress;
        if (string.IsNullOrWhiteSpace(_swBank)) _swBank = s.SellerBank;
        _testMsg = null;
    }

    private async Task SaveSettings()
    {
        if (_form is null) return;
        _busy = true;
        try
        {
            var f = _form;
            var n = _s! with
            {
                Mode = _fMode, UnregisteredSince = _fUnregSince, Start = _fStart, BusinessSince = _fBizSince, Vat = _fVat,
                SellerName = f.SellerName ?? "", SellerAddress = f.SellerAddress ?? "", SellerEmail = f.SellerEmail ?? "",
                SellerTaxId = _fMode == FinanceModes.Business ? f.SellerTaxId ?? "" : "",
                SellerRegon = _fMode == FinanceModes.Business ? f.SellerRegon ?? "" : "",
                SellerBank = f.SellerBank ?? "", VatNote = f.VatNote ?? "", AutoIssue = f.AutoIssue, EmailDocs = f.EmailDocs,
                Provider = f.Provider, FakturowniaDomain = f.FakturowniaDomain ?? "",
                PrefixReceipt = f.PrefixReceipt ?? "", PrefixInvoice = f.PrefixInvoice ?? "", PrefixCorrection = f.PrefixCorrection ?? "",
                QuarterLimit = FinanceRules.ParseAmount(_fQuarterLimit) is > 0 and var q ? q : null,
                VatLimit = FinanceRules.ParseAmount(_fVatLimit) is > 0 and var v ? v : null,
                TaxReservePct = FinanceRules.ParseAmount(_fReserve) is >= 0 and <= 100 and var p ? p : 12m
            };
            var error = await Acc.SaveSettingsAsync(n, _actor);
            if (error is null && !string.IsNullOrWhiteSpace(_token))
            {
                await Acc.SetFakturowniaTokenAsync(_token, _actor);
                _token = null;
            }
            Flash(error, "Zapisano ustawienia księgowości.");
            if (error is null)
            {
                await ReloadAsync();
                FillForm();
            }
        }
        finally { _busy = false; }
    }

    private async Task TestFakturownia()
    {
        _busy = true;
        try
        {
            // Najpierw zapisujemy subdomenę i nowy token, żeby test sprawdzał to, co jest w formularzu.
            if (FakturowniaClient.NormalizeDomain(_form?.FakturowniaDomain) is not { } domain)
            {
                (_testOk, _testMsg) = (false, "Podaj subdomenę konta (część adresu przed .fakturownia.pl).");
                return;
            }
            await Acc.SetFakturowniaDomainAsync(domain, _actor);
            if (!string.IsNullOrWhiteSpace(_token)) { await Acc.SetFakturowniaTokenAsync(_token, _actor); _token = null; }
            (_testOk, _testMsg) = await Fakturownia.TestAsync();
            _s = await Acc.GetSettingsAsync();
        }
        finally { _busy = false; }
    }

    private async Task RemoveToken()
    {
        await Acc.SetFakturowniaTokenAsync(null, _actor);
        _s = await Acc.GetSettingsAsync();
        Flash(null, "Token Fakturowni usunięty.");
    }

    private async Task SwitchToBusiness()
    {
        _busy = true;
        try
        {
            var error = await Acc.SwitchToBusinessAsync(_swSince, _swName ?? "", _swAddress ?? "", _swNip ?? "", _swRegon ?? "", _swBank ?? "", _swVat, _actor);
            Flash(error, $"Gratulacje! Od {_swSince:dd.MM.yyyy} dokumenty wystawia firma. Ewidencja i numeracja biegną dalej.");
            if (error is null)
            {
                _switchOpen = false;
                await ReloadAsync();
                FillForm();
            }
        }
        finally { _busy = false; }
    }
}
