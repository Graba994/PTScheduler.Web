    private void Flash(string? error, string ok)
    {
        _flashOk = error is null;
        _flash = error ?? ok;
    }

    private string ModeHeadline() => _o!.ModeToday switch
    {
        FinanceModes.Unregistered => "Działalność nierejestrowana",
        FinanceModes.Business => _s!.Vat == "vat" ? "Firma — czynny podatnik VAT" : "Firma — zwolnienie z VAT",
        _ => "Księgowość nie jest jeszcze ustawiona"
    };

    private string ModeDetail()
    {
        var s = _s!;
        if (!s.Configured) return "Wpłaty nie trafiają jeszcze do ewidencji. Ustaw formę działalności i dane sprzedawcy.";
        var parts = new List<string>();
        if (_o!.ModeToday == FinanceModes.Business && s.BusinessSince is { } b) parts.Add($"od {b:dd.MM.yyyy}");
        else if (s.UnregisteredSince is { } u) parts.Add($"od {u:dd.MM.yyyy}");
        if (s.Start is { } st) parts.Add($"ewidencja od {st:dd.MM.yyyy}");
        if (s.Mode == FinanceModes.Business && s.UnregisteredSince is { } u2 && s.BusinessSince is { } b2) parts.Add($"wcześniej nierejestrowana ({u2:dd.MM.yyyy} – {b2.AddDays(-1):dd.MM.yyyy})");
        return string.Join(" · ", parts);
    }

    private IEnumerable<(bool Ok, string Text, string? Tab)> Checklist()
    {
        var s = _s!;
        var o = _o!;
        yield return (s.MissingSellerData().Count == 0, "Dane sprzedawcy na dokumentach", "ustawienia");
        yield return (s.Start is not null, s.Start is { } st ? $"Ewidencja prowadzona od {st:dd.MM.yyyy}" : "Ewidencja wpłat włączona", "ustawienia");
        yield return (s.AutoIssue, "Dokument po każdej wpłacie", "ustawienia");
        yield return (o.PaymentsWithoutDoc == 0, "Każda wpłata ma dokument", "dokumenty");
        yield return (o.PendingDocs == 0, "Brak dokumentów czekających na numer", "dokumenty");
        yield return (o.ExpensesWithoutProof == 0, "Koszty mają dowody", "koszty");
        yield return (o.LastExport is { } le && AccountingService.LocalDate(le) >= new DateOnly(Today.Year, Today.Month, 1).AddMonths(Today.Day >= 5 ? 0 : -1),
            "Kopia za poprzedni miesiąc poza Hantly", "eksport");
    }

    private static string MonthName(int m) => FinanceRules.Pl.DateTimeFormat.MonthNames[m - 1] is { Length: > 0 } n ? char.ToUpper(n[0]) + n[1..] : m.ToString();

    private static string Pct(decimal value, decimal total, decimal offset = 0)
    {
        if (total <= 0) return "0";
        var room = Math.Max(0, 100 - offset * 100 / total);
        var p = Math.Clamp(value * 100 / total, 0, room);
        return p.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string ExportUrl(string file, DateOnly from, DateOnly to) => $"/api/panel/ksiegowosc/{file}?od={from:yyyy-MM-dd}&do={to:yyyy-MM-dd}";

    private async Task SyncNow()
    {
        _busy = true;
        try
        {
            var r = await Acc.SyncAsync(_actor);
            var msg = $"Nowe wpisy w ewidencji: {r.Ledger}, dokumenty: {r.Documents}, z Fakturowni: {r.Synced}, wysłane: {r.Emailed}.";
            Flash(r.Errors.Count > 0 ? msg + " Uwaga: " + r.Errors.Distinct().First() : null, msg);
            await ReloadAsync();
            await SelectTab(_tab);
        }
        finally { _busy = false; }
