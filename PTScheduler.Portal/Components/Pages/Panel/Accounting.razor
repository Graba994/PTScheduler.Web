@page "/panel/ksiegowosc"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject AccountingService Acc
@inject FakturowniaClient Fakturownia
@inject IDbContextFactory<PortalDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@rendermode InteractiveServer

@* Księgowość platformy: od działalności nierejestrowanej do firmy, bez przerwy w ewidencji i numeracji.
   Wystawionych dokumentów i wpisów się nie zmienia — korekta, sprostowanie, a wszystko w historii zmian. *@

<PageTitle>Księgowość — Hantly Portal</PageTitle>

<PanelHeader Title="Księgowość" Icon="bi-journal-check" IconClass="pp-tone-ok"
             Subtitle="Ewidencja sprzedaży, rachunki i faktury, koszty i limit — w jednym miejscu, od działalności nierejestrowanej po firmę.">
    <Actions>
        @if (_s?.Configured == true)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="SyncNow" disabled="@_busy"><i class="bi bi-arrow-repeat me-1"></i>Synchronizuj wpłaty</button>
            <button class="btn btn-sm btn-primary" @onclick="OpenNewDocument"><i class="bi bi-plus-lg me-1"></i>Wystaw dokument</button>
        }
    </Actions>
</PanelHeader>

@if (_o is null || _s is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="acc-mode @(_s.Configured ? "" : "acc-mode-off")">
        <span class="acc-mode-icon"><i class="bi @(_o.ModeToday == FinanceModes.Business ? "bi-building-check" : _s.Configured ? "bi-person-badge" : "bi-signpost-split")"></i></span>
        <div class="acc-mode-text">
            <b>@ModeHeadline()</b>
            <span>@ModeDetail()</span>
        </div>
        @if (_s.Configured)
        {
            <span class="pp-chip @(_s.UsesFakturownia ? "pp-tone-info" : "pp-tone-muted")"><i class="bi @(_s.UsesFakturownia ? "bi-cloud-check" : "bi-file-earmark-text")"></i>@(_s.UsesFakturownia ? "Dokumenty w Fakturowni" : "Dokumenty w Hantly")</span>
            <span class="pp-chip @(_s.AutoIssue ? "pp-tone-ok" : "pp-tone-muted")"><i class="bi bi-lightning-charge"></i>@(_s.AutoIssue ? "Automatycznie po wpłacie" : "Dokumenty ręcznie")</span>
        }
    </div>

    @if (_flash is not null)
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-danger") py-2 small d-flex align-items-center gap-2" role="status">
            <i class="bi @(_flashOk ? "bi-check-circle" : "bi-exclamation-triangle")"></i><span>@_flash</span>
            <button type="button" class="btn-close ms-auto" aria-label="Zamknij" @onclick="() => _flash = null"></button>
        </div>
    }

    <ul class="nav pp-tabs mb-3" role="tablist">
        @foreach (var (key, label, icon) in Tabs)
        {
            <li class="nav-item" role="presentation">
                <button type="button" role="tab" class="nav-link @(_tab == key ? "active" : "")" aria-selected="@(_tab == key ? "true" : "false")" @onclick="() => SelectTab(key)">
                    <i class="bi @icon me-1"></i>@label
                    @if (key == "dokumenty" && _o.PendingDocs + _o.PaymentsWithoutDoc > 0)
                    {
                        <span class="acc-dot" title="Do uwagi"></span>
                    }
                </button>
            </li>
        }
    </ul>

    @if (_tab == "przeglad")
    {
        @if (!_s.Configured)
        {
            <div class="pp-card acc-start">
                <h2 class="pp-card-title mb-2">Zacznijmy od formy działalności</h2>
                <p class="text-muted small mb-3">Wybierz, jak teraz sprzedajesz. Od wybranej daty każda wpłata trafi do ewidencji sprzedaży, a dokument (rachunek albo faktura) powstanie sam. Gdy założysz firmę, przełączysz to jednym kliknięciem — ewidencja i numeracja biegną dalej.</p>
                <div class="acc-choice">
                    <button type="button" class="acc-choice-btn" @onclick='() => StartWith(FinanceModes.Unregistered)'>
                        <i class="bi bi-person-badge"></i><b>Działalność nierejestrowana</b>
                        <span>Bez CEIDG, do limitu kwartalnego (w 2026 r. @FinanceRules.Money(FinanceRules.QuarterLimit(2026, 1).Limit)). Rachunki i ewidencja sprzedaży.</span>
                    </button>
                    <button type="button" class="acc-choice-btn" @onclick='() => StartWith(FinanceModes.Business)'>
                        <i class="bi bi-building-check"></i><b>Firma (CEIDG)</b>
                        <span>Masz NIP i wpis w CEIDG. Faktury bez VAT albo z VAT.</span>
                    </button>
                </div>
            </div>
        }

        @foreach (var a in _o.Alerts)
        {
            <div class="acc-alert pp-tone-@a.Tone">
                <i class="bi @a.Icon"></i>
                <div class="min-w-0"><b>@a.Title</b><span>@a.Text</span></div>
                @if (a.Tab is { } t)
                {
                    <button class="btn btn-sm btn-light ms-auto" @onclick="() => SelectTab(t)">Przejdź</button>
                }
            </div>
        }

        @if (_o.Quarter is { } q)
        {
            <div class="pp-card acc-limit pp-tone-@q.Tone">
                <div class="acc-limit-head">
                    <div>
                        <span class="acc-eyebrow">Limit działalności nierejestrowanej · @(q.Quarter). kwartał @q.Year</span>
                        <div class="acc-limit-big"><b>@FinanceRules.Money(q.Total)</b><span>z @FinanceRules.Money(q.Limit)</span></div>
                    </div>
                    <div class="acc-limit-pct">@(q.Percent)%</div>
                </div>
                <div class="acc-bar" role="img" aria-label="@($"Wykorzystano {q.Percent}% limitu")">
                    <span class="acc-bar-paid" style="width:@Pct(q.Received, q.Limit)%"></span>
                    <span class="acc-bar-open" style="width:@Pct(q.Outstanding, q.Limit, q.Received)%"></span>
                    @if (q.Forecast > q.Total)
                    {
                        <span class="acc-bar-forecast" style="left:@Pct(q.Forecast, q.Limit)%" title="Prognoza na koniec kwartału"></span>
                    }
                </div>
                <dl class="acc-limit-facts">
                    <div><dt>Wpłynęło</dt><dd>@FinanceRules.Money(q.Received)</dd></div>
                    <div><dt>Wystawione, nieopłacone</dt><dd>@FinanceRules.Money(q.Outstanding)</dd></div>
                    <div><dt>Zostało</dt><dd>@FinanceRules.Money(q.Left)</dd></div>
                    <div><dt>Prognoza na @q.End.ToString("dd.MM")</dt><dd>@FinanceRules.Money(q.Forecast)</dd></div>
                </dl>
                <p class="acc-fine">Limit to 225% minimalnego wynagrodzenia na kwartał@(q.Estimated ? " (płaca na ten rok nieznana — sprawdź i wpisz limit w ustawieniach)." : ".") Liczymy wpłaty z ewidencji i rachunki wystawione w tym kwartale, jeszcze nieopłacone. Prognoza zakłada dotychczasowe tempo sprzedaży.</p>
                @if (_o.YearQuarters.Count > 1)
                {
                    <div class="acc-quarters">
                        @foreach (var yq in _o.YearQuarters)
                        {
                            <div class="acc-q pp-tone-@yq.Tone @(yq.Quarter == q.Quarter ? "now" : "")">
                                <span>Q@(yq.Quarter)</span>
                                <div class="acc-q-bar"><i style="height:@Pct(yq.Total, yq.Limit)%"></i></div>
                                <small>@yq.Percent%</small>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_o.Vat is { } v)
        {
            <div class="pp-card acc-limit pp-tone-@v.Tone">
                <span class="acc-eyebrow">Limit zwolnienia z VAT · @v.Year</span>
                <div class="acc-limit-big"><b>@FinanceRules.Money(v.Revenue)</b><span>z @FinanceRules.Money(v.Limit) (@v.Percent%)</span></div>
                <div class="acc-bar"><span class="acc-bar-paid" style="width:@Pct(v.Revenue, v.Limit)%"></span></div>
                <p class="acc-fine">Limit proporcjonalny do dni działania firmy w roku. Kwotę limitu sprawdź z księgową i w razie zmian przepisów wpisz ją w ustawieniach.</p>
            </div>
        }

        @if (_s.Configured)
        {
            <div class="pp-stats">
                <StatTile Label="Ten miesiąc" Value="@FinanceRules.Money(_o.MonthRevenue)" Icon="bi-calendar-event" Tone="info" />
                <StatTile Label="Przychód w roku" Value="@FinanceRules.Money(_o.YearRevenue)" Icon="bi-graph-up-arrow" Tone="ok" />
                <StatTile Label="Koszty w roku" Value="@FinanceRules.Money(_o.YearCosts)" Meta="@(_o.ExpensesWithoutProof > 0 ? $"{_o.ExpensesWithoutProof} bez dowodu" : null)" Icon="bi-bag" Tone="muted" />
                <StatTile Label="Odłóż na podatek" Value="@FinanceRules.Money(_o.TaxReserve)" Meta="@($"szacunek: {_s.TaxReservePct:0.#}% od {FinanceRules.Money(_o.YearIncome)}")" Icon="bi-piggy-bank" Tone="warn" />
            </div>

            <div class="row g-3">
                <div class="col-lg-7">
                    <div class="pp-card h-100">
                        <h2 class="pp-card-title mb-3">Przychód i koszty w @Today.Year</h2>
                        <div class="acc-months" role="img" aria-label="Wykres miesięcznego przychodu i kosztów">
                            @foreach (var m in _o.Months)
                            {
                                <div class="acc-month @(m.Month == Today.Month ? "now" : "")" title="@($"{MonthName(m.Month)}: przychód {FinanceRules.Money(m.Revenue)}, koszty {FinanceRules.Money(m.Costs)}")">
                                    <div class="acc-month-bars">
                                        <i class="rev" style="height:@Pct(m.Revenue, MonthMax)%"></i>
                                        <i class="cost" style="height:@Pct(m.Costs, MonthMax)%"></i>
                                    </div>
                                    <span>@(MonthName(m.Month)[..3])</span>
                                </div>
                            }
                        </div>
                        <div class="acc-legend"><span><i class="rev"></i>Przychód</span><span><i class="cost"></i>Koszty</span></div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="pp-card h-100">
                        <h2 class="pp-card-title mb-3">Porządek w papierach</h2>
                        <ul class="acc-check">
                            @foreach (var (ok, text, tab) in Checklist())
                            {
                                <li class="@(ok ? "ok" : "")">
                                    <i class="bi @(ok ? "bi-check-circle-fill" : "bi-circle")"></i>
                                    <span>@text</span>
                                    @if (!ok && tab is not null)
                                    {
                                        <button class="btn btn-link btn-sm p-0 ms-auto" @onclick="() => SelectTab(tab)">Zrób to</button>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    }

    @if (_tab == "dokumenty")
    {
        @if (_newDoc is not null)
        {
            <div class="pp-card acc-form">
                <div class="pp-card-head">
                    <h2 class="pp-card-title">Nowy dokument</h2>
                    <button class="btn btn-sm btn-link ms-auto" @onclick="() => _newDoc = null">Anuluj</button>
                </div>
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Rodzaj</label>
                        <select class="form-select form-select-sm" @bind="_newDoc.Kind">
                            @foreach (var k in AccountingService.ManualKinds(_s, _newDoc.SaleDate))
                            {
                                <option value="@k">@SalesDocumentKinds.Label(k)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Data sprzedaży</label>
                        <input type="date" class="form-control form-control-sm" @bind="_newDoc.SaleDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Trener (wypełni dane nabywcy)</label>
                        <select class="form-select form-select-sm" value="@(_newDoc.TenantId?.ToString() ?? "")" @onchange="PickTenant">
                            <option value="">— inny nabywca —</option>
                            @foreach (var t in _tenants)
                            {
                                <option value="@t.Id">@t.CompanyName (@t.OwnerName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6"><label class="form-label small mb-1">Nabywca</label><input class="form-control form-control-sm" @bind="_newDoc.BuyerName" maxlength="300" /></div>
                    <div class="col-md-3"><label class="form-label small mb-1">NIP nabywcy</label><input class="form-control form-control-sm" @bind="_newDoc.BuyerTaxId" maxlength="20" /></div>
                    <div class="col-md-3"><label class="form-label small mb-1">E-mail nabywcy</label><input class="form-control form-control-sm" @bind="_newDoc.BuyerEmail" maxlength="256" /></div>
                    <div class="col-12"><label class="form-label small mb-1">Adres nabywcy</label><textarea class="form-control form-control-sm" rows="2" @bind="_newDoc.BuyerAddress" maxlength="500"></textarea></div>
                </div>

                <div class="acc-lines mt-3">
                    <div class="acc-line acc-line-head"><span>Nazwa</span><span>Ilość</span><span>Jedn.</span><span>Cena brutto</span>@if (_newDoc.Kind == SalesDocumentKinds.InvoiceVat) { <span>VAT</span> }<span></span></div>
                    @foreach (var line in _newDoc.Lines)
                    {
                        <div class="acc-line">
                            <input class="form-control form-control-sm" @bind="line.Name" placeholder="np. Konsultacja wdrożeniowa" maxlength="300" aria-label="Nazwa" />
                            <input class="form-control form-control-sm" type="number" min="0" step="0.001" @bind="line.Quantity" aria-label="Ilość" />
                            <input class="form-control form-control-sm" @bind="line.Unit" maxlength="16" aria-label="Jednostka" />
                            <input class="form-control form-control-sm" type="number" min="0" step="0.01" @bind="line.UnitGross" aria-label="Cena brutto" />
                            @if (_newDoc.Kind == SalesDocumentKinds.InvoiceVat)
                            {
                                <select class="form-select form-select-sm" @bind="line.VatRate" aria-label="Stawka VAT">
                                    <option value="23">23%</option><option value="8">8%</option><option value="5">5%</option><option value="0">0%</option><option value="zw">zw</option>
                                </select>
                            }
                            <button class="btn btn-sm btn-outline-secondary" title="Usuń pozycję" aria-label="Usuń pozycję" disabled="@(_newDoc.Lines.Count == 1)" @onclick="() => _newDoc.Lines.Remove(line)"><i class="bi bi-x"></i></button>
                        </div>
                    }
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => _newDoc.Lines.Add(new())"><i class="bi bi-plus me-1"></i>Pozycja</button>
                        <b class="ms-auto">Razem: @FinanceRules.Money(_newDoc.Lines.Sum(l => Math.Round(l.UnitGross * l.Quantity, 2)))</b>
                    </div>
                </div>

                <div class="row g-2 mt-1">
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Sposób zapłaty</label>
                        <select class="form-select form-select-sm" @bind="_newDoc.PaymentMethod">
                            <option value="przelew">przelew</option><option value="karta">karta</option><option value="gotówka">gotówka</option><option value="płatność online">płatność online</option>
                        </select>
                    </div>
                    <div class="col-md-9"><label class="form-label small mb-1">Uwagi na dokumencie (opcjonalnie)</label><input class="form-control form-control-sm" @bind="_newDoc.Note" maxlength="1000" /></div>
                </div>
                <div class="d-flex flex-wrap gap-3 mt-2 small">
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_newDoc.Paid" /> <span class="form-check-label">Zapłacono</span></label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_newDoc.AddToLedger" /> <span class="form-check-label">Wpisz do ewidencji sprzedaży</span></label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_newDoc.SendEmail" /> <span class="form-check-label">Wyślij PDF e-mailem</span></label>
                </div>
                <p class="acc-fine mt-2">Wpłat z platformy nie wpisuj tutaj — trafiają do ewidencji same. Ten formularz jest dla sprzedaży poza aplikacją (np. wdrożenie, konsultacja).</p>
                <button class="btn btn-primary btn-sm" @onclick="IssueManual" disabled="@_busy"><i class="bi bi-check2 me-1"></i>Wystaw @SalesDocumentKinds.Label(_newDoc.Kind).ToLowerInvariant()</button>
            </div>
        }

        @if (_noDoc.Count > 0)
        {
            <div class="pp-card">
                <div class="pp-card-head">
                    <h2 class="pp-card-title">Wpłaty bez dokumentu</h2>
                    <span class="pp-chip pp-tone-warn">@_noDoc.Count</span>
                    <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="IssueAllMissing" disabled="@_busy">Wystaw wszystkie</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle small mb-0">
                        <tbody>
                            @foreach (var e in _noDoc)
                            {
                                <tr>
                                    <td class="text-nowrap">@e.Date.ToString("dd.MM.yyyy")</td>
                                    <td>@e.Description</td>
                                    <td class="text-end text-nowrap fw-semibold">@FinanceRules.Money(e.Amount)</td>
                                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary" @onclick="() => IssueFor(e)" disabled="@_busy">Wystaw</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="pp-card pp-card-flush">
            <div class="acc-filters">
                <select class="form-select form-select-sm" @bind="_fYear" @bind:after="LoadDocs" aria-label="Rok">
                    <option value="0">Wszystkie lata</option>
                    @for (var y = Today.Year; y >= Today.Year - 5; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <select class="form-select form-select-sm" @bind="_fMonth" @bind:after="LoadDocs" aria-label="Miesiąc">
                    <option value="0">Cały rok</option>
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m">@MonthName(m)</option>
                    }
                </select>
                <select class="form-select form-select-sm" @bind="_fKind" @bind:after="LoadDocs" aria-label="Rodzaj">
                    <option value="">Wszystkie rodzaje</option>
                    @foreach (var k in SalesDocumentKinds.All)
                    {
                        <option value="@k">@SalesDocumentKinds.Label(k)</option>
                    }
                </select>
                <input class="form-control form-control-sm" placeholder="Numer, nabywca, NIP…" @bind="_fQuery" @bind:event="oninput" @bind:after="LoadDocs" aria-label="Szukaj" />
                <label class="form-check small mb-0 text-nowrap"><input class="form-check-input" type="checkbox" @bind="_fProblems" @bind:after="LoadDocs" /> <span class="form-check-label">Do uwagi</span></label>
            </div>
            @if (_docs.Count == 0)
            {
                <p class="text-muted small p-3 mb-0">Brak dokumentów dla tych filtrów.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle small mb-0 acc-table">
                        <thead class="table-light">
                            <tr><th>Numer</th><th>Rodzaj</th><th>Wystawiony</th><th>Nabywca</th><th class="text-end">Kwota</th><th>Stan</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _docs)
                            {
                                <tr class="@(d.Status == SalesDocumentStatus.Cancelled ? "acc-cancelled" : "")">
                                    <td class="font-monospace text-nowrap">@(d.Number.Length > 0 ? d.Number : "—")</td>
                                    <td class="text-nowrap">@SalesDocumentKinds.Label(d.Kind)</td>
                                    <td class="text-nowrap">@d.IssueDate.ToString("dd.MM.yyyy")</td>
                                    <td class="acc-buyer">@d.BuyerName @if (d.BuyerTaxId is not null) { <small class="text-muted">NIP @d.BuyerTaxId</small> }</td>
                                    <td class="text-end text-nowrap fw-semibold @(d.Gross < 0 ? "text-danger" : "")">@FinanceRules.Money(d.Gross)</td>
                                    <td>
                                        <span class="d-inline-flex flex-wrap gap-1">
                                            @if (d.Status == SalesDocumentStatus.Pending)
                                            {
                                                <span class="pp-chip pp-tone-warn" title="@d.ExternalError"><i class="bi bi-cloud-slash"></i>czeka na Fakturownię</span>
                                            }
                                            else if (d.Status == SalesDocumentStatus.Cancelled)
                                            {
                                                <span class="pp-chip pp-tone-muted" title="@d.CancelReason">anulowany</span>
                                            }
                                            else
                                            {
                                                @if (d.ExternalId is not null) { <span class="pp-chip pp-tone-info"><i class="bi bi-cloud-check"></i>Fakturownia</span> }
                                                @if (d.EmailedAt is not null) { <span class="pp-chip pp-tone-ok"><i class="bi bi-envelope-check"></i>wysłany</span> }
                                                else if (d.BuyerEmail is not null) { <span class="pp-chip pp-tone-muted">niewysłany</span> }
                                            }
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (d.Status != SalesDocumentStatus.Pending)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="/api/panel/ksiegowosc/dokument/@(d.Id).pdf" target="_blank" title="PDF" aria-label="PDF"><i class="bi bi-file-pdf"></i></a>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenDoc(d)" title="Więcej" aria-label="Więcej"><i class="bi bi-three-dots"></i></button>
                                    </td>
                                </tr>
                                @if (_open?.Id == d.Id)
                                {
                                    <tr class="acc-open">
                                        <td colspan="7">
                                            <div class="acc-doc">
                                                <div class="acc-doc-meta">
                                                    <div><small>Sprzedaż</small>@d.SaleDate.ToString("dd.MM.yyyy")</div>
                                                    <div><small>Zapłata</small>@(d.PaidDate?.ToString("dd.MM.yyyy") ?? "—") @d.PaymentMethod</div>
                                                    <div><small>Forma</small>@AccountingService.ModeLabel(d.Mode)</div>
                                                    <div><small>E-mail</small>@(d.BuyerEmail ?? "—")</div>
                                                    @if (d.CorrectionReason is not null) { <div><small>Przyczyna korekty</small>@d.CorrectionReason</div> }
                                                    @if (d.CancelReason is not null) { <div><small>Powód anulowania</small>@d.CancelReason</div> }
                                                    @if (d.ExternalError is not null) { <div class="text-danger"><small>Błąd Fakturowni (próba @d.ExternalAttempts)</small>@d.ExternalError</div> }
                                                    @if (d.ExternalUrl is not null) { <div><small>Fakturownia</small><a href="@d.ExternalUrl" target="_blank" rel="noopener">otwórz dokument</a></div> }
                                                </div>
                                                <div class="acc-doc-actions">
                                                    @if (d.Status == SalesDocumentStatus.Pending)
                                                    {
                                                        <button class="btn btn-sm btn-primary" @onclick="() => Retry(d)" disabled="@_busy">Ponów w Fakturowni</button>
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => IssueLocal(d)" disabled="@_busy">Wystaw z numerem Hantly</button>
                                                    }
                                                    @if (d.Status == SalesDocumentStatus.Issued)
                                                    {
                                                        <div class="acc-inline">
                                                            <input class="form-control form-control-sm" placeholder="@(d.BuyerEmail ?? "adres e-mail")" @bind="_emailTo" aria-label="Adres e-mail" />
                                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SendDoc(d)" disabled="@_busy"><i class="bi bi-send me-1"></i>@(d.EmailedAt is null ? "Wyślij" : "Wyślij ponownie")</button>
                                                        </div>
                                                        @if (d.Kind != SalesDocumentKinds.Correction)
                                                        {
                                                            <div class="acc-inline">
                                                                <input class="form-control form-control-sm acc-amount" type="number" min="0" step="0.01" placeholder="kwota" @bind="_corrAmount" aria-label="Kwota korekty" />
                                                                <input class="form-control form-control-sm" placeholder="przyczyna (np. zwrot za maj)" @bind="_corrReason" maxlength="500" aria-label="Przyczyna korekty" />
                                                                <button class="btn btn-sm btn-outline-warning" @onclick="() => Correct(d)" disabled="@_busy">Korekta in minus</button>
                                                            </div>
                                                        }
                                                    }
                                                    @if (d.Status != SalesDocumentStatus.Cancelled && !d.InCirculation)
                                                    {
                                                        <div class="acc-inline">
                                                            <input class="form-control form-control-sm" placeholder="powód anulowania (np. zły nabywca)" @bind="_cancelReason" maxlength="500" aria-label="Powód anulowania" />
                                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancel(d)" disabled="@_busy">Anuluj</button>
                                                        </div>
                                                        <p class="acc-fine mb-0">Anulować można tylko dokument, który nie wyszedł do nabywcy. Wpłata zostaje w ewidencji i czeka na nowy dokument.</p>
                                                    }
                                                    else if (d.Status == SalesDocumentStatus.Issued)
                                                    {
                                                        <p class="acc-fine mb-0">Dokument wyszedł do nabywcy — błędy prostuje się korektą.</p>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (_tab == "ewidencja")
    {
        <div class="pp-card">
            <div class="acc-period">
                <input type="month" class="form-control form-control-sm" value="@_ledgerMonth" @onchange="SetLedgerMonth" aria-label="Miesiąc" />
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => LedgerRange(LedgerQuarter())">Ten kwartał</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => LedgerRange((new DateOnly(Today.Year, 1, 1), Today))">Ten rok</button>
                <span class="text-muted small ms-1">@_lFrom.ToString("dd.MM.yyyy") – @_lTo.ToString("dd.MM.yyyy")</span>
                <span class="ms-auto d-inline-flex gap-1">
                    <a class="btn btn-sm btn-outline-secondary" href="@ExportUrl("ewidencja.csv", _lFrom, _lTo)" download><i class="bi bi-filetype-csv me-1"></i>CSV</a>
                    <a class="btn btn-sm btn-outline-secondary" href="@ExportUrl("ewidencja.pdf", _lFrom, _lTo)" target="_blank"><i class="bi bi-file-pdf me-1"></i>PDF</a>
                </span>
            </div>
            @if (_days.Count == 0)
            {
                <p class="text-muted small mb-0 mt-3">Brak sprzedaży w tym okresie.</p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle small mb-0 acc-table">
                        <thead class="table-light"><tr><th>Lp.</th><th>Data</th><th>Sprzedaż</th><th class="text-end">Z dnia</th><th class="text-end">Narastająco w miesiącu</th></tr></thead>
                        <tbody>
                            @foreach (var d in _days)
                            {
                                <tr>
                                    <td class="text-muted">@d.No</td>
                                    <td class="text-nowrap">@d.Date.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @foreach (var e in d.Entries)
                                        {
                                            <div class="acc-entry">
                                                <span class="@(e.Amount < 0 ? "text-danger" : "")">@e.Description</span>
                                                <small class="text-muted text-nowrap">@FinanceRules.Money(e.Amount)</small>
                                                @if (e.ReversesId is null && e.Source != "correction")
                                                {
                                                    <button class="btn btn-link btn-sm p-0 acc-mini" @onclick="() => { _reverseId = e.Id; _reverseReason = null; }">sprostuj</button>
                                                }
                                            </div>
                                            @if (_reverseId == e.Id)
                                            {
                                                <div class="acc-inline my-1">
                                                    <input class="form-control form-control-sm" placeholder="powód (np. pomyłka w kwocie)" @bind="_reverseReason" aria-label="Powód sprostowania" />
                                                    <button class="btn btn-sm btn-outline-warning" @onclick="() => Reverse(e)" disabled="@_busy">Dodaj wpis in minus</button>
                                                    <button class="btn btn-sm btn-link" @onclick="() => _reverseId = null">Anuluj</button>
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td class="text-end text-nowrap fw-semibold">@FinanceRules.Money(d.Amount)</td>
                                    <td class="text-end text-nowrap">@FinanceRules.Money(d.MonthToDate)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><th colspan="3">Razem w okresie</th><th class="text-end text-nowrap">@FinanceRules.Money(_days.Sum(d => d.Amount))</th><th></th></tr></tfoot>
                    </table>
                </div>
            }
        </div>

        <div class="pp-card acc-form">
            <h2 class="pp-card-title mb-2">Sprzedaż spoza aplikacji</h2>
            <p class="acc-fine">Np. gotówka za wdrożenie albo przelew na konto. Wpłaty z platformy dopisują się same. Wpisu nie da się usunąć — pomyłkę prostuje wpis in minus.</p>
            <div class="acc-inline">
                <input type="date" class="form-control form-control-sm acc-date" @bind="_manualDate" aria-label="Data" />
                <input type="number" step="0.01" class="form-control form-control-sm acc-amount" placeholder="kwota" @bind="_manualAmount" aria-label="Kwota" />
                <input class="form-control form-control-sm" placeholder="co i dla kogo" @bind="_manualDesc" maxlength="500" aria-label="Opis" />
                <button class="btn btn-sm btn-primary" @onclick="AddManual" disabled="@_busy">Dopisz</button>
            </div>
        </div>
        <p class="acc-fine">Ewidencja liczy sprzedaż w dniu wpłaty: przychód z dnia i sumę narastająco od początku miesiąca. Wymagania dotyczące ewidencji przy działalności nierejestrowanej sprawdź z księgową — Hantly porządkuje dane, ale nie zastępuje doradcy.</p>
    }

    @if (_tab == "koszty")
    {
        <div class="pp-card acc-form">
            <h2 class="pp-card-title mb-2">Dodaj koszt</h2>
            <div class="row g-2">
                <div class="col-md-2"><label class="form-label small mb-1">Data</label><input type="date" class="form-control form-control-sm" @bind="_exp.Date" /></div>
                <div class="col-md-2"><label class="form-label small mb-1">Kwota brutto</label><input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_exp.Amount" /></div>
                <div class="col-md-4"><label class="form-label small mb-1">Sprzedawca</label><input class="form-control form-control-sm" @bind="_exp.Vendor" maxlength="200" placeholder="np. Hetzner" /></div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">Kategoria</label>
                    <select class="form-select form-select-sm" @bind="_exp.Category">
                        @foreach (var c in AccountingService.ExpenseCategories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-6"><label class="form-label small mb-1">Opis</label><input class="form-control form-control-sm" @bind="_exp.Description" maxlength="500" placeholder="np. serwer za październik" /></div>
                <div class="col-md-3"><label class="form-label small mb-1">Nr faktury / paragonu</label><input class="form-control form-control-sm" @bind="_exp.DocumentNumber" maxlength="100" /></div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Dowód (PDF, zdjęcie)</label>
                    <InputFile class="form-control form-control-sm" OnChange="PickProof" accept=".pdf,.jpg,.jpeg,.png,.webp,.heic" />
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button class="btn btn-sm btn-primary" @onclick="AddExpense" disabled="@_busy"><i class="bi bi-plus-lg me-1"></i>Dodaj koszt</button>
                @if (_proofName is not null) { <span class="small text-muted"><i class="bi bi-paperclip"></i> @_proofName</span> }
            </div>
        </div>

        <div class="pp-card pp-card-flush">
            <div class="acc-filters">
                <select class="form-select form-select-sm" @bind="_expYear" @bind:after="LoadExpenses" aria-label="Rok">
                    @for (var y = Today.Year; y >= Today.Year - 5; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <span class="small text-muted">Razem: <b>@FinanceRules.Money(_expenses.Sum(e => e.Amount))</b></span>
                <a class="btn btn-sm btn-outline-secondary ms-auto" href="@ExportUrl("koszty.csv", new DateOnly(_expYear, 1, 1), new DateOnly(_expYear, 12, 31))" download><i class="bi bi-filetype-csv me-1"></i>CSV</a>
            </div>
            @if (_expenses.Count == 0)
            {
                <p class="text-muted small p-3 mb-0">Brak kosztów w tym roku.</p>
            }
            else
            {
                <div class="acc-cats">
                    @foreach (var g in _expenses.GroupBy(e => e.Category).OrderByDescending(g => g.Sum(e => e.Amount)))
                    {
                        <span class="pp-chip pp-tone-muted">@g.Key · @FinanceRules.Money(g.Sum(e => e.Amount))</span>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle small mb-0 acc-table">
                        <thead class="table-light"><tr><th>Data</th><th>Sprzedawca</th><th>Opis</th><th>Kategoria</th><th class="text-end">Kwota</th><th>Dowód</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in _expenses)
                            {
                                <tr>
                                    <td class="text-nowrap">@e.Date.ToString("dd.MM.yyyy")</td>
                                    <td>@e.Vendor</td>
                                    <td>@e.Description @if (e.DocumentNumber is not null) { <small class="text-muted">· @e.DocumentNumber</small> }</td>
                                    <td>@e.Category</td>
                                    <td class="text-end text-nowrap fw-semibold">@FinanceRules.Money(e.Amount)</td>
                                    <td>
                                        @if (e.AttachmentName is not null)
                                        {
                                            <a href="/api/panel/ksiegowosc/koszt/@e.Id/dowod" title="@e.AttachmentName"><i class="bi bi-paperclip"></i> pobierz</a>
                                        }
                                        else
                                        {
                                            <span class="pp-chip pp-tone-warn">brak</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (_deleteExpId == e.Id)
                                        {
                                            <span class="acc-inline">
                                                <input class="form-control form-control-sm" placeholder="powód" @bind="_deleteExpReason" aria-label="Powód usunięcia" />
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteExpense(e)">Usuń</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => { _deleteExpId = e.Id; _deleteExpReason = null; }">usuń</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (_tab == "eksport")
    {
        <div class="pp-card">
            <h2 class="pp-card-title mb-2">Paczka dla księgowej i kopia poza Hantly</h2>
            <p class="text-muted small">Jeden plik ZIP: ewidencja sprzedaży (CSV i PDF), rejestr dokumentów z PDF-ami, koszty z dowodami i podsumowanie. Pobieraj ją co miesiąc i odkładaj poza aplikacją — to Twoja kopia bezpieczeństwa.</p>
            <div class="acc-period">
                <button class="btn btn-sm @(_exportPreset == "prev" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => ExportPreset("prev")'>Poprzedni miesiąc</button>
                <button class="btn btn-sm @(_exportPreset == "month" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => ExportPreset("month")'>Ten miesiąc</button>
                <button class="btn btn-sm @(_exportPreset == "quarter" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => ExportPreset("quarter")'>Ten kwartał</button>
                <button class="btn btn-sm @(_exportPreset == "prevyear" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => ExportPreset("prevyear")'>Poprzedni rok</button>
                <button class="btn btn-sm @(_exportPreset == "year" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => ExportPreset("year")'>Ten rok</button>
                <input type="date" class="form-control form-control-sm acc-date" @bind="_eFrom" aria-label="Od" />
                <input type="date" class="form-control form-control-sm acc-date" @bind="_eTo" aria-label="Do" />
            </div>
            <div class="acc-exports">
                <a class="acc-export main" href="@ExportUrl("paczka.zip", _eFrom, _eTo)" download><i class="bi bi-file-earmark-zip"></i><b>Paczka ZIP</b><span>wszystko naraz</span></a>
                <a class="acc-export" href="@ExportUrl("ewidencja.pdf", _eFrom, _eTo)" target="_blank"><i class="bi bi-file-pdf"></i><b>Ewidencja PDF</b><span>do wydruku</span></a>
                <a class="acc-export" href="@ExportUrl("ewidencja.csv", _eFrom, _eTo)" download><i class="bi bi-filetype-csv"></i><b>Ewidencja CSV</b><span>Excel</span></a>
                <a class="acc-export" href="@ExportUrl("dokumenty.csv", _eFrom, _eTo)" download><i class="bi bi-receipt"></i><b>Rejestr dokumentów</b><span>CSV</span></a>
                <a class="acc-export" href="@ExportUrl("koszty.csv", _eFrom, _eTo)" download><i class="bi bi-bag"></i><b>Koszty</b><span>CSV</span></a>
            </div>
            <p class="acc-fine mt-3 mb-0">Ostatnia paczka: @(_o.LastExport is { } le ? TimeZoneInfo.ConvertTimeFromUtc(le, AccountingService.Tz).ToString("dd.MM.yyyy HH:mm") : "jeszcze nie pobrana"). Dane księgowe są też w nocnej kopii bazy Portalu.</p>
        </div>
    }

    @if (_tab == "historia")
    {
        <div class="pp-card pp-card-flush">
            <div class="pp-card-head"><h2 class="pp-card-title">Historia zmian</h2><span class="text-muted small">Tylko dopisywana — nikt jej nie edytuje.</span></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle small mb-0 acc-table">
                    <thead class="table-light"><tr><th>Kiedy</th><th>Kto</th><th>Co</th><th>Szczegóły</th></tr></thead>
                    <tbody>
                        @foreach (var e in _history)
                        {
                            <tr>
                                <td class="text-nowrap">@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(e.At, DateTimeKind.Utc), AccountingService.Tz).ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-nowrap">@e.Actor</td>
                                <td class="text-nowrap">@AccountingService.ActionLabel(e.Action)</td>
                                <td>@e.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_tab == "ustawienia" && _form is not null)
    {
        @if (_s.Mode == FinanceModes.Unregistered)
        {
            <div class="pp-card acc-switch">
                <div class="pp-card-head">
                    <span class="pp-icon pp-icon-sm pp-tone-ok"><i class="bi bi-building-add"></i></span>
                    <h2 class="pp-card-title">Firma założona? Przełącz księgowość</h2>
                    <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => _switchOpen = !_switchOpen">@(_switchOpen ? "Zwiń" : "Przełącz na firmę")</button>
                </div>
                <p class="small text-muted mb-0">Od daty rozpoczęcia z CEIDG dokumenty wystawia firma (z NIP-em). Ewidencja, numeracja i wszystkie dotychczasowe dokumenty zostają — nic nie znika i nic się nie przepisuje.</p>
                @if (_switchOpen)
                {
                    <ol class="acc-steps">
                        <li>Wniosek CEIDG (biznes.gov.pl) — po przekroczeniu limitu w ciągu 7 dni od dnia przekroczenia.</li>
                        <li>Forma opodatkowania i ZUS — wybierasz we wniosku albo później w terminach z przepisów.</li>
                        <li>VAT: zostajesz przy zwolnieniu albo składasz VAT-R przed pierwszą sprzedażą z VAT.</li>
                        <li>Tutaj: data z CEIDG i dane firmy — od tej daty nowe dokumenty mają NIP.</li>
                    </ol>
                    <div class="row g-2">
                        <div class="col-md-3"><label class="form-label small mb-1">Data rozpoczęcia (CEIDG)</label><input type="date" class="form-control form-control-sm" @bind="_swSince" /></div>
                        <div class="col-md-5"><label class="form-label small mb-1">Nazwa firmy</label><input class="form-control form-control-sm" @bind="_swName" maxlength="300" /></div>
                        <div class="col-md-2"><label class="form-label small mb-1">NIP</label><input class="form-control form-control-sm" @bind="_swNip" maxlength="20" /></div>
                        <div class="col-md-2"><label class="form-label small mb-1">REGON</label><input class="form-control form-control-sm" @bind="_swRegon" maxlength="20" /></div>
                        <div class="col-md-6"><label class="form-label small mb-1">Adres firmy</label><textarea class="form-control form-control-sm" rows="2" @bind="_swAddress"></textarea></div>
                        <div class="col-md-3"><label class="form-label small mb-1">Konto bankowe</label><input class="form-control form-control-sm" @bind="_swBank" maxlength="40" /></div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1">VAT</label>
                            <select class="form-select form-select-sm" @bind="_swVat"><option value="zw">zwolnienie (bez VAT)</option><option value="vat">czynny podatnik VAT</option></select>
                        </div>
                    </div>
                    <label class="form-check small mt-2"><input class="form-check-input" type="checkbox" @bind="_swConfirm" /> <span class="form-check-label">Dane są zgodne z wpisem w CEIDG. Dokumenty od tej daty będą wystawiane jako firma.</span></label>
                    <button class="btn btn-sm btn-success mt-2" @onclick="SwitchToBusiness" disabled="@(!_swConfirm || _busy)"><i class="bi bi-building-check me-1"></i>Przełącz na firmę</button>
                }
            </div>
        }

        <div class="pp-card acc-form">
            <h2 class="pp-card-title mb-3">Forma działalności i ewidencja</h2>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small mb-1">Forma</label>
                    <select class="form-select form-select-sm" @bind="_fMode">
                        <option value="">— wybierz —</option>
                        <option value="@FinanceModes.Unregistered">Działalność nierejestrowana</option>
                        <option value="@FinanceModes.Business">Firma (CEIDG)</option>
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label small mb-1">Działalność nierejestrowana od</label><input type="date" class="form-control form-control-sm" @bind="_fUnregSince" /></div>
                <div class="col-md-4"><label class="form-label small mb-1">Ewidencja wpłat od</label><input type="date" class="form-control form-control-sm" @bind="_fStart" /></div>
                @if (_fMode == FinanceModes.Business)
                {
                    <div class="col-md-4"><label class="form-label small mb-1">Firma od (CEIDG)</label><input type="date" class="form-control form-control-sm" @bind="_fBizSince" /></div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">VAT</label>
                        <select class="form-select form-select-sm" @bind="_fVat"><option value="zw">zwolnienie (bez VAT)</option><option value="vat">czynny podatnik VAT (23%)</option></select>
                    </div>
                }
            </div>
            <p class="acc-fine mt-2 mb-0">„Ewidencja wpłat od” — wpłaty sprzed tej daty nie trafią do ewidencji ani nie dostaną dokumentów. Ustaw ją na dzień, od którego chcesz prowadzić porządek (np. początek kwartału).</p>

            <h3 class="acc-h3">Dane sprzedawcy (na dokumentach)</h3>
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label small mb-1">@(_fMode == FinanceModes.Business ? "Nazwa firmy" : "Imię i nazwisko")</label><input class="form-control form-control-sm" @bind="_form.SellerName" maxlength="300" /></div>
                <div class="col-md-6"><label class="form-label small mb-1">E-mail na dokumentach</label><input class="form-control form-control-sm" @bind="_form.SellerEmail" maxlength="256" /></div>
                <div class="col-md-6"><label class="form-label small mb-1">Adres</label><textarea class="form-control form-control-sm" rows="2" @bind="_form.SellerAddress" placeholder="ul. Przykładowa 1&#10;00-001 Miasto"></textarea></div>
                <div class="col-md-6">
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label small mb-1">NIP @(_fMode == FinanceModes.Business ? "" : "(firma)")</label><input class="form-control form-control-sm" @bind="_form.SellerTaxId" maxlength="20" disabled="@(_fMode != FinanceModes.Business)" /></div>
                        <div class="col-6"><label class="form-label small mb-1">REGON</label><input class="form-control form-control-sm" @bind="_form.SellerRegon" maxlength="20" disabled="@(_fMode != FinanceModes.Business)" /></div>
                        <div class="col-12"><label class="form-label small mb-1">Konto bankowe (opcjonalnie)</label><input class="form-control form-control-sm" @bind="_form.SellerBank" maxlength="40" /></div>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Adnotacja o zwolnieniu z VAT (puste — tekst domyślny)</label>
                    <input class="form-control form-control-sm" @bind="_form.VatNote" maxlength="300" placeholder="@VatNotePlaceholder" />
                </div>
            </div>

            <h3 class="acc-h3">Dokumenty</h3>
            <div class="d-flex flex-wrap gap-3 small">
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_form.AutoIssue" /> <span class="form-check-label">Wystawiaj dokument sam po każdej wpłacie</span></label>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_form.EmailDocs" /> <span class="form-check-label">Wysyłaj PDF nabywcy e-mailem</span></label>
            </div>
            <p class="acc-fine">Osoba prywatna dostaje rachunek, trener z NIP-em — fakturę (bez VAT, a przy czynnym VAT — fakturę VAT). Dane nabywcy trener uzupełnia w swoim panelu.</p>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small mb-1">Kto wystawia</label>
                    <select class="form-select form-select-sm" @bind="_form.Provider">
                        <option value="local">Hantly (numeracja i PDF tutaj)</option>
                        <option value="fakturownia">Fakturownia.pl</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label small mb-1">Numeracja (przedrostki)</label>
                    <div class="acc-inline">
                        <input class="form-control form-control-sm acc-prefix" @bind="_form.PrefixReceipt" maxlength="12" aria-label="Przedrostek rachunków" />
                        <input class="form-control form-control-sm acc-prefix" @bind="_form.PrefixInvoice" maxlength="12" aria-label="Przedrostek faktur" />
                        <input class="form-control form-control-sm acc-prefix" @bind="_form.PrefixCorrection" maxlength="12" aria-label="Przedrostek korekt" />
                        <span class="small text-muted">np. @FinanceRules.FormatNumber(_form.PrefixReceipt, Today.Year, 7), @FinanceRules.FormatNumber(_form.PrefixInvoice, Today.Year, 7)</span>
                    </div>
                </div>
            </div>
            @if (_form.Provider == "fakturownia")
            {
                <div class="acc-fakt">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4"><label class="form-label small mb-1">Subdomena konta</label>
                            <div class="input-group input-group-sm"><input class="form-control" @bind="_form.FakturowniaDomain" placeholder="mojafirma" /><span class="input-group-text">.fakturownia.pl</span></div></div>
                        <div class="col-md-5"><label class="form-label small mb-1">Token API @(_s.HasFakturowniaToken ? "(zapisany — wpisz nowy, żeby zmienić)" : "")</label>
                            <input class="form-control form-control-sm" type="password" autocomplete="off" @bind="_token" placeholder="@(_s.HasFakturowniaToken ? "••••••••" : "Ustawienia → Ustawienia konta → Integracja")" /></div>
                        <div class="col-md-3 d-flex gap-1">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="TestFakturownia" disabled="@_busy">Sprawdź połączenie</button>
                            @if (_s.HasFakturowniaToken)
                            {
                                <button class="btn btn-sm btn-link text-danger" @onclick="RemoveToken">Usuń token</button>
                            }
                        </div>
                    </div>
                    @if (_testMsg is not null) { <p class="small mt-2 mb-0 @(_testOk ? "text-success" : "text-danger")">@_testMsg</p> }
                    <p class="acc-fine mt-2 mb-0">Fakturownia nadaje numer i trzyma oryginał (z jej ustawieniami sprzedawcy, a po założeniu firmy — także wysyłką do KSeF, jeśli ją tam włączysz). Gdy nie odpowiada, dokument czeka i ponawiamy próby; w razie potrzeby wystawisz go z numerem Hantly. Token jest zaszyfrowany.</p>
                </div>
            }

            <h3 class="acc-h3">Limity i rezerwa</h3>
            <div class="row g-2">
                <div class="col-md-4"><label class="form-label small mb-1">Limit kwartalny (nierejestrowana)</label>
                    <input class="form-control form-control-sm" @bind="_fQuarterLimit" placeholder="@($"domyślnie {FinanceRules.Money(FinanceRules.QuarterLimit(Today.Year, FinanceRules.QuarterOf(Today)).Limit)}")" /></div>
                <div class="col-md-4"><label class="form-label small mb-1">Limit zwolnienia z VAT (rok)</label>
                    <input class="form-control form-control-sm" @bind="_fVatLimit" placeholder="@($"domyślnie {FinanceRules.Money(FinanceRules.DefaultVatLimit(Today.Year))}")" /></div>
                <div class="col-md-4"><label class="form-label small mb-1">Rezerwa na podatek (% dochodu)</label>
                    <input class="form-control form-control-sm" @bind="_fReserve" /></div>
            </div>
            <p class="acc-fine mt-2">Kwoty domyślne wynikają z przepisów znanych w chwili wydania Hantly. Gdy się zmienią, wpisz nowe — to nadpisze domyślne.</p>

            <button class="btn btn-primary btn-sm" @onclick="SaveSettings" disabled="@_busy"><i class="bi bi-check2 me-1"></i>Zapisz ustawienia</button>
        </div>
        <p class="acc-fine">Hantly pilnuje porządku: ewidencji, numeracji, limitów i kopii. Interpretację przepisów (limit, VAT, PIT, ZUS, KSeF) zawsze potwierdź z księgową lub doradcą podatkowym.</p>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
