    private string VatNotePlaceholder => FinanceRules.DefaultVatNote(string.IsNullOrEmpty(_fMode) ? FinanceModes.Unregistered : _fMode, SalesDocumentKinds.Receipt);

    /// <summary>Pola formularza ustawień (rekord ustawień jest niezmienny).</summary>
    private sealed class SettingsForm
