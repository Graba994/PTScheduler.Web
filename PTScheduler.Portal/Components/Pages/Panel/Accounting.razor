        public bool EmailDocs { get; set; }
        public string Provider { get; set; } = "local";
        public string FakturowniaDomain { get; set; } = "";
        public string PrefixReceipt { get; set; } = "";
        public string PrefixInvoice { get; set; } = "";
        public string PrefixCorrection { get; set; } = "";
    }

    private static Expense NewExpense() => new() { Date = Today, Category = "serwer" };

    protected override async Task OnInitializedAsync()
    {
        _actor = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin";
        ExportPreset("prev");
        await ReloadAsync();
        var start = Tabs.Any(t => t.Key == TabQuery) ? TabQuery! : _s?.Configured == false ? "przeglad" : "przeglad";
        if (!string.IsNullOrWhiteSpace(Query)) { _fQuery = Query; _fYear = 0; }
        await SelectTab(start);
    }

    private async Task ReloadAsync()
    {
        _s = await Acc.GetSettingsAsync();
        _o = await Acc.OverviewAsync();
    }

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        switch (tab)
        {
            case "dokumenty": await LoadDocs(); break;
            case "ewidencja": await LoadLedger(); break;
            case "koszty": await LoadExpenses(); break;
            case "historia": _history = await Acc.HistoryAsync(); break;
            case "ustawienia": FillForm(); break;
        }
