    // ── Dokumenty ──

    private async Task LoadDocs()
    {
        _docs = await Acc.DocumentsAsync(new AccountingService.DocumentFilter(_fYear == 0 ? null : _fYear, _fMonth == 0 ? null : _fMonth,
            string.IsNullOrEmpty(_fKind) ? null : _fKind, _fQuery, _fProblems));
