@page "/panel/system"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject DockerService DockerSvc
@inject TenantService TenantSvc
@rendermode InteractiveServer

<PageTitle>System — PTScheduler Portal</PageTitle>

<PanelHeader Title="Serwer" Icon="bi-cpu" Subtitle="Zasoby maszyny, na której działają Portal i instancje trenerów, oraz stan kontenerów Dockera." />

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    var allUp = _statuses.Count > 0 && _statuses.All(x => x.IsHealthy);
    var downCount = _statuses.Count(x => !x.IsHealthy);
    @if (_sys is null)
    {
        <StatusBanner Tone="danger" Icon="bi-plug" Title="Brak połączenia z Dockerem">Portal nie widzi Dockera, więc nie pokaże kontenerów ani zasobów. Sprawdź, czy gniazdo Dockera jest zamontowane w kontenerze Portalu.</StatusBanner>
    }
    else if (downCount > 0)
    {
        <StatusBanner Tone="danger" Icon="bi-exclamation-octagon-fill" Title="@($"{downCount} {PanelUi.Plural(downCount, "trener ma", "trenerów ma", "trenerów ma")} zatrzymane kontenery")">Sprawdź tabelę poniżej i uruchom je ponownie z karty trenera.</StatusBanner>
    }
    else if (allUp)
    {
        <StatusBanner Tone="ok" Icon="bi-check-circle-fill" Title="Wszystkie kontenery działają">Kontenery aplikacji i baz danych wszystkich trenerów są uruchomione.</StatusBanner>
    }

    <div class="pp-stats">
        <StatTile Label="Procesor" Value="@(_sys is null ? "—" : $"{_sys.CpuCount} rdzeni")" Icon="bi-cpu" Tone="info" />
        <StatTile Label="Pamięć" Value="@(_sys is null ? "—" : $"{_sys.TotalMemoryMB / 1024} GB")" Icon="bi-memory" Tone="info" />
        <StatTile Label="Kontenery" Value="@(_sys is null ? "—" : $"{_sys.RunningContainers} / {_sys.TotalContainers}")" Meta="działające / wszystkie" Icon="bi-boxes" Tone="@(downCount > 0 ? "danger" : "ok")" />
        <StatTile Label="Docker" Value="@(_sys?.DockerVersion ?? "—")" Icon="bi-box-seam" Tone="muted" />
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="pp-card-title pp-card-title-icon"><span class="pp-icon pp-icon-sm pp-tone-muted"><i class="bi bi-box"></i></span>Kontenery trenerów</h2>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>

                    @if (_statuses.Count == 0)
                    {
                        <p class="text-muted small">Brak aktywnych trenerów.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Slug</th>
                                        <th>Web</th>
                                        <th>DB</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in _statuses)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-semibold">@s.Slug</td>
                                            <td>
                                                <span class="pp-chip pp-tone-@(s.Web?.Running == true ? "ok" : "danger")">@(s.Web?.Running == true ? "działa" : "zatrzymany")</span>
                                                @if (s.Web is not null)
                                                {
                                                    <span class="text-muted ms-1">@s.Web.Id</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="pp-chip pp-tone-@(s.Db?.Running == true ? "ok" : "danger")">@(s.Db?.Running == true ? "działa" : "zatrzymany")</span>
                                                @if (s.Db is not null)
                                                {
                                                    <span class="text-muted ms-1">@s.Db.Id</span>
                                                }
                                            </td>
                                            <td>
                                                @if (s.IsHealthy)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="pp-card-title pp-card-title-icon mb-3"><span class="pp-icon pp-icon-sm pp-tone-muted"><i class="bi bi-bar-chart"></i></span>Ilu trenerów zmieścisz</h2>
                    @if (_sys is not null)
                    {
                        var maxTenants = (int)(_sys.TotalMemoryMB / 150);
                        var activeTenants = _statuses.Count(s => s.IsHealthy);
                        var pct = maxTenants > 0 ? (activeTenants * 100 / maxTenants) : 0;

                        <div class="d-flex justify-content-between small mb-1">
                            <span>@activeTenants aktywnych</span>
                            <span>max ~@maxTenants</span>
                        </div>
                        <div class="progress mb-3" style="height:12px">
                            <div class="progress-bar @(pct > 80 ? "bg-danger" : pct > 60 ? "bg-warning" : "bg-primary")"
                                 style="width:@pct%">@pct%</div>
                        </div>

                        <div class="small text-muted">
                            <p>Szacunek: ~150 MB / trener (app + DB).</p>
                            <p class="mb-0">Przy upgrade do 4C/8GB: ~@((int)(8192 / 150)) trenerów.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private SystemInfo? _sys;
    private List<TenantContainerStatus> _statuses = [];

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        _loading = true;
        try { _sys = await DockerSvc.GetSystemInfoAsync(); } catch { }

        var tenants = await TenantSvc.GetAllAsync();
        try
        {
            _statuses = await DockerSvc.GetAllTenantsStatusAsync(
                tenants.Where(t => t.Status == TenantStatus.Active)
                    .Select(t => (t.Slug, t.WebContainerName, t.DbContainerName)));
        }
        catch { }

        _loading = false;
    }
}
