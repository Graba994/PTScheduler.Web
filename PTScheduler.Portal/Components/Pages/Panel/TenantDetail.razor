    private static string EventBadge(string type) => type switch
    {
        TenantEventTypes.Created or TenantEventTypes.Provisioned or TenantEventTypes.Resumed => "bg-success",
        TenantEventTypes.PaymentReceived or TenantEventTypes.HealthRecovered => "bg-success",
        TenantEventTypes.Suspended or TenantEventTypes.Deleted => "bg-danger",
        TenantEventTypes.PaymentFailed or TenantEventTypes.TrialExpired or TenantEventTypes.HealthDown => "bg-danger",
        TenantEventTypes.TrialWarning or TenantEventTypes.InactivityWarning or TenantEventTypes.CleanupWarning => "bg-warning text-dark",
        TenantEventTypes.InactivitySuspended or TenantEventTypes.CleanupDeleted => "bg-danger",
        TenantEventTypes.GraceExtended => "bg-info",
        TenantEventTypes.PlanChanged or TenantEventTypes.DomainChanged or TenantEventTypes.TrialStarted => "bg-info",
        _ => "bg-secondary"
    };

    private static string PaymentRecordBadge(PaymentRecordStatus s) => s switch
    {
        PaymentRecordStatus.Paid => "bg-success",
        PaymentRecordStatus.Failed => "bg-danger",
        PaymentRecordStatus.Refunded => "bg-warning text-dark",
        PaymentRecordStatus.Pending => "bg-secondary",
        _ => "bg-secondary"
    };

    private record AdminInfo
    {
        public bool Found { get; init; }
        public string? Email { get; init; }
        public string? FirstName { get; init; }
        public string? LastName { get; init; }
        public bool EmailConfirmed { get; init; }
        public string? LockoutEnd { get; init; }
    }
