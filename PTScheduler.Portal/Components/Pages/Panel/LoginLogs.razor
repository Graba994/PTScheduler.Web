@page "/panel/login-logs"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<PortalDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Logi logowań — PTScheduler Portal</PageTitle>

<PanelHeader Title="Logi logowań" Icon="bi-journal-text" IconClass="pp-icon-cyan" BackHref="/panel/setup" BackLabel="Konfiguracja platformy" Subtitle="Kto i kiedy logował się do Portalu. Nieudane próby z jednego adresu mogą oznaczać zgadywanie hasła.">
    <Actions>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Load"><i class="bi bi-arrow-clockwise me-1"></i>Odśwież</button>
    </Actions>
</PanelHeader>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="pp-stats">
        <StatTile Label="Udane logowania" Value="@_successCount.ToString()" Icon="bi-check-circle" Tone="ok" />
        <StatTile Label="Nieudane próby" Value="@_failCount.ToString()" Icon="bi-x-circle" Tone="@(_failCount > 0 ? "danger" : "muted")" />
        <StatTile Label="Blokady konta" Value="@_lockoutCount.ToString()" Meta="po kilku nieudanych próbach z rzędu" Icon="bi-lock" Tone="@(_lockoutCount > 0 ? "warn" : "muted")" />
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Email</th>
                        <th>Wynik</th>
                        <th>IP</th>
                        <th>Przeglądarka</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr class="@(!log.Success ? "table-danger" : "")">
                            <td class="text-nowrap">@log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td class="font-monospace">@log.Email</td>
                            <td>
                                @if (log.Success)
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                                else if (log.FailureReason == "locked_out")
                                {
                                    <span class="badge bg-warning text-dark">Zablokowany</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Błąd</span>
                                }
                            </td>
                            <td class="font-monospace text-muted">@(log.IpAddress ?? "—")</td>
                            <td class="text-muted" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @(ShortenUA(log.UserAgent))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_logs.Count == 0)
        {
            <p class="text-muted text-center py-3">Brak logów.</p>
        }
    </div>
}

@code {
    private List<LoginLog> _logs = [];
    private bool _loading = true;
    private int _successCount;
    private int _failCount;
    private int _lockoutCount;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        await using var db = DbFactory.CreateDbContext();
        _logs = await db.LoginLogs
            .AsNoTracking()
            .OrderByDescending(l => l.CreatedAt)
            .Take(200)
            .ToListAsync();

        _successCount = _logs.Count(l => l.Success);
        _failCount = _logs.Count(l => !l.Success && l.FailureReason != "locked_out");
        _lockoutCount = _logs.Count(l => l.FailureReason == "locked_out");
        _loading = false;
    }

    private static string ShortenUA(string? ua)
    {
        if (string.IsNullOrEmpty(ua)) return "—";
        if (ua.Contains("Firefox")) return "Firefox";
        if (ua.Contains("Edg/")) return "Edge";
        if (ua.Contains("Chrome")) return "Chrome";
        if (ua.Contains("Safari")) return "Safari";
        return ua.Length > 50 ? ua[..47] + "..." : ua;
    }
}
