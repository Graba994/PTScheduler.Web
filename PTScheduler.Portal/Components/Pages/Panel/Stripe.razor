@page "/panel/stripe"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject SiteSettingsService Settings
@inject StripeService StripeSvc
@inject IDbContextFactory<PortalDbContext> DbFactory
@inject IConfiguration Config
@rendermode InteractiveServer

<PageTitle>Stripe — Hantly Portal</PageTitle>

<PanelHeader Title="Stripe" Icon="bi-stripe" BackHref="/panel/setup" BackLabel="Konfiguracja platformy" Subtitle="Płatności kartą za abonamenty trenerów: klucze API i webhook, który odnawia subskrypcje. Produkty i ceny Portal zakłada w Stripe sam." />

@if (string.IsNullOrWhiteSpace(_form.SecretKey))
{
    <StatusBanner Tone="warn" Icon="bi-credit-card" Title="Płatności kartą są wyłączone">Trenerzy nie opłacą abonamentu online. Wklej klucze ze Stripe Dashboard → Developers → API keys.</StatusBanner>
}
else
{
    var live = _form.SecretKey.StartsWith("sk_live");
    <StatusBanner Tone="@(live ? "ok" : "info")" Icon="@(live ? "bi-check-circle-fill" : "bi-cone-striped")" Title="@(live ? "Stripe działa na prawdziwych płatnościach" : "Stripe w trybie testowym")">
        @(live ? "Klucze produkcyjne — trenerzy płacą prawdziwymi kartami." : "Klucze testowe (sk_test_…) — płatności nie pobierają pieniędzy. Przed startem podmień je na produkcyjne.")
        @if (string.IsNullOrWhiteSpace(_form.WebhookSecret)) { <div class="mt-1 fw-semibold">Brakuje sekretu webhooka — bez niego odnowienia subskrypcji nie dotrą do Portalu.</div> }
    </StatusBanner>
}

@if (_saved)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-1"></i>Zapisano.
        <button type="button" class="btn-close" @onclick="() => _saved = false"></button>
    </div>
}

<EditForm Model="_form" OnValidSubmit="Save" FormName="stripe-config">
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header pp-card-header"><span class="pp-icon pp-icon-sm"><i class="bi bi-key"></i></span>API Keys</div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label small fw-semibold">Secret Key</label>
                <input type="password" class="form-control font-monospace" @bind="_form.SecretKey" placeholder="sk_test_... lub sk_live_..." />
                <div class="form-text">Znajdziesz w Stripe Dashboard → Developers → API keys</div>
            </div>
            <div class="mb-0">
                <label class="form-label small fw-semibold">Publishable Key</label>
                <input class="form-control font-monospace" @bind="_form.PublishableKey" placeholder="pk_test_... lub pk_live_..." />
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header pp-card-header"><span class="pp-icon pp-icon-sm"><i class="bi bi-broadcast"></i></span>Webhook</div>
        <div class="card-body">
            <p class="small text-muted mb-2">Przez webhook Stripe zgłasza Portalowi opłacone abonamenty, odnowienia, nieudane płatności i anulowania. Jeden endpoint obsługuje też płatności kartą w sklepie i za rachunki.</p>
            <ol class="small mb-3 ps-3">
                <li class="mb-1">Stripe Dashboard → <b>Developers → Webhooks</b> → <b>Add destination</b> (na starszych kontach: <b>Add endpoint</b>).</li>
                <li class="mb-1">Zakres: <b>Your account</b>, payload: <b>Snapshot</b>, API version: <code style="user-select:all">@(global::Stripe.StripeConfiguration.ApiVersion)</code> — inna wersja niż ta, z którą działa Portal, kończy się odrzuceniem eventów.</li>
                <li class="mb-1">Eventy (<b>Selected events</b>, wpisz w wyszukiwarkę):
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var ev in Events)
                        {
                            <code class="px-2 py-1 rounded" style="user-select:all;background:var(--bs-tertiary-bg)">@ev</code>
                        }
                    </div>
                </li>
                <li class="mb-1">Typ: <b>Webhook endpoint</b>, adres: <code style="user-select:all">@_webhookUrl</code></li>
                <li>Po zapisaniu kliknij <b>Signing secret → Reveal</b> i wklej go poniżej (zaczyna się od <code>whsec_</code>).</li>
            </ol>
            <div class="mb-0">
                <label class="form-label small fw-semibold">Webhook Signing Secret</label>
                <input type="password" class="form-control font-monospace" @bind="_form.WebhookSecret" placeholder="whsec_..." />
                <div class="form-text">Tryb testowy i produkcyjny mają osobne endpointy i osobne sekrety — po przejściu na klucze live załóż endpoint jeszcze raz.</div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary" disabled="@_saving">
        @if (_saving)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        <i class="bi bi-floppy me-1"></i>Zapisz
    </button>
</EditForm>

<div class="card border-0 shadow-sm mt-3">
    <div class="card-header pp-card-header"><span class="pp-icon pp-icon-sm"><i class="bi bi-tags"></i></span>Plany w Stripe</div>
    <div class="card-body">
        <p class="small text-muted mb-2">Nic nie kopiujesz: Portal sam zakłada w Stripe produkt i ceny (miesięczną i roczną) przy zapisie planu w <a href="/panel/plans">Planach cenowych</a> i przy pierwszej płatności. Po zmianie kwoty powstaje nowa cena.</p>
        @if (_plans.Count == 0)
        {
            <p class="small mb-0">Brak aktywnych płatnych planów.</p>
        }
        else
        {
            <ul class="list-unstyled small mb-3">
                @foreach (var p in _plans)
                {
                    var ready = !string.IsNullOrWhiteSpace(p.StripeMonthlyPriceId) && (p.YearlyPrice is not > 0 || !string.IsNullOrWhiteSpace(p.StripeYearlyPriceId));
                    <li class="d-flex align-items-center gap-2 py-1">
                        <i class="bi @(ready ? "bi-check-circle-fill text-success" : "bi-circle text-muted")"></i>
                        <span class="fw-semibold">@p.Name</span>
                        <span class="text-muted">@p.MonthlyPrice.ToString("0.##") zł/mies.@(p.YearlyPrice is > 0 ? $" · {p.YearlyPrice.Value:0.##} zł/rok" : "")</span>
                        <span class="ms-auto text-muted">@(ready ? "ceny w Stripe" : "jeszcze nie założone")</span>
                    </li>
                }
            </ul>
            <button class="btn btn-sm btn-outline-primary" @onclick="SyncPlansAsync" disabled="@(_syncing || string.IsNullOrWhiteSpace(_form.SecretKey))">
                @if (_syncing)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="bi bi-arrow-repeat me-1"></i>Załóż i sprawdź ceny teraz
            </button>
            @if (_syncMessage is not null)
            {
                <div class="small mt-2 @(_syncError ? "text-danger" : "text-success")">@_syncMessage</div>
            }
        }
    </div>
</div>

<div class="card border-0 shadow-sm mt-3">
    <div class="card-header pp-card-header"><span class="pp-icon pp-icon-sm"><i class="bi bi-list-check"></i></span>Test i przejście na produkcję</div>
    <div class="card-body small">
        <ol class="mb-0 ps-3">
            <li class="mb-1">W Stripe przy endpoincie kliknij <b>Send test event</b> — w historii endpointu powinna pojawić się odpowiedź 200.</li>
            <li class="mb-1">Załóż testowe konto trenera w kreatorze i podepnij kartę <code>4242 4242 4242 4242</code> (dowolna przyszła data i CVC).</li>
            <li>Przed startem: podmień klucze na <code>sk_live_…</code> i <code>pk_live_…</code>, załóż webhook w trybie live i wklej jego nowy sekret, potem kliknij <b>Załóż i sprawdź ceny teraz</b> — ceny z sandboxa nie działają na koncie produkcyjnym.</li>
        </ol>
    </div>
</div>

@code {
    private static readonly string[] Events =
    [
        "checkout.session.completed",
        "customer.subscription.created",
        "customer.subscription.updated",
        "customer.subscription.deleted",
        "invoice.payment_succeeded",
        "invoice.payment_failed",
    ];

    private StripeForm _form = new();
    private bool _saving, _saved, _syncing, _syncError;
    private string? _syncMessage;
    private string _webhookUrl = "";
    private List<Plan> _plans = [];

    private class StripeForm
    {
        public string SecretKey { get; set; } = "";
        public string PublishableKey { get; set; } = "";
        public string WebhookSecret { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        _webhookUrl = PortalUrls.Public(Config) + "/api/webhooks/stripe";
        var s = await Settings.GetAllAsync(
            SiteSettingsService.Keys.StripeSecretKey,
            SiteSettingsService.Keys.StripePublishableKey,
            SiteSettingsService.Keys.StripeWebhookSecret);

        _form.SecretKey = s[SiteSettingsService.Keys.StripeSecretKey];
        _form.PublishableKey = s[SiteSettingsService.Keys.StripePublishableKey];
        _form.WebhookSecret = s[SiteSettingsService.Keys.StripeWebhookSecret];
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        _plans = await db.Plans.AsNoTracking().Where(p => p.IsActive && p.MonthlyPrice > 0).OrderBy(p => p.SortOrder).ToListAsync();
    }

    private async Task Save()
    {
        _saving = true; _saved = false;
        await Settings.SetManyAsync(new Dictionary<string, string>
        {
            [SiteSettingsService.Keys.StripeSecretKey] = _form.SecretKey.Trim(),
            [SiteSettingsService.Keys.StripePublishableKey] = _form.PublishableKey.Trim(),
            [SiteSettingsService.Keys.StripeWebhookSecret] = _form.WebhookSecret.Trim()
        });
        _saving = false; _saved = true;
    }

    private async Task SyncPlansAsync()
    {
        _syncing = true; _syncMessage = null;
        try
        {
            var errors = new List<string>();
            foreach (var p in _plans)
            {
                var (ok, error) = await StripeSvc.EnsurePricesAsync(p.Id);
                if (!ok) errors.Add($"{p.Name}: {error}");
            }
            _syncError = errors.Count > 0;
            _syncMessage = _syncError ? string.Join(" · ", errors) : "Ceny wszystkich planów są w Stripe.";
            await LoadPlansAsync();
        }
        finally { _syncing = false; }
    }
}
