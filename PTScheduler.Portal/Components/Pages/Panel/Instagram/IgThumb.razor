@* Miniatura posta: pierwsza grafika albo ikona rodzaju (film, pusty post). *@
@if (IgUi.Thumb(Post) is { } src)
{
    <span class="ig-thumb @Class"><img src="@src" alt="" loading="lazy" />@if (Post.Assets.Count > 1) { <i class="bi bi-collection ig-thumb-badge"></i> }</span>
}
else
{
    <span class="ig-thumb ig-thumb-empty @Class"><i class="bi @InstagramRules.KindIcon(Post.Kind)"></i></span>
}

@code {
    [Parameter, EditorRequired] public InstagramPost Post { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
}
