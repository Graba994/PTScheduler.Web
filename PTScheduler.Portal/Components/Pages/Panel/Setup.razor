@page "/panel/setup"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject SiteSettingsService Settings
@inject IConfiguration Config
@inject IDbContextFactory<PortalDbContext> DbFactory
@inject LegalService Legal
@inject AccountingService Accounting
@rendermode InteractiveServer

<PageTitle>Konfiguracja platformy — Hantly Portal</PageTitle>

<PanelHeader Title="Konfiguracja platformy" Icon="bi-gear" Subtitle="Ustawienia wspólne dla wszystkich trenerów — robisz je raz, przy instalacji. Trenerzy niczego z tej listy nie konfigurują." />

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    var missing = _groups.SelectMany(g => g.Items).Where(i => !i.Optional && !i.Done).ToList();
    @if (missing.Count == 0)
    {
        <StatusBanner Tone="ok" Icon="bi-check-circle-fill" Title="Platforma jest skonfigurowana">
            Wszystkie wymagane ustawienia są gotowe (@_done z @_total). Opcjonalne pozycje możesz dodać w dowolnym momencie.
        </StatusBanner>
    }
    else
    {
        <StatusBanner Tone="warn" Icon="bi-list-check" Title="@($"Zostało {missing.Count} z {_total} kroków")">
            <div class="pp-meter pp-tone-ok my-2" style="max-width:360px"><div style="width:@(_total == 0 ? 0 : _done * 100 / _total)%"></div></div>
            Do zrobienia: @string.Join(", ", missing.Select(m => m.Title)).
        </StatusBanner>
    }

    @foreach (var group in _groups)
    {
        <h2 class="pp-section-title">@group.Title</h2>
        <div class="pp-tiles">
            @foreach (var item in group.Items)
            {
                var tone = item.Done ? "ok" : item.Optional ? "muted" : "warn";
                <a href="@item.Href" class="pp-tile">
                    <span class="pp-icon"><i class="bi @item.Icon"></i></span>
                    <span class="flex-grow-1 min-w-0">
                        <span class="pp-tile-title d-block">@item.Title</span>
                        <span class="pp-tile-text d-block">@item.Description</span>
                        <span class="pp-chip pp-tone-@tone mt-2">
                            <i class="bi @(item.Done ? "bi-check-lg" : item.Optional ? "bi-dash" : "bi-exclamation")"></i>@(item.Done ? "gotowe" : item.Optional ? "opcjonalne" : "do zrobienia")
                        </span>
                    </span>
                </a>
            }
        </div>
    }
}


@code {
    private record Item(string Title, string Description, string Icon, string Href, bool Done, bool Optional = false);
    private record Group(string Title, List<Item> Items);

    private bool _loading = true;
    private List<Group> _groups = [];
    private int _done, _total;
    private bool _isolationOk;

    protected override async Task OnInitializedAsync()
    {
        var s = await Settings.GetAllAsync(
            SiteSettingsService.Keys.MainDomain, SiteSettingsService.Keys.NpmUrl, SiteSettingsService.Keys.NpmToken,
            SiteSettingsService.Keys.NpmEmail, SiteSettingsService.Keys.GithubToken, SiteSettingsService.Keys.GuardianUrl,
            SiteSettingsService.Keys.SmtpHost, SiteSettingsService.Keys.PlatformSmsApiToken,
            SiteSettingsService.Keys.PlatformBunnyLibraryId, SiteSettingsService.Keys.PlatformBunnyApiKey,
            SiteSettingsService.Keys.StripeSecretKey, SiteSettingsService.Keys.PayuPosId, SiteSettingsService.Keys.P24MerchantId, SiteSettingsService.Keys.AutopayServiceId,
            SiteSettingsService.Keys.BackupDir, SiteSettingsService.Keys.PlatformGoogleClientId,
            SiteSettingsService.Keys.AiEnabled, SiteSettingsService.Keys.AiApiKey, SiteSettingsService.Keys.GarminClientId, SiteSettingsService.Keys.GarminClientSecret,
            SiteSettingsService.Keys.RequireAdmin2fa, SiteSettingsService.Keys.BackupOffsiteTarget, SiteSettingsService.Keys.BackupVerify,
            SiteSettingsService.Keys.AdminNotificationEmail, SiteSettingsService.Keys.ErrorAlertEnabled, SiteSettingsService.Keys.ErrorAlertEmail);
        bool Has(string key) => !string.IsNullOrWhiteSpace(s.GetValueOrDefault(key));
        var legal = await Legal.CompanyAsync();
        var books = await Accounting.GetSettingsAsync();
        bool plans, services;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            _isolationOk = !await db.Tenants.AnyAsync(t => (t.InternalSecret == null || t.InternalSecret == "")
                && t.Status != TenantStatus.Destroyed && t.Status != TenantStatus.Pending);
            plans = await db.Plans.AnyAsync(p => p.IsActive);
            services = await db.ServiceItems.AnyAsync(i => i.IsActive);
        }

        _groups =
        [
            new("Serwer i domeny",
            [
                new("Domena główna", "Adres platformy i subdomeny trenerów.", "bi-globe", "/panel/domain", Has(SiteSettingsService.Keys.MainDomain)),
                new("Reverse proxy (NPM)", "Automatyczne wpisy i certyfikaty SSL dla nowych trenerów.", "bi-diagram-3", "/panel/npm",
                    Has(SiteSettingsService.Keys.NpmUrl) && (Has(SiteSettingsService.Keys.NpmToken) || Has(SiteSettingsService.Keys.NpmEmail))),
                new("GitHub", "Źródło aktualizacji aplikacji i Portalu.", "bi-github", "/panel/github", Has(SiteSettingsService.Keys.GithubToken)),
                new("Guardian (aktualizacje bez przestoju)", "Adres i sekret usługi aktualizacji.", "bi-shield-check", "/panel/updates", Has(SiteSettingsService.Keys.GuardianUrl)),
                new("Kopie zapasowe", "Katalog i harmonogram kopii baz trenerów.", "bi-hdd-stack", "/panel/backups", Has(SiteSettingsService.Keys.BackupDir), Optional: true),
                new("Kopia poza serwerem", "Zaszyfrowane kopie na SFTP albo Google Drive — awaria serwera nie zabiera danych.", "bi-cloud-arrow-up", "/panel/backups",
                    s.GetValueOrDefault(SiteSettingsService.Keys.BackupOffsiteTarget) is "sftp" or "gdrive"),
                new("Test odtworzenia kopii", "Co tydzień Portal odtwarza najnowsze kopie do tymczasowej bazy i sprawdza, czy działają.", "bi-arrow-counterclockwise", "/panel/backups",
                    s.GetValueOrDefault(SiteSettingsService.Keys.BackupVerify) != "off")
            ]),
            new("Usługi dla trenerów",
            [
                new("E-mail (SMTP)", "Poczta Portalu i wysyłka z aplikacji trenerów (nadawca = nazwa studia).", "bi-envelope-at", "/panel/email", Has(SiteSettingsService.Keys.SmtpHost)),
                new("SMS", "Konto SMSAPI platformy — trenerzy kupują pakiety SMS.", "bi-chat-dots", "/panel/setup/services#sms", Has(SiteSettingsService.Keys.PlatformSmsApiToken)),
                new("Wideo (Bunny)", "Jedna biblioteka — każdy trener ma w niej swoje foldery i limit z pakietu.", "bi-camera-video", "/panel/setup/services#video",
                    Has(SiteSettingsService.Keys.PlatformBunnyLibraryId) && Has(SiteSettingsService.Keys.PlatformBunnyApiKey)),
                new("Google Calendar i Meet", "Klient OAuth platformy — trener tylko klika „Połącz z Google”.", "bi-google", "/panel/setup/services#google",
                    Has(SiteSettingsService.Keys.PlatformGoogleClientId), Optional: true)
            ]),
            // Ustawiane raz i rzadko zmieniane — dlatego nie ma ich na pasku bocznym.
            new("Oferta i treści",
            [
                new("Plany cenowe", "Pakiety dla trenerów: ceny, limity, funkcje i okres próbny.", "bi-tags", "/panel/plans", plans),
                new("Katalog usług", "Usługi, dodatki i pakiety, które trenerzy kupują w Sklepie.", "bi-shop", "/panel/services", services),
                new("Dokumenty prawne", "Regulamin, polityka prywatności i umowa powierzenia z danymi usługodawcy.", "bi-file-earmark-text", "/panel/dokumenty",
                    legal.Complete),
                new("Asystent, Leo i AI", "Maskotka trenerów, agent Portalu, klucz AI i włączniki funkcji AI.", "bi-emoji-smile", "/panel/asystent",
                    s.GetValueOrDefault(SiteSettingsService.Keys.AiEnabled) == "true" && Has(SiteSettingsService.Keys.AiApiKey), Optional: true),
                new("Garmin (zegarki klientów)", "Sen, regeneracja i aktywności klientów w karcie klienta. Plan Starter Garmin Connect.", "bi-smartwatch", "/panel/garmin",
                    Has(SiteSettingsService.Keys.GarminClientId) && Has(SiteSettingsService.Keys.GarminClientSecret), Optional: true)
            ]),
            new("Płatności",
            [
                new("Abonamenty trenerów (Stripe)", "Płatności za plany cenowe.", "bi-credit-card-2-front", "/panel/stripe", Has(SiteSettingsService.Keys.StripeSecretKey)),
                new("Sklep usług (PayU / Przelewy24 / Autopay)", "Płatności trenerów za SMS-y, wideo i usługi.", "bi-wallet2", "/panel/payment-gateways",
                    Has(SiteSettingsService.Keys.PayuPosId) || Has(SiteSettingsService.Keys.P24MerchantId) || Has(SiteSettingsService.Keys.AutopayServiceId))
            ]),
            new("Księgowość",
            [
                new("Forma działalności i dane sprzedawcy", books.Configured
                        ? $"{AccountingService.ModeLabel(books.ModeOn(AccountingService.Today))} — ewidencja wpłat i dokumenty sprzedaży."
                        : "Działalność nierejestrowana albo firma — od tego zależą rachunki, faktury i treść regulaminu.",
                    "bi-journal-check", "/panel/ksiegowosc?tab=ustawienia", books.Configured && books.MissingSellerData().Count == 0)
            ]),
            new("Powiadomienia",
            [
                new("E-mail administratora", "Adres na zgłoszenia, alarmy, limit działalności i raporty Leo.", "bi-bell", "/panel/orders",
                    Has(SiteSettingsService.Keys.AdminNotificationEmail)),
                new("Alarm przy fali błędów", "E-mail, gdy aplikacje trenerów zaczną zgłaszać błędy.", "bi-activity", "/panel/alerts",
                    s.GetValueOrDefault(SiteSettingsService.Keys.ErrorAlertEnabled) != "false" && s.GetValueOrDefault(SiteSettingsService.Keys.ErrorAlertEmail) != "false"
                    && Has(SiteSettingsService.Keys.AdminNotificationEmail))
            ]),
            new("Bezpieczeństwo",
            [
                new("Izolacja trenerów", "Własne sekrety instancji, limity zasobów i poczty — trenerzy nie wpływają na siebie.", "bi-shield-lock", "/panel/setup/isolation", _isolationOk),
                new("Konto administratora", "Hasło do Portalu i historia logowań.", "bi-person-lock", "/panel/change-password", true),
                new("Weryfikacja dwuetapowa wymagana", "Każdy administrator loguje się hasłem i kodem z aplikacji — wyciek hasła nie otwiera Panelu.", "bi-shield-check", "/panel/administratorzy",
                    s.GetValueOrDefault(SiteSettingsService.Keys.RequireAdmin2fa) == "true"),
                new("Logi logowań", "Kto i skąd logował się do Portalu.", "bi-journal-text", "/panel/login-logs", true, Optional: true)
            ])
        ];
        var required = _groups.SelectMany(g => g.Items).Where(i => !i.Optional).ToList();
        _total = required.Count;
        _done = required.Count(i => i.Done);
        _loading = false;
    }
}
