    }
    .reg-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .reg-title {
        font-family: var(--pts-font-display);
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 800;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
    }
    .reg-updated {
        font-size: 0.85rem;
        color: var(--pts-text-secondary);
        margin-bottom: 40px;
    }
    .reg-content h2 {
        font-family: var(--pts-font-display);
        font-size: 1.2rem;
        font-weight: 700;
        margin-top: 36px;
        margin-bottom: 12px;
        color: var(--pts-text);
    }
    .reg-content p {
        font-size: 0.95rem;
        line-height: 1.75;
        color: var(--pts-text-secondary);
        margin-bottom: 12px;
    }
    .reg-content a {
        color: var(--pts-primary);
        text-decoration: none;
    }
    .reg-content a:hover {
        text-decoration: underline;
    }
</style>
