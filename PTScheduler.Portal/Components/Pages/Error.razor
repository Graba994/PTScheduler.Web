@page "/Error"
@using System.Diagnostics

<PageTitle>Błąd — PTScheduler</PageTitle>

<section class="err-page">
    <div class="err-container">
        <div class="err-icon">
            <span class="material-symbols-rounded" style="font-size:40px">warning</span>
        </div>
        <h1>Coś poszło nie tak</h1>
        <p>Wystąpił nieoczekiwany błąd podczas przetwarzania żądania.</p>

        @if (ShowRequestId)
        {
            <div class="err-detail">
                <span class="err-detail-label">Request ID:</span>
                <code>@RequestId</code>
            </div>
        }

        <div class="err-actions">
            <a href="/" class="err-btn err-btn-primary">
                <span class="material-symbols-rounded" style="font-size:18px">home</span>
                Strona główna
            </a>
            <a href="/login" class="err-btn err-btn-outline">
                <span class="material-symbols-rounded" style="font-size:18px">login</span>
                Zaloguj się
            </a>
        </div>
    </div>
</section>

<style>
    .err-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 24px;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        color: #1A1625;
        background: #FAFAFF;
    }
    .err-container {
        text-align: center;
        max-width: 480px;
    }
    .err-icon {
        width: 72px; height: 72px;
        border-radius: 18px;
        background: rgba(239, 68, 68, 0.1);
        color: #DC2626;
        display: inline-flex;
        align-items: center; justify-content: center;
        margin-bottom: 24px;
    }
    .err-page h1 {
        font-family: 'Sora', system-ui, sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 10px;
        letter-spacing: -0.02em;
    }
    .err-page p {
        font-size: 1rem;
        color: #6E6882;
        margin: 0 0 24px;
        line-height: 1.6;
    }
    .err-detail {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        background: #F3F1FA;
        border-radius: 8px;
        font-size: 0.82rem;
        color: #6E6882;
        margin-bottom: 32px;
    }
    .err-detail-label { font-weight: 600; }
    .err-detail code {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: #1A1625;
    }
    .err-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .err-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 12px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s;
        border: none;
        cursor: pointer;
    }
    .err-btn-primary {
        background: #7C3AED;
        color: #fff;
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.35);
    }
    .err-btn-primary:hover {
        background: #5B21B6;
        transform: translateY(-1px);
        color: #fff;
    }
    .err-btn-outline {
        background: transparent;
        color: #1A1625;
        border: 2px solid #E8E5F0;
    }
    .err-btn-outline:hover {
        border-color: #7C3AED;
        color: #7C3AED;
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
