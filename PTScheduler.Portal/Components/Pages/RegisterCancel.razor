@page "/register/cancel"
@layout PublicLayout

<PageTitle>Płatność anulowana — PTScheduler</PageTitle>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div style="width:80px;height:80px;border-radius:50%;background:#f59e0b;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:2.5rem" class="mb-3">
                    <i class="bi bi-x-lg"></i>
                </div>
                <h2 class="fw-bold">Płatność anulowana</h2>
                <p class="text-muted">
                    Rejestracja nie została zakończona — nie została pobrana żadna opłata.
                </p>
                <div class="mt-4">
                    <a href="/register" class="btn btn-primary">Wróć do rejestracji</a>
                    <a href="/" class="btn btn-outline-secondary ms-2">Strona główna</a>
                </div>
            </div>
        </div>
    </div>
</section>
