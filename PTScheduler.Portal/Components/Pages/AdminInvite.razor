@page "/zaproszenie-admina"
@layout PublicLayout

<PageTitle>Zaproszenie do panelu — Hantly Portal</PageTitle>

@* Nowy administrator ustawia hasło z linku z e-maila (token resetu hasła, ważny dobę). *@
<section class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo"><img src="/brand/hantly-mark.svg" alt="" width="44" height="44" /></div>
                <h2>Witaj w zespole Hantly</h2>
                <p>Ustaw hasło do panelu administracyjnego. Po zalogowaniu włącz weryfikację dwuetapową w zakładce „Bezpieczeństwo”.</p>
            </div>

            @if (string.IsNullOrWhiteSpace(U) || string.IsNullOrWhiteSpace(T))
            {
                <div class="login-alert login-alert-danger"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>Ten link jest niepełny — otwórz go jeszcze raz z e-maila.</div>
            }
            else
            {
                <form method="post" action="/api/account/admin-invite" data-enhance="false">
                    <input type="hidden" name="u" value="@U" />
                    <input type="hidden" name="t" value="@T" />
                    <AntiforgeryToken />
                    @if (!string.IsNullOrWhiteSpace(Error))
                    {
                        <div class="login-alert login-alert-danger"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@Error</div>
                    }
                    <div class="login-field">
                        <label for="password">Nowe hasło</label>
                        <div class="login-input-wrap">
                            <i class="bi bi-lock login-input-icon" aria-hidden="true"></i>
                            <input id="password" type="password" name="password" autocomplete="new-password" minlength="8" required autofocus />
                        </div>
                        <div class="login-hint">Co najmniej 8 znaków, wielka litera, cyfra i znak specjalny.</div>
                    </div>
                    <div class="login-field">
                        <label for="password2">Powtórz hasło</label>
                        <div class="login-input-wrap">
                            <i class="bi bi-lock login-input-icon" aria-hidden="true"></i>
                            <input id="password2" type="password" name="password2" autocomplete="new-password" minlength="8" required />
                        </div>
                    </div>
                    <button type="submit" class="login-submit"><i class="bi bi-check2-circle" aria-hidden="true"></i>Ustaw hasło</button>
                </form>
            }
        </div>
    </div>
</section>

<style>
    .login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 120px 24px 60px; font-family: var(--pts-font-body); }
    .login-container { width: 100%; max-width: 420px; }
    .login-card { background: var(--pts-surface); border: 1px solid var(--pts-border); border-radius: var(--pts-radius); padding: 36px 32px; box-shadow: var(--pts-shadow-lg); }
    .login-header { text-align: center; margin-bottom: 24px; }
    .login-logo { width: 52px; height: 52px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .login-header h2 { font-family: var(--pts-font-display); font-weight: 700; font-size: 1.4rem; color: var(--pts-text); margin: 0 0 6px; }
    .login-header p { font-size: .9rem; color: var(--pts-text-secondary); margin: 0; }
    .login-alert { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: var(--pts-radius-sm); font-size: .85rem; font-weight: 500; margin-bottom: 20px; }
    .login-alert-danger { background: rgba(239, 68, 68, .08); color: #DC2626; border: 1px solid rgba(239, 68, 68, .15); }
    .login-field { margin-bottom: 18px; }
    .login-field label { display: block; font-size: .82rem; font-weight: 600; color: var(--pts-text); margin-bottom: 6px; }
    .login-input-wrap { position: relative; }
    .login-input-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--pts-text-secondary); }
    .login-input-wrap input { width: 100%; padding: 12px 14px 12px 42px; border: 1.5px solid var(--pts-border); border-radius: var(--pts-radius-sm); font-size: .95rem; background: var(--pts-bg); }
    .login-input-wrap input:focus { outline: none; border-color: var(--pts-primary); box-shadow: 0 0 0 3px var(--pts-glow); }
    .login-hint { font-size: .78rem; color: var(--pts-text-secondary); margin-top: 6px; }
    .login-submit { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px; border: 0; border-radius: var(--pts-radius-sm); background: var(--pts-primary); color: #fff; font-weight: 700; font-size: .95rem; }
    .login-submit:hover { background: var(--pts-primary-dark); }
</style>

@code {
    [SupplyParameterFromQuery] public string? U { get; set; }
    [SupplyParameterFromQuery] public string? T { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
