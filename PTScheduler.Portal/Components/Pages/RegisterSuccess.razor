@page "/register/success"
@layout PublicLayout
@inject IDbContextFactory<PortalDbContext> DbFactory

<PageTitle>Płatność zakończona — PTScheduler</PageTitle>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div style="width:80px;height:80px;border-radius:50%;background:#198754;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:2.5rem" class="mb-3">
                    <i class="bi bi-check-lg"></i>
                </div>
                <h2 class="fw-bold">Dziękujemy za płatność!</h2>
                <p class="text-muted">
                    Twoja subskrypcja została aktywowana. W ciągu kilku minut uruchomimy Twoją instancję —
                    otrzymasz email z linkiem gdy będzie gotowa.
                </p>

                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Co się teraz dzieje</h6>
                        <ol class="text-start small mb-0">
                            <li class="mb-2">Stripe potwierdził płatność</li>
                            <li class="mb-2">Nasz portal tworzy Twoje kontenery (kilka sekund)</li>
                            <li class="mb-2">Baza jest inicjalizowana</li>
                            <li>Wysyłamy Ci email z linkiem do Twojej aplikacji</li>
                        </ol>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(SessionId))
                {
                    <p class="text-muted small mt-3">
                        ID sesji: <code>@SessionId</code>
                    </p>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "session_id")]
    public string? SessionId { get; set; }
}
