@page "/login"
@layout PublicLayout

<PageTitle>Logowanie — PTScheduler Portal</PageTitle>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold">Panel administracyjny</h3>
                    <p class="text-muted">Zaloguj się aby zarządzać instancjami</p>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <form method="post" action="/api/account/login">
                            <input type="hidden" name="returnUrl" value="/panel" />
                            <AntiforgeryToken />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email</label>
                                <input class="form-control" type="email" name="email" placeholder="admin@ptscheduler.pl" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Hasło</label>
                                <input class="form-control" type="password" name="password" required />
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">Zapamiętaj mnie</label>
                            </div>

                            @if (Error == "locked")
                            {
                                <div class="alert alert-danger py-2 small">
                                    <i class="bi bi-lock me-1"></i>Konto zablokowane po zbyt wielu próbach. Spróbuj za 15 minut.
                                </div>
                            }
                            else if (_error)
                            {
                                <div class="alert alert-danger py-2 small">Nieprawidłowy email lub hasło.</div>
                            }

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Zaloguj się
                            </button>
                        </form>

                        <p class="text-muted text-center small mt-3 mb-0">
                            <a href="/">Wróć na stronę główną</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private bool _error => !string.IsNullOrEmpty(Error);
}
