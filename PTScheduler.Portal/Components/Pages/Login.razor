@page "/login"
@layout PublicLayout
@inject SignInManager<IdentityUser> SignInMgr
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Logowanie — PTScheduler Portal</PageTitle>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold">Panel administracyjny</h3>
                    <p class="text-muted">Zaloguj się aby zarządzać instancjami</p>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <EditForm Model="_form" OnValidSubmit="Submit" FormName="login">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email</label>
                                <InputText class="form-control" type="email" @bind-Value="_form.Email" placeholder="admin@ptscheduler.pl" />
                                <ValidationMessage For="() => _form.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Hasło</label>
                                <InputText class="form-control" type="password" @bind-Value="_form.Password" />
                                <ValidationMessage For="() => _form.Password" />
                            </div>

                            <div class="form-check mb-3">
                                <InputCheckbox class="form-check-input" @bind-Value="_form.RememberMe" />
                                <label class="form-check-label">Zapamiętaj mnie</label>
                            </div>

                            @if (_error is not null)
                            {
                                <div class="alert alert-danger py-2 small">@_error</div>
                            }

                            <button type="submit" class="btn btn-primary w-100" disabled="@_loading">
                                @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-box-arrow-in-right me-1"></i>Zaloguj się
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private LoginForm _form = new();
    private bool _loading;
    private string? _error;

    private async Task Submit()
    {
        _error = null;
        _loading = true;

        var result = await SignInMgr.PasswordSignInAsync(
            _form.Email, _form.Password, _form.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Nav.NavigateTo("/panel", forceLoad: true);
        }
        else
        {
            _error = "Nieprawidłowy email lub hasło.";
        }

        _loading = false;
    }

    private class LoginForm
    {
        [global::System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        [global::System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Nieprawidłowy email")]
        public string Email { get; set; } = "";

        [global::System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
