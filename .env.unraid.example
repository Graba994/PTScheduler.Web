# Używane przez docker-compose.unraid.yml (Postgres jako osobny kontener/VM na Unraidzie).
# Skopiuj jako .env: cp .env.unraid.example .env

# Adres i port serwera PostgreSQL już działającego na Twoim Unraidzie
DB_HOST=192.168.0.220
DB_PORT=5432
DB_NAME=ptscheduler
DB_USER=postgres
DB_PASSWORD=zmien_na_silne_haslo

# Port hosta, na którym appka będzie widoczna (domyślnie 8080)
APP_PORT=8080
