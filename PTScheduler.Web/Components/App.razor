@inject PTScheduler.Application.Interfaces.IBrandingService BrandingService

<!DOCTYPE html>
<html lang="pl" data-theme="@_accent" data-mode="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />

    <!-- Theme init: runs synchronously before paint to avoid flash -->
    <script>
        (function () {
            var h = document.documentElement;
            function setAttrIfChanged(name, value) {
                if (h.getAttribute(name) !== value) h.setAttribute(name, value);
            }
            function applyDark(dark) {
                var rawTheme = h.getAttribute('data-theme') || 'ocean';
                var base = rawTheme.replace(/-dark$/, '');
                setAttrIfChanged('data-theme', dark ? base + '-dark' : base);
                setAttrIfChanged('data-effective-mode', dark ? 'dark' : 'light');
            }
            function getCookie() {
                var match = document.cookie.match(/ptscheduler-dark=([01])/);
                return match ? match[1] : null;
            }
            function getStored() {
                var c = getCookie();
                if (c !== null) return c;
                try { return localStorage.getItem('ptscheduler-dark'); } catch (e) { return null; }
            }
            function savePref(dark) {
                document.cookie = 'ptscheduler-dark=' + (dark ? '1' : '0') + '; path=/; max-age=31536000; SameSite=Lax';
                try { localStorage.setItem('ptscheduler-dark', dark ? '1' : '0'); } catch (e) { }
            }
            function apply() {
                var pref = getStored();
                if (pref !== null) {
                    applyDark(pref === '1');
                } else {
                    applyDark(false); // domyślnie tryb jasny
                }
            }
            window.PTTheme = {
                isDark: function () { return h.getAttribute('data-effective-mode') === 'dark'; },
                toggle: function () {
                    var dark = !window.PTTheme.isDark();
                    applyDark(dark);
                    savePref(dark);
                    return dark;
                },
                apply: apply
            };
            apply();
            // Re-apply on Blazor enhanced navigation
            document.addEventListener('enhancedload', apply);
            // Defensive: react if <html> attrs get reset (enhanced nav, streaming render, etc.)
            // setAttrIfChanged guards against infinite loop — same-value writes are skipped.
            try {
                new MutationObserver(apply).observe(h, {
                    attributes: true,
                    attributeFilter: ['data-theme', 'data-mode']
                });
            } catch (e) { }
        })();
    </script>

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0284C7" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="@_companyName" />
    <meta name="application-name" content="@_companyName" />
    <meta name="msapplication-TileColor" content="#0284C7" />
    <meta name="msapplication-TileImage" content="/icons/icon-144.png" />
    <!-- Apple touch icons — custom first, then built-in sizes as fallback -->
    @if (!string.IsNullOrEmpty(_pwaIconPath))
    {
        <link rel="apple-touch-icon" href="@_pwaIconPath" />
    }
    else
    {
        <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />
        <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152.png" />
        <link rel="apple-touch-icon" sizes="144x144" href="/icons/icon-144.png" />
        <link rel="apple-touch-icon" sizes="128x128" href="/icons/icon-128.png" />
        <link rel="apple-touch-icon" sizes="96x96"   href="/icons/icon-96.png" />
        <link rel="apple-touch-icon"                  href="@(_faviconPath ?? "/icons/icon-192.png")" />
    }

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- FullCalendar -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PTScheduler.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="@(_faviconPath ?? "/favicon.png")" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <!-- FullCalendar global bundle -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/locales/pl.global.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>
    <script src="/js/charts.js"></script>
    <script src="/js/keyboard-nav.js"></script>
    <script src="/js/pull-to-refresh.js"></script>
    <script src="/js/welcome.js"></script>
    <script src="/js/export.js"></script>
    <script src="/js/workout-store.js"></script>
    <script src="/js/auth-forms.js"></script>
    <!-- UserMenu position helper -->
    <script>
        window.PTMenu = {
            getRect: function (el) {
                var r = el.getBoundingClientRect();
                return { top: r.top, bottom: r.bottom, left: r.left, right: r.right, width: r.width, vw: window.innerWidth, vh: window.innerHeight };
            }
        };
    </script>
    <!-- PWA: Service Worker + Install Prompt -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
        }

        window._installPrompt = null;
        window._bannerRef = null;

        window.addEventListener('beforeinstallprompt', e => {
            e.preventDefault();
            window._installPrompt = e;
            // Notify the Blazor banner component if it's already listening
            if (window._bannerRef && !document.querySelector('.pwa-banner')) {
                window._bannerRef.invokeMethodAsync('OnInstallAvailable');
            }
        });

        window.addEventListener('appinstalled', () => {
            window._installPrompt = null;
            localStorage.setItem('pwa-banner-dismissed', Date.now().toString());
        });

        window.triggerPwaInstall = async () => {
            if (!window._installPrompt) return false;
            window._installPrompt.prompt();
            const { outcome } = await window._installPrompt.userChoice;
            window._installPrompt = null;
            return outcome === 'accepted';
        };

        // Called by PwaInstallBanner.razor to register its DotNet ref
        window.PTBanner = {
            // standalone | dismissed | desktop | ios | mobile
            environment: () => {
                if (window.navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches)
                    return 'standalone';
                try {
                    const ts = parseInt(localStorage.getItem('pwa-banner-dismissed') || '0', 10);
                    if (ts && Date.now() - ts < 3 * 24 * 60 * 60 * 1000) return 'dismissed';
                } catch (e) { }
                const ua = navigator.userAgent;
                // iPadOS 13+ przedstawia się jako Mac — rozpoznajemy po ekranie dotykowym.
                const ios = /iphone|ipad|ipod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
                if (ios) {
                    try {
                        if (sessionStorage.getItem('pwa-ios-shown')) return 'dismissed';
                        sessionStorage.setItem('pwa-ios-shown', '1');
                    } catch (e) { }
                    return 'ios';
                }
                const mobile = /android|mobile/i.test(ua) || window.matchMedia('(pointer: coarse)').matches;
                return mobile ? 'mobile' : 'desktop';
            },
            dismiss: () => {
                try { localStorage.setItem('pwa-banner-dismissed', Date.now().toString()); } catch (e) { }
            },
            otherBannerVisible: () => !!document.querySelector('.pwa-banner'),
            listen: (dotnetRef) => {
                window._bannerRef = dotnetRef;
                // If the install prompt already fired before the banner mounted, notify immediately
                if (window._installPrompt && !document.querySelector('.pwa-banner')) {
                    dotnetRef.invokeMethodAsync('OnInstallAvailable');
                }
            }
        };

        // Web Push subscription helpers
        window.PTPush = {
            isSupported: () => 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window,
            getPermission: () => ('Notification' in window) ? Notification.permission : 'unsupported',
            // iPhone/iPad: push działa tylko w aplikacji dodanej do ekranu głównego (iOS 16.4+).
            isIosNotInstalled: () => {
                const ios = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
                const standalone = window.navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches;
                return ios && !standalone;
            },
            // navigator.serviceWorker.ready nigdy się nie kończy, gdy SW się nie zarejestrował — limit czasu.
            _ready: () => Promise.race([
                navigator.serviceWorker.ready,
                new Promise((_, reject) => setTimeout(() => reject(new Error('Service worker niedostępny')), 8000))
            ]),
            _toDto: (sub) => {
                const json = sub.toJSON();
                return { endpoint: json.endpoint, p256dh: json.keys.p256dh, auth: json.keys.auth };
            },
            _sameKey: (current, expected) => {
                if (!current) return false;
                const a = new Uint8Array(current);
                if (a.length !== expected.length) return false;
                for (let i = 0; i < a.length; i++) if (a[i] !== expected[i]) return false;
                return true;
            },
            // Przy zgodzie już udzielonej: zwraca aktualną subskrypcję (tworzy/odnawia ją w razie potrzeby,
            // np. po zmianie kluczy VAPID przez admina). Bez zgody — null.
            ensureSubscribed: async (vapidPublicKey) => {
                if (Notification.permission !== 'granted') return null;
                const reg = await PTPush._ready();
                const key = PTPush._urlBase64ToUint8Array(vapidPublicKey);
                let sub = await reg.pushManager.getSubscription();
                if (sub && !PTPush._sameKey(sub.options && sub.options.applicationServerKey, key)) {
                    await sub.unsubscribe();
                    sub = null;
                }
                if (!sub) sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: key });
                return PTPush._toDto(sub);
            },
            // Prośba o zgodę MUSI paść bezpośrednio w obsłudze kliknięcia (Safari/iOS, Firefox) — dlatego
            // natywny listener, a nie @onclick Blazora (tam wywołanie JS przychodzi po podróży do serwera).
            bindEnable: (el, dotnetRef, vapidPublicKey) => {
                if (!el || el._ptPushBound) return;
                el._ptPushBound = true;
                el.addEventListener('click', async () => {
                    try {
                        const permission = await Notification.requestPermission();
                        if (permission !== 'granted') {
                            await dotnetRef.invokeMethodAsync('OnPushResult', null, permission);
                            return;
                        }
                        const sub = await PTPush.ensureSubscribed(vapidPublicKey);
                        await dotnetRef.invokeMethodAsync('OnPushResult', sub, 'granted');
                    } catch (e) {
                        await dotnetRef.invokeMethodAsync('OnPushResult', null, 'error:' + ((e && e.message) || e));
                    }
                });
            },
            getSubscription: async () => {
                const reg = await PTPush._ready();
                const sub = await reg.pushManager.getSubscription();
                return sub ? sub.endpoint : null;
            },
            unsubscribe: async () => {
                const reg = await PTPush._ready();
                const sub = await reg.pushManager.getSubscription();
                if (sub) { await sub.unsubscribe(); return sub.endpoint; }
                return null;
            },
            // Propozycja włączenia po zalogowaniu: raz na sesję, „Nie teraz” wycisza na 30 dni,
            // nie razem z innym banerem (instalacja PWA, odcisk palca).
            shouldOffer: () => {
                if (!PTPush.isSupported() || PTPush.isIosNotInstalled()) return false;
                // Telefon w zwykłej przeglądarce: najpierw instalacja aplikacji (baner PWA), push — już w aplikacji.
                const standalone = window.navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches;
                const mobile = /android|iphone|ipad|mobile/i.test(navigator.userAgent) || window.matchMedia('(pointer: coarse)').matches;
                if (mobile && !standalone) return false;
                if (Notification.permission !== 'default') return false;
                if (document.querySelector('.pwa-banner')) return false;
                try {
                    const d = parseInt(localStorage.getItem('pts.push.dismissed') || '0', 10);
                    if (d && Date.now() - d < 30 * 864e5) return false;
                    if (sessionStorage.getItem('pts.push.shown')) return false;
                    sessionStorage.setItem('pts.push.shown', '1');
                } catch (e) { }
                return true;
            },
            dismiss: () => { try { localStorage.setItem('pts.push.dismissed', Date.now().toString()); } catch (e) { } },
            _urlBase64ToUint8Array: (base64String) => {
                const padding = '='.repeat((4 - base64String.length % 4) % 4);
                const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
                const raw = atob(base64);
                return Uint8Array.from([...raw].map(c => c.charCodeAt(0)));
            }
        };
    </script>
</body>

</html>

@code {
    private string _accent = "ocean";
    private string _companyName = "PTScheduler";
    private string? _faviconPath;
    private string? _pwaIconPath;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var branding = await BrandingService.GetAsync();
            _accent = branding.ThemeName ?? "ocean";
            _companyName = branding.CompanyName ?? "PTScheduler";
            _faviconPath = branding.FaviconPath;
            _pwaIconPath = branding.PwaIconPath;
        }
        catch { } // Best-effort: fall back to defaults if branding unavailable
    }
}
