@inherits LayoutComponentBase
@layout PTScheduler.Web.Components.Layout.MainLayout
@inject AuthenticationStateProvider AuthState
@inject PTScheduler.Application.Interfaces.IPermissionService Permission
@inject NavigationManager Nav
@inject SetupGuide Guide

@* Ustawienia: bez długiego menu bocznego. Strona „Zarządzanie” to kafelki, a na podstronach jest tylko
   powrót, nazwa bieżącej opcji z wyjaśnieniem (i) i „Przejdź do…” do szybkiej zmiany. *@
<div class="setx">
    @if (!_isHub)
    {
        <div class="setx-bar">
            <a class="setx-back" href="/admin" title="Wszystkie ustawienia">
                <i class="bi bi-arrow-left"></i><span>Ustawienia</span>
            </a>
            <div class="setx-crumb">
                @if (_current is { } c)
                {
                    <span class="setx-crumb-group">@c.Group.Title</span>
                    <i class="bi bi-chevron-right setx-crumb-sep"></i>
                    <span class="setx-crumb-item"><i class="bi @c.Item.Icon"></i>@c.Item.Title</span>
                    <InfoTip Title="@c.Item.Title" Text="@c.Item.Info" />
                }
            </div>
            <button type="button" class="setx-jump-btn" popovertarget="setx-jump">
                <i class="bi bi-grid-3x3-gap-fill"></i><span>Przejdź do…</span>
            </button>
            <div popover id="setx-jump" class="setx-jump" role="dialog" aria-label="Przejdź do ustawienia">
                <div class="setx-jump-head">
                    <strong>Przejdź do</strong>
                    <button type="button" class="btn-close" popovertarget="setx-jump" popovertargetaction="hide" aria-label="Zamknij"></button>
                </div>
                <div class="setx-jump-grid">
                    @foreach (var group in AdminMenu.Groups)
                    {
                        var items = group.Items.Where(_access.Sees).ToList();
                        if (items.Count == 0) continue;
                        <div class="setx-jump-group set-tone-@group.Tone">
                            <div class="setx-jump-title"><i class="bi @group.Icon"></i>@group.Title</div>
                            @foreach (var item in items)
                            {
                                var done = _state?.StatusOf(item).IsConfigured == true;
                                <a href="/@item.Href" class="@(_current?.Item == item ? "active" : "")">
                                    <i class="bi @item.Icon"></i><span>@item.Title</span>
                                    @if (done) { <i class="bi bi-check-circle-fill setx-jump-ok" title="Skonfigurowane"></i> }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (_state is not null) { <SetupGuideBar State="_state" /> }
    }
    <div class="setx-page">
        @Body
    </div>
</div>

@code {
    private bool _isHub;
    private AdminAccess _access = new();
    private SetupState? _state;
    private (AdminMenuGroup Group, AdminMenuItem Item)? _current;

    protected override async Task OnInitializedAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        _isHub = path.Equals("admin", StringComparison.OrdinalIgnoreCase);
        if (_isHub) return;
        _current = AdminMenu.Find(path);
        _access = await AdminAccess.LoadAsync(AuthState, Permission);
        var auth = await AuthState.GetAuthenticationStateAsync();
        _state = await Guide.GetAsync(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "", _access);
    }
}
