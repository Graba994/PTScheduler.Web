@inherits LayoutComponentBase
@layout PTScheduler.Web.Components.Layout.MainLayout
@inject AuthenticationStateProvider AuthState

<div class="manage-shell admin-shell">

    <div class="manage-header admin-panel-header">
        <div class="manage-avatar" style="background:linear-gradient(135deg,var(--bs-danger),#921925)">
            <i class="bi bi-shield-fill-check" style="font-size:1.4rem"></i>
        </div>
        <div>
            <div class="manage-user-name">Panel zarządzania</div>
            <div class="manage-user-email">Konfiguracja i zarządzanie</div>
            <span class="badge @_roleBadgeClass mt-1" style="font-size:.7rem">@_roleLabel</span>
        </div>
    </div>

    <div class="manage-body">
        <div class="manage-sidebar">
            <AdminNavMenu />
        </div>
        <div class="manage-content">
            @Body
        </div>
    </div>

</div>

@code {
    private string _roleLabel = "Administrator";
    private string _roleBadgeClass = "bg-danger";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.IsInRole("Admin")) { _roleLabel = "Administrator"; _roleBadgeClass = "bg-danger"; }
        else if (auth.User.IsInRole("Trainer")) { _roleLabel = "Trener"; _roleBadgeClass = "bg-primary"; }
        else if (auth.User.IsInRole("Subordinate")) { _roleLabel = "Współtrener"; _roleBadgeClass = "bg-secondary"; }
    }
}
