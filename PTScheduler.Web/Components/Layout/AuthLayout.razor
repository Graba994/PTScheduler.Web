@inherits LayoutComponentBase
@inject PTScheduler.Application.Interfaces.IBrandingService BrandingService

<div class="auth-shell @(_hasPhoto ? "auth-shell-photo" : "")"
     style="@(_hasPhoto ? $"--auth-bg:url('{_branding.LoginBackgroundPath}')" : null)">
    <div class="auth-brand">
        @if (!string.IsNullOrEmpty(_branding.LogoPath))
        {
            <img src="@_branding.LogoPath" alt="@_branding.CompanyName" class="auth-logo" />
        }
        else
        {
            <div class="auth-icon"><i class="bi bi-calendar-heart"></i></div>
        }
        <span class="auth-company">@_branding.CompanyName</span>
    </div>

    <div class="auth-card-wrap">
        <CascadingValue Value="_branding" IsFixed="true">
            @Body
        </CascadingValue>
    </div>

    <div class="auth-footer">© @StudioClock.Now.Year @_branding.CompanyName</div>
</div>

<CookieConsent />

@code {
    private PTScheduler.Application.DTOs.AppBrandingDto _branding = new();
    private bool _hasPhoto => !string.IsNullOrEmpty(_branding.LoginBackgroundPath);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branding = await BrandingService.GetAsync();
            if (string.IsNullOrWhiteSpace(_branding.CompanyName)) _branding.CompanyName = "PTScheduler";
        }
        catch { } // Best-effort: fall back to defaults if branding unavailable
    }
}
