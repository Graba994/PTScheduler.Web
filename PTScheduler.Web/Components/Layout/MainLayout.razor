@inherits LayoutComponentBase
@inject NavigationManager Nav
@using PTScheduler.Domain.Constants

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <div class="app-content">
            @Body
        </div>
    </main>
</div>

<PwaInstallBanner />

<AuthorizeView>
    <Authorized>
        <TrainerContactCache />
    </Authorized>
</AuthorizeView>

<!-- Mobile bottom nav — Trainer / Admin / Subordinate -->
<AuthorizeView Roles="Admin,Trainer,Subordinate">
    <Authorized>
        <nav class="mobile-bottom-nav">
            <a href="/" class="mobile-nav-item @IsActive("")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-house-fill"></i>
                <span>Home</span>
            </a>
            <a href="/calendar" class="mobile-nav-item @IsActive("calendar")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-calendar3"></i>
                <span>Kalendarz</span>
            </a>
            <a href="/sessions" class="mobile-nav-item @IsActive("sessions")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-calendar-check"></i>
                <span>Wizyty</span>
            </a>
            <a href="/clients" class="mobile-nav-item @IsActive("clients")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-people-fill"></i>
                <span>Klienci</span>
            </a>
            <MobileMoreMenu />
        </nav>
    </Authorized>
</AuthorizeView>

<!-- Mobile bottom nav — Client -->
<AuthorizeView Roles="Client">
    <Authorized>
        <nav class="mobile-bottom-nav">
            <a href="/" class="mobile-nav-item @IsActive("")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-house-fill"></i>
                <span>Home</span>
            </a>
            <a href="/my" class="mobile-nav-item @IsActive("my")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-calendar-week-fill"></i>
                <span>Grafik</span>
            </a>
            <a href="/sessions" class="mobile-nav-item @IsActive("sessions")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-calendar-check"></i>
                <span>Wizyty</span>
            </a>
            <a href="/my/measurements" class="mobile-nav-item @IsActive("my/measurements")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-rulers"></i>
                <span>Pomiary</span>
            </a>
            <MobileMoreMenu />
        </nav>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private string IsActive(string path)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (path == "" && current == "") return "active";
        if (path == "my" && current.StartsWith("my", StringComparison.OrdinalIgnoreCase))
            return current.StartsWith("my/", StringComparison.OrdinalIgnoreCase) ? string.Empty : "active";
        if (path != "" && current.StartsWith(path, StringComparison.OrdinalIgnoreCase)) return "active";
        return string.Empty;
    }
}
