@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject PTScheduler.Web.Services.ClientNav ClientNav
@using PTScheduler.Domain.Constants

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <div class="app-content">
            <SwitchedBanner />
            <AuthorizeView Roles="Client">
                <Authorized><ClientTabs /></Authorized>
            </AuthorizeView>
            @if (ShowAdminBanner)
            {
                <AuthorizeView Roles="Admin">
                    <Authorized><AdminRoleBanner /></Authorized>
                </AuthorizeView>
            }
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="text-center py-5">
                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size:2.5rem"></i>
                        <h5 class="mt-3">Ups, coś poszło nie tak</h5>
                        <p class="text-muted small mb-3">Wystąpił nieoczekiwany błąd. Spróbuj odświeżyć stronę.</p>
                        <button class="btn btn-primary btn-sm" @onclick="RecoverError">
                            <i class="bi bi-arrow-clockwise me-1"></i>Spróbuj ponownie
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
</div>

<PwaInstallBanner />
<UpsellPopup />
<ToastContainer />
<CookieConsent />

<AuthorizeView>
    <Authorized>
        <TrainerContactCache />
        @* Po przełączeniu na cudze konto nie proponujemy klucza dostępu, powiadomień ani ankiety
           w imieniu tej osoby — i nic nie zasłania przycisku powrotu. *@
        @if (!PTScheduler.Web.Services.AccountSwitchService.IsSwitched(context.User))
        {
            <PasskeyPrompt />
            <PushPrompt />
            <DocumentsGate />
            <HealthSurveyGate />
        }
    </Authorized>
</AuthorizeView>

<!-- Mobile bottom nav — Trainer / Admin / Subordinate -->
<AuthorizeView Roles="Admin,Trainer,Subordinate">
    <Authorized>
        <nav class="mobile-bottom-nav">
            <a href="/app" class="mobile-nav-item @IsActive("app")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-house-fill"></i>
                <span>Home</span>
            </a>
            <a href="/calendar" class="mobile-nav-item @IsActive("calendar")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-calendar3"></i>
                <span>Kalendarz</span>
            </a>
            <a href="/sessions" class="mobile-nav-item @IsActive("sessions")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-calendar-check"></i>
                <span>Wizyty</span>
            </a>
            <a href="/clients" class="mobile-nav-item @IsActive("clients")">
                <span class="mobile-nav-indicator"></span>
                <i class="bi bi-people-fill"></i>
                <span>Klienci</span>
            </a>
            <MobileMoreMenu />
        </nav>
    </Authorized>
</AuthorizeView>

<!-- Mobile bottom nav — Client: te same sekcje co w menu bocznym -->
<AuthorizeView Roles="Client">
    <Authorized>
        <nav class="mobile-bottom-nav">
            @foreach (var s in _clientSections.Where(s => s.Key is "start" or "visits" or "training" or "chat").Take(4))
            {
                <a href="@s.Href" class="mobile-nav-item @(_clientSection?.Key == s.Key ? "active" : "")">
                    <span class="mobile-nav-indicator"></span>
                    <i class="bi @s.Icon position-relative">
                        @if (s.Key == "chat") { <ChatUnreadBadge @rendermode="PTScheduler.Web.RenderModes.Server" /> }
                    </i>
                    <span>@s.Label</span>
                </a>
            }
            <MobileMoreMenu />
        </nav>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    private void RecoverError() => _errorBoundary?.Recover();

    private IReadOnlyList<PTScheduler.Web.Services.ClientNav.Section> _clientSections = [];
    private PTScheduler.Web.Services.ClientNav.Section? _clientSection;

    protected override async Task OnParametersSetAsync()
    {
        _clientSections = await ClientNav.GetSectionsAsync();
        _clientSection = PTScheduler.Web.Services.ClientNav.Match(_clientSections, Nav.ToBaseRelativePath(Nav.Uri)).Section;
    }

    // Baner „Jesteś na koncie Administratora” — na stronach pracy trenera, nie w ustawieniach.
    private static readonly string[] TrainerWork = ["app", "calendar", "sessions", "clients", "trainer", "chat"];

    private bool ShowAdminBanner
    {
        get
        {
            var current = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimStart('/');
            var first = current.Split('/')[0];
            return TrainerWork.Contains(first, StringComparer.OrdinalIgnoreCase);
        }
    }

    private string IsActive(string path)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (path == "" && current == "") return "active";
        if (path == "my" && current.StartsWith("my", StringComparison.OrdinalIgnoreCase))
            return current.StartsWith("my/", StringComparison.OrdinalIgnoreCase) ? string.Empty : "active";
        if (path != "" && current.StartsWith(path, StringComparison.OrdinalIgnoreCase)) return "active";
        return string.Empty;
    }
}
