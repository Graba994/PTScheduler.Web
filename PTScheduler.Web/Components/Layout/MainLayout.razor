@inherits LayoutComponentBase
@inject NavigationManager Nav
@using PTScheduler.Domain.Constants

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <div class="app-content">
            @Body
        </div>
    </main>
</div>

<PwaInstallBanner />

<!-- Cache offline data for all logged-in users -->
<AuthorizeView>
    <Authorized>
        <TrainerContactCache />
    </Authorized>
</AuthorizeView>

<!-- Mobile bottom nav -->
<AuthorizeView Roles="Admin,Trainer,Subordinate">
    <Authorized>
        <nav class="mobile-bottom-nav">
            <a href="/" class="mobile-nav-item @IsActive("")">
                <i class="bi bi-house-fill"></i>
                <span>Home</span>
            </a>
            <a href="/calendar" class="mobile-nav-item @IsActive("calendar")">
                <i class="bi bi-calendar3"></i>
                <span>Kalendarz</span>
            </a>
            <a href="/sessions" class="mobile-nav-item @IsActive("sessions")">
                <i class="bi bi-calendar-check"></i>
                <span>Wizyty</span>
            </a>
            <a href="/clients" class="mobile-nav-item @IsActive("clients")">
                <i class="bi bi-people-fill"></i>
                <span>Klienci</span>
            </a>
            <a href="/Account/Manage" class="mobile-nav-item @IsActive("Account/Manage")">
                <i class="bi bi-person-circle"></i>
                <span>Profil</span>
            </a>
        </nav>
    </Authorized>
</AuthorizeView>
<AuthorizeView Roles="Client">
    <Authorized>
        <nav class="mobile-bottom-nav">
            <a href="/" class="mobile-nav-item @IsActive("")">
                <i class="bi bi-house-fill"></i>
                <span>Home</span>
            </a>
            <a href="/my" class="mobile-nav-item @IsActive("my")">
                <i class="bi bi-calendar-week-fill"></i>
                <span>Grafik</span>
            </a>
            <a href="/sessions" class="mobile-nav-item @IsActive("sessions")">
                <i class="bi bi-calendar-check"></i>
                <span>Wizyty</span>
            </a>
            <a href="/my/measurements" class="mobile-nav-item @IsActive("my/measurements")">
                <i class="bi bi-rulers"></i>
                <span>Pomiary</span>
            </a>
            <a href="/Account/Manage" class="mobile-nav-item @IsActive("Account/Manage")">
                <i class="bi bi-person-circle"></i>
                <span>Profil</span>
            </a>
        </nav>
    </Authorized>
</AuthorizeView>

<!-- Mobile floating user menu — visible only on small screens -->
<AuthorizeView>
    <Authorized>
        <div class="mobile-usermenu-float">
            <UserMenu Direction="down" ShowName="false" />
        </div>
    </Authorized>
</AuthorizeView>

<style>
    .mobile-usermenu-float {
        display: none;
        position: fixed;
        /* top safe area for iOS notch/dynamic island */
        top: max(10px, env(safe-area-inset-top, 10px));
        right: max(10px, env(safe-area-inset-right, 10px));
        z-index: 1050;
    }
    @@media (max-width: 767.98px) {
        .mobile-usermenu-float { display: block; }
    }
</style>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private string IsActive(string path)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (path == "" && current == "") return "active";
        if (path == "my" && current.StartsWith("my", StringComparison.OrdinalIgnoreCase))
            return current.StartsWith("my/", StringComparison.OrdinalIgnoreCase) ? string.Empty : "active";
        if (path != "" && current.StartsWith(path, StringComparison.OrdinalIgnoreCase)) return "active";
        return string.Empty;
    }
}
