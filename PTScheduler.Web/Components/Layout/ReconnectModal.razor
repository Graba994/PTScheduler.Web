<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">

        <!-- Brand mark -->
        <div class="rc-brand">
            <i class="bi bi-calendar-heart"></i>
        </div>

        <!-- Pulsing animation (shown while trying to reconnect) -->
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>

        <!-- Icon: connection lost -->
        <div class="rc-state-icon components-reconnect-failed-visible">
            <i class="bi bi-wifi-off"></i>
        </div>

        <!-- Icon: session paused -->
        <div class="rc-state-icon components-pause-visible components-resume-failed-visible">
            <i class="bi bi-pause-circle"></i>
        </div>

        <!-- Messages -->
        <div class="rc-messages">
            <p class="rc-title components-reconnect-first-attempt-visible">
                Łączę z serwerem…
            </p>
            <p class="rc-hint components-reconnect-first-attempt-visible">
                Chwila cierpliwości, pracujemy nad połączeniem.
            </p>

            <p class="rc-title components-reconnect-repeated-attempt-visible">
                Kolejna próba za <span id="components-seconds-to-next-attempt" class="rc-countdown"></span> s
            </p>
            <p class="rc-hint components-reconnect-repeated-attempt-visible">
                Nie zamykaj okna — spróbujemy automatycznie.
            </p>

            <p class="rc-title components-reconnect-failed-visible">
                Brak połączenia
            </p>
            <p class="rc-hint components-reconnect-failed-visible">
                Sprawdź internet i spróbuj ponownie.
            </p>

            <p class="rc-title components-pause-visible">
                Sesja wstrzymana
            </p>
            <p class="rc-hint components-pause-visible">
                Serwer chwilowo wstrzymał połączenie.
            </p>

            <p class="rc-title components-resume-failed-visible">
                Nie udało się wznowić
            </p>
            <p class="rc-hint components-resume-failed-visible">
                Odśwież stronę, aby kontynuować.
            </p>
        </div>

        <!-- Action buttons -->
        <button id="components-reconnect-button" class="rc-btn components-reconnect-failed-visible">
            <i class="bi bi-arrow-clockwise"></i> Spróbuj ponownie
        </button>
        <button id="components-resume-button" class="rc-btn components-pause-visible components-resume-failed-visible">
            <i class="bi bi-play-fill"></i> Wznów sesję
        </button>

    </div>
</dialog>
