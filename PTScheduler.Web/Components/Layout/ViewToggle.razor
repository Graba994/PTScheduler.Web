@* Przełącznik widoku ustawień (kafelki ↔ menu boczne). Wybór zapamiętuje ciasteczko na rok. *@

<div class="view-toggle" role="group" aria-label="Widok ustawień">
    <span class="view-toggle-label">Widok:</span>
    <button type="button" class="@(!Sidebar ? "active" : "")" onclick="@Script("tiles")" aria-pressed="@(!Sidebar ? "true" : "false")">
        <i class="bi bi-grid-3x2-gap"></i>Kafelki
    </button>
    <button type="button" class="@(Sidebar ? "active" : "")" onclick="@Script("sidebar")" aria-pressed="@(Sidebar ? "true" : "false")">
        <i class="bi bi-layout-sidebar"></i>Menu boczne
    </button>
</div>

@code {
    [Parameter] public bool Sidebar { get; set; }

    private static string Script(string value) =>
        $"document.cookie='{AdminLayout.ViewCookie}={value}; path=/; max-age=31536000; samesite=lax'; location.reload();";
}
