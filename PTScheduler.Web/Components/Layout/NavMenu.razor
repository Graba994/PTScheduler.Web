@inject PTScheduler.Web.Services.EntitlementService Entitlements
@inject PTScheduler.Application.Interfaces.IBrandingService BrandingService
@using PTScheduler.Domain.Constants
@inject PTScheduler.Web.Services.ClientNav ClientNavigation
@inject NavigationManager Navigation
@inject PTScheduler.Web.Services.UpsellService Upsell

<!-- Sidebar brand -->
<a href="/app" class="sidebar-brand">
    @if (!string.IsNullOrEmpty(_logoPath))
    {
        <img src="@_logoPath" alt="@_companyName" />
        <span style="color:var(--c-primary);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@_companyName</span>
    }
    else
    {
        <i class="bi pt-ico-dumbbell"></i>
        <span>@_companyName</span>
    }
</a>

<!-- Navigation -->
<div class="sidebar-nav">
    <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")">
        @* Cztery grupy zamiast długiej listy: praca na co dzień, trening, biznes, ustawienia. *@
        <div class="sidebar-quick"><QuickAdd Css="qa-side" Label="Dodaj" /></div>
        <div class="sidebar-label">Praca</div>
        <NavLink class="sidebar-link" href="app" Match="NavLinkMatch.All">
            <i class="bi bi-house-fill"></i><span>Pulpit</span>
        </NavLink>
        <NavLink class="sidebar-link" href="dzis">
            <i class="bi bi-sun"></i><span>Dziś</span>
        </NavLink>
        <NavLink class="sidebar-link" href="calendar">
            <i class="bi bi-calendar3"></i><span>Kalendarz</span>
        </NavLink>
        <NavLink class="sidebar-link" href="clients">
            <i class="bi bi-people-fill"></i><span>Klienci</span>
        </NavLink>
        <NavLink class="sidebar-link" href="chat">
            <i class="bi bi-chat-dots-fill"></i><span>Wiadomości</span>
            <ChatUnreadBadge @rendermode="PTScheduler.Web.RenderModes.Server" />
        </NavLink>

        @if (Entitlements.IsAllowed("TrainingPlansEnabled"))
        {
            <div class="sidebar-label">Trening</div>
            <NavLink class="sidebar-link" href="plans">
                <i class="bi bi-list-check"></i><span>Plany</span>
            </NavLink>
            <NavLink class="sidebar-link" href="exercises">
                <i class="bi pt-ico-dumbbell"></i><span>Ćwiczenia</span>
            </NavLink>
            <NavLink class="sidebar-link" href="trainer/activity">
                <i class="bi bi-people"></i><span>Aktywność</span>
            </NavLink>
        }

        <div class="sidebar-label">Biznes</div>
        @* Moduły spoza planu nie pojawiają się w menu (nikomu) — dostępne plany pokazuje „Ulepsz plan”. *@
        @if (Entitlements.IsAllowed("FinancialReports"))
        {
            <NavLink class="sidebar-link" href="finance">
                <i class="bi bi-currency-dollar"></i><span>Finanse</span>
            </NavLink>
        }
        @if (Entitlements.IsAllowed("AdvancedAnalytics"))
        {
            <NavLink class="sidebar-link" href="stats">
                <i class="bi bi-bar-chart-line-fill"></i><span>Statystyki</span>
            </NavLink>
        }
        @* Mogą odejść, zaległości, wolne okienka, kończące się pakiety — jedna pozycja, zakładki na stronie. *@
        <a class="sidebar-link @(AttentionActive ? "active" : "")" href="uwaga">
            <i class="bi bi-person-exclamation"></i><span>Wymaga uwagi</span>
        </a>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.Client">
        @* Kilka sekcji zamiast kilkunastu pozycji — reszta w zakładkach nad stroną. *@
        @foreach (var sec in _clientSections)
        {
            <a class="sidebar-link @(_clientSection?.Key == sec.Key ? "active" : "")" href="@sec.Href">
                <i class="bi @sec.Icon"></i><span>@sec.Label</span>
                @if (sec.Key == "chat") { <ChatUnreadBadge @rendermode="PTScheduler.Web.RenderModes.Server" /> }
            </a>
        }
        <div class="sidebar-divider"></div>
        <NavLink class="sidebar-link" href="Account/Manage">
            <i class="bi bi-person-circle"></i><span>Moje konto</span>
        </NavLink>
        @if (ClientNavigation.ReferralsEnabled)
        {
            <NavLink class="sidebar-link" href="my/referrals">
                <i class="bi bi-gift"></i><span>Poleć znajomym</span>
            </NavLink>
        }
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")">
        <div class="sidebar-label">Ustawienia</div>
        <NavLink class="sidebar-link" href="trainer/availability">
            <i class="bi bi-clock-fill"></i><span>Godziny pracy</span>
        </NavLink>
        @if (Entitlements.IsAllowed("RecurringSessions"))
        {
            <NavLink class="sidebar-link" href="trainer/series">
                <i class="bi bi-repeat"></i><span>Serie wizyt</span>
            </NavLink>
        }
        <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Trainer}")" Context="weekTplAuth">
            <NavLink class="sidebar-link" href="trainer/szablon-tygodnia">
                <i class="bi bi-calendar-range"></i><span>Szablon tygodnia</span>
            </NavLink>
        </AuthorizeView>
        <NavLink class="sidebar-link" href="trainer/pairs">
            <i class="bi bi-people-fill"></i><span>Treningi w parach</span>
        </NavLink>
        <NavLink class="sidebar-link" href="admin" Match="NavLinkMatch.All">
            <i class="bi bi-shield-fill-check"></i><span>Zarządzanie</span>
        </NavLink>
    </AuthorizeView>
    @* Sklep usług — zawsze pod ręką dla właściciela; kropka, gdy coś się kończy. *@
    <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Trainer}")">
        <NavLink class="sidebar-link" href="admin/sklep">
            <i class="bi bi-bag-heart-fill"></i><span>Sklep</span>
            @if (_urgent) { <span class="nav-dot" title="Coś się kończy — zajrzyj"></span> }
        </NavLink>
    </AuthorizeView>
</div>

@if (_showPlan)
{
    <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Trainer}")">
        <a href="/admin/upgrade" class="plan-pill" title="Zobacz, co daje wyższy plan">
            <i class="bi bi-rocket-takeoff"></i>
            <span>Plan <b>@Entitlements.Current.Name</b></span>
            <span class="plan-pill-cta">Ulepsz</span>
        </a>
    </AuthorizeView>
}

<!-- Dev credit -->
<div style="padding:0 1rem .25rem;text-align:center">
    <a href="https://grabowski.app" target="_blank" rel="noopener noreferrer"
       style="font-size:.65rem;color:var(--bs-secondary-color);text-decoration:none;opacity:.6;transition:opacity .2s"
       onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='.6'">
        made by Patryk Grabowski
    </a>
</div>

<!-- Sidebar footer -->
<div class="sidebar-footer">
    <AuthorizeView>
        <Authorized>
            <UserMenu Direction="up" ShowName="true" />
        </Authorized>
        <NotAuthorized>
            <NavLink class="sidebar-link" href="Account/Login">
                <i class="bi bi-box-arrow-in-right"></i><span>Zaloguj</span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string? _logoPath;
    private string _companyName = "PTScheduler";

    private IReadOnlyList<PTScheduler.Web.Services.ClientNav.Section> _clientSections = [];
    private PTScheduler.Web.Services.ClientNav.Section? _clientSection;

    protected override async Task OnParametersSetAsync()
    {
        _clientSections = await ClientNavigation.GetSectionsAsync();
        _clientSection = PTScheduler.Web.Services.ClientNav.Match(_clientSections, Navigation.ToBaseRelativePath(Navigation.Uri)).Section;
    }

    private static readonly string[] AttentionPaths = ["uwaga", "zaleglosci", "trainer/retencja", "okienka", "pakiety-koncza"];
    private bool AttentionActive => AttentionPaths.Contains(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/'));

    private bool _urgent;
    // „Ulepsz” pokazujemy tylko, gdy instancja ma plan z Portalu (samodzielna instalacja jest bez ograniczeń).
    private bool _showPlan => PlanCatalog.HasUpgrade(Entitlements.Current);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var branding = await BrandingService.GetAsync();
            _logoPath = branding.LogoPath;
            _companyName = branding.CompanyName ?? "PTScheduler";
        }
        catch { } // Best-effort: fall back to defaults if branding unavailable

        try { _urgent = (await Upsell.GetAsync()).Any(n => n.IsUrgent); } catch { }
    }

}
