@implements IDisposable
@inject NavigationManager NavigationManager
@inject PTScheduler.Application.Interfaces.IBrandingService BrandingService
@using PTScheduler.Domain.Constants

<!-- Sidebar brand -->
<a href="/" class="sidebar-brand">
    @if (!string.IsNullOrEmpty(_logoPath))
    {
        <img src="@_logoPath" alt="@_companyName" />
        <span style="color:var(--c-primary);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@_companyName</span>
    }
    else
    {
        <i class="bi bi-calendar-heart"></i>
        <span>@_companyName</span>
    }
</a>

<!-- Navigation -->
<div class="sidebar-nav">
    <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")">
        <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-fill"></i><span>Dashboard</span>
        </NavLink>
        <NavLink class="sidebar-link" href="calendar">
            <i class="bi bi-calendar3"></i><span>Kalendarz</span>
        </NavLink>
        <NavLink class="sidebar-link" href="sessions">
            <i class="bi bi-calendar-check"></i><span>Wizyty</span>
        </NavLink>
        <NavLink class="sidebar-link" href="clients">
            <i class="bi bi-people-fill"></i><span>Klienci</span>
        </NavLink>
        <NavLink class="sidebar-link" href="stats">
            <i class="bi bi-bar-chart-line-fill"></i><span>Statystyki</span>
        </NavLink>
        <NavLink class="sidebar-link" href="finance">
            <i class="bi bi-currency-dollar"></i><span>Finanse</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.Client">
        <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-fill"></i><span>Dashboard</span>
        </NavLink>
        <NavLink class="sidebar-link" href="my">
            <i class="bi bi-calendar-week-fill"></i><span>Mój grafik</span>
        </NavLink>
        <NavLink class="sidebar-link" href="sessions">
            <i class="bi bi-calendar-check"></i><span>Wizyty</span>
        </NavLink>
        <NavLink class="sidebar-link" href="my/measurements">
            <i class="bi bi-rulers"></i><span>Moje pomiary</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")">
        <div class="sidebar-divider"></div>
        <NavLink class="sidebar-link" href="trainer/availability">
            <i class="bi bi-clock-fill"></i><span>Dostępność</span>
        </NavLink>
        <NavLink class="sidebar-link" href="trainer/series">
            <i class="bi bi-repeat"></i><span>Serie wizyt</span>
        </NavLink>
        <NavLink class="sidebar-link" href="trainer/contacts">
            <i class="bi bi-people-fill"></i><span>Pary klientów</span>
        </NavLink>
        <NavLink class="sidebar-link" href="trainer/intro-config">
            <i class="bi bi-person-lines-fill"></i><span>Pierwsza wizyta</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.Admin">
        <div class="sidebar-divider"></div>
        <NavLink class="sidebar-link" href="admin/users">
            <i class="bi bi-shield-fill-check"></i><span>Administracja</span>
        </NavLink>
    </AuthorizeView>
</div>

<!-- Dev credit -->
<div style="padding:0 1rem .25rem;text-align:center">
    <a href="https://grabowski.app" target="_blank" rel="noopener noreferrer"
       style="font-size:.65rem;color:var(--bs-secondary-color);text-decoration:none;opacity:.6;transition:opacity .2s"
       onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='.6'">
        made by Patryk Grabowski
    </a>
</div>

<!-- Sidebar footer -->
<div class="sidebar-footer">
    <AuthorizeView>
        <Authorized>
            <a href="/Account/Manage" class="sidebar-user">
                <div class="sidebar-user-avatar">
                    @(_initials)
                </div>
                <span class="sidebar-user-name">@context.User.Identity?.Name</span>
            </a>
            <form action="Account/Logout" method="post" style="margin:0">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                <button type="submit" class="sidebar-logout">
                    <i class="bi bi-box-arrow-left"></i>Wyloguj
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink class="sidebar-link" href="Account/Login">
                <i class="bi bi-box-arrow-in-right"></i><span>Zaloguj</span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string? _currentUrl;
    private string? _logoPath;
    private string _companyName = "PTScheduler";
    private string _initials = "?";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        try
        {
            var branding = await BrandingService.GetAsync();
            _logoPath = branding.LogoPath;
            _companyName = branding.CompanyName ?? "PTScheduler";
        }
        catch { }

        if (AuthState is not null)
        {
            var auth = await AuthState;
            var name = auth.User.Identity?.Name ?? "";
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            _initials = parts.Length >= 2
                ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
                : name.Length > 0 ? name[0].ToString().ToUpper() : "?";
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
