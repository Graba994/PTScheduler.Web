@inject PTScheduler.Application.Interfaces.IBrandingService BrandingService
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode PTScheduler.Web.RenderModes.Server

@if (_show && _bannerEnabled)
{
    <div class="pwa-banner @(_mode == Mode.Ios ? "pwa-banner--ios" : "")" role="dialog" aria-label="Zainstaluj aplikację">
        <img class="pwa-banner-icon" src="@(_iconPath ?? "/icons/icon-96.png")" alt="" width="48" height="48" />
        <div class="pwa-banner-text">
            <div class="pwa-banner-title">@_title</div>
            @switch (_mode)
            {
                case Mode.Ios:
                    <div class="pwa-banner-body">
                        Naciśnij <span class="pwa-share-icon" title="Udostępnij"><i class="bi bi-box-arrow-up"></i></span>
                        i wybierz <strong>Dodaj do ekranu głównego</strong>
                    </div>
                    break;
                case Mode.Manual:
                    <div class="pwa-banner-body">
                        Otwórz menu przeglądarki <strong>⋮</strong> i wybierz <strong>Zainstaluj aplikację</strong>
                        albo <strong>Dodaj do ekranu głównego</strong>
                    </div>
                    break;
                default:
                    <div class="pwa-banner-body">@_body</div>
                    break;
            }
        </div>
        <div class="pwa-banner-actions">
            @if (_mode == Mode.Prompt)
            {
                <button class="btn btn-primary btn-sm" @onclick="InstallAsync">@_button</button>
            }
            <button class="btn btn-link btn-sm pwa-banner-close" @onclick="Dismiss" aria-label="Zamknij">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>
}

@code {
    private enum Mode { Prompt, Ios, Manual }

    private bool _show;
    private Mode _mode = Mode.Prompt;
    private bool _bannerEnabled = true;
    private string _title   = "Zainstaluj aplikację";
    private string _body    = "Dodaj do ekranu głównego — działa jak natywna, bez przeglądarki.";
    private string _button  = "Zainstaluj";
    private string? _iconPath;

    private DotNetObjectReference<PwaInstallBanner>? _ref;
    private CancellationTokenSource? _fallbackCts;

    // Ile czekamy na beforeinstallprompt, zanim pokażemy instrukcję ręczną. Chrome wysyła je
    // dopiero po spełnieniu warunków (HTTPS, interakcja + ~30 s na stronie), Firefox/Samsung
    // czasem wcale — bez tego baner na Androidzie mógł się nigdy nie pojawić.
    private static readonly TimeSpan ManualFallbackDelay = TimeSpan.FromSeconds(8);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var b = await BrandingService.GetAsync();
            _bannerEnabled = b.PwaBannerEnabled;
            var appName = b.CompanyName ?? "PTScheduler";
            _title    = !string.IsNullOrWhiteSpace(b.PwaBannerTitle)  ? b.PwaBannerTitle  : $"Zainstaluj {appName}";
            _body     = !string.IsNullOrWhiteSpace(b.PwaBannerBody)   ? b.PwaBannerBody   : _body;
            _button   = !string.IsNullOrWhiteSpace(b.PwaBannerButton) ? b.PwaBannerButton : _button;
            _iconPath = b.PwaIconPath;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_bannerEnabled) return;

        // Wyjątek JS (np. zablokowany localStorage) nie może zerwać połączenia Blazora.
        try
        {
            var env = await JS.InvokeAsync<string>("PTBanner.environment");
            if (env is "standalone" or "dismissed") return;

            if (env == "ios")
            {
                _mode = Mode.Ios;
                _show = true;
                StateHasChanged();
                return;
            }

            // Android / inne mobilne: przycisk „Zainstaluj”, gdy przeglądarka da zdarzenie;
            // w przeciwnym razie po chwili instrukcja z menu przeglądarki.
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("PTBanner.listen", _ref);
            // Komputer: baner tylko po zdarzeniu z przeglądarki, bez instrukcji ręcznej.
            if (_show || env == "desktop") return;

            _fallbackCts = new CancellationTokenSource();
            await Task.Delay(ManualFallbackDelay, _fallbackCts.Token);
            if (!_show)
            {
                _mode = Mode.Manual;
                _show = true;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        catch { }
    }

    [JSInvokable]
    public void OnInstallAvailable()
    {
        _fallbackCts?.Cancel();
        _mode = Mode.Prompt;
        _show = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task InstallAsync()
    {
        try
        {
            var accepted = await JS.InvokeAsync<bool>("triggerPwaInstall");
            if (accepted)
            {
                _show = false;
                await JS.InvokeVoidAsync("PTBanner.dismiss");
            }
        }
        catch { }
    }

    private async Task Dismiss()
    {
        _show = false;
        try { await JS.InvokeVoidAsync("PTBanner.dismiss"); } catch { }
    }

    public ValueTask DisposeAsync()
    {
        _fallbackCts?.Cancel();
        _fallbackCts?.Dispose();
        _ref?.Dispose();
        return ValueTask.CompletedTask;
    }
}
