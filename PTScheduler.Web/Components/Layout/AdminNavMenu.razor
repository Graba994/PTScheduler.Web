@inject PTScheduler.Application.Interfaces.IPermissionService Permission
@inject AuthenticationStateProvider AuthState
@inject EntitlementService Entitlements

@* Menu ustawień — te same grupy i nazwy co kafelki na stronie „Zarządzanie” (AdminMenu). *@
<nav class="manage-nav">
    <NavLink class="manage-nav-link manage-nav-standalone manage-nav-home" href="admin" Match="NavLinkMatch.All">
        <i class="bi bi-grid-1x2-fill"></i><span>Wszystkie ustawienia</span>
    </NavLink>

    @if (!_isHighestPlan && _access.IsOwner)
    {
        <NavLink class="manage-nav-link manage-nav-upgrade" href="admin/upgrade">
            <i class="bi bi-rocket-takeoff-fill"></i><span>Ulepsz plan</span>
        </NavLink>
    }

    @foreach (var group in AdminMenu.Groups)
    {
        var items = group.Items.Where(_access.Sees).ToList();
        if (items.Count == 0) continue;
        <div class="manage-nav-group">
            <div class="manage-nav-section">@group.Title</div>
            <div class="manage-nav-grid">
                @foreach (var item in items)
                {
                    <NavLink class="manage-nav-link" href="@item.Href">
                        <i class="bi @item.Icon"></i><span>@item.Title</span>
                        @if (item.PlanFlag is not null)
                        {
                            <PlanBadge Flag="@item.PlanFlag" RequiredPlan="@(item.PlanName ?? "Pro")" />
                        }
                    </NavLink>
                }
            </div>
        </div>
    }

    <NavLink class="manage-nav-link manage-nav-standalone" href="admin/feedback">
        <i class="bi bi-chat-heart"></i><span>Oceń aplikację</span>
    </NavLink>
</nav>

@code {
    private AdminAccess _access = new();
    private bool _isHighestPlan;

    protected override async Task OnInitializedAsync()
    {
        _isHighestPlan = Entitlements.Current.Id is "studio" or "unlimited";
        _access = await AdminAccess.LoadAsync(AuthState, Permission);
    }
}
