@page "/trainer/activity/{ClientId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Trainer + "," + Roles.Subordinate)]
@inject IWorkoutLogService WorkoutLog
@inject IClientService ClientService
@inject ISurveyService Surveys
@inject AuthenticationStateProvider AuthState
@inject ILoggerFactory LoggerFactory
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="@(_client is null ? "Dziennik treningów" : $"Dziennik — {_client.FullName}")" />

<FeatureGate Flag="TrainingPlansEnabled" RequiredPlan="Pro" Title="Moduł treningowy">

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/trainer/activity">Aktywność</a></li>
        <li class="breadcrumb-item active">@(_client?.FullName ?? "Klient")</li>
    </ol>
</nav>

@if (_loading)
{
    <div class="text-center text-muted py-5"><div class="spinner-border"></div></div>
}
else if (_client is null)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Nie znaleziono klienta albo nie masz do niego dostępu.</div>
}
else
{
    <div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h4 class="page-title mb-0"><i class="bi bi-journal-text me-2" style="color:var(--c-primary)"></i>Dziennik treningów — @_client.FullName</h4>
        <a href="@($"/clients/{_client.Id}")" class="btn btn-sm btn-outline-primary"><i class="bi bi-person me-1"></i>Profil</a>
    </div>

    @if (_journal.Count == 0)
    {
        <div class="alert alert-secondary"><i class="bi bi-inbox me-2"></i>Klient nie zapisał jeszcze żadnego treningu.</div>
    }
    else
    {
        <p class="text-muted small">Rozwiń dzień, żeby zobaczyć serie i dodać komentarz — klient dostanie powiadomienie.</p>
        <WorkoutJournal ClientId="_client.Id" Days="_journal" AsTrainer="true" CurrentUserId="@_userId" Surveys="_surveys" />
    }
}
</FeatureGate>

@code {
    [Parameter] public int ClientId { get; set; }

    private bool _loading = true;
    private ClientDto? _client;
    private List<WorkoutJournalDayDto> _journal = [];
    private string _userId = string.Empty;
    private Dictionary<DateOnly, PTScheduler.Application.Surveys.SurveyResponseDto> _surveys = [];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            var isAdmin = auth.User.IsInRole(Roles.Admin);

            var client = await ClientService.GetClientAsync(ClientId);
            _client = client is not null && (isAdmin || client.TrainerUserId == _userId) ? client : null;
            _journal = _client is null ? [] : await WorkoutLog.GetJournalAsync(_client.Id, 30);
            _surveys = _client is null ? [] : await Surveys.GetPostWorkoutByDateAsync(_client.Id, 120);
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger("ClientJournal").LogError(ex, "Błąd ładowania dziennika klienta.");
        }
        _loading = false;
    }
}
