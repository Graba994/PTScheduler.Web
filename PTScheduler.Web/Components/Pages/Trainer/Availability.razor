@page "/trainer/availability"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@inject ITrainerAvailabilityService AvailabilityService
@inject IAuditLogService AuditLogService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ILogger<Availability> Logger
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Godziny pracy" />

<SetupGuideBar />

<div class="set-head">
    <div>
        <h4 class="set-title"><i class="bi bi-clock-fill"></i>Godziny pracy</h4>
        <p class="set-sub">Ustaw, kiedy przyjmujesz klientów. W aplikacji zobaczą tylko wolne terminy z tych godzin — rezerwują sami, bez pisania do Ciebie.</p>
    </div>
    @if (!_loading)
    {
        <div class="av-summary">
            <span><b>@WeeklyHours.ToString("0.#")</b> h w tygodniu</span>
            <span><b>@WorkDays</b> @Pl(WorkDays, "dzień", "dni", "dni") pracy</span>
        </div>
    }
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_messageOk ? "alert-success" : "alert-danger") py-2 small d-flex align-items-center gap-2">
            <i class="bi @(_messageOk ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>@_message
        </div>
    }

    <!-- ===== Tydzień ===== -->
    <section class="av-card">
        <div class="av-card-head">
            <h5><i class="bi bi-calendar-week"></i>Twój tydzień</h5>
            <InfoTip Title="Jak działa tydzień?" Text="Godziny powtarzają się co tydzień. W jednym dniu możesz mieć kilka przedziałów, np. 7:00–11:00 i 16:00–20:00. Wstrzymany przedział (ikona pauzy) nie znika — po prostu klienci chwilowo nie mogą się na niego zapisać." />
        </div>

        <div class="av-templates">
            <span class="av-templates-label"><i class="bi bi-magic"></i>Szybki start:</span>
            @foreach (var t in Templates)
            {
                <button type="button" class="av-template" @onclick="() => ApplyTemplateAsync(t)"><b>@t.Name</b><small>@t.Hint</small></button>
            }
        </div>

        <ul class="av-days">
            @foreach (var day in WeekDays)
            {
                var windows = _rules.Where(r => r.IsRecurring && r.DayOfWeek == day).OrderBy(r => r.StartTime).ToList();
                var isAdding = _addingDay == day;
                <li class="av-day @(windows.Any(w => w.IsActive) ? "on" : "off")">
                    <div class="av-day-name">
                        <b>@DayShort(day)</b><span>@DayName(day)</span>
                    </div>
                    <div class="av-day-windows">
                        @if (windows.Count == 0 && !isAdding)
                        {
                            <span class="av-free">Wolne</span>
                        }
                        @foreach (var w in windows)
                        {
                            <span class="av-window @(w.IsActive ? "" : "paused")" title="@(w.IsActive ? "" : "Wstrzymane — klienci nie widzą tych godzin")">
                                <span class="av-window-time">@w.StartTime.ToString("HH:mm")–@w.EndTime.ToString("HH:mm")</span>
                                @if (!string.IsNullOrWhiteSpace(w.Label)) { <span class="av-window-label">@w.Label</span> }
                                @if (w.ValidFrom.HasValue || w.ValidUntil.HasValue)
                                {
                                    <span class="av-window-label"><i class="bi bi-calendar-range"></i>@($"{w.ValidFrom?.ToString("dd.MM") ?? "…"}–{w.ValidUntil?.ToString("dd.MM") ?? "…"}")</span>
                                }
                                <button type="button" class="av-icon-btn" title="@(w.IsActive ? "Wstrzymaj" : "Wznów")" aria-label="@(w.IsActive ? "Wstrzymaj" : "Wznów")" @onclick="() => ToggleActiveAsync(w)">
                                    <i class="bi @(w.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                </button>
                                <button type="button" class="av-icon-btn danger" title="Usuń" aria-label="Usuń" @onclick="() => DeleteRuleAsync(w)"><i class="bi bi-x-lg"></i></button>
                            </span>
                        }
                        @if (isAdding)
                        {
                            <div class="av-add">
                                <TimePicker @bind-Value="_newStart" Small="true" />
                                <span class="text-muted">–</span>
                                <TimePicker @bind-Value="_newEnd" Small="true" />
                                <input class="form-control form-control-sm av-add-label" placeholder="Miejsce (opcjonalnie)" maxlength="60" @bind="_newLabel" />
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => AddRecurringAsync(day)"><i class="bi bi-check-lg me-1"></i>Dodaj</button>
                                <button type="button" class="btn btn-sm btn-link text-muted" @onclick="() => _addingDay = null">Anuluj</button>
                                <details class="av-more">
                                    <summary>Tylko w określonym okresie</summary>
                                    <div class="d-flex gap-2 flex-wrap mt-2 align-items-center">
                                        <label class="small">od <input type="date" class="form-control form-control-sm d-inline-block w-auto" @bind="_newValidFrom" /></label>
                                        <label class="small">do <input type="date" class="form-control form-control-sm d-inline-block w-auto" @bind="_newValidUntil" /></label>
                                    </div>
                                </details>
                            </div>
                        }
                    </div>
                    <div class="av-day-actions">
                        @if (!isAdding)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartAdding(day)"><i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline ms-1">Godziny</span></button>
                        }
                        @if (windows.Count > 0 && !isAdding)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Skopiuj na pozostałe dni robocze" aria-label="Skopiuj na pozostałe dni robocze" @onclick="() => CopyToWeekdaysAsync(day)"><i class="bi bi-copy"></i></button>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- ===== Wyjątki ===== -->
    <section class="av-card">
        <div class="av-card-head">
            <h5><i class="bi bi-calendar-plus"></i>Dodatkowe terminy</h5>
            <InfoTip Title="Dodatkowe terminy" Text="Jednorazowe godziny poza zwykłym tygodniem — np. wyjątkowo sobota rano albo zastępstwo za inny dzień. Obowiązują tylko w wybranym dniu." />
        </div>
        @{
            var extras = _rules.Where(r => !r.IsRecurring).OrderBy(r => r.SpecificDate).ThenBy(r => r.StartTime).ToList();
        }
        @if (extras.Count > 0)
        {
            <div class="av-day-windows mb-3">
                @foreach (var w in extras)
                {
                    <span class="av-window @(w.IsActive ? "" : "paused")">
                        <span class="av-window-time">@w.SpecificDate?.ToString("dd.MM") · @w.StartTime.ToString("HH:mm")–@w.EndTime.ToString("HH:mm")</span>
                        @if (!string.IsNullOrWhiteSpace(w.Label)) { <span class="av-window-label">@w.Label</span> }
                        <button type="button" class="av-icon-btn danger" title="Usuń" aria-label="Usuń" @onclick="() => DeleteRuleAsync(w)"><i class="bi bi-x-lg"></i></button>
                    </span>
                }
            </div>
        }
        <div class="av-add av-add-inline">
            <input type="date" class="form-control form-control-sm w-auto" @bind="_extraDate" aria-label="Data" />
            <TimePicker @bind-Value="_extraStart" Small="true" />
            <span class="text-muted">–</span>
            <TimePicker @bind-Value="_extraEnd" Small="true" />
            <input class="form-control form-control-sm av-add-label" placeholder="Miejsce (opcjonalnie)" maxlength="60" @bind="_extraLabel" />
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddExtraAsync"><i class="bi bi-plus-lg me-1"></i>Dodaj termin</button>
        </div>
    </section>

    <!-- ===== Zasady rezerwacji ===== -->
    <section class="av-card">
        <div class="av-card-head">
            <h5><i class="bi bi-sliders"></i>Zasady rezerwacji</h5>
            <span class="av-saved @(_configSaved ? "show" : "")" aria-live="polite"><i class="bi bi-check-circle-fill"></i>Zapisano</span>
        </div>

        <div class="av-rules">
            <div class="av-rule">
                <div class="av-rule-label">Przerwa po treningu <InfoTip Title="Przerwa po treningu" Text="Czas wolny dodawany po każdym treningu — na dojazd, przygotowanie sali albo chwilę oddechu. Klient nie zarezerwuje kolejnego treningu od razu po poprzednim." /></div>
                <div class="av-seg">
                    @foreach (var m in new[] { 0, 5, 10, 15, 30 })
                    {
                        <button type="button" class="@(_cfg.BreakAfterSessionMinutes == m ? "active" : "")" @onclick="() => SetConfig(c => c.BreakAfterSessionMinutes = m)">@(m == 0 ? "Bez przerwy" : $"{m} min")</button>
                    }
                </div>
            </div>

            <div class="av-rule">
                <div class="av-rule-label">Terminy co <InfoTip Title="Terminy co…" Text="Co ile minut klient widzi możliwe godziny rozpoczęcia. Przy 30 min: 8:00, 8:30, 9:00… Przy 60 min grafik jest prostszy, przy 15 min — więcej możliwości." /></div>
                <div class="av-seg">
                    @foreach (var m in new[] { 15, 30, 45, 60 })
                    {
                        <button type="button" class="@(_cfg.SlotGranularityMinutes == m ? "active" : "")" @onclick="() => SetConfig(c => c.SlotGranularityMinutes = m)">@m min</button>
                    }
                </div>
            </div>

            <div class="av-rule">
                <div class="av-rule-label">Bezpłatne odwołanie <InfoTip Title="Bezpłatne odwołanie" Text="Do ilu godzin przed treningiem klient może sam odwołać wizytę bez konsekwencji. Najczęściej trenerzy ustawiają 24 h." /></div>
                <div class="av-seg">
                    @foreach (var h in new[] { 0, 6, 12, 24, 48 })
                    {
                        <button type="button" class="@(_cfg.CancellationWindowHours == h ? "active" : "")" @onclick="() => SetConfig(c => c.CancellationWindowHours = h)">@(h == 0 ? "Zawsze" : $"{h} h przed")</button>
                    }
                </div>
            </div>

            @if (_cfg.CancellationWindowHours > 0)
            {
                <div class="av-rule">
                    <div class="av-rule-label">Gdy klient odwoła później <InfoTip Title="Późne odwołanie" Text="Co się dzieje, gdy klient odwołuje po czasie. Standard w treningu personalnym: trening przepada (schodzi z pakietu), bo zarezerwowany czas trudno komuś oddać." /></div>
                    <div class="av-choices">
                        @foreach (var (policy, title, hint) in Policies)
                        {
                            <button type="button" class="av-choice @(_cfg.LateCancellationPolicy == policy ? "active" : "")" @onclick="() => SetConfig(c => c.LateCancellationPolicy = policy)">
                                <b>@title</b><small>@hint</small>
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="av-rule av-rule-switch">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="noShow" checked="@_cfg.NoShowChargesSession"
                           @onchange="e => SetConfig(c => c.NoShowChargesSession = e.Value is true)" />
                    <label class="form-check-label fw-semibold" for="noShow">Nieobecność bez odwołania = trening przepada</label>
                </div>
                <InfoTip Title="Nieobecność" Text="Gdy klient nie przyjdzie i nie odwoła, oznaczasz wizytę jako „nieobecność”. Wtedy trening schodzi z pakietu tak, jakby się odbył." />
            </div>

            <div class="av-rule av-rule-switch">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="peers" checked="@_cfg.AllowClientsDiscoverPeers"
                           @onchange="e => SetConfig(c => c.AllowClientsDiscoverPeers = e.Value is true)" />
                    <label class="form-check-label fw-semibold" for="peers">Klienci widzą innych klientów</label>
                </div>
                <InfoTip Title="Lista klientów" Text="Przydaje się, gdy prowadzisz treningi w parach lub małych grupach — klient może zaprosić znajomego ćwiczącego u Ciebie. Domyślnie wyłączone (prywatność)." />
            </div>
        </div>

        <div class="av-preview">
            <i class="bi bi-eye"></i>
            <div><b>Tak zobaczą to klienci:</b> @PTScheduler.Application.Scheduling.CancellationRules.Describe(_cfg)</div>
        </div>
    </section>
}

@code {
    private string _trainerUserId = string.Empty;
    private string _trainerEmail = string.Empty;
    private string _trainerRole = string.Empty;
    private List<TrainerAvailabilityDto> _rules = [];
    private TrainerConfigDto _cfg = new();
    private bool _loading = true;
    private bool _configSaved;
    private string? _message;
    private bool _messageOk;
    private CancellationTokenSource? _savedCts;

    private DayOfWeek? _addingDay;
    private TimeOnly _newStart = new(8, 0);
    private TimeOnly _newEnd = new(16, 0);
    private string? _newLabel;
    private DateOnly? _newValidFrom;
    private DateOnly? _newValidUntil;

    private DateOnly? _extraDate;
    private TimeOnly _extraStart = new(9, 0);
    private TimeOnly _extraEnd = new(13, 0);
    private string? _extraLabel;

    private static readonly DayOfWeek[] WeekDays =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];
    private static readonly DayOfWeek[] Workdays = WeekDays[..5];

    private sealed record Template(string Name, string Hint, DayOfWeek[] Days, (TimeOnly From, TimeOnly To)[] Windows);

    private static readonly Template[] Templates =
    [
        new("Dni robocze", "Pn–Pt 8:00–16:00", Workdays, [(new(8, 0), new(16, 0))]),
        new("Cały dzień", "Pn–Pt 7:00–20:00", Workdays, [(new(7, 0), new(20, 0))]),
        new("Rano i wieczorem", "Pn–Pt 7–11 i 16–20", Workdays, [(new(7, 0), new(11, 0)), (new(16, 0), new(20, 0))]),
        new("Weekend", "Sb–Nd 9:00–14:00", [DayOfWeek.Saturday, DayOfWeek.Sunday], [(new(9, 0), new(14, 0))])
    ];

    private static readonly (LateCancellationPolicy Policy, string Title, string Hint)[] Policies =
    [
        (LateCancellationPolicy.ChargeSession, "Trening przepada", "Klient może odwołać, ale sesja schodzi z pakietu"),
        (LateCancellationPolicy.Block, "Tylko przez kontakt", "Klient musi napisać do Ciebie — Ty decydujesz"),
        (LateCancellationPolicy.Refund, "Bez konsekwencji", "Klient odwołuje, sesja wraca do pakietu")
    ];

    private double WeeklyHours => _rules.Where(r => r.IsRecurring && r.IsActive).Sum(r => (r.EndTime - r.StartTime).TotalHours);
    private int WorkDays => _rules.Where(r => r.IsRecurring && r.IsActive).Select(r => r.DayOfWeek).Distinct().Count();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _trainerUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _trainerEmail = auth.User.Identity?.Name ?? _trainerUserId;
        _trainerRole = auth.User.IsInRole(Roles.Admin) ? Roles.Admin
                     : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer : Roles.Subordinate;
        _rules = await AvailabilityService.GetAvailabilityRulesAsync(_trainerUserId);
        _cfg = await AvailabilityService.GetConfigAsync(_trainerUserId);
        _loading = false;
    }

    private void StartAdding(DayOfWeek day)
    {
        _addingDay = day;
        // Podpowiedź: po ostatnim przedziale tego dnia albo 8:00–16:00.
        var last = _rules.Where(r => r.IsRecurring && r.DayOfWeek == day).OrderBy(r => r.EndTime).LastOrDefault();
        if (last is null || last.EndTime >= new TimeOnly(20, 0))
        {
            _newStart = new(8, 0);
            _newEnd = last is null ? new(16, 0) : new(12, 0);
        }
        else
        {
            _newStart = last.EndTime.AddHours(1);
            _newEnd = _newStart.AddHours(3) > new TimeOnly(23, 0) || _newStart.AddHours(3) < _newStart ? new(23, 0) : _newStart.AddHours(3);
        }
        _newLabel = null;
        _newValidFrom = null;
        _newValidUntil = null;
        _message = null;
    }

    private async Task AddRecurringAsync(DayOfWeek day)
    {
        if (await AddWindowAsync(day, null, _newStart, _newEnd, _newLabel, _newValidFrom, _newValidUntil))
            _addingDay = null;
    }

    private async Task AddExtraAsync()
    {
        if (_extraDate is null) { Fail("Wybierz dzień dodatkowego terminu."); return; }
        if (await AddWindowAsync(null, _extraDate, _extraStart, _extraEnd, _extraLabel, null, null))
        {
            _extraLabel = null;
            _extraDate = null;
        }
    }

    /// <summary>Dodaje przedział po sprawdzeniu godzin i nakładania się na istniejące.</summary>
    private async Task<bool> AddWindowAsync(DayOfWeek? day, DateOnly? date, TimeOnly from, TimeOnly to, string? label,
        DateOnly? validFrom, DateOnly? validUntil, bool reload = true)
    {
        _message = null;
        if (from >= to) { Fail("Godzina końca musi być późniejsza niż początek."); return false; }
        var clash = _rules.FirstOrDefault(r => r.IsActive
            && (day is not null ? r.DayOfWeek == day : r.SpecificDate == date)
            && r.StartTime < to && from < r.EndTime);
        if (clash is not null) { Fail($"Nakłada się na {clash.StartTime:HH:mm}–{clash.EndTime:HH:mm} — zmień godziny albo usuń tamten przedział."); return false; }
        try
        {
            var added = await AvailabilityService.AddRuleAsync(new CreateTrainerAvailabilityDto
            {
                TrainerUserId = _trainerUserId,
                DayOfWeek = day,
                SpecificDate = date,
                StartTime = from,
                EndTime = to,
                ValidFrom = validFrom,
                ValidUntil = validUntil,
                Label = string.IsNullOrWhiteSpace(label) ? null : label.Trim()
            });
            await AuditLogService.LogAsync(_trainerUserId, _trainerEmail, _trainerRole, "AvailabilityRuleAdded", "TrainerAvailability",
                added.Id.ToString(), $"{(day is { } d ? DayName(d) : date?.ToString("dd.MM.yyyy"))}: {from:HH:mm}–{to:HH:mm}");
            if (reload) _rules = await AvailabilityService.GetAvailabilityRulesAsync(_trainerUserId);
            else _rules.Add(added);
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się dodać godzin pracy.");
            Fail("Nie udało się zapisać — spróbuj ponownie.");
            return false;
        }
    }

    private async Task ApplyTemplateAsync(Template t)
    {
        var existing = _rules.Where(r => r.IsRecurring && t.Days.Contains(r.DayOfWeek!.Value)).ToList();
        if (existing.Count > 0 && !await JS.InvokeAsync<bool>("confirm",
                $"Szablon „{t.Name}” zastąpi obecne godziny w wybranych dniach ({string.Join(", ", t.Days.Select(DayShort))}). Kontynuować?"))
            return;
        foreach (var r in existing) await AvailabilityService.DeleteRuleAsync(r.Id);
        _rules.RemoveAll(r => existing.Contains(r));
        foreach (var day in t.Days)
            foreach (var (from, to) in t.Windows)
                await AddWindowAsync(day, null, from, to, null, null, null, reload: false);
        _rules = await AvailabilityService.GetAvailabilityRulesAsync(_trainerUserId);
        Ok($"Ustawiono „{t.Name}”: {t.Hint}. Możesz jeszcze poprawić pojedyncze dni.");
    }

    private async Task CopyToWeekdaysAsync(DayOfWeek source)
    {
        var windows = _rules.Where(r => r.IsRecurring && r.DayOfWeek == source).ToList();
        var targets = Workdays.Where(d => d != source).ToList();
        var busy = targets.Where(d => _rules.Any(r => r.IsRecurring && r.DayOfWeek == d)).ToList();
        if (busy.Count > 0 && !await JS.InvokeAsync<bool>("confirm",
                $"Skopiować godziny z dnia {DayName(source).ToLowerInvariant()} na pozostałe dni robocze? Obecne godziny w: {string.Join(", ", busy.Select(DayShort))} zostaną zastąpione."))
            return;
        foreach (var r in _rules.Where(r => r.IsRecurring && targets.Contains(r.DayOfWeek!.Value)).ToList())
        {
            await AvailabilityService.DeleteRuleAsync(r.Id);
            _rules.Remove(r);
        }
        foreach (var day in targets)
            foreach (var w in windows)
                await AddWindowAsync(day, null, w.StartTime, w.EndTime, w.Label, w.ValidFrom, w.ValidUntil, reload: false);
        _rules = await AvailabilityService.GetAvailabilityRulesAsync(_trainerUserId);
        Ok($"Skopiowano godziny na: {string.Join(", ", targets.Select(DayShort))}.");
    }

    private async Task DeleteRuleAsync(TrainerAvailabilityDto rule)
    {
        await AvailabilityService.DeleteRuleAsync(rule.Id);
        await AuditLogService.LogAsync(_trainerUserId, _trainerEmail, _trainerRole, "AvailabilityRuleDeleted", "TrainerAvailability",
            rule.Id.ToString(), $"{(rule.DayOfWeek is { } d ? DayName(d) : rule.SpecificDate?.ToString("dd.MM.yyyy"))}: {rule.StartTime:HH:mm}–{rule.EndTime:HH:mm}");
        _rules.Remove(rule);
        _message = null;
    }

    private async Task ToggleActiveAsync(TrainerAvailabilityDto rule)
    {
        await AvailabilityService.SetActiveAsync(rule.Id, !rule.IsActive);
        await AuditLogService.LogAsync(_trainerUserId, _trainerEmail, _trainerRole, "AvailabilityRuleToggled", "TrainerAvailability",
            rule.Id.ToString(), $"Aktywny: {!rule.IsActive}");
        rule.IsActive = !rule.IsActive;
    }

    // Zasady zapisują się od razu po kliknięciu — bez osobnego przycisku „Zapisz”.
    private async Task SetConfig(Action<TrainerConfigDto> change)
    {
        change(_cfg);
        await AvailabilityService.SaveConfigAsync(_trainerUserId, _cfg);
        await AuditLogService.LogAsync(_trainerUserId, _trainerEmail, _trainerRole, "AvailabilityConfigSaved", "TrainerConfig",
            null, $"Przerwa: {_cfg.BreakAfterSessionMinutes}min, terminy co: {_cfg.SlotGranularityMinutes}min, odwołanie: {_cfg.CancellationWindowHours}h");
        _configSaved = true;
        _savedCts?.Cancel();
        var cts = _savedCts = new CancellationTokenSource();
        _ = Task.Delay(2000, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _configSaved = false;
            InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    private void Ok(string text) { _messageOk = true; _message = text; }
    private void Fail(string text) { _messageOk = false; _message = text; }

    private static string Pl(int n, string one, string few, string many) =>
        n == 1 ? one : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? few : many;

    private static string DayShort(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Pn", DayOfWeek.Tuesday => "Wt", DayOfWeek.Wednesday => "Śr", DayOfWeek.Thursday => "Cz",
        DayOfWeek.Friday => "Pt", DayOfWeek.Saturday => "Sb", _ => "Nd"
    };

    private static string DayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Poniedziałek",
        DayOfWeek.Tuesday => "Wtorek",
        DayOfWeek.Wednesday => "Środa",
