    {
        ExerciseCategory.Strength => "Siła",
        ExerciseCategory.Stretching => "Rozciąganie",
        ExerciseCategory.Plyometrics => "Pliometria",
        ExerciseCategory.Strongman => "Strongman",
        ExerciseCategory.Powerlifting => "Trójbój siłowy",
        ExerciseCategory.Cardio => "Cardio",
        ExerciseCategory.OlympicWeightlifting => "Podnoszenie olimpijskie",
        _ => "Inne"
    };

    private static string LevelPl(ExerciseLevel l) => l switch
    {
        ExerciseLevel.Beginner => "Początkujący",
        ExerciseLevel.Intermediate => "Średniozaawansowany",
        ExerciseLevel.Expert => "Zaawansowany",
        _ => l.ToString()
    };

    private static string? YtEmbed(string? r)
    {
        if (string.IsNullOrWhiteSpace(r)) return null;
        r = r.Trim();
        string? id = null;
        if (r.Contains("youtube.com", StringComparison.OrdinalIgnoreCase))
        {
            var i = r.IndexOf("v=", StringComparison.OrdinalIgnoreCase);
            if (i >= 0) { id = r[(i + 2)..]; var amp = id.IndexOf('&'); if (amp >= 0) id = id[..amp]; }
        }
        else if (r.Contains("youtu.be/", StringComparison.OrdinalIgnoreCase))
        {
            id = r[(r.IndexOf("youtu.be/", StringComparison.OrdinalIgnoreCase) + 9)..];
            var q = id.IndexOf('?'); if (q >= 0) id = id[..q];
        }
        else if (!r.Contains('/') && !r.Contains(' '))
        {
            id = r; // samo ID
        }
        return string.IsNullOrWhiteSpace(id) ? null : $"https://www.youtube.com/embed/{id}";
    }
