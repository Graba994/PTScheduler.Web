@code {
    private string _userId = string.Empty;
    private string? _ownDesc;
    private bool _ownBusy;
    private bool _ownSaved;

    private async Task SaveOwnAsync()
    {
        if (_detail is null) return;
        await Catalog.SetTrainerDescriptionAsync(_userId, _detail.Id, _ownDesc);
        _detail.TrainerDescription = string.IsNullOrWhiteSpace(_ownDesc) ? null : _ownDesc.Trim();
        _ownSaved = true;
    }

    /// <summary>Krótsza, prostsza wersja opisu z katalogu (AI pod marką trenera, bez AI — pierwsze kroki z katalogu).</summary>
    private async Task SimplifyAsync()
    {
        if (_detail?.DescriptionPl is not { Length: > 0 } source) return;
        _ownBusy = true;
        try
        {
            var steps = source.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4).ToList();
            var fallback = string.Join("\n", steps);
            if (fallback.Length > 560) fallback = fallback[..560];
            var cfg = await Platform.GetConfigAsync();
            var text = await Platform.PhraseAsync($"opis-{_detail.Id}-{Guid.NewGuid():N}", "opis_cwiczenia",
                new Dictionary<string, string> { ["cwiczenie"] = _detail.NamePl.Length <= 80 ? _detail.NamePl : _detail.NamePl[..80] }, fallback, cfg?.Ai == true, audience: "klient");
            _ownDesc = text;
            _ownSaved = false;
        }
        finally { _ownBusy = false; }
    }
    // ── Społeczność, wgrywanie filmów ──
    private bool _community;
    private bool _communityLoading;
    private PTScheduler.Web.Services.CommunityExerciseClient.Page _communityPage = new(false, [], []);
    private PTScheduler.Web.Services.CommunityExerciseClient.Item? _communityDetail;
    private HashSet<int> _sharedIds = [];
    private bool _copyBusy;
    private string? _copyMsg;
    private bool _shareOpen;
    private bool _shareConsent;
    private bool _shareAuthor = true;
    private bool _shareBusy;
    private string? _shareError;
    private ExerciseMediaFields? _media;
    private bool _showEnFields;

    /// <summary>Wgrywanie filmów i Społeczność — tylko w pakiecie z wideo (Bunny).</summary>
    private bool VideoPlan => Entitlements.Current.VideoProvider == "bunny" && Entitlements.Current.MaxVideoStorageGB > 0;
    private static bool CommunityAvailable => PTScheduler.Web.Services.CommunityExerciseClient.Available;

    private async Task OpenCommunity()
    {
        _community = true;
        await LoadCommunityAsync();
    }

    private async Task LoadCommunityAsync()
    {
        if (!VideoPlan) return;
        _communityLoading = true;
        _communityPage = await Community.SearchAsync(_filter.Search, _filter.Muscle is { } m ? Muscles.ToCsv([m]) : null);
        _sharedIds = _communityPage.Shared.ToHashSet();
        _communityLoading = false;
    }

    private async Task CopyFromCommunity(PTScheduler.Web.Services.CommunityExerciseClient.Item item)
    {
        _copyBusy = true;
        _copyMsg = null;
        try
        {
            var c = await Community.CopyAsync(item.Id);
            if (c is null) { _copyMsg = "Nie udało się skopiować — spróbuj ponownie."; return; }
            var dto = new SaveExerciseDto
            {
                NamePl = c.NamePl,
                NameEn = c.NameEn,
                DescriptionPl = c.Description,
                PrimaryMuscles = Muscles.Parse(c.PrimaryMuscles).ToList(),
                SecondaryMuscles = Muscles.Parse(c.SecondaryMuscles).ToList(),
                Category = Enum.TryParse<ExerciseCategory>(c.Category, out var cat) ? cat : ExerciseCategory.Strength,
                Level = Enum.TryParse<ExerciseLevel>(c.Level, out var lvl) ? lvl : ExerciseLevel.Beginner,
                Equipment = c.Equipment,
                ImageUrls = c.ImageUrls.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList(),
                VideoType = Enum.TryParse<ExerciseVideoType>(c.VideoType, out var vt) ? vt : ExerciseVideoType.None,
                VideoRef = c.VideoRef,
                Tracking = Enum.TryParse<ExerciseTracking>(c.Tracking, out var tr) ? tr : ExerciseTracking.WeightReps,
                Attribution = c.AuthorName is { } a ? $"Społeczność: {a}" : "Społeczność trenerów"
            };
            await Catalog.CreateAsync(_userId, dto);
            _copyMsg = $"Dodano „{c.NamePl}” do Twoich ćwiczeń.";
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger("Exercises").LogError(ex, "Błąd kopiowania ze Społeczności.");
            _copyMsg = "Nie udało się skopiować — spróbuj ponownie.";
        }
        finally { _copyBusy = false; }
    }

    private async Task ShareDetail()
    {
        if (_detail is null || !_shareConsent) return;
        _shareBusy = true;
        _shareError = null;
        var images = _detail.ImageUrls.Select(u => Uri.TryCreate(u, UriKind.Absolute, out var abs) ? abs.ToString() : new Uri(new Uri(Nav.BaseUri), u.TrimStart('/')).ToString()).ToList();
        var (ok, err) = await Community.ShareAsync(new(_detail.Id, _detail.NamePl, _detail.NameEn,
            string.IsNullOrWhiteSpace(_detail.DescriptionPl) ? _detail.TrainerDescription : _detail.DescriptionPl,
            _detail.PrimaryMuscles, _detail.SecondaryMuscles, _detail.Category.ToString(), _detail.Level.ToString(), _detail.Equipment,
            _detail.Force, _detail.Mechanic, _detail.Tracking.ToString(), images, _detail.VideoType.ToString(), _detail.VideoRef, _shareAuthor, true));
        _shareBusy = false;
        if (!ok) { _shareError = err; return; }
        _sharedIds.Add(_detail.Id);
        _shareOpen = false;
    }

    private async Task UnshareDetail()
    {
        if (_detail is null) return;
        _shareBusy = true;
        if (await Community.UnshareAsync(_detail.Id)) _sharedIds.Remove(_detail.Id);
        _shareBusy = false;
    }

    private async Task CancelEdit()
    {
        // Zdjęcia i film wgrane do ćwiczenia, którego nie zapisano, nie mogą zajmować opłaconego miejsca.
        if (_media is not null) await _media.DiscardAsync();
        _showEdit = false;
    }

    private readonly ExerciseFilterDto _filter = new();
    private List<ExerciseListItemDto> _items = [];
    private List<string> _equipment = [];
    private bool _loading = true;

    private ExerciseDetailDto? _detail;
    private bool _showDetail;
    private bool _showEn;

    private bool _showEdit;
    private SaveExerciseDto _form = new();
    private string? _editError;
    private bool _saving;

    private readonly (ExerciseCatalogScope, string, string)[] _scopes =
    [
        (ExerciseCatalogScope.All, "Wszystkie", "bi-grid"),
        (ExerciseCatalogScope.Public, "Baza", "bi-globe"),
        (ExerciseCatalogScope.Mine, "Moje", "bi-person"),
        (ExerciseCatalogScope.Favorites, "Ulubione", "bi-star"),
        (ExerciseCatalogScope.Recent, "Ostatnie", "bi-clock-history")
    ];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _equipment = await Catalog.GetEquipmentOptionsAsync(_userId);
        await LoadAsync();
        // Znaczek „w Społeczności” przy własnych ćwiczeniach.
        if (VideoPlan && CommunityAvailable) _sharedIds = (await Community.SearchAsync(null, null)).Shared.ToHashSet();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Catalog.SearchAsync(_userId, _filter); }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger("Exercises").LogError(ex, "Błąd ładowania katalogu ćwiczeń.");
            _items = [];
        }
        _loading = false;
    }

    private async Task SetScope(ExerciseCatalogScope s) { _community = false; _filter.Scope = s; await LoadAsync(); }
    private async Task OnSearchInput(ChangeEventArgs e) { _filter.Search = e.Value?.ToString(); await (_community ? LoadCommunityAsync() : LoadAsync()); }
    private async Task OnMuscleChange(ChangeEventArgs e) { _filter.Muscle = Enum.TryParse<MuscleGroup>(e.Value?.ToString(), out var m) ? m : null; await (_community ? LoadCommunityAsync() : LoadAsync()); }
    private async Task OnCategoryChange(ChangeEventArgs e) { _filter.Category = Enum.TryParse<ExerciseCategory>(e.Value?.ToString(), out var c) ? c : null; await LoadAsync(); }
    private async Task OnLevelChange(ChangeEventArgs e) { _filter.Level = Enum.TryParse<ExerciseLevel>(e.Value?.ToString(), out var l) ? l : null; await LoadAsync(); }
    private async Task OnEquipmentChange(ChangeEventArgs e) { var v = e.Value?.ToString(); _filter.Equipment = string.IsNullOrEmpty(v) ? null : v; await LoadAsync(); }

    private async Task OpenDetail(int id)
    {
        _showEn = false;
        _detail = await Catalog.GetAsync(_userId, id);
        _ownDesc = _detail?.TrainerDescription;
        _ownSaved = false;
        _showDetail = _detail is not null;
    }
    private void CloseDetail() { _showDetail = false; _detail = null; _mmPicked = null; }

    private async Task ToggleFav(ExerciseListItemDto item)
    {
        try
        {
            item.IsFavorite = await Catalog.ToggleFavoriteAsync(_userId, item.Id);
            if (_filter.Scope == ExerciseCatalogScope.Favorites && !item.IsFavorite)
                await LoadAsync();
        }
        catch (Exception ex) { LoggerFactory.CreateLogger("Exercises").LogError(ex, "Błąd przełączania ulubionego."); }
    }

    private async Task ToggleFavDetail()
    {
        if (_detail is null) return;
        _detail.IsFavorite = await Catalog.ToggleFavoriteAsync(_userId, _detail.Id);
        var card = _items.FirstOrDefault(i => i.Id == _detail.Id);
        if (card is not null) card.IsFavorite = _detail.IsFavorite;
    }

    private void OpenCreate()
    {
        _form = new SaveExerciseDto();
        _editError = null;
        _showEnFields = false;
        _showEdit = true;
    }

    private void OpenEditFromDetail()
    {
        if (_detail is null) return;
        _form = new SaveExerciseDto
        {
            Id = _detail.Id,
            NamePl = _detail.NamePl,
            NameEn = _detail.NameEn,
            DescriptionPl = _detail.DescriptionPl,
            DescriptionEn = _detail.DescriptionEn,
            PrimaryMuscles = Muscles.Parse(_detail.PrimaryMuscles).ToList(),
            SecondaryMuscles = Muscles.Parse(_detail.SecondaryMuscles).ToList(),
            Category = _detail.Category,
            Level = _detail.Level,
            Equipment = _detail.Equipment,
            ImageUrls = _detail.ImageUrls.ToList(),
            VideoType = _detail.VideoType,
            VideoRef = _detail.VideoRef,
            Tracking = _detail.Tracking,
            Attribution = _detail.Attribution
        };
        _showEnFields = !string.IsNullOrWhiteSpace(_detail.DescriptionEn) || (!string.IsNullOrWhiteSpace(_detail.NameEn) && _detail.NameEn != _detail.NamePl);
        _editError = null;
        _showDetail = false;
        _showEdit = true;
    }

    private static bool IsHttpUrl(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var u) && u.Scheme == Uri.UriSchemeHttps;

    /// <summary>Ćwiczenie z katalogu jako własne — np. żeby dodać do niego film z YouTube.</summary>
    private void CopyDetailAsMine()
    {
        OpenEditFromDetail();
        _form.Id = null;
    }

    // Mapa mięśni (włącznik w Portalu → Konfiguracja → Usługi → Ćwiczenia).
    private bool MapOn => Entitlements.Current.MuscleMap;
    private bool _mmFemale;
    private MuscleGroup? _mmPicked;

    private void PickDetailMuscle(MuscleGroup m) => _mmPicked = _mmPicked == m ? null : m;

    private void ClearMuscles()
    {
        _form.PrimaryMuscles.Clear();
        _form.SecondaryMuscles.Clear();
    }

    /// <summary>Jedno kliknięcie zmienia stan: brak → główna → wspomagająca → brak.</summary>
    private void CycleMuscle(MuscleGroup m)
    {
        if (_form.PrimaryMuscles.Remove(m)) { _form.SecondaryMuscles.Add(m); return; }
        if (_form.SecondaryMuscles.Remove(m)) return;
        _form.PrimaryMuscles.Add(m);
    }

    private async Task Save()
    {
        _editError = null;
        if (string.IsNullOrWhiteSpace(_form.NamePl)) { _editError = "Podaj nazwę (PL)."; return; }
        if (_form.VideoType is ExerciseVideoType.YouTube or ExerciseVideoType.Url && string.IsNullOrWhiteSpace(_form.VideoRef))
            _form.VideoType = ExerciseVideoType.None;
        if (_form.VideoType == ExerciseVideoType.YouTube && ExerciseMediaFields.YouTubeId(_form.VideoRef) is null && _form.VideoRef!.Contains('/'))
        { _editError = "Nie rozpoznaję linku z YouTube — skopiuj adres filmu z paska przeglądarki albo z „Udostępnij”."; return; }
        if (_form.VideoType == ExerciseVideoType.Url && !IsHttpUrl(_form.VideoRef))
        { _editError = "Link do filmu musi zaczynać się od https://."; return; }
        _saving = true;
        try
        {
            if (_form.Id is null) await Catalog.CreateAsync(_userId, _form);
            else await Catalog.UpdateAsync(_userId, _form);
            // Pliki, które wypadły z ćwiczenia, zwalniają miejsce (jeśli nie używa ich inne ćwiczenie ani lekcja).
            if (_media is not null) await _media.CommitAsync();
            _showEdit = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
            LoggerFactory.CreateLogger("Exercises").LogError(ex, "Błąd zapisu ćwiczenia.");
        }
        finally { _saving = false; }
    }

    private async Task DeleteDetail()
    {
        if (_detail is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Usunąć ćwiczenie „{_detail.NamePl}\"?")) return;
        try
        {
            var video = _detail.VideoType == ExerciseVideoType.Bunny ? _detail.VideoRef : null;
            var images = _detail.ImageUrls.ToList();
            var id = _detail.Id;
            await Catalog.DeleteAsync(_userId, id);
            if (_sharedIds.Contains(id)) { await Community.UnshareAsync(id); _sharedIds.Remove(id); }
            await Media.DeleteVideoIfUnusedAsync(video);
            foreach (var url in images) await Media.DeleteImageIfUnusedAsync(url);
            CloseDetail();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }

