@page "/exercises"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@using PTScheduler.Domain.Rules
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Trainer + "," + Roles.Subordinate)]
@inject IExerciseCatalogService Catalog
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ILoggerFactory LoggerFactory
@inject PTScheduler.Web.Services.PlatformAssistantService Platform
@inject PTScheduler.Web.Services.CommunityExerciseClient Community
@inject IBunnyService Bunny
@inject ExerciseMediaService Media
@inject EntitlementService Entitlements
@inject NavigationManager Nav
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Katalog ćwiczeń" />

<FeatureGate Flag="TrainingPlansEnabled" RequiredPlan="Pro" Title="Moduł treningowy">

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h4 class="page-title mb-0"><i class="bi pt-ico-dumbbell me-2" style="color:var(--c-primary)"></i>Katalog ćwiczeń</h4>
    <button class="btn btn-sm btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg me-1"></i>Dodaj ćwiczenie</button>
</div>

<!-- Zakładki zakresu -->
<ul class="nav nav-pills gap-1 mb-3 flex-wrap">
    @foreach (var (scope, label, icon) in _scopes)
    {
        <li class="nav-item">
            <button class="nav-link py-1 px-3 @(!_community && _filter.Scope == scope ? "active" : "")"
                    @onclick="() => SetScope(scope)">
                <i class="bi @icon me-1"></i>@label
            </button>
        </li>
    }
    <li class="nav-item">
        <button class="nav-link py-1 px-3 @(_community ? "active" : "")" @onclick="OpenCommunity" title="Ćwiczenia udostępnione przez innych trenerów platformy">
            <i class="bi bi-people me-1"></i>Społeczność
            @if (!VideoPlan) { <i class="bi bi-lock-fill ms-1 small"></i> }
        </button>
    </li>
</ul>

<!-- Filtry -->
<div class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Szukaj (PL/EN)…" value="@_filter.Search"
                   @oninput="OnSearchInput" />
        </div>
    </div>
    <div class="col-6 col-md-2">
        <select class="form-select form-select-sm" @onchange="OnMuscleChange">
            <option value="">— partia —</option>
            @foreach (var m in Enum.GetValues<MuscleGroup>())
            {
                <option value="@m" selected="@(_filter.Muscle == m)">@Muscles.Label(m)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select class="form-select form-select-sm" @onchange="OnCategoryChange">
            <option value="">— kategoria —</option>
            @foreach (var c in Enum.GetValues<ExerciseCategory>())
            {
                <option value="@c" selected="@(_filter.Category == c)">@CategoryPl(c)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select class="form-select form-select-sm" @onchange="OnLevelChange">
            <option value="">— poziom —</option>
            @foreach (var l in Enum.GetValues<ExerciseLevel>())
            {
                <option value="@l" selected="@(_filter.Level == l)">@LevelPl(l)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select class="form-select form-select-sm" @onchange="OnEquipmentChange">
            <option value="">— sprzęt —</option>
            @foreach (var eq in _equipment)
            {
                <option value="@eq" selected="@(_filter.Equipment == eq)">@eq</option>
            }
        </select>
    </div>
</div>

@if (_community)
{
    @if (!VideoPlan)
    {
        <div class="community-gate">
            <i class="bi bi-people"></i>
            <div>
                <b>Społeczność jest w pakiecie z wideo</b>
                <p class="mb-2">Wspólna baza ćwiczeń trenerów platformy — z filmami i opisami, gotowa do skopiowania do Twojego katalogu.
                    Działa razem z hostingiem wideo, w ramach opłaconego miejsca.</p>
                <a href="/admin/upgrade" class="btn btn-sm btn-primary">Zobacz pakiety</a>
            </div>
        </div>
    }
    else if (_communityLoading)
    {
        <div class="text-center text-muted py-5"><div class="spinner-border" role="status"></div></div>
    }
    else if (!_communityPage.Allowed)
    {
        <div class="alert alert-info small"><i class="bi bi-info-circle me-1"></i>Społeczność jest teraz niedostępna — spróbuj za chwilę.</div>
    }
    else if (_communityPage.Items.Count == 0)
    {
        <div class="alert alert-secondary"><i class="bi bi-people me-2"></i>Brak ćwiczeń dla tych filtrów. Udostępnij swoje — otwórz własne ćwiczenie i kliknij „Udostępnij społeczności”.</div>
    }
    else
    {
        <div class="text-muted small mb-2">@_communityPage.Items.Count ćwiczeń od trenerów platformy</div>
        <div class="row g-3">
            @foreach (var c in _communityPage.Items)
            {
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="card h-100 exercise-card" @onclick="() => _communityDetail = c" style="cursor:pointer">
                        <div class="exercise-thumb">
                            @if (c.Thumbnail is { } th)
                            {
                                <img src="@th" alt="@c.NamePl" loading="lazy" />
                            }
                            else
                            {
                                <div class="exercise-thumb-empty"><i class="bi pt-ico-dumbbell"></i></div>
                            }
                            @if (c.VideoType != "None")
                            {
                                <span class="badge-video"><i class="bi bi-play-circle-fill"></i></span>
                            }
                            @if (c.Mine)
                            {
                                <span class="badge bg-primary badge-mine">moje</span>
                            }
                        </div>
                        <div class="card-body p-2">
                            <div class="fw-semibold small text-truncate" title="@c.NamePl">@c.NamePl</div>
                            <div class="text-muted text-truncate" style="font-size:.7rem">@(c.AuthorName ?? "Trener platformy")@(c.Copies > 0 ? $" · {c.Copies}× skopiowane" : "")</div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var m in Muscles.Parse(c.PrimaryMuscles).Take(3))
                                {
                                    <span class="badge bg-light text-dark border">@Muscles.Label(m)</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else if (_loading)
{
    <div class="text-center text-muted py-5"><div class="spinner-border" role="status"></div></div>
}
else if (_items.Count == 0)
{
    <div class="alert alert-secondary"><i class="bi bi-inbox me-2"></i>Brak ćwiczeń dla wybranych filtrów.</div>
}
else
{
    <div class="text-muted small mb-2">@_items.Count ćwiczeń</div>
    <div class="row g-3">
        @foreach (var e in _items)
        {
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card h-100 exercise-card" @onclick="() => OpenDetail(e.Id)" style="cursor:pointer">
                    <div class="exercise-thumb">
                        @if (!string.IsNullOrEmpty(e.ThumbnailUrl))
                        {
                            <img src="@e.ThumbnailUrl" alt="@e.NamePl" loading="lazy" />
                        }
                        else
                        {
                            <div class="exercise-thumb-empty"><i class="bi pt-ico-dumbbell"></i></div>
                        }
                        <button class="btn-fav @(e.IsFavorite ? "on" : "")" title="Interesujące mnie"
                                @onclick="() => ToggleFav(e)" @onclick:stopPropagation="true">
                            <i class="bi @(e.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                        @if (e.HasVideo)
                        {
                            <span class="badge-video"><i class="bi bi-play-circle-fill"></i></span>
                        }
                        @if (e.IsMine)
                        {
                            <span class="badge bg-primary badge-mine">@(_sharedIds.Contains(e.Id) ? "moje · w Społeczności" : "moje")</span>
                        }
                        @if (MapOn && Muscles.Parse(e.PrimaryMuscles) is { Count: > 0 } cardPrimary)
                        {
                            <span class="exercise-mm" aria-hidden="true">
                                <MuscleMap Primary="@cardPrimary" Secondary="@Muscles.Parse(e.SecondaryMuscles)" Female="@_mmFemale" Compact="true" OnlyActive="true" />
                            </span>
                        }
                    </div>
                    <div class="card-body p-2">
                        <div class="fw-semibold small text-truncate" title="@e.NamePl">@e.NamePl</div>
                        @if (!string.IsNullOrWhiteSpace(e.NameEn) && e.NameEn != e.NamePl)
                        {
                            <div class="text-muted text-truncate" style="font-size:.7rem" title="@e.NameEn">@e.NameEn</div>
                        }
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var m in Muscles.Parse(e.PrimaryMuscles).Take(3))
                            {
                                <span class="badge bg-light text-dark border">@Muscles.Label(m)</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ---------- Szczegóły ---------- *@
@if (_showDetail && _detail is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)" @onclick="CloseDetail">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @_detail.NamePl
                        @if (!string.IsNullOrWhiteSpace(_detail.NameEn) && _detail.NameEn != _detail.NamePl)
                        {
                            <small class="d-block text-muted fw-normal" style="font-size:.8rem">🇬🇧 @_detail.NameEn</small>
                        }
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm @(_detail.IsFavorite ? "btn-warning" : "btn-outline-warning")"
                                @onclick="() => ToggleFavDetail()">
                            <i class="bi @(_detail.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                        <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="row g-3 g-md-4">
                        <div class="col-12 col-md-5">
                            @if (_detail.ImageUrls.Count > 0)
                            {
                                <img src="@_detail.ImageUrls[0]" class="img-fluid rounded border mb-2" alt="@_detail.NamePl" />
                                @if (_detail.ImageUrls.Count > 1)
                                {
                                    <img src="@_detail.ImageUrls[1]" class="img-fluid rounded border" alt="@_detail.NamePl" />
                                }
                            }
                            else
                            {
                                <div class="exercise-thumb-empty rounded border" style="height:180px"><i class="bi pt-ico-dumbbell"></i></div>
                            }

                            @{ var yt = _detail.VideoType == ExerciseVideoType.YouTube ? YtEmbed(_detail.VideoRef) : null; }
                            @if (yt is not null)
                            {
                                <div class="ratio ratio-16x9 mt-2">
                                    <iframe src="@yt" title="Wideo" allowfullscreen loading="lazy"></iframe>
                                </div>
                            }
                            else if (_detail.VideoType == ExerciseVideoType.Url && IsHttpUrl(_detail.VideoRef))
                            {
                                <video class="w-100 rounded border mt-2" src="@_detail.VideoRef" controls muted playsinline preload="metadata"></video>
                            }
                            else if (_detail.VideoType == ExerciseVideoType.Bunny && !string.IsNullOrWhiteSpace(_detail.VideoRef))
                            {
                                <div class="mt-2"><VideoPlayer BunnyVideoId="@_detail.VideoRef" ShowPlaceholder="false" /></div>
                            }
                            @if (_detail.VideoType == ExerciseVideoType.None && !_detail.IsMine)
                            {
                                <div class="small text-muted mt-2">
                                    <i class="bi bi-camera-video me-1"></i>Katalog ma zdjęcia bez filmów.
                                    <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="CopyDetailAsMine">Zrób swoją wersję z filmem</button>
                                </div>
                            }
                        </div>
                        <div class="col-12 col-md-7">
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class="badge bg-secondary">@CategoryPl(_detail.Category)</span>
                                <span class="badge bg-secondary">@LevelPl(_detail.Level)</span>
                                <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-rulers me-1"></i>@ExerciseTrackingRules.Label(_detail.Tracking)</span>
                                @if (!string.IsNullOrWhiteSpace(_detail.Equipment))
                                {
                                    <span class="badge bg-secondary">@ExerciseLabels.Equipment(_detail.Equipment)</span>
                                }
                            </div>

                            @if (MapOn)
                            {
                                var dPrimary = Muscles.Parse(_detail.PrimaryMuscles);
                                var dSecondary = Muscles.Parse(_detail.SecondaryMuscles);
                                <div class="exd-muscles">
                                    <div class="exd-mm">
                                        <MuscleMap Primary="@dPrimary" Secondary="@dSecondary" Female="@_mmFemale" Picked="@_mmPicked" OnPick="PickDetailMuscle" />
                                    </div>
                                    <div class="exd-mside">
                                        <div class="exd-mhead">
                                            <span>Pracujące mięśnie</span>
                                            <MuscleSexToggle Female="@_mmFemale" FemaleChanged="v => _mmFemale = v" />
                                        </div>
                                        @if (dPrimary.Count == 0 && dSecondary.Count == 0)
                                        {
                                            <div class="small text-muted">Partie nie są jeszcze opisane.@(_detail.IsMine ? " Uzupełnij je w edycji ćwiczenia." : "")</div>
                                        }
                                        @if (dPrimary.Count > 0)
                                        {
                                            <div class="exd-mgroup">Główne</div>
                                        }
                                        @foreach (var m in dPrimary)
                                        {
                                            <button type="button" class="exd-mrow p @(_mmPicked == m ? "on" : "")" @onclick="() => PickDetailMuscle(m)"><i></i>@Muscles.Label(m)</button>
                                        }
                                        @if (dSecondary.Count > 0)
                                        {
                                            <div class="exd-mgroup">Pomocnicze</div>
                                        }
                                        @foreach (var m in dSecondary)
                                        {
                                            <button type="button" class="exd-mrow s @(_mmPicked == m ? "on" : "")" @onclick="() => PickDetailMuscle(m)"><i></i>@Muscles.Label(m)</button>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                            <div class="small text-muted mb-1">Partie główne</div>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var m in Muscles.Parse(_detail.PrimaryMuscles))
                                {
                                    <span class="badge bg-primary">@Muscles.Label(m)</span>
                                }
                                @if (Muscles.Parse(_detail.PrimaryMuscles).Count == 0)
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </div>

                            @if (Muscles.Parse(_detail.SecondaryMuscles).Count > 0)
                            {
                                <div class="small text-muted mb-1">Partie wspomagające</div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var m in Muscles.Parse(_detail.SecondaryMuscles))
                                    {
                                        <span class="badge bg-light text-dark border">@Muscles.Label(m)</span>
                                    }
                                </div>
                            }

                            }

                            <div class="ex-own mt-3">
                                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-1">
                                    <label class="small fw-semibold mb-0" for="ex-own">Moje wskazówki dla klientów</label>
                                    @if (!string.IsNullOrWhiteSpace(_detail.DescriptionPl))
                                    {
                                        <button type="button" class="btn btn-sm btn-link px-0" @onclick="SimplifyAsync" disabled="@_ownBusy">
                                            @if (_ownBusy) { <span class="spinner-border spinner-border-sm me-1"></span> } else { <i class="bi bi-magic me-1"></i> }
                                            Uprość opis z katalogu
                                        </button>
                                    }
                                </div>
                                <textarea id="ex-own" class="form-control form-control-sm" rows="4" @bind="_ownDesc" maxlength="2000"
                                          placeholder="Twoimi słowami, każdy krok w nowej linii — klienci zobaczą to w „Jak wykonać to ćwiczenie?” zamiast opisu z katalogu."></textarea>
                                <div class="d-flex gap-2 align-items-center mt-1">
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveOwnAsync"><i class="bi bi-check-lg me-1"></i>Zapisz wskazówki</button>
                                    @if (_ownSaved) { <span class="small text-success">Zapisane — klienci już je widzą.</span> }
                                </div>
                            </div>

                            <div class="small text-muted mb-1 mt-3">Jak wykonać (katalog)</div>
                            @{
                                var descPl = string.IsNullOrWhiteSpace(_detail.DescriptionPl) ? null : _detail.DescriptionPl;
                                var descEn = string.IsNullOrWhiteSpace(_detail.DescriptionEn) ? null : _detail.DescriptionEn;
                            }
                            @if (descPl is not null)
                            {
                                var steps = descPl.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                @if (steps.Length > 1)
                                {
                                    <ol class="small ps-3 mb-0 exercise-steps">
                                        @foreach (var step in steps) { <li>@step</li> }
                                    </ol>
                                }
                                else
                                {
                                    <div class="small" style="white-space:pre-line">@descPl</div>
                                }
                            }
                            @if (descEn is not null)
                            {
                                <button class="btn btn-sm btn-link px-0 mt-1" @onclick="() => _showEn = !_showEn">
                                    <span style="font-size:1rem">🇬🇧</span> @(_showEn ? "Ukryj opis EN" : "Pokaż opis EN")
                                </button>
                                @if (_showEn)
                                {
                                    <div class="small text-muted" style="white-space:pre-line">@descEn</div>
                                }
                            }
                            @if (descPl is null && descEn is null)
                            {
                                <div class="text-muted small">Brak opisu.</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.Attribution))
                            {
                                <div class="exercise-attribution mt-3">
                                    <i class="bi bi-c-circle me-1"></i>@_detail.Attribution
                                    @if (_detail.Attribution.StartsWith("wger.de"))
                                    {
                                        <span> · <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.pl" target="_blank" rel="noopener">o licencji</a></span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                @if (_detail.IsMine)
                {
                    @if (_shareOpen)
                    {
                        <div class="share-consent">
                            <div class="fw-semibold mb-1"><i class="bi bi-people me-1"></i>Udostępnij „@_detail.NamePl” społeczności</div>
                            <p class="small text-muted mb-2">Inni trenerzy platformy zobaczą to ćwiczenie (nazwę, opis, partie, zdjęcia i film) i będą mogli skopiować je do swojego katalogu.
                                Twoje wskazówki dla klientów, plany i dane klientów nie są udostępniane. Wycofasz je w każdej chwili.</p>
                            <label class="form-check small mb-1">
                                <input type="checkbox" class="form-check-input" @bind="_shareConsent" />
                                <span class="form-check-label">Zgadzam się na udostępnienie tego ćwiczenia innym trenerom platformy i mam prawa do zdjęć oraz filmu.</span>
                            </label>
                            <label class="form-check small mb-2">
                                <input type="checkbox" class="form-check-input" @bind="_shareAuthor" />
                                <span class="form-check-label">Pokaż nazwę mojego studia jako autora</span>
                            </label>
                            @if (_shareError is not null) { <div class="alert alert-danger py-1 small mb-2">@_shareError</div> }
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-primary" disabled="@(!_shareConsent || _shareBusy)" @onclick="ShareDetail">
                                    @if (_shareBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }Udostępnij
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _shareOpen = false">Anuluj</button>
                            </div>
                        </div>
                    }
                    <div class="modal-footer">
                        <button class="btn btn-sm btn-outline-danger me-auto" @onclick="() => DeleteDetail()"><i class="bi bi-trash me-1"></i>Usuń</button>
                        @* Kopii ze Społeczności nie udostępniamy dalej jako własnych. *@
                        @if (VideoPlan && CommunityAvailable && _detail.Attribution?.StartsWith("Społeczność") != true)
                        {
                            @if (_sharedIds.Contains(_detail.Id))
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled="@_shareBusy" @onclick="UnshareDetail"><i class="bi bi-people me-1"></i>Wycofaj ze Społeczności</button>
                            }
                            else if (!_shareOpen)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => { _shareOpen = true; _shareConsent = false; _shareError = null; }"><i class="bi bi-people me-1"></i>Udostępnij społeczności</button>
                            }
                        }
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditFromDetail()"><i class="bi bi-pencil me-1"></i>Edytuj</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ---------- Dodaj / edytuj własne ---------- *@
@if (_showEdit)
{
    <div class="modal fade show d-block exm-modal" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_form.Id is null ? "Nowe ćwiczenie" : "Edytuj ćwiczenie")</h5>
                    <button type="button" class="btn-close" aria-label="Zamknij" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_editError))
                    {
                        <div class="alert alert-danger py-2 small">@_editError</div>
                    }

                    <div class="exm-section">
                        <label class="form-label fw-semibold" for="ex-name">Nazwa ćwiczenia</label>
                        <input id="ex-name" class="form-control form-control-lg" @bind="_form.NamePl" maxlength="120" placeholder="np. Przysiad bułgarski" autocomplete="off" />
                        @if (_showEnFields)
                        {
                            <input class="form-control mt-2" @bind="_form.NameEn" maxlength="120" placeholder="Nazwa po angielsku (opcjonalnie)" aria-label="Nazwa po angielsku" />
                        }
                    </div>

                    <div class="exm-section">
                        <span class="form-label fw-semibold d-block">Co mierzymy w serii</span>
                        <div class="exm-chips">
                            @foreach (var t in Enum.GetValues<ExerciseTracking>())
                            {
                                var track = t;
                                <button type="button" class="exm-chip @(_form.Tracking == track ? "on" : "")" aria-pressed="@(_form.Tracking == track ? "true" : "false")" @onclick="() => _form.Tracking = track">
                                    @ExerciseTrackingRules.Label(track)
                                </button>
                            }
                        </div>
                        <small class="exm-hint">Od tego zależą pola w planie i podczas treningu klienta (np. bieg: dystans i czas, deska: czas).</small>
                    </div>

                    <div class="exm-section">
                        <div class="row g-2">
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold" for="ex-cat">Kategoria</label>
                                <select id="ex-cat" class="form-select" @bind="_form.Category">
                                    @foreach (var c in Enum.GetValues<ExerciseCategory>())
                                    {
                                        <option value="@c">@CategoryPl(c)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold" for="ex-lvl">Poziom</label>
                                <select id="ex-lvl" class="form-select" @bind="_form.Level">
                                    @foreach (var l in Enum.GetValues<ExerciseLevel>())
                                    {
                                        <option value="@l">@LevelPl(l)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold" for="ex-eq">Sprzęt</label>
                                <input id="ex-eq" class="form-control" @bind="_form.Equipment" maxlength="60" placeholder="np. hantle" list="ex-eq-list" autocomplete="off" />
                                <datalist id="ex-eq-list">
                                    @foreach (var eq in _equipment)
                                    {
                                        <option value="@eq"></option>
                                    }
                                </datalist>
                            </div>
                        </div>
                    </div>

                    <div class="exm-section">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                            <span class="form-label fw-semibold mb-0">Partie mięśni</span>
                            @if (MapOn) { <MuscleSexToggle Female="@_mmFemale" FemaleChanged="v => _mmFemale = v" /> }
                        </div>
                        <small class="exm-hint d-block mb-2">@(MapOn ? "Stuknij mięsień na postaci albo nazwę: raz — główna, drugi raz — pomocnicza, trzeci — odznacz." : "Kliknij raz — główna, drugi raz — wspomagająca, trzeci — odznacz.")</small>
                        <div class="@(MapOn ? "exm-mm-picker" : "")">
                        @if (MapOn)
                        {
                            <div class="exm-mm-fig">
                                <MuscleMap Primary="@_form.PrimaryMuscles" Secondary="@_form.SecondaryMuscles" Female="@_mmFemale" OnPick="CycleMuscle" />
                            </div>
                        }
                        <div class="exm-chips @(MapOn ? "mm-colors" : "")">
                            @foreach (var m in Enum.GetValues<MuscleGroup>())
                            {
                                var muscle = m;
                                var state = _form.PrimaryMuscles.Contains(muscle) ? "main" : _form.SecondaryMuscles.Contains(muscle) ? "help" : "";
                                <button type="button" class="exm-chip exm-muscle @state" @onclick="() => CycleMuscle(muscle)"
                                        aria-label="@($"{Muscles.Label(muscle)}: {(state == "main" ? "główna" : state == "help" ? "wspomagająca" : "nie wybrano")}")">
                                    @if (state == "main") { <i class="bi bi-circle-fill"></i> } else if (state == "help") { <i class="bi bi-circle-half"></i> }
                                    @Muscles.Label(muscle)
                                </button>
                            }
                        </div>
                        </div>
                        <div class="exm-legend @(MapOn ? "mm-colors" : "")"><span><i class="bi bi-circle-fill"></i> główna</span><span><i class="bi bi-circle-half"></i> @(MapOn ? "pomocnicza" : "wspomagająca")</span>
                            @if (MapOn && (_form.PrimaryMuscles.Count + _form.SecondaryMuscles.Count) > 0)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-auto exm-clear" @onclick="ClearMuscles">Wyczyść</button>
                            }
                        </div>
                    </div>

                    <div class="exm-section">
                        <label class="form-label fw-semibold" for="ex-desc">Jak wykonać</label>
                        <textarea id="ex-desc" class="form-control" rows="3" @bind="_form.DescriptionPl" placeholder="Krótko: ustawienie, ruch, na co uważać"></textarea>
                        @if (_showEnFields)
                        {
                            <textarea class="form-control mt-2" rows="2" @bind="_form.DescriptionEn" placeholder="Opis po angielsku (opcjonalnie)" aria-label="Opis po angielsku"></textarea>
                        }
                        else
                        {
                            <button type="button" class="btn btn-link btn-sm px-0 exm-more" @onclick="() => _showEnFields = true"><i class="bi bi-translate me-1"></i>Dodaj nazwę i opis po angielsku</button>
                        }
                    </div>

                    <div class="exm-section">
                        <ExerciseMediaFields @ref="_media" Form="_form" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit">Anuluj</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Zapisz ćwiczenie
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- Ćwiczenie ze Społeczności ---------- *@
@if (_communityDetail is { } cd)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)" @onclick="() => _communityDetail = null">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@cd.NamePl
                        <small class="d-block text-muted fw-normal" style="font-size:.8rem"><i class="bi bi-people me-1"></i>@(cd.AuthorName ?? "Trener platformy")</small>
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => _communityDetail = null" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            @if (cd.Thumbnail is { } img)
                            {
                                <img src="@img" class="img-fluid rounded border mb-2" alt="@cd.NamePl" />
                            }
                            @if (cd.VideoType == "Bunny")
                            {
                                <VideoPlayer BunnyVideoId="@cd.VideoRef" ShowPlaceholder="false" />
                            }
                            else if (cd.VideoType == "YouTube" && YtEmbed(cd.VideoRef) is { } cyt)
                            {
                                <div class="ratio ratio-16x9"><iframe src="@cyt" title="Wideo" allowfullscreen loading="lazy"></iframe></div>
                            }
                        </div>
                        <div class="col-12 col-md-7">
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var m in Muscles.Parse(cd.PrimaryMuscles))
                                {
                                    <span class="badge bg-primary">@Muscles.Label(m)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(cd.Equipment)) { <span class="badge bg-secondary">@cd.Equipment</span> }
                            </div>
                            <div class="small" style="white-space:pre-line">@(cd.Description ?? "Brak opisu.")</div>
                        </div>
                    </div>
                    @if (_copyMsg is not null) { <div class="alert alert-success py-2 small mt-3 mb-0">@_copyMsg</div> }
                </div>
                <div class="modal-footer">
                    @if (cd.Mine)
                    {
                        <span class="small text-muted me-auto">To Twoje ćwiczenie.</span>
                    }
                    else
                    {
                        <span class="small text-muted me-auto">Kopia trafi do „Moje” — możesz ją potem zmieniać. Film zostaje u autora.</span>
                        <button class="btn btn-sm btn-primary" disabled="@_copyBusy" @onclick="() => CopyFromCommunity(cd)">
                            @if (_copyBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }<i class="bi bi-plus-lg me-1"></i>Dodaj do moich
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

