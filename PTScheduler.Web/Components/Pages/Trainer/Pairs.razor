@page "/trainer/pairs"
@page "/trainer/contacts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@inject IPairService PairService
@inject IClientService ClientService
@inject ISessionPackageService PackageService
@inject IPackageOfferService OfferService
@inject ISessionService SessionService
@inject IAuditLogService AuditLogService
@inject AuthenticationStateProvider AuthState
@inject ILogger<Pairs> Logger
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Treningi w parach" />

<div class="set-head">
    <div>
        <h4 class="set-title"><i class="bi bi-people-fill"></i>Treningi w parach</h4>
        <p class="set-sub">Połącz osoby, które trenują razem. Potem przy rezerwacji i zakupie pakietu partner podpowie się sam.</p>
    </div>
</div>

<PairHowItWorks Class="mb-3" />

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_messageOk ? "alert-success" : "alert-danger") py-2 small d-flex align-items-center gap-2">
            <i class="bi @(_messageOk ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>@_message
        </div>
    }

    <section class="av-card">
        <div class="av-card-head">
            <h5><i class="bi bi-person-plus"></i>Nowa para</h5>
            <InfoTip Title="Po co łączyć w parę?" Text="Para to tylko informacja „te dwie osoby trenują razem”. Dzięki niej przy rezerwacji treningu w parze i przy zakupie pakietu dla pary partner jest od razu podpowiedziany. Parę możesz w każdej chwili rozłączyć — wizyty i pakiety zostają." />
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold mb-1">Pierwsza osoba</label>
                <select class="form-select" @bind="_newA">
                    <option value="0">— wybierz —</option>
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Id">@c.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold mb-1">Druga osoba</label>
                <select class="form-select" @bind="_newB">
                    <option value="0">— wybierz —</option>
                    @foreach (var c in _clients.Where(c => c.Id != _newA))
                    {
                        <option value="@c.Id">@c.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-primary" @onclick="AddPairAsync" disabled="@(_newA == 0 || _newB == 0 || _busy)">
                    <i class="bi bi-link-45deg me-1"></i>Połącz
                </button>
            </div>
        </div>
    </section>

    <section class="av-card">
        <div class="av-card-head">
            <h5><i class="bi bi-people"></i>Pary (@_pairs.Count)</h5>
        </div>
        @if (_pairs.Count == 0)
        {
            <div class="text-muted small py-2">Nie ma jeszcze par. Połącz dwie osoby powyżej albo poczekaj — para zapisze się sama, gdy ktoś kupi pakiet dla pary.</div>
        }
        else
        {
            <div class="pair-list">
                @foreach (var p in _pairs)
                {
                    <div class="pair-card">
                        <div class="pair-card-names">
                            <span class="avatar-circle" style="width:36px;height:36px;font-size:.8rem">@Initial(p.ClientAName)@Initial(p.ClientBName)</span>
                            <div>
                                <div class="fw-bold">
                                    <a href="@($"/clients/{p.ClientAId}")">@p.ClientAName</a> + <a href="@($"/clients/{p.ClientBId}")">@p.ClientBName</a>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @if (p.SharedRemaining > 0)
                                    {
                                        <span class="pair-chip"><i class="bi bi-box-seam"></i>Wspólny pakiet: @p.SharedRemaining @Trainings(p.SharedRemaining)</span>
                                    }
                                    else
                                    {
                                        <span class="set-chip set-chip-muted">Bez wspólnego pakietu</span>
                                    }
                                    @if (p.NextTraining is { } next)
                                    {
                                        <span class="set-chip set-chip-muted"><i class="bi bi-calendar-event"></i>@next.ToString("ddd d.MM, HH:mm")</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="pair-card-actions">
                            <button class="btn btn-sm btn-primary" @onclick="() => OpenPackage(p)">
                                <i class="bi bi-plus-lg me-1"></i>Dodaj pakiet
                            </button>
                            @if (_confirmRemove == p.Id)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => RemovePairAsync(p)">Tak, rozłącz</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmRemove = 0">Nie</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmRemove = p.Id" title="Rozłącz parę">
                                    <i class="bi bi-scissors"></i>
                                </button>
                            }
                        </div>

                        @if (_pkgFor?.Id == p.Id)
                        {
                            <div class="pair-pkg">
                                <div class="small fw-semibold mb-2">Pakiet dla pary @p.DisplayName</div>
                                @if (_pairOffers.Count > 0)
                                {
                                    <label class="form-label small mb-1">Z oferty</label>
                                    <select class="form-select form-select-sm mb-2" @bind="_pkgOfferId" @bind:after="ApplyOffer">
                                        <option value="0">— własny pakiet —</option>
                                        @foreach (var o in _pairOffers)
                                        {
                                            <option value="@o.Id">@o.Name · @o.SessionsCount @Trainings(o.SessionsCount) · @o.Price.ToString("0.##") zł</option>
                                        }
                                    </select>
                                }
                                <div class="row g-2 mb-2">
                                    <div class="col-12 col-sm-5">
                                        <label class="form-label small mb-1">Rodzaj treningu</label>
                                        <select class="form-select form-select-sm" @bind="_pkg.SessionTypeId">
                                            @foreach (var t in _types)
                                            {
                                                <option value="@t.Id">@t.Name@(t.IsPair ? " · w parze" : "")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <label class="form-label small mb-1">Treningów</label>
                                        <input type="number" min="1" class="form-control form-control-sm" @bind="_pkg.TotalSessions" />
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <label class="form-label small mb-1">Cena za całość (zł)</label>
                                        <input type="number" min="0" step="1" class="form-control form-control-sm" @bind="_pkgTotalPrice" />
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-3 small mb-2">
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="_pkg.IsPaid" />
                                        <span class="form-check-label">Opłacony</span>
                                    </label>
                                    <span class="text-muted">Należy do: <strong>@p.ClientAName</strong> i <strong>@p.ClientBName</strong> · 1 trening = 1 wspólne wejście</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success" @onclick="SavePackageAsync" disabled="@(_busy || _pkg.TotalSessions < 1 || _pkg.SessionTypeId == 0)">
                                        @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        Dodaj pakiet
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _pkgFor = null">Anuluj</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private string _userId = "";
    private string _userEmail = "";
    private string _userRole = "";
    private bool _isAdmin;
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private bool _messageOk;

    private List<PairDto> _pairs = [];
    private List<ClientDto> _clients = [];
    private List<SessionTypeDto> _types = [];
    private List<PackageOfferDto> _pairOffers = [];
    private int _newA, _newB, _confirmRemove;

    private PairDto? _pkgFor;
    private int _pkgOfferId;
    private decimal _pkgTotalPrice;
    private CreateSessionPackageDto _pkg = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _userEmail = auth.User.Identity?.Name ?? _userId;
        _isAdmin = auth.User.IsInRole(Roles.Admin);
        _userRole = _isAdmin ? Roles.Admin : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer : Roles.Subordinate;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var filter = _isAdmin ? null : _userId;
            _pairs = await PairService.GetPairsAsync(filter);
            _clients = (await ClientService.GetClientsAsync(filter))
                .Where(c => c.Status == ClientStatus.Active).OrderBy(c => c.FullName).ToList();
            _types = await SessionService.GetSessionTypesAsync();
            _pairOffers = (await OfferService.GetAllAsync()).Where(o => o.IsForPair && o.IsActive).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd ładowania par");
            Show(false, "Nie udało się wczytać par. Odśwież stronę.");
        }
        finally { _loading = false; }
    }

    private async Task AddPairAsync()
    {
        _busy = true;
        try
        {
            await PairService.AddPairAsync(_newA, _newB, _userId);
            _newA = _newB = 0;
            _pairs = await PairService.GetPairsAsync(_isAdmin ? null : _userId);
            Show(true, "Para połączona. Przy rezerwacji partner podpowie się sam.");
        }
        catch (Exception ex) { Show(false, ex.Message); }
        finally { _busy = false; }
    }

    private async Task RemovePairAsync(PairDto p)
    {
        await PairService.RemovePairAsync(p.Id);
        _confirmRemove = 0;
        _pairs = await PairService.GetPairsAsync(_isAdmin ? null : _userId);
        Show(true, $"Rozłączono {p.DisplayName}. Wizyty i pakiety zostają bez zmian.");
    }

    private void OpenPackage(PairDto p)
    {
        _pkgFor = p;
        var pairType = _types.FirstOrDefault(t => t.IsPair) ?? _types.FirstOrDefault();
        _pkg = new CreateSessionPackageDto
        {
            ClientId = p.ClientAId,
            PartnerClientId = p.ClientBId,
            CreatedByUserId = _userId,
            SessionTypeId = pairType?.Id ?? 0,
            TotalSessions = 10
        };
        _pkgTotalPrice = 0;
        _pkgOfferId = 0;
        if (_pairOffers.Count > 0) { _pkgOfferId = _pairOffers[0].Id; ApplyOffer(); }
    }

    private void ApplyOffer()
    {
        var o = _pairOffers.FirstOrDefault(x => x.Id == _pkgOfferId);
        if (o is null) return;
        _pkg.SessionTypeId = o.SessionTypeId;
        _pkg.TotalSessions = o.SessionsCount;
        _pkg.Name = o.Name;
        _pkg.ExpiresAt = o.ValidDays is int d ? DateTime.UtcNow.AddDays(d) : null;
        _pkgTotalPrice = o.Price;
    }

    private async Task SavePackageAsync()
    {
        if (_pkgFor is null) return;
        _busy = true;
        try
        {
            if (_pkgOfferId == 0) _pkg.Name = "";
            _pkg.PricePerSession = _pkg.TotalSessions > 0 ? Math.Round(_pkgTotalPrice / _pkg.TotalSessions, 2) : 0;
            var created = await PackageService.CreatePackageAsync(_pkg);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "PackageCreated", "SessionPackage", created.Id.ToString(),
                $"Pakiet dla pary {_pkgFor.DisplayName}: {created.Name}, {created.TotalSessions} tr.{(_pkg.IsPaid ? ", opłacony" : "")}");
            Show(true, $"Dodano pakiet „{created.Name}” dla {_pkgFor.DisplayName}. Oboje widzą go od razu.");
            _pkgFor = null;
            _pairs = await PairService.GetPairsAsync(_isAdmin ? null : _userId);
        }
        catch (Exception ex) { Show(false, ex.Message); }
        finally { _busy = false; }
    }

    private void Show(bool ok, string msg) { _messageOk = ok; _message = msg; }
    private static string Initial(string name) => name.Length > 0 ? name[..1].ToUpper() : "?";
    private static string Trainings(int n) => n == 1 ? "trening" : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? "treningi" : "treningów";
}
