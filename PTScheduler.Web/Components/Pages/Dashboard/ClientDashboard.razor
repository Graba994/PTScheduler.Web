@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@using System.Globalization
@inject ISessionService SessionService
@inject IClientService ClientService
@inject ISessionInvitationService InvitationService
@inject IBodyMeasurementService MeasurementService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IModuleSettingsService ModuleSettings

@if (!_loaded)
{
    <div class="cd-page">
        <!-- Hero skeleton -->
        <div class="skeleton-card" style="padding:2rem;text-align:center">
            <div class="skeleton skeleton-line w-40 mx-auto" style="height:14px"></div>
            <div class="skeleton skeleton-line w-50 mx-auto" style="height:28px"></div>
            <div class="skeleton skeleton-line w-75 mx-auto" style="height:12px"></div>
        </div>
        <!-- Stats skeleton -->
        <div class="d-flex gap-2 mb-3">
            @for (var i = 0; i < 4; i++)
            {
                <div class="skeleton-card flex-fill" style="padding:14px;text-align:center">
                    <div class="skeleton skeleton-line w-50 mx-auto" style="height:20px"></div>
                    <div class="skeleton skeleton-line w-75 mx-auto" style="height:10px;margin-bottom:0"></div>
                </div>
            }
        </div>
        <!-- Package skeleton -->
        <div class="skeleton-card">
            <div class="skeleton skeleton-line w-50" style="height:14px"></div>
            <div class="skeleton skeleton-line w-75" style="height:10px"></div>
            <div class="skeleton" style="width:100%;height:8px;border-radius:4px;margin-bottom:0"></div>
        </div>
    </div>
}
else if (_errorMsg is not null)
{
    <div class="alert alert-danger small"><i class="bi bi-exclamation-circle me-1"></i>@_errorMsg</div>
}
else if (_client is null)
{
    <div class="alert alert-warning small">Nie znaleziono profilu klienta.</div>
}
else
{
    <PullToRefresh OnRefresh="RefreshAsync">
    <div class="cd-page">

        <!-- Greeting -->
        <div class="cd-greeting">
            <h5 class="cd-greeting-hi">Cześć, @(_client.FirstName is { Length: > 0 } fn ? fn : _client.Email.Split('@')[0])!</h5>
            @if (_streakCount >= 3)
            {
                <div class="cd-greeting-streak"><i class="bi bi-fire"></i> @_streakCount treningów z rzędu — tak trzymaj!</div>
            }
        </div>

        @if (_client.Status == ClientStatus.Pending)
        {
            <div class="cd-pending">
                <div class="cd-pending-ico">⏳</div>
                <div>
                    <strong>Twoje konto czeka na zatwierdzenie</strong>
                    <div class="small">Trener wkrótce zatwierdzi Twoje konto, wtedy zobaczysz pełny grafik.</div>
                </div>
            </div>
        }

        @if (_invitations.Any())
        {
            <div class="cd-invites">
                <div class="cd-invites-head">
                    <i class="bi bi-envelope-fill"></i>
                    <span>Zaproszenia na sesje (@_invitations.Count)</span>
                </div>
                @foreach (var inv in _invitations)
                {
                    <div class="cd-invite">
                        <div class="cd-invite-when">
                            <div class="cd-invite-day">@inv.SessionStartTime.ToString("dd.MM")</div>
                            <div class="cd-invite-time">@inv.SessionStartTime.ToString("HH:mm")</div>
                        </div>
                        <div class="cd-invite-body">
                            <div class="cd-invite-title">@inv.SessionTypeName · @inv.DurationMinutes min</div>
                            <div class="cd-invite-trainer"><i class="bi bi-person"></i>@inv.TrainerName</div>
                        </div>
                        @if (_respondingId == inv.Id)
                        {
                            <div class="cd-invite-actions w-100">
                                <input class="form-control form-control-sm mb-2" placeholder="Notatka..." @bind="_respondNote" />
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success flex-grow-1" @onclick="() => RespondAsync(inv.Id, true)">
                                        <i class="bi bi-check-lg me-1"></i>Akceptuj
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger flex-grow-1" @onclick="() => RespondAsync(inv.Id, false)">
                                        <i class="bi bi-x-lg me-1"></i>Odrzuć
                                    </button>
                                </div>
                                @if (_respondError is not null)
                                {
                                    <div class="text-danger small mt-1">@_respondError</div>
                                }
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary" @onclick="() => StartRespond(inv.Id)">
                                Odpowiedz
                            </button>
                        }
                    </div>
                }
            </div>
        }

        <!-- HERO: next session countdown -->
        <div class="cd-hero @HeroToneClass()">
            @if (_nextSession is null)
            {
                <div class="cd-hero-empty">
                    <div class="cd-hero-ico">📅</div>
                    <div class="cd-hero-title">Brak zaplanowanych treningów</div>
                    @if (_client?.AllowSelfBooking == true)
                    {
                        <div class="cd-hero-sub">Umów się sam na trening w swoim grafiku!</div>
                        <a href="/my" class="cd-hero-cta"><i class="bi bi-plus-circle me-1"></i>Zaplanuj trening</a>
                    }
                    else
                    {
                        <div class="cd-hero-sub">Skontaktuj się z trenerem, aby umówić kolejną sesję.</div>
                    }
                </div>
            }
            else
            {
                <div class="cd-hero-label">Twój następny trening</div>
                <div class="cd-hero-countdown">@CountdownLabel(_nextSession.StartTime)</div>
                <div class="cd-hero-when">@FormatWhen(_nextSession.StartTime)</div>

                <div class="cd-hero-meta">
                    <span><i class="bi bi-person"></i>@_nextSession.TrainerName</span>
                    <span><i class="bi bi-clock"></i>@_nextSession.DurationMinutes min</span>
                    <span><i class="bi bi-bookmark"></i>@_nextSession.SessionTypeName</span>
                </div>

                @if (!string.IsNullOrEmpty(_nextSession.MeetingUrl))
                {
                    <a href="@_nextSession.MeetingUrl" target="_blank" class="cd-hero-meet">
                        <i class="bi bi-camera-video-fill me-1"></i>Dołącz do Google Meet
                    </a>
                }

                @if (_cancelConfirmId == _nextSession.Id)
                {
                    <div class="cd-hero-confirm">
                        <input class="form-control form-control-sm mb-2"
                               placeholder="Powód anulowania (opcjonalnie)"
                               @bind="_cancelReason" />
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-light flex-grow-1" @onclick="() => _cancelConfirmId = null">
                                Wstecz
                            </button>
                            <button class="btn btn-sm btn-danger flex-grow-1" @onclick="ConfirmCancel" disabled="@_cancelling">
                                @if (_cancelling) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Anuluj sesję
                            </button>
                        </div>
                        @if (_cancelError is not null)
                        {
                            <div class="cd-hero-err">@_cancelError</div>
                        }
                    </div>
                }
                else
                {
                    <button class="cd-hero-cancel" @onclick="StartCancel">
                        <i class="bi bi-x-circle"></i> Anuluj sesję
                    </button>
                }
            }
        </div>

        <!-- Quick stats -->
        <div class="cd-stats">
            <div class="cd-stat">
                <div class="cd-stat-val">@(_client.ActivePackage?.RemainingCredits ?? 0)</div>
                <div class="cd-stat-lab">Pozostałe sesje</div>
            </div>
            <div class="cd-stat">
                <div class="cd-stat-val">@_client.TotalSessions</div>
                <div class="cd-stat-lab">Ukończone</div>
            </div>
            <div class="cd-stat">
                <div class="cd-stat-val">
                    @if (_latestMeasurement?.WeightKg is { } w)
                    {
                        <span>@w.ToString("0.#", CultureInfo.InvariantCulture)<span class="cd-stat-unit">kg</span></span>
                        @if (_previousWeight is { } pw)
                        {
                            var delta = w - pw;
                            if (delta != 0)
                            {
                                var cls = delta < 0 ? "down" : "up";
                                <span class="cd-stat-delta @cls">
                                    <i class="bi bi-arrow-@(delta < 0 ? "down" : "up")-short"></i>@Math.Abs(delta).ToString("0.#", CultureInfo.InvariantCulture)
                                </span>
                            }
                        }
                    }
                    else
                    {
                        <span class="cd-stat-empty">—</span>
                    }
                </div>
                <div class="cd-stat-lab">Ostatnia waga</div>
            </div>
            <div class="cd-stat">
                <div class="cd-stat-val">
                    @if (_completedCount + _noShowCount > 0)
                    {
                        var rate = (int)Math.Round(100.0 * _completedCount / (_completedCount + _noShowCount));
                        <span>@rate<span class="cd-stat-unit">%</span></span>
                    }
                    else if (_client.TotalSessions > 0)
                    {
                        <span>100<span class="cd-stat-unit">%</span></span>
                    }
                    else
                    {
                        <span class="cd-stat-empty">—</span>
                    }
                </div>
                <div class="cd-stat-lab">Frekwencja</div>
            </div>
        </div>

        <!-- Active package -->
        @if (_client.ActivePackage is { } pkg)
        {
            var pct = pkg.TotalSessions > 0 ? (int)((double)pkg.UsedSessions / pkg.TotalSessions * 100) : 0;
            <div class="cd-section">
                <div class="cd-section-head">
                    <h6 class="cd-section-title"><i class="bi bi-ticket-perforated"></i>Aktywny pakiet</h6>
                    @if (_client.AllPackages.Count > 1)
                    {
                        <a href="/my/packages" class="cd-section-link">Wszystkie <i class="bi bi-arrow-right"></i></a>
                    }
                </div>
                <div class="cd-pkg">
                    <div class="cd-pkg-head">
                        <div class="cd-pkg-name">@pkg.Name</div>
                        @if (pkg.IsPaid)
                        {
                            <span class="cd-pkg-badge paid">Opłacony</span>
                        }
                        else
                        {
                            <span class="cd-pkg-badge unpaid">Oczekuje opłaty</span>
                        }
                    </div>
                    <div class="cd-pkg-progress">
                        <div class="cd-pkg-bar"><div class="cd-pkg-bar-fill" style="width:@(pct)%"></div></div>
                        <div class="cd-pkg-stats">
                            <span><strong>@pkg.RemainingCredits</strong> z @pkg.TotalSessions</span>
                            @if (pkg.ExpiresAt.HasValue)
                            {
                                var daysLeft = (int)(pkg.ExpiresAt.Value - DateTime.Now).TotalDays;
                                var cls = daysLeft <= 7 ? "warn" : daysLeft <= 14 ? "soft" : "muted";
                                <span class="cd-pkg-expires @cls">
                                    <i class="bi bi-calendar-x"></i>
                                    @(daysLeft <= 0 ? "Wygasł" : $"{daysLeft} dni")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Mini weight chart -->
        @if (_chartPoints.Count >= 2)
        {
            <div class="cd-section">
                <div class="cd-section-head">
                    <h6 class="cd-section-title"><i class="bi bi-graph-up"></i>Postęp wagi</h6>
                    <a href="/my/measurements" class="cd-section-link">Pełna historia <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="cd-chart-wrap">
                    <canvas id="cd-weight-chart-@_client.Id"></canvas>
                </div>
            </div>
        }

        <!-- Quick weight entry -->
        <div class="cd-section">
            <div class="cd-section-head">
                <h6 class="cd-section-title"><i class="bi bi-speedometer2"></i>Szybki wpis wagi</h6>
            </div>
            <div class="cd-quick-weight">
                <div class="cd-qw-form">
                    <input type="text" inputmode="decimal"
                           class="form-control form-control-sm cd-qw-input"
                           placeholder="np. 72.5"
                           @bind="_quickWeight" />
                    <span class="cd-qw-unit">kg</span>
                    <button class="btn btn-sm btn-primary cd-qw-btn" @onclick="LogQuickWeightAsync" disabled="@_weightSaving">
                        @if (_weightSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i><span class="d-none d-sm-inline ms-1">Zapisz</span>
                        }
                    </button>
                </div>
                @if (_weightMsg is not null)
                {
                    <div class="cd-qw-msg @(_weightMsgOk ? "ok" : "err")">@_weightMsg</div>
                }
            </div>
        </div>

        @if (_coursesEnabled)
        {
            <a href="/courses" class="cd-courses-cta">
                <div class="cd-courses-cta-icon"><i class="bi bi-collection-play-fill"></i></div>
                <div class="cd-courses-cta-body">
                    <div class="cd-courses-cta-title">Rozwijaj się z kursami online</div>
                    <div class="cd-courses-cta-sub">Wiedza od trenera dostępna 24/7 — przeglądaj dostępne kursy i mentoring.</div>
                </div>
                <span class="cd-courses-cta-btn">Przeglądaj kursy <i class="bi bi-arrow-right"></i></span>
            </a>
        }

        <a href="/packages" class="cd-packages-cta">
            <div class="cd-packages-cta-icon"><i class="bi bi-box-seam-fill"></i></div>
            <div class="cd-packages-cta-body">
                <div class="cd-packages-cta-title">Pakiety treningowe w super cenach</div>
                <div class="cd-packages-cta-sub">Kup pakiet sesji i oszczędzaj — im więcej treningów, tym lepsza cena za sesję.</div>
            </div>
            <span class="cd-packages-cta-btn">Zobacz pakiety <i class="bi bi-arrow-right"></i></span>
        </a>

        <!-- Quick actions -->
        <div class="cd-actions">
            <a href="/my/profile" class="cd-action">
                <i class="bi bi-person-circle"></i>
                <span>Profil</span>
            </a>
            <a href="/my/measurements" class="cd-action">
                <i class="bi bi-rulers"></i>
                <span>Pomiary</span>
            </a>
            <a href="/my/packages" class="cd-action">
                <i class="bi bi-box-seam"></i>
                <span>Pakiety</span>
            </a>
            @if (_coursesEnabled)
            {
                <a href="/my/courses" class="cd-action">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Moje kursy</span>
                </a>
            }
            <a href="/my/stats" class="cd-action">
                <i class="bi bi-graph-up"></i>
                <span>Statystyki</span>
            </a>
        </div>

        <!-- Recent sessions -->
        @if (_recentPast.Any())
        {
            <div class="cd-section">
                <div class="cd-section-head">
                    <h6 class="cd-section-title"><i class="bi bi-clock-history"></i>Ostatnie treningi</h6>
                    <a href="/sessions" class="cd-section-link">Wszystkie <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="cd-recent">
                    @foreach (var s in _recentPast)
                    {
                        <div class="cd-recent-item">
                            <div class="cd-recent-date">
                                <div class="cd-recent-day">@s.StartTime.ToString("dd.MM")</div>
                                <div class="cd-recent-time">@s.StartTime.ToString("HH:mm")</div>
                            </div>
                            <div class="cd-recent-body">
                                <div class="cd-recent-title">@s.SessionTypeName</div>
                                <div class="cd-recent-sub">@s.DurationMinutes min · @s.TrainerName</div>
                            </div>
                            <span class="cd-recent-badge @StatusClass(s.Status)">@StatusLabel(s.Status)</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    </PullToRefresh>
}

@code {
    private static readonly CultureInfo _pl = new("pl-PL");

    [Parameter] public string? UserId { get; set; }
    [Parameter] public int? ClientIdOverride { get; set; }

    private bool _loaded;
    private bool _loading;
    private ClientDto? _client;
    private SessionDto? _nextSession;
    private List<SessionDto> _recentPast = [];
    private int _upcomingCount;
    private List<SessionInvitationDto> _invitations = [];
    private BodyMeasurementDto? _latestMeasurement;
    private List<(string Date, double Value)> _chartPoints = [];
    private string? _errorMsg;

    // Invitation responding
    private int? _respondingId;
    private string? _respondNote;
    private string? _respondError;

    // Session cancel
    private int? _cancelConfirmId;
    private string? _cancelReason;
    private string? _cancelError;
    private bool _cancelling;

    // Computed stats
    private decimal? _previousWeight;
    private int _completedCount;
    private int _noShowCount;
    private int _streakCount;

    // Quick weight entry
    private string? _quickWeight;
    private bool _weightSaving;
    private string? _weightMsg;
    private bool _weightMsgOk;

    // Chart re-render trigger
    private bool _chartNeedsRender;

    // Courses module
    private bool _coursesEnabled;

    private async Task RefreshAsync()
    {
        _loading = false;
        await OnParametersSetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loading) return;
        _loading = true;
        try
        {
            _loaded = false;
            _client = null;
            _errorMsg = null;
            _coursesEnabled = (await ModuleSettings.GetAsync()).CoursesEnabled;
            try
            {
                if (ClientIdOverride.HasValue)
                    _client = await ClientService.GetClientAsync(ClientIdOverride.Value);
                else if (!string.IsNullOrEmpty(UserId))
                    _client = await ClientService.GetClientByUserIdAsync(UserId);

                if (_client is not null)
                {
                    var upcoming = await SessionService.GetUpcomingAsync(clientId: _client.Id, count: 10);
                    _upcomingCount = upcoming.Count;
                    _nextSession   = upcoming.FirstOrDefault();

                    var allRecent = await SessionService.GetClientSessionsAsync(_client.Id, 50);
                    var pastSessions = allRecent.Where(s => s.StartTime < DateTime.Now).ToList();
                    _recentPast    = pastSessions.Take(5).ToList();
                    _completedCount = pastSessions.Count(s => s.Status == SessionStatus.Completed);
                    _noShowCount = pastSessions.Count(s => s.Status == SessionStatus.NoShow);
                    _streakCount = CalcStreak(pastSessions);

                    _invitations   = await InvitationService.GetPendingForClientAsync(_client.Id);

                    var measurements = await MeasurementService.GetAsync(_client.Id);
                    _latestMeasurement = measurements.OrderByDescending(m => m.MeasurementDate).FirstOrDefault();
                    var weightHistory = measurements.Where(m => m.WeightKg.HasValue).OrderByDescending(m => m.MeasurementDate).ToList();
                    _previousWeight = weightHistory.Count >= 2 ? weightHistory[1].WeightKg : null;

                    _chartPoints = measurements
                        .Where(m => m.WeightKg.HasValue)
                        .OrderByDescending(m => m.MeasurementDate)
                        .Take(6)
                        .OrderBy(m => m.MeasurementDate)
                        .Select(m => (m.MeasurementDate.ToString("dd.MM"), (double)m.WeightKg!.Value))
                        .ToList();

                    if (_chartPoints.Count >= 2) _chartNeedsRender = true;
                }
            }
            catch (Exception ex)
            {
                _errorMsg = $"Błąd ładowania danych: {ex.Message}";
            }
            _loaded = true;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender && _client is not null && _chartPoints.Count >= 2)
        {
            _chartNeedsRender = false;
            try
            {
                await JS.InvokeVoidAsync("PTChart.renderLine",
                    $"cd-weight-chart-{_client.Id}",
                    _chartPoints.Select(p => p.Date).ToArray(),
                    _chartPoints.Select(p => p.Value).ToArray(),
                    "Waga", "kg");
            }
            catch { /* chart helper may be missing in some renderers; ignore */ }
        }
    }

    // ---- Invitations ----

    private void StartRespond(int invitationId)
    {
        _respondingId = invitationId;
        _respondNote  = null;
        _respondError = null;
    }

    private async Task RespondAsync(int invitationId, bool accept)
    {
        _respondError = null;
        try
        {
            await InvitationService.RespondAsync(invitationId, accept, _respondNote);
            _respondingId = null;
            if (_client is not null)
                _invitations = await InvitationService.GetPendingForClientAsync(_client.Id);
        }
        catch (Exception ex)
        {
            _respondError = ex.Message;
        }
    }

    // ---- Cancel session ----

    private void StartCancel()
    {
        _cancelConfirmId = _nextSession?.Id;
        _cancelReason = null;
        _cancelError = null;
    }

    private async Task ConfirmCancel()
    {
        if (_nextSession is null || _client is null) return;
        _cancelling = true;
        _cancelError = null;
        try
        {
            await SessionService.ClientCancelSessionAsync(_nextSession.Id, _client.ApplicationUserId, _cancelReason);
            // Reload data
            _cancelConfirmId = null;
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            _cancelError = ex.Message;
        }
        finally
        {
            _cancelling = false;
        }
    }

    // ---- Hero formatting ----

    private string CountdownLabel(DateTime when)
    {
        var diff = when - DateTime.Now;
        if (diff.TotalSeconds < 0) return "Już trwa";
        if (diff.TotalMinutes < 60) return $"Za {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24)
        {
            var h = (int)diff.TotalHours;
            var m = diff.Minutes;
            return m > 0 ? $"Za {h}h {m}min" : $"Za {h}h";
        }
        if (diff.TotalDays < 2) return "Jutro";
        if (diff.TotalDays < 7) return $"Za {(int)diff.TotalDays} dni";
        return when.ToString("d MMM", _pl);
    }

    private string HeroToneClass()
    {
        if (_nextSession is null) return "tone-empty";
        var diff = _nextSession.StartTime - DateTime.Now;
        if (diff.TotalHours < 4) return "tone-urgent";
        if (diff.TotalHours < 24) return "tone-soon";
        return "tone-default";
    }

    private string FormatWhen(DateTime when)
    {
        var label = when.ToString("dddd, d MMMM, HH:mm", _pl);
        return char.ToUpper(label[0], _pl) + label[1..];
    }

    // ---- Status helpers ----

    private static string StatusClass(SessionStatus s) => s switch
    {
        SessionStatus.Completed       => "ok",
        SessionStatus.Cancelled       => "danger",
        SessionStatus.NoShow          => "muted",
        SessionStatus.AwaitingPackage => "warn",
        _                             => "info"
    };

    private static string StatusLabel(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled       => "Zaplanowana",
        SessionStatus.Completed       => "Ukończona",
        SessionStatus.Cancelled       => "Anulowana",
        SessionStatus.NoShow          => "Nieobecność",
        SessionStatus.AwaitingPackage => "Bez pakietu",
        _                             => s.ToString()
    };

    // ---- Quick weight entry ----

    private async Task LogQuickWeightAsync()
    {
        if (_client is null) return;
        if (!decimal.TryParse(_quickWeight?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var w) || w < 20 || w > 400)
        {
            _weightMsg = "Podaj poprawną wagę (20–400 kg)";
            _weightMsgOk = false;
            return;
        }
        _weightSaving = true;
        _weightMsg = null;
        try
        {
            await MeasurementService.AddAsync(new CreateBodyMeasurementDto
            {
                ClientId = _client.Id,
                MeasurementDate = DateOnly.FromDateTime(DateTime.Today),
                WeightKg = w
            });
            _quickWeight = null;
            _weightMsg = "Zapisano!";
            _weightMsgOk = true;
            var measurements = await MeasurementService.GetAsync(_client.Id);
            _latestMeasurement = measurements.OrderByDescending(m => m.MeasurementDate).FirstOrDefault();
            var wh = measurements.Where(m => m.WeightKg.HasValue).OrderByDescending(m => m.MeasurementDate).ToList();
            _previousWeight = wh.Count >= 2 ? wh[1].WeightKg : null;
            _chartPoints = measurements.Where(m => m.WeightKg.HasValue)
                .OrderByDescending(m => m.MeasurementDate).Take(6)
                .OrderBy(m => m.MeasurementDate)
                .Select(m => (m.MeasurementDate.ToString("dd.MM"), (double)m.WeightKg!.Value)).ToList();
            if (_chartPoints.Count >= 2) _chartNeedsRender = true;
        }
        catch (Exception ex)
        {
            _weightMsg = ex.Message;
            _weightMsgOk = false;
        }
        finally { _weightSaving = false; }
    }

    private static int CalcStreak(List<SessionDto> pastSessions)
    {
        int streak = 0;
        foreach (var s in pastSessions
            .Where(s => s.Status is SessionStatus.Completed or SessionStatus.NoShow or SessionStatus.Cancelled)
            .OrderByDescending(s => s.StartTime))
        {
            if (s.Status == SessionStatus.Completed) streak++;
            else break;
        }
        return streak;
    }
}
