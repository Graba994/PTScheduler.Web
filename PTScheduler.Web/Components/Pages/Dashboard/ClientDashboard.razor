@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@using System.Globalization
@inject ISessionService SessionService
@inject IClientService ClientService
@inject IBodyMeasurementService MeasurementService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IModuleSettingsService ModuleSettings
@inject PTScheduler.Web.Services.EntitlementService Entitlements

@if (!_loaded)
{
    <div class="cdx">
        <!-- Hero skeleton -->
        <div class="skeleton-card" style="padding:2rem;text-align:center">
            <div class="skeleton skeleton-line w-40 mx-auto" style="height:14px"></div>
            <div class="skeleton skeleton-line w-50 mx-auto" style="height:28px"></div>
            <div class="skeleton skeleton-line w-75 mx-auto" style="height:12px"></div>
        </div>
        <!-- Stats skeleton -->
        <div class="d-flex gap-2 mb-3">
            @for (var i = 0; i < 4; i++)
            {
                <div class="skeleton-card flex-fill" style="padding:14px;text-align:center">
                    <div class="skeleton skeleton-line w-50 mx-auto" style="height:20px"></div>
                    <div class="skeleton skeleton-line w-75 mx-auto" style="height:10px;margin-bottom:0"></div>
                </div>
            }
        </div>
        <!-- Package skeleton -->
        <div class="skeleton-card">
            <div class="skeleton skeleton-line w-50" style="height:14px"></div>
            <div class="skeleton skeleton-line w-75" style="height:10px"></div>
            <div class="skeleton" style="width:100%;height:8px;border-radius:4px;margin-bottom:0"></div>
        </div>
    </div>
}
else if (_errorMsg is not null)
{
    <div class="alert alert-danger small"><i class="bi bi-exclamation-circle me-1"></i>@_errorMsg</div>
}
else if (_client is null)
{
    <div class="alert alert-warning small">Nie znaleziono profilu klienta.</div>
}
else
{
    <PullToRefresh OnRefresh="RefreshAsync">
    <div class="cdx">

        <!-- Nagłówek: powitanie + najczęstsze akcje -->
        <div class="cdx-head">
            <div class="min-w-0">
                <h4 class="cdx-hi">Cześć, @(_client.FirstName is { Length: > 0 } fn ? fn : _client.Email.Split('@')[0])!</h4>
                <div class="cdx-sub">
                    <span>@Capital(StudioClock.Now.ToString("dddd, d MMMM", _pl))</span>
                    @if (_streakCount >= 3)
                    {
                        <span class="cdx-streak"><i class="bi bi-fire"></i>@_streakCount treningów z rzędu</span>
                    }
                </div>
            </div>
            <div class="cdx-head-actions">
                @if (_trainingEnabled)
                {
                    <a href="/train" class="btn btn-primary"><i class="bi bi-lightning-charge-fill me-1"></i>Zacznij trening</a>
                }
                @if (_client.AllowSelfBooking)
                {
                    <a href="/my" class="btn btn-outline-primary"><i class="bi bi-calendar-plus me-1"></i>Umów trening</a>
                }
            </div>
        </div>

        @if (_client.Status == ClientStatus.Pending)
        {
            <div class="cdx-pending">
                <i class="bi bi-hourglass-split"></i>
                <div>
                    <strong>Twoje konto czeka na zatwierdzenie</strong>
                    <div class="small">Trener wkrótce zatwierdzi Twoje konto, wtedy zobaczysz pełny grafik.</div>
                </div>
            </div>
        }
        else
        {
            <ReviewPrompt ClientId="_client.Id" />
        }

        <!-- Następny trening + pakiet -->
        <div class="cdx-row cdx-row-hero">
            <div class="cdx-next @(IsSoon() ? "soon" : "")">
                @if (_nextSession is null)
                {
                    <div class="cdx-next-empty">
                        <span class="cdx-next-ic"><i class="bi bi-calendar2-plus"></i></span>
                        <div>
                            <div class="cdx-next-title">Nie masz zaplanowanego treningu</div>
                            <div class="cdx-next-sub">@(_client.AllowSelfBooking ? "Wybierz wolny termin — zajmie to chwilę." : "Napisz do trenera, żeby umówić kolejny trening.")</div>
                        </div>
                        @if (_client.AllowSelfBooking)
                        {
                            <a href="/my" class="btn btn-light fw-semibold">Umów trening <i class="bi bi-arrow-right"></i></a>
                        }
                        else
                        {
                            <a href="/chat" class="btn btn-light fw-semibold">Napisz do trenera <i class="bi bi-arrow-right"></i></a>
                        }
                    </div>
                }
                else
                {
                    <div class="cdx-next-top">
                        <div class="cdx-date">
                            <span class="d">@_nextSession.StartTime.Day</span>
                            <span class="m">@_nextSession.StartTime.ToString("MMM", _pl)</span>
                        </div>
                        <div class="min-w-0 flex-grow-1">
                            <div class="cdx-next-label">Twój następny trening @if (IsSoon()) { <span class="cdx-soon-chip">już niedługo</span> }</div>
                            <div class="cdx-next-count">@CountdownLabel(_nextSession.StartTime)</div>
                            <div class="cdx-next-when">@FormatWhen(_nextSession.StartTime)</div>
                        </div>
                    </div>
                    <div class="cdx-next-meta">
                        @if (_nextSession.IsPair && _nextSession.PartnerActive)
                        {
                            <span><i class="bi bi-people-fill"></i>z: @_nextSession.PartnerName</span>
                        }
                        <span><i class="bi bi-person"></i>@_nextSession.TrainerName</span>
                        <span><i class="bi bi-clock"></i>@_nextSession.DurationMinutes min</span>
                        <span><i class="bi bi-bookmark"></i>@_nextSession.SessionTypeName</span>
                    </div>
                    <div class="cdx-next-actions">
                        @if (!string.IsNullOrEmpty(_nextSession.MeetingUrl))
                        {
                            <a href="@_nextSession.MeetingUrl" target="_blank" class="cdx-pill-btn solid"><i class="bi bi-camera-video-fill me-1"></i>Dołącz do Google Meet</a>
                        }
                        <AddToCalendarButton Title="@($"{_nextSession.SessionTypeName} — {_nextSession.TrainerName}")"
                                              StartTime="_nextSession.StartTime" DurationMinutes="_nextSession.DurationMinutes"
                                              Location="@(_nextSession.MeetingUrl ?? "")" Uid="@($"session-{_nextSession.Id}")"
                                              ButtonClass="cdx-pill-btn" Compact="false" />
                        @if (_cancelConfirmId != _nextSession.Id && _cancelDecision?.Allowed == true)
                        {
                            <button class="cdx-link-btn" @onclick="StartCancel"><i class="bi bi-x-circle me-1"></i>Odwołaj</button>
                        }
                    </div>

                    @if (_cancelConfirmId == _nextSession.Id)
                    {
                        <div class="cdx-confirm">
                            @if (_nextSession.IsPair && _nextSession.PartnerActive)
                            {
                                <div class="cdx-confirm-note"><i class="bi bi-people me-1"></i>Odwołujesz tylko siebie — @_nextSession.PartnerName trenuje dalej i dostanie wiadomość.</div>
                            }
                            @if (_cancelDecision is not null)
                            {
                                <div class="cdx-confirm-note @(_cancelDecision.RefundsSession ? "" : "warn")">
                                    <i class="bi @(_cancelDecision.RefundsSession ? "bi-info-circle" : "bi-exclamation-triangle") me-1"></i>@_cancelDecision.Message
                                </div>
                            }
                            <input class="form-control form-control-sm mb-2" placeholder="Powód odwołania (opcjonalnie)" @bind="_cancelReason" />
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-light flex-grow-1" @onclick="() => _cancelConfirmId = null">Wstecz</button>
                                <button class="btn btn-sm btn-danger flex-grow-1" @onclick="ConfirmCancel" disabled="@_cancelling">
                                    @if (_cancelling) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Odwołaj trening
                                </button>
                            </div>
                            @if (_cancelError is not null)
                            {
                                <div class="cdx-confirm-note warn mt-2">@_cancelError</div>
                            }
                        </div>
                    }
                    else if (_cancelDecision is { Allowed: false } && _nextSession.Status == SessionStatus.Scheduled)
                    {
                        <div class="cdx-next-foot"><i class="bi bi-info-circle me-1"></i>@_cancelDecision.Message</div>
                    }
                }
            </div>

            <div class="cdx-card cdx-pkg">
                <div class="cdx-card-head">
                    <h6><i class="bi bi-ticket-perforated"></i>Twój pakiet</h6>
                    <a href="/my/packages" class="cdx-more">Wszystkie <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (_client.ActivePackage is { } pkg)
                {
                    var pct = pkg.TotalSessions > 0 ? (int)((double)pkg.RemainingCredits / pkg.TotalSessions * 100) : 0;
                    <div class="cdx-pkg-body">
                        <div class="cdx-ring" style="--p:@pct"><span><b>@pkg.RemainingCredits</b><small>z @pkg.TotalSessions</small></span></div>
                        <div class="min-w-0">
                            <div class="cdx-pkg-name">@pkg.Name</div>
                            <div class="cdx-pkg-tags">
                                <span class="cdx-tag @(pkg.IsPaid ? "ok" : "warn")">@(pkg.IsPaid ? "Opłacony" : "Oczekuje opłaty")</span>
                                @if (pkg.ExpiresAt.HasValue)
                                {
                                    var daysLeft = (int)(pkg.ExpiresAt.Value - StudioClock.Now).TotalDays;
                                    <span class="cdx-tag @(daysLeft <= 7 ? "warn" : "muted")"><i class="bi bi-calendar-x me-1"></i>@(daysLeft <= 0 ? "Wygasł" : $"jeszcze {daysLeft} dni")</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (pkg.RemainingCredits <= 2)
                    {
                        <a href="/packages" class="cdx-pkg-cta"><i class="bi bi-bag-plus me-1"></i>Kończy się — kup kolejny pakiet</a>
                    }
                }
                else
                {
                    <div class="cdx-empty">
                        <i class="bi bi-box-seam"></i>
                        <div>Nie masz aktywnego pakietu.</div>
                        <a href="/packages" class="btn btn-sm btn-primary mt-2">Wybierz pakiet</a>
                    </div>
                }
            </div>
        </div>

        <!-- Liczby -->
        <div class="cdx-kpis">
            <div class="cdx-kpi">
                <span class="cdx-kpi-ic"><i class="bi bi-ticket-perforated-fill"></i></span>
                <b>@(_client!.ActivePackage?.RemainingCredits ?? 0)</b><small>pozostałe treningi</small>
            </div>
            <div class="cdx-kpi">
                <span class="cdx-kpi-ic green"><i class="bi bi-check2-circle"></i></span>
                <b>@_client.TotalSessions</b><small>ukończone</small>
            </div>
            <div class="cdx-kpi">
                <span class="cdx-kpi-ic violet"><i class="bi bi-speedometer2"></i></span>
                @if (_latestMeasurement?.WeightKg is { } w)
                {
                    <b>
                        @w.ToString("0.#", CultureInfo.InvariantCulture)<em>kg</em>
                        @if (_previousWeight is { } pw && w - pw != 0)
                        {
                            var delta = w - pw;
                            <span class="cdx-delta @(delta < 0 ? "down" : "up")"><i class="bi bi-arrow-@(delta < 0 ? "down" : "up")-short"></i>@Math.Abs(delta).ToString("0.#", CultureInfo.InvariantCulture)</span>
                        }
                    </b>
                }
                else
                {
                    <b class="muted">—</b>
                }
                <small>ostatnia waga</small>
            </div>
            <div class="cdx-kpi">
                <span class="cdx-kpi-ic amber"><i class="bi bi-graph-up-arrow"></i></span>
                @if (_completedCount + _noShowCount > 0)
                {
                    <b>@((int)Math.Round(100.0 * _completedCount / (_completedCount + _noShowCount)))<em>%</em></b>
                }
                else if (_client.TotalSessions > 0)
                {
                    <b>100<em>%</em></b>
                }
                else
                {
                    <b class="muted">—</b>
                }
                <small>frekwencja</small>
            </div>
        </div>

        <!-- Waga + skróty -->
        <div class="cdx-row">
            <div class="cdx-card">
                <div class="cdx-card-head">
                    <h6><i class="bi bi-graph-down-arrow"></i>Postęp wagi</h6>
                    <a href="/my/measurements" class="cdx-more">Pomiary <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (_chartPoints.Count >= 2)
                {
                    <div class="cdx-chart"><canvas id="cd-weight-chart-@_client.Id"></canvas></div>
                }
                else
                {
                    <p class="cdx-muted">Wpisuj wagę raz w tygodniu, a tu zobaczysz wykres postępów.</p>
                }
                <div class="cdx-qw">
                    <label class="cdx-qw-label" for="cdx-qw-input">Dzisiejsza waga</label>
                    <div class="cdx-qw-form">
                        <input id="cdx-qw-input" type="text" inputmode="decimal" class="form-control form-control-sm" placeholder="np. 72.5" @bind="_quickWeight" />
                        <span class="cdx-qw-unit">kg</span>
                        <button class="btn btn-sm btn-primary" @onclick="LogQuickWeightAsync" disabled="@_weightSaving">
                            @if (_weightSaving) { <span class="spinner-border spinner-border-sm"></span> }
                            else { <i class="bi bi-check-lg"></i><span class="ms-1">Zapisz</span> }
                        </button>
                    </div>
                    @if (_weightMsg is not null)
                    {
                        <div class="cdx-qw-msg @(_weightMsgOk ? "ok" : "err")">@_weightMsg</div>
                    }
                </div>
            </div>

            <div class="cdx-card cdx-links">
                <div class="cdx-card-head"><h6><i class="bi bi-grid"></i>Na skróty</h6></div>
                <a href="/my/stats"><i class="bi bi-bar-chart-line"></i><span>Statystyki i rekordy</span><i class="bi bi-chevron-right"></i></a>
                <a href="/my/measurements"><i class="bi bi-rulers"></i><span>Pomiary i zdjęcia</span><i class="bi bi-chevron-right"></i></a>
                <a href="/my/packages"><i class="bi bi-box-seam"></i><span>Moje pakiety</span><i class="bi bi-chevron-right"></i></a>
                @if (_coursesEnabled)
                {
                    <a href="/my/courses"><i class="bi bi-mortarboard"></i><span>Moje kursy</span><i class="bi bi-chevron-right"></i></a>
                }
                <a href="/chat"><i class="bi bi-chat-dots"></i><span>Napisz do trenera</span><i class="bi bi-chevron-right"></i></a>
                <a href="/my/profile"><i class="bi bi-person-circle"></i><span>Mój profil</span><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>

        <!-- Historia + dla Ciebie -->
        <div class="cdx-row">
            <div class="cdx-card">
                <div class="cdx-card-head">
                    <h6><i class="bi bi-clock-history"></i>Ostatnie treningi</h6>
                    <a href="/sessions" class="cdx-more">Wszystkie <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (_recentPast.Any())
                {
                    <div class="cdx-recent">
                        @foreach (var s in _recentPast)
                        {
                            <div class="cdx-recent-item">
                                <div class="cdx-recent-date"><b>@s.StartTime.ToString("dd.MM")</b><small>@s.StartTime.ToString("HH:mm")</small></div>
                                <div class="min-w-0 flex-grow-1">
                                    <div class="cdx-recent-title">@s.SessionTypeName</div>
                                    <div class="cdx-recent-sub">@s.DurationMinutes min · @s.TrainerName</div>
                                </div>
                                <span class="cdx-tag @StatusClass(s.Status)">@StatusLabel(s.Status)</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="cdx-muted">Tu pojawi się historia Twoich treningów.</p>
                }
            </div>

            <div class="cdx-card cdx-offer">
                <div class="cdx-card-head"><h6><i class="bi bi-stars"></i>Dla Ciebie</h6></div>
                <a href="/packages" class="cdx-offer-item">
                    <span class="cdx-offer-ic green"><i class="bi bi-box-seam-fill"></i></span>
                    <span><b>Pakiety w lepszej cenie</b><small>Im więcej treningów, tym taniej za jeden.</small></span>
                </a>
                @if (_coursesEnabled)
                {
                    <a href="/courses" class="cdx-offer-item">
                        <span class="cdx-offer-ic blue"><i class="bi bi-collection-play-fill"></i></span>
                        <span><b>Kursy online</b><small>Wiedza od trenera dostępna o każdej porze.</small></span>
                    </a>
                }
            </div>
        </div>
    </div>
    </PullToRefresh>
}

@code {
    private static readonly CultureInfo _pl = new("pl-PL");

    [Parameter] public string? UserId { get; set; }
    [Parameter] public int? ClientIdOverride { get; set; }

    private bool _loaded;
    private bool _loading;
    private ClientDto? _client;
    private SessionDto? _nextSession;
    private PTScheduler.Application.Scheduling.CancellationDecision? _cancelDecision;
    private List<SessionDto> _recentPast = [];
    private int _upcomingCount;
    private BodyMeasurementDto? _latestMeasurement;
    private List<(string Date, double Value)> _chartPoints = [];
    private string? _errorMsg;

    // Session cancel
    private int? _cancelConfirmId;
    private string? _cancelReason;
    private string? _cancelError;
    private bool _cancelling;

    // Computed stats
    private decimal? _previousWeight;
    private int _completedCount;
    private int _noShowCount;
    private int _streakCount;

    // Quick weight entry
    private string? _quickWeight;
    private bool _weightSaving;
    private string? _weightMsg;
    private bool _weightMsgOk;

    // Chart re-render trigger
    private bool _chartNeedsRender;

    // Courses module
    private bool _coursesEnabled;
    private bool _trainingEnabled;

    private async Task RefreshAsync()
    {
        _loading = false;
        await OnParametersSetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loading) return;
        _loading = true;
        try
        {
            _loaded = false;
            _client = null;
            _errorMsg = null;
            _coursesEnabled = (await ModuleSettings.GetAsync()).CoursesEnabled;
            _trainingEnabled = Entitlements.IsAllowed("TrainingPlansEnabled");
            try
            {
                if (ClientIdOverride.HasValue)
                    _client = await ClientService.GetClientAsync(ClientIdOverride.Value);
                else if (!string.IsNullOrEmpty(UserId))
                    _client = await ClientService.GetClientByUserIdAsync(UserId);

                if (_client is not null)
                {
                    var upcoming = await SessionService.GetUpcomingAsync(clientId: _client.Id, count: 10);
                    _upcomingCount = upcoming.Count;
                    _nextSession   = upcoming.FirstOrDefault();
                    _cancelDecision = _nextSession is null || ClientIdOverride.HasValue
                        ? null
                        : await SessionService.GetClientCancellationAsync(_nextSession.Id, _client.ApplicationUserId);

                    var allRecent = await SessionService.GetClientSessionsAsync(_client.Id, 50);
                    var pastSessions = allRecent.Where(s => s.StartTime < StudioClock.Now).ToList();
                    _recentPast    = pastSessions.Take(5).ToList();
                    _completedCount = pastSessions.Count(s => s.Status == SessionStatus.Completed);
                    _noShowCount = pastSessions.Count(s => s.Status == SessionStatus.NoShow);
                    _streakCount = CalcStreak(pastSessions);

                    var measurements = await MeasurementService.GetAsync(_client.Id);
                    _latestMeasurement = measurements.OrderByDescending(m => m.MeasurementDate).FirstOrDefault();
                    var weightHistory = measurements.Where(m => m.WeightKg.HasValue).OrderByDescending(m => m.MeasurementDate).ToList();
                    _previousWeight = weightHistory.Count >= 2 ? weightHistory[1].WeightKg : null;

                    _chartPoints = measurements
                        .Where(m => m.WeightKg.HasValue)
                        .OrderByDescending(m => m.MeasurementDate)
                        .Take(6)
                        .OrderBy(m => m.MeasurementDate)
                        .Select(m => (m.MeasurementDate.ToString("dd.MM"), (double)m.WeightKg!.Value))
                        .ToList();

                    if (_chartPoints.Count >= 2) _chartNeedsRender = true;
                }
            }
            catch (Exception ex)
            {
                _errorMsg = $"Błąd ładowania danych: {ex.Message}";
            }
            _loaded = true;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender && _client is not null && _chartPoints.Count >= 2)
        {
            _chartNeedsRender = false;
            try
            {
                await JS.InvokeVoidAsync("PTChart.renderLine",
                    $"cd-weight-chart-{_client.Id}",
                    _chartPoints.Select(p => p.Date).ToArray(),
                    _chartPoints.Select(p => p.Value).ToArray(),
                    "Waga", "kg");
            }
            catch { /* chart helper may be missing in some renderers; ignore */ }
        }
    }

    // ---- Cancel session ----

    private void StartCancel()
    {
        _cancelConfirmId = _nextSession?.Id;
        _cancelReason = null;
        _cancelError = null;
    }

    private async Task ConfirmCancel()
    {
        if (_nextSession is null || _client is null) return;
        _cancelling = true;
        _cancelError = null;
        try
        {
            await SessionService.ClientCancelSessionAsync(_nextSession.Id, _client.ApplicationUserId, _cancelReason);
            // Reload data
            _cancelConfirmId = null;
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            _cancelError = ex.Message;
        }
        finally
        {
            _cancelling = false;
        }
    }

    // ---- Hero formatting ----

    private string CountdownLabel(DateTime when)
    {
        var diff = when - StudioClock.Now;
        if (diff.TotalSeconds < 0) return "Już trwa";
        if (diff.TotalMinutes < 60) return $"Za {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24)
        {
            var h = (int)diff.TotalHours;
            var m = diff.Minutes;
            return m > 0 ? $"Za {h}h {m}min" : $"Za {h}h";
        }
        if (diff.TotalDays < 2) return "Jutro";
        if (diff.TotalDays < 7) return $"Za {(int)diff.TotalDays} dni";
        return when.ToString("d MMM", _pl);
    }

    // Trening w ciągu 4 godzin — wyróżniamy go na karcie.
    private bool IsSoon() => _nextSession is not null && (_nextSession.StartTime - StudioClock.Now).TotalHours < 4;

    private static string Capital(string s) => s.Length == 0 ? s : char.ToUpper(s[0], _pl) + s[1..];

    private string FormatWhen(DateTime when)
    {
        var label = when.ToString("dddd, d MMMM, HH:mm", _pl);
        return char.ToUpper(label[0], _pl) + label[1..];
    }

    // ---- Status helpers ----

    private static string StatusClass(SessionStatus s) => s switch
    {
        SessionStatus.Completed       => "ok",
        SessionStatus.Cancelled       => "danger",
        SessionStatus.NoShow          => "muted",
        SessionStatus.AwaitingPackage => "warn",
        _                             => "info"
    };

    private static string StatusLabel(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled       => "Zaplanowana",
        SessionStatus.Completed       => "Ukończona",
        SessionStatus.Cancelled       => "Anulowana",
        SessionStatus.NoShow          => "Nieobecność",
        SessionStatus.AwaitingPackage => "Bez pakietu",
        _                             => s.ToString()
    };

    // ---- Quick weight entry ----

    private async Task LogQuickWeightAsync()
    {
        if (_client is null) return;
        if (!decimal.TryParse(_quickWeight?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var w) || w < 20 || w > 400)
        {
            _weightMsg = "Podaj poprawną wagę (20–400 kg)";
            _weightMsgOk = false;
            return;
        }
        _weightSaving = true;
        _weightMsg = null;
        try
        {
            await MeasurementService.AddAsync(new CreateBodyMeasurementDto
            {
                ClientId = _client.Id,
                MeasurementDate = DateOnly.FromDateTime(StudioClock.Today),
                WeightKg = w
            });
            _quickWeight = null;
            _weightMsg = "Zapisano!";
            _weightMsgOk = true;
            var measurements = await MeasurementService.GetAsync(_client.Id);
            _latestMeasurement = measurements.OrderByDescending(m => m.MeasurementDate).FirstOrDefault();
            var wh = measurements.Where(m => m.WeightKg.HasValue).OrderByDescending(m => m.MeasurementDate).ToList();
            _previousWeight = wh.Count >= 2 ? wh[1].WeightKg : null;
            _chartPoints = measurements.Where(m => m.WeightKg.HasValue)
                .OrderByDescending(m => m.MeasurementDate).Take(6)
                .OrderBy(m => m.MeasurementDate)
                .Select(m => (m.MeasurementDate.ToString("dd.MM"), (double)m.WeightKg!.Value)).ToList();
            if (_chartPoints.Count >= 2) _chartNeedsRender = true;
        }
        catch (Exception ex)
        {
            _weightMsg = ex.Message;
            _weightMsgOk = false;
        }
        finally { _weightSaving = false; }
    }

    private static int CalcStreak(List<SessionDto> pastSessions)
    {
        int streak = 0;
        foreach (var s in pastSessions
            .Where(s => s.Status is SessionStatus.Completed or SessionStatus.NoShow or SessionStatus.Cancelled)
            .OrderByDescending(s => s.StartTime))
        {
            if (s.Status == SessionStatus.Completed) streak++;
            else break;
        }
        return streak;
    }
}
