@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@using PTScheduler.Domain.Constants
@inject ISessionService SessionService
@inject IClientService ClientService
@inject ISessionPackageService PackageService

@if (!_loaded)
{
    <div class="text-center py-4"><div class="spinner-border text-primary" style="width:1.5rem;height:1.5rem"></div></div>
}
else
{
    <div class="page-header">
        <h4 class="page-title"><i class="bi bi-calendar3 me-2" style="color:var(--c-primary)"></i>Mój dzień</h4>
        <a href="/calendar" class="btn btn-sm btn-primary"><i class="bi bi-calendar3 me-1"></i>Kalendarz</a>
    </div>

    <!-- KPI stat cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-calendar-week-fill"></i></div>
                <div>
                    <div class="stat-value">@_thisWeekCount</div>
                    <div class="stat-label">Sesje w tym tygodniu</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:#F0FDF4;color:#16A34A">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@_thisMonthCompleted</div>
                    <div class="stat-label">Ukończone w @MonthLocative(DateTime.Now.Month)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:#EFF6FF;color:#3B82F6">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@_activeClientsCount</div>
                    <div class="stat-label">Aktywnych klientów</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:#FEF3C7;color:#D97706">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@_expiring.Count</div>
                    <div class="stat-label">Pakiety wygasają</div>
                </div>
            </div>
        </div>
    </div>

    @if (_awaiting.Any())
    {
        var awaitingGroups = _awaiting.GroupBy(s => s.ClientId).ToList();
        <div class="card mb-3" style="border-left:4px solid #D97706">
            <div class="card-header d-flex align-items-center justify-content-between py-2 flex-wrap gap-2"
                 style="background:rgba(217,119,6,.08)">
                <span class="fw-semibold" style="color:#92400E">
                    <i class="bi bi-exclamation-triangle-fill me-2" style="color:#D97706"></i>Oczekują na pakiet
                </span>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-white" style="background:#D97706">@_awaiting.Count sesji</span>
                    <a href="/sessions" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:.75rem">
                        Przejdź do wizyt <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @foreach (var g in awaitingGroups)
                {
                    var sessions = g.ToList();
                    var first = sessions[0];
                    var initials = string.Concat(first.ClientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
                    <div class="px-3 py-2 @(g != awaitingGroups.Last() ? "border-bottom" : "")">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div class="avatar-circle flex-shrink-0" style="width:28px;height:28px;font-size:.65rem">@initials</div>
                            <span class="fw-semibold" style="font-size:.875rem">@first.ClientName</span>
                            @if (sessions.Count > 1)
                            {
                                <span class="badge rounded-pill bg-warning text-dark ms-auto" style="font-size:.65rem">@sessions.Count×</span>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2 ms-1" style="padding-left:36px">
                            @foreach (var s in sessions)
                            {
                                <a href="/sessions" class="text-decoration-none">
                                    <span class="badge rounded-pill border"
                                          style="font-size:.7rem;color:#92400E;background:rgba(217,119,6,.12);border-color:rgba(217,119,6,.3)!important">
                                        @s.StartTime.ToString("dd.MM HH:mm") · @s.SessionTypeName
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row g-3 mb-3">
        <!-- Today -->
        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-sun me-2"></i>Dziś — @DateTime.Now.ToString("dd MMMM")</span>
                    <span class="badge" style="background:var(--c-primary-light);color:var(--c-primary)">@_today.Count</span>
                </div>
                <div class="card-body p-0">
                    @if (!_today.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-calendar-x d-block fs-3 mb-2"></i>Brak sesji na dziś
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var s in _today)
                            {
                                <div class="list-group-item d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="text-center flex-shrink-0" style="min-width:48px">
                                        <div class="fw-bold" style="font-size:1rem;color:var(--c-primary)">@s.StartTime.ToString("HH:mm")</div>
                                        <div class="text-muted" style="font-size:.7rem">@s.DurationMinutes min</div>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@s.ClientName</div>
                                        <div class="text-muted" style="font-size:.75rem">@s.SessionTypeName</div>
                                    </div>
                                    <span class="badge rounded-pill @StatusBadge(s.Status)" style="font-size:.65rem">@StatusLabel(s.Status)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming -->
        <div class="col-12 col-lg-7">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-arrow-right-circle me-2"></i>Nadchodzące wizyty</div>
                <div class="card-body p-0">
                    @if (!_upcoming.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-calendar-check d-block fs-3 mb-2"></i>Brak zaplanowanych wizyt
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var s in _upcoming)
                            {
                                <a href="/clients/@s.ClientId" class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="flex-shrink-0 text-center" style="min-width:52px">
                                        <div class="fw-semibold" style="font-size:.8rem;color:var(--c-primary)">@s.StartTime.ToString("dd.MM")</div>
                                        <div class="text-muted" style="font-size:.7rem">@s.StartTime.ToString("HH:mm")</div>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@s.ClientName</div>
                                        <div class="text-muted" style="font-size:.75rem">@s.SessionTypeName · @s.DurationMinutes min</div>
                                    </div>
                                    <div class="text-muted" style="font-size:.7rem;white-space:nowrap">@DaysUntil(s.StartTime)</div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Expiring packages -->
        <div class="col-12 col-lg-7">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-exclamation-triangle me-2" style="color:#D97706"></i>Pakiety wygasające (14 dni)</span>
                    @if (_expiring.Any())
                    {
                        <span class="badge bg-warning text-dark">@_expiring.Count</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!_expiring.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-check-circle d-block fs-3 mb-2" style="color:#16A34A"></i>Brak pakietów wygasających w ciągu 14 dni
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var p in _expiring)
                            {
                                <a href="/clients/@p.ClientId" class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@p.ClientName</div>
                                        <div class="text-muted" style="font-size:.75rem">@p.PackageName · @p.RemainingCredits pozostałych</div>
                                    </div>
                                    <span class="badge rounded-pill @(p.DaysLeft <= 3 ? "bg-danger" : p.DaysLeft <= 7 ? "bg-warning text-dark" : "bg-secondary")">
                                        @(p.DaysLeft == 0 ? "dziś" : $"{p.DaysLeft} d.")
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Pending clients -->
        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-hourglass-split me-2"></i>Oczekują na zatwierdzenie</span>
                    @if (_pending.Any())
                    {
                        <span class="badge bg-warning text-dark">@_pending.Count</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!_pending.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-check-all d-block fs-3 mb-2" style="color:#16A34A"></i>Brak oczekujących
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var c in _pending)
                            {
                                <a href="/clients/@c.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="avatar-circle flex-shrink-0" style="width:32px;height:32px;font-size:.75rem">@c.Initials</div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@c.FullName</div>
                                        <div class="text-muted text-truncate" style="font-size:.75rem">@c.Email</div>
                                    </div>
                                    <span class="badge bg-warning text-dark" style="font-size:.65rem">Oczekuje</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? TrainerUserId { get; set; }

    private bool _loaded;
    private List<SessionDto> _today = [];
    private List<SessionDto> _upcoming = [];
    private List<SessionDto> _awaiting = [];
    private List<ExpiringPackageDto> _expiring = [];
    private List<ClientDto> _pending = [];

    private int _thisWeekCount;
    private int _thisMonthCompleted;
    private int _activeClientsCount;
    private bool _loading;

    protected override async Task OnParametersSetAsync()
    {
        if (_loading) return;
        _loading = true;
        try
        {
            _loaded = false;
            var now = DateTime.Now;
            var todayStart = new DateTime(now.Year, now.Month, now.Day);
            var todayEnd   = todayStart.AddDays(1);

            _today    = await SessionService.GetSessionsAsync(todayStart, todayEnd, TrainerUserId);
            _upcoming = (await SessionService.GetUpcomingAsync(trainerUserId: TrainerUserId, count: 8))
                            .Where(s => s.StartTime.Date > DateTime.Now.Date).ToList();
            _awaiting = await SessionService.GetAwaitingPackageAsync(TrainerUserId);
            _expiring = await PackageService.GetExpiringAsync(14, TrainerUserId);
            _pending  = await ClientService.GetPendingClientsAsync(TrainerUserId);

            // Stats
            var weekDay = (int)now.DayOfWeek;
            var mondayOffset = weekDay == 0 ? -6 : 1 - weekDay;
            var weekStart = todayStart.AddDays(mondayOffset);
            var weekEnd = weekStart.AddDays(7);
            var monthStart = new DateTime(now.Year, now.Month, 1);
            var statsFrom = weekStart.AddDays(-7 * 7);

            var statsSessions = await SessionService.GetSessionsAsync(statsFrom, weekEnd, TrainerUserId);
            _thisWeekCount = statsSessions.Count(s =>
                s.StartTime >= weekStart &&
                s.Status != SessionStatus.Cancelled &&
                s.Status != SessionStatus.NoShow);

            _thisMonthCompleted = (await SessionService.GetSessionsAsync(monthStart, now.AddDays(1), TrainerUserId))
                .Count(s => s.Status == SessionStatus.Completed);

            _activeClientsCount = (await ClientService.GetClientsAsync(TrainerUserId))
                .Count(c => c.Status == ClientStatus.Active);

            _loaded = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string MonthLocative(int m) => m switch
    {
        1 => "styczniu", 2 => "lutym",     3 => "marcu",      4 => "kwietniu",
        5 => "maju",     6 => "czerwcu",   7 => "lipcu",      8 => "sierpniu",
        9 => "wrześniu", 10 => "październiku", 11 => "listopadzie", 12 => "grudniu",
        _ => ""
    };

    private static string DaysUntil(DateTime dt)
    {
        var diff = (dt.Date - DateTime.Now.Date).Days;
        return diff switch { 0 => "dziś", 1 => "jutro", _ => $"za {diff} dni" };
    }

    private static string StatusBadge(SessionStatus s) => s switch
    {
        SessionStatus.Completed       => "bg-success",
        SessionStatus.Cancelled       => "bg-danger",
        SessionStatus.NoShow          => "bg-secondary",
        SessionStatus.AwaitingPackage => "bg-warning text-dark",
        _                             => "bg-primary"
    };

    private static string StatusLabel(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled       => "Zaplanowana",
        SessionStatus.Completed       => "Ukończona",
        SessionStatus.Cancelled       => "Anulowana",
        SessionStatus.NoShow          => "Nieobecność",
        SessionStatus.AwaitingPackage => "Bez pakietu",
        _                             => s.ToString()
    };
}
