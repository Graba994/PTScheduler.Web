@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@inject ISessionService SessionService
@inject IClientService ClientService
@inject ISessionPackageService PackageService

@if (!_loaded)
{
    <div class="text-center py-4"><div class="spinner-border text-primary" style="width:1.5rem;height:1.5rem"></div></div>
}
else
{
    <div class="page-header">
        <h4 class="page-title"><i class="bi bi-calendar3 me-2" style="color:var(--c-primary)"></i>Mój dzień</h4>
        <a href="/calendar" class="btn btn-sm btn-primary"><i class="bi bi-calendar3 me-1"></i>Kalendarz</a>
    </div>

    <div class="row g-3 mb-3">
        <!-- Today -->
        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-sun me-2"></i>Dziś — @DateTime.Now.ToString("dd MMMM")</span>
                    <span class="badge" style="background:var(--c-primary-light);color:var(--c-primary)">@_today.Count</span>
                </div>
                <div class="card-body p-0">
                    @if (!_today.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-calendar-x d-block fs-3 mb-2"></i>Brak sesji na dziś
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var s in _today)
                            {
                                <div class="list-group-item d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="text-center flex-shrink-0" style="min-width:48px">
                                        <div class="fw-bold" style="font-size:1rem;color:var(--c-primary)">@s.StartTime.ToLocalTime().ToString("HH:mm")</div>
                                        <div class="text-muted" style="font-size:.7rem">@s.DurationMinutes min</div>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@s.ClientName</div>
                                        <div class="text-muted" style="font-size:.75rem">@s.SessionTypeName</div>
                                    </div>
                                    <span class="badge rounded-pill @StatusBadge(s.Status)" style="font-size:.65rem">@StatusLabel(s.Status)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming -->
        <div class="col-12 col-lg-7">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-arrow-right-circle me-2"></i>Nadchodzące wizyty</div>
                <div class="card-body p-0">
                    @if (!_upcoming.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-calendar-check d-block fs-3 mb-2"></i>Brak zaplanowanych wizyt
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var s in _upcoming)
                            {
                                <a href="/clients/@s.ClientId" class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="flex-shrink-0 text-center" style="min-width:52px">
                                        <div class="fw-semibold" style="font-size:.8rem;color:var(--c-primary)">@s.StartTime.ToLocalTime().ToString("dd.MM")</div>
                                        <div class="text-muted" style="font-size:.7rem">@s.StartTime.ToLocalTime().ToString("HH:mm")</div>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@s.ClientName</div>
                                        <div class="text-muted" style="font-size:.75rem">@s.SessionTypeName · @s.DurationMinutes min</div>
                                    </div>
                                    <div class="text-muted" style="font-size:.7rem;white-space:nowrap">@DaysUntil(s.StartTime)</div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Expiring packages -->
        <div class="col-12 col-lg-7">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-exclamation-triangle me-2" style="color:#D97706"></i>Pakiety wygasające (14 dni)</span>
                    @if (_expiring.Any())
                    {
                        <span class="badge bg-warning text-dark">@_expiring.Count</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!_expiring.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-check-circle d-block fs-3 mb-2" style="color:#16A34A"></i>Brak pakietów wygasających w ciągu 14 dni
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var p in _expiring)
                            {
                                <a href="/clients/@p.ClientId" class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@p.ClientName</div>
                                        <div class="text-muted" style="font-size:.75rem">@p.PackageName · @p.RemainingCredits pozostałych</div>
                                    </div>
                                    <span class="badge rounded-pill @(p.DaysLeft <= 3 ? "bg-danger" : p.DaysLeft <= 7 ? "bg-warning text-dark" : "bg-secondary")">
                                        @(p.DaysLeft == 0 ? "dziś" : $"{p.DaysLeft} d.")
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Pending clients -->
        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-hourglass-split me-2"></i>Oczekują na zatwierdzenie</span>
                    @if (_pending.Any())
                    {
                        <span class="badge bg-warning text-dark">@_pending.Count</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!_pending.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-check-all d-block fs-3 mb-2" style="color:#16A34A"></i>Brak oczekujących
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var c in _pending)
                            {
                                <a href="/clients/@c.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-2">
                                    <div class="avatar-circle flex-shrink-0" style="width:32px;height:32px;font-size:.75rem">@c.Initials</div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:.875rem">@c.FullName</div>
                                        <div class="text-muted text-truncate" style="font-size:.75rem">@c.Email</div>
                                    </div>
                                    <span class="badge bg-warning text-dark" style="font-size:.65rem">Oczekuje</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? TrainerUserId { get; set; }

    private bool _loaded;
    private List<SessionDto> _today = [];
    private List<SessionDto> _upcoming = [];
    private List<ExpiringPackageDto> _expiring = [];
    private List<ClientDto> _pending = [];

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        var now = DateTime.Now;
        var todayUtcStart = new DateTime(now.Year, now.Month, now.Day, 0, 0, 0, DateTimeKind.Local).ToUniversalTime();
        var todayUtcEnd   = todayUtcStart.AddDays(1);

        var todayTask    = SessionService.GetSessionsAsync(todayUtcStart, todayUtcEnd, TrainerUserId);
        var upcomingTask = SessionService.GetUpcomingAsync(trainerUserId: TrainerUserId, count: 8);
        var expiringTask = PackageService.GetExpiringAsync(14, TrainerUserId);
        var pendingTask  = ClientService.GetPendingClientsAsync(TrainerUserId);

        await Task.WhenAll(todayTask, upcomingTask, expiringTask, pendingTask);

        _today    = todayTask.Result;
        _upcoming = upcomingTask.Result.Where(s => s.StartTime.Date > DateTime.UtcNow.Date).ToList();
        _expiring = expiringTask.Result;
        _pending  = pendingTask.Result;
        _loaded = true;
    }

    private static string DaysUntil(DateTime utc)
    {
        var diff = (utc.ToLocalTime().Date - DateTime.Now.Date).Days;
        return diff switch { 0 => "dziś", 1 => "jutro", _ => $"za {diff} dni" };
    }

    private static string StatusBadge(SessionStatus s) => s switch
    {
        SessionStatus.Completed => "bg-success",
        SessionStatus.Cancelled => "bg-danger",
        SessionStatus.NoShow    => "bg-secondary",
        _                       => "bg-primary"
    };

    private static string StatusLabel(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled => "Zaplanowana",
        SessionStatus.Completed => "Ukończona",
        SessionStatus.Cancelled => "Anulowana",
        SessionStatus.NoShow    => "Nieobecność",
        _                       => s.ToString()
    };
}
