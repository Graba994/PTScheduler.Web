@page "/my/orders"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IPaymentService PaymentService
@inject IReceiptService ReceiptService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Moje zamówienia" />

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h4 class="page-title mb-0"><i class="bi bi-receipt me-2" style="color:var(--c-primary)"></i>Moje zamówienia</h4>
    <div class="d-flex gap-2">
        <a href="/packages" class="btn btn-sm btn-outline-primary"><i class="bi bi-box-seam me-1"></i>Pakiety</a>
        <a href="/courses" class="btn btn-sm btn-outline-primary"><i class="bi bi-collection-play me-1"></i>Kursy</a>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_orders.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-receipt" style="font-size:2.2rem"></i>
        <p class="mt-2 mb-3">Nie masz jeszcze zamówień.</p>
        <div class="d-flex gap-2 justify-content-center">
            <a href="/packages" class="btn btn-primary"><i class="bi bi-box-seam me-1"></i>Kup pakiet</a>
            <a href="/courses" class="btn btn-outline-primary"><i class="bi bi-collection-play me-1"></i>Przeglądaj kursy</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Produkt</th>
                        <th>Typ</th>
                        <th class="text-end">Kwota</th>
                        <th>Bramka</th>
                        <th>Status</th>
                        <th>Data</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in _orders)
                    {
                        <tr>
                            <td class="fw-semibold">@o.ItemTitle</td>
                            <td>
                                <span class="badge @KindBadge(o.Kind)">@KindLabel(o.Kind)</span>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (o.HasDiscount)
                                {
                                    <span class="text-muted text-decoration-line-through small">@o.OriginalAmount!.Value.ToString("0.00")</span>
                                    <span class="ms-1">@o.Amount.ToString("0.00") @o.Currency</span>
                                    <div class="small text-success"><i class="bi bi-tag me-1"></i>@o.CouponCode (−@o.DiscountAmount!.Value.ToString("0.00"))</div>
                                }
                                else
                                {
                                    @($"{o.Amount:0.00} {o.Currency}")
                                }
                            </td>
                            <td class="text-muted small">@(o.Provider ?? "—")</td>
                            <td>
                                <span class="badge @BadgeClass(o.Status)">@StatusLabel(o.Status)</span>
                            </td>
                            <td class="text-nowrap text-muted">
                                @o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                @if (o.PaidAt.HasValue)
                                {
                                    <div class="small text-success"><i class="bi bi-check-circle me-1"></i>@o.PaidAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                }
                            </td>
                            <td>
                                @if (o.Status == "Paid")
                                {
                                    <button class="btn btn-sm btn-outline-secondary" title="Pobierz potwierdzenie"
                                            @onclick="() => DownloadReceipt(o.Id)" disabled="@(_downloadingId == o.Id)">
                                        @if (_downloadingId == o.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        }
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<OrderDto> _orders = [];
    private int? _downloadingId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _orders = await PaymentService.GetMyOrdersAsync(userId);
        _loading = false;
    }

    private async Task DownloadReceipt(int orderId)
    {
        _downloadingId = orderId;
        try
        {
            var (bytes, fileName) = await ReceiptService.GenerateReceiptAsync(orderId);
            await JS.InvokeVoidAsync("PTExport.downloadCsv", fileName, bytes);
        }
        catch { }
        finally { _downloadingId = null; }
    }

    private static string StatusLabel(string s) => s switch
    {
        "Paid" => "Opłacone",
        "Pending" => "Oczekuje",
        "Canceled" => "Anulowane",
        "Failed" => "Nieudane",
        _ => s
    };

    private static string BadgeClass(string s) => s switch
    {
        "Paid" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Canceled" => "bg-secondary",
        "Failed" => "bg-danger",
        _ => "bg-secondary"
    };

    private static string KindLabel(string? k) => k switch
    {
        "Course" => "Kurs",
        "Package" => "Pakiet",
        _ => "Zamówienie"
    };

    private static string KindBadge(string? k) => k switch
    {
        "Course" => "bg-info-subtle text-info-emphasis",
        "Package" => "bg-primary-subtle text-primary-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}
