@page "/stats"
@rendermode PTScheduler.Web.RenderModes.Server
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@using PTScheduler.Domain.Constants
@inject ISessionService SessionService
@inject IClientService ClientService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject EntitlementService Entitlements
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")]

@if (!Entitlements.IsAllowed("AdvancedAnalytics"))
{
    <div class="alert alert-primary d-flex align-items-center gap-3 mb-3">
        <i class="bi bi-arrow-up-circle fs-4"></i>
        <div class="flex-grow-1 small">
            Widzisz <strong>podstawowe statystyki</strong>. Zaawansowana analityka (kohorty, retencja, LTV, prognozy) jest w planie <strong>Pro</strong>.
        </div>
        <a href="/upgrade" class="btn btn-sm btn-primary">Zwiększ plan</a>
    </div>
}

@if (!_loaded)
{
    <div class="page-header mb-3">
        <div class="skeleton skeleton-line w-40" style="height:24px;margin-bottom:0"></div>
        <div class="skeleton" style="width:120px;height:32px;border-radius:8px"></div>
    </div>
    <div class="row g-3 mb-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-6 col-xl-3">
                <div class="skeleton-stat">
                    <div class="skeleton skeleton-circle" style="width:40px;height:40px"></div>
                    <div style="flex:1">
                        <div class="skeleton skeleton-line w-40" style="height:20px"></div>
                        <div class="skeleton skeleton-line w-75" style="height:10px;margin-bottom:0"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="skeleton-card" style="height:200px"></div>
}
else
{
    <AuthorizeView Roles="Admin,Trainer">
        <div class="seg-tabs mb-3" role="tablist" aria-label="Statystyki">
            <a class="seg-tab active" href="/stats" aria-current="page"><i class="bi bi-bar-chart-line"></i>Aktywność</a>
            <a class="seg-tab" href="/stats/business"><i class="bi bi-graph-up-arrow"></i>Biznes</a>
        </div>
    </AuthorizeView>
    <div class="page-header">
        <h4 class="page-title"><i class="bi bi-bar-chart-line-fill me-2" style="color:var(--c-primary)"></i>Statystyki</h4>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn @(_months == 3 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(3)">3M</button>
            <button type="button" class="btn @(_months == 6 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(6)">6M</button>
            <button type="button" class="btn @(_months == 12 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(12)">12M</button>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="stat-card st-card">
                <div class="stat-icon"><i class="bi bi-calendar3"></i></div>
                <div>
                    <div class="stat-value">@_sessions.Count</div>
                    <div class="stat-label">Sesji łącznie</div>
                </div>
                <InfoTip Title="Sesji łącznie" Class="info-tip-sm st-info" Text="Wszystkie wizyty z wybranego okresu (3, 6 albo 12 miesięcy), niezależnie od statusu: odbyte, odwołane, nieobecności, zaplanowane na dziś i jutro oraz czekające na pakiet." />
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card st-card">
                <div class="stat-icon stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_sessions.Count(s => s.Status == SessionStatus.Completed)</div>
                    <div class="stat-label">Ukończone</div>
                </div>
                <InfoTip Title="Ukończone" Class="info-tip-sm st-info" Text="Treningi, które się odbyły (wizyty oznaczone jako ukończone). To one liczą się do retencji w zakładce Biznes i do medali klientów." />
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card st-card">
                <div class="stat-icon stat-icon-red"><i class="bi bi-x-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_sessions.Count(s => s.Status == SessionStatus.Cancelled)</div>
                    <div class="stat-label">Anulowane</div>
                </div>
                <InfoTip Title="Anulowane" Class="info-tip-sm st-info" Text="Wizyty odwołane — przez klienta albo przez Ciebie, z wyprzedzeniem lub po terminie. Szczegóły (np. które godziny są najczęściej odwoływane) znajdziesz w zakładce Biznes." />
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card st-card">
                <div class="stat-icon stat-icon-amber"><i class="bi bi-person-dash-fill"></i></div>
                <div>
                    <div class="stat-value">@_sessions.Count(s => s.Status == SessionStatus.NoShow)</div>
                    <div class="stat-label">Nieobecności</div>
                </div>
                <InfoTip Title="Nieobecności" Class="info-tip-sm st-info" Text="Klient nie przyszedł i wcześniej nie odwołał wizyty. Częste nieobecności to dobry powód do rozmowy albo do ustawienia zasad odwoływania z opłatą." />
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-8">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold d-flex align-items-center" style="font-size:.875rem">
                    <i class="bi bi-bar-chart-fill me-2" style="color:var(--c-primary)"></i>Sesje — miesięcznie
                    <InfoTip Title="Sesje — miesięcznie" Class="info-tip-sm ms-auto" Text="Dwa słupki dla każdego miesiąca: wszystkie wizyty i te ukończone. Duża różnica między nimi oznacza dużo odwołań albo nieobecności w tym miesiącu. W bieżącym miesiącu część wizyt jest jeszcze przed Tobą." />
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="stats-bar"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold d-flex align-items-center" style="font-size:.875rem">
                    <i class="bi bi-pie-chart-fill me-2" style="color:var(--c-primary)"></i>Statusy
                    <InfoTip Title="Statusy wizyt" Class="info-tip-sm ms-auto">
                        <ul class="st-info-list">
                            <li><b>Ukończone</b> — trening się odbył.</li>
                            <li><b>Anulowane</b> — wizyta odwołana.</li>
                            <li><b>Nieobecność</b> — klient nie przyszedł i nie odwołał.</li>
                            <li><b>Zaplanowane</b> — wizyta jeszcze przed Wami.</li>
                            <li><b>Bez pakietu</b> — termin jest zarezerwowany, ale klient nie ma wolnych treningów w pakiecie; czeka na zakup albo płatność.</li>
                        </ul>
                    </InfoTip>
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="stats-donut"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header py-2 fw-semibold d-flex align-items-center" style="font-size:.875rem">
            <i class="bi bi-trophy-fill me-2" style="color:var(--c-primary)"></i>Top klienci — liczba sesji
            <InfoTip Title="Top klienci" Class="info-tip-sm ms-auto" Text="10 osób z największą liczbą ukończonych treningów w wybranym okresie. „Łącznie” liczy wszystkie ich wizyty — także odwołane, nieobecności i zaplanowane." />
        </div>
        <div class="card-body p-0">
            @if (!_topClients.Any())
            {
                <div class="text-center text-muted py-4 small">Brak danych za wybrany okres</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-stack table-hover mb-0" style="font-size:.875rem">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Klient</th>
                                <th class="text-center">Ukończone</th>
                                <th class="text-center">Łącznie</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rank = 1;
                            }
                            @foreach (var (name, completed, total, clientId) in _topClients)
                            {
                                <tr>
                                    <td class="text-muted" style="width:40px">@(rank++)</td>
                                    <td><a href="/clients/@clientId" class="text-decoration-none fw-semibold">@name</a></td>
                                    <td class="text-center"><span class="badge bg-success">@completed</span></td>
                                    <td class="text-center text-muted">@total</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<style>
    .st-card { position: relative; padding-right: 2.2rem; }
    .st-info { position: absolute; top: .5rem; right: .5rem; }
    .st-info-list { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .4rem; }
</style>

@code {
    private bool _loaded;
    private int _months = 3;
    private string? _trainerUserId;
    private List<SessionDto> _sessions = [];
    private List<(string Name, int Completed, int Total, int ClientId)> _topClients = [];
    private bool _chartNeedsRender;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var isAdmin = auth.User.IsInRole(Roles.Admin);
        _trainerUserId = isAdmin ? null : auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender)
        {
            _chartNeedsRender = false;
            await RenderChartsAsync();
        }
    }

    private async Task ChangeRange(int months)
    {
        _months = months;
        _loaded = false;
        StateHasChanged();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var from = StudioClock.Now.AddMonths(-_months);
        var to = StudioClock.Now.AddDays(1);
        _sessions = await SessionService.GetSessionsAsync(from, to, _trainerUserId);

        var clients = await ClientService.GetClientsAsync(_trainerUserId);
        _topClients = _sessions
            .GroupBy(s => s.ClientId)
            .Select(g =>
            {
                var c = clients.FirstOrDefault(x => x.Id == g.Key);
                return (
                    Name: c?.FullName ?? "Nieznany",
                    Completed: g.Count(s => s.Status == SessionStatus.Completed),
                    Total: g.Count(),
                    ClientId: g.Key
                );
            })
            .OrderByDescending(x => x.Completed)
            .Take(10)
            .ToList();

        _loaded = true;
        _chartNeedsRender = true;
    }

    private async Task RenderChartsAsync()
    {
        var monthSlots = Enumerable.Range(0, _months)
            .Select(i => StudioClock.Now.AddMonths(-(_months - 1 - i)))
            .Select(d => (Label: d.ToString("MM.yy"), Year: d.Year, Month: d.Month))
            .ToList();

        var barLabels = monthSlots.Select(m => m.Label).ToArray();
        var barCompleted = monthSlots
            .Select(m => (double)_sessions.Count(s =>
                s.StartTime.Year == m.Year && s.StartTime.Month == m.Month &&
                s.Status == SessionStatus.Completed))
            .ToArray();
        var barAll = monthSlots
            .Select(m => (double)_sessions.Count(s =>
                s.StartTime.Year == m.Year && s.StartTime.Month == m.Month))
            .ToArray();

        await JS.InvokeVoidAsync("PTChart.renderBar", "stats-bar", barLabels,
            new object[]
            {
                new { label = "Ukończone", data = barCompleted },
                new { label = "Wszystkie", data = barAll }
            });

        var completed = _sessions.Count(s => s.Status == SessionStatus.Completed);
        var cancelled = _sessions.Count(s => s.Status == SessionStatus.Cancelled);
        var noShow = _sessions.Count(s => s.Status == SessionStatus.NoShow);
        var scheduled = _sessions.Count(s => s.Status == SessionStatus.Scheduled);
        var awaiting = _sessions.Count(s => s.Status == SessionStatus.AwaitingPackage);

        await JS.InvokeVoidAsync("PTChart.renderDoughnut", "stats-donut",
            new[] { "Ukończone", "Anulowane", "Nieobecność", "Zaplanowane", "Bez pakietu" },
            new double[] { completed, cancelled, noShow, scheduled, awaiting },
            new[] { "#16A34A", "#DC2626", "#D97706", "#3B82F6", "#9CA3AF" });
    }
}
