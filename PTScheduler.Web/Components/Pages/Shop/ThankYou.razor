@page "/shop/thank-you"
@using Microsoft.AspNetCore.Authorization
@layout PTScheduler.Web.Components.Layout.PublicLayout
@attribute [AllowAnonymous]

<PageTitle>Dziękujemy!</PageTitle>

<section class="container py-5 text-center">
    <i class="bi bi-check-circle-fill text-success" style="font-size:4rem;"></i>
    <h1 class="mt-3">Dziękujemy za zakup!</h1>
    <p class="lead text-muted mt-2">
        Twoja płatność jest przetwarzana. Po jej potwierdzeniu otrzymasz dostęp do zakupionego produktu.
    </p>
    <p>
        Jeśli nie masz jeszcze konta — zostanie utworzone automatycznie, a dane logowania
        znajdziesz w panelu trenerki lub otrzymasz mailem.
    </p>
    <div class="mt-4">
        <a href="/" class="btn btn-outline-primary me-2">Strona główna</a>
        <a href="/Account/Login" class="btn btn-primary">Zaloguj się</a>
    </div>
</section>
