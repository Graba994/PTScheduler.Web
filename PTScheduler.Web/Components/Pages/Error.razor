@page "/Error"
@using System.Diagnostics

<PageTitle>Coś nie działa — PTScheduler</PageTitle>

<ErrorScreen Emoji="🛠️"
             Tone="danger"
             Title="Coś poszło nie tak"
             Lead="Wystąpił nieoczekiwany problem przy ładowaniu strony. Już to naprawiamy — spróbuj odświeżyć za moment.">
    <Body>
        <strong>Co możesz zrobić:</strong>
        <ul>
            <li>Odśwież stronę (przycisk poniżej).</li>
            <li>Wróć na stronę główną i spróbuj ponownie.</li>
            <li>Jeśli problem się powtarza — skontaktuj się ze swoim trenerem.</li>
        </ul>
    </Body>
    <Actions>
        <button class="es-btn" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Odśwież stronę
        </button>
        <a href="/" class="es-btn es-btn-ghost">
            <i class="bi bi-house"></i> Strona główna
        </a>
    </Actions>
    <AdminInfo>
        @if (!string.IsNullOrEmpty(RequestId))
        {
            <div class="tech-row">
                <div class="tech-label">Identyfikator zapytania</div>
                <div class="tech-value">@RequestId</div>
            </div>
        }
        <div class="tech-row">
            <div class="tech-label">Czas wystąpienia</div>
            <div class="tech-value">@DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")</div>
        </div>
    </AdminInfo>
</ErrorScreen>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
