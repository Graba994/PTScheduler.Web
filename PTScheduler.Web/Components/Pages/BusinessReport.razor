@page "/stats/business"
@rendermode PTScheduler.Web.RenderModes.Server
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@inject IBusinessReportService ReportSvc
@inject AuthenticationStateProvider AuthState
@inject EntitlementService Entitlements
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Trainer}")]

<AppTitle Page="Raporty biznesowe" />

<div class="page-header flex-wrap gap-2">
    <div class="seg-tabs" role="tablist" aria-label="Statystyki">
        <a class="seg-tab" href="/stats"><i class="bi bi-bar-chart-line"></i>Aktywność</a>
        <a class="seg-tab active" href="/stats/business" aria-current="page"><i class="bi bi-graph-up-arrow"></i>Biznes</a>
    </div>
    @if (Entitlements.IsAllowed("AdvancedAnalytics"))
    {
        <div class="btn-group btn-group-sm" role="group" aria-label="Okres">
            @foreach (var days in new[] { 30, 90, 180 })
            {
                var d = days;
                <button type="button" class="btn @(_days == d ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangePeriod(d)">@d dni</button>
            }
        </div>
    }
</div>

@if (!Entitlements.IsAllowed("AdvancedAnalytics"))
{
    <FeatureGate Flag="AdvancedAnalytics" RequiredPlan="Pro" Title="Raporty biznesowe są w wyższym planie">
        <Description>
            Retencja klientów, średni przychód na klienta, obłożenie grafiku, prognoza przychodu z pakietów i karnetów oraz godziny, w których klienci najczęściej odwołują treningi.
        </Description>
    </FeatureGate>
    return;
}

@if (_report is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    return;
}

@{
    var r = _report;
    var f = r.Forecast;
}

<p class="text-muted small mb-3">Ostatnie @r.PeriodDays dni w porównaniu z poprzednimi @r.PeriodDays dniami. Przychód to opłacone pakiety, karnety i pojedyncze treningi.</p>

<!-- Najważniejsze liczby -->
<div class="br-kpis mb-3">
    <div class="br-kpi">
        <div class="br-kpi-label"><i class="bi bi-arrow-repeat"></i>Retencja</div>
        <div class="br-kpi-value">@(r.RetentionPercent is int ret ? $"{ret}%" : "—")</div>
        @Trend(r.RetentionPercent, r.RetentionPercentPrevious, "pp")
        <div class="br-kpi-help">Tylu klientów z poprzedniego okresu trenuje dalej.</div>
    </div>
    <div class="br-kpi">
        <div class="br-kpi-label"><i class="bi bi-cash-coin"></i>Średnio na klienta</div>
        <div class="br-kpi-value">@Money(r.AvgRevenuePerClient)</div>
        @Trend(r.AvgRevenuePerClient, r.AvgRevenuePerClientPrevious, "zł")
        <div class="br-kpi-help">@r.PayingClients płacących · @Money(r.AvgMonthlyRevenuePerActiveClient) / mies. na aktywnego klienta</div>
    </div>
    <div class="br-kpi">
        <div class="br-kpi-label"><i class="bi bi-calendar-check"></i>Obłożenie grafiku</div>
        <div class="br-kpi-value">@(r.PastOccupancy.Percent is int occ ? $"{occ}%" : "—")</div>
        <div class="br-kpi-help">
            @if (r.PastOccupancy.AvailableMinutes == 0)
            {
                <span>Ustaw <a href="/trainer/availability">godziny pracy</a>, żeby liczyć obłożenie.</span>
            }
            else
            {
                <span>Ostatnie 4 tygodnie · @Hours(r.PastOccupancy.BookedMinutes) z @Hours(r.PastOccupancy.AvailableMinutes)</span>
            }
        </div>
    </div>
    <div class="br-kpi br-kpi-accent">
        <div class="br-kpi-label"><i class="bi bi-graph-up-arrow"></i>Prognoza — @f.Days dni</div>
        <div class="br-kpi-value">@Money(f.Total)</div>
        <div class="br-kpi-help">Odnowienia karnetów i szacowane zakupy kolejnych pakietów.</div>
    </div>
</div>

<div class="row g-3 mb-3">
    <!-- Retencja -->
    <div class="col-12 col-xl-7">
        <section class="card h-100">
            <div class="card-header py-2 fw-semibold small"><i class="bi bi-people me-2 text-primary"></i>Klienci i retencja</div>
            <div class="card-body">
                <div class="br-mini mb-3">
                    <div><strong>@r.ActiveClients</strong><span>aktywnych @Delta(r.ActiveClients - r.ActiveClientsPrevious)</span></div>
                    <div><strong>@r.NewClients</strong><span>nowych</span></div>
                    <div><strong>@r.LostClients.Count</strong><span>przestało przychodzić</span></div>
                </div>
                <div class="small text-muted mb-2">Retencja miesiąc do miesiąca</div>
                <div class="br-months">
                    @foreach (var m in r.RetentionByMonth)
                    {
                        <div class="br-month" title="@m.Label: @m.ActiveClients aktywnych">
                            <div class="br-month-bar"><span style="height:@(m.RetentionPercent ?? 0)%"></span></div>
                            <div class="br-month-value">@(m.RetentionPercent is int p ? $"{p}%" : "—")</div>
                            <div class="br-month-label">@m.Label</div>
                        </div>
                    }
                </div>
                @if (r.LostClients.Count > 0)
                {
                    <div class="small fw-semibold mt-3 mb-2">Warto się odezwać</div>
                    <ul class="list-unstyled small mb-0 br-list">
                        @foreach (var c in r.LostClients.Take(6))
                        {
                            <li>
                                <a href="/clients/@c.ClientId">@c.Name</a>
                                <span class="text-muted">ostatnio @(c.LastVisit?.ToString("dd.MM") ?? "—")</span>
                            </li>
                        }
                    </ul>
                    <div class="small text-muted mt-2">
                        <i class="bi bi-magic me-1"></i>Włącz <a href="/admin/automations">automatyczne odzyskiwanie klientów</a> — aplikacja sama wyśle zaproszenie z kuponem.
                    </div>
                }
            </div>
        </section>
    </div>

    <!-- Przychód -->
    <div class="col-12 col-xl-5">
        <section class="card h-100">
            <div class="card-header py-2 fw-semibold small"><i class="bi bi-wallet2 me-2 text-primary"></i>Przychód</div>
            <div class="card-body">
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <span class="fs-4 fw-bold">@Money(r.Revenue)</span>
                    @Trend(r.Revenue, r.RevenuePrevious, "zł")
                </div>
                <div class="small text-muted mb-3">poprzednio @Money(r.RevenuePrevious)</div>
                @if (r.TopClients.Count > 0)
                {
                    <div class="small fw-semibold mb-2">Najwięcej wydali</div>
                    var max = r.TopClients.Max(c => c.Revenue);
                    <div class="d-flex flex-column gap-2">
                        @foreach (var c in r.TopClients)
                        {
                            <div class="br-rank">
                                <div class="d-flex justify-content-between small"><a href="/clients/@c.ClientId">@c.Name</a><span class="fw-semibold">@Money(c.Revenue)</span></div>
                                <div class="br-track"><span style="width:@Pct(c.Revenue, max)%"></span></div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="small text-muted">Brak opłaconych zakupów w tym okresie.</div>
                }
            </div>
        </section>
    </div>
</div>

<div class="row g-3 mb-3">
    <!-- Obłożenie -->
    <div class="col-12 col-xl-6">
        <section class="card h-100">
            <div class="card-header py-2 fw-semibold small"><i class="bi bi-calendar-week me-2 text-primary"></i>Obłożenie grafiku</div>
            <div class="card-body">
                @if (r.PastOccupancy.AvailableMinutes == 0 && r.UpcomingOccupancy.AvailableMinutes == 0)
                {
                    <div class="small text-muted">Obłożenie liczymy z <a href="/trainer/availability">godzin pracy</a>. Ustaw je, a zobaczysz, ile grafiku jest zajęte i gdzie masz wolne miejsca.</div>
                }
                else
                {
                    <div class="br-mini mb-3">
                        <div><strong>@(r.PastOccupancy.Percent ?? 0)%</strong><span>ostatnie 4 tyg.</span></div>
                        <div><strong>@(r.UpcomingOccupancy.Percent ?? 0)%</strong><span>najbliższe 2 tyg.</span></div>
                        <div><strong>@Hours(r.UpcomingOccupancy.FreeMinutes)</strong><span>wolnego do sprzedania</span></div>
                    </div>
                    <div class="small text-muted mb-2">Wg dnia tygodnia (ostatnie 8 tygodni)</div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var d in r.OccupancyByWeekday)
                        {
                            <div class="br-day">
                                <span class="br-day-name">@d.Day</span>
                                <div class="br-track flex-grow-1"><span class="@OccClass(d.Percent)" style="width:@(d.Percent ?? 0)%"></span></div>
                                <span class="br-day-value">@(d.AvailableMinutes == 0 ? "wolne" : $"{d.Percent}%")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    </div>

    <!-- Prognoza -->
    <div class="col-12 col-xl-6">
        <section class="card h-100">
            <div class="card-header py-2 fw-semibold small"><i class="bi bi-binoculars me-2 text-primary"></i>Prognoza przychodu — najbliższe @f.Days dni</div>
            <div class="card-body">
                <div class="br-forecast mb-3">
                    <div>
                        <span class="text-muted small">Odnowienia karnetów</span>
                        <strong>@Money(f.MembershipAmount)</strong>
                        <span class="small text-muted">@f.MembershipRenewals @Plural(f.MembershipRenewals, "karnet", "karnety", "karnetów")</span>
                    </div>
                    <div>
                        <span class="text-muted small">Kolejne pakiety (szacunek)</span>
                        <strong>@Money(f.ExpectedPackageAmount)</strong>
                        <span class="small text-muted">
                            @f.EndingPackages kończących się@(f.RepurchaseRatePercent is int rr ? $" · kupuje ponownie {rr}%" : "")
                        </span>
                    </div>
                </div>
                <div class="small d-flex flex-column gap-1 mb-3">
                    <div><i class="bi bi-arrow-repeat text-primary me-1"></i>Stały przychód z karnetów: <strong>@Money(f.MonthlyRecurring)</strong> / mies.</div>
                    <div><i class="bi bi-safe text-success me-1"></i>Opłacone treningi do zrobienia: <strong>@f.PrepaidSessions</strong> (@Money(f.PrepaidValue))</div>
                    @if (f.UnpaidAmount > 0)
                    {
                        <div><i class="bi bi-hourglass-split text-warning me-1"></i>Nieopłacone pakiety: <strong>@Money(f.UnpaidAmount)</strong> — <a href="/finance">zobacz w Finansach</a></div>
                    }
                </div>
                @if (f.EndingList.Count > 0)
                {
                    <div class="small fw-semibold mb-2">Pakiety, które zaraz się skończą — zaproponuj kolejny</div>
                    <ul class="list-unstyled small mb-0 br-list">
                        @foreach (var p in f.EndingList)
                        {
                            <li>
                                <a href="/clients/@p.ClientId">@p.ClientName</a>
                                <span class="text-muted">@p.PackageName · @(p.Remaining == 0 ? "wykorzystany" : $"zostało {p.Remaining}")@(p.ExpiresAt is { } e ? $" · do {e:dd.MM}" : "")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
</div>

<!-- Odwołania -->
<section class="card mb-3">
    <div class="card-header py-2 fw-semibold small"><i class="bi bi-calendar-x me-2 text-primary"></i>Odwołania i nieobecności</div>
    <div class="card-body">
        <div class="br-mini mb-3">
            <div><strong>@(r.CancellationRatePercent ?? 0)%</strong><span>wizyt odwołanych</span></div>
            <div><strong>@r.CancelledCount</strong><span>odwołań (@r.LateCancelledCount późnych)</span></div>
            <div><strong>@r.NoShowCount</strong><span>nieobecności</span></div>
        </div>
        @if (r.TopCancelledSlots.Count == 0)
        {
            <div class="small text-muted">W tym okresie nikt nie odwołał treningu. 👏</div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-lg-5">
                    <div class="small fw-semibold mb-2">Najczęściej odwoływane godziny</div>
                    <ol class="small mb-2 ps-3 d-flex flex-column gap-1">
                        @foreach (var s in r.TopCancelledSlots)
                        {
                            <li><strong>@s.Day, @s.Hour:00</strong> — @s.Cancelled z @s.Total wizyt (@s.RatePercent%)</li>
                        }
                    </ol>
                    <div class="small text-muted">Wysoki odsetek w jednej godzinie? Rozważ inną godzinę pracy albo <a href="/trainer/availability">zasady odwoływania</a>.</div>
                </div>
                <div class="col-12 col-lg-7">
                    <div class="br-heat-wrap">
                        @{ var heatMax = Math.Max(1, r.CancellationHeatmap.SelectMany(x => x).DefaultIfEmpty(0).Max()); }
                        <table class="br-heat" aria-label="Mapa odwołań wg dnia i godziny">
                            <thead>
                                <tr>
                                    <th></th>
                                    @for (var h = r.HeatmapFirstHour; h <= r.HeatmapLastHour; h++)
                                    {
                                        <th>@h</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var d = 0; d < r.CancellationHeatmap.Length; d++)
                                {
                                    var row = r.CancellationHeatmap[d];
                                    <tr>
                                        <th>@DayNames[d]</th>
                                        @for (var h = 0; h < row.Length; h++)
                                        {
                                            var v = row[h];
                                            <td title="@(v > 0 ? $"{DayNames[d]} {r.HeatmapFirstHour + h}:00 — {v}" : "")"
                                                style="@(v > 0 ? $"--a:{(0.2 + 0.8 * v / heatMax).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}" : "")"
                                                class="@(v > 0 ? "on" : "")">@(v > 0 ? v : "")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .br-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .75rem; }
    .br-kpi { background: var(--bs-body-bg); border: 1px solid var(--bs-border-color); border-radius: 14px; padding: .9rem 1rem; display: flex; flex-direction: column; gap: .2rem; }
    .br-kpi-accent { border-color: var(--c-primary); background: var(--c-primary-light); }
    .br-kpi-label { font-size: .78rem; color: var(--bs-secondary-color); display: flex; gap: .4rem; align-items: center; }
    .br-kpi-label .bi { color: var(--c-primary); }
    .br-kpi-value { font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; }
    .br-kpi-help { font-size: .76rem; color: var(--bs-secondary-color); }
    .br-trend { font-size: .75rem; font-weight: 600; }
    .br-trend.up { color: var(--c-success, #16A34A); }
    .br-trend.down { color: var(--c-danger, #DC2626); }
    .br-trend.flat { color: var(--bs-secondary-color); }
    .br-mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
    .br-mini > div { background: var(--bs-tertiary-bg); border-radius: 10px; padding: .55rem .7rem; display: flex; flex-direction: column; }
    .br-mini strong { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
    .br-mini span { font-size: .74rem; color: var(--bs-secondary-color); }
    .br-months { display: grid; grid-template-columns: repeat(6, 1fr); gap: .5rem; align-items: end; }
    .br-month { display: flex; flex-direction: column; align-items: center; gap: .2rem; }
    .br-month-bar { width: 100%; max-width: 44px; height: 90px; background: var(--bs-tertiary-bg); border-radius: 8px; display: flex; align-items: flex-end; overflow: hidden; }
    .br-month-bar span { display: block; width: 100%; background: var(--c-primary); border-radius: 8px 8px 0 0; }
    .br-month-value { font-size: .78rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .br-month-label { font-size: .7rem; color: var(--bs-secondary-color); }
    .br-track { height: 8px; background: var(--bs-tertiary-bg); border-radius: 99px; overflow: hidden; }
    .br-track span { display: block; height: 100%; background: var(--c-primary); border-radius: 99px; }
    .br-track span.low { background: var(--c-warning, #D97706); }
    .br-track span.high { background: var(--c-success, #16A34A); }
    .br-day { display: flex; align-items: center; gap: .6rem; font-size: .8rem; }
    .br-day-name { width: 3rem; color: var(--bs-secondary-color); }
    .br-day-value { width: 3rem; text-align: right; font-variant-numeric: tabular-nums; }
    .br-list li { display: flex; justify-content: space-between; gap: .5rem; padding: .3rem 0; border-bottom: 1px dashed var(--bs-border-color); flex-wrap: wrap; }
    .br-list li:last-child { border-bottom: 0; }
    .br-forecast { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    .br-forecast > div { background: var(--bs-tertiary-bg); border-radius: 10px; padding: .7rem; display: flex; flex-direction: column; }
    .br-forecast strong { font-size: 1.2rem; font-variant-numeric: tabular-nums; }
    .br-heat-wrap { overflow-x: auto; }
    .br-heat { border-collapse: separate; border-spacing: 3px; font-size: .7rem; margin: 0 auto; }
    .br-heat th { color: var(--bs-secondary-color); font-weight: 500; text-align: center; padding: 0 2px; }
    .br-heat tbody th { text-align: right; padding-right: 6px; }
    .br-heat td { width: 26px; height: 24px; border-radius: 5px; background: var(--bs-tertiary-bg); text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
    .br-heat td.on { background: rgba(220, 38, 38, var(--a)); color: #fff; }
    @@media (max-width: 575.98px) { .br-forecast { grid-template-columns: 1fr; } .br-kpi-value { font-size: 1.35rem; } }
</style>

@code {
    private static readonly string[] DayNames = ["Pon", "Wt", "Śr", "Czw", "Pt", "Sob", "Niedz"];
    private static readonly System.Globalization.CultureInfo Pl = new("pl-PL");
    private int _days = 90;
    private string? _trainerUserId;
    private BusinessReportDto? _report;

    protected override async Task OnInitializedAsync()
    {
        if (!Entitlements.IsAllowed("AdvancedAnalytics")) return;
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _trainerUserId = user.IsInRole(Roles.Admin) ? null : user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _report = await ReportSvc.GetAsync(_days, _trainerUserId);
    }

    private async Task ChangePeriod(int days)
    {
        _days = days;
        _report = null;
        StateHasChanged();
        _report = await ReportSvc.GetAsync(_days, _trainerUserId);
    }

    private static string Money(decimal v) => v.ToString("#,0", Pl) + "\u00A0zł";
    private static string Hours(int minutes) => (minutes % 60 == 0 ? (minutes / 60).ToString(Pl) : (minutes / 60.0).ToString("0.#", Pl)) + "\u00A0h";
    private static int Pct(decimal v, decimal max) => max <= 0 ? 0 : (int)Math.Round(v / max * 100);
    private static string OccClass(int? p) => p is null ? "" : p < 40 ? "low" : p >= 75 ? "high" : "";
    private static string Plural(int n, string one, string few, string many) =>
        n == 1 ? one : n % 10 is >= 2 and <= 4 && (n % 100 < 10 || n % 100 >= 20) ? few : many;

    private static RenderFragment Delta(int d) => __builder =>
    {
        if (d == 0) return;
        <span class="br-trend @(d > 0 ? "up" : "down")">@(d > 0 ? "+" : "")@d</span>
    };

    private static RenderFragment Trend(decimal? now, decimal? before, string unit) => __builder =>
    {
        if (now is null || before is null) return;
        var diff = now.Value - before.Value;
        var cls = diff > 0 ? "up" : diff < 0 ? "down" : "flat";
        var icon = diff > 0 ? "bi-arrow-up-right" : diff < 0 ? "bi-arrow-down-right" : "bi-dash";
        var text = unit == "pp" ? $"{Math.Abs(diff):0} pp" : Money(Math.Abs(diff));
        <span class="br-trend @cls"><i class="bi @icon"></i> @(diff == 0 ? "bez zmian" : text) vs poprzedni okres</span>
    };

    private static RenderFragment Trend(int? now, int? before, string unit) => Trend((decimal?)now, (decimal?)before, unit);
}
