@page "/my/measurements"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Client")]
@inject IBodyMeasurementService MeasurementService
@inject IClientService ClientService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject EntitlementService Entitlements
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using System.Globalization
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Moje pomiary" />

@if (!Entitlements.IsAllowed("BodyMeasurements"))
{
    <FeatureGate Flag="BodyMeasurements" RequiredPlan="Pro"
                 Title="Pomiary ciała są niedostępne w Twoim planie">
        <Description>
            Śledź postępy klientów — waga, tkanka tłuszczowa, obwody i wykresy zmian w czasie.
        </Description>
    </FeatureGate>
    return;
}

<div class="d-flex align-items-center justify-content-between gap-2 mb-3 flex-wrap">
    <h4 class="mb-0 fw-bold"><i class="bi bi-rulers me-2"></i>Moje pomiary</h4>
    @if (_tab == Tab.Measurements && _clientId is not null && !_adding)
    {
        <button class="btn btn-primary btn-sm" @onclick="StartAdd"><i class="bi bi-plus-lg me-1"></i>Dodaj pomiar</button>
    }
</div>

<div class="seg-tabs mb-4" role="tablist" aria-label="Pomiary i zdjęcia">
    <button type="button" role="tab" class="seg-tab @(_tab == Tab.Measurements ? "active" : "")" aria-selected="@(_tab == Tab.Measurements ? "true" : "false")"
            @onclick="() => SelectTab(Tab.Measurements)"><i class="bi bi-graph-up"></i>Pomiary</button>
    <button type="button" role="tab" class="seg-tab @(_tab == Tab.Photos ? "active" : "")" aria-selected="@(_tab == Tab.Photos ? "true" : "false")"
            @onclick="() => SelectTab(Tab.Photos)"><i class="bi bi-camera"></i>Zdjęcia sylwetki</button>
</div>

@if (_tab == Tab.Measurements && _adding)
{
    <div class="card border-0 shadow-sm mb-4 mm-form">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2 text-primary"></i>Nowy pomiar</h6>
            @if (_formError is not null)
            {
                <div class="alert alert-danger py-2 small">@_formError</div>
            }
            <div class="row g-3 align-items-end">
                <div class="col-6 col-sm-4">
                    <label class="form-label small fw-semibold" for="mm-date">Data</label>
                    <input id="mm-date" type="date" class="form-control" max="@_today.ToString("yyyy-MM-dd")"
                           value="@_new.MeasurementDate.ToString("yyyy-MM-dd")"
                           @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d)) _new.MeasurementDate = d; }" />
                </div>
                <div class="col-6 col-sm-4">
                    <label class="form-label small fw-semibold" for="mm-weight">Waga</label>
                    <div class="input-group">
                        <input id="mm-weight" type="number" inputmode="decimal" step="0.1" min="20" max="400" class="form-control mm-big"
                               placeholder="np. 72,5" @bind="_new.WeightKg" />
                        <span class="input-group-text">kg</span>
                    </div>
                </div>
            </div>

            @if (!_more)
            {
                <button type="button" class="btn btn-link btn-sm px-0 mt-2" @onclick="() => _more = true">
                    <i class="bi bi-chevron-down me-1"></i>Dodaj też obwody i tkankę tłuszczową
                </button>
            }
            else
            {
                <div class="row g-3 mt-1">
                    @MeasureField("Tkanka tłuszczowa", "%", () => _new.BodyFatPercent, v => _new.BodyFatPercent = v)
                    @MeasureField("Talia", "cm", () => _new.WaistCm, v => _new.WaistCm = v)
                    @MeasureField("Biodra", "cm", () => _new.HipsCm, v => _new.HipsCm = v)
                    @MeasureField("Klatka piersiowa", "cm", () => _new.ChestCm, v => _new.ChestCm = v)
                    @MeasureField("Udo", "cm", () => _new.ThighCm, v => _new.ThighCm = v)
                    @MeasureField("Ramię", "cm", () => _new.ArmCm, v => _new.ArmCm = v)
                </div>
                <div class="form-text">Mierz zawsze w tym samym miejscu i o podobnej porze — najlepiej rano, na czczo.</div>
            }

            <div class="mt-3">
                <label class="form-label small fw-semibold" for="mm-notes">Notatka (opcjonalnie)</label>
                <input id="mm-notes" class="form-control" maxlength="300" placeholder="np. po weekendzie, po treningu" @bind="_new.Notes" />
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="bi bi-check-lg me-1"></i>Zapisz
                </button>
                <button class="btn btn-outline-secondary" @onclick="() => _adding = false" disabled="@_saving">Anuluj</button>
            </div>
            <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Trener zobaczy Twój pomiar w swoim panelu.</div>
        </div>
    </div>
}

@if (_saved is not null)
{
    <div class="alert alert-success alert-dismissible py-2 small">
        <i class="bi bi-check-circle me-1"></i>@_saved
        <button type="button" class="btn-close" @onclick="() => _saved = null"></button>
    </div>
}

@if (_tab == Tab.Photos)
{
    @if (!_loading && _clientId is int photoClientId)
    {
        <ProgressPhotos ClientId="photoClientId" UserId="@_userId" />
    }
    else if (!_loading)
    {
        <div class="alert alert-secondary">Twoje konto nie jest jeszcze powiązane z profilem klienta.</div>
    }
}
else if (_loading)
{
    @for (var i = 0; i < 3; i++)
    {
        <div class="skeleton-card" style="padding:16px">
            <div class="skeleton skeleton-line w-40" style="height:14px"></div>
            <div class="skeleton skeleton-line w-75" style="height:11px"></div>
            <div class="skeleton skeleton-line w-50" style="height:11px;margin-bottom:0"></div>
        </div>
    }
}
else if (_measurements.Count == 0)
{
    <div class="empty-state py-5">
        <div class="empty-state-icon">📏</div>
        <div class="empty-state-title">Brak pomiarów</div>
        <div class="empty-state-desc">Wpisz swoją wagę albo obwody — zobaczysz postępy na wykresie. Pomiary może też dodawać Twój trener, a zdjęcia sylwetki dodasz w zakładce obok.</div>
        <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
            @if (_clientId is not null && !_adding)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="StartAdd"><i class="bi bi-plus-lg me-1"></i>Dodaj pierwszy pomiar</button>
            }
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => SelectTab(Tab.Photos)"><i class="bi bi-camera me-1"></i>Zdjęcia sylwetki</button>
        </div>
    </div>
}
else
{
    <!-- Stat cards: latest + trend -->
    <div class="row g-3 mb-4">
        @foreach (var card in _cards)
        {
            <div class="col-6 col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size:.65rem;letter-spacing:.06em">
                            @card.Label
                        </div>
                        <div class="fw-bold" style="font-size:1.5rem;line-height:1.1">
                            @card.Latest <span class="text-muted" style="font-size:.85rem;font-weight:400">@card.Unit</span>
                        </div>
                        <div class="mt-1 small @card.TrendClass" style="font-size:.78rem">
                            @if (card.Delta == 0)
                            {
                                <span class="text-muted">bez zmian vs poprzedni</span>
                            }
                            else if (card.Delta is not null)
                            {
                                @((card.Delta > 0 ? "↑ +" : "↓ ") + card.Delta?.ToString("0.#", _pl) + " " + card.Unit)
                                <span class="text-muted ms-1">vs poprzedni</span>
                            }
                            else
                            {
                                <span class="text-muted">pierwszy pomiar</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Chart -->
    @if (_chartMetrics.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body pb-3">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var m in _chartMetrics)
                    {
                        <button class="btn btn-sm @(_activeMetric == m.Key ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => SelectMetricAsync(m.Key)">
                            @m.Label
                        </button>
                    }
                </div>
                <div style="height:220px;position:relative">
                    <canvas id="measurements-chart"></canvas>
                </div>
            </div>
        </div>
    }

    <!-- Last measurement date -->
    <div class="text-muted small mb-4">
        <i class="bi bi-calendar-check me-1"></i>
        Ostatni pomiar: <strong>@_measurements[0].MeasurementDate.ToString("d MMMM yyyy", _pl)</strong>
        · Łącznie pomiarów: <strong>@_measurements.Count</strong>
    </div>

    <!-- History table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header fw-semibold bg-transparent border-bottom">
            Historia pomiarów
        </div>
        @* Telefon: najważniejsze na wierzchu (data, waga, tkanka tłuszczowa), reszta po rozwinięciu. *@
        <div class="hist-list d-md-none">
            @for (var i = 0; i < _measurements.Count; i++)
            {
                var m = _measurements[i];
                var prev = i + 1 < _measurements.Count ? _measurements[i + 1] : null;
                <details class="hist-item">
                    <summary>
                        <div class="hist-date"><b>@m.MeasurementDate.Day</b><span>@m.MeasurementDate.ToString("MMM yy", _pl)</span></div>
                        <div class="hist-main">
                            <div class="hist-title">@(m.WeightKg.HasValue ? $"{Fmt(m.WeightKg)} kg" : "Pomiar") @if (m.AddedByClient) { <span class="mm-own">Ty</span> }</div>
                            <div class="hist-sub">
                                @if (m.WeightKg.HasValue && prev?.WeightKg is decimal pw)
                                {
                                    var d = m.WeightKg.Value - pw;
                                    <span class="@(d < 0 ? "text-success" : d > 0 ? "text-danger" : "")">@(d > 0 ? "+" : "")@d.ToString("0.#") kg</span>
                                }
                                @if (m.BodyFatPercent.HasValue) { <span> · tł. @Fmt(m.BodyFatPercent)%</span> }
                            </div>
                        </div>
                    </summary>
                    <div class="hist-body">
                        @if (_hasChest) { <div><small>Klatka</small>@Fmt(m.ChestCm) cm</div> }
                        @if (_hasWaist) { <div><small>Talia</small>@Fmt(m.WaistCm) cm</div> }
                        @if (_hasHips)  { <div><small>Biodra</small>@Fmt(m.HipsCm) cm</div> }
                        @if (_hasThigh) { <div><small>Udo</small>@Fmt(m.ThighCm) cm</div> }
                        @if (_hasArm)   { <div><small>Ramię</small>@Fmt(m.ArmCm) cm</div> }
                        @if (_hasFat)   { <div><small>Tkanka tł.</small>@Fmt(m.BodyFatPercent) %</div> }
                        @if (!string.IsNullOrWhiteSpace(m.Notes)) { <div class="wide"><small>Notatka</small>@m.Notes</div> }
                        @if (m.AddedByClient) { <div class="wide">@DeleteButton(m)</div> }
                    </div>
                </details>
            }
        </div>
        <div class="table-responsive d-none d-md-block">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        @if (_hasWeight) { <th class="text-end">Waga (kg)</th> }
                        @if (_hasFat)    { <th class="text-end">Tk. tł. (%)</th> }
                        @if (_hasChest)  { <th class="text-end">Klatka (cm)</th> }
                        @if (_hasWaist)  { <th class="text-end">Talia (cm)</th> }
                        @if (_hasHips)   { <th class="text-end">Biodra (cm)</th> }
                        @if (_hasThigh)  { <th class="text-end">Udo (cm)</th> }
                        @if (_hasArm)    { <th class="text-end">Ramię (cm)</th> }
                        @if (_hasNotes)  { <th>Notatki</th> }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _measurements)
                    {
                        <tr>
                            <td class="text-nowrap small">@m.MeasurementDate.ToString("dd.MM.yyyy") @if (m.AddedByClient) { <span class="mm-own" title="Dodane przez Ciebie">Ty</span> }</td>
                            @if (_hasWeight) { <td class="text-end small">@Fmt(m.WeightKg)</td> }
                            @if (_hasFat)    { <td class="text-end small">@Fmt(m.BodyFatPercent)</td> }
                            @if (_hasChest)  { <td class="text-end small">@Fmt(m.ChestCm)</td> }
                            @if (_hasWaist)  { <td class="text-end small">@Fmt(m.WaistCm)</td> }
                            @if (_hasHips)   { <td class="text-end small">@Fmt(m.HipsCm)</td> }
                            @if (_hasThigh)  { <td class="text-end small">@Fmt(m.ThighCm)</td> }
                            @if (_hasArm)    { <td class="text-end small">@Fmt(m.ArmCm)</td> }
                            @if (_hasNotes)  { <td class="small text-muted">@(m.Notes ?? "—")</td> }
                            <td class="text-end">@if (m.AddedByClient) { @DeleteButton(m) }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


@code {
    private static readonly CultureInfo _pl = new("pl-PL");

    // ── Pomiar wpisany przez klienta ──
    private bool _adding, _more, _saving;
    private string? _formError, _saved;
    private int? _confirmDelete;
    private DateOnly _today = DateOnly.FromDateTime(StudioClock.Today);
    private CreateBodyMeasurementDto _new = new();

    private void StartAdd()
    {
        _today = DateOnly.FromDateTime(StudioClock.Today);
        _new = new CreateBodyMeasurementDto { MeasurementDate = _today, WeightKg = _measurements.FirstOrDefault(m => m.WeightKg.HasValue)?.WeightKg };
        _more = false;
        _formError = null;
        _saved = null;
        _adding = true;
    }

    private async Task SaveAsync()
    {
        if (_clientId is not int clientId) return;
        _saving = true;
        _formError = null;
        try
        {
            _new.ClientId = clientId;
            _new.AddedByClient = true;
            await MeasurementService.AddAsync(_new);
            _adding = false;
            _saved = "Zapisano pomiar. Trener zobaczy go w swoim panelu.";
            await ReloadAsync();
        }
        catch (ArgumentException ex) { _formError = ex.Message; }
        catch (Exception) { _formError = "Nie udało się zapisać pomiaru. Spróbuj ponownie."; }
        finally { _saving = false; }
    }

    private async Task DeleteOwnAsync(int id)
    {
        if (_clientId is not int clientId) return;
        _confirmDelete = null;
        if (await MeasurementService.DeleteOwnAsync(id, clientId)) await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _measurements = [.. (await MeasurementService.GetAsync(_clientId!.Value)).OrderByDescending(m => m.MeasurementDate)];
        _cards.Clear();
        _chartMetrics.Clear();
        DetectColumns();
        BuildCards();
        BuildChartMetrics();
        _chartPending = true;
    }

    private RenderFragment DeleteButton(BodyMeasurementDto m) => __builder =>
    {
        if (_confirmDelete == m.Id)
        {
            <span class="d-inline-flex align-items-center gap-1 small">
                Usunąć?
                <button class="btn btn-sm btn-danger py-0" @onclick="() => DeleteOwnAsync(m.Id)">Tak</button>
                <button class="btn btn-sm btn-link py-0" @onclick="() => _confirmDelete = null">Nie</button>
            </span>
        }
        else
        {
            <button class="btn btn-sm btn-link text-danger p-0" title="Usuń swój pomiar" @onclick="() => _confirmDelete = m.Id"><i class="bi bi-trash3"></i></button>
        }
    };

    private RenderFragment MeasureField(string label, string unit, Func<decimal?> get, Action<decimal?> set) => __builder =>
    {
        <div class="col-6 col-sm-4">
            <label class="form-label small fw-semibold">@label</label>
            <div class="input-group input-group-sm">
                <input type="number" inputmode="decimal" step="0.1" class="form-control" aria-label="@label"
                       value="@get()?.ToString(CultureInfo.InvariantCulture)"
                       @onchange="e => set(decimal.TryParse(e.Value?.ToString()?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null)" />
                <span class="input-group-text">@unit</span>
            </div>
        </div>
    };

    private enum Tab { Measurements, Photos }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    private Tab _tab = Tab.Measurements;
    private bool _chartPending;

    protected override void OnParametersSet()
    {
        if (string.Equals(TabQuery, "zdjecia", StringComparison.OrdinalIgnoreCase)) _tab = Tab.Photos;
    }

    private void SelectTab(Tab tab)
    {
        if (_tab == tab) return;
        _tab = tab;
        // Wykres rysuje JS na płótnie, które znika z zakładką — po powrocie trzeba go narysować od nowa.
        _chartPending = tab == Tab.Measurements;
    }

    private List<BodyMeasurementDto> _measurements = [];
    private List<StatCard> _cards = [];
    private List<ChartMetric> _chartMetrics = [];
    private string _activeMetric = string.Empty;
    private bool _loading = true;
    private int? _clientId;
    private string _userId = "";

    private bool _hasWeight, _hasFat, _hasChest, _hasWaist, _hasHips, _hasThigh, _hasArm, _hasNotes;

    protected override async Task OnInitializedAsync()
    {
        var auth   = await AuthState.GetAuthenticationStateAsync();
        var uid    = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        var client = await ClientService.GetClientByUserIdAsync(uid);
        _userId = uid;
        _clientId = client?.Id;
        if (client is not null)
        {
            _measurements = await MeasurementService.GetAsync(client.Id);
            _measurements = [.. _measurements.OrderByDescending(m => m.MeasurementDate)];
            DetectColumns();
            BuildCards();
            BuildChartMetrics();
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((firstRender || _chartPending) && _tab == Tab.Measurements && _chartMetrics.Count > 0)
        {
            _chartPending = false;
            await RenderChartAsync();
        }
    }

    private void DetectColumns()
    {
        _hasWeight = _measurements.Any(m => m.WeightKg.HasValue);
        _hasFat    = _measurements.Any(m => m.BodyFatPercent.HasValue);
        _hasChest  = _measurements.Any(m => m.ChestCm.HasValue);
        _hasWaist  = _measurements.Any(m => m.WaistCm.HasValue);
        _hasHips   = _measurements.Any(m => m.HipsCm.HasValue);
        _hasThigh  = _measurements.Any(m => m.ThighCm.HasValue);
        _hasArm    = _measurements.Any(m => m.ArmCm.HasValue);
        _hasNotes  = _measurements.Any(m => !string.IsNullOrEmpty(m.Notes));
    }

    private void BuildCards()
    {
        if (_measurements.Count == 0) return;  // empty state — no cards to render

        // Każda miara osobno: ostatnia znana wartość i poprzednia (klient może wpisać np. samą wagę).
        void Add(bool has, string label, string unit, Func<BodyMeasurementDto, decimal?> pick)
        {
            if (!has) return;
            var values = _measurements.Select(pick).Where(v => v.HasValue).Take(2).ToList();
            _cards.Add(Card(label, unit, values.ElementAtOrDefault(0), values.ElementAtOrDefault(1)));
        }

        Add(_hasWeight, "Waga",              "kg", m => m.WeightKg);
        Add(_hasFat,    "Tkanka tłuszczowa", "%",  m => m.BodyFatPercent);
        Add(_hasChest,  "Klatka piersiowa",  "cm", m => m.ChestCm);
        Add(_hasWaist,  "Talia",             "cm", m => m.WaistCm);
        Add(_hasHips,   "Biodra",            "cm", m => m.HipsCm);
        Add(_hasThigh,  "Udo",               "cm", m => m.ThighCm);
        Add(_hasArm,    "Ramię",             "cm", m => m.ArmCm);
    }

    private void BuildChartMetrics()
    {
        if (_hasWeight) _chartMetrics.Add(new("weight", "Waga",        "kg", m => m.WeightKg));
        if (_hasFat)    _chartMetrics.Add(new("fat",    "Tk. tłuszcz.", "%",  m => m.BodyFatPercent));
        if (_hasChest)  _chartMetrics.Add(new("chest",  "Klatka",       "cm", m => m.ChestCm));
        if (_hasWaist)  _chartMetrics.Add(new("waist",  "Talia",        "cm", m => m.WaistCm));
        if (_hasHips)   _chartMetrics.Add(new("hips",   "Biodra",       "cm", m => m.HipsCm));
        if (_hasThigh)  _chartMetrics.Add(new("thigh",  "Udo",          "cm", m => m.ThighCm));
        if (_hasArm)    _chartMetrics.Add(new("arm",    "Ramię",        "cm", m => m.ArmCm));

        if (_chartMetrics.Count > 0 && _chartMetrics.All(m => m.Key != _activeMetric)) _activeMetric = _chartMetrics[0].Key;
    }

    private async Task SelectMetricAsync(string key)
    {
        _activeMetric = key;
        await RenderChartAsync();
    }

    private async Task RenderChartAsync()
    {
        var metric = _chartMetrics.FirstOrDefault(m => m.Key == _activeMetric);
        if (metric is null) return;

        // chronological order for the chart (oldest → newest)
        var ordered = _measurements
            .Where(m => metric.Selector(m).HasValue)
            .OrderBy(m => m.MeasurementDate)
            .ToList();

        var labels = ordered.Select(m => m.MeasurementDate.ToString("dd.MM.yy")).ToArray();
        var data   = ordered.Select(m => (double)metric.Selector(m)!.Value).ToArray();

        await JS.InvokeVoidAsync("PTChart.renderLine",
            "measurements-chart", labels, data, metric.Label, metric.Unit);
    }

    private static StatCard Card(string label, string unit, decimal? latest, decimal? prev)
    {
        decimal? delta = (latest.HasValue && prev.HasValue) ? latest.Value - prev.Value : null;
        return new StatCard
        {
            Label      = label,
            Unit       = unit,
            Latest     = latest?.ToString("0.#", CultureInfo.InvariantCulture) ?? "—",
            Delta      = delta,
            TrendClass = delta is null ? "" : (delta < 0 ? "text-success" : delta > 0 ? "text-body-secondary" : "text-muted")
        };
    }

    private static string Fmt(decimal? v) => v?.ToString("0.#", CultureInfo.InvariantCulture) ?? "—";

    private sealed class StatCard
    {
        public string Label { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public string Latest { get; set; } = string.Empty;
        public decimal? Delta { get; set; }
        public string TrendClass { get; set; } = string.Empty;
    }

    private sealed class ChartMetric(string key, string label, string unit, Func<BodyMeasurementDto, decimal?> selector)
    {
        public string Key { get; } = key;
        public string Label { get; } = label;
        public string Unit { get; } = unit;
        public Func<BodyMeasurementDto, decimal?> Selector { get; } = selector;
    }
}

