@page "/sessions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ISessionService SessionService
@inject IClientService ClientService
@inject IAuditLogService AuditLogService
@inject ITrainerAvailabilityService AvailabilityService
@inject ISessionSeriesService SeriesService
@inject ITrainerConfigService TrainerConfigService
@inject AuthenticationStateProvider AuthState
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@using System.Globalization
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<AppTitle Page="Wizyty" />

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0 fw-bold">
        <i class="bi bi-calendar-check me-2"></i>Wizyty
    </h4>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        @if (_isClientRole)
        {
            @if (_clientDto?.AllowSelfBooking == true)
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenBookingPanel">
                    <i class="bi bi-plus-circle me-1"></i>Umów wizytę
                </button>
            }
            else
            {
                <span class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>Rezerwacja przez trenera
                </span>
            }
        }
        @if (_canEdit && _clients.Count > 0)
        {
            <select class="form-select form-select-sm w-auto" value="@_filterClientId"
                    @onchange="OnClientFilterChanged">
                <option value="0">Wszyscy klienci</option>
                @foreach (var c in _clients)
                {
                    <option value="@c.Id">@c.FullName</option>
                }
            </select>
        }
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5">
        <span class="spinner-border text-primary"></span>
        <div class="text-muted small mt-2">Ładowanie...</div>
    </div>
}
else
{
    <div class="sessions-body">
        <div class="sessions-main">

            <!-- Upcoming -->
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="session-section-label">Nadchodzące</span>
                @if (_upcoming.Count > 0)
                {
                    <span class="badge bg-primary rounded-pill">@_upcoming.Count</span>
                }
            </div>

            @if (_upcoming.Count == 0)
            {
                <div class="text-muted py-3 small mb-4">Brak nadchodzących wizyt.</div>
            }
            else
            {
                <div class="session-tiles mb-5">
                    @foreach (var s in _upcoming)
                    {
                        <div class="session-tile status-@s.Status.ToString().ToLower() @(_selectedSession?.Id == s.Id ? "session-tile-selected" : "")"
                             style="cursor:pointer"
                             @onclick="() => OpenPanel(s.Id)">
                            <div class="session-tile-date">
                                <div class="session-tile-day">@s.StartTime.Day</div>
                                <div class="session-tile-month">@s.StartTime.ToString("MMM", _pl)</div>
                                <div class="session-tile-weekday">@s.StartTime.ToString("ddd", _pl)</div>
                            </div>
                            <div class="session-tile-info">
                                <div class="session-tile-client">@s.ClientName</div>
                                <div class="session-tile-type">@s.SessionTypeName</div>
                                <div class="session-tile-time">
                                    <i class="bi bi-clock me-1 text-muted"></i>@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")
                                </div>
                                @if (_canEdit)
                                {
                                    <div class="session-tile-trainer text-muted">
                                        <i class="bi bi-person me-1"></i>@s.TrainerName
                                    </div>
                                }
                                @if (s.Status == SessionStatus.AwaitingPackage)
                                {
                                    <div style="font-size:.72rem;color:#b45309;font-weight:600;margin-top:2px">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Poza pakietem — wymaga opłaty
                                    </div>
                                }
                            </div>
                            <div class="session-tile-meta">
                                <span class="badge @StatusBadge(s.Status)">@StatusLabel(s.Status)</span>
                                <i class="bi bi-chevron-right text-muted" style="font-size:.75rem"></i>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Archive -->
            <div class="d-flex align-items-center gap-2 mb-2 mt-2">
                <span class="session-section-label" style="color:var(--bs-secondary-color)">Archiwum</span>
                @if (_past.Count > 0)
                {
                    <span class="badge bg-secondary rounded-pill">@_past.Count</span>
                }
            </div>

            @if (_past.Count == 0)
            {
                <div class="text-muted py-3 small">Brak archiwalnych wizyt.</div>
            }
            else
            {
                <div class="session-tiles">
                    @foreach (var s in _past)
                    {
                        <div class="session-tile status-@s.Status.ToString().ToLower() @(_selectedSession?.Id == s.Id ? "session-tile-selected" : "")"
                             style="cursor:pointer"
                             @onclick="() => OpenPanel(s.Id)">
                            <div class="session-tile-date">
                                <div class="session-tile-day">@s.StartTime.Day</div>
                                <div class="session-tile-month">@s.StartTime.ToString("MMM", _pl)</div>
                                <div class="session-tile-weekday">@s.StartTime.ToString("ddd", _pl)</div>
                            </div>
                            <div class="session-tile-info">
                                <div class="session-tile-client">@s.ClientName</div>
                                <div class="session-tile-type">@s.SessionTypeName</div>
                                <div class="session-tile-time">
                                    <i class="bi bi-clock me-1 text-muted"></i>@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")
                                </div>
                                @if (_canEdit)
                                {
                                    <div class="session-tile-trainer text-muted">
                                        <i class="bi bi-person me-1"></i>@s.TrainerName
                                    </div>
                                }
                                @if (s.Status == SessionStatus.AwaitingPackage)
                                {
                                    <div style="font-size:.72rem;color:#b45309;font-weight:600;margin-top:2px">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Poza pakietem — wymaga opłaty
                                    </div>
                                }
                            </div>
                            <div class="session-tile-meta">
                                <span class="badge @StatusBadge(s.Status)">@StatusLabel(s.Status)</span>
                                <i class="bi bi-chevron-right text-muted" style="font-size:.75rem"></i>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>

        <!-- Booking panel (client self-booking) -->
        @if (_bookingOpen)
        {
            <div class="cal-panel">
                <div class="cal-panel-header">
                    <span class="fw-semibold"><i class="bi bi-calendar-plus me-2"></i>Nowa wizyta</span>
                    <button class="btn-close btn-sm" @onclick="CloseBookingPanel"></button>
                </div>
                <div class="cal-panel-body">

                    @if (!string.IsNullOrEmpty(_bookingError))
                    {
                        <div class="alert alert-danger py-2 small">@_bookingError</div>
                    }

                    @if (_isClientRole && !_clientHasActivePackage)
                    {
                        <div class="alert alert-warning py-3 small">
                            <i class="bi bi-ticket-x me-2 fs-5 d-block mb-2"></i>
                            <strong>Brak aktywnego pakietu</strong><br />
                            Nie masz pakietu z dostępnymi sesjami. Skontaktuj się z trenerem, aby zarezerwować wizytę.
                        </div>
                        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="CloseBookingPanel">Zamknij</button>
                    }
                    else if (_sessionTypes.Count == 0)
                    {
                        <div class="alert alert-warning py-2 small">
                            Brak dostępnych typów sesji. Skontaktuj się z trenerem.
                        </div>
                    }
                    else
                    {
                        <!-- Mode tabs -->
                        <ul class="nav nav-tabs nav-sm mb-3">
                            <li class="nav-item">
                                <button class="nav-link py-1 @(_bookingMode == "single" ? "active" : "")"
                                        @onclick='() => SetBookingMode("single")'>Jednorazowa</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link py-1 @(_bookingMode == "series" ? "active" : "")"
                                        @onclick='() => SetBookingMode("series")'>Seria <HintButton Title="Seria wizyt" Text="Rezerwacja cyklu regularnych treningów naraz — np. każdy wtorek i czwartek o 18:00. System rezerwuje wszystkie pasujące terminy w wybranym przedziale dat i dopasowuje do dostępnych pakietów." PopClass="hint-pop-right" /></button>
                            </li>
                        </ul>

                        <!-- Session type selector (shared) -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">Rodzaj sesji <HintButton Text="Wybierz typ treningu. Każdy typ ma własny czas trwania. Jeśli masz aktywny pakiet, możesz rezerwować tylko typy sesji objęte tym pakietem." /></label>
                            @foreach (var t in _sessionTypes)
                            {
                                var isCovered = !_isClientRole || _clientCoveredTypeIds.Contains(t.Id);
                                var isSelected = _bookingSessionTypeId == t.Id;
                                <button type="button"
                                        class="btn btn-sm w-100 mb-1 d-flex justify-content-between align-items-center
                                               @(isSelected && isCovered ? "btn-primary" : isCovered ? "btn-outline-primary" : "btn-outline-secondary")"
                                        style="@(!isCovered ? "opacity:.45;cursor:not-allowed" : "")"
                                        disabled="@(!isCovered)"
                                        @onclick="@(async () => { if (isCovered) { _bookingSessionTypeId = t.Id; await OnSessionTypeChangedAsync(); } })">
                                    <span>@t.Name · @t.DurationMinutes min</span>
                                    @if (!isCovered)
                                    {
                                        <span class="badge bg-secondary ms-2" style="font-size:.6rem">Brak w pakiecie</span>
                                    }
                                </button>
                            }
                        </div>

                        @if (_bookingMode == "single")
                        {
                            <!-- Date picker + slot list -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">Data</label>
                                <input type="date" class="form-control form-control-sm"
                                       @bind="_bookingDate" @bind:after="LoadSlotsAsync"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>

                            @if (_loadingSlots)
                            {
                                <div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                            }
                            else if (_availableSlots.Count > 0)
                            {
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold mb-1">Dostępne terminy</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var slot in _availableSlots.Where(s => s.IsAvailable))
                                        {
                                            <button class="btn btn-sm @(IsSelectedSlot(slot) ? "btn-primary" : "btn-outline-primary")"
                                                    @onclick="() => SelectSlot(slot)">
                                                @slot.Start.ToString("HH:mm")
                                            </button>
                                        }
                                    </div>
                                    @if (!_availableSlots.Any(s => s.IsAvailable))
                                    {
                                        <div class="text-muted small mt-1">Brak wolnych terminów w tym dniu.</div>
                                    }
                                </div>
                            }
                            else if (_bookingDate != default && !_loadingSlots)
                            {
                                <div class="text-muted small mb-3">Trener nie ma dostępności w tym dniu.</div>
                            }

                            <div class="mb-4">
                                <label class="form-label small fw-semibold mb-1">Notatki (opcjonalne)</label>
                                <textarea class="form-control form-control-sm" rows="2"
                                          @bind="_bookingNotes" placeholder="Dodaj uwagi dla trenera..."></textarea>
                            </div>

                            <div class="d-grid gap-2">
                                <button class="btn btn-primary btn-sm" @onclick="ConfirmBooking"
                                        disabled="@(_bookingBusy || _bookingDateTime == default)">
                                    @if (_bookingBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                    <i class="bi bi-check-circle me-1"></i>Potwierdź rezerwację
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="CloseBookingPanel">Anuluj</button>
                            </div>
                        }
                        else
                        {
                            <!-- Series booking -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">Dni tygodnia</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (DayOfWeek d in new[]{ DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
                                    {
                                        var selected = _seriesDays.Contains(d);
                                        <button type="button"
                                                class="btn btn-sm @(selected ? "btn-primary" : "btn-outline-secondary")"
                                                @onclick="() => ToggleSeriesDay(d)">
                                            @ShortDayName(d)
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold mb-1">Godzina</label>
                                    <input type="time" class="form-control form-control-sm" @bind="_seriesTime" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold mb-1">Data startu</label>
                                    <input type="date" class="form-control form-control-sm" @bind="_seriesStartDate"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold mb-1">Data końca (opcjonalna)</label>
                                    <input type="date" class="form-control form-control-sm" @bind="_seriesEndDate" />
                                </div>
                            </div>

                            @if (_seriesPreview is not null)
                            {
                                <div class="p-2 rounded border mb-3 small">
                                    <div class="fw-semibold mb-1">Podgląd serii:</div>
                                    <div class="text-success">✓ @_seriesPreview.WillBeScheduled zaplanowanych</div>
                                    @if (_seriesPreview.WillBeAwaitingPackage > 0)
                                    {
                                        <div class="text-warning">⚠ @_seriesPreview.WillBeAwaitingPackage oczekuje na pakiet</div>
                                    }
                                    @if (_seriesPreview.ConflictDates.Count > 0)
                                    {
                                        <div class="text-danger">✗ @_seriesPreview.ConflictDates.Count kolizji (zostaną pominięte)</div>
                                    }
                                    <div class="text-muted">Kredytów: @_seriesPreview.AvailableCredits</div>
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="PreviewSeriesAsync"
                                        disabled="@(_bookingBusy || _seriesDays.Count == 0)">
                                    <i class="bi bi-eye me-1"></i>Podgląd
                                </button>
                                <button class="btn btn-primary btn-sm" @onclick="ConfirmSeriesAsync"
                                        disabled="@(_bookingBusy || _seriesDays.Count == 0)">
                                    @if (_bookingBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                    <i class="bi bi-calendar-range me-1"></i>Utwórz serię
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="CloseBookingPanel">Anuluj</button>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <!-- Detail panel (existing session) -->
        @if (!_bookingOpen && _panelOpen && _selectedSession is not null)
        {
            <div class="cal-panel">
                <div class="cal-panel-header">
                    <span class="fw-semibold">Szczegóły wizyty</span>
                    <button class="btn-close btn-sm" @onclick="ClosePanel"></button>
                </div>
                <div class="cal-panel-body">

                    <!-- Avatar + name -->
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="avatar-circle" style="width:52px;height:52px;font-size:1.1rem">
                            @Initials(_selectedSession.ClientName)
                        </div>
                        <div>
                            <div class="fw-bold fs-6">@_selectedSession.ClientName</div>
                            <small class="text-muted">@_selectedSession.SessionTypeName</small>
                        </div>
                    </div>

                    <!-- Detail rows -->
                    <div class="session-detail-list">
                        <div class="session-detail-row">
                            <i class="bi bi-calendar-event"></i>
                            <span>@_selectedSession.StartTime.ToString("dddd, d MMMM yyyy", _pl)</span>
                        </div>
                        <div class="session-detail-row">
                            <i class="bi bi-clock"></i>
                            <span>
                                @_selectedSession.StartTime.ToString("HH:mm") – @_selectedSession.EndTime.ToString("HH:mm")
                                <span class="text-muted">(@_selectedSession.DurationMinutes min)</span>
                            </span>
                        </div>
                        <div class="session-detail-row">
                            <i class="bi bi-person"></i>
                            <span>@_selectedSession.TrainerName</span>
                        </div>
                        <div class="session-detail-row">
                            <i class="bi bi-circle-fill" style="font-size:.45rem;margin-top:5px"></i>
                            <span class="badge @StatusBadge(_selectedSession.Status)">@StatusLabel(_selectedSession.Status)</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_selectedSession.Notes))
                    {
                        <div class="p-3 rounded mb-3" style="background:var(--bs-tertiary-bg)">
                            <div class="small text-muted fw-semibold mb-1">Notatki</div>
                            <div class="small">@_selectedSession.Notes</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_selectedSession.CancellationReason))
                    {
                        <div class="p-3 rounded bg-danger bg-opacity-10 mb-3">
                            <div class="small text-danger fw-semibold mb-1">Powód anulowania</div>
                            <div class="small">@_selectedSession.CancellationReason</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_panelError))
                    {
                        <div class="alert alert-danger py-2 small">@_panelError</div>
                    }

                    <!-- AwaitingPackage warning -->
                    @if (_selectedSession.Status == SessionStatus.AwaitingPackage)
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Termin zarezerwowany, lecz klient nie ma aktywnego pakietu. Skontaktuj się z klientem w sprawie finansów.
                        </div>
                    }

                    <!-- Trainer/Admin actions for Scheduled or AwaitingPackage sessions -->
                    @if (_canEdit && (_selectedSession.Status == SessionStatus.Scheduled || _selectedSession.Status == SessionStatus.AwaitingPackage))
                    {
                        <div class="d-grid gap-2 mt-3">
                            <button class="btn btn-success btn-sm"
                                    @onclick='() => ChangeStatus(SessionStatus.Completed)' disabled="@_busy">
                                <i class="bi bi-check-circle me-1"></i>Oznacz jako ukończona
                            </button>
                            <button class="btn btn-warning btn-sm"
                                    @onclick='() => ChangeStatus(SessionStatus.NoShow)' disabled="@_busy">
                                <i class="bi bi-person-x me-1"></i>Klient nie przyszedł
                            </button>

                            @if (!_showRescheduleForm && !_showCancelForm)
                            {
                                <button class="btn btn-outline-primary btn-sm" @onclick="ShowRescheduleForm">
                                    <i class="bi bi-calendar-range me-1"></i>Przeplanuj wizytę
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="ShowCancelForm">
                                    <i class="bi bi-x-circle me-1"></i>Anuluj wizytę
                                </button>
                            }

                            @if (_showRescheduleForm)
                            {
                                <div class="p-3 rounded border border-primary-subtle">
                                    <label class="form-label small fw-semibold mb-1">Nowy termin</label>
                                    <input type="datetime-local" class="form-control form-control-sm mb-2"
                                           @bind="_rescheduleDateTime" @bind:format="yyyy-MM-ddTHH:mm" />
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-primary btn-sm flex-fill"
                                                @onclick="ConfirmReschedule" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                            Potwierdź
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => _showRescheduleForm = false">Wróć</button>
                                    </div>
                                </div>
                            }

                            @if (_showCancelForm)
                            {
                                <div class="p-3 rounded border border-danger-subtle">
                                    <label class="form-label small mb-1">Powód anulowania (opcjonalny)</label>
                                    <input class="form-control form-control-sm mb-2"
                                           @bind="_cancelReason" placeholder="..." />
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-danger btn-sm flex-fill"
                                                @onclick="ConfirmCancel" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                            Potwierdź
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => _showCancelForm = false">Wróć</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Client: cancel own session within trainer-configured window -->
                    @if (_isClientRole && _selectedSession.Status == SessionStatus.Scheduled
                         && (_cancellationWindowHours == 0 || _selectedSession.StartTime > DateTime.Now.AddHours(_cancellationWindowHours)))
                    {
                        <div class="mt-3">
                            @if (!_showCancelForm)
                            {
                                <button class="btn btn-outline-danger btn-sm w-100" @onclick="ShowCancelForm">
                                    <i class="bi bi-x-circle me-1"></i>Anuluj wizytę
                                </button>
                            }
                            else
                            {
                                <div class="p-3 rounded border border-danger-subtle">
                                    <label class="form-label small mb-1">Powód anulowania (opcjonalny)</label>
                                    <input class="form-control form-control-sm mb-2"
                                           @bind="_cancelReason" placeholder="..." />
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-danger btn-sm flex-fill"
                                                @onclick="ConfirmCancel" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                            Potwierdź
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => _showCancelForm = false">Wróć</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Trainer/Admin: restore cancelled or no-show sessions -->
                    @if (_canEdit && (_selectedSession.Status == SessionStatus.Cancelled
                                   || _selectedSession.Status == SessionStatus.NoShow))
                    {
                        <div class="mt-3">
                            @if (!_showRestoreConfirm)
                            {
                                <button class="btn btn-outline-secondary btn-sm w-100"
                                        @onclick="ShowRestoreConfirm">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Przywróć wizytę
                                </button>
                            }
                            else
                            {
                                <div class="p-3 rounded border border-warning-subtle">
                                    <div class="small fw-semibold mb-1 text-warning-emphasis">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Czy na pewno przywrócić tę wizytę?
                                    </div>
                                    <div class="small text-muted mb-3">
                                        Wizyta zostanie oznaczona jako zaplanowana. Upewnij się, że termin jest nadal aktualny.
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-warning btn-sm flex-fill"
                                                @onclick="ConfirmRestore" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                            Tak, przywróć
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => _showRestoreConfirm = false">Anuluj</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>
