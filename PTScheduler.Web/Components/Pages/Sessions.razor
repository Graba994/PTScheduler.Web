@code {
    private static readonly CultureInfo _pl = new("pl-PL");

    private List<SessionDto> _upcoming = [];
    private List<SessionDto> _past     = [];
    private List<ClientSummaryDto> _clients = [];
    private bool _loading = true;
    private bool _canEdit;
    private bool _isAdminRole;
    private bool _isClientRole;
    private string _userId = string.Empty;
    private string _userEmail = string.Empty;
    private string _userRole = string.Empty;
    private ClientDto? _clientDto;
    private int? _clientNumericId;
    private int _filterClientId = 0;

    // Detail panel state
    private bool _panelOpen;
    private bool _busy;
    private int _cancellationWindowHours = 24;
    private string _panelError = string.Empty;
    private SessionDto? _selectedSession;
    private bool _showCancelForm;
    private string _cancelReason = string.Empty;
    private bool _showRescheduleForm;
    private DateTime _rescheduleDateTime = DateTime.Now;
    private bool _showRestoreConfirm;

    // Booking panel state
    private bool _bookingOpen;
    private bool _bookingBusy;
    private string _bookingError = string.Empty;
    private List<SessionTypeDto> _sessionTypes = [];
    private int _bookingSessionTypeId;
    private DateTime _bookingDateTime = default;
    private string _bookingNotes = string.Empty;
    private HashSet<int> _clientCoveredTypeIds = [];
    private bool _clientHasActivePackage;

    // Slot picker
    private string _bookingMode = "single";
    private DateOnly _bookingDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private List<AvailableSlotDto> _availableSlots = [];
    private bool _loadingSlots;

    // Series booking
    private HashSet<DayOfWeek> _seriesDays = [];
    private TimeOnly _seriesTime = new(8, 0);
    private DateOnly _seriesStartDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private DateOnly? _seriesEndDate;
    private SeriesPreviewDto? _seriesPreview;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId    = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _userEmail = auth.User.Identity?.Name ?? _userId;

        _isAdminRole  = auth.User.IsInRole(Roles.Admin);
        var isTrainer = auth.User.IsInRole(Roles.Trainer) || auth.User.IsInRole(Roles.Subordinate);
        _isClientRole = auth.User.IsInRole(Roles.Client);
        _canEdit      = _isAdminRole || isTrainer;

        _userRole = _isAdminRole ? Roles.Admin
                  : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer
                  : auth.User.IsInRole(Roles.Subordinate) ? Roles.Subordinate
                  : _isClientRole ? Roles.Client : string.Empty;

        if (_canEdit)
        {
            var sessionsTrainerFilter = _isAdminRole ? null : _userId;
            _clients = await SessionService.GetClientsAsync(sessionsTrainerFilter);
        }

        if (_isClientRole)
        {
            _clientDto = await ClientService.GetClientByUserIdAsync(_userId);
            _clientNumericId = _clientDto?.Id;
        }

        await LoadSessionsAsync();
    }

    private async Task OnClientFilterChanged(ChangeEventArgs e)
    {
        _filterClientId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await LoadSessionsAsync();
    }

    private async Task LoadSessionsAsync()
    {
        _loading = true;
        try
        {
            string? trainerFilter = _canEdit && !_isAdminRole ? _userId : null;
            int?    clientFilter  = _isClientRole ? _clientNumericId
                                  : (_filterClientId > 0 ? _filterClientId : null);

            _upcoming = await SessionService.GetUpcomingAsync(trainerFilter, clientFilter, count: 100);
            _past     = await SessionService.GetPastSessionsAsync(trainerFilter, clientFilter, count: 100);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenPanel(int sessionId)
    {
        _bookingOpen        = false;
        _panelError         = string.Empty;
        _showCancelForm     = false;
        _cancelReason       = string.Empty;
        _showRescheduleForm = false;
        _showRestoreConfirm = false;
        _selectedSession    = await SessionService.GetSessionAsync(sessionId);
        if (_selectedSession is not null)
        {
            _rescheduleDateTime = _selectedSession.StartTime;
            if (_isClientRole)
            {
                var cfg = await TrainerConfigService.GetAsync(_selectedSession.TrainerUserId);
                _cancellationWindowHours = cfg.CancellationWindowHours;
            }
        }
        _panelOpen = true;
    }

    private void ClosePanel()
    {
        _panelOpen          = false;
        _selectedSession    = null;
        _showCancelForm     = false;
        _showRescheduleForm = false;
        _showRestoreConfirm = false;
        _panelError         = string.Empty;
    }

    private async Task OpenBookingPanel()
    {
        ClosePanel();
        if (_sessionTypes.Count == 0)
            _sessionTypes = await SessionService.GetSessionTypesAsync();

        // Refresh client packages to enforce booking restrictions
        if (_isClientRole && !string.IsNullOrEmpty(_userId))
        {
            _clientDto = await ClientService.GetClientByUserIdAsync(_userId);
            var activePkgs = _clientDto?.AllPackages
                .Where(p => p.Status == PTScheduler.Domain.Enums.PackageStatus.Active && p.RemainingCredits > 0)
                .ToList() ?? [];
            _clientCoveredTypeIds = activePkgs.Select(p => p.SessionTypeId).ToHashSet();
            _clientHasActivePackage = _clientCoveredTypeIds.Count > 0;
        }
        else
        {
            _clientCoveredTypeIds = [];
            _clientHasActivePackage = true;
        }

        // Auto-select first covered type (or any type for trainers)
        _bookingSessionTypeId = _isClientRole
            ? (_sessionTypes.FirstOrDefault(t => _clientCoveredTypeIds.Contains(t.Id))?.Id ?? 0)
            : (_sessionTypes.FirstOrDefault()?.Id ?? 0);

        _bookingMode     = "single";
        _bookingDate     = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        _bookingDateTime = default;
        _bookingNotes    = string.Empty;
        _bookingError    = string.Empty;
        _availableSlots  = [];
        _seriesDays      = [];
        _seriesPreview   = null;
        _bookingOpen     = true;
        if (_bookingSessionTypeId > 0)
            await LoadSlotsAsync();
    }

    private void CloseBookingPanel()
    {
        _bookingOpen  = false;
        _bookingError = string.Empty;
        _seriesPreview = null;
    }

    private void SetBookingMode(string mode)
    {
        _bookingMode = mode;
        _seriesPreview = null;
        _bookingError = string.Empty;
    }

    private async Task OnSessionTypeChangedAsync()
    {
        _bookingDateTime = default;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        if (_clientDto?.TrainerUserId is null || _bookingSessionTypeId == 0) return;
        var sessionType = _sessionTypes.FirstOrDefault(t => t.Id == _bookingSessionTypeId);
        if (sessionType is null) return;

        _loadingSlots = true;
        _availableSlots = [];
        _bookingDateTime = default;
        try
        {
            _availableSlots = await AvailabilityService.GetAvailableSlotsAsync(
                _clientDto.TrainerUserId, _bookingDate, sessionType.DurationMinutes);
        }
        finally { _loadingSlots = false; }
    }

    private void SelectSlot(AvailableSlotDto slot)
    {
        _bookingDateTime = slot.Start;
    }

    private bool IsSelectedSlot(AvailableSlotDto slot) =>
        _bookingDateTime != default && slot.Start == _bookingDateTime;

    private async Task ConfirmBooking()
    {
        if (_clientDto?.TrainerUserId is null)
        {
            _bookingError = "Nie masz przypisanego trenera. Skontaktuj się z administratorem.";
            return;
        }
        if (_bookingSessionTypeId == 0)
        {
            _bookingError = "Wybierz rodzaj sesji.";
            return;
        }
        if (_bookingDateTime == default)
        {
            _bookingError = "Wybierz termin.";
            return;
        }
        _bookingBusy = true; _bookingError = string.Empty;
        try
        {
            var dto = new CreateSessionDto
            {
                ClientId       = _clientDto.Id,
                SessionTypeId  = _bookingSessionTypeId,
                TrainerUserId  = _clientDto.TrainerUserId,
                StartTime      = _bookingDateTime,
                Notes          = string.IsNullOrWhiteSpace(_bookingNotes) ? null : _bookingNotes.Trim()
            };
            await SessionService.CreateSessionAsync(dto, allowAwaitingPackage: false);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionBooked", "Session",
                null, $"Termin: {_bookingDateTime:dd.MM.yyyy HH:mm}");
            CloseBookingPanel();
            await LoadSessionsAsync();
        }
        catch (Exception ex) { _bookingError = ex.Message; }
        finally { _bookingBusy = false; }
    }

    private void ToggleSeriesDay(DayOfWeek d)
    {
        if (!_seriesDays.Remove(d)) _seriesDays.Add(d);
        _seriesPreview = null;
    }

    private async Task PreviewSeriesAsync()
    {
        if (_clientDto?.TrainerUserId is null || _seriesDays.Count == 0) return;
        _bookingBusy = true; _bookingError = string.Empty;
        try
        {
            _seriesPreview = await SeriesService.PreviewAsync(BuildSeriesDto());
        }
        catch (Exception ex) { _bookingError = ex.Message; }
        finally { _bookingBusy = false; }
    }

    private async Task ConfirmSeriesAsync()
    {
        if (_clientDto?.TrainerUserId is null || _seriesDays.Count == 0) return;
        _bookingBusy = true; _bookingError = string.Empty;
        try
        {
            var result = await SeriesService.CreateAsync(BuildSeriesDto(), skipConflicts: true);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SeriesCreated", "SessionSeries",
                result.Id.ToString(), $"Klient: {_clientDto.FullName}, sesje: {result.TotalSessionsCreated}");
            CloseBookingPanel();
            await LoadSessionsAsync();
        }
        catch (Exception ex) { _bookingError = ex.Message; }
        finally { _bookingBusy = false; }
    }

    private CreateSessionSeriesDto BuildSeriesDto() => new()
    {
        ClientId       = _clientDto!.Id,
        TrainerUserId  = _clientDto.TrainerUserId!,
        SessionTypeId  = _bookingSessionTypeId,
        RecurrenceDays = [.. _seriesDays],
        StartTime      = _seriesTime,
        StartDate      = _seriesStartDate,
        EndDate        = _seriesEndDate,
    };

    private void ShowCancelForm()    { _showCancelForm = true; _showRescheduleForm = false; }
    private void ShowRescheduleForm() { _showRescheduleForm = true; _showCancelForm = false; }
    private void ShowRestoreConfirm() => _showRestoreConfirm = true;

    private async Task ChangeStatus(SessionStatus status)
    {
        if (_selectedSession is null) return;
        _busy = true; _panelError = string.Empty;
        try
        {
            await SessionService.UpdateStatusAsync(_selectedSession.Id, status);
            var action = status == SessionStatus.Completed ? "SessionCompleted" : "SessionNoShow";
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, action, "Session",
                _selectedSession.Id.ToString(),
                $"Klient: {_selectedSession.ClientName}, termin: {_selectedSession.StartTime:dd.MM.yyyy HH:mm}");
            ClosePanel();
            await LoadSessionsAsync();
        }
        catch (Exception ex) { _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmCancel()
    {
        if (_selectedSession is null) return;
        _busy = true; _panelError = string.Empty;
        try
        {
            var suffix = string.IsNullOrEmpty(_cancelReason) ? "" : $", powód: {_cancelReason}";
            var baseDetails = $"Klient: {_selectedSession.ClientName}, termin: {_selectedSession.StartTime:dd.MM.yyyy HH:mm}";
            if (_isClientRole)
            {
                await SessionService.ClientCancelSessionAsync(_selectedSession.Id, _userId, _cancelReason);
                await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionCancelledByClient", "Session",
                    _selectedSession.Id.ToString(), baseDetails + suffix);
            }
            else
            {
                await SessionService.UpdateStatusAsync(_selectedSession.Id, SessionStatus.Cancelled, _cancelReason);
                await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionCancelled", "Session",
                    _selectedSession.Id.ToString(), baseDetails + suffix);
            }
            ClosePanel();
            await LoadSessionsAsync();
        }
        catch (Exception ex) { _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmReschedule()
    {
        if (_selectedSession is null) return;
        _busy = true; _panelError = string.Empty;
        try
        {
            var oldTime = _selectedSession.StartTime;
            await SessionService.RescheduleAsync(_selectedSession.Id, _rescheduleDateTime);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionRescheduled", "Session",
                _selectedSession.Id.ToString(),
                $"Klient: {_selectedSession.ClientName}, stary termin: {oldTime:dd.MM.yyyy HH:mm}, nowy: {_rescheduleDateTime:dd.MM.yyyy HH:mm}");
            ClosePanel();
            await LoadSessionsAsync();
        }
        catch (Exception ex) { _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmRestore()
