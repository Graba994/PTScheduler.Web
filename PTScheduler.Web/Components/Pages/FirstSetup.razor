    private async Task SavePayAsync()
    {
        if (_paymentsOn) { await NextAsync(); return; }
        if (_payChoice == "online")
        {
            if (PayMeta is not { } meta) return;
            var missing = meta.Fields.Where(f => string.IsNullOrWhiteSpace(PayField(f.Key))).Select(f => f.Label).ToList();
            if (missing.Count > 0) { _error = $"Uzupełnij: {string.Join(", ", missing)}."; return; }
        }
        await RunAsync(async () =>
        {
            if (_payChoice == "online")
            {
                var pay = await PaymentSettings.GetAsync();
                var cfg = pay.Provider(_payKey);
                if (cfg is null) pay.Providers.Add(cfg = new PaymentProviderConfigDto { Key = _payKey });
                cfg.Enabled = true;
                cfg.Sandbox = _paySandbox;
                foreach (var f in PayMeta!.Fields) cfg.Fields[f.Key] = PayField(f.Key);
                pay.Enabled = true;
                await PaymentSettings.SaveAsync(pay);
                await Setup.SetDecisionAsync("payments-offline", false);
                _paymentsOn = true;
                _payNames = [PayMeta.Name];
                _saved.Add("pay");
            }
            else if (_payChoice == "offline")
            {
                await Setup.SetDecisionAsync("payments-offline", true);
                _saved.Add("pay");
            }
        });
    }

    // ── Pierwszy plan ──
    private async Task LoadPlanClientsAsync()
    {
        try
        {
            _planClients = (await ClientService.GetClientsAsync(_isAdmin ? null : _trainerId))
                .OrderByDescending(c => c.CreatedAt).Take(100).ToList();
            if (_planClients.Count > 0 && _planClients.All(c => c.Id != _planClientId))
            {
                _planClientId = _planClients[0].Id;
                PlanClientChanged();
            }
        }
        catch (Exception) { _planClients = []; }
    }

    private void PlanClientChanged()
    {
        _planProposal = null;
        _planFocus = PlanGeneratorRules.FocusFromGoal(_planClients.FirstOrDefault(c => c.Id == _planClientId)?.TrainingGoal);
    }

    private async Task ProposePlanAsync()
    {
        if (_trainerId is null || _planClientId == 0) return;
        _planBusy = true;
        _error = null;
        try
        {
            // Tylko reguły (bez AI) — propozycja w sekundę; AI jest w edytorze planu, gdy trener zechce.
            var minutes = _types.FirstOrDefault(t => t.Active)?.Minutes ?? 60;
            _planProposal = await Generator.ProposeAsync(_planClientId, _trainerId, new PlanGeneratorRules.Options(_planDays, minutes, _planFocus, _planKit), false, null);
        }
        catch (Exception) { _error = "Nie udało się ułożyć propozycji. Spróbuj jeszcze raz albo pomiń — plan ułożysz w zakładce Plany."; }
        finally { _planBusy = false; }
    }

    private async Task AssignPlanAsync()
    {
        if (_planProposal is not { } prop || _trainerId is null) return;
        await RunAsync(async () =>
        {
            var meta = await Generator.MetaAsync(prop.Plan.Days.SelectMany(d => d.Exercises).Select(e => e.ExerciseId));
            var dto = PTScheduler.Web.Services.PlanGeneratorService.ToEditDto(prop.Plan, _planClientId, meta);
            await TrainingPlans.SavePlanAsync(_trainerId, dto, _isAdmin);
            var who = _planClients.FirstOrDefault(c => c.Id == _planClientId)?.FullName ?? "Klient";
            _planDone = $"„{dto.Name}” — {who} widzi go już w aplikacji.";
            _saved.Add("plan");
        });
    }

    private static string Dose(PlanGeneratorRules.Pick x) =>
        x.DurationSeconds is int sec ? $"{x.Sets} × {sec} s" : $"{x.Sets} × {x.Reps ?? "—"}";

    // ── Klient ──
    private async Task AddClientAsync()
    {
        _error = null;
        var name = _cName.Trim();
        if (name.Length == 0) { _error = "Podaj imię i nazwisko."; return; }
        if (EmailRules.Problem(_cEmail) is { } problem) { _error = problem; return; }
        await RefreshLimitAsync();
        if (_limitReached) return;
        var space = name.IndexOf(' ');
        var dto = new CreateClientDto
        {
            FirstName = space > 0 ? name[..space] : name,
            LastName = space > 0 ? name[(space + 1)..].Trim() : "",
            Email = EmailRules.Normalize(_cEmail),
            Phone = string.IsNullOrWhiteSpace(_cPhone) ? null : _cPhone.Trim(),
            TrainerUserId = _trainerId
        };
        _busy = true;
        try
        {
            var result = await ClientService.AddClientAsync(dto);
            if (!result.Ok) { _error = result.Error ?? "Nie udało się dodać klienta."; return; }
            var note = result.Notice ?? "dodano do Twoich klientów";
            if (_cInvite && result.Notice is null)
            {
                var r = await Invitations.SendInviteAsync(result.Client!.Id, Nav.BaseUri);
                note = r.EmailSent ? $"zaproszenie wysłane na {dto.Email}" : "dodano — zaproszenia nie udało się wysłać, wyślesz je z profilu klienta";
            }
            _added.Add((name, note));
            _saved.Add("client");
            _clientCount++;
            _cName = _cEmail = _cPhone = "";
            await RefreshLimitAsync();
        }
        catch (Exception)
        {
            _error = "Nie udało się dodać klienta. Spróbuj jeszcze raz albo dodaj go później w zakładce Klienci.";
        }
        finally { _busy = false; }
    }

    // Limit planu liczy wszystkich klientów studia, a _clientCount u trenera to tylko jego klienci.
    private async Task RefreshLimitAsync() =>
        (_, _studioClients, _maxClients) = await Entitlements.CheckClientLimitAsync();

    private (string Text, bool Reached)? LimitNote => FirstSetupRules.ClientLimitNote(_studioClients, _maxClients, _clientCount, _isOwner);

    private async Task CopyAsync(string text)
    {
        try { if (await JS.InvokeAsync<bool>("ptShare.copy", text)) _copied = text; } catch (JSException) { }
    }

    // ── Nawigacja ──
    private async Task RunAsync(Func<Task> save)
    {
        _error = null;
        _busy = true;
        try
        {
            await save();
            await NextAsync();
        }
        catch (Exception)
        {
            _error = "Nie udało się zapisać. Spróbuj jeszcze raz albo pomiń — ustawisz to później w Zarządzaniu.";
        }
        finally { _busy = false; }
    }

    private Task NextAsync() => GoAsync(_at + 1);

    private async Task GoAsync(int idx)
    {
        _error = null;
        _at = Math.Clamp(idx, 0, _steps.Count);
        if (Current == "plan" && _planDone is null) await LoadPlanClientsAsync();
        _qrDrawn = false;
        try { await JS.InvokeVoidAsync("ptFirstSetup.save", StorageKey, _at >= _steps.Count ? "done" : _steps[_at]); } catch (JSException) { }
        try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch (JSException) { }
    }

    private RenderFragment Error() => __builder =>
    {
        if (_error is not null)
        {
            <div class="alert alert-danger py-2 mt-3 mb-0" role="alert">@_error</div>
        }
    };

    private RenderFragment Busy() => __builder =>
    {
        if (_busy)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
    };

    private static string Hours(IEnumerable<FirstSetupRules.Window> w)
    {
        var h = FirstSetupRules.TotalHours(w);
        return $"{h:0.#} h";
    }

