    private async Task LoadMailAsync(string? myEmail)
    {
        var mail = await MailSettings.GetAsync();
        _platform = await PlatformMail.GetStatusAsync() is not null;
        var own = mail.IsEnabled && !string.IsNullOrWhiteSpace(mail.SmtpHost);
        _mailChoice = own ? "own" : _platform ? "hantly" : "own";
        _replyTo = mail.ReplyTo ?? myEmail ?? "";
        if (!string.IsNullOrWhiteSpace(mail.FromName) && mail.FromName is not ("Hantly" or "PTScheduler")) _studio = mail.FromName;
        if (own || !string.IsNullOrWhiteSpace(mail.ReplyTo)) _saved.Add("mail");
        _ownOk = own;
        _ownEmail = own ? mail.FromAddress : _replyTo;
        _workspace = mail.Provider == "GoogleWorkspace";
    }

    private void CheckReply() => _replyProblem = string.IsNullOrWhiteSpace(_replyTo) ? null : EmailRules.Problem(_replyTo);

    private async Task SaveMailAsync()
    {
        if (_mailChoice == "own")
        {
            // Niepodłączona skrzynka nie blokuje — do tego czasu (o ile się da) wysyła Hantly w imieniu studia.
            if (_ownOk) _saved.Add("mail");
            await NextAsync();
            return;
        }
        CheckReply();
        if (_replyProblem is not null) return;
        await RunAsync(async () =>
        {
            var mail = await MailSettings.GetAsync();
            mail.ReplyTo = string.IsNullOrWhiteSpace(_replyTo) ? null : EmailRules.Normalize(_replyTo);
            // Hantly wysyła: własna skrzynka wyłączona, nadawcą zostaje nazwa studia.
            mail.IsEnabled = false;
            if (string.IsNullOrWhiteSpace(mail.FromName) || mail.FromName is "Hantly" or "PTScheduler") mail.FromName = _studio;
            mail.Password = ""; // puste = bez zmiany zapisanego hasła
            await MailSettings.SaveAsync(mail);
            _saved.Add("mail");
        });
    }

    // ── Własna skrzynka ──
    /// <summary>Test z danymi z formularza (wiadomość na ten sam adres); zapis i włączenie dopiero, gdy serwer ją przyjmie.</summary>
    private async Task VerifyOwnAsync()
    {
        _ownError = null;
        if (EmailRules.Problem(_ownEmail) is { } problem) { _ownError = problem; return; }
        if (OwnProvider is not { } prov) return;
        var host = prov.CustomHost && !string.IsNullOrWhiteSpace(_ownHost) ? _ownHost.Trim() : prov.Host;
        if (string.IsNullOrWhiteSpace(host)) { _ownError = "Wpisz serwer SMTP z panelu hostingu."; return; }
        _testingOwn = true;
        try
        {
            var email = EmailRules.Normalize(_ownEmail);
            var dto = await MailSettings.GetAsync();
            dto.Provider = prov.Key is "Gmail" or "GoogleWorkspace" ? prov.Key : "Custom";
            dto.SmtpHost = host;
            dto.SmtpPort = prov.CustomHost ? _ownPort : prov.Port;
            dto.UseTls = true;
            dto.Login = email;
            // Hasło aplikacji Google pokazuje się w grupach po 4 znaki — spacje nie są jego częścią.
            dto.Password = prov.Key is "Gmail" or "GoogleWorkspace" ? _ownPass.Replace(" ", "") : _ownPass.Trim();
            dto.FromAddress = email;
            if (string.IsNullOrWhiteSpace(dto.FromName) || dto.FromName is "Hantly" or "PTScheduler") dto.FromName = _studio;
            if (string.IsNullOrWhiteSpace(dto.ReplyTo)) dto.ReplyTo = email;
            var (ok, error) = await MailService.TestOwnAsync(dto, email);
            if (!ok)
            {
                _ownError = $"Skrzynka nie przyjęła wiadomości ({error}). Sprawdź hasło i czy dostęp dla programów pocztowych jest włączony — albo zamów podłączenie poniżej.";
                return;
            }
            dto.IsEnabled = true;
            await MailSettings.SaveAsync(dto);
            _ownOk = true;
            _ownEmail = email;
            _ownPass = "";
            if (string.IsNullOrWhiteSpace(_replyTo)) _replyTo = email;
            _saved.Add("mail");
        }
        catch (Exception)
        {
            _ownError = "Nie udało się sprawdzić skrzynki. Spróbuj jeszcze raz albo zamów podłączenie poniżej.";
        }
        finally { _testingOwn = false; }
    }

