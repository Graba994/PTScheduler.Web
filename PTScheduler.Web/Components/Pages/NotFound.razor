@layout PTScheduler.Web.Components.Layout.MainLayout

<AppTitle Page="Nie znaleziono" />

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;text-align:center;padding:2rem">

    <div style="position:relative;margin-bottom:1.5rem">
        <i class="bi bi-calendar-x" style="font-size:6rem;color:var(--c-primary);opacity:.15;display:block"></i>
        <span style="position:absolute;top:50%;left:50%;transform:translate(-50%,-55%);font-size:2rem;font-weight:900;color:var(--c-primary);letter-spacing:-.03em">404</span>
    </div>

    <h2 class="fw-bold mb-2" style="font-size:1.5rem">Tej strony nie ma</h2>

    <p class="text-muted mb-1" style="font-size:1rem;max-width:380px">
        Podobnie jak six-pack po majówce.
    </p>
    <p class="text-muted small mb-4" style="max-width:380px">
        Strona, której szukasz, musiała pójść na zaległy trening nóg.<br />
        Albo nigdy nie istniała. Trudno powiedzieć.
    </p>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        <a href="/" class="btn btn-primary px-4">
            <i class="bi bi-house-fill me-2"></i>Wróć na start
        </a>
        <button class="btn btn-outline-secondary px-4" onclick="history.back()">
            <i class="bi bi-arrow-left me-2"></i>Cofnij
        </button>
    </div>

    <p class="text-muted mt-5" style="font-size:.7rem;opacity:.5">
        Pro tip: ból mięśni po 404 nie istnieje, bo trening i tak nie był zaplanowany.
    </p>
</div>
