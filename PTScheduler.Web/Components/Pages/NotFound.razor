@page "/not-found"
@layout PTScheduler.Web.Components.Layout.MainLayout

<AppTitle Page="Nie znaleziono" />

<ErrorScreen Emoji="🤷"
             Tone="cold"
             Title="Tej strony nie ma"
             Lead="Podobnie jak six-pack po majówce.">
    <Body>
        <p>Strona, której szukasz, poszła na zaległy trening nóg. Albo nigdy nie istniała — trudno powiedzieć.</p>
    </Body>
    <Actions>
        <a href="/" class="es-btn">
            <i class="bi bi-house-fill"></i> Wróć na start
        </a>
        <button class="es-btn es-btn-ghost" onclick="history.back()">
            <i class="bi bi-arrow-left"></i> Cofnij
        </button>
    </Actions>
</ErrorScreen>
