    }

    private async Task ConfirmBooking()
    {
        if (_bookingClientId == 0 || _bookingSessionTypeId == 0) return;
        _bookingBusy = true; _bookingError = string.Empty;
        try
        {
            var dto = new CreateSessionDto
            {
                ClientId      = _bookingClientId,
                TrainerUserId = _userId,
                SessionTypeId = _bookingSessionTypeId,
                StartTime     = _bookingDateTime,
                Notes         = string.IsNullOrWhiteSpace(_bookingNotes) ? null : _bookingNotes.Trim()
            };
            var created = await SessionService.CreateSessionAsync(dto);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionBooked", "Session",
                created.Id.ToString(), $"Klient: {created.ClientName}, termin: {_bookingDateTime:dd.MM.yyyy HH:mm}");
            CloseBookingPanel();
            if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
        }
        catch (Exception ex) { _bookingError = ex.Message; }
        finally { _bookingBusy = false; }
    }

    private void ToggleInviteSection()
    {
        _showInviteSection = !_showInviteSection;
        _inviteError   = string.Empty;
        _inviteSuccess = string.Empty;
    }

    private async Task SendInvitationAsync()
    {
        if (_selectedSession is null || _inviteClientId == 0) return;
        _inviteError = string.Empty; _inviteSuccess = string.Empty;
        _busy = true;
        try
        {
            await InvitationService.SendAsync(_selectedSession.Id, _inviteClientId, _userId);
            _inviteSuccess = "Zaproszenie wysłane.";
            _inviteClientId = 0;
            _invitations = await InvitationService.GetForSessionAsync(_selectedSession.Id);
        }
        catch (Exception ex) { _inviteError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RevokeInvitationAsync(int invitationId)
    {
        if (_selectedSession is null) return;
        _inviteError = string.Empty; _inviteSuccess = string.Empty;
        try
        {
            await InvitationService.RevokeAsync(invitationId);
            _invitations = await InvitationService.GetForSessionAsync(_selectedSession.Id);
        }
        catch (Exception ex) { _inviteError = ex.Message; }
    }

    private static string InvBadge(PTScheduler.Domain.Enums.InvitationStatus s) => s switch
    {
        PTScheduler.Domain.Enums.InvitationStatus.Accepted => "bg-success",
        PTScheduler.Domain.Enums.InvitationStatus.Declined => "bg-danger",
        _                                                   => "bg-warning text-dark"
    };

    private static string InvLabel(PTScheduler.Domain.Enums.InvitationStatus s) => s switch
    {
        PTScheduler.Domain.Enums.InvitationStatus.Accepted => "Zaakceptowane",
        PTScheduler.Domain.Enums.InvitationStatus.Declined => "Odrzucone",
        _                                                   => "Oczekuje"
    };

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();

    private static string StatusBadge(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled       => "bg-primary",
        SessionStatus.Completed       => "bg-success",
        SessionStatus.Cancelled       => "bg-danger",
        SessionStatus.NoShow          => "bg-warning text-dark",
        SessionStatus.AwaitingPackage => "bg-orange text-white",
        _                             => "bg-secondary"
    };

    private static string StatusLabel(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled       => "Zaplanowana",
        SessionStatus.Completed       => "Ukończona",
        SessionStatus.Cancelled       => "Anulowana",
        SessionStatus.NoShow          => "Nieobecność",
        SessionStatus.AwaitingPackage => "Oczekuje na pakiet",
        _                             => s.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("destroyCalendar");
            await _module.DisposeAsync();
        }
        _ref?.Dispose();
    }
