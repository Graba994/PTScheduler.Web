@page "/calendar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@inject IJSRuntime JS
@using PTScheduler.Application.Scheduling
@inject ISessionService SessionService
@inject IClientService ClientService
@inject IAuditLogService AuditLogService
@inject IPairService PairService
@inject ITrainerAvailabilityService AvailabilityService
@inject IGoogleCalendarService GoogleCalendar
@inject ITrainerConfigService TrainerConfigService
@inject IAppClock Clock
@inject AuthenticationStateProvider AuthState
@inject ILogger<Calendar> Logger
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Exceptions
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@using System.Globalization
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Kalendarz" />

<div class="cal-shell">

    <!-- Topbar -->
    <div class="cal-topbar">
        <div class="d-flex align-items-center gap-2">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-calendar3 me-2"></i>Kalendarz
            </h4>
            <CalendarFeedButton />
        </div>
        <div class="cal-filters">
            <button class='cal-filter-chip chip-all @(IsAllActive ? "active" : "")'
                    @onclick='() => ToggleFilter("All")'>Wszystkie</button>
            <button class='cal-filter-chip chip-scheduled @(_activeStatuses.Contains("Scheduled") ? "active" : "")'
                    @onclick='() => ToggleFilter("Scheduled")'>
                <span class="chip-dot"></span>Zaplanowane
            </button>
            <button class='cal-filter-chip chip-awaiting @(_activeStatuses.Contains("AwaitingPackage") ? "active" : "")'
                    @onclick='() => ToggleFilter("AwaitingPackage")'>
                <span class="chip-dot"></span>Oczekuje na pakiet
            </button>
            <button class='cal-filter-chip chip-completed @(_activeStatuses.Contains("Completed") ? "active" : "")'
                    @onclick='() => ToggleFilter("Completed")'>
                <span class="chip-dot"></span>Ukończone
            </button>
            <button class='cal-filter-chip chip-cancelled @(_activeStatuses.Contains("Cancelled") ? "active" : "")'
                    @onclick='() => ToggleFilter("Cancelled")'>
                <span class="chip-dot"></span>Anulowane
            </button>
            <button class='cal-filter-chip chip-noshow @(_activeStatuses.Contains("NoShow") ? "active" : "")'
                    @onclick='() => ToggleFilter("NoShow")'>
                <span class="chip-dot"></span>Nieobecność
            </button>
        </div>
    </div>

    <!-- Body -->
    <div class="cal-body">
        <div class="cal-main">
            <div @ref="_calendarEl" id="main-calendar"></div>
        </div>

        <!-- Session detail panel -->
        @if (_panelOpen && _selectedSession is not null && !_bookingOpen)
        {
            <div class="cal-panel">
                <div class="cal-panel-header">
                    <span class="fw-semibold">Szczegóły wizyty</span>
                    <button class="btn-close btn-sm" @onclick="ClosePanel"></button>
                </div>
                <div class="cal-panel-body">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="avatar-circle" style="width:52px;height:52px;font-size:1.1rem">
                            @if (_selectedSession.IsPair) { <i class="bi bi-people-fill"></i> } else { @Initials(_selectedSession.ClientName) }
                        </div>
                        <div>
                            <div class="fw-bold fs-6">@(_isClientRole ? _selectedSession.ClientName : _selectedSession.DisplayName)</div>
                            <small class="text-muted">@_selectedSession.SessionTypeName@(_selectedSession.IsPair ? " · w parze" : "")</small>
                        </div>
                    </div>

                    @if (_selectedSession.IsPair && _selectedSession.PartnerName is not null)
                    {
                        <div class="pair-box mb-3">
                            <div class="pair-box-title"><i class="bi bi-people me-1"></i>Trening w parze
                                <InfoTip Title="Jak działa trening w parze">
                                    Każda osoba ma własną wizytę: swój grafik, przypomnienie i możliwość odwołania.
                                    Gdy jedna odwoła, druga trenuje sama. Ze wspólnego pakietu „Duet” za trening schodzi 1,
                                    a bez niego — po 1 z pakietu każdej osoby.
                                </InfoTip>
                            </div>
                            <div class="pair-person">
                                <span>@_selectedSession.ClientName</span>
                                <span class="badge @StatusBadge(_selectedSession.Status)">@StatusLabel(_selectedSession.Status)</span>
                            </div>
                            <div class="pair-person">
                                <span>@_selectedSession.PartnerName</span>
                                <span class="d-flex align-items-center gap-2">
                                    <span class="badge @StatusBadge(_selectedSession.PartnerStatus ?? SessionStatus.Scheduled)">@StatusLabel(_selectedSession.PartnerStatus ?? SessionStatus.Scheduled)</span>
                                    @if (_canEdit && _selectedSession.PartnerStatus is SessionStatus.Cancelled or SessionStatus.NoShow
                                         && _selectedSession.PartnerSessionId is int psid)
                                    {
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => RestorePartner(psid)" disabled="@_busy">Przywróć</button>
                                    }
                                </span>
                            </div>
                            <div class="pair-box-hint">
                                @PackageHint(_selectedSession)
                            </div>
                        </div>
                    }

                    <div class="session-detail-list">
                        <div class="session-detail-row">
                            <i class="bi bi-calendar-event"></i>
                            <span>@_selectedSession.StartTime.ToString("dddd, d MMMM yyyy", new CultureInfo("pl-PL"))</span>
                        </div>
                        <div class="session-detail-row">
                            <i class="bi bi-clock"></i>
                            <span>
                                @_selectedSession.StartTime.ToString("HH:mm") – @_selectedSession.EndTime.ToString("HH:mm")
                                <span class="text-muted">(@_selectedSession.DurationMinutes min)</span>
                            </span>
                        </div>
                        <div class="session-detail-row">
                            <i class="bi bi-person"></i>
                            <span>@_selectedSession.TrainerName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_selectedSession.MeetingUrl))
                        {
                            <div class="session-detail-row">
                                <i class="bi bi-camera-video"></i>
                                <a href="@_selectedSession.MeetingUrl" target="_blank" rel="noopener"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-google me-1"></i>Dołącz do Google Meet
                                </a>
                            </div>
                        }
                        <div class="session-detail-row">
                            <i class="bi bi-circle-fill" style="font-size:.45rem;margin-top:5px"></i>
                            <span class="badge @StatusBadge(_selectedSession.Status)">@StatusLabel(_selectedSession.Status)</span>
                        </div>
                    </div>

                    <OffPackagePanel Session="_selectedSession" CanManage="!_isClientRole" OnChanged="OnOffPackageChanged" />

                    @if (!string.IsNullOrEmpty(_selectedSession.Notes))
                    {
                        <div class="p-3 rounded mb-3" style="background:var(--bs-tertiary-bg)">
                            <div class="small text-muted fw-semibold mb-1">Notatki</div>
                            <div class="small">@_selectedSession.Notes</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_selectedSession.CancellationReason))
                    {
                        <div class="p-3 rounded bg-danger bg-opacity-10 mb-3">
                            <div class="small text-danger fw-semibold mb-1">Powód anulowania</div>
                            <div class="small">@_selectedSession.CancellationReason</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_panelError))
                    {
                        <div class="alert alert-danger py-2 small">@_panelError</div>
                    }

                    <!-- Trainer/Admin actions: Scheduled or AwaitingPackage -->
                    @if (_canEdit && (_selectedSession.Status == SessionStatus.Scheduled
                                   || _selectedSession.Status == SessionStatus.AwaitingPackage))
                    {
                        <div class="d-grid gap-2 mt-3">
                            <button class="btn btn-success btn-sm"
                                    @onclick='async () => await ChangeStatus(SessionStatus.Completed, includePartner: true)' disabled="@_busy">
                                <i class="bi bi-check-circle me-1"></i>@(PairActive ? "Oznacz jako ukończony (oboje)" : "Oznacz jako ukończona")
                            </button>
                            @if (!_confirmNoShow)
                            {
                                <button class="btn btn-warning btn-sm"
                                        @onclick="() => _confirmNoShow = true" disabled="@_busy">
                                    <i class="bi bi-person-x me-1"></i>@(PairActive ? "Ktoś nie przyszedł" : "Klient nie przyszedł")
                                </button>
                            }
                            else if (PairActive)
                            {
                                <div class="p-2 rounded border border-warning-subtle text-center">
                                    <div class="small fw-semibold mb-2">Kto nie przyszedł?</div>
                                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                                        <button class="btn btn-warning btn-sm"
                                                @onclick='async () => { _confirmNoShow = false; await ChangeStatus(SessionStatus.NoShow); }' disabled="@_busy">
                                            @_selectedSession.ClientName
                                        </button>
                                        <button class="btn btn-warning btn-sm"
                                                @onclick='async () => { _confirmNoShow = false; await ChangeStatus(SessionStatus.NoShow, targetId: _selectedSession.PartnerSessionId); }' disabled="@_busy">
                                            @_selectedSession.PartnerName
                                        </button>
                                        <button class="btn btn-warning btn-sm"
                                                @onclick='async () => { _confirmNoShow = false; await ChangeStatus(SessionStatus.NoShow, includePartner: true); }' disabled="@_busy">
                                            Oboje
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                @onclick="() => _confirmNoShow = false">
                                            Wróć
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-2 rounded border border-warning-subtle text-center">
                                    <div class="small fw-semibold mb-2">Oznaczyć jako nieobecność?</div>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button class="btn btn-warning btn-sm"
                                                @onclick='async () => { _confirmNoShow = false; await ChangeStatus(SessionStatus.NoShow); }' disabled="@_busy">
                                            Tak
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                @onclick="() => _confirmNoShow = false">
                                            Nie
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (!_showRescheduleForm && !_showCancelForm)
                            {
                                <button class="btn btn-outline-primary btn-sm" @onclick="ShowRescheduleForm">
                                    <i class="bi bi-calendar-range me-1"></i>Przeplanuj wizytę
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="ShowCancelForm">
                                    <i class="bi bi-x-circle me-1"></i>Anuluj wizytę
                                </button>
                            }

                            @if (_showRescheduleForm)
                            {
                                <div class="p-3 rounded border border-primary-subtle">
                                    <label class="form-label small fw-semibold mb-1">Nowy termin</label>
                                    @if (PairActive)
                                    {
                                        <div class="small text-muted mb-1">Przeniesiemy trening dla obu osób — każda dostanie wiadomość.</div>
                                    }
                                    <input type="datetime-local" class="form-control form-control-sm mb-2"
                                           @bind="_rescheduleDateTime" @bind:format="yyyy-MM-ddTHH:mm"
                                           @bind:after="() => _rescheduleOverlap = false" />
                                    @if (_rescheduleOverlap)
                                    {
                                        <div class="alert alert-warning py-2 small mb-2">
                                            Ten termin nachodzi na inną sesję. Możesz nałożyć terminy mimo to.
                                        </div>
                                    }
                                    <div class="d-flex gap-2">
                                        @if (_rescheduleOverlap)
                                        {
                                            <button class="btn btn-warning btn-sm flex-fill"
                                                    @onclick="() => ConfirmReschedule(true)" disabled="@_busy">
                                                @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                                Nałóż mimo to
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm flex-fill"
                                                    @onclick="() => ConfirmReschedule(false)" disabled="@_busy">
                                                @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                                Potwierdź
                                            </button>
                                        }
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => { _showRescheduleForm = false; _rescheduleOverlap = false; }">Wróć</button>
                                    </div>
                                </div>
                            }

                            @if (_showCancelForm)
                            {
                                <div class="p-3 rounded border border-danger-subtle">
                                    @if (PairActive)
                                    {
                                        <div class="small fw-semibold mb-1">Kogo odwołać?</div>
                                        <div class="d-flex flex-column gap-1 mb-2 small">
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="cscope" checked="@(_cancelScope == 0)" @onchange="() => _cancelScope = 0" />
                                                <span class="form-check-label">Cały trening (oboje)</span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="cscope" checked="@(_cancelScope == _selectedSession.Id)" @onchange="() => _cancelScope = _selectedSession.Id" />
                                                <span class="form-check-label">Tylko @_selectedSession.ClientName — @_selectedSession.PartnerName trenuje bez pary</span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="cscope" checked="@(_cancelScope == _selectedSession.PartnerSessionId)" @onchange="() => _cancelScope = _selectedSession.PartnerSessionId ?? 0" />
                                                <span class="form-check-label">Tylko @_selectedSession.PartnerName — @_selectedSession.ClientName trenuje bez pary</span>
                                            </label>
                                        </div>
                                    }
                                    <label class="form-label small mb-1">Powód anulowania (opcjonalny)</label>
                                    <input class="form-control form-control-sm mb-2" @bind="_cancelReason" placeholder="..." />
                                    <div class="form-check small mb-2">
                                        <input class="form-check-input" type="checkbox" id="chargeLate" @bind="_chargeLate" />
                                        <label class="form-check-label" for="chargeLate">
                                            Późne odwołanie przez klienta — sesja przepada (nie wraca do pakietu)
                                        </label>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-danger btn-sm flex-fill"
                                                @onclick="ConfirmCancel" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                            Potwierdź
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => _showCancelForm = false">Wróć</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Restore cancelled/noshow -->
                    @if (_canEdit && (_selectedSession.Status == SessionStatus.Cancelled
                                   || _selectedSession.Status == SessionStatus.NoShow))
                    {
                        <div class="mt-3">
                            @if (!_showRestoreConfirm)
                            {
                                <button class="btn btn-outline-secondary btn-sm w-100"
                                        @onclick="() => _showRestoreConfirm = true">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Przywróć wizytę
                                </button>
                            }
                            else
                            {
                                <div class="p-3 rounded border border-warning-subtle">
                                    <div class="small fw-semibold mb-2 text-warning-emphasis">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Czy na pewno przywrócić?
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-warning btn-sm flex-fill"
                                                @onclick="ConfirmRestore" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                            Tak, przywróć
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => _showRestoreConfirm = false">Anuluj</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Client: cancel own session -->
                    @if (_isClientRole && _selectedSession.Status == SessionStatus.Scheduled
                         && CancellationRules.ForClient(_trainerCfg, _selectedSession.StartTime, Clock.LocalNow).Allowed)
                    {
                        <div class="mt-3">
                            @if (!_showCancelForm)
                            {
                                <button class="btn btn-outline-danger btn-sm w-100" @onclick="ShowCancelForm">
                                    <i class="bi bi-x-circle me-1"></i>Anuluj wizytę
                                </button>
                            }
                            else
                            {
                                <div class="p-3 rounded border border-danger-subtle">
                                    @if (PairActive)
                                    {
                                        <div class="small text-muted mb-2">Odwołujesz tylko swój udział — @_selectedSession.PartnerName trenuje dalej i dostanie o tym wiadomość.</div>
                                    }
                                    <label class="form-label small mb-1">Powód anulowania (opcjonalny)</label>
                                    <input class="form-control form-control-sm mb-2" @bind="_cancelReason" placeholder="..." />
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-danger btn-sm flex-fill"
                                                @onclick="ConfirmCancel" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                            Potwierdź
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => _showCancelForm = false">Wróć</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Booking panel (trainer clicks empty slot) -->
        @if (_bookingOpen && _canEdit)
        {
            <div class="cal-panel">
                <div class="cal-panel-header">
                    <span class="fw-semibold"><i class="bi bi-calendar-plus me-2"></i>Nowa wizyta</span>
                    <button class="btn-close btn-sm" @onclick="CloseBookingPanel"></button>
                </div>
                <div class="cal-panel-body">

                    @if (!string.IsNullOrEmpty(_bookingError))
                    {
                        <div class="alert alert-danger py-2 small">@_bookingError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Klient</label>
                        <select class="form-select form-select-sm" @bind="_bookingClientId" @bind:after="LoadBookingPartnersAsync">
                            <option value="0">— wybierz —</option>
                            @foreach (var c in _allClients)
                            {
                                <option value="@c.Id">@c.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Rodzaj sesji</label>
                        <select class="form-select form-select-sm" @bind="_bookingSessionTypeId"
                                @bind:after="OnBookingTypeChanged">
                            @foreach (var t in _sessionTypes)
                            {
                                <option value="@t.Id">@t.Name (@t.DurationMinutes min)@(t.IsPair ? " · w parze" : "")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-check small mb-1">
                            <input class="form-check-input" type="checkbox" @bind="_bookingWithPartner" @bind:after="LoadBookingPartnersAsync" />
                            <span class="form-check-label fw-semibold">Trening w parze</span>
                            <InfoTip Title="Trening w parze">
                                Obie osoby dostają własną wizytę, potwierdzenie i przypomnienie. Ze wspólnego pakietu „Duet”
                                schodzi 1 za trening, bez niego — po 1 z pakietu każdej osoby. Gdy jedna odwoła, druga trenuje sama.
                            </InfoTip>
                        </label>
                        @if (_bookingWithPartner)
                        {
                            <select class="form-select form-select-sm" @bind="_bookingPartnerId">
                                <option value="0">— z kim? —</option>
                                @if (_bookingPartners.Count > 0)
                                {
                                    <optgroup label="Para">
                                        @foreach (var p in _bookingPartners)
                                        {
                                            <option value="@p.ClientId">@p.Name</option>
                                        }
                                    </optgroup>
                                }
                                <optgroup label="Wszyscy podopieczni">
                                    @foreach (var c in _allClients.Where(c => c.Id != _bookingClientId && _bookingPartners.All(p => p.ClientId != c.Id)))
                                    {
                                        <option value="@c.Id">@c.FullName</option>
                                    }
                                </optgroup>
                            </select>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Termin</label>
                        <div class="slot-day-nav">
                            <button class="slot-nav-btn" @onclick="BookingPrevDay"
                                    disabled="@(_bookingSlotDate <= DateOnly.FromDateTime(StudioClock.Today))">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <div class="slot-nav-center">
                                <div class="slot-nav-weekday">@_bookingSlotDate.ToString("dddd", new CultureInfo("pl-PL"))</div>
                                <div class="slot-nav-full">@_bookingSlotDate.ToString("d MMMM yyyy", new CultureInfo("pl-PL"))</div>
                            </div>
                            <button class="slot-nav-btn" @onclick="BookingNextDay">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>

                        @if (_loadingBookingSlots)
                        {
                            <div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else if (_bookingAvailableSlots.Count > 0)
                        {
                            <div class="slot-tile-grid">
                                @foreach (var slot in _bookingAvailableSlots)
                                {
                                    var sel = _bookingDateTime != default && slot.Start == _bookingDateTime;
                                    <button type="button" class="slot-tile @(sel ? "slot-tile-active" : "")"
                                            @onclick="() => { _bookingDateTime = slot.Start; _bookingOverlap = false; }">
                                        <div class="slot-tile-time">@slot.Start.ToString("HH:mm")</div>
                                        <div class="slot-tile-end">— @slot.End.ToString("HH:mm")</div>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="slot-empty">
                                <i class="bi bi-calendar-x"></i>
                                Brak wolnych terminów w tym dniu
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold mb-1">Notatki (opcjonalne)</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_bookingNotes"
                                  placeholder="Uwagi do sesji..."></textarea>
                    </div>

                    @if (_bookingOverlap)
                    {
                        <div class="alert alert-warning py-2 small">
                            Ten termin nachodzi na inną sesję. Możesz nałożyć terminy mimo to.
                        </div>
                    }
                    <div class="d-grid gap-2">
                        @if (_bookingOverlap)
                        {
                            <button class="btn btn-warning btn-sm" @onclick="() => ConfirmBooking(true)"
                                    disabled="@(_bookingBusy || _bookingClientId == 0 || _bookingDateTime == default || (_bookingWithPartner && _bookingPartnerId == 0))">
                                @if (_bookingBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                <i class="bi bi-exclamation-triangle me-1"></i>Nałóż mimo to
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => ConfirmBooking(false)"
                                    disabled="@(_bookingBusy || _bookingClientId == 0 || _bookingDateTime == default || (_bookingWithPartner && _bookingPartnerId == 0))">
                                @if (_bookingBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                <i class="bi bi-check-circle me-1"></i>Utwórz sesję
                            </button>
                        }
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CloseBookingPanel">Anuluj</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ElementReference _calendarEl;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Calendar>? _ref;

    // Session detail panel
    private bool _panelOpen;
    private bool _busy;
    private string _panelError = string.Empty;
    private SessionDto? _selectedSession;
    private bool _showCancelForm;
    private bool _confirmNoShow;
    private string _cancelReason = string.Empty;
    private bool _showRescheduleForm;
    private DateTime _rescheduleDateTime;
    private bool _rescheduleOverlap;   // kolizja terminu wykryta — czeka na potwierdzenie nałożenia
    private bool _showRestoreConfirm;

    // Trening w parze
    private int _cancelScope;            // 0 = oboje, inaczej Id wizyty do odwołania
    private bool _bookingWithPartner;
    private int _bookingPartnerId;
    private List<PartnerDto> _bookingPartners = [];
    private bool PairActive => _selectedSession is { IsPair: true, PartnerActive: true }
                               && _selectedSession.Status is SessionStatus.Scheduled or SessionStatus.AwaitingPackage;

    // Booking panel (trainer books for client)
    private bool _bookingOpen;
    private bool _bookingBusy;
    private string _bookingError = string.Empty;
    private bool _bookingOverlap;   // kolizja terminu wykryta — czeka na potwierdzenie nałożenia
    private DateTime _bookingDateTime;
    private int _bookingClientId;
    private int _bookingSessionTypeId;
    private string _bookingNotes = string.Empty;
    private List<ClientSummaryDto> _allClients = [];
    private List<SessionTypeDto> _sessionTypes = [];

    // Slot picker for booking panel
    private DateOnly _bookingSlotDate;
    private List<AvailableSlotDto> _bookingAvailableSlots = [];
    private bool _loadingBookingSlots;

    private string _userId = string.Empty;
    private string _userEmail = string.Empty;
    private string _userRole = string.Empty;
    private int? _clientNumericId;
    private string? _clientTrainerUserId;
    private TrainerConfigDto _trainerCfg = new();
    private bool _chargeLate;
    private bool _isAdminRole;
    private bool _isTrainerRole;
    private bool _isClientRole;
    private bool _canEdit;

    private HashSet<string> _activeStatuses = new(StringComparer.OrdinalIgnoreCase);
    private bool IsAllActive => _activeStatuses.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId    = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _userEmail = auth.User.Identity?.Name ?? _userId;
        _isAdminRole   = auth.User.IsInRole(Roles.Admin);
        _isTrainerRole = auth.User.IsInRole(Roles.Trainer) || auth.User.IsInRole(Roles.Subordinate);
        _isClientRole  = auth.User.IsInRole(Roles.Client);
        _canEdit = _isAdminRole || _isTrainerRole;
        _userRole = _isAdminRole ? Roles.Admin
                  : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer
                  : auth.User.IsInRole(Roles.Subordinate) ? Roles.Subordinate
                  : _isClientRole ? Roles.Client : string.Empty;

        if (_isClientRole)
        {
            var client = await ClientService.GetClientByUserIdAsync(_userId);
            _clientNumericId = client?.Id;
            _clientTrainerUserId = client?.TrainerUserId;
            if (!string.IsNullOrEmpty(_clientTrainerUserId))
            {
                try
                {
                    var cfg = await TrainerConfigService.GetAsync(_clientTrainerUserId);
                    _trainerCfg = cfg;
                }
                catch { /* best-effort — use default cancellation window */ }
            }
        }

        if (_canEdit)
        {
            var calTrainerFilter = _isAdminRole ? null : _userId;
            _allClients  = await SessionService.GetClientsAsync(calTrainerFilter);
            _sessionTypes = await SessionService.GetSessionTypesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref    = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/calendar-interop.js");
        await _module.InvokeVoidAsync("initCalendar", _ref, _calendarEl, _canEdit);
    }

    [JSInvokable]
    public async Task<object[]> GetEvents(string start, string end)
    {
        try
        {
            var from = DateTime.Parse(start);
            var to   = DateTime.Parse(end);

            string? trainerFilter = _isTrainerRole ? _userId : null;
            int?    clientFilter  = _isClientRole  ? _clientNumericId : null;

            var sessions = await SessionService.GetSessionsAsync(from, to, trainerFilter, clientFilter);

            // Trening w parze to dwie wizyty — trener widzi go raz („Ola + Piotr”).
            if (!_isClientRole)
                sessions = sessions.Where(s => !s.IsPairFollower).ToList();

            if (_activeStatuses.Count > 0)
                sessions = sessions.Where(s => _activeStatuses.Contains(s.Status.ToString())).ToList();

            var events = sessions.Select(s => (object)new
            {
                id    = s.Id.ToString(),
                title = _isClientRole ? s.ClientName : s.DisplayName,
                start = s.StartTime.ToString("o"),
                end   = s.EndTime.ToString("o"),
                extendedProps = new
                {
                    status      = s.Status.ToString(),
                    clientName  = _isClientRole ? s.ClientName : s.DisplayName,
                    sessionType = s.SessionTypeName + (s.IsPair && s.PartnerActive ? " · w parze" : ""),
                    trainerName = s.TrainerName,
                    initials    = s.IsPair && s.PartnerActive && !_isClientRole ? PairInitials(s) : Initials(s.ClientName),
                    duration    = s.DurationMinutes
                }
            }).ToList();

            // Zajęte terminy z Google Calendar jako tło — widać, czemu godzina nie jest do rezerwacji.
            if (!_isClientRole)
            {
                var busy = await GoogleCalendar.GetBusyBlocksAsync(_userId, from, to);
                events.AddRange(busy.Select((b, i) => (object)new
                {
                    id        = $"busy-{i}",
                    start     = b.IsAllDay ? b.StartTime.ToString("yyyy-MM-dd") : b.StartTime.ToString("o"),
                    end       = b.IsAllDay ? b.EndTime.ToString("yyyy-MM-dd") : b.EndTime.ToString("o"),
                    allDay    = b.IsAllDay,
                    display   = "background",
                    classNames = new[] { "cal-busy-bg" },
                    extendedProps = new { busy = true }
                }));
            }
            return events.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "GetEvents failed");
            return [];
        }
    }

    [JSInvokable]
    public async Task OnEventClick(int sessionId)
    {
        _bookingOpen        = false;
        _selectedSession    = await SessionService.GetSessionAsync(sessionId);
        if (_selectedSession is not null && !_isClientRole)
        {
            try { _trainerCfg = await TrainerConfigService.GetAsync(_selectedSession.TrainerUserId); }
            catch { /* domyślna polityka */ }
        }
        _showCancelForm     = false;
        _showRescheduleForm = false;
        _showRestoreConfirm = false;
        _confirmNoShow      = false;
        _cancelScope        = 0;
        _cancelReason       = string.Empty;
        _panelError         = string.Empty;
        _rescheduleOverlap  = false;
        _panelOpen          = true;
        if (_selectedSession is not null)
        {
            _rescheduleDateTime = _selectedSession.StartTime;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnDateClick(string dateStr)
    {
        if (!_canEdit) return;
        _panelOpen      = false;
        _bookingError   = string.Empty;
        _bookingNotes   = string.Empty;
        _bookingClientId = 0;
        _bookingSessionTypeId = _sessionTypes.FirstOrDefault()?.Id ?? 0;
        _bookingDateTime = default;
        _bookingOverlap  = false;
        _bookingWithPartner = _sessionTypes.FirstOrDefault()?.IsPair == true;
        _bookingPartnerId = 0;
        _bookingPartners = [];
        var dt = DateTime.TryParse(dateStr, out var parsed) ? parsed : StudioClock.Now;
        _bookingSlotDate = DateOnly.FromDateTime(dt);
        _bookingOpen    = true;
        await InvokeAsync(StateHasChanged);
        await LoadBookingSlotsAsync();
    }

    private void ClosePanel()
    {
        _panelOpen          = false;
        _selectedSession    = null;
        _showCancelForm     = false;
        _showRescheduleForm = false;
        _showRestoreConfirm = false;
        _panelError         = string.Empty;
    }

    private void CloseBookingPanel()
    {
        _bookingOpen  = false;
        _bookingError = string.Empty;
        _bookingAvailableSlots = [];
        _bookingSlotDate = default;
        _bookingDateTime = default;
    }

    private async Task LoadBookingSlotsAsync()
    {
        var sessionType = _sessionTypes.FirstOrDefault(t => t.Id == _bookingSessionTypeId);
        if (sessionType is null || _bookingSlotDate == default) return;

        _loadingBookingSlots = true;
        _bookingDateTime = default;
        StateHasChanged();
        try
        {
            var slots = await AvailabilityService.GetAvailableSlotsAsync(
                _userId, _bookingSlotDate, sessionType.DurationMinutes);
            _bookingAvailableSlots = slots
                .Where(s => s.IsAvailable && s.Start > StudioClock.Now)
                .ToList();
        }
        catch
        {
            _bookingAvailableSlots = [];
        }
        finally
        {
            _loadingBookingSlots = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task BookingPrevDay()
    {
        _bookingSlotDate = _bookingSlotDate.AddDays(-1);
        await LoadBookingSlotsAsync();
    }

    private async Task BookingNextDay()
    {
        _bookingSlotDate = _bookingSlotDate.AddDays(1);
        await LoadBookingSlotsAsync();
    }

    private async Task ToggleFilter(string status)
    {
        if (status == "All")
            _activeStatuses.Clear();
        else if (!_activeStatuses.Remove(status))
            _activeStatuses.Add(status);

        if (_module is not null)
            await _module.InvokeVoidAsync("refetchEvents");
    }

    private async Task OnBookingTypeChanged()
    {
        if (_sessionTypes.FirstOrDefault(t => t.Id == _bookingSessionTypeId)?.IsPair == true && !_bookingWithPartner)
        {
            _bookingWithPartner = true;
            await LoadBookingPartnersAsync();
        }
        await LoadBookingSlotsAsync();
    }

    // Partner podpowiadany z par; gdy para jest jedna — wybrany od razu.
    private async Task LoadBookingPartnersAsync()
    {
        _bookingPartners = _bookingClientId > 0 ? await PairService.GetPartnersAsync(_bookingClientId) : [];
        if (_bookingPartnerId == _bookingClientId) _bookingPartnerId = 0;
        if (_bookingPartnerId == 0 && _bookingPartners.Count == 1) _bookingPartnerId = _bookingPartners[0].ClientId;
    }

    private static string PackageHint(SessionDto s) =>
        s.PackageShared
            ? "Wspólny pakiet pary: za ten trening schodzi 1."
            : "Każda osoba korzysta z własnego pakietu.";

    private static string PairInitials(SessionDto s) =>
        $"{s.ClientName.FirstOrDefault()}{s.PartnerName?.FirstOrDefault()}".ToUpper();

    private async Task RestorePartner(int partnerSessionId)
    {
        _busy = true; _panelError = string.Empty;
        try
        {
            await SessionService.RestoreAsync(partnerSessionId);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionRestored", "Session",
                partnerSessionId.ToString(), $"Klient: {_selectedSession?.PartnerName} (trening w parze)");
            if (_selectedSession is not null) await OnEventClick(_selectedSession.Id);
            if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
        }
        catch (Exception ex) { _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnOffPackageChanged()
    {
        if (_selectedSession is null) return;
        _selectedSession = await SessionService.GetSessionAsync(_selectedSession.Id);
        if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
    }

    private async Task ChangeStatus(SessionStatus status, bool includePartner = false, int? targetId = null)
    {
        if (_selectedSession is null) return;
        _busy = true; _panelError = string.Empty;
        try
        {
            await SessionService.UpdateStatusAsync(targetId ?? _selectedSession.Id, status, includePartner: includePartner);
            var action = status == SessionStatus.Completed ? "SessionCompleted" : "SessionNoShow";
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, action, "Session",
                _selectedSession.Id.ToString(),
                $"Klient: {_selectedSession.ClientName}, termin: {_selectedSession.StartTime:dd.MM.yyyy HH:mm}");
            ClosePanel();
            if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
        }
        catch (Exception ex) { _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private void ShowCancelForm()
    {
        _showCancelForm = true; _showRescheduleForm = false;
        // Podpowiedź dla trenera: w oknie późnego odwołania przy polityce „sesja przepada”.
        _chargeLate = !_isClientRole && _selectedSession is not null
            && _trainerCfg.LateCancellationPolicy == LateCancellationPolicy.ChargeSession
            && CancellationRules.ForClient(_trainerCfg, _selectedSession.StartTime, Clock.LocalNow).IsLate;
    }
    private void ShowRescheduleForm() { _showRescheduleForm = true; _showCancelForm = false; }

    private async Task ConfirmCancel()
    {
        if (_selectedSession is null) return;
        _busy = true; _panelError = string.Empty;
        try
        {
            var details = $"Klient: {_selectedSession.ClientName}, termin: {_selectedSession.StartTime:dd.MM.yyyy HH:mm}" +
                          (string.IsNullOrEmpty(_cancelReason) ? "" : $", powód: {_cancelReason}");
            if (_isClientRole)
            {
                await SessionService.ClientCancelSessionAsync(_selectedSession.Id, _userId, _cancelReason);
                await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionCancelledByClient", "Session",
                    _selectedSession.Id.ToString(), details);
            }
            else
            {
                // Trening w parze: domyślnie odwołujemy oboje; można odwołać jedną osobę.
                var pair = PairActive;
                var target = pair && _cancelScope != 0 ? _cancelScope : _selectedSession.Id;
                await SessionService.UpdateStatusAsync(target, SessionStatus.Cancelled, _cancelReason, chargeSession: _chargeLate,
                    includePartner: pair && _cancelScope == 0);
                await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionCancelled", "Session",
                    _selectedSession.Id.ToString(), details);
            }
            ClosePanel();
            if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
        }
        catch (Exception ex) { _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmReschedule(bool allowOverlap = false)
    {
        if (_selectedSession is null) return;
        _busy = true; _panelError = string.Empty;
        try
        {
            var oldTime = _selectedSession.StartTime;
            await SessionService.RescheduleAsync(_selectedSession.Id, _rescheduleDateTime, allowOverlap);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionRescheduled", "Session",
                _selectedSession.Id.ToString(),
                $"Klient: {_selectedSession.ClientName}, stary: {oldTime:dd.MM.yyyy HH:mm}, nowy: {_rescheduleDateTime:dd.MM.yyyy HH:mm}{(allowOverlap ? " (nałożono)" : "")}");
            _rescheduleOverlap = false;
            ClosePanel();
            if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
        }
        catch (SlotConflictException ex) { _rescheduleOverlap = true; _panelError = ex.Message; }
        catch (Exception ex) { _rescheduleOverlap = false; _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmRestore()
    {
        if (_selectedSession is null) return;
        _busy = true; _panelError = string.Empty;
        try
        {
            await SessionService.RestoreAsync(_selectedSession.Id);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionRestored", "Session",
                _selectedSession.Id.ToString(),
                $"Klient: {_selectedSession.ClientName}, termin: {_selectedSession.StartTime:dd.MM.yyyy HH:mm}");
            ClosePanel();
            if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
        }
        catch (Exception ex) { _panelError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmBooking(bool allowOverlap = false)
    {
        if (_bookingClientId == 0 || _bookingSessionTypeId == 0) return;
        _bookingBusy = true; _bookingError = string.Empty;
        try
        {
            var dto = new CreateSessionDto
            {
                ClientId      = _bookingClientId,
                TrainerUserId = _userId,
                SessionTypeId = _bookingSessionTypeId,
                StartTime     = _bookingDateTime,
                Notes         = string.IsNullOrWhiteSpace(_bookingNotes) ? null : _bookingNotes.Trim()
            };
            var created = _bookingWithPartner && _bookingPartnerId > 0
                ? await SessionService.CreatePairSessionAsync(dto, _bookingPartnerId, allowOverlap: allowOverlap)
                : await SessionService.CreateSessionAsync(dto, allowOverlap: allowOverlap);
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "SessionBooked", "Session",
                created.Id.ToString(), $"Klient: {created.DisplayName}, termin: {_bookingDateTime:dd.MM.yyyy HH:mm}{(allowOverlap ? " (nałożono)" : "")}");
            _bookingOverlap = false;
            CloseBookingPanel();
            if (_module is not null) await _module.InvokeVoidAsync("refetchEvents");
        }
        catch (SlotConflictException ex) { _bookingOverlap = true; _bookingError = ex.Message; }
        catch (Exception ex) { _bookingOverlap = false; _bookingError = ex.Message; }
        finally { _bookingBusy = false; }
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();

    private static string StatusBadge(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled       => "bg-primary",
        SessionStatus.Completed       => "bg-success",
        SessionStatus.Cancelled       => "bg-danger",
        SessionStatus.NoShow          => "bg-warning text-dark",
        SessionStatus.AwaitingPackage => "bg-orange text-white",
        _                             => "bg-secondary"
    };

    private static string StatusLabel(SessionStatus s) => s switch
    {
        SessionStatus.Scheduled       => "Zaplanowana",
        SessionStatus.Completed       => "Ukończona",
        SessionStatus.Cancelled       => "Anulowana",
        SessionStatus.NoShow          => "Nieobecność",
        SessionStatus.AwaitingPackage => "Oczekuje na pakiet",
        _                             => s.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("destroyCalendar");
            await _module.DisposeAsync();
        }
        _ref?.Dispose();
    }
}

