@page "/packages"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IPackageOfferService OfferService
@inject IPaymentService PaymentService
@inject IPaymentSettingsService PaymentSettings
@inject ICouponService CouponSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Sklep pakietów" />

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h4 class="page-title mb-0"><i class="bi bi-box-seam-fill me-2" style="color:var(--c-primary)"></i>Pakiety treningowe</h4>
    <a href="/my/packages" class="btn btn-sm btn-outline-primary"><i class="bi bi-box-seam me-1"></i>Moje pakiety</a>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_offers.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-box-seam" style="font-size:2.4rem"></i>
        <p class="mt-2 mb-0">Brak dostępnych pakietów.</p>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_err)) { <div class="alert alert-danger">@_err</div> }

    @if (_featured.Any())
    {
        <div class="row g-3 mb-4">
            @foreach (var o in _featured)
            {
                <div class="col-12 col-md-6">
                    <div class="card border-primary h-100 position-relative overflow-hidden">
                        <div class="pkg-featured-badge"><i class="bi bi-star-fill me-1"></i>Polecany</div>
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title fw-bold">@o.Name</h4>
                            <div class="text-muted small mb-2"><i class="bi bi-clock me-1"></i>@o.SessionTypeName · @o.DurationMinutes min · @o.SessionsCount sesji</div>
                            @if (!string.IsNullOrEmpty(o.Description)) { <p class="text-muted flex-grow-1">@o.Description</p> } else { <div class="flex-grow-1"></div> }
                            @if (o.ValidDays.HasValue) { <div class="text-muted small mb-2"><i class="bi bi-calendar-range me-1"></i>Ważność: @o.ValidDays dni od zakupu</div> }

                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <div>
                                    <span class="fw-bold fs-4" style="color:var(--c-primary)">@o.Price.ToString("0.00") @_currency</span>
                                    @if (o.SessionsCount > 0)
                                    {
                                        <div class="text-muted small">@((o.Price / o.SessionsCount).ToString("0.00")) @_currency / sesja</div>
                                    }
                                </div>
                                @if (_isStaff)
                                {
                                    <a href="/admin/package-offers" class="btn btn-outline-secondary btn-sm"><i class="bi bi-gear me-1"></i>Zarządzaj</a>
                                }
                                else if (_paymentsEnabled)
                                {
                                    <button class="btn btn-primary btn-lg" @onclick="() => Buy(o)" disabled="@(_buyingId == o.Id)">
                                        @if (_buyingId == o.Id) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                        <i class="bi bi-bag-check me-1"></i>Kup pakiet
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Niedostępny online</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (_regular.Any())
    {
        <div class="row g-3">
            @foreach (var o in _regular)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@o.Name</h5>
                            <div class="text-muted small mb-2"><i class="bi bi-clock me-1"></i>@o.SessionTypeName · @o.DurationMinutes min · @o.SessionsCount sesji</div>
                            @if (!string.IsNullOrEmpty(o.Description)) { <p class="text-muted small flex-grow-1">@o.Description</p> } else { <div class="flex-grow-1"></div> }
                            @if (o.ValidDays.HasValue) { <div class="text-muted small mb-2"><i class="bi bi-calendar-range me-1"></i>Ważność: @o.ValidDays dni</div> }

                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <div>
                                    <span class="fw-bold fs-5" style="color:var(--c-primary)">@o.Price.ToString("0.00") @_currency</span>
                                    @if (o.SessionsCount > 0)
                                    {
                                        <div class="text-muted small">@((o.Price / o.SessionsCount).ToString("0.00")) @_currency / sesja</div>
                                    }
                                </div>
                                @if (_isStaff)
                                {
                                    <a href="/admin/package-offers" class="btn btn-outline-secondary btn-sm"><i class="bi bi-gear me-1"></i>Zarządzaj</a>
                                }
                                else if (_paymentsEnabled)
                                {
                                    <button class="btn btn-primary" @onclick="() => Buy(o)" disabled="@(_buyingId == o.Id)">
                                        @if (_buyingId == o.Id) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                        <i class="bi bi-bag-check me-1"></i>Kup
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Niedostępny</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@if (_pickFor is not null)
{
    <div class="modal-backdrop-custom" @onclick="ClosePicker">
        <div class="pay-picker" @onclick:stopPropagation="true">
            <div class="pay-picker-head">
                <span class="fw-semibold">Wybierz metodę płatności</span>
                <button class="btn-close" @onclick="ClosePicker"></button>
            </div>
            <div class="pay-picker-sub">
                @_pickFor.Name —
                @if (_couponFinal.HasValue)
                {
                    <span class="text-muted text-decoration-line-through">@_pickFor.Price.ToString("0.00")</span>
                    <strong class="text-success ms-1">@_couponFinal.Value.ToString("0.00") @_currency</strong>
                    <div class="small text-success">Rabat: -@((_pickFor.Price - _couponFinal.Value).ToString("0.00")) @_currency</div>
                }
                else
                {
                    <strong>@_pickFor.Price.ToString("0.00") @_currency</strong>
                }
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Kod rabatowy</label>
                <div class="input-group input-group-sm">
                    <input class="form-control font-monospace" placeholder="np. LATO20"
                           @bind="_couponCode" @bind:event="oninput" />
                    <button class="btn btn-outline-primary" @onclick="ApplyCoupon" disabled="@(_couponBusy || string.IsNullOrWhiteSpace(_couponCode))">
                        @if (_couponBusy) { <span class="spinner-border spinner-border-sm"></span> } else { <span>Zastosuj</span> }
                    </button>
                    @if (!string.IsNullOrEmpty(_appliedCoupon))
                    {
                        <button class="btn btn-outline-secondary" @onclick="ClearCoupon"><i class="bi bi-x"></i></button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_couponMsg))
                {
                    <div class="small mt-1 @(_couponError ? "text-danger" : "text-success")">
                        <i class="bi @(_couponError ? "bi-exclamation-circle" : "bi-check-circle") me-1"></i>@_couponMsg
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_err)) { <div class="alert alert-danger py-2 mb-2">@_err</div> }
            <div class="d-grid gap-2">
                @foreach (var opt in _options)
                {
                    <button class="pay-option" @onclick="() => StartCheckout(_pickFor, opt.Key)" disabled="@_busy">
                        <i class="bi @opt.Icon"></i><span>@opt.Name</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _paymentsEnabled;
    private bool _isStaff;
    private bool _busy;
    private string _currency = "PLN";
    private string _userId = string.Empty;
    private string _email = string.Empty;
    private int? _buyingId;
    private string _err = string.Empty;

    private List<PackageOfferDto> _offers = [];
    private List<PackageOfferDto> _featured = [];
    private List<PackageOfferDto> _regular = [];
    private List<PaymentOptionDto> _options = [];
    private PackageOfferDto? _pickFor;

    // Coupon state (per-picker instance)
    private string _couponCode = string.Empty;
    private string? _appliedCoupon;
    private decimal? _couponFinal;
    private bool _couponBusy;
    private bool _couponError;
    private string? _couponMsg;

    private async Task ApplyCoupon()
    {
        if (_pickFor is null || string.IsNullOrWhiteSpace(_couponCode)) return;
        _couponBusy = true; _couponMsg = null;
        var res = await CouponSvc.ValidateAsync(_couponCode.Trim(), _pickFor.Price, "package");
        if (res.IsValid)
        {
            _appliedCoupon = res.Code;
            _couponFinal = res.FinalAmount;
            _couponError = false;
            _couponMsg = $"Kod zastosowany: -{res.DiscountAmount:0.00} {_currency}";
        }
        else
        {
            _appliedCoupon = null;
            _couponFinal = null;
            _couponError = true;
            _couponMsg = res.Error;
        }
        _couponBusy = false;
    }

    private void ClearCoupon()
    {
        _couponCode = string.Empty;
        _appliedCoupon = null;
        _couponFinal = null;
        _couponMsg = null;
        _couponError = false;
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                 ?? auth.User.Identity?.Name ?? string.Empty;
        _isStaff = auth.User.IsInRole("Admin") || auth.User.IsInRole("Trainer") || auth.User.IsInRole("Subordinate");

        var settings = await PaymentSettings.GetAsync();
        _currency = settings.Currency;
        _options = await PaymentService.GetEnabledOptionsAsync();
        _paymentsEnabled = _options.Count > 0;

        _offers = await OfferService.GetActiveOffersAsync();
        _featured = _offers.Where(o => o.IsFeatured).ToList();
        _regular = _offers.Where(o => !o.IsFeatured).ToList();
        _loading = false;
    }

    private void Buy(PackageOfferDto o)
    {
        _err = string.Empty;
        _buyingId = o.Id;
        ClearCoupon();
        _pickFor = o;
        _buyingId = null;
    }

    private async Task StartCheckout(PackageOfferDto o, string providerKey)
    {
        _busy = true; _err = string.Empty;
        var res = await PaymentService.StartPackageCheckoutAsync(_userId, o.Id, providerKey, Nav.BaseUri, _email, string.Empty, _appliedCoupon);
        if (res.Ok && res.RedirectUrl is not null) { Nav.NavigateTo(res.RedirectUrl, forceLoad: true); return; }
        _err = res.Error ?? "Nie udało się rozpocząć płatności.";
        _busy = false;
        _buyingId = null;
    }

    private void ClosePicker() { _pickFor = null; _err = string.Empty; ClearCoupon(); }
}

<style>
    .pkg-featured-badge {
        position: absolute; top: 12px; right: -30px;
        background: var(--c-primary, #5c6bc0); color: #fff;
        font-size: .7rem; font-weight: 700; padding: .25rem 2.5rem;
        transform: rotate(45deg); z-index: 1;
    }
    .modal-backdrop-custom {
        position: fixed; inset: 0; background: rgba(0,0,0,.45);
        display: flex; align-items: center; justify-content: center;
        z-index: 1080; padding: 1rem; backdrop-filter: blur(2px);
    }
    .pay-picker {
        width: 100%; max-width: 380px; background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color); border-radius: 1rem;
        padding: 1.25rem; box-shadow: 0 20px 50px -20px rgba(0,0,0,.55);
    }
    .pay-picker-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:.25rem; }
    .pay-picker-sub { color: var(--bs-secondary-color); font-size:.9rem; margin-bottom:1rem; }
    .pay-option {
        display:flex; align-items:center; gap:.7rem; width:100%;
        padding:.75rem .9rem; border:1px solid var(--bs-border-color);
        border-radius:.7rem; background:var(--bs-body-bg); color:var(--bs-body-color);
        font-weight:600; transition:border-color .15s, transform .15s;
    }
    .pay-option:hover:not(:disabled) { border-color: var(--c-primary); transform: translateY(-1px); }
    .pay-option i:first-child { color: var(--c-primary); font-size:1.15rem; }
</style>
