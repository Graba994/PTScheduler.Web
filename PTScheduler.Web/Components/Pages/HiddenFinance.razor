@page "/finance/hidden"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@using PTScheduler.Domain.Constants
@inject ISessionPackageService PackageService
@inject IFinanceService FinanceService
@inject IPermissionService PermissionService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")]

@if (!_authorized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:60vh">
        <div class="card" style="max-width:360px;width:100%">
            <div class="card-body text-center p-4">
                <i class="bi bi-shield-lock-fill d-block mb-3" style="font-size:2.5rem;color:var(--c-primary)"></i>

                @if (!_hasPermission)
                {
                    <h5>Brak dostępu</h5>
                    <p class="text-muted small mb-3">Nie masz uprawnień do ukrytego modułu finansów.</p>
                    <a href="/finance" class="btn btn-primary btn-sm">Wróć do finansów</a>
                }
                else if (!_pinSet)
                {
                    <h5>Ustaw PIN</h5>
                    <p class="text-muted small mb-3">Aby korzystać z ukrytych finansów, ustaw PIN zabezpieczający.</p>
                    <div class="mb-3">
                        <input type="password" class="form-control text-center" maxlength="8" placeholder="Nowy PIN (4-8 cyfr)"
                               @bind="_newPin" @bind:event="oninput" inputmode="numeric" style="letter-spacing:.5em;font-size:1.25rem" />
                    </div>
                    <div class="mb-3">
                        <input type="password" class="form-control text-center" maxlength="8" placeholder="Powtórz PIN"
                               @bind="_confirmPin" @bind:event="oninput" inputmode="numeric" style="letter-spacing:.5em;font-size:1.25rem" />
                    </div>
                    @if (!string.IsNullOrEmpty(_pinError))
                    {
                        <div class="text-danger small mb-2">@_pinError</div>
                    }
                    <button class="btn btn-primary" @onclick="SetPinAsync" disabled="@_settingPin">
                        @if (_settingPin) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Ustaw PIN
                    </button>
                }
                else
                {
                    <h5>Wprowadź PIN</h5>
                    <p class="text-muted small mb-3">Podaj PIN, aby uzyskać dostęp do ukrytych finansów.</p>
                    <div class="mb-3">
                        <input type="password" class="form-control text-center" maxlength="8" placeholder="PIN"
                               @bind="_enteredPin" @bind:event="oninput" @onkeydown="PinKeyDown"
                               inputmode="numeric" style="letter-spacing:.5em;font-size:1.25rem" />
                    </div>
                    @if (!string.IsNullOrEmpty(_pinError))
                    {
                        <div class="text-danger small mb-2">@_pinError</div>
                    }
                    <button class="btn btn-primary" @onclick="VerifyPinAsync" disabled="@_verifyingPin">
                        @if (_verifyingPin) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Odblokuj
                    </button>
                    <div class="mt-2">
                        <a href="/finance" class="text-muted small text-decoration-none">Wróć do finansów</a>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <h4 class="page-title"><i class="bi bi-eye-slash-fill me-2" style="color:var(--c-primary)"></i>Ukryte finanse</h4>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <a href="/finance" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Finanse
            </a>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn @(_viewMode == "hidden" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ChangeView("hidden")'>Ukryte</button>
                <button type="button" class="btn @(_viewMode == "all" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => ChangeView("all")'>Wszystkie</button>
            </div>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn @(_months == 6 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(6)">6M</button>
                <button type="button" class="btn @(_months == 12 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(12)">12M</button>
                <button type="button" class="btn @(_months == 24 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(24)">2 lata</button>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="stat-value">@_displayPackages.Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Łączna wartość</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_displayPackages.Where(p => p.IsPaid).Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Opłacone</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-red"><i class="bi bi-exclamation-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_displayPackages.Where(p => !p.IsPaid && p.Status != PackageStatus.Cancelled).Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Nieopłacone</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-blue"><i class="bi bi-box-seam-fill"></i></div>
                <div>
                    <div class="stat-value">@_displayPackages.Count(p => p.Status == PackageStatus.Active)</div>
                    <div class="stat-label">Aktywnych pakietów</div>
                </div>
            </div>
        </div>
    </div>

    @if (_taxConfig is not null && HasAnyTaxOption(_taxConfig))
    {
        var t = ComputeTax(_displayPackages, _taxConfig, _months);
        <div class="card mb-3">
            <div class="card-header py-2 d-flex align-items-center justify-content-between">
                <span class="fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-calculator me-2" style="color:var(--c-primary)"></i>Podsumowanie podatkowe
                    @if (_viewMode == "all")
                    {
                        <span class="badge bg-info text-dark ms-1">Wszystkie</span>
                    }
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showTaxSettings = !_showTaxSettings">
                    <i class="bi bi-gear me-1"></i>Ustawienia
                </button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="text-muted small">Przychód brutto</div>
                        <div class="fw-semibold">@t.Gross.ToString("N2") zł</div>
                    </div>
                    @if (_taxConfig.VatEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">VAT (@_taxConfig.VatRate%)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Vat.ToString("N2") zł</div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">Netto (bez VAT)</div>
                            <div class="fw-semibold">@t.Net.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.IncomeTaxType != "none")
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">@t.TaxLabel</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.IncomeTax.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.ZusEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">ZUS (@_months mies.)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Zus.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.HealthInsuranceEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">Zdrowotne (@_months mies.)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Health.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.CostDeductionsEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">Koszty stałe (@_months mies.)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Costs.ToString("N2") zł</div>
                        </div>
                    }
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="text-muted small fw-bold">Zysk netto</div>
                        <div class="fw-bold fs-5" style="color:@(t.Profit >= 0 ? "var(--c-success)" : "var(--c-danger)")">@t.Profit.ToString("N2") zł</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showTaxSettings && _taxConfig is not null)
    {
        <div class="card mb-3 border-primary">
            <div class="card-header py-2 d-flex align-items-center justify-content-between bg-primary bg-opacity-10">
                <span class="fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-sliders me-2"></i>Ustawienia podatkowe — moduł ukryty
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showTaxSettings = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12"><h6 class="mb-0"><i class="bi bi-receipt me-2"></i>VAT</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="h-vat-enabled" @bind="_taxConfig.VatEnabled" />
                            <label class="form-check-label" for="h-vat-enabled">VAT naliczany</label>
                        </div>
                    </div>
                    @if (_taxConfig.VatEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Stawka VAT (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.VatRate" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-bank me-2"></i>Podatek dochodowy (PIT)</h6></div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small">Forma opodatkowania</label>
                        <select class="form-select form-select-sm" @bind="_taxConfig.IncomeTaxType">
                            <option value="none">Brak</option>
                            <option value="scale">Skala podatkowa</option>
                            <option value="flat">Podatek liniowy</option>
                            <option value="lump">Ryczałt</option>
                        </select>
                    </div>
                    @if (_taxConfig.IncomeTaxType == "flat")
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Stawka liniowa (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.FlatTaxRate" />
                        </div>
                    }
                    @if (_taxConfig.IncomeTaxType == "lump")
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Stawka ryczałtu (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.LumpSumRate" />
                        </div>
                    }
                    @if (_taxConfig.IncomeTaxType == "scale")
                    {
                        <div class="col-6 col-md-4">
                            <label class="form-label small">Próg (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="1" @bind="_taxConfig.ScaleTaxThreshold" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small">Stawka do progu (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.ScaleTaxRateLow" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small">Stawka powyżej (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.ScaleTaxRateHigh" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-shield-check me-2"></i>ZUS</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="h-zus-enabled" @bind="_taxConfig.ZusEnabled" />
                            <label class="form-check-label" for="h-zus-enabled">Składki ZUS</label>
                        </div>
                    </div>
                    @if (_taxConfig.ZusEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Miesięczna składka ZUS (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.ZusMonthlyAmount" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-heart-pulse me-2"></i>Ubezpieczenie zdrowotne</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="h-health-enabled" @bind="_taxConfig.HealthInsuranceEnabled" />
                            <label class="form-check-label" for="h-health-enabled">Składka zdrowotna</label>
                        </div>
                    </div>
                    @if (_taxConfig.HealthInsuranceEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Miesięczna składka zdrowotna (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.HealthInsuranceMonthly" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-wallet2 me-2"></i>Koszty uzyskania przychodu</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="h-costs-enabled" @bind="_taxConfig.CostDeductionsEnabled" />
                            <label class="form-check-label" for="h-costs-enabled">Odliczanie kosztów stałych</label>
                        </div>
                    </div>
                    @if (_taxConfig.CostDeductionsEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Miesięczne koszty stałe (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.MonthlyFixedCosts" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-hash me-2"></i>Numeracja faktur</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="h-invoice-enabled" @bind="_taxConfig.InvoiceNumberingEnabled" />
                            <label class="form-check-label" for="h-invoice-enabled">Automatyczna numeracja</label>
                        </div>
                    </div>
                    @if (_taxConfig.InvoiceNumberingEnabled)
                    {
                        <div class="col-6 col-md-3">
                            <label class="form-label small">Prefiks</label>
                            <input type="text" class="form-control form-control-sm" @bind="_taxConfig.InvoicePrefix" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">Następny numer</label>
                            <input type="number" class="form-control form-control-sm" min="1" @bind="_taxConfig.InvoiceNextNumber" />
                        </div>
                    }

                    <div class="col-12 mt-3">
                        <button class="btn btn-primary btn-sm" @onclick="SaveTaxSettingsAsync" disabled="@_taxSaving">
                            @if (_taxSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Zapisz ustawienia
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-8">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-bar-chart-fill me-2" style="color:var(--c-primary)"></i>Przychody miesięcznie — opłacone pakiety (zł)
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="hidden-finance-bar"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-pie-chart-fill me-2" style="color:var(--c-primary)"></i>Status pakietów
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="hidden-finance-donut"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- History -->
    <div class="card">
        <div class="card-header py-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="fw-semibold me-auto" style="font-size:.875rem">
                <i class="bi bi-clock-history me-2"></i>
                @(_viewMode == "all" ? "Wszystkie pakiety" : "Ukryte pakiety")
                <span class="badge bg-secondary ms-1">@_historyFiltered.Count</span>
            </span>
            <input class="form-control form-control-sm" style="max-width:180px" placeholder="Szukaj klienta…"
                   @bind="_search" @bind:event="oninput" />
            <select class="form-select form-select-sm" style="max-width:150px" @bind="_statusFilter">
                <option value="">Wszystkie statusy</option>
                <option value="Active">Aktywne</option>
                <option value="Depleted">Wyczerpane</option>
                <option value="Expired">Wygasłe</option>
                <option value="Cancelled">Anulowane</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:.875rem">
                <thead class="table-light">
                    <tr>
                        <th>Klient</th>
                        <th>Pakiet</th>
                        <th class="text-center">Sesje</th>
                        <th class="text-end">Wartość</th>
                        <th>Zakupiony</th>
                        <th>Ważny do</th>
                        <th>Płatność</th>
                        <th>Status</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_historyFiltered.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4 small">Brak ukrytych pakietów</td></tr>
                    }
                    @foreach (var p in _historyFiltered)
                    {
                        var pkgId = p.Id;
                        var isHidden = p.IsHidden;
                        <tr class="@(isHidden ? "" : "table-light")">
                            <td><a href="/clients/@p.ClientId" class="text-decoration-none fw-semibold">@p.ClientName</a></td>
                            <td>
                                <div>
                                    @p.Name
                                    @if (_viewMode == "all" && isHidden)
                                    {
                                        <i class="bi bi-eye-slash ms-1 text-muted" style="font-size:.7rem"></i>
                                    }
                                </div>
                                <div class="text-muted" style="font-size:.75rem">@p.SessionTypeName · @p.DurationMinutes min</div>
                            </td>
                            <td class="text-center">
                                <span class="fw-semibold">@p.UsedSessions/@p.TotalSessions</span>
                                @if (p.Status == PackageStatus.Active)
                                {
                                    <div class="progress mt-1" style="height:4px;width:50px;margin:0 auto">
                                        <div class="progress-bar bg-primary" style="width:@(p.TotalSessions > 0 ? (int)((double)p.UsedSessions/p.TotalSessions*100) : 0)%"></div>
                                    </div>
                                }
                            </td>
                            <td class="text-end fw-semibold">@p.TotalPrice.ToString("N0") zł</td>
                            <td class="text-nowrap text-muted">@p.PurchasedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-nowrap text-muted">
                                @(p.ExpiresAt.HasValue ? p.ExpiresAt.Value.ToLocalTime().ToString("dd.MM.yyyy") : "—")
                            </td>
                            <td>
                                @if (p.IsPaid)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check me-1"></i>Opłacony</span>
                                }
                                else if (p.Status != PackageStatus.Cancelled)
                                {
                                    <span class="badge bg-warning text-dark">Oczekuje</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @StatusCss(p.Status)">@StatusLabel(p.Status)</span></td>
                            <td>
                                @if (isHidden)
                                {
                                    <button class="btn btn-sm btn-link text-muted p-0" title="Pokaż pakiet (przenieś do zwykłych)" @onclick="() => UnhidePackageAsync(pkgId)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (_historyFiltered.Any())
                {
                    <tfoot class="fw-bold table-light">
                        <tr>
                            <td colspan="3">Razem (@_historyFiltered.Count)</td>
                            <td class="text-end">@_historyFiltered.Sum(p => p.TotalPrice).ToString("N0") zł</td>
                            <td colspan="5"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    <!-- PIN management -->
    <div class="card mt-3">
        <div class="card-header py-2 fw-semibold" style="font-size:.875rem">
            <i class="bi bi-key me-2"></i>Zarządzanie PIN-em
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label small">Nowy PIN (4-8 cyfr)</label>
                    <input type="password" class="form-control form-control-sm" maxlength="8" @bind="_changePinValue"
                           inputmode="numeric" style="width:140px;letter-spacing:.3em" />
                </div>
                <div class="col-auto">
                    <label class="form-label small">Powtórz</label>
                    <input type="password" class="form-control form-control-sm" maxlength="8" @bind="_changePinConfirm"
                           inputmode="numeric" style="width:140px;letter-spacing:.3em" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-outline-primary" @onclick="ChangePinAsync" disabled="@_settingPin">
                        @if (_settingPin) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Zmień PIN
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_changePinError))
                {
                    <div class="col-12">
                        <div class="text-danger small">@_changePinError</div>
                    </div>
                }
                @if (_changePinSuccess)
                {
                    <div class="col-12">
                        <div class="text-success small"><i class="bi bi-check-circle me-1"></i>PIN został zmieniony.</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _hasPermission;
    private bool _pinSet;
    private bool _authorized;
    private string? _trainerUserId;
    private string _userRole = "";

    private string _newPin = "";
    private string _confirmPin = "";
    private string _enteredPin = "";
    private string _pinError = "";
    private bool _settingPin;
    private bool _verifyingPin;

    private string _changePinValue = "";
    private string _changePinConfirm = "";
    private string _changePinError = "";
    private bool _changePinSuccess;

    private int _months = 6;
    private string _viewMode = "hidden";
    private List<SessionPackageDto> _allPackagesRaw = [];
    private List<SessionPackageDto> _hiddenPackages = [];
    private List<SessionPackageDto> _displayPackages = [];
    private bool _chartNeedsRender;
    private FinanceTaxConfigDto? _taxConfig;
    private bool _showTaxSettings;
    private bool _taxSaving;

    private string _search = string.Empty;
    private string _statusFilter = string.Empty;

    private List<SessionPackageDto> _historyFiltered =>
        (_viewMode == "all" ? _allPackagesRaw : _hiddenPackages)
        .Where(p =>
            (string.IsNullOrWhiteSpace(_search) || p.ClientName.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_statusFilter) || p.Status.ToString() == _statusFilter)
        )
        .OrderByDescending(p => p.PurchasedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var isAdmin = auth.User.IsInRole(Roles.Admin);
        _trainerUserId = isAdmin ? null : auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _userRole = isAdmin ? Roles.Admin
            : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer
            : auth.User.IsInRole(Roles.Subordinate) ? Roles.Subordinate
            : "";

        _hasPermission = await PermissionService.HasPermissionAsync(_userRole, Permissions.ViewHiddenFinance);
        if (!_hasPermission) return;

        _pinSet = await FinanceService.IsPinSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender && _authorized)
        {
            _chartNeedsRender = false;
            await RenderChartsAsync();
        }
    }

    private async Task PinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VerifyPinAsync();
    }

    private async Task SetPinAsync()
    {
        _pinError = "";
        if (_newPin.Length < 4 || _newPin.Length > 8 || !_newPin.All(char.IsDigit))
        {
            _pinError = "PIN musi mieć 4-8 cyfr.";
            return;
        }
        if (_newPin != _confirmPin)
        {
            _pinError = "PIN-y się nie zgadzają.";
            return;
        }
        _settingPin = true;
        StateHasChanged();
        await FinanceService.SetPinAsync(_newPin);
        _pinSet = true;
        _settingPin = false;
    }

    private async Task VerifyPinAsync()
    {
        _pinError = "";
        if (string.IsNullOrWhiteSpace(_enteredPin))
        {
            _pinError = "Wprowadź PIN.";
            return;
        }
        _verifyingPin = true;
        StateHasChanged();
        var ok = await FinanceService.VerifyPinAsync(_enteredPin);
        _verifyingPin = false;
        if (!ok)
        {
            _pinError = "Nieprawidłowy PIN.";
            _enteredPin = "";
            return;
        }
        _authorized = true;
        _taxConfig = await FinanceService.GetTaxConfigAsync("hidden");
        await LoadDataAsync();
    }

    private async Task ChangePinAsync()
    {
        _changePinError = "";
        _changePinSuccess = false;
        if (_changePinValue.Length < 4 || _changePinValue.Length > 8 || !_changePinValue.All(char.IsDigit))
        {
            _changePinError = "PIN musi mieć 4-8 cyfr.";
            return;
        }
        if (_changePinValue != _changePinConfirm)
        {
            _changePinError = "PIN-y się nie zgadzają.";
            return;
        }
        _settingPin = true;
        StateHasChanged();
        await FinanceService.SetPinAsync(_changePinValue);
        _settingPin = false;
        _changePinValue = "";
        _changePinConfirm = "";
        _changePinSuccess = true;
    }

    private async Task ChangeRange(int months)
    {
        _months = months;
        await LoadDataAsync();
    }

    private void ChangeView(string mode)
    {
        _viewMode = mode;
        _displayPackages = _viewMode == "all" ? _allPackagesRaw : _hiddenPackages;
        _chartNeedsRender = true;
    }

    private async Task LoadDataAsync()
    {
        var from = DateTime.UtcNow.AddMonths(-_months);
        _allPackagesRaw = (await PackageService.GetAllPackagesAsync(_trainerUserId))
            .Where(p => p.PurchasedAt >= from).ToList();
        _hiddenPackages = _allPackagesRaw.Where(p => p.IsHidden).ToList();
        _displayPackages = _viewMode == "all" ? _allPackagesRaw : _hiddenPackages;
        _chartNeedsRender = true;
    }

    private async Task UnhidePackageAsync(int packageId)
    {
        await FinanceService.SetPackageHiddenAsync(packageId, false);
        await LoadDataAsync();
    }

    private async Task SaveTaxSettingsAsync()
    {
        if (_taxConfig is null) return;
        _taxSaving = true;
        StateHasChanged();
        await FinanceService.SaveTaxConfigAsync(_taxConfig);
        _taxSaving = false;
        _showTaxSettings = false;
    }

    private static bool HasAnyTaxOption(FinanceTaxConfigDto tc) =>
        tc.VatEnabled || tc.IncomeTaxType != "none" || tc.ZusEnabled || tc.HealthInsuranceEnabled || tc.CostDeductionsEnabled;

    private static (decimal Gross, decimal Vat, decimal Net, decimal IncomeTax, string TaxLabel, decimal Zus, decimal Health, decimal Costs, decimal Profit) ComputeTax(
        List<SessionPackageDto> packages, FinanceTaxConfigDto tax, int months)
    {
        var gross = packages.Where(p => p.IsPaid).Sum(p => p.TotalPrice);
        decimal vat = 0, net = gross;
        if (tax.VatEnabled && tax.VatRate > 0)
        {
            vat = gross * tax.VatRate / (100 + tax.VatRate);
            net = gross - vat;
        }

        decimal incomeTax = 0;
        string taxLabel = "";
        switch (tax.IncomeTaxType)
        {
            case "flat":
                incomeTax = net * tax.FlatTaxRate / 100;
                taxLabel = $"PIT liniowy ({tax.FlatTaxRate}%)";
                break;
            case "lump":
                incomeTax = net * tax.LumpSumRate / 100;
                taxLabel = $"Ryczałt ({tax.LumpSumRate}%)";
                break;
            case "scale":
                if (net <= tax.ScaleTaxThreshold)
                {
                    incomeTax = net * tax.ScaleTaxRateLow / 100;
                    taxLabel = $"Skala ({tax.ScaleTaxRateLow}%)";
                }
                else
                {
                    incomeTax = tax.ScaleTaxThreshold * tax.ScaleTaxRateLow / 100
                                + (net - tax.ScaleTaxThreshold) * tax.ScaleTaxRateHigh / 100;
                    taxLabel = $"Skala ({tax.ScaleTaxRateLow}%/{tax.ScaleTaxRateHigh}%)";
                }
                break;
        }

        var zus = tax.ZusEnabled ? tax.ZusMonthlyAmount * months : 0;
        var health = tax.HealthInsuranceEnabled ? tax.HealthInsuranceMonthly * months : 0;
        var costs = tax.CostDeductionsEnabled ? tax.MonthlyFixedCosts * months : 0;
        return (gross, vat, net, incomeTax, taxLabel, zus, health, costs, net - incomeTax - zus - health - costs);
    }

    private async Task RenderChartsAsync()
    {
        var monthSlots = Enumerable.Range(0, _months)
            .Select(i => DateTime.Now.AddMonths(-(_months - 1 - i)))
            .Select(d => (Label: d.ToString("MM.yy"), Year: d.Year, Month: d.Month))
            .ToList();

        var barLabels = monthSlots.Select(m => m.Label).ToArray();
        var barRevenue = monthSlots
            .Select(m => (double)_displayPackages
                .Where(p => p.IsPaid
                    && p.PurchasedAt.ToLocalTime().Year == m.Year
                    && p.PurchasedAt.ToLocalTime().Month == m.Month)
                .Sum(p => p.TotalPrice))
            .ToArray();

        await JS.InvokeVoidAsync("PTChart.renderBar", "hidden-finance-bar", barLabels,
            new object[] { new { label = "Przychód (zł)", data = barRevenue } });

        var active = _displayPackages.Count(p => p.Status == PackageStatus.Active);
        var depleted = _displayPackages.Count(p => p.Status == PackageStatus.Depleted);
        var expired = _displayPackages.Count(p => p.Status == PackageStatus.Expired);
        var cancelled = _displayPackages.Count(p => p.Status == PackageStatus.Cancelled);

        await JS.InvokeVoidAsync("PTChart.renderDoughnut", "hidden-finance-donut",
            new[] { "Aktywne", "Wyczerpane", "Wygasłe", "Anulowane" },
            new double[] { active, depleted, expired, cancelled },
            new[] { "#3B82F6", "#16A34A", "#D97706", "#9CA3AF" });
    }

    private static string StatusCss(PackageStatus s) => s switch
    {
        PackageStatus.Active    => "bg-primary",
        PackageStatus.Depleted  => "bg-success",
        PackageStatus.Expired   => "bg-warning text-dark",
        PackageStatus.Cancelled => "bg-secondary",
        _                       => "bg-secondary"
    };

    private static string StatusLabel(PackageStatus s) => s switch
    {
        PackageStatus.Active    => "Aktywny",
        PackageStatus.Depleted  => "Wyczerpany",
        PackageStatus.Expired   => "Wygasły",
        PackageStatus.Cancelled => "Anulowany",
        _                       => s.ToString()
    };
}
