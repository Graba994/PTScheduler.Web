    }

    public sealed class DraftSet
    {
        public int Reps { get; set; }
        public decimal Weight { get; set; }
        public int? DurationSeconds { get; set; }
        public decimal? DistanceMeters { get; set; }
        public bool Done { get; set; }
    }
