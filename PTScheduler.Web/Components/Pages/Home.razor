@page "/app"
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Dashboard" />

<!-- ADMIN (administrator studia i konto techniczne) -->
<AuthorizeView Roles="@Roles.Admin">
    <Authorized>
        <AdminDashboard />
    </Authorized>
</AuthorizeView>

<!-- TRAINER / SUBORDINATE -->
<AuthorizeView Roles="@($"{Roles.Trainer},{Roles.Subordinate}")">
    <Authorized>
        <PasswordReminder />
        <TrainerDashboard TrainerUserId="@_trainerUserId" />
    </Authorized>
</AuthorizeView>

<!-- CLIENT -->
<AuthorizeView Roles="@Roles.Client">
    <Authorized>
        <PasswordReminder />
        <ClientDashboard UserId="@_clientUserId" />
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private string? _trainerUserId;
    private string? _clientUserId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateTask;
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (auth.User.IsInRole(Roles.Admin)) return;
        if (auth.User.IsInRole(Roles.Trainer) || auth.User.IsInRole(Roles.Subordinate))
            _trainerUserId = userId;
        else if (auth.User.IsInRole(Roles.Client))
            _clientUserId = userId;
    }
}
