@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject IDbContextFactory<PTScheduler.Infrastructure.Data.ApplicationDbContext> DbFactory
@inject IAuditLogService AuditService
@inject IUserManagementService UserService
@inject IPermissionService Permission
@inject IPaymentSettingsService PaymentSettings
@inject IModuleSettingsService ModuleSettings
@inject AuthenticationStateProvider AuthState
@inject ILoggerFactory LoggerFactory
@inject EntitlementService Entitlements
@inject SetupGuide Guide
@using PTScheduler.Web.Components.Layout
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Zarządzanie" />

<div class="set-head">
    <div>
        <h4 class="set-title"><i class="bi bi-sliders2"></i>Zarządzanie</h4>
        <p class="set-sub">Wszystko, co ustawiasz raz — oferta, płatności, powiadomienia i wygląd aplikacji. Kliknij <i class="bi bi-info-circle"></i>, żeby zobaczyć, do czego służy dana opcja.</p>
    </div>
    <span class="badge bg-body-secondary text-body"><i class="bi bi-person-fill me-1"></i>@_userEmail · @_role</span>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (_access.IsOwner && _setup.Steps.Count > 0)
    {
        var steps = _setup.Steps;
        var done = _setup.DoneCount;
        if (!_setup.AllDone)
        {
            <section class="set-start" aria-labelledby="set-start-title">
                <div class="set-start-head">
                    <div>
                        <h5 id="set-start-title"><i class="bi bi-rocket-takeoff"></i>Pierwsze kroki</h5>
                        <div class="text-muted small">Zrób to raz, a aplikacja będzie gotowa dla klientów.</div>
                    </div>
                    <div class="set-start-count"><b>@done</b> z @steps.Count</div>
                </div>
                <div class="set-progress" role="progressbar" aria-valuenow="@done" aria-valuemin="0" aria-valuemax="@steps.Count"><div style="width:@(done * 100 / steps.Count)%"></div></div>
                <ol class="set-steps">
                    @foreach (var step in steps.Where(x => !x.Done))
                    {
                        <li>
                            <a href="@step.Href">
                                <span class="set-step-check"><i class="bi @step.Icon"></i></span>
                                <span class="set-step-text"><b>@step.Title</b><small>@step.Hint</small></span>
                                <i class="bi bi-chevron-right ms-auto text-muted"></i>
                            </a>
                        </li>
                    }
                </ol>
                @if (done > 0)
                {
                    <div class="set-steps-done">
                        <span>Zrobione:</span>
                        @foreach (var step in steps.Where(x => x.Done))
                        {
                            <a href="@step.Href"><i class="bi bi-check-circle-fill me-1"></i>@step.Title</a>
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <div class="set-alldone">
                <i class="bi bi-patch-check-fill"></i>
                <span><b>Wszystko gotowe.</b> Aplikacja jest skonfigurowana — poniżej zostały tylko opcje, do których możesz wrócić, gdy zechcesz.</span>
            </div>
        }
    }

    @if (!_isHighestPlan && _access.IsOwner)
    {
        <a href="/admin/upgrade" class="set-upgrade">
            <i class="bi bi-rocket-takeoff-fill"></i>
            <span><b>Potrzebujesz więcej?</b> Sprawdź wyższy plan — SMS-y, płatności online, kursy i zespół.</span>
            <i class="bi bi-chevron-right ms-auto"></i>
        </a>
    }

    @foreach (var group in AdminMenu.Groups.Where(g => !g.Advanced))
    {
        @RenderGroup(group)
    }

    @if (AdminMenu.Groups.Any(g => g.Advanced && g.Items.Any(_access.Sees)))
    {
        <details class="set-more">
            <summary><i class="bi bi-sliders"></i>Więcej ustawień: zespół, kopie zapasowe, eksport, historia zmian</summary>
            @foreach (var group in AdminMenu.Groups.Where(g => g.Advanced))
            {
                @RenderGroup(group)
            }
        </details>
    }

    <div class="set-foot">
        <a href="/admin/feedback"><i class="bi bi-chat-heart me-1"></i>Oceń aplikację i napisz, czego brakuje</a>
    </div>

    @if (_isAdmin)
    {
        <details class="set-tech">
            <summary><i class="bi bi-cpu me-2"></i>Szczegóły techniczne <span class="text-muted small">(stan systemu, baza, ostatnia aktywność)</span></summary>
            <div class="mt-3">
            <!-- System status -->
                <div class="card mb-4">
                    <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                        <span class="fw-semibold"><i class="bi bi-heart-pulse me-2 text-success"></i>Stan systemu</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh" disabled="@_loading">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="adm-sys-grid">
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Baza danych</div>
                                <div class="adm-sys-value">
                                    @if (_dbOnline)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Offline</span>
                                    }
                                </div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Wielkość bazy</div>
                                <div class="adm-sys-value fw-semibold">@_dbSize</div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Tabele</div>
                                <div class="adm-sys-value fw-semibold">@_tableCount</div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Migracje EF</div>
                                <div class="adm-sys-value fw-semibold">@_migrationCount</div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Środowisko</div>
                                <div class="adm-sys-value"><span class="badge bg-body-secondary text-body">@_environment</span></div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">.NET</div>
                                <div class="adm-sys-value"><span class="badge bg-body-secondary text-body">@_dotnetVersion</span></div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Wersja aplikacji</div>
                                <div class="adm-sys-value"><span class="badge bg-body-secondary text-body font-monospace">@_appVersion</span></div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Płatności online</div>
                                <div class="adm-sys-value">
                                    @if (_paymentsEnabled)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Włączone (@_enabledGateways)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Wyłączone</span>
                                    }
                                </div>
                            </div>
                            <div class="adm-sys-item">
                                <div class="adm-sys-label">Moduł kursów</div>
                                <div class="adm-sys-value">
                                    @if (_coursesEnabled)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Włączony</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Wyłączony</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table sizes -->
                @if (_tableSizes.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-transparent">
                            <span class="fw-semibold"><i class="bi bi-database me-2" style="color:var(--c-primary)"></i>Rozmiary tabel</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" style="font-size:.85rem">
                                    <thead class="table-light">
                                        <tr><th>Tabela</th><th class="text-end">Wiersze</th><th class="text-end">Rozmiar</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in _tableSizes)
                                        {
                                            <tr>
                                                <td class="fw-semibold font-monospace" style="font-size:.8rem">@t.Name</td>
                                                <td class="text-end text-muted">@t.Rows.ToString("N0")</td>
                                                <td class="text-end text-muted">@t.Size</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

            <!-- Recent activity -->
            <div class="card">
                <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                    <span class="fw-semibold"><i class="bi bi-clock-history me-2" style="color:var(--c-primary)"></i>Ostatnia aktywność</span>
                    <a href="/admin/audit-logs" class="btn btn-sm btn-outline-primary">Zobacz wszystko</a>
                </div>
                <div class="card-body p-0">
                    @if (_recentLogs.Count == 0)
                    {
                        <div class="text-center text-muted py-4 small">Brak aktywności.</div>
                    }
                    else
                    {
                        <div class="adm-activity">
                            @foreach (var log in _recentLogs)
                            {
                                <div class="adm-activity-item">
                                    <div class="adm-activity-dot @ActivityDotClass(log.Action)"></div>
                                    <div class="adm-activity-body">
                                        <div class="adm-activity-action">
                                            <span class="fw-semibold">@log.Action</span>
                                            @if (!string.IsNullOrEmpty(log.EntityType))
                                            {
                                                <span class="badge bg-body-secondary text-body ms-1" style="font-size:.7rem">@log.EntityType</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(log.Details))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width:500px">@log.Details</div>
                                        }
                                        <div class="adm-activity-meta">
                                            <span>@log.UserEmail</span>
                                            <span>@log.Timestamp.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            </div>
        </details>
    }
}

<style>
    .adm-stat-card {
        display: flex; align-items: center; gap: .85rem;
        padding: 1.1rem 1rem; border-radius: 1rem;
        background: var(--bs-body-bg); border: 1px solid var(--bs-border-color);
        transition: transform .12s, box-shadow .12s;
    }
    .adm-stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px -12px rgba(0,0,0,.12); }
    .adm-stat-icon {
        width: 48px; height: 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
    }
    .adm-stat-value { font-size: 1.5rem; font-weight: 800; line-height: 1.1; }
    .adm-stat-label { font-size: .78rem; color: var(--bs-secondary-color); font-weight: 500; }

    .adm-sys-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
    .adm-sys-item {
        display: flex; align-items: center; justify-content: space-between; gap: .5rem;
        padding: .7rem 1rem; border-bottom: 1px solid var(--bs-border-color);
    }
    .adm-sys-item:last-child { border-bottom: none; }
    .adm-sys-label { font-size: .85rem; color: var(--bs-secondary-color); }
    .adm-sys-value { font-size: .85rem; }

    .adm-activity { display: flex; flex-direction: column; }
    .adm-activity-item {
        display: flex; gap: .75rem; padding: .75rem 1rem;
        border-bottom: 1px solid var(--bs-border-color);
    }
    .adm-activity-item:last-child { border-bottom: none; }
    .adm-activity-dot {
        width: 10px; height: 10px; border-radius: 50%; margin-top: 5px; flex-shrink: 0;
        background: var(--bs-secondary-color);
    }
    .adm-activity-dot.create { background: #10b981; }
    .adm-activity-dot.update { background: #3b82f6; }
    .adm-activity-dot.delete { background: #ef4444; }
    .adm-activity-dot.login { background: #8b5cf6; }
    .adm-activity-body { flex: 1; min-width: 0; }
    .adm-activity-action { font-size: .88rem; }
    .adm-activity-meta {
        display: flex; gap: .75rem; font-size: .75rem;
        color: var(--bs-secondary-color); margin-top: .15rem;
    }

    .adm-quick-links { display: flex; flex-direction: column; }
    .adm-qlink {
        display: flex; align-items: center; gap: .65rem;
        padding: .65rem 1rem; text-decoration: none;
        color: var(--bs-body-color); font-weight: 500; font-size: .9rem;
        border-bottom: 1px solid var(--bs-border-color);
        transition: background .12s;
    }
    .adm-qlink:last-child { border-bottom: none; }
    .adm-qlink:hover { background: var(--bs-tertiary-bg); color: var(--c-primary); }
    .adm-qlink i:first-child { color: var(--c-primary); font-size: 1.05rem; width: 20px; text-align: center; }
    .adm-qlink i:last-child { font-size: .7rem; color: var(--bs-secondary-color); }
</style>

@code {
    private bool _loading = true;
    private bool _isAdmin;
    private string _role = "";
    private string _userEmail = "";

    private bool _dbOnline;
    private string _dbSize = "—";
    private int _tableCount;
    private int _migrationCount;
    private string _environment = "";
    private string _dotnetVersion = "";
    private string _appVersion = "";
    private bool _paymentsEnabled;
    private int _enabledGateways;
    private bool _coursesEnabled;

    private AdminStats _stats = new();

    // Grupa kafelków: skonfigurowane opcje zwinięte do małych „✓”, żeby na wierzchu zostało to, co do zrobienia.
    private RenderFragment RenderGroup(AdminMenuGroup group) => __builder =>
    {
        var items = group.Items.Where(_access.Sees).ToList();
        if (items.Count == 0) return;
        var configured = items.Where(i => _setup.StatusOf(i).IsConfigured && !(i.PlanFlag is not null && !Entitlements.IsAllowed(i.PlanFlag))).ToList();
        var open = items.Except(configured).ToList();
        <section class="set-group set-tone-@group.Tone" aria-label="@group.Title">
            <h6 class="set-group-title"><i class="bi @group.Icon"></i>@group.Title</h6>
            @if (open.Count > 0)
            {
                <div class="set-grid">
                    @foreach (var item in open)
                    {
                        var locked = item.PlanFlag is not null && !Entitlements.IsAllowed(item.PlanFlag);
                        var status = _setup.StatusOf(item);
                        <div class="set-tile @(locked ? "locked" : "")">
                            <span class="set-tile-icon"><i class="bi @item.Icon"></i></span>
                            <div class="set-tile-body">
                                <a class="set-tile-link" href="/@item.Href">@item.Title</a>
                                <div class="set-tile-desc">@item.Description</div>
                                @if (locked)
                                {
                                    <span class="set-chip set-chip-plan"><i class="bi bi-lock-fill"></i>Plan @(item.PlanName ?? "Pro")</span>
                                }
                                else if (status.Text is not null)
                                {
                                    <span class="set-chip set-chip-@status.Tone">@status.Text</span>
                                }
                            </div>
                            <InfoTip Title="@item.Title" Text="@item.Info" Class="set-tile-info" />
                        </div>
                    }
                </div>
            }
            @if (configured.Count > 0)
            {
                <div class="set-done">
                    <span class="set-done-label">Gotowe:</span>
                    @foreach (var item in configured)
                    {
                        <a href="/@item.Href" title="@item.Description"><i class="bi bi-check-circle-fill"></i>@item.Title <small>@_setup.StatusOf(item).Text</small></a>
                    }
                </div>
            }
        </section>
    };

    // Strona „Zarządzanie”: kto co widzi, pierwsze kroki i stan kafelków.
    private AdminAccess _access = new();
    private bool _isHighestPlan;
    private SetupState _setup = new();
    private List<AuditLogDto> _recentLogs = [];
    private List<RoleCount> _roleCounts = [];
    private List<TableSize> _tableSizes = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userEmail = auth.User.Identity?.Name ?? "";
        _isAdmin = auth.User.IsInRole(Roles.Admin);
        _role = _isAdmin ? "Admin"
              : auth.User.IsInRole(Roles.Trainer) ? "Trener"
              : auth.User.IsInRole(Roles.Subordinate) ? "Asystent trenera" : "—";

        _dotnetVersion = System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription;
        _environment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production";

        // Wersja obrazu — z BUILD_COMMIT/BUILD_TIME wstrzykniętych przy budowie
        // (Dockerfile ENV). Pozwala potwierdzić, że wgrany jest właściwy build.
        var commit = Environment.GetEnvironmentVariable("BUILD_COMMIT");
        var buildTime = Environment.GetEnvironmentVariable("BUILD_TIME");
        if (!string.IsNullOrWhiteSpace(commit) && commit != "unknown")
        {
            var shortSha = commit.Length >= 7 ? commit[..7] : commit;
            _appVersion = string.IsNullOrWhiteSpace(buildTime) || buildTime == "unknown"
                ? shortSha
                : $"{shortSha} · {buildTime}";
        }
        else
        {
            _appVersion = "nieznana (zbudowano bez wersji)";
        }

        _access = await AdminAccess.LoadAsync(AuthState, Permission);
        _isHighestPlan = Entitlements.Current.Id is "studio" or "unlimited";
        await LoadDataAsync();
        await LoadHubAsync(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "");
        _loading = false;
    }

    /// <summary>Stan kafelków („3 rodzaje”, „Do ustawienia”) i lista pierwszych kroków.</summary>
    private async Task LoadHubAsync(string userId) => _setup = await Guide.GetAsync(userId, _access);

    private async Task Refresh()
    {
        _loading = true;
        await LoadDataAsync();
        _loading = false;
    }

    private async Task LoadDataAsync()
    {
        await using var db = DbFactory.CreateDbContext();

        try { _dbOnline = await db.Database.CanConnectAsync(); } catch { _dbOnline = false; }

        if (_dbOnline)
        {
            _stats.Users = await db.Users.CountAsync();
            _stats.Clients = await db.Clients.CountAsync();
            _stats.Sessions = await db.Sessions.CountAsync();
            _stats.Packages = await db.SessionPackages.CountAsync();
            _stats.Orders = await db.Orders.CountAsync();
            _stats.PaidOrders = await db.Orders.CountAsync(o => o.Status == PTScheduler.Domain.Enums.OrderStatus.Paid);
            _stats.PendingOrders = await db.Orders.CountAsync(o => o.Status == PTScheduler.Domain.Enums.OrderStatus.Pending);
            _stats.Revenue = await db.Orders
                .Where(o => o.Status == PTScheduler.Domain.Enums.OrderStatus.Paid)
                .SumAsync(o => (decimal?)o.Amount) ?? 0;

            var users = await UserService.GetAllUsersAsync();
            _roleCounts =
            [
                new("Admin", users.Count(u => u.Role == "Admin"), "#3b82f6"),
                new("Trener", users.Count(u => u.Role == "Trainer"), "#10b981"),
                new("Asystent trenera", users.Count(u => u.Role == "Subordinate"), "#f59e0b"),
                new("Klient", users.Count(u => u.Role == "Client"), "#8b5cf6"),
            ];

            if (_isAdmin)
            {
                try
                {
                    var sizeResult = await db.Database.SqlQueryRaw<string>(
                        "SELECT pg_size_pretty(pg_database_size(current_database())) AS \"Value\"")
                        .FirstOrDefaultAsync();
                    _dbSize = sizeResult ?? "—";
                }
                catch { _dbSize = "—"; }

                try
                {
                    _tableCount = await db.Database.SqlQueryRaw<int>(
                        "SELECT COUNT(*)::int AS \"Value\" FROM information_schema.tables WHERE table_schema = 'public'")
                        .FirstOrDefaultAsync();
                }
                catch (Exception ex) { LoggerFactory.CreateLogger("AdminDashboard").LogWarning(ex, "Nie udało się policzyć tabel bazy."); }

                try
                {
                    _migrationCount = await db.Database.SqlQueryRaw<int>(
                        "SELECT COUNT(*)::int AS \"Value\" FROM \"__EFMigrationsHistory\"")
                        .FirstOrDefaultAsync();
                }
                catch (Exception ex) { LoggerFactory.CreateLogger("AdminDashboard").LogWarning(ex, "Nie udało się policzyć zastosowanych migracji."); }

                try
                {
                    _tableSizes = await db.Database.SqlQueryRaw<TableSizeRaw>(
                        @"SELECT relname AS ""Name"",
                                 n_live_tup AS ""Rows"",
                                 pg_size_pretty(pg_total_relation_size(quote_ident(relname))) AS ""Size""
                          FROM pg_stat_user_tables
                          ORDER BY pg_total_relation_size(quote_ident(relname)) DESC
                          LIMIT 15")
                        .Select(r => new TableSize(r.Name, r.Rows, r.Size))
                        .ToListAsync();
                }
                catch { _tableSizes = []; }
            }
        }

        try
        {
            var ps = await PaymentSettings.GetAsync();
            _paymentsEnabled = ps.Enabled;
            _enabledGateways = ps.Providers.Count(p => p.Enabled);
        }
        catch (Exception ex) { LoggerFactory.CreateLogger("AdminDashboard").LogWarning(ex, "Nie udało się wczytać ustawień płatności na panel."); }

        try { _coursesEnabled = (await ModuleSettings.GetAsync()).CoursesEnabled; }
        catch (Exception ex) { LoggerFactory.CreateLogger("AdminDashboard").LogWarning(ex, "Nie udało się wczytać ustawień modułów na panel."); }

        try { _recentLogs = await AuditService.GetLogsAsync(count: 15); }
        catch (Exception ex) { LoggerFactory.CreateLogger("AdminDashboard").LogWarning(ex, "Nie udało się wczytać ostatnich logów audytu na panel."); }
    }

    private static string ActivityDotClass(string action)
    {
        var a = action.ToLowerInvariant();
        if (a.Contains("create") || a.Contains("dodano") || a.Contains("utwo")) return "create";
        if (a.Contains("update") || a.Contains("edycja") || a.Contains("zmian")) return "update";
        if (a.Contains("delete") || a.Contains("usun") || a.Contains("anulo")) return "delete";
        if (a.Contains("login") || a.Contains("logowa")) return "login";
        return "";
    }

    private class AdminStats
    {
        public int Users, Clients, Sessions, Packages, Orders, PaidOrders, PendingOrders;
        public decimal Revenue;
    }

    private record RoleCount(string Role, int Count, string Color);
    private record TableSize(string Name, long Rows, string Size);

    private class TableSizeRaw
    {
        public string Name { get; set; } = "";
        public long Rows { get; set; }
        public string Size { get; set; } = "";
    }
}
