@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@inject IDatabaseSettingsService DbSettings
@inject ILogger<Settings> Logger
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Baza danych" />

<div class="manage-card">
    <h5 class="fw-bold mb-1"><i class="bi bi-database-fill me-2"></i>Baza danych</h5>
    <p class="text-muted small mb-4">
        Zmiany są zapisywane do <code>connections.json</code> i ładowane bez restartu serwera.
        Nowe połączenia będą natychmiast używać zaktualizowanego stringa.
    </p>

    <div class="mb-3">
        <label class="form-label fw-semibold">Connection String</label>
        <textarea class="form-control font-monospace" rows="3"
                  @bind="_connectionString"
                  placeholder="Host=...;Port=5432;Database=...;Username=...;Password=..." />
    </div>

    @if (_testResult is not null)
    {
        <div class="alert @(_testResult.Value ? "alert-success" : "alert-danger") py-2 small mb-3">
            @if (_testResult.Value)
            {
                <i class="bi bi-check-circle-fill me-1"></i><text>Połączenie udane.</text>
            }
            else
            {
                <i class="bi bi-x-circle-fill me-1"></i><text>Połączenie nieudane. Sprawdź dane.</text>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_saveMessage))
    {
        <div class="alert alert-info py-2 small mb-3">@_saveMessage</div>
    }

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="TestConnectionAsync" disabled="@_busy">
            @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
            <i class="bi bi-plug me-1"></i>Testuj połączenie
        </button>
        <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@_busy">
            <i class="bi bi-floppy-fill me-1"></i>Zapisz
        </button>
    </div>
</div>

@code {
    private string _connectionString = string.Empty;
    private bool? _testResult;
    private string _saveMessage = string.Empty;
    private bool _busy;

    protected override void OnInitialized()
    {
        _connectionString = DbSettings.GetConnectionString();
    }

    private async Task TestConnectionAsync()
    {
        _busy = true;
        _testResult = null;
        _saveMessage = string.Empty;
        _testResult = await DbSettings.TestConnectionAsync(_connectionString);
        _busy = false;
    }

    private void Save()
    {
        try
        {
            DbSettings.SaveConnectionString(_connectionString);
            _saveMessage = "Zapisano. Nowe połączenia będą używać zaktualizowanego stringa.";
            _testResult = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save connection string");
            _saveMessage = $"Błąd zapisu: {ex.Message}";
        }
    }
}
