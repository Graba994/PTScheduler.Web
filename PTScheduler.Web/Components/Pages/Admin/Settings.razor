@page "/admin/settings"
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]
@inject IDatabaseSettingsService DbSettings
@inject ILogger<Settings> Logger
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<AppTitle Page="Ustawienia bazy danych" />

<h2>Ustawienia bazy danych</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Connection String</h5>
                <p class="text-muted small">
                    Zmiany są zapisywane do <code>connections.json</code> i ładowane bez restartu.
                    Nowe połączenia będą używać nowego stringa.
                </p>

                <div class="mb-3">
                    <label class="form-label">Connection String</label>
                    <textarea class="form-control font-monospace" rows="3"
                              @bind="connectionString" placeholder="Host=...;Port=5432;Database=...;Username=...;Password=..." />
                </div>

                @if (testResult is not null)
                {
                    <div class="alert @(testResult.Value ? "alert-success" : "alert-danger") py-2">
                        @(testResult.Value ? "Połączenie udane." : "Połączenie nieudane. Sprawdź dane.")
                    </div>
                }

                @if (!string.IsNullOrEmpty(saveMessage))
                {
                    <div class="alert alert-info py-2">@saveMessage</div>
                }

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="TestConnection" disabled="@isBusy">
                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                        Testuj połączenie
                    </button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@isBusy">
                        Zapisz
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="my-4" />

<h4 class="mb-3"><i class="bi bi-credit-card me-2"></i>Płatności online</h4>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Włącz lub wyłącz moduł płatności online. Konfiguracja kluczy API będzie dostępna po włączeniu integracji z operatorem.
                </p>

                <div class="d-flex align-items-center justify-content-between mb-3 p-3 border rounded">
                    <div>
                        <div class="fw-semibold">Płatności online</div>
                        <div class="text-muted small">Master switch — włącza moduł płatności dla klientów</div>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch"
                               checked="@onlinePaymentsEnabled"
                               @onchange="e => onlinePaymentsEnabled = (bool)(e.Value ?? false)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-uppercase text-muted">Dostępne operatory</label>
                    @foreach (var provider in paymentProviders)
                    {
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-bank text-primary"></i>
                                <span>@provider.Name</span>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       checked="@provider.IsEnabled"
                                       disabled="@(!onlinePaymentsEnabled)"
                                       @onchange="e => provider.IsEnabled = (bool)(e.Value ?? false)" />
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(paymentSaveMsg))
                {
                    <div class="alert alert-info py-2 small">@paymentSaveMsg</div>
                }

                <button class="btn btn-primary btn-sm" @onclick="SavePaymentSettings">
                    Zapisz ustawienia płatności
                </button>
                <p class="text-muted small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>Integracja z API operatorów płatności zostanie uruchomiona w kolejnej wersji.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private string connectionString = string.Empty;
    private bool? testResult;
    private string saveMessage = string.Empty;
    private bool isBusy;

    private bool onlinePaymentsEnabled = false;
    private string paymentSaveMsg = string.Empty;
    private List<PaymentProviderItem> paymentProviders =
    [
        new() { Name = "Przelewy24" },
        new() { Name = "PayU" },
        new() { Name = "PayPo" },
        new() { Name = "Klarna" }
    ];

    protected override void OnInitialized()
    {
        connectionString = DbSettings.GetConnectionString();
    }

    private async Task TestConnection()
    {
        isBusy = true;
        testResult = null;
        saveMessage = string.Empty;
        testResult = await DbSettings.TestConnectionAsync(connectionString);
        isBusy = false;
    }

    private void Save()
    {
        try
        {
            DbSettings.SaveConnectionString(connectionString);
            saveMessage = "Zapisano. Nowe połączenia będą używać zaktualizowanego stringa.";
            testResult = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save connection string");
            saveMessage = $"Błąd zapisu: {ex.Message}";
        }
    }

    private void SavePaymentSettings()
    {
        paymentSaveMsg = "Ustawienia płatności zapisane (infrastruktura gotowa — integracja API w przygotowaniu).";
    }

    private sealed class PaymentProviderItem
    {
        public string Name { get; set; } = string.Empty;
        public bool IsEnabled { get; set; } = false;
    }
}

