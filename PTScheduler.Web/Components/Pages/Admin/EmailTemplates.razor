@page "/admin/email-templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@inject IEmailTemplateService TemplateService
@inject IBrandingService BrandingService
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Szablony email" />

<div class="cal-shell">
    <div class="cal-topbar">
        <h4 class="mb-0 fw-bold">
            <i class="bi bi-file-earmark-richtext-fill me-2"></i>Szablony email
        </h4>
        <button class="btn btn-outline-secondary btn-sm ms-auto" @onclick="() => showHelp = !showHelp">
            <i class="bi bi-question-circle me-1"></i>@(showHelp ? "Zamknij pomoc" : "Jak to działa?")
        </button>
    </div>

    @if (showHelp)
    {
        <div class="p-3 border-bottom" style="background:var(--bs-tertiary-bg)">
            <div style="max-width:720px">
                <h6 class="fw-bold mb-2"><i class="bi bi-lightbulb me-1" style="color:#D97706"></i>Jak działają szablony email?</h6>
                <p class="small text-body-secondary mb-2">
                    Każdy email wysyłany przez aplikację korzysta z szablonu. Możesz dostosować treść, tytuł, kolorystykę i stopkę każdego szablonu.
                </p>
                <div class="row g-3 mb-2">
                    <div class="col-12 col-md-4">
                        <div class="card card-body p-2 h-100">
                            <div class="fw-semibold small"><i class="bi bi-pencil-square me-1 text-primary"></i>Edycja</div>
                            <div class="text-body-secondary" style="font-size:.8rem">Wybierz szablon z listy, zmień temat, tytuł nagłówka, stopkę i kolor akcentu. Zmiany są widoczne natychmiast w podglądzie.</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card card-body p-2 h-100">
                            <div class="fw-semibold small"><i class="bi bi-braces me-1 text-success"></i>Zmienne</div>
                            <div class="text-body-secondary" style="font-size:.8rem">Użyj <code>@("{{NazwaZmiennej}}")</code> w treści. Zmienne są automatycznie zamieniane na dane klienta, trenera, sesji itp. Lista dostępnych zmiennych jest pod formularzem.</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card card-body p-2 h-100">
                            <div class="fw-semibold small"><i class="bi bi-image me-1 text-info"></i>Logo i branding</div>
                            <div class="text-body-secondary" style="font-size:.8rem">Logo aplikacji (z ustawień Wyglądu) jest automatycznie dodawane do nagłówka emaila. Zmienna <code>@("{{Logo}}")</code> zawiera ścieżkę do loga.</div>
                        </div>
                    </div>
                </div>
                <p class="small text-body-secondary mb-0">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Każdy szablon można przywrócić do domyślnej wersji przyciskiem <strong>Przywróć domyślny</strong>.
                    Kod HTML można edytować w sekcji <strong>Zaawansowane</strong> — dla większości zmian wystarczy formularz.
                </p>
            </div>
        </div>
    }

    <div class="cal-body">
        @* ── LEFT: Template list ── *@
        <div class="cal-sidebar" style="min-width:260px;max-width:300px;overflow-y:auto;border-right:1px solid var(--bs-border-color)">
            @if (templates is null)
            {
                @for (var i = 0; i < 8; i++)
                {
                    <div class="p-3 border-bottom">
                        <div class="skeleton skeleton-line w-75" style="height:14px"></div>
                        <div class="skeleton skeleton-line w-50" style="height:10px;margin-top:6px"></div>
                    </div>
                }
            }
            else
            {
                @foreach (var t in templates)
                {
                    <button class="btn btn-link text-start w-100 p-3 border-bottom text-decoration-none rounded-0 @(selected?.Key == t.Key ? "bg-body-secondary" : "")"
                            @onclick="() => Select(t)">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @t.Icon" style="font-size:1.1rem;color:@t.AccentColor"></i>
                            <span class="fw-semibold text-body" style="font-size:.9rem">@t.DisplayName</span>
                            @if (t.IsCustomized)
                            {
                                <span class="badge bg-info text-dark ms-auto" style="font-size:.65rem">Zmieniony</span>
                            }
                        </div>
                    </button>
                }
            }
        </div>

        @* ── RIGHT: Editor ── *@
        <div class="cal-main" style="overflow-y:auto;padding:1.5rem">
            @if (selected is null)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-envelope-open" style="font-size:3rem"></i>
                    <p class="mt-3">Wybierz szablon z listy po lewej stronie, aby go edytować.</p>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h5 class="mb-0">
                        <i class="bi @selected.Icon me-2" style="color:@selected.AccentColor"></i>@selected.DisplayName
                    </h5>
                    <div class="d-flex gap-2">
                        @if (selected.IsCustomized)
                        {
                            <button class="btn btn-outline-warning btn-sm" @onclick="ResetTemplate" disabled="@busy">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Przywróć domyślny
                            </button>
                        }
                        <button class="btn btn-primary btn-sm" @onclick="SaveTemplate" disabled="@busy">
                            @if (busy) { <span class="spinner-border spinner-border-sm me-1" /> }
                            <i class="bi bi-floppy me-1"></i>Zapisz
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(statusMsg))
                {
                    <div class="alert @(statusOk ? "alert-success" : "alert-danger") py-2 small">@statusMsg</div>
                }

                @* ── Branding info ── *@
                @if (branding is not null)
                {
                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded" style="background:var(--bs-tertiary-bg)">
                        @if (!string.IsNullOrEmpty(branding.LogoPath))
                        {
                            <img src="@branding.LogoPath" alt="Logo" style="max-height:32px;max-width:120px" />
                        }
                        <span class="small text-body-secondary">
                            <i class="bi bi-check-circle text-success me-1"></i>Logo i nazwa firmy (<strong>@branding.CompanyName</strong>) są automatycznie dodawane do emaili.
                            <a href="/admin/branding" class="ms-1">Zmień w ustawieniach</a>
                        </span>
                    </div>
                }

                @* ── Main form ── *@
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold">Temat e-maila</label>
                        <input class="form-control" @bind="editSubject" @bind:event="oninput" maxlength="200" />
                        <div class="form-text">Widoczny w skrzynce odbiorczej.</div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold">Tytuł nagłówka</label>
                        <input class="form-control" @bind="editHeaderTitle" @bind:event="oninput" maxlength="200" />
                        <div class="form-text">Tekst w kolorowym pasku na górze emaila.</div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold">Kolor akcentu</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="color" class="form-control form-control-color" @bind="editAccentColor" />
                            <input class="form-control" style="max-width:120px" @bind="editAccentColor" maxlength="9" />
                            @if (branding is not null)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="UseThemeColor" title="Użyj koloru motywu aplikacji">
                                    <i class="bi bi-palette me-1"></i>Motyw
                                </button>
                            }
                        </div>
                        <div class="form-text">Kolor nagłówka i przycisków w emailu.</div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold">Stopka</label>
                        <input class="form-control" @bind="editFooterText" @bind:event="oninput" maxlength="300" />
                        <div class="form-text">Tekst na dole emaila (mała czcionka).</div>
                    </div>
                </div>

                @* ── Variables ── *@
                <div class="mt-3">
                    <label class="form-label fw-semibold">Dostępne zmienne</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var v in selected.AvailableVariables)
                        {
                            <span class="badge bg-body-secondary text-body font-monospace" style="font-size:.8rem;cursor:default" title="@("{{" + v + "}}")">
                                @("{{" + v + "}}")
                            </span>
                        }
                        <span class="badge bg-body-secondary text-body font-monospace" style="font-size:.8rem;cursor:default" title="{{CompanyName}}">
                            @("{{CompanyName}}")
                        </span>
                        @if (branding is not null && !string.IsNullOrEmpty(branding.LogoPath))
                        {
                            <span class="badge bg-body-secondary text-body font-monospace" style="font-size:.8rem;cursor:default" title="{{Logo}}">
                                @("{{Logo}}")
                            </span>
                        }
                    </div>
                    <div class="form-text">Te zmienne możesz użyć w temacie, tytule, treści i stopce.</div>
                </div>

                @* ── Advanced: HTML ── *@
                <div class="mt-4">
                    <button class="btn btn-sm @(showHtml ? "btn-outline-secondary" : "btn-outline-secondary")" @onclick="() => showHtml = !showHtml">
                        <i class="bi @(showHtml ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                        Zaawansowane — Kod HTML
                    </button>
                    @if (showHtml)
                    {
                        <div class="mt-2">
                            <textarea class="form-control font-monospace" rows="14" @bind="editHtmlBody" @bind:event="oninput" style="font-size:.82rem;tab-size:2"></textarea>
                            <div class="form-text">Treść emaila w formacie HTML. Zmienne <code>@("{{...}}")</code> są zamieniane automatycznie.</div>
                        </div>
                    }
                </div>

                @* ── Preview ── *@
                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0"><i class="bi bi-eye me-1"></i>Podgląd</h6>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshPreview">
                        <i class="bi bi-arrow-clockwise me-1"></i>Odśwież
                    </button>
                </div>

                <div class="border rounded p-3" style="background:#f9fafb">
                    <div class="mb-2">
                        <small class="text-muted">Temat: </small>
                        <strong style="font-size:.9rem">@previewSubject</strong>
                    </div>
                    <div style="overflow-x:auto">
                        @((MarkupString)previewHtml)
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<EmailTemplateDto>? templates;
    private EmailTemplateDto? selected;
    private AppBrandingDto? branding;

    private string editSubject = "";
    private string editHeaderTitle = "";
    private string editHtmlBody = "";
    private string editAccentColor = "#0284C7";
    private string editFooterText = "";

    private string previewSubject = "";
    private string previewHtml = "";

    private bool busy;
    private string statusMsg = "";
    private bool statusOk;
    private bool showHelp;
    private bool showHtml;

    protected override async Task OnInitializedAsync()
    {
        templates = await TemplateService.GetAllAsync();
        branding = await BrandingService.GetAsync();
    }

    private void Select(EmailTemplateDto t)
    {
        selected = t;
        editSubject = t.Subject;
        editHeaderTitle = t.HeaderTitle;
        editHtmlBody = t.HtmlBody;
        editAccentColor = t.AccentColor;
        editFooterText = t.FooterText;
        statusMsg = "";
        RefreshPreview();
    }

    private void UseThemeColor()
    {
        if (branding is null) return;
        editAccentColor = ThemeColor(branding.ThemeName);
    }

    private async Task SaveTemplate()
    {
        if (selected is null) return;
        busy = true;
        statusMsg = "";
        try
        {
            var dto = new EmailTemplateDto
            {
                Subject = editSubject,
                HeaderTitle = editHeaderTitle,
                HtmlBody = editHtmlBody,
                AccentColor = editAccentColor,
                FooterText = editFooterText
            };
            await TemplateService.SaveAsync(selected.Key, dto);

            templates = await TemplateService.GetAllAsync();
            selected = templates.First(t => t.Key == selected.Key);
            Select(selected);
            statusMsg = "Szablon zapisany pomyślnie.";
            statusOk = true;
        }
        catch (Exception ex)
        {
            statusMsg = $"Błąd: {ex.Message}";
            statusOk = false;
        }
        finally { busy = false; }
    }

    private async Task ResetTemplate()
    {
        if (selected is null) return;
        busy = true;
        statusMsg = "";
        try
        {
            await TemplateService.ResetAsync(selected.Key);
            templates = await TemplateService.GetAllAsync();
            selected = templates.First(t => t.Key == selected.Key);
            Select(selected);
            statusMsg = "Przywrócono domyślny szablon.";
            statusOk = true;
        }
        catch (Exception ex)
        {
            statusMsg = $"Błąd: {ex.Message}";
            statusOk = false;
        }
        finally { busy = false; }
    }

    private void RefreshPreview()
    {
        if (selected is null) return;
        var sampleVars = BuildSampleVars(selected);
        previewSubject = ReplacePlaceholders(editSubject, sampleVars);
        var body = ReplacePlaceholders(editHtmlBody, sampleVars);
        var footer = ReplacePlaceholders(editFooterText, sampleVars);

        string? logoHtml = null;
        if (branding is not null && !string.IsNullOrEmpty(branding.LogoPath))
        {
            logoHtml = $"""<img src="{branding.LogoPath}" alt="{branding?.CompanyName ?? "Logo"}" style="max-height:48px;max-width:180px;display:block;margin:0 auto 12px" />""";
        }

        previewHtml = WrapInLayout(
            ReplacePlaceholders(editHeaderTitle, sampleVars),
            body, footer, editAccentColor, logoHtml);
    }

    private static string ReplacePlaceholders(string text, Dictionary<string, string> vars)
    {
        foreach (var (k, v) in vars)
            text = text.Replace($"{{{{{k}}}}}", v);
        return text;
    }

    private static string WrapInLayout(string headerTitle, string body, string footer, string accent, string? logoHtml = null) =>
        $"""
        <div style="font-family:Arial,sans-serif;max-width:560px;margin:0 auto;padding:32px 24px">
          <div style="background:{accent};border-radius:8px 8px 0 0;padding:24px;text-align:center">
            {(logoHtml ?? "")}
            <h2 style="color:white;margin:0;font-size:20px">{headerTitle}</h2>
          </div>
          <div style="border:1px solid #e5e7eb;border-top:none;border-radius:0 0 8px 8px;padding:24px">
            {body}
            <p style="color:#9ca3af;font-size:12px;margin-top:24px;padding-top:16px;border-top:1px solid #f3f4f6;text-align:center">
              {footer}
            </p>
          </div>
        </div>
        """;

    private static Dictionary<string, string> BuildSampleVars(EmailTemplateDto t) => new()
    {
        ["ClientName"] = "Jan Kowalski",
        ["TrainerName"] = "Anna Nowak",
        ["SessionType"] = "Trening personalny",
        ["SessionDate"] = "poniedziałek, 14 lipca 2025",
        ["SessionTime"] = "10:00",
        ["Duration"] = "60",
        ["Reason"] = "Choroba trenera",
        ["ReasonRow"] = "<tr><td style=\"padding:8px 0;color:#6b7280;font-size:14px\">Powód</td><td style=\"padding:8px 0;font-size:14px\">Choroba trenera</td></tr>",
        ["OldDate"] = "12.07.2025",
        ["OldTime"] = "10:00",
        ["NewDate"] = "poniedziałek, 14 lipca 2025",
        ["NewTime"] = "11:00",
        ["PackageName"] = "Pakiet Premium 10x",
        ["TotalSessions"] = "10",
        ["ExpiresAt"] = "31.12.2025",
        ["ExpiresRow"] = "<tr><td style=\"padding:8px 0;color:#6b7280;font-size:14px\">Ważny do</td><td style=\"padding:8px 0;font-size:14px;font-weight:600\">31.12.2025</td></tr>",
        ["Price"] = "<strong>150,00 zł</strong>",
        ["SetPasswordLink"] = "#",
        ["AccentColor"] = t.AccentColor,
        ["UserName"] = "Jan Kowalski",
        ["ResetLink"] = "#",
        ["ResetCode"] = "847291",
        ["ConfirmLink"] = "#",
        ["CompanyName"] = "PTScheduler",
        ["ClientEmail"] = "jan@kowalski.pl",
        ["ClientPhone"] = "+48 123 456 789",
        ["PhoneRow"] = "<p style=\"margin:6px 0\"><strong>Telefon:</strong> +48 123 456 789</p>",
        ["TrainingGoal"] = "Redukcja masy ciała",
        ["GoalRow"] = "<p style=\"margin:10px 0 0;padding-top:8px;border-top:1px solid #e5e7eb\"><strong>Cel treningowy:</strong><br/>Redukcja masy ciała</p>",
        ["Amount"] = "1 500,00",
        ["RemainingCredits"] = "3"
    };

    private static string ThemeColor(string theme) => theme switch
    {
        "forest"   => "#16A34A", "sunset"  => "#EA580C", "crimson" => "#DC2626",
        "lavender" => "#9333EA", "slate"   => "#475569", "rose"    => "#E11D48",
        "teal"     => "#0D9488", "amber"   => "#D97706", "indigo"  => "#4F46E5",
        _          => "#0284C7"
    };
}
