@page "/admin/coupons"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@inject ICouponService CouponService
@inject EntitlementService Entitlements
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Kupony rabatowe" />

<div class="page-header d-flex justify-content-between align-items-center">
    <h4 class="page-title"><i class="bi bi-tag-fill me-2" style="color:var(--c-primary)"></i>Kupony rabatowe</h4>
    @if (Entitlements.IsAllowed("Coupons"))
    {
        <button class="btn btn-primary" @onclick="NewCoupon"><i class="bi bi-plus-lg me-1"></i>Nowy kupon</button>
    }
</div>

@if (!Entitlements.IsAllowed("Coupons"))
{
    <FeatureGate Flag="Coupons" RequiredPlan="Pro"
                 Title="Kupony rabatowe są dostępne w planie Pro">
        <Description>
            Twórz kody rabatowe (% lub kwotowe), z limitami użyć i datą wygaśnięcia. Kod działa na pakiety i kursy. Odblokuj w planie <strong>Pro</strong> lub <strong>Studio</strong>.
        </Description>
    </FeatureGate>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_msgError ? "alert-danger" : "alert-success") alert-dismissible py-2 small">
            @_message
            <button type="button" class="btn-close btn-close-sm" @onclick="() => _message = null"></button>
        </div>
    }

    @if (_editing is not null)
    {
        <div class="card mb-4">
            <div class="card-header">@(_editingId is null ? "Nowy kupon" : "Edycja kuponu")</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Kod</label>
                        <input class="form-control font-monospace" @bind="_editing.Code" maxlength="40" placeholder="LATO20" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Typ rabatu</label>
                        <select class="form-select" @bind="_editing.DiscountType">
                            <option value="percent">Procent (%)</option>
                            <option value="amount">Kwota (zł)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Wartość</label>
                        <input type="number" step="0.01" class="form-control" @bind="_editing.DiscountValue" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Zakres</label>
                        <select class="form-select" @bind="_editing.Scope">
                            <option value="all">Wszystko</option>
                            <option value="package">Tylko pakiety</option>
                            <option value="course">Tylko kursy</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Ważny od</label>
                        <input type="datetime-local" class="form-control" @bind="_editing.ValidFrom" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Ważny do</label>
                        <input type="datetime-local" class="form-control" @bind="_editing.ValidUntil" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Max użyć (0 = brak limitu)</label>
                        <input type="number" min="0" class="form-control" @bind="_editing.MaxUses" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="_editing.IsActive" id="ca" />
                            <label class="form-check-label small" for="ca">Aktywny</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Opis (widoczny tylko dla admina)</label>
                        <input class="form-control" @bind="_editing.Description" maxlength="200" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="Save"><i class="bi bi-save me-1"></i>Zapisz</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _editing = null">Anuluj</button>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            @if (_coupons.Count == 0)
            {
                <p class="text-muted small p-3 mb-0">Brak kuponów. Kliknij „Nowy kupon".</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 small align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Kod</th>
                                <th>Rabat</th>
                                <th>Zakres</th>
                                <th>Ważny</th>
                                <th>Użycia</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _coupons)
                            {
                                <tr>
                                    <td class="fw-semibold font-monospace">@c.Code</td>
                                    <td>
                                        @if (c.DiscountType == "percent") { <span>@c.DiscountValue %</span> }
                                        else { <span>@c.DiscountValue.ToString("0.00") zł</span> }
                                    </td>
                                    <td>@ScopeLabel(c.Scope)</td>
                                    <td class="text-muted small">
                                        @(c.ValidFrom?.ToString("dd.MM.yyyy") ?? "—") →
                                        @(c.ValidUntil?.ToString("dd.MM.yyyy") ?? "∞")
                                    </td>
                                    <td>@c.UsedCount / @(c.MaxUses == 0 ? "∞" : c.MaxUses.ToString())</td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge bg-success">Aktywny</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Wyłączony</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(c)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(c.Id)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<CouponDto> _coupons = new();
    private SaveCouponDto? _editing;
    private int? _editingId;
    private string? _message;
    private bool _msgError;

    protected override async Task OnInitializedAsync()
    {
        if (Entitlements.IsAllowed("Coupons")) await Load();
    }

    private async Task Load() => _coupons = await CouponService.GetAllAsync();

    private void NewCoupon()
    {
        _editing = new SaveCouponDto { DiscountType = "percent", DiscountValue = 10, Scope = "all", IsActive = true };
        _editingId = null;
    }

    private async Task Edit(CouponDto c)
    {
        var full = await CouponService.GetAsync(c.Id);
        if (full is null) return;
        _editing = new SaveCouponDto
        {
            Code = full.Code, Description = full.Description,
            DiscountType = full.DiscountType, DiscountValue = full.DiscountValue,
            ValidFrom = full.ValidFrom, ValidUntil = full.ValidUntil,
            MaxUses = full.MaxUses, Scope = full.Scope, IsActive = full.IsActive
        };
        _editingId = c.Id;
    }

    private async Task Save()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Code)) { _message = "Kod jest wymagany."; _msgError = true; return; }
        try
        {
            if (_editingId is null) await CouponService.CreateAsync(_editing);
            else await CouponService.UpdateAsync(_editingId.Value, _editing);
            _editing = null; _editingId = null;
            await Load();
            _message = "Zapisano."; _msgError = false;
        }
        catch (Exception ex) { _message = ex.Message; _msgError = true; }
    }

    private async Task Delete(int id)
    {
        try
        {
            await CouponService.DeleteAsync(id);
            await Load();
            _message = "Usunięto."; _msgError = false;
        }
        catch (Exception ex) { _message = ex.Message; _msgError = true; }
    }

    private static string ScopeLabel(string s) => s switch
    {
        "package" => "Pakiety",
        "course" => "Kursy",
        _ => "Wszystko"
    };
}
