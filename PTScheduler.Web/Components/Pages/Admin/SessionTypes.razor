@page "/admin/session-types"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = PTScheduler.Domain.Constants.Roles.Admin)]
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@inject ISessionTypeService TypeService
@inject PTScheduler.Web.Services.ToastService Toast
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Typy sesji" />

<div class="page-header">
    <h4 class="page-title"><i class="bi bi-clock-fill me-2" style="color:var(--c-primary)"></i>Typy sesji</h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenAdd">
        <i class="bi bi-plus-lg me-1"></i>Dodaj typ
    </button>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            @if (!_types.Any())
            {
                <div class="text-center text-muted py-5 small">
                    <i class="bi bi-clock d-block fs-2 mb-2"></i>Brak typów sesji.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-stack table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nazwa</th>
                                <th class="text-center">Czas (min)</th>
                                <th class="text-center">Grupowa</th>
                                <th class="text-center">Maks. osób</th>
                                <th class="text-center">Sesji</th>
                                <th class="text-center">Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _types)
                            {
                                <tr class="@(!t.IsActive ? "opacity-50" : "")">
                                    <td class="fw-semibold">
                                        @t.Name @if (t.IsPair) { <span class="pair-chip ms-1"><i class="bi bi-people-fill"></i>W parze</span> }
                                        @if (t.RequiresPackage) { <span class="badge bg-light text-body border ms-1">tylko z pakietem</span> }
                                        else if (t.SinglePrice is { } sp) { <span class="badge bg-success-subtle text-success ms-1">pojedynczo @sp.ToString("0.##") zł</span> }
                                    </td>
                                    <td class="text-center">@t.DurationMinutes</td>
                                    <td class="text-center">
                                        @if (t.IsGroup)
                                        {
                                            <span class="badge bg-info text-dark">Tak</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center text-muted small">@(t.MaxParticipants?.ToString() ?? "—")</td>
                                    <td class="text-center text-muted small">@t.SessionCount</td>
                                    <td class="text-center">
                                        @if (t.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Aktywny</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Nieaktywny</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEdit(t)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (t.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" title="Dezaktywuj"
                                                    @onclick="() => ToggleActive(t, false)">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="Aktywuj"
                                                    @onclick="() => ToggleActive(t, true)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="alert alert-info mt-3 small">
        <i class="bi bi-info-circle me-1"></i>
        Dezaktywowane typy sesji nie są widoczne przy rezerwacjach, ale zachowują historię.
    </div>
}

@if (_modalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-clock me-2 text-primary"></i>
                        @(_editId is null ? "Nowy typ sesji" : "Edytuj typ sesji")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger py-2 small">@_error</div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Nazwa <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_form.Name" placeholder="np. 60 min – Personal Training" maxlength="80" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Czas trwania (min) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" min="5" max="480" @bind="_form.DurationMinutes" />
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2 pt-4">
                            <input type="checkbox" class="form-check-input" id="isGroup" @bind="_form.IsGroup" @bind:after="() => { if (_form.IsGroup) _form.IsPair = false; }" />
                            <label class="form-check-label" for="isGroup">Sesja grupowa</label>
                        </div>
                        <div class="col-12 d-flex align-items-center gap-2">
                            <input type="checkbox" class="form-check-input" id="isPair" @bind="_form.IsPair" @bind:after="() => { if (_form.IsPair) _form.IsGroup = false; }" />
                            <label class="form-check-label" for="isPair">Trening w parze (2 osoby)</label>
                            <InfoTip Title="Trening w parze" Text="Przy rezerwacji tego rodzaju treningu aplikacja od razu pyta o partnera. Każda osoba dostaje własną wizytę i przypomnienie. Dodaj też pakiet „dla pary” w Ofercie pakietów — wtedy za wspólny trening schodzi 1." />
                        </div>
                        @if (_form.IsGroup)
                        {
                            <div class="col-12">
                                <label class="form-label">Maks. uczestników</label>
                                <input type="number" class="form-control" min="2" max="100"
                                       value="@(_form.MaxParticipants?.ToString() ?? "")"
                                       @onchange="e => _form.MaxParticipants = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value!.ToString()!)" />
                            </div>
                        }
                        <div class="col-12 col-sm-6">
                            <label class="form-label">Cena pojedynczego treningu <span class="text-muted small">(opcjonalnie)</span>
                                <InfoTip Title="Pojedynczy trening online" Text="Klient bez pakietu może zapłacić za ten jeden trening online przy rezerwacji (BLIK, karta). Zostaw puste, jeśli sprzedajesz ten trening tylko w pakietach albo rozliczasz się u siebie." />
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control" min="0" step="1" placeholder="np. 150"
                                       value="@(_form.SinglePrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                       @onchange="e => _form.SinglePrice = decimal.TryParse(e.Value?.ToString()?.Replace(',', '.'), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0 ? v : null" />
                                <span class="input-group-text">zł</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 form-check form-switch d-flex align-items-center gap-2 ps-5 pt-sm-4">
                            <input type="checkbox" class="form-check-input" id="reqPkg" @bind="_form.RequiresPackage" />
                            <label class="form-check-label" for="reqPkg">Tylko z pakietem</label>
                            <InfoTip Title="Tylko z pakietem" Text="Bez pakietu klient nie zarezerwuje tego treningu — zobaczy tylko „Kup pakiet”. Przydaje się np. przy zajęciach z karnetem." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModal">Anuluj</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Zapisz
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SessionTypeDto> _types = [];
    private bool _loading = true;
    private bool _modalOpen;
    private bool _busy;
    private string _error = string.Empty;
    private int? _editId;
    private CreateSessionTypeDto _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try { _types = await TypeService.GetAllAsync(includeInactive: true); }
        finally { _loading = false; }
    }

    private void OpenAdd()
    {
        _editId = null;
        _form = new CreateSessionTypeDto();
        _error = string.Empty;
        _modalOpen = true;
    }

    private void OpenEdit(SessionTypeDto t)
    {
        _editId = t.Id;
        _form = new CreateSessionTypeDto
        {
            Name = t.Name,
            DurationMinutes = t.DurationMinutes,
            IsGroup = t.IsGroup,
            IsPair = t.IsPair,
            MaxParticipants = t.MaxParticipants,
            SinglePrice = t.SinglePrice,
            RequiresPackage = t.RequiresPackage
        };
        _error = string.Empty;
        _modalOpen = true;
    }

    private void CloseModal() => _modalOpen = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) { _error = "Nazwa jest wymagana."; return; }
        if (_form.DurationMinutes < 5) { _error = "Czas musi wynosić co najmniej 5 minut."; return; }
        _busy = true; _error = string.Empty;
        try
        {
            if (_editId is null) await TypeService.CreateAsync(_form);
            else await TypeService.UpdateAsync(_editId.Value, _form);
            _modalOpen = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleActive(SessionTypeDto t, bool active)
    {
        try
        {
            await TypeService.SetActiveAsync(t.Id, active);
            await LoadAsync();
        }
        catch
        {
            Toast.Error("Nie udało się zmienić statusu typu sesji.");
        }
    }
}
