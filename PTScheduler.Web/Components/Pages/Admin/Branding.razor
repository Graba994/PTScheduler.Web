@page "/admin/branding"
@using Microsoft.AspNetCore.Components.Forms
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]
@inject IBrandingService BrandingService
@inject NavigationManager Nav
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<AppTitle Page="Wygląd aplikacji" />

<div class="page-header">
    <h4 class="page-title"><i class="bi bi-palette-fill me-2" style="color:var(--c-primary)"></i>Wygląd aplikacji</h4>
</div>

@if (_branding is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-4">

        <!-- Theme picker -->
        <div class="col-12 col-lg-7">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-palette me-2"></i>Motyw kolorystyczny</div>
                <div class="card-body">
                    <p class="text-muted small mb-2 fw-semibold">Akcent kolorystyczny</p>
                    <div class="theme-grid">
                        @foreach (var t in _themes)
                        {
                            <button type="button"
                                    class="theme-swatch @(_branding.ThemeName == t.Key ? "selected" : "")"
                                    @onclick="@(() => SelectTheme(t.Key))">
                                <div class="theme-dot" style="background:linear-gradient(135deg,@t.Value.Primary,@t.Value.Secondary)"></div>
                                <span>@t.Value.Label</span>
                            </button>
                        }
                    </div>
                    <p class="text-muted small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Tryb jasny / ciemny każdy użytkownik wybiera samodzielnie z menu w lewym dolnym rogu.
                    </p>
                </div>
            </div>
        </div>

        <!-- Company name + logo + favicon -->
        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-building me-2"></i>Identyfikacja</div>
                <div class="card-body d-flex flex-column gap-3">

                    <!-- Company name -->
                    <div>
                        <label class="form-label">Nazwa firmy / trenera</label>
                        <input class="form-control" @bind="_branding.CompanyName" placeholder="np. Jan Kowalski PT" maxlength="60" />
                        <div class="form-text">Wyświetlana w sidebarze i tytule strony.</div>
                    </div>

                    <!-- Logo -->
                    <div>
                        <label class="form-label">Logo <span class="text-muted fw-normal">(PNG, SVG, JPG — maks. 2 MB)</span></label>
                        @if (!string.IsNullOrEmpty(_logoPath))
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <img src="@_logoPath" alt="Logo"
                                     style="height:40px;max-width:140px;object-fit:contain;border-radius:4px;border:1px solid #E5E7EB;padding:4px" />
                                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteLogo">
                                    <i class="bi bi-trash me-1"></i>Usuń
                                </button>
                            </div>
                        }
                        <label class="upload-zone d-block" for="logoFile">
                            <i class="bi bi-upload fs-4 text-muted d-block mb-1"></i>
                            <span class="text-muted small">Kliknij aby wybrać plik</span>
                        </label>
                        <InputFile id="logoFile" style="display:none" accept="image/png,image/jpeg,image/svg+xml,image/webp"
                                   OnChange="UploadLogo" />
                    </div>

                    <!-- Favicon -->
                    <div>
                        <label class="form-label">Favicon <span class="text-muted fw-normal">(PNG, ICO — maks. 512 KB)</span></label>
                        @if (!string.IsNullOrEmpty(_faviconPath))
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <img src="@_faviconPath" alt="Favicon"
                                     style="height:32px;width:32px;object-fit:contain;border-radius:4px;border:1px solid #E5E7EB;padding:2px" />
                                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteFavicon">
                                    <i class="bi bi-trash me-1"></i>Usuń
                                </button>
                            </div>
                        }
                        <label class="upload-zone d-block" for="faviconFile">
                            <i class="bi bi-image fs-4 text-muted d-block mb-1"></i>
                            <span class="text-muted small">Kliknij aby wybrać plik</span>
                        </label>
                        <InputFile id="faviconFile" style="display:none" accept="image/png,image/x-icon,image/svg+xml"
                                   OnChange="UploadFavicon" />
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Save bar -->
    <div class="mt-4 d-flex align-items-center gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            Zapisz ustawienia
        </button>
        @if (!string.IsNullOrEmpty(_message))
        {
            <span class="text-success small"><i class="bi bi-check-circle me-1"></i>@_message</span>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>@_error</span>
        }
    </div>

    <div class="alert alert-info mt-3 small">
        <i class="bi bi-info-circle me-1"></i>
        Po zapisaniu strona odświeży się automatycznie i zastosuje zmiany.
    </div>
}

@code {
    private SaveBrandingDto? _branding;
    private string? _logoPath;
    private string? _faviconPath;
    private bool _saving;
    private string _message = string.Empty;
    private string _error   = string.Empty;

    private record ThemeInfo(string Label, string Primary, string Secondary);

    private readonly Dictionary<string, ThemeInfo> _themes = new()
    {
        ["ocean"]    = new("Ocean",    "#0284C7", "#06B6D4"),
        ["forest"]   = new("Forest",   "#16A34A", "#10B981"),
        ["sunset"]   = new("Sunset",   "#EA580C", "#FBBF24"),
        ["crimson"]  = new("Crimson",  "#DC2626", "#F97316"),
        ["lavender"] = new("Lavender", "#9333EA", "#EC4899"),
        ["slate"]    = new("Slate",    "#475569", "#64748B"),
        ["rose"]     = new("Rose",     "#E11D48", "#F43F5E"),
        ["teal"]     = new("Teal",     "#0D9488", "#06B6D4"),
        ["amber"]    = new("Amber",    "#D97706", "#F59E0B"),
        ["indigo"]   = new("Indigo",   "#4F46E5", "#7C3AED"),
    };

    protected override async Task OnInitializedAsync()
    {
        var dto = await BrandingService.GetAsync();
        _branding = new SaveBrandingDto
        {
            ThemeName   = dto.ThemeName,
            ThemeMode   = "light", // tryb jasny/ciemny dobierany per-użytkownik z menu
            CompanyName = dto.CompanyName,
        };
        _logoPath    = dto.LogoPath;
        _faviconPath = dto.FaviconPath;
    }

    private void SelectTheme(string key)
    {
        if (_branding is null) return;
        _branding.ThemeName = key;
    }

    private async Task Save()
    {
        if (_branding is null) return;
        _saving = true;
        _message = _error = string.Empty;
        try
        {
            await BrandingService.SaveAsync(_branding);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Błąd: {ex.Message}";
        }
        finally { _saving = false; }
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        if (_branding is null) return;
        _error = string.Empty;
        try
        {
            await using var stream = e.File.OpenReadStream(2 * 1024 * 1024);
            await BrandingService.UploadLogoAsync(stream, e.File.Name);
            await BrandingService.SaveAsync(_branding);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex) { _error = $"Błąd logo: {ex.Message}"; }
    }

    private async Task UploadFavicon(InputFileChangeEventArgs e)
    {
        if (_branding is null) return;
        _error = string.Empty;
        try
        {
            await using var stream = e.File.OpenReadStream(512 * 1024);
            await BrandingService.UploadFaviconAsync(stream, e.File.Name);
            await BrandingService.SaveAsync(_branding);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex) { _error = $"Błąd favicon: {ex.Message}"; }
    }

    private async Task DeleteLogo()
    {
        await BrandingService.DeleteLogoAsync();
        _logoPath = null;
    }

    private async Task DeleteFavicon()
    {
        await BrandingService.DeleteFaviconAsync();
        _faviconPath = null;
    }
}

