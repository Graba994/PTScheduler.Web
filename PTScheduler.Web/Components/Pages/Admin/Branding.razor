@page "/admin/branding"
@using Microsoft.AspNetCore.Components.Forms
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]
@inject IBrandingService BrandingService
@inject NavigationManager Nav
@inject EntitlementService Entitlements
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Wygląd aplikacji" />

<div class="page-header">
    <h4 class="page-title"><i class="bi bi-palette-fill me-2" style="color:var(--c-primary)"></i>Wygląd aplikacji</h4>
</div>

@if (_branding is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-4">

        <!-- Theme picker -->
        <div class="col-12 col-lg-7">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-palette me-2"></i>Motyw kolorystyczny</div>
                <div class="card-body">
                    @if (_brandingTier == "preview")
                    {
                        <div class="position-relative">
                            <div class="branding-preview-overlay">
                                <div class="branding-preview-badge">
                                    <i class="bi bi-lock-fill me-1"></i>Podgląd
                                </div>
                                <p class="small mb-2 fw-semibold">Zmiana wyglądu dostępna w płatnych planach</p>
                                <p class="small text-muted mb-0">Wybierz plan Starter lub wyższy, aby zmienić kolorystykę aplikacji.</p>
                            </div>
                            <div style="filter:blur(1px);opacity:0.5;pointer-events:none">
                                <p class="text-muted small mb-2 fw-semibold">Akcent kolorystyczny</p>
                                <div class="theme-grid">
                                    @foreach (var t in _themes)
                                    {
                                        <button type="button" class="theme-swatch" disabled>
                                            <div class="theme-dot" style="background:linear-gradient(135deg,@t.Value.Primary,@t.Value.Secondary)"></div>
                                            <span>@t.Value.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-2 fw-semibold">Akcent kolorystyczny</p>
                        <div class="theme-grid">
                            @foreach (var t in _themes)
                            {
                                var isLocked = !IsThemeAvailable(t.Key);
                                <button type="button"
                                        class="theme-swatch @(_branding.ThemeName == t.Key ? "selected" : "") @(isLocked ? "theme-locked" : "")"
                                        @onclick="@(() => { if (!isLocked) SelectTheme(t.Key); })"
                                        disabled="@isLocked">
                                    <div class="theme-dot" style="background:linear-gradient(135deg,@t.Value.Primary,@t.Value.Secondary)">
                                        @if (isLocked)
                                        {
                                            <i class="bi bi-lock-fill" style="color:#fff;font-size:12px"></i>
                                        }
                                    </div>
                                    <span>@t.Value.Label</span>
                                    @if (t.Value.Tier == "premium")
                                    {
                                        <span class="theme-tier-badge">Premium</span>
                                    }
                                </button>
                            }
                        </div>
                        @if (_brandingTier == "basic")
                        {
                            <p class="text-muted small mt-3 mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Twój plan zawiera podstawowe kolory. Przejdź na plan Pro, aby odblokować wszystkie motywy.
                            </p>
                        }
                        else
                        {
                            <p class="text-muted small mt-3 mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Tryb jasny / ciemny każdy użytkownik wybiera samodzielnie z menu w lewym dolnym rogu.
                            </p>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Company name + logo + favicon -->
        <div class="col-12 col-lg-5">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-building me-2"></i>Identyfikacja</div>
                <div class="card-body d-flex flex-column gap-3">

                    <!-- Company name -->
                    <div>
                        <label class="form-label">Nazwa firmy / trenera</label>
                        <input class="form-control" @bind="_branding.CompanyName" placeholder="np. Jan Kowalski PT" maxlength="60" />
                        <div class="form-text">Wyświetlana w sidebarze i tytule strony.</div>
                    </div>

                    <!-- Logo -->
                    <div>
                        <label class="form-label">Logo <span class="text-muted fw-normal">(PNG, SVG, JPG — maks. 2 MB)</span></label>
                        @if (Entitlements.IsAllowed("CustomLogo"))
                        {
                            @if (!string.IsNullOrEmpty(_logoPath))
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <img src="@_logoPath" alt="Logo"
                                         style="height:40px;max-width:140px;object-fit:contain;border-radius:4px;border:1px solid #E5E7EB;padding:4px" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteLogo">
                                        <i class="bi bi-trash me-1"></i>Usuń
                                    </button>
                                </div>
                            }
                            <label class="upload-zone d-block" for="logoFile">
                                <i class="bi bi-upload fs-4 text-muted d-block mb-1"></i>
                                <span class="text-muted small">Kliknij aby wybrać plik</span>
                            </label>
                            <InputFile id="logoFile" style="display:none" accept="image/png,image/jpeg,image/svg+xml,image/webp"
                                       OnChange="UploadLogo" />
                        }
                        else
                        {
                            <FeatureGate Flag="CustomLogo" RequiredPlan="Starter" ShowLock="true"
                                         Title="Własne logo dostępne od planu Starter" />
                        }
                    </div>

                    <!-- Favicon -->
                    <div>
                        <label class="form-label">Favicon <span class="text-muted fw-normal">(PNG, ICO — maks. 512 KB)</span></label>
                        @if (Entitlements.IsAllowed("CustomFavicon"))
                        {
                            @if (!string.IsNullOrEmpty(_faviconPath))
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <img src="@_faviconPath" alt="Favicon"
                                         style="height:32px;width:32px;object-fit:contain;border-radius:4px;border:1px solid #E5E7EB;padding:2px" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteFavicon">
                                        <i class="bi bi-trash me-1"></i>Usuń
                                    </button>
                                </div>
                            }
                            <label class="upload-zone d-block" for="faviconFile">
                                <i class="bi bi-image fs-4 text-muted d-block mb-1"></i>
                                <span class="text-muted small">Kliknij aby wybrać plik</span>
                            </label>
                            <InputFile id="faviconFile" style="display:none" accept="image/png,image/x-icon,image/svg+xml"
                                       OnChange="UploadFavicon" />
                        }
                        else
                        {
                            <FeatureGate Flag="CustomFavicon" RequiredPlan="Starter" ShowLock="true"
                                         Title="Własny favicon dostępny od planu Starter" />
                        }
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- PWA Install Banner configurator -->
    <div class="row g-4 mt-0">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-phone-fill me-2"></i>Baner instalacji PWA</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="pwaEnabled"
                               checked="@_branding!.PwaBannerEnabled"
                               @onchange="e => _branding.PwaBannerEnabled = (bool)e.Value!" />
                        <label class="form-check-label small" for="pwaEnabled">
                            @(_branding!.PwaBannerEnabled ? "Włączony" : "Wyłączony")
                        </label>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Baner pojawia się automatycznie na urządzeniach mobilnych gdy aplikacja może zostać zainstalowana
                        jako PWA. Na iOS pokazuje instrukcję — <em>Udostępnij → Dodaj do ekranu głównego</em>.
                    </p>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Krótka nazwa (do 16 znaków)</label>
                            <input class="form-control" @bind="_branding.PwaShortName" maxlength="16"
                                   placeholder="@(_branding.CompanyName.Length <= 16 ? _branding.CompanyName : _branding.CompanyName[..12] + "…")" />
                            <div class="form-text">Widoczna pod ikoną na ekranie głównym urządzenia.</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Tekst przycisku</label>
                            <input class="form-control" @bind="_branding.PwaBannerButton" maxlength="24"
                                   placeholder="Zainstaluj" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Tytuł banera</label>
                            <input class="form-control" @bind="_branding.PwaBannerTitle" maxlength="60"
                                   placeholder="@($"Zainstaluj {_branding.CompanyName}")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Treść banera</label>
                            <textarea class="form-control" rows="2" @bind="_branding.PwaBannerBody" maxlength="160"
                                      placeholder="Dodaj do ekranu głównego — działa jak natywna, bez przeglądarki."></textarea>
                        </div>
                    </div>

                    <!-- PWA Icon upload -->
                    <div class="col-12 mt-2">
                        <label class="form-label">Ikona PWA <span class="text-muted fw-normal">(PNG, JPG, WebP — kwadrat, maks. 2 MB)</span></label>
                        @if (!string.IsNullOrEmpty(_pwaIconPath))
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <img src="@_pwaIconPath" alt="Ikona PWA"
                                     style="height:64px;width:64px;object-fit:cover;border-radius:12px;border:1px solid #E5E7EB" />
                                <div class="small text-muted">Twoja ikona · pojawi się na ekranie urządzenia i w banerze instalacji</div>
                                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="DeletePwaIcon">
                                    <i class="bi bi-trash me-1"></i>Usuń
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted mb-2">Brak — używana jest domyślna ikona PTScheduler</div>
                        }
                        <label class="upload-zone d-block" for="pwaIconFile">
                            <i class="bi bi-image fs-4 text-muted d-block mb-1"></i>
                            <span class="text-muted small">Kliknij aby wybrać plik (zalecane: 512×512 px)</span>
                        </label>
                        <InputFile id="pwaIconFile" style="display:none" accept="image/png,image/jpeg,image/webp"
                                   OnChange="UploadPwaIcon" />
                    </div>

                    <!-- Preview -->
                    @if (_branding.PwaBannerEnabled)
                    {
                        <div class="mt-4">
                            <p class="text-muted small fw-semibold mb-2">Podgląd banera</p>
                            <div class="pwa-banner position-relative" style="position:static!important;transform:none!important;box-shadow:0 2px 12px rgba(0,0,0,.1);max-width:420px">
                                <img class="pwa-banner-icon" src="@(_pwaIconPath ?? "/icons/icon-96.png")" alt="" width="48" height="48" />
                                <div class="pwa-banner-text">
                                    <div class="pwa-banner-title">
                                        @(string.IsNullOrWhiteSpace(_branding.PwaBannerTitle)
                                            ? $"Zainstaluj {_branding.CompanyName}"
                                            : _branding.PwaBannerTitle)
                                    </div>
                                    <div class="pwa-banner-body">
                                        @(string.IsNullOrWhiteSpace(_branding.PwaBannerBody)
                                            ? "Dodaj do ekranu głównego — działa jak natywna, bez przeglądarki."
                                            : _branding.PwaBannerBody)
                                    </div>
                                </div>
                                <div class="pwa-banner-actions">
                                    <button class="btn btn-primary btn-sm">
                                        @(string.IsNullOrWhiteSpace(_branding.PwaBannerButton) ? "Zainstaluj" : _branding.PwaBannerButton)
                                    </button>
                                    <button class="btn btn-link btn-sm pwa-banner-close" disabled>
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Save bar -->
    <div class="mt-4 d-flex align-items-center gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            Zapisz ustawienia
        </button>
        @if (!string.IsNullOrEmpty(_message))
        {
            <span class="text-success small"><i class="bi bi-check-circle me-1"></i>@_message</span>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>@_error</span>
        }
    </div>

    <div class="alert alert-info mt-3 small">
        <i class="bi bi-info-circle me-1"></i>
        Po zapisaniu strona odświeży się automatycznie i zastosuje zmiany.
    </div>
}

@code {
    private SaveBrandingDto? _branding;
    private string? _logoPath;
    private string? _faviconPath;
    private string? _pwaIconPath;
    private bool _saving;
    private string _message = string.Empty;
    private string _error   = string.Empty;

    private string _brandingTier = "preview";

    private record ThemeInfo(string Label, string Primary, string Secondary, string Tier = "basic");

    private readonly Dictionary<string, ThemeInfo> _themes = new()
    {
        ["ocean"]    = new("Ocean",    "#0284C7", "#06B6D4", "basic"),
        ["forest"]   = new("Forest",   "#16A34A", "#10B981", "basic"),
        ["slate"]    = new("Slate",    "#475569", "#64748B", "basic"),
        ["teal"]     = new("Teal",     "#0D9488", "#06B6D4", "basic"),
        ["sunset"]   = new("Sunset",   "#EA580C", "#FBBF24", "full"),
        ["crimson"]  = new("Crimson",  "#DC2626", "#F97316", "full"),
        ["lavender"] = new("Lavender", "#9333EA", "#EC4899", "full"),
        ["amber"]    = new("Amber",    "#D97706", "#F59E0B", "full"),
        ["indigo"]   = new("Indigo",   "#4F46E5", "#7C3AED", "full"),
        ["rose"]     = new("Rose",     "#E11D48", "#F43F5E", "premium"),
    };

    private bool IsThemeAvailable(string themeKey)
    {
        if (!_themes.TryGetValue(themeKey, out var info)) return false;
        return _brandingTier switch
        {
            "basic"   => info.Tier == "basic",
            "full"    => info.Tier is "basic" or "full",
            "premium" => true,
            _ => false
        };
    }

    protected override async Task OnInitializedAsync()
    {
        _brandingTier = Entitlements.Current.BrandingTier;

        var dto = await BrandingService.GetAsync();
        _branding = new SaveBrandingDto
        {
            ThemeName      = dto.ThemeName,
            ThemeMode      = "light",
            CompanyName    = dto.CompanyName,
            PwaShortName   = dto.PwaShortName,
            PwaBannerEnabled = dto.PwaBannerEnabled,
            PwaBannerTitle = dto.PwaBannerTitle,
            PwaBannerBody  = dto.PwaBannerBody,
            PwaBannerButton = dto.PwaBannerButton,
        };
        _logoPath    = dto.LogoPath;
        _faviconPath = dto.FaviconPath;
        _pwaIconPath = dto.PwaIconPath;
    }

    private void SelectTheme(string key)
    {
        if (_branding is null) return;
        _branding.ThemeName = key;
    }

    private async Task Save()
    {
        if (_branding is null) return;
        _saving = true;
        _message = _error = string.Empty;
        try
        {
            await BrandingService.SaveAsync(_branding);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            _error = $"Błąd: {ex.Message}";
        }
        finally { _saving = false; }
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        if (_branding is null) return;
        _error = string.Empty;
        try
        {
            await using var stream = e.File.OpenReadStream(2 * 1024 * 1024);
            await BrandingService.UploadLogoAsync(stream, e.File.Name);
            await BrandingService.SaveAsync(_branding);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex) { _error = $"Błąd logo: {ex.Message}"; }
    }

    private async Task UploadFavicon(InputFileChangeEventArgs e)
    {
        if (_branding is null) return;
        _error = string.Empty;
        try
        {
            await using var stream = e.File.OpenReadStream(512 * 1024);
            await BrandingService.UploadFaviconAsync(stream, e.File.Name);
            await BrandingService.SaveAsync(_branding);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex) { _error = $"Błąd favicon: {ex.Message}"; }
    }

    private async Task DeleteLogo()
    {
        await BrandingService.DeleteLogoAsync();
        _logoPath = null;
    }

    private async Task DeleteFavicon()
    {
        await BrandingService.DeleteFaviconAsync();
        _faviconPath = null;
    }

    private async Task UploadPwaIcon(InputFileChangeEventArgs e)
    {
        if (_branding is null) return;
        _error = string.Empty;
        try
        {
            await using var stream = e.File.OpenReadStream(2 * 1024 * 1024);
            _pwaIconPath = await BrandingService.UploadPwaIconAsync(stream, e.File.Name);
            await BrandingService.SaveAsync(_branding);
            StateHasChanged();
        }
        catch (Exception ex) { _error = $"Błąd ikony: {ex.Message}"; }
    }

    private async Task DeletePwaIcon()
    {
        await BrandingService.DeletePwaIconAsync();
        _pwaIconPath = null;
    }
}

<style>
    .branding-preview-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: rgba(255,255,255,0.85);
        border-radius: 8px;
        padding: 24px;
    }
    [data-theme$="-dark"] .branding-preview-overlay {
        background: rgba(15,23,42,0.85);
    }
    .branding-preview-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 16px;
        border-radius: 20px;
        background: var(--c-primary-light, #EEF2FF);
        color: var(--c-primary, #4F46E5);
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 12px;
    }
    .theme-swatch.theme-locked {
        opacity: 0.45;
        cursor: not-allowed;
    }
    .theme-swatch.theme-locked:hover {
        transform: none;
        border-color: #E5E7EB;
        background: transparent;
    }
    .theme-swatch .theme-dot {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .theme-tier-badge {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #9333EA;
        background: rgba(147,51,234,0.08);
        padding: 1px 6px;
        border-radius: 4px;
        margin-top: -2px;
    }
</style>

