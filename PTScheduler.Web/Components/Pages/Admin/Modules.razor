@page "/admin/modules"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]
@using PTScheduler.Domain.Enums
@implements IDisposable
@inject IModuleSettingsService ModuleSettings
@inject PTScheduler.Web.Services.ExerciseCatalogSync CatalogSync
@inject IAppClock Clock
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Moduły" />

<div class="page-header">
    <h4 class="page-title"><i class="bi bi-toggles me-2" style="color:var(--c-primary)"></i>Moduły</h4>
</div>

@if (_settings is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@_msg</div> }

    <p class="text-muted">Włączaj i wyłączaj moduły widoczne dla klientów. Wyłączony moduł znika z ich menu i strony głównej; zarządzanie w panelu admina pozostaje dostępne.</p>

    <div class="card" style="max-width:640px">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-3">
                <div>
                    <div class="fw-semibold"><i class="bi bi-mortarboard-fill me-2" style="color:var(--c-primary)"></i>Portal szkoleniowy (kursy)</div>
                    <div class="text-muted small">Kafelek „Moje kursy" u klienta i karta kursów na stronie głównej.</div>
                </div>
                <div class="form-check form-switch fs-5 m-0">
                    <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.CoursesEnabled" id="mCourses" />
                </div>
            </div>
            <hr />
            <div class="d-flex align-items-start justify-content-between gap-3">
                <div>
                    <div class="fw-semibold"><i class="bi bi-bell-fill me-2" style="color:var(--c-primary)"></i>Przypomnienia o pakietach</div>
                    <div class="text-muted small">
                        Klient dostaje e-mail i powiadomienie, gdy zostaną mu 1–2 wizyty w pakiecie albo pakiet wygasa w ciągu 7 dni —
                        z linkiem do zakupu kolejnego. Raz na pakiet; klient może to wyłączyć w swoich powiadomieniach.
                    </div>
                </div>
                <div class="form-check form-switch fs-5 m-0">
                    <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.PackageRemindersEnabled" id="mPkgReminders" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3" style="max-width:640px">
        <div class="card-body">
            <div class="fw-semibold"><i class="bi bi-collection-fill me-2" style="color:var(--c-primary)"></i>Baza ćwiczeń</div>
            <div class="text-muted small mb-3">Z tego katalogu trenerzy wybierają ćwiczenia do planów. Własne ćwiczenia trenerów są widoczne zawsze.</div>

            <div class="source-options" role="radiogroup" aria-label="Źródło bazy ćwiczeń">
                <label class="source-option @(_settings.ExerciseCatalogSource == ExerciseSource.FreeExerciseDb ? "active" : "")">
                    <input type="radio" name="exSource" class="form-check-input" checked="@(_settings.ExerciseCatalogSource == ExerciseSource.FreeExerciseDb)"
                           @onchange="() => _settings.ExerciseCatalogSource = ExerciseSource.FreeExerciseDb" />
                    <span class="source-option-body">
                        <span class="source-option-title">Free Exercise DB</span>
                        <span class="source-option-list">
                            <span><i class="bi bi-check2"></i>ok. 870 ćwiczeń ze zdjęciami</span>
                            <span><i class="bi bi-check2"></i>wszystkie nazwy i opisy po polsku</span>
                            <span><i class="bi bi-dash"></i>bez filmów</span>
                            <span><i class="bi bi-check2"></i>wbudowana, działa bez internetu</span>
                        </span>
                    </span>
                </label>
                <label class="source-option @(_settings.ExerciseCatalogSource == ExerciseSource.Wger ? "active" : "")">
                    <input type="radio" name="exSource" class="form-check-input" checked="@(_settings.ExerciseCatalogSource == ExerciseSource.Wger)"
                           @onchange="() => _settings.ExerciseCatalogSource = ExerciseSource.Wger" />
                    <span class="source-option-body">
                        <span class="source-option-title">wger.de</span>
                        <span class="source-option-list">
                            <span><i class="bi bi-check2"></i>otwarta baza rozwijana przez społeczność</span>
                            <span><i class="bi bi-check2"></i>część ćwiczeń z filmami</span>
                            <span><i class="bi bi-dash"></i>po polsku tylko część nazw, reszta po angielsku</span>
                            <span><i class="bi bi-check2"></i>aktualizacja co tydzień, autorzy przy każdym ćwiczeniu</span>
                        </span>
                    </span>
                </label>
            </div>

            @if (_settings.ExerciseCatalogSource == ExerciseSource.Wger || CatalogSync.IsRunning || _stored?.WgerExerciseCount > 0)
            {
                <div class="source-status mt-3">
                    @if (CatalogSync.IsRunning)
                    {
                        var pct = CatalogSync.Total == 0 ? 5 : Math.Clamp(CatalogSync.Done * 100 / CatalogSync.Total, 5, 100);
                        <div class="d-flex align-items-center gap-2 small mb-1">
                            <span class="spinner-border spinner-border-sm text-primary"></span>
                            <span>Pobieram ćwiczenia z wger.de… @(CatalogSync.Total > 0 ? $"{pct}%" : "")</span>
                        </div>
                        <div class="progress" style="height:6px" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="Postęp pobierania">
                            <div class="progress-bar" style="width:@(pct)%"></div>
                        </div>
                        <div class="text-muted small mt-1">Możesz zamknąć tę stronę — pobieranie trwa w tle.</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div class="small flex-grow-1">
                                @if (_stored?.WgerSyncedAt is { } synced)
                                {
                                    <i class="bi bi-cloud-check me-1 text-success"></i>
                                    <span>Pobrano @_stored.WgerExerciseCount ćwiczeń · ostatnia aktualizacja @Clock.ToWallClock(synced).ToString("dd.MM.yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-arrow-down me-1"></i>
                                    <span>Ćwiczenia z wger.de pobiorą się po zapisaniu (ok. minuty).</span>
                                }
                            </div>
                            @if (_stored?.ExerciseCatalogSource == ExerciseSource.Wger)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="SyncNow"><i class="bi bi-arrow-repeat me-1"></i>Aktualizuj teraz</button>
                            }
                        </div>
                        @if (CatalogSync.LastError is { } err)
                        {
                            <div class="alert alert-warning py-2 small mt-2 mb-0"><i class="bi bi-exclamation-triangle me-1"></i>@err @(_stored?.WgerExerciseCount > 0 ? "Katalog pokazuje ćwiczenia z poprzedniego pobrania." : "Do tego czasu katalog pokazuje Free Exercise DB.")</div>
                        }
                        else if (CatalogSync.LastResult is { } res)
                        {
                            <div class="text-success small mt-1"><i class="bi bi-check2-circle me-1"></i>Gotowe: @res.Added nowych, @res.Updated zaktualizowanych.</div>
                        }
                    }
                </div>
            }

            <div class="text-muted small mt-3">
                <i class="bi bi-info-circle me-1"></i>Zmiana źródła nie usuwa ćwiczeń z istniejących planów ani dziennika treningów — dotyczy katalogu i wyboru nowych ćwiczeń.
                Treści wger.de są na licencji <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.pl" target="_blank" rel="noopener">CC-BY-SA</a>; autorów pokazujemy przy każdym ćwiczeniu.
            </div>
        </div>
    </div>

    <button class="btn btn-primary mt-3" @onclick="Save" disabled="@_saving">
        @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
        <i class="bi bi-save me-1"></i>Zapisz
    </button>
}

@code {
    private ModuleSettingsDto? _settings;
    private bool _saving;
    private string _msg = string.Empty;

    private ModuleSettingsDto? _stored; // stan zapisany (w tym wynik ostatniego pobrania z wger)

    protected override async Task OnInitializedAsync()
    {
        _settings = await ModuleSettings.GetAsync();
        _stored = await ModuleSettings.GetAsync();
        CatalogSync.Changed += OnSyncChanged;
    }

    private void OnSyncChanged() => _ = InvokeAsync(async () =>
    {
        if (!CatalogSync.IsRunning) _stored = await ModuleSettings.GetAsync();
        StateHasChanged();
    });

    private async Task Save()
    {
        if (_settings is null) return;
        _saving = true; _msg = string.Empty;
        try
        {
            // Świeży odczyt: pobieranie z wger mogło w międzyczasie zapisać swój wynik.
            var current = await ModuleSettings.GetAsync();
            current.CoursesEnabled = _settings.CoursesEnabled;
            current.PackageRemindersEnabled = _settings.PackageRemindersEnabled;
            current.ExerciseCatalogSource = _settings.ExerciseCatalogSource;
            await ModuleSettings.SaveAsync(current);
            _stored = current;
            _msg = "Zapisano ustawienia modułów.";

            if (current.ExerciseCatalogSource == ExerciseSource.Wger && current.WgerExerciseCount == 0 && CatalogSync.TryStart())
                _msg = "Zapisano. Pobieram ćwiczenia z wger.de — katalog przełączy się sam, gdy skończę.";
        }
        finally { _saving = false; }
    }

    private void SyncNow() => CatalogSync.TryStart();

    public void Dispose() => CatalogSync.Changed -= OnSyncChanged;
}
