@page "/admin/courses/{CourseId:int}"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@inject ICourseService CourseService
@inject IPermissionService Permission
@inject IBunnyService Bunny
@inject EntitlementService Entitlements
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Budowa kursu" />

<div class="page-header d-flex align-items-center justify-content-between">
    <h4 class="page-title">
        <a href="/admin/courses" class="text-decoration-none text-muted me-2"><i class="bi bi-arrow-left"></i></a>
        <i class="bi bi-diagram-3 me-2" style="color:var(--c-primary)"></i>@(_course?.Title ?? "Kurs")
    </h4>
</div>

@if (_denied)
{
    <div class="alert alert-danger"><i class="bi bi-shield-lock me-2"></i>Brak uprawnień do zarządzania kursami.</div>
}
else if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (_course is null)
{
    <div class="alert alert-warning">Nie znaleziono kursu.</div>
}
else
{
    <p class="text-muted">Zbuduj kurs z modułów i lekcji. W każdej lekcji dodasz film (wgrany na platformę albo link z YouTube), opis i quiz.</p>

    @foreach (var m in _modules)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2">
                @if (_renameModuleId == m.Id)
                {
                    <input class="form-control form-control-sm" style="max-width:360px" @bind="_renameModuleTitle" />
                    <button class="btn btn-sm btn-primary" @onclick="() => SaveModuleTitle(m.Id)"><i class="bi bi-check-lg"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _renameModuleId = null">Anuluj</button>
                }
                else
                {
                    <span class="fw-semibold flex-grow-1"><i class="bi bi-collection me-2"></i>@m.Title</span>
                    <button class="btn btn-sm btn-outline-secondary" title="W górę" @onclick="() => MoveModule(m.Id, -1)"><i class="bi bi-arrow-up"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" title="W dół" @onclick="() => MoveModule(m.Id, 1)"><i class="bi bi-arrow-down"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" title="Zmień nazwę" @onclick="() => StartRenameModule(m)"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger" title="Usuń moduł" @onclick="() => DeleteModule(m.Id)"><i class="bi bi-trash"></i></button>
                }
            </div>
            <div class="card-body">
                @if (m.Lessons.Count == 0)
                {
                    <p class="text-muted small mb-2">Brak lekcji w tym module.</p>
                }
                else
                {
                    <div class="mb-2">
                        @foreach (var l in m.Lessons)
                        {
                            <div class="border rounded mb-2">
                                <div class="d-flex align-items-center gap-2 px-2 py-2" style="cursor:pointer" @onclick="() => ToggleLesson(l)">
                                    <i class="bi @(IsLessonOpen(l) ? "bi-chevron-down" : "bi-chevron-right") text-muted"></i>
                                    <i class="bi @(!string.IsNullOrEmpty(l.BunnyVideoId) ? "bi-camera-video" : !string.IsNullOrEmpty(l.VideoUrl) ? "bi-play-circle" : "bi-file-text") text-muted"></i>
                                    <span class="flex-grow-1">
                                        @l.Title
                                        @if (l.BunnyVideoSizeBytes > 0)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size:.65rem">@FormatSize(l.BunnyVideoSizeBytes.Value)</span>
                                        }
                                    </span>
                                    <button class="btn btn-sm btn-outline-secondary" title="W górę" @onclick="() => MoveLesson(l.Id, -1)" @onclick:stopPropagation="true"><i class="bi bi-arrow-up"></i></button>
                                    <button class="btn btn-sm btn-outline-secondary" title="W dół" @onclick="() => MoveLesson(l.Id, 1)" @onclick:stopPropagation="true"><i class="bi bi-arrow-down"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" title="Usuń" @onclick="() => DeleteLesson(l.Id)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                                </div>
                                @if (IsLessonOpen(l))
                                {
                                    <div class="px-3 pb-3">
                                        @LessonFormUi()
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_lessonFormModuleId == m.Id && _lessonFormId is null)
                {
                    @LessonFormUi()
                }
                else
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartAddLesson(m.Id)"><i class="bi bi-plus-lg me-1"></i>Dodaj lekcję</button>
                }
            </div>
        </div>
    }

    @* Add module *@
    <div class="input-group mt-3" style="max-width:520px">
        <input class="form-control" placeholder="Nazwa nowego modułu" @bind="_newModuleTitle"
               @onkeydown="@(e => { if (e.Key == "Enter") { _ = AddModule(); } })" />
        <button class="btn btn-primary" @onclick="AddModule"><i class="bi bi-plus-lg me-1"></i>Dodaj moduł</button>
    </div>
}

@code {
    [Parameter] public int CourseId { get; set; }

    private bool _loading = true;
    private bool _denied;
    private bool _saving;
    private CourseDto? _course;
    private List<ModuleDto> _modules = [];

    private string _newModuleTitle = string.Empty;

    private int? _renameModuleId;
    private string _renameModuleTitle = string.Empty;

    private int? _lessonFormModuleId;
    private int? _lessonFormId;
    private SaveLessonDto _lessonForm = new();
    private string _videoTab = "upload";
    private bool _uploading;
    private bool _uploadError;
    private string? _uploadMsg;
    private long _uploadTotal;
    private long _uploadDone;
    private int UploadPct => _uploadTotal > 0 ? (int)(100 * _uploadDone / _uploadTotal) : 0;
    private string _lessonText = string.Empty;
    private string _lessonTextOriginal = string.Empty;

    private QuizDto _quiz = new();
    private bool _savingQuiz;
    private bool _quizSaved;

    private bool _bunnyAvailable;
    private VideoHubStatus? _video;
    private bool _deletingVideo;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var role = auth.User.IsInRole(Roles.Admin) ? Roles.Admin
                 : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer
                 : auth.User.IsInRole(Roles.Subordinate) ? Roles.Subordinate : string.Empty;
        if (!await Permission.HasPermissionAsync(role, PTScheduler.Domain.Constants.Permissions.ManageCourses))
        {
            _denied = true; _loading = false; return;
        }

        _course = await CourseService.GetCourseAsync(CourseId);
        if (_course is not null) await ReloadContent();

        // Wgrywanie filmów tylko w pakiecie z wideo (Bunny) i w ramach opłaconego miejsca.
        _bunnyAvailable = Entitlements.Current.VideoProvider == "bunny" && Entitlements.Current.MaxVideoStorageGB > 0;
        if (_bunnyAvailable)
            await RefreshVideoUsage();
        if (!_bunnyAvailable || _video is { Enabled: false }) _videoTab = "url";

        _loading = false;
    }

    private async Task ReloadContent() => _modules = await CourseService.GetContentAsync(CourseId);

    // ---- Modules ----
    private async Task AddModule()
    {
        if (string.IsNullOrWhiteSpace(_newModuleTitle)) return;
        await CourseService.AddModuleAsync(CourseId, _newModuleTitle);
        _newModuleTitle = string.Empty;
        await ReloadContent();
    }

    private void StartRenameModule(ModuleDto m)
    {
        _renameModuleId = m.Id;
        _renameModuleTitle = m.Title;
    }

    private async Task SaveModuleTitle(int moduleId)
    {
        await CourseService.UpdateModuleAsync(moduleId, _renameModuleTitle);
        _renameModuleId = null;
        await ReloadContent();
    }

    private async Task MoveModule(int moduleId, int direction)
    {
        await CourseService.MoveModuleAsync(moduleId, direction);
        await ReloadContent();
    }

    private async Task DeleteModule(int moduleId)
    {
        await CourseService.DeleteModuleAsync(moduleId);
        if (_lessonFormModuleId == moduleId) CancelLessonForm();
        await ReloadContent();
    }

    // ---- Lessons ----
    private void StartAddLesson(int moduleId)
    {
        _lessonFormModuleId = moduleId;
        _lessonFormId = null;
        _lessonForm = new SaveLessonDto();
        _lessonText = _lessonTextOriginal = string.Empty;
        _uploadMsg = null;
        _quiz = new QuizDto();
        _quizSaved = false;
    }

    private async Task EditLesson(LessonDto l)
    {
        _lessonFormModuleId = l.ModuleId;
        _lessonFormId = l.Id;
        _lessonForm = new SaveLessonDto { Title = l.Title, VideoUrl = l.VideoUrl, BunnyVideoId = l.BunnyVideoId, ContentHtml = l.ContentHtml,
            BunnyVideoSizeBytes = l.BunnyVideoSizeBytes, BunnyVideoDurationSec = l.BunnyVideoDurationSec };
        _lessonText = _lessonTextOriginal = PTScheduler.Application.Training.LessonText.FromHtml(l.ContentHtml);
        _uploadMsg = null;
        _quizSaved = false;
        _quiz = await CourseService.GetQuizForEditAsync(l.Id);
    }

    private async Task UploadToBunny(InputFileChangeEventArgs e)
    {
        _uploadMsg = null; _uploadError = false;
        var f = e.File;
        const long max = 10L * 1024 * 1024 * 1024;
        if (f.Size > max) { _uploadMsg = "Plik jest za duży — najwięcej 10 GB naraz."; _uploadError = true; return; }
        if (_video is { Enabled: true } v && v.FreeBytes < f.Size)
        {
            _uploadMsg = $"Brak miejsca: wolne {FormatSize(v.FreeBytes)}, plik ma {FormatSize(f.Size)}. Dokup miejsce w Sklepie albo usuń niepotrzebne filmy.";
            _uploadError = true;
            return;
        }

        _uploading = true; _uploadTotal = f.Size; _uploadDone = 0;
        try
        {
            var title = string.IsNullOrWhiteSpace(_lessonForm.Title) ? Path.GetFileNameWithoutExtension(f.Name) : _lessonForm.Title;
            var progress = new Progress<long>(done => { _uploadDone = done; _ = InvokeAsync(StateHasChanged); });
            await using var stream = f.OpenReadStream(max);
            var previous = _lessonForm.BunnyVideoId;
            var (ok, videoRef, err) = await Bunny.UploadAsync(title, VideoKinds.Courses, stream, f.Size, progress);
            if (ok && videoRef is not null)
            {
                _lessonForm.BunnyVideoId = videoRef;
                _lessonForm.BunnyVideoSizeBytes = f.Size;
                _lessonForm.BunnyVideoDurationSec = null;
                _lessonForm.VideoUrl = null;
                // Poprzedni film tej lekcji (z platformy) zwalnia miejsce.
                if (previous is not null && previous.Contains('/')) await Bunny.DeleteAsync(previous);
                // Lekcja zapisana od razu — inaczej film zostałby na platformie bez lekcji.
                if (_lessonFormId is not null) { await CourseService.UpdateLessonAsync(_lessonFormId.Value, WithText()); await ReloadContent(); }
                _uploadMsg = $"Wgrano {FormatSize(f.Size)}. Film jest teraz przetwarzany — za kilka minut będzie gotowy do odtwarzania.";
                await RefreshVideoUsage();
            }
            else { _uploadMsg = err ?? "Przesyłanie nie powiodło się."; _uploadError = true; }
        }
        catch (Exception ex) { _uploadMsg = ex.Message; _uploadError = true; }
        finally { _uploading = false; }
    }

    private async Task DeleteBunnyVideo()
    {
        if (string.IsNullOrWhiteSpace(_lessonForm.BunnyVideoId)) return;
        _deletingVideo = true;
        // Stary film (sam GUID ze starej biblioteki) tylko odpinamy od lekcji.
        var (ok, err) = _lessonForm.BunnyVideoId.Contains('/') ? await Bunny.DeleteAsync(_lessonForm.BunnyVideoId) : (true, null);
        if (ok)
        {
            _lessonForm.BunnyVideoId = null;
            _lessonForm.BunnyVideoSizeBytes = null;
            _lessonForm.BunnyVideoDurationSec = null;
            if (_lessonFormId is not null) { await CourseService.UpdateLessonAsync(_lessonFormId.Value, WithText()); await ReloadContent(); }
            _uploadMsg = "Film usunięty — miejsce zwolnione.";
            _uploadError = false;
            await RefreshVideoUsage();
        }
        else
        {
            _uploadMsg = err ?? "Nie udało się usunąć filmu.";
            _uploadError = true;
        }
        _deletingVideo = false;
    }

    private async Task RefreshVideoUsage() => _video = await Bunny.GetStatusAsync(refresh: true);

    /// <summary>Opis lekcji jako zwykły tekst → bezpieczny HTML; niezmieniony opis starszej lekcji zostaje jak był.</summary>
    private SaveLessonDto WithText()
    {
        if (_lessonText != _lessonTextOriginal) _lessonForm.ContentHtml = PTScheduler.Application.Training.LessonText.ToHtml(_lessonText);
        return _lessonForm;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):0.#} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):0.##} GB";
    }

    private void CancelLessonForm()
    {
        _lessonFormModuleId = null;
        _lessonFormId = null;
        _lessonForm = new SaveLessonDto();
        _lessonText = _lessonTextOriginal = string.Empty;
        _quiz = new QuizDto();
    }

    private async Task SaveLesson()
    {
        if (_lessonFormModuleId is null) return;
        if (string.IsNullOrWhiteSpace(_lessonForm.Title)) { _lessonForm.Title = "Nowa lekcja"; }
        _saving = true;
        try
        {
            if (_lessonFormId is null)
            {
                await CourseService.AddLessonAsync(_lessonFormModuleId.Value, WithText());
                CancelLessonForm();
            }
            else
            {
                await CourseService.UpdateLessonAsync(_lessonFormId.Value, WithText());
                _lessonTextOriginal = _lessonText;
            }
            await ReloadContent();
        }
        finally { _saving = false; }
    }

    private void AddQuestion() =>
        _quiz.Questions.Add(new QuizQuestionDto { Options = { new QuizOptionDto(), new QuizOptionDto() } });

    private async Task SaveQuiz()
    {
        if (_lessonFormId is null) return;
        _savingQuiz = true; _quizSaved = false;
        try
        {
            await CourseService.SaveQuizAsync(_lessonFormId.Value, _quiz.PassThreshold, _quiz.Questions);
            _quiz = await CourseService.GetQuizForEditAsync(_lessonFormId.Value);
            await ReloadContent();
            _quizSaved = true;
        }
        finally { _savingQuiz = false; }
    }

    private async Task MoveLesson(int lessonId, int direction)
    {
        await CourseService.MoveLessonAsync(lessonId, direction);
        await ReloadContent();
    }

    private async Task DeleteLesson(int lessonId)
    {
        await CourseService.DeleteLessonAsync(lessonId);
        if (_lessonFormId == lessonId) CancelLessonForm();
        await ReloadContent();
    }

    private bool IsLessonOpen(LessonDto l) => _lessonFormId == l.Id;

    private async Task ToggleLesson(LessonDto l)
    {
        if (_lessonFormId == l.Id) CancelLessonForm();
        else await EditLesson(l);
    }

    private RenderFragment LessonFormUi() =>@<div class="border rounded p-3 mt-2 bg-body-tertiary">
        <h6 class="mb-3">@(_lessonFormId is null ? "Nowa lekcja" : "Edycja lekcji")</h6>
        <div class="mb-3">
            <label class="form-label fw-semibold">Tytuł lekcji</label>
            <input class="form-control" @bind="_lessonForm.Title" maxlength="160" />
        </div>
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <label class="form-label fw-semibold">Film</label>
                <ul class="nav nav-tabs small mb-2">
                    @if (_bunnyAvailable && _video is { Enabled: true })
                    {
                        <li class="nav-item">
                            <a class="nav-link @(_videoTab == "upload" ? "active" : "")" @onclick='() => _videoTab = "upload"' href="javascript:void(0)"><i class="bi bi-cloud-upload me-1"></i>Wgraj film</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link disabled text-muted"><i class="bi bi-cloud-upload me-1"></i>Wgraj film <PlanBadge Flag="CoursesEnabled" RequiredPlan="Pro" /></span>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(_videoTab == "url" ? "active" : "")" @onclick='() => _videoTab = "url"' href="javascript:void(0)"><i class="bi bi-youtube me-1"></i>Link YouTube</a>
                    </li>
                </ul>

                @if (_videoTab == "url" || !_bunnyAvailable || _video is not { Enabled: true })
                {
                    <input class="form-control" @bind="_lessonForm.VideoUrl" @bind:event="oninput" placeholder="https://youtube.com/watch?v=…" />
                    <div class="form-text">Wklej link — osadzimy film automatycznie. Nie zajmuje miejsca na platformie.</div>
                    @if (_bunnyAvailable && _video is { Enabled: false })
                    {
                        <div class="form-text text-warning"><i class="bi bi-info-circle me-1"></i>@_video.Reason</div>
                    }
                }
                else
                {
                    <div class="small mb-2">
                        <div class="d-flex justify-content-between text-muted mb-1">
                            <span>@(_video.ImagesEnabled ? "Miejsce na filmy i zdjęcia" : "Miejsce na filmy")</span>
                            <span style="font-variant-numeric:tabular-nums">@FormatSize(_video.UsedBytes) z @(_video.QuotaBytes == long.MaxValue ? "bez limitu" : FormatSize(_video.QuotaBytes))</span>
                        </div>
                        <div class="progress" style="height:6px">
                            <div class="progress-bar @(_video.Percent > 90 ? "bg-danger" : _video.Percent > 70 ? "bg-warning" : "bg-success")" style="width:@(_video.Percent)%"></div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_lessonForm.BunnyVideoId))
                    {
                        <div class="d-flex align-items-center gap-2 mb-2 p-2 border rounded bg-body">
                            <i class="bi bi-camera-video text-primary"></i>
                            <span class="small flex-grow-1">Film w lekcji@(_lessonForm.BunnyVideoSizeBytes is long sz ? $" · {FormatSize(sz)}" : "")</span>
                            <button class="btn btn-sm btn-outline-danger" title="Usuń film z lekcji i platformy" @onclick="DeleteBunnyVideo" disabled="@(_deletingVideo || _uploading)">
                                @if (_deletingVideo) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-trash me-1"></i> }Usuń film
                            </button>
                        </div>
                    }
                    <label class="form-label small mb-1">@(string.IsNullOrWhiteSpace(_lessonForm.BunnyVideoId) ? "Wybierz plik wideo (MP4, MOV…)" : "Zamień na inny plik")</label>
                    <InputFile OnChange="UploadToBunny" accept="video/*" class="form-control form-control-sm" disabled="@_uploading" />
                    @if (_uploading)
                    {
                        <div class="mt-2">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span><span class="spinner-border spinner-border-sm me-1"></span>Wgrywam na platformę…</span>
                                <span style="font-variant-numeric:tabular-nums">@UploadPct% · @FormatSize(_uploadDone) z @FormatSize(_uploadTotal)</span>
                            </div>
                            <div class="progress" style="height:6px"><div class="progress-bar progress-bar-striped progress-bar-animated" style="width:@(UploadPct)%"></div></div>
                            <div class="form-text">Nie zamykaj tej karty do końca przesyłania.</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_uploadMsg))
                    {
                        <div class="alert @(_uploadError ? "alert-danger" : "alert-success") py-1 small mt-2 mb-0">@_uploadMsg</div>
                    }
                }

                <div class="mt-2">
                    <VideoPlayer Url="@_lessonForm.VideoUrl" BunnyVideoId="@_lessonForm.BunnyVideoId" />
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <label class="form-label fw-semibold" for="lesson-text">Opis lekcji <span class="text-muted small fw-normal">— klient zobaczy go pod filmem</span></label>
                <textarea id="lesson-text" class="form-control" rows="9" maxlength="8000" @bind="_lessonText" @bind:event="oninput"
                          placeholder="Co zrobimy w tej lekcji, na co uważać, materiały do pobrania (link)…"></textarea>
                <div class="form-text">Zwykły tekst: pusta linia zaczyna nowy akapit, linki https:// staną się klikalne.</div>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveLesson" disabled="@_saving">
                @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                <i class="bi bi-save me-1"></i>Zapisz lekcję
            </button>
            <button class="btn btn-outline-secondary" @onclick="CancelLessonForm">Anuluj</button>
        </div>

        @if (_lessonFormId is not null)
        {
            <hr class="my-3" />
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h6 class="mb-0"><i class="bi bi-patch-question me-1"></i>Quiz <span class="text-muted small">(opcjonalny, auto-oceniany)</span></h6>
                <div class="d-flex align-items-center gap-1">
                    <label class="small text-muted mb-0">Próg zaliczenia</label>
                    <input type="number" min="1" max="100" class="form-control form-control-sm" style="width:78px" @bind="_quiz.PassThreshold" />
                    <span class="small text-muted">%</span>
                </div>
            </div>

            @foreach (var q in _quiz.Questions)
            {
                <div class="border rounded p-2 mb-2 bg-body">
                    <div class="d-flex gap-2 mb-2">
                        <input class="form-control form-control-sm" placeholder="Treść pytania" @bind="q.Text" />
                        <select class="form-select form-select-sm" style="width:auto" @bind="q.Type">
                            <option value="@QuizQuestionType.SingleChoice">Jednokrotny wybór</option>
                            <option value="@QuizQuestionType.MultipleChoice">Wielokrotny wybór</option>
                        </select>
                        <button class="btn btn-sm btn-outline-danger" title="Usuń pytanie" @onclick="() => _quiz.Questions.Remove(q)"><i class="bi bi-trash"></i></button>
                    </div>
                    @foreach (var o in q.Options)
                    {
                        <div class="d-flex align-items-center gap-2 mb-1 ms-3">
                            <input class="form-check-input mt-0" type="checkbox" @bind="o.IsCorrect" title="Poprawna odpowiedź" />
                            <input class="form-control form-control-sm" placeholder="Treść odpowiedzi" @bind="o.Text" />
                            <button class="btn btn-sm btn-outline-secondary" title="Usuń odpowiedź" @onclick="() => q.Options.Remove(o)"><i class="bi bi-x-lg"></i></button>
                        </div>
                    }
                    <button class="btn btn-sm btn-link px-1" @onclick="() => q.Options.Add(new QuizOptionDto())"><i class="bi bi-plus"></i> Dodaj odpowiedź</button>
                </div>
            }

            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-sm btn-outline-primary" @onclick="AddQuestion"><i class="bi bi-plus-lg me-1"></i>Dodaj pytanie</button>
                <button class="btn btn-sm btn-success" @onclick="SaveQuiz" disabled="@_savingQuiz">
                    @if (_savingQuiz) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="bi bi-save me-1"></i>Zapisz quiz
                </button>
                @if (_quizSaved) { <span class="text-success small align-self-center"><i class="bi bi-check-circle me-1"></i>Zapisano</span> }
            </div>
        }
    </div>;
}
