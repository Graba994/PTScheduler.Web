@page "/admin/users/{Id}"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]
@inject IUserManagementService UserService
@inject IAuditLogService AuditLogService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Edycja użytkownika" />

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin/users">Użytkownicy</a></li>
        <li class="breadcrumb-item active">Edycja</li>
    </ol>
</nav>

@if (user is null)
{
    <p><span class="spinner-border spinner-border-sm me-2" />Ładowanie...</p>
}
else
{
    <div class="row">
        <div class="col-md-6 d-flex flex-column gap-3">

            <!-- Profile data -->
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title mb-3"><i class="bi bi-person-fill me-2"></i>Dane użytkownika</h6>

                    @if (!string.IsNullOrEmpty(profileMsg))
                    {
                        <div class="alert @(profileError ? "alert-danger" : "alert-success") py-2 small">@profileMsg</div>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label small fw-semibold">Imię</label>
                            <input class="form-control" @bind="editFirstName" maxlength="60" />
                        </div>
                        <div class="col">
                            <label class="form-label small fw-semibold">Nazwisko</label>
                            <input class="form-control" @bind="editLastName" maxlength="60" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">E-mail</label>
                        <input class="form-control" type="email" @bind="editEmail" maxlength="120" />
                    </div>

                    <button class="btn btn-primary btn-sm" @onclick="SaveProfile" disabled="@isBusy">
                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                        <i class="bi bi-check-lg me-1"></i>Zapisz dane
                    </button>
                </div>
            </div>

            <!-- Role & status -->
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title mb-3"><i class="bi bi-shield-fill me-2"></i>Rola i status</h6>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success") py-2 small">@message</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Rola</label>
                        <select class="form-select" @bind="selectedRole">
                            <option value="">— brak roli —</option>
                            <option value="@Roles.Admin">Administrator</option>
                            <option value="@Roles.Trainer">Trener</option>
                            <option value="@Roles.Subordinate">Asystent trenera</option>
                            <option value="@Roles.Client">Klient</option>
                        </select>
                    </div>

                    @if (selectedRole == Roles.Subordinate)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Przełożony (Trainer)</label>
                            <select class="form-select" @bind="selectedSupervisorId">
                                <option value="">— brak —</option>
                                @foreach (var trainer in trainers)
                                {
                                    <option value="@trainer.Id">@trainer.FullName (@trainer.Email)</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Status konta</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="lockSwitch" @bind="isLocked" />
                            <label class="form-check-label" for="lockSwitch">
                                @(isLocked ? "Zablokowany" : "Aktywny")
                            </label>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@isBusy">
                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                        <i class="bi bi-check-lg me-1"></i>Zapisz rolę
                    </button>
                </div>
            </div>

            <!-- Trainer's clients -->
            @if (selectedRole is Roles.Trainer or Roles.Subordinate || trainerClients.Count > 0)
            {
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title mb-3">
                            <i class="bi bi-people-fill me-2"></i>Klienci trenera
                            <span class="badge bg-secondary ms-1">@trainerClients.Count</span>
                        </h6>

                        @if (!string.IsNullOrEmpty(reassignMsg))
                        {
                            <div class="alert @(reassignError ? "alert-danger" : "alert-success") py-2 small">@reassignMsg</div>
                        }

                        @if (trainerClients.Count == 0)
                        {
                            <p class="text-muted small mb-0">Ten trener nie ma jeszcze żadnych klientów.</p>
                        }
                        else
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:30px">
                                                <input type="checkbox" class="form-check-input"
                                                       checked="@AllClientsSelected"
                                                       @onchange="ToggleAllClients" />
                                            </th>
                                            <th>Klient</th>
                                            <th>E-mail</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in trainerClients)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@selectedClientIds.Contains(c.Id)"
                                                           @onchange="() => ToggleClient(c.Id)" />
                                                </td>
                                                <td class="fw-semibold small">@c.FullName</td>
                                                <td class="small text-muted">@c.Email</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (selectedClientIds.Count > 0)
                            {
                                <div class="d-flex align-items-end gap-2 flex-wrap">
                                    <div style="min-width:200px">
                                        <label class="form-label small fw-semibold mb-1">Przypisz do trenera</label>
                                        <select class="form-select form-select-sm" @bind="reassignTargetTrainerId">
                                            <option value="">— wybierz trenera —</option>
                                            @foreach (var t in trainers.Where(t => t.Id != Id))
                                            {
                                                <option value="@t.Id">@t.FullName (@t.Email)</option>
                                            }
                                        </select>
                                    </div>
                                    <button class="btn btn-warning btn-sm" @onclick="ReassignClients" disabled="@(isBusy || string.IsNullOrEmpty(reassignTargetTrainerId))">
                                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                                        <i class="bi bi-arrow-right-circle me-1"></i>Przenieś @selectedClientIds.Count
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4 d-flex flex-column gap-3">

            <!-- Reset password -->
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-lock-fill me-2 text-warning"></i>Resetuj hasło</h6>
                    <p class="small text-muted mb-3">Ustaw nowe hasło bez znajomości starego.</p>

                    @if (!string.IsNullOrEmpty(pwMsg))
                    {
                        <div class="alert @(pwError ? "alert-danger" : "alert-success") py-2 small mb-2">@pwMsg</div>
                    }

                    <div class="mb-2">
                        <input class="form-control form-control-sm" type="password"
                               @bind="newPw" placeholder="Nowe hasło (min. 6 znaków)" autocomplete="new-password" />
                    </div>
                    <button class="btn btn-warning btn-sm w-100" @onclick="ResetPassword" disabled="@isBusy">
                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                        <i class="bi bi-arrow-clockwise me-1"></i>Ustaw nowe hasło
                    </button>
                </div>
            </div>

            <!-- Danger zone -->
            <div class="card border-danger">
                <div class="card-body">
                    <h6 class="card-title text-danger">Strefa niebezpieczna</h6>
                    <p class="small text-muted">Usunięcie użytkownika jest nieodwracalne.</p>
                    <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDelete">
                        Usuń użytkownika
                    </button>

                    @if (showDeleteConfirm)
                    {
                        <div class="mt-3 p-2 bg-danger bg-opacity-10 rounded">
                            <p class="small mb-2">Na pewno? Tej operacji nie można cofnąć.</p>
                            <button class="btn btn-danger btn-sm me-2" @onclick="Delete">Tak, usuń</button>
                            <button class="btn btn-secondary btn-sm" @onclick="() => showDeleteConfirm = false">Anuluj</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private UserDto? user;
    private List<UserDto> trainers = [];
    private string selectedRole = string.Empty;
    private string? selectedSupervisorId;
    private bool isLocked;
    private bool isBusy;
    private bool showDeleteConfirm;
    private string message = string.Empty;
    private bool isError;

    private string editFirstName = string.Empty;
    private string editLastName = string.Empty;
    private string editEmail = string.Empty;
    private string profileMsg = string.Empty;
    private bool profileError;

    private string newPw = string.Empty;
    private string pwMsg = string.Empty;
    private bool pwError;

    private List<ClientSummaryDto> trainerClients = [];
    private HashSet<int> selectedClientIds = [];
    private string reassignTargetTrainerId = string.Empty;
    private string reassignMsg = string.Empty;
    private bool reassignError;

    private string _adminId = string.Empty;
    private string _adminEmail = string.Empty;

    private bool AllClientsSelected => trainerClients.Count > 0 && selectedClientIds.Count == trainerClients.Count;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _adminId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _adminEmail = auth.User.Identity?.Name ?? _adminId;

        await LoadUser();
    }

    private async Task LoadUser()
    {
        user = await UserService.GetUserAsync(Id);
        trainers = await UserService.GetTrainersAsync();

        if (user is not null)
        {
            selectedRole = user.Role;
            selectedSupervisorId = user.SupervisorId;
            isLocked = user.IsLockedOut;
            editFirstName = user.FirstName ?? string.Empty;
            editLastName = user.LastName ?? string.Empty;
            editEmail = user.Email;
        }

        await LoadTrainerClients();
    }

    private async Task LoadTrainerClients()
    {
        trainerClients = await UserService.GetClientsByTrainerAsync(Id);
        selectedClientIds.Clear();
        reassignTargetTrainerId = string.Empty;
    }

    private async Task SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(editEmail)) { profileMsg = "E-mail jest wymagany."; profileError = true; return; }

        isBusy = true; profileMsg = string.Empty;
        try
        {
            var (success, error) = await UserService.UpdateProfileAsync(Id, editFirstName.Trim(), editLastName.Trim(), editEmail.Trim());
            if (success)
            {
                await AuditLogService.LogAsync(_adminId, _adminEmail, Roles.Admin, "UserProfileUpdated", "User",
                    Id, $"Imię: {editFirstName}, Nazwisko: {editLastName}, Email: {editEmail}");
                profileMsg = "Dane zapisane."; profileError = false;
                user = await UserService.GetUserAsync(Id);
            }
            else { profileMsg = error ?? "Nie udało się zapisać danych."; profileError = true; }
        }
        catch (Exception ex) { profileMsg = $"Błąd: {ex.Message}"; profileError = true; }
        finally { isBusy = false; }
    }

    private async Task Save()
    {
        isBusy = true;
        message = string.Empty;
        try
        {
            await UserService.SetRoleAsync(Id, selectedRole);

            if (selectedRole == Roles.Subordinate)
                await UserService.SetSupervisorAsync(Id, selectedSupervisorId);

            await UserService.SetLockoutAsync(Id, isLocked);

            await AuditLogService.LogAsync(_adminId, _adminEmail, Roles.Admin, "UserUpdated", "User",
                Id, $"Email: {user?.Email}, rola: {selectedRole}, zablokowany: {isLocked}");

            message = "Zmiany zapisane.";
            isError = false;
            await LoadUser();
        }
        catch (Exception ex)
        {
            message = $"Błąd: {ex.Message}";
            isError = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPw)) { pwMsg = "Podaj nowe hasło."; pwError = true; return; }
        isBusy = true; pwMsg = string.Empty;
        try
        {
            var (success, error) = await UserService.ResetPasswordAsync(Id, newPw);
            if (success)
            {
                await AuditLogService.LogAsync(_adminId, _adminEmail, Roles.Admin, "UserPasswordReset", "User",
                    Id, $"Email: {user?.Email}");
                pwMsg = "Hasło zostało zmienione."; pwError = false; newPw = string.Empty;
            }
            else { pwMsg = error ?? "Błąd zmiany hasła."; pwError = true; }
        }
        catch (Exception ex) { pwMsg = ex.Message; pwError = true; }
        finally { isBusy = false; }
    }

    private void ConfirmDelete() => showDeleteConfirm = true;

    private async Task Delete()
    {
        try
        {
            var deletedEmail = user?.Email ?? Id;
            await UserService.DeleteUserAsync(Id);
            await AuditLogService.LogAsync(_adminId, _adminEmail, Roles.Admin, "UserDeleted", "User",
                Id, $"Email: {deletedEmail}");
            Nav.NavigateTo("/admin/users");
        }
        catch (Exception ex)
        {
            message = $"Błąd usuwania: {ex.Message}";
            isError = true;
            showDeleteConfirm = false;
        }
    }

    private void ToggleClient(int clientId)
    {
        if (!selectedClientIds.Remove(clientId))
            selectedClientIds.Add(clientId);
    }

    private void ToggleAllClients(ChangeEventArgs e)
    {
        if (e.Value is true)
            selectedClientIds = trainerClients.Select(c => c.Id).ToHashSet();
        else
            selectedClientIds.Clear();
    }

    private async Task ReassignClients()
    {
        if (selectedClientIds.Count == 0 || string.IsNullOrEmpty(reassignTargetTrainerId)) return;

        isBusy = true; reassignMsg = string.Empty;
        try
        {
            var count = selectedClientIds.Count;
            await UserService.ReassignClientsAsync(selectedClientIds, reassignTargetTrainerId);

            var targetTrainer = trainers.FirstOrDefault(t => t.Id == reassignTargetTrainerId);
            await AuditLogService.LogAsync(_adminId, _adminEmail, Roles.Admin, "ClientsReassigned", "Client",
                Id, $"Przeniesiono {count} klientów do trenera: {targetTrainer?.FullName ?? reassignTargetTrainerId}");

            reassignMsg = $"Przeniesiono {count} klientów do {targetTrainer?.FullName ?? "innego trenera"}.";
            reassignError = false;
            await LoadTrainerClients();
        }
        catch (Exception ex) { reassignMsg = $"Błąd: {ex.Message}"; reassignError = true; }
        finally { isBusy = false; }
    }
}
