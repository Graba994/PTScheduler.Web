@page "/admin/payments"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@inject IPaymentSettingsService PaymentSettings
@inject IPermissionService Permission
@inject AuthenticationStateProvider AuthState
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<AppTitle Page="Płatności online" />

<div class="page-header">
    <h4 class="page-title"><i class="bi bi-credit-card-fill me-2" style="color:var(--c-primary)"></i>Płatności online (PayU)</h4>
</div>

@if (_denied)
{
    <div class="alert alert-danger"><i class="bi bi-shield-lock me-2"></i>Brak uprawnień do konfiguracji płatności.</div>
}
else if (_settings is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (!string.IsNullOrEmpty(_msg)) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@_msg</div> }

    <div class="row g-4" style="max-width:820px">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                        <div>
                            <div class="fw-semibold">Płatności online</div>
                            <div class="text-muted small">Główny przełącznik — udostępnia zakupy klientom.</div>
                        </div>
                        <div class="form-check form-switch fs-5 m-0">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.Enabled" />
                        </div>
                    </div>

                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="fw-semibold">Tryb sandbox (testowy)</div>
                            <div class="text-muted small">Włączony = środowisko testowe PayU. Wyłącz dla płatności produkcyjnych.</div>
                        </div>
                        <div class="form-check form-switch fs-5 m-0">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.Sandbox" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-key me-2"></i>Dane PayU
                    <span class="badge @(_settings.Sandbox ? "bg-warning text-dark" : "bg-success") ms-2">@(_settings.Sandbox ? "Sandbox" : "Produkcja")</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">POS ID</label>
                            <input class="form-control" @bind="_settings.PosId" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Drugi klucz (MD5)</label>
                            <input class="form-control" type="password" @bind="_settings.SecondKey" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">OAuth client_id</label>
                            <input class="form-control" @bind="_settings.ClientId" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">OAuth client_secret</label>
                            <input class="form-control" type="password" @bind="_settings.ClientSecret" autocomplete="off" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold">Waluta</label>
                            <input class="form-control" @bind="_settings.Currency" maxlength="3" />
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Dane znajdziesz w panelu PayU → Ustawienia → Klucze konfiguracji (osobne dla sandbox i produkcji).
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12">
            <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                <i class="bi bi-save me-1"></i>Zapisz konfigurację
            </button>
        </div>
    </div>
}

@code {
    private PaymentSettingsDto? _settings;
    private bool _denied;
    private bool _saving;
    private string _msg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var role = auth.User.IsInRole(Roles.Admin) ? Roles.Admin
                 : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer
                 : auth.User.IsInRole(Roles.Subordinate) ? Roles.Subordinate : string.Empty;
        if (!await Permission.HasPermissionAsync(role, PTScheduler.Domain.Constants.Permissions.ManagePayments))
        {
            _denied = true;
            return;
        }
        _settings = await PaymentSettings.GetAsync();
    }

    private async Task Save()
    {
        if (_settings is null) return;
        _saving = true; _msg = string.Empty;
        try
        {
            await PaymentSettings.SaveAsync(_settings);
            _msg = "Zapisano konfigurację płatności.";
        }
        finally { _saving = false; }
    }
}
