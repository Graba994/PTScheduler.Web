@page "/admin/users"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Entities
@using Microsoft.AspNetCore.Identity
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]
@inject IUserManagementService UserService
@inject UserManager<ApplicationUser> UserManager
@inject EntitlementService Entitlements
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Użytkownicy" />

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Użytkownicy</h2>
    <button class="btn btn-primary btn-sm flex-shrink-0" @onclick="OpenCreateModal">
        <i class="bi bi-person-plus me-1"></i>Dodaj użytkownika
    </button>
</div>
<hr />

@if (_solo is { Possible: true } solo)
{
    <section class="solo-card @(solo.Enabled ? "on" : "")" id="solo" aria-labelledby="solo-title">
        <div class="solo-ic" aria-hidden="true"><i class="bi @(solo.Enabled ? "bi-person-check-fill" : "bi-person-workspace")"></i></div>
        <div class="min-w-0 flex-grow-1">
            <h6 id="solo-title">Pracuję sam — jedno konto do wszystkiego</h6>
            @if (solo.Enabled)
            {
                <p>Włączone. Profil trenera <b>@solo.TrainerName</b> (@solo.TrainerEmail) ma też uprawnienia administratora — loguj się tylko nim, bez przełączania. To konto zostaje jako zapasowe.</p>
            }
            else
            {
                <p>Masz jeden profil trenera. Po włączeniu <b>@solo.TrainerName</b> dostanie też uprawnienia administratora: ustawienia, ceny i treningi w jednym miejscu, bez przełączania kont.</p>
            }
            @if (_soloMsg is not null) { <div class="small @(_soloErr ? "text-danger" : "text-success") mb-2">@_soloMsg</div> }
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm @(solo.Enabled ? "btn-outline-secondary" : "btn-primary")" disabled="@_soloBusy" @onclick="() => ToggleSoloAsync(!solo.Enabled)">
                    @(solo.Enabled ? "Wyłącz" : "Włącz tryb „pracuję sam”")
                </button>
                @if (solo.Enabled && solo.TrainerId is { } tid && _canSwitchToSolo)
                {
                    <form action="Account/SwitchTo" method="post" data-enhance="false">
                        <AntiforgeryToken />
                        <input type="hidden" name="userId" value="@tid" />
                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-person-badge me-1"></i>Przejdź na swój profil</button>
                    </form>
                }
            </div>
        </div>
    </section>
}

@if (users is null)
{
    <div class="skeleton skeleton-line w-40" style="height:36px;max-width:320px;margin-bottom:16px"></div>
    @for (var i = 0; i < 5; i++)
    {
        <div class="skeleton-row">
            <div class="skeleton skeleton-circle" style="width:32px;height:32px"></div>
            <div style="flex:1">
                <div class="skeleton skeleton-line w-50" style="height:12px"></div>
                <div class="skeleton skeleton-line w-75" style="height:10px;margin-bottom:0"></div>
            </div>
        </div>
    }
}
else
{
    <div class="mb-3">
        <input class="form-control" style="max-width:320px" placeholder="Szukaj..." @bind="search" @bind:event="oninput" />
    </div>

    <div class="table-responsive">
        <table class="table table-stack table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Użytkownik</th>
                    <th>Rola</th>
                    <th>Przełożony</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Filtered)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@user.FullName</div>
                            <small class="text-muted">@user.Email</small>
                        </td>
                        <td>
                            <span class="badge @RoleBadge(user.Role)">@RoleLabel(user.Role)</span>
                        </td>
                        <td>
                            @if (user.Role == Roles.Subordinate)
                            {
                                <small>@(user.SupervisorEmail ?? "— brak —")</small>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger">Zablokowany</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Aktywny</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@($"/admin/users/{user.Id}")" class="btn btn-sm btn-outline-primary">
                                Edytuj
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <small class="text-muted">Łącznie: @Filtered.Count() użytkowników</small>
}

@if (showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nowy użytkownik</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal" />
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createError))
                    {
                        <div class="alert alert-danger py-2">@createError</div>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label">Imię</label>
                            <input class="form-control" @bind="newUser.FirstName" placeholder="Imię" maxlength="60" />
                        </div>
                        <div class="col">
                            <label class="form-label">Nazwisko</label>
                            <input class="form-control" @bind="newUser.LastName" placeholder="Nazwisko" maxlength="60" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">E-mail</label>
                        <input class="form-control" type="email" @bind="newUser.Email" placeholder="adres@email.pl" maxlength="120" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Hasło</label>
                        <input class="form-control" type="password" @bind="newUser.Password" placeholder="min. 6 znaków" maxlength="128" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Rola</label>
                        <select class="form-select" @bind="newUser.Role">
                            <option value="@Roles.Admin">Administrator</option>
                            <option value="@Roles.Trainer">Trener</option>
                            <option value="@Roles.Subordinate">Asystent trenera</option>
                            <option value="@Roles.Client">Klient</option>
                        </select>
                    </div>

                    @if (newUser.Role == Roles.Subordinate)
                    {
                        <div class="mb-2">
                            <label class="form-label">Przełożony (trener)</label>
                            <select class="form-select" @bind="newUser.SupervisorId">
                                <option value="">— brak —</option>
                                @foreach (var t in trainers)
                                {
                                    <option value="@t.Id">@t.FullName (@t.Email)</option>
                                }
                            </select>
                        </div>
                    }

                    @if (newUser.Role == Roles.Client)
                    {
                        <div class="mb-2">
                            <label class="form-label">Trener</label>
                            <select class="form-select" @bind="newClientTrainerId">
                                <option value="">— wybierz trenera —</option>
                                @foreach (var t in trainers)
                                {
                                    <option value="@t.Id">@t.FullName (@t.Email)</option>
                                }
                            </select>
                            <div class="form-text">Klient pojawi się na liście tego trenera.</div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseCreateModal">Anuluj</button>
                    <button class="btn btn-primary" @onclick="CreateUser" disabled="@createBusy">
                        @if (createBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                        Utwórz konto
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private SoloModeState? _solo;
    private string? _currentUserId;
    private bool _soloBusy, _soloErr, _canSwitchToSolo;
    private string? _soloMsg;

    private async Task LoadSoloAsync()
    {
        try { _solo = await UserService.GetSoloModeAsync(); } catch { _solo = null; }
        _canSwitchToSolo = _solo?.TrainerId is not null && _currentUserId != _solo.TrainerId;
    }

    private async Task ToggleSoloAsync(bool on)
    {
        _soloBusy = true; _soloMsg = null;
        var (ok, error) = await UserService.SetSoloModeAsync(on);
        _soloErr = !ok;
        _soloMsg = ok ? (on ? "Gotowe. Przejdź na swój profil — od teraz to Twoje jedyne konto do pracy." : "Wyłączone. Profil trenera ma znowu tylko uprawnienia trenera.") : error;
        await LoadSoloAsync();
        _soloBusy = false;
    }

    private List<UserDto>? users;
    private List<UserDto> trainers = [];
    private string search = string.Empty;

    private bool showCreateModal;
    private bool createBusy;
    private string createError = string.Empty;
    private CreateUserDto newUser = new();
    private string newClientTrainerId = string.Empty;
    private string? _confirmedEmail;

    private IEnumerable<UserDto> Filtered => users?
        .Where(u => string.IsNullOrEmpty(search) ||
            u.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            u.FullName.Contains(search, StringComparison.OrdinalIgnoreCase))
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        users = await UserService.GetAllUsersAsync();
        trainers = await UserService.GetTrainersAsync();
        _currentUserId = (await AuthState.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadSoloAsync();
    }

    private void OpenCreateModal()
    {
        newUser = new CreateUserDto { Role = Roles.Trainer };
        newClientTrainerId = trainers.Count == 1 ? trainers[0].Id : string.Empty;
        createError = string.Empty;
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private async Task CreateUser()
    {
        createError = string.Empty;

        newUser.Email = PTScheduler.Domain.Rules.EmailRules.Normalize(newUser.Email);
        if (PTScheduler.Domain.Rules.EmailRules.Problem(newUser.Email) is { } emailProblem) { createError = emailProblem; return; }
        if (PTScheduler.Domain.Rules.EmailRules.Suggestion(newUser.Email) is { } suggestion && newUser.Email != _confirmedEmail)
        {
            _confirmedEmail = newUser.Email;
            createError = $"Sprawdź adres — czy chodziło o {suggestion}? Jeśli adres jest dobry, kliknij „Utwórz” jeszcze raz.";
            return;
        }
        if (newUser.Role == Roles.Client && trainers.Count > 0 && string.IsNullOrEmpty(newClientTrainerId)) { createError = "Wybierz trenera klienta."; return; }
        if (string.IsNullOrWhiteSpace(newUser.Password)) { createError = "Hasło jest wymagane."; return; }

        // Plan limit checks — trainers and subordinates are limited by the plan
        if (newUser.Role == Roles.Trainer)
        {
            var (ok, cur, max) = await Entitlements.CheckTrainerLimitAsync(UserManager);
            if (!ok) { createError = $"Osiągnięto limit trenerów w planie {Entitlements.Current.Name} ({cur}/{max}). Zwiększ plan aby dodać więcej."; return; }
        }
        if (newUser.Role == Roles.Subordinate)
        {
            var (ok, cur, max) = await Entitlements.CheckSubordinateLimitAsync(UserManager);
            if (!ok) { createError = $"Osiągnięto limit asystentów w planie {Entitlements.Current.Name} ({cur}/{max}). Zwiększ plan aby dodać więcej."; return; }
        }

        createBusy = true;
        try
        {
            if (newUser.Role == Roles.Client && !string.IsNullOrEmpty(newClientTrainerId))
                newUser.TrainerUserId = newClientTrainerId;

            var (success, error) = await UserService.CreateUserAsync(newUser);
            if (!success)
            {
                createError = error ?? "Nie udało się utworzyć konta.";
                return;
            }

            showCreateModal = false;
            users = await UserService.GetAllUsersAsync();
            trainers = await UserService.GetTrainersAsync();
        }
        catch (Exception ex)
        {
            createError = $"Błąd: {ex.Message}";
        }
        finally
        {
            createBusy = false;
        }
    }

    private static string RoleBadge(string role) => role switch
    {
        Roles.Admin       => "bg-danger",
        Roles.Trainer     => "bg-primary",
        Roles.Subordinate => "bg-info text-dark",
        Roles.Client      => "bg-secondary",
        _                 => "bg-light text-dark"
    };

    private static string RoleLabel(string role) => role switch
    {
        Roles.Admin       => "Administrator",
        Roles.Trainer     => "Trener",
        Roles.Subordinate => "Asystent trenera",
        Roles.Client      => "Klient",
        _                 => "Brak roli"
    };
}

