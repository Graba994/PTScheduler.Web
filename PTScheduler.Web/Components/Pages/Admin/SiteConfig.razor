@page "/admin/site"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = $"{Roles.Admin},{Roles.Trainer}")]
@inject ISiteSettingsService SiteSettings
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<PageTitle>Moduły i strona główna</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-toggles fs-4 text-primary"></i>
    <h2 class="mb-0">Moduły i strona główna</h2>
</div>
<hr />

@if (dto is null)
{
    <p><span class="spinner-border spinner-border-sm me-2" />Ładowanie...</p>
}
else
{
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") py-2">@message</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold"><i class="bi bi-toggles me-2"></i>Aktywne moduły</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="mWelcome" @bind="dto.WelcomeEnabled" />
                        <label class="form-check-label" for="mWelcome">Strona powitalna (landing)</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="mSched" @bind="dto.SchedulerEnabled" />
                        <label class="form-check-label" for="mSched">Kalendarz / grafik</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="mAcad" @bind="dto.AcademyEnabled" />
                        <label class="form-check-label" for="mAcad">Portal szkoleniowy (kursy)</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="mShop" @bind="dto.ShopEnabled" />
                        <label class="form-check-label" for="mShop">Sklep <span class="badge bg-secondary">wkrótce</span></label>
                    </div>
                    <div class="form-text">Wyłączenie modułu ukrywa jego pozycje w menu.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold"><i class="bi bi-window me-2"></i>Treść strony powitalnej</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Nagłówek (hero)</label>
                        <input class="form-control" @bind="dto.HeroHeadline" placeholder="np. odNowa – nowe życie, nowa energia" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Podtytuł</label>
                        <input class="form-control" @bind="dto.HeroSubheadline"
                               placeholder="np. Mentoring żywieniowy, który kończy Twoją historię wiecznych diet." />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tekst przycisku CTA</label>
                            <input class="form-control" @bind="dto.HeroCtaLabel" placeholder="np. Zamów mentoring" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Link przycisku CTA</label>
                            <input class="form-control" @bind="dto.HeroCtaUrl" placeholder="https://..." />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">URL obrazka hero <span class="text-muted small">(opcjonalnie)</span></label>
                        <input class="form-control" @bind="dto.HeroImageUrl" placeholder="https://..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Treść strony (HTML)</label>
                        <textarea class="form-control font-monospace" rows="10" @bind="dto.BodyHtml"
                                  placeholder="&lt;h2&gt;Co znajdziesz w środku&lt;/h2&gt;&lt;p&gt;...&lt;/p&gt;"></textarea>
                        <div class="form-text">Dozwolony HTML. Sekcje, listy, akapity — pełna dowolność.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-mail kontaktowy</label>
                        <input class="form-control" type="email" @bind="dto.ContactEmail" placeholder="kontakt@..." />
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="Save" disabled="@busy">
                            <i class="bi bi-floppy me-1"></i>Zapisz
                        </button>
                        <a href="/" target="_blank" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Zobacz stronę
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private SiteSettingsDto? dto;
    private bool busy;
    private string message = string.Empty;
    private bool isError;

    protected override async Task OnInitializedAsync() => dto = await SiteSettings.GetAsync();

    private async Task Save()
    {
        if (dto is null) return;
        busy = true; message = string.Empty;
        try
        {
            await SiteSettings.SaveAsync(dto);
            message = "Zapisano."; isError = false;
        }
        catch (Exception ex) { message = $"Błąd: {ex.Message}"; isError = true; }
        finally { busy = false; }
    }
}
