@page "/admin/email"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IEmailSettingsService SettingsService
@inject IEmailService EmailService
@inject AuthenticationStateProvider AuthState
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Konfiguracja emaili" />

<div class="cal-shell">
    <div class="cal-topbar">
        <h4 class="mb-0 fw-bold">
            <i class="bi bi-envelope-fill me-2"></i>Konfiguracja emaili
        </h4>
    </div>

    <div class="cal-body">
        <div class="cal-main" style="overflow-y:auto;padding:1.5rem">

            @if (_loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else
            {
                @if (_managed && _platformMode)
                {
                    <!-- Instancja zarządzana: wysyłka przez serwer platformy, bez konfiguracji SMTP -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <strong>E-maile wysyłają się automatycznie</strong>
                            </div>
                            <p class="small text-muted mb-3">
                                Przypomnienia, potwierdzenia i faktury wychodzą z serwera platformy — nie musisz niczego konfigurować.
                                Klienci widzą nazwę Twojego studia jako nadawcę, a odpowiedzi trafiają na Twój adres.
                                @if (_quota is { } q)
                                {
                                    <span class="d-block mt-1">Dziś wysłano <strong>@q.SentToday</strong> z @q.Limit e-maili (limit dzienny).</span>
                                }
                            </p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Nazwa nadawcy</label>
                                    <input class="form-control" @bind="_dto.FromName" placeholder="np. Studio Jana Kowalskiego" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Odpowiedzi klientów wysyłaj na</label>
                                    <input type="email" class="form-control" @bind="_dto.ReplyTo" placeholder="twoj@email.pl" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Wyślij testowy e-mail na</label>
                                    <input type="email" class="form-control" @bind="_testEmail" />
                                </div>
                                <div class="col-md-6 d-flex align-items-end gap-2">
                                    <button class="btn btn-primary" @onclick="SavePlatformAsync" disabled="@(_saving || _testing)">
                                        <i class="bi bi-floppy-fill me-1"></i>Zapisz
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="TestEmailAsync" disabled="@(_saving || _testing || string.IsNullOrWhiteSpace(_testEmail))">
                                        @if (_testing && !_showOwn) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        Wyślij test
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_message) && !_showOwn)
                            {
                                <div class="alert @(_messageOk ? "alert-success" : "alert-danger") py-2 small mt-3 mb-0">@_message</div>
                            }
                        </div>
                    </div>

                    @if (!_showOwn)
                    {
                        <!-- Zachęta: własna skrzynka zamiast serwera platformy -->
                        <div class="card mb-3">
                            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:44px;height:44px;background:rgba(2,132,199,.1);color:var(--bs-primary);font-size:1.25rem">
                                    <i class="bi bi-envelope-at-fill"></i>
                                </div>
                                <div style="flex:1 1 260px;min-width:0">
                                    <div class="fw-semibold">Wysyłaj z własnej skrzynki</div>
                                    <div class="small text-muted">
                                        Podłącz swoją pocztę — Google Workspace, Microsoft 365, Gmail, Brevo albo skrzynkę z hostingu.
                                        Klienci dostaną e-maile prosto z Twojego adresu i nie będą się liczyć do limitu platformy.
                                        Najpierw wyślemy test, a gdyby skrzynka kiedyś przestała działać, wiadomości pójdą awaryjnie przez serwer platformy.
                                    </div>
                                </div>
                                <button class="btn btn-outline-primary" @onclick="OpenOwn">
                                    <i class="bi bi-plug-fill me-1"></i>Podłącz skrzynkę
                                </button>
                            </div>
                        </div>
                    }
                }
                else if (_managed)
                {
                    <!-- Instancja zarządzana z własną skrzynką trenera (awaryjnie serwer platformy) -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <i class="bi bi-envelope-check-fill text-success fs-5"></i>
                                <strong>E-maile wychodzą z Twojej skrzynki</strong>
                                <span class="badge rounded-pill text-bg-light border">@_dto.FromAddress</span>
                            </div>
                            <p class="small text-muted mb-3">
                                Przypomnienia, potwierdzenia i faktury wysyła serwer <code>@_dto.SmtpHost</code>.
                                Gdyby Twoja skrzynka chwilowo nie działała, aplikacja wyśle wiadomość awaryjnie przez serwer platformy — nic nie zginie.
                            </p>
                            @if (_dto.OwnFailing(DateTime.UtcNow))
                            {
                                <div class="alert alert-warning small py-2 mb-3">
                                    <div class="fw-semibold mb-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Twoja skrzynka zgłosiła błąd (@_dto.LastErrorAt!.Value.ToLocalTime().ToString("d.MM HH:mm"))
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_dto.LastError))
                                    {
                                        <div class="mb-1">@_dto.LastError</div>
                                    }
                                    @if (_dto.FallbackCount > 0)
                                    {
                                        <div class="mb-1">Wysłane awaryjnie przez serwer platformy: <strong>@_dto.FallbackCount</strong>.</div>
                                    }
                                    Sprawdź dane w „Zmień ustawienia” albo wróć do poczty platformy.
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-outline-primary" @onclick="ToggleOwn" disabled="@(_saving || _testing)">
                                    <i class="bi @(_showOwn ? "bi-chevron-up" : "bi-sliders") me-1"></i>@(_showOwn ? "Ukryj ustawienia" : "Zmień ustawienia")
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ReturnToPlatformAsync" disabled="@(_saving || _testing)">
                                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    else { <i class="bi bi-arrow-counterclockwise me-1"></i> }
                                    Wróć do poczty platformy
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_message) && !_showOwn)
                            {
                                <div class="alert @(_messageOk ? "alert-success" : "alert-danger") py-2 small mt-3 mb-0">@_message</div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- Enable toggle -->
                    <div class="card mb-4">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="enableEmail"
                                       @bind="_dto.IsEnabled" style="width:2.5em;height:1.3em" />
                                <label class="form-check-label fw-semibold fs-6" for="enableEmail">
                                    Włącz wysyłanie emaili
                                </label>
                            </div>
                            <span class="text-muted small">
                                @if (_dto.IsEnabled)
                                {
                                    <span class="badge bg-success">Aktywne</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Wyłączone</span>
                                }
                            </span>
                        </div>
                    </div>
                }

                @if (!_managed || _showOwn)
                {
                <!-- Provider selection -->
                <div class="card mb-4">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-server me-2"></i>Wybierz dostawcę poczty
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-4">
                            @foreach (var p in _providers)
                            {
                                var isSelected = _dto.Provider == p.Key;
                                <div class="col-6 col-md-4 col-xl">
                                    <div class="p-3 rounded-3 border h-100 @(isSelected ? "border-primary" : "border-2")"
                                         style="cursor:pointer;transition:all .15s;
                                                background:@(isSelected ? "rgba(2,132,199,.06)" : "var(--bs-body-bg)")"
                                         @onclick="() => SelectProvider(p.Key)">
                                        <div class="d-flex flex-column align-items-center text-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width:48px;height:48px;background:@p.Value.Color;color:white;font-size:1.3rem">
                                                <i class="bi @p.Value.Icon"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold small">@p.Value.Name</div>
                                                <div class="text-muted" style="font-size:.7rem">@p.Value.Tagline</div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <i class="bi bi-check-circle-fill text-primary"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Setup guide for selected provider -->
                        @if (_providers.TryGetValue(_dto.Provider, out var prov))
                        {
                            <div class="p-3 rounded-3 mb-2"
                                 style="background:rgba(2,132,199,.05);border:1px solid rgba(2,132,199,.2)">
                                <div class="fw-semibold mb-3">
                                    <i class="bi bi-info-circle-fill text-primary me-2"></i>
                                    Jak skonfigurować @prov.Name — krok po kroku
                                </div>
                                <ol class="mb-0 ps-3" style="font-size:.875rem;line-height:1.9">
                                    @foreach (var step in prov.Steps)
                                    {
                                        <li>@((MarkupString)step)</li>
                                    }
                                </ol>
                                @if (!string.IsNullOrEmpty(prov.Note))
                                {
                                    <div class="mt-3 small text-muted">
                                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>@((MarkupString)prov.Note)
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- SMTP settings form -->
                <div class="card mb-4">
                    <div class="card-header fw-semibold d-flex align-items-center gap-2">
                        <i class="bi bi-sliders me-2"></i>Dane połączenia SMTP
                        <HintButton Title="Dane SMTP" Text="SMTP to protokół wysyłania e-maili. Dane znajdziesz w panelu swojego dostawcy poczty (np. Gmail → Ustawienia → Przekazywanie i POP/IMAP). Używaj App Password zamiast hasła do konta dla większego bezpieczeństwa." />
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold small mb-1">Serwer SMTP (Host)</label>
                                <input type="text" class="form-control" @bind="_dto.SmtpHost"
                                       placeholder="np. smtp.gmail.com" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold small mb-1">Port</label>
                                <select class="form-select" @bind="_dto.SmtpPort">
                                    <option value="587">587 (TLS)</option>
                                    <option value="465">465 (SSL)</option>
                                    <option value="2525">2525 (TLS)</option>
                                    <option value="25">25 (brak)</option>
                                    @if (_dto.SmtpPort is not (587 or 465 or 2525 or 25))
                                    {
                                        <option value="@_dto.SmtpPort">@_dto.SmtpPort</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end pb-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="tls" @bind="_dto.UseTls" />
                                    <label class="form-check-label small" for="tls">Szyfrowanie TLS <HintButton Text="TLS (Transport Layer Security) szyfruje połączenie z serwerem SMTP. Prawie zawsze powinno być włączone. Wyłącz tylko jeśli Twój serwer tego wymaga (bardzo rzadkie)." /></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small mb-1">Login (email konta SMTP)</label>
                                <input type="email" class="form-control" @bind="_dto.Login"
                                       placeholder="np. kontakt@twojadomena.pl" autocomplete="username" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small mb-1">
                                    Hasło / App Password <HintButton Title="App Password" Text="Dla Gmail i Microsoft 365 użyj specjalnego App Password (hasła aplikacji), nie hasła do konta. Wygeneruj je w ustawieniach bezpieczeństwa konta pocztowego → Weryfikacja dwuetapowa → Hasła aplikacji." />
                                    <span class="text-muted fw-normal">(zostaw puste, aby nie zmieniać)</span>
                                </label>
                                <div class="input-group">
                                    <input type="@(_showPassword ? "text" : "password")"
                                           class="form-control" @bind="_dto.Password"
                                           autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button"
                                            @onclick="() => _showPassword = !_showPassword">
                                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small mb-1">Adres nadawcy (From)</label>
                                <input type="email" class="form-control" @bind="_dto.FromAddress"
                                       placeholder="np. noreply@twojadomena.pl" />
                                <div class="form-text">Adres widoczny w skrzynce odbiorczej klienta</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small mb-1">Nazwa nadawcy</label>
                                <input type="text" class="form-control" @bind="_dto.FromName"
                                       placeholder="np. Studio Jana Kowalskiego" />
                                <div class="form-text">Nazwa widoczna w skrzynce odbiorczej</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (_managed)
                {
                    <!-- Sprawdzenie skrzynki: test przed włączeniem -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Wyślij test na</label>
                                    <input type="email" class="form-control" @bind="_testEmail" placeholder="twoj@email.com" />
                                </div>
                                <div class="col-md-6 d-flex flex-wrap gap-2">
                                    <button class="btn btn-primary" @onclick="VerifyAndEnableAsync"
                                            disabled="@(_saving || _testing || string.IsNullOrWhiteSpace(_testEmail))">
                                        @if (_testing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        else { <i class="bi bi-shield-check me-1"></i> }
                                        @(_platformMode ? "Sprawdź i włącz" : "Sprawdź i zapisz")
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="CancelOwn" disabled="@(_saving || _testing)">Anuluj</button>
                                </div>
                            </div>
                            <div class="form-text mt-2">
                                Najpierw wyślemy test z Twojej skrzynki. Zapiszemy ustawienia tylko wtedy, gdy serwer go przyjmie —
                                do tego czasu e-maile wychodzą jak dotąd.
                            </div>
                            @if (!string.IsNullOrEmpty(_message))
                            {
                                <div class="alert @(_messageOk ? "alert-success" : "alert-danger") py-2 small mt-3 mb-0">
                                    <i class="bi @(_messageOk ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>@_message
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                <!-- Actions -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold small mb-1">Testowy email (wyślij na adres)</label>
                                <div class="input-group">
                                    <input type="email" class="form-control" @bind="_testEmail"
                                           placeholder="twoj@email.com" />
                                    <button class="btn btn-outline-primary" @onclick="TestEmailAsync"
                                            disabled="@(_saving || string.IsNullOrWhiteSpace(_testEmail))">
                                        @if (_testing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-send me-1"></i>
                                        }
                                        Wyślij test
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end gap-2">
                                <button class="btn btn-primary" @onclick="SaveAsync"
                                        disabled="@(_saving || _testing)">
                                    @if (_saving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-floppy-fill me-1"></i>
                                    }
                                    Zapisz ustawienia
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_message))
                        {
                            <div class="alert @(_messageOk ? "alert-success" : "alert-danger") py-2 small mt-3 mb-0">
                                <i class="bi @(_messageOk ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>
                                @_message
                            </div>
                        }
                    </div>
                </div>
                }

                <!-- Info box -->
                <div class="card border-0" style="background:var(--bs-tertiary-bg)">
                    <div class="card-body small text-muted">
                        <i class="bi bi-shield-lock me-2"></i>
                        <strong class="me-1">Bezpieczeństwo:</strong>
                        @if (_managed)
                        {
                            <text>Hasło zostaje w Twojej instancji i służy tylko do wysyłki. Użyj <strong>hasła aplikacji</strong> zamiast głównego hasła do konta — w każdej chwili możesz je unieważnić u dostawcy poczty.</text>
                        }
                        else
                        {
                            <text>Hasło SMTP jest przechowywane w bazie danych w postaci niezaszyfrowanej.
                            Upewnij się, że dostęp do bazy danych jest odpowiednio zabezpieczony.
                            Zalecane jest użycie <strong>App Password</strong> (hasła aplikacji) zamiast głównego hasła do konta.</text>
                        }
                    </div>
                </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private EmailSettingsDto _dto = new();
    private bool _loading = true;
    private bool _saving;
    private bool _testing;
    private bool _showPassword;
    private string _testEmail = "";
    private string _message = "";
    private bool _messageOk;

    private record ProviderInfo(string Name, string Tagline, string Icon, string Color, List<string> Steps, string Note = "");

    private readonly Dictionary<string, ProviderInfo> _providers = new()
    {
        ["GoogleWorkspace"] = new(
            "Google Workspace",
            "Gmail dla firm",
            "bi-google",
            "#EA4335",
            [
                "Zaloguj się na <strong>admin.google.com</strong> → Katalog → Użytkownicy → Twoje konto → Informacje → dodaj alias <code>noreply@twojadomena.pl</code>",
                "Na koncie Google (<strong>myaccount.google.com</strong>) włącz <strong>Weryfikację dwuetapową</strong> (jeśli jeszcze nie aktywna)",
                "Przejdź do <strong>Bezpieczeństwo → Weryfikacja dwuetapowa → Hasła do aplikacji</strong>",
                "Kliknij <strong>Utwórz hasło do aplikacji</strong>, wpisz nazwę np. \"Hantly\" → skopiuj 16-znakowy kod",
                "W formularzu poniżej wpisz: Host <code>smtp.gmail.com</code>, Port <code>587</code>, Login = Twój główny email, Hasło = skopiowany 16-znakowy kod, From = alias <code>noreply@twojadomena.pl</code>"
            ],
            "Alias musi być ustawiony w Google Admin Console, bo Gmail pozwala wysyłać tylko z adresów przypisanych do konta."
        ),
        ["Microsoft365"] = new(
            "Microsoft 365",
            "Outlook dla firm",
            "bi-microsoft",
            "#0078D4",
            [
                "Zaloguj się do <strong>admin.microsoft.com</strong> → Użytkownicy → Aktywni użytkownicy → Twoje konto → Zarządzaj nazwami użytkowników",
                "Dodaj alias np. <code>noreply@twojadomena.pl</code> jeśli chcesz inny adres nadawcy",
                "Przejdź do <strong>portal.azure.com</strong> → Azure Active Directory → Użytkownicy → Twoje konto",
                "Włącz <strong>uwierzytelnianie wieloskładnikowe (MFA)</strong> jeśli nie jest aktywne",
                "Na <strong>mysignins.microsoft.com</strong> → Informacje zabezpieczające → Dodaj metodę → Hasło aplikacji → nadaj nazwę \"Hantly\" → skopiuj hasło",
                "W formularzu: Host <code>smtp.office365.com</code>, Port <code>587</code>, Login = email konta Microsoft, Hasło = hasło aplikacji"
            ],
            "Microsoft 365 wymaga włączenia SMTP AUTH dla konta. Jeśli test się nie powiedzie, sprawdź w admin.microsoft.com → Ustawienia → Poczta → Uwierzytelnianie SMTP."
        ),
        ["Gmail"] = new(
            "Gmail",
            "Prywatna skrzynka",
            "bi-envelope-fill",
            "#C5221F",
            [
                "Zaloguj się na <strong>myaccount.google.com</strong> i w <strong>Bezpieczeństwo</strong> włącz <strong>Weryfikację dwuetapową</strong>",
                "Wyszukaj <strong>„Hasła do aplikacji”</strong>, utwórz hasło o nazwie np. \"Hantly\" i skopiuj 16-znakowy kod",
                "W formularzu: Host <code>smtp.gmail.com</code>, Port <code>587</code>, Login i adres nadawcy = Twój adres <code>@gmail.com</code>, Hasło = skopiowany kod"
            ],
            "Prywatny Gmail wysyła tylko z Twojego adresu @gmail.com i ma limit około 500 wiadomości dziennie. Przy własnej domenie wybierz Google Workspace albo Brevo."
        ),
        ["Brevo"] = new(
            "Brevo",
            "300 emaili/dzień za darmo",
            "bi-envelope-check-fill",
            "#0B996E",
            [
                "Załóż bezpłatne konto na <strong>brevo.com</strong> (bez karty kredytowej)",
                "Po zalogowaniu przejdź do <strong>Ustawienia → SMTP & API → SMTP</strong>",
                "Skopiuj <strong>Serwer SMTP, Port, Login i Klucz SMTP</strong>",
                "(Opcjonalnie) Zweryfikuj swoją domenę w <strong>Senders & IP → Domains</strong> — dzięki temu emaile będą wychodzić z <code>noreply@twojadomena.pl</code>",
                "Wklej dane do formularza poniżej. Login to Twój email w Brevo, hasło to <strong>klucz SMTP</strong> (nie hasło do konta Brevo)"
            ],
            "Darmowy plan Brevo daje 300 emaili dziennie — w zupełności wystarczy dla małej aplikacji treningowej."
        ),
        ["Custom"] = new(
            "Hosting / inny",
            "home.pl, OVH, nazwa.pl…",
            "bi-hdd-network-fill",
            "#6366f1",
            [
                "W panelu hostingu (home.pl, OVH, nazwa.pl, cyber_Folks itp.) otwórz ustawienia skrzynki — znajdziesz tam dane <strong>SMTP</strong> (serwer poczty wychodzącej)",
                "Typowe dane: host np. <code>mail.twojadomena.pl</code> albo nazwa serwera z panelu, port <code>587</code> (TLS) lub <code>465</code> (SSL), login = pełny adres e-mail, hasło do skrzynki",
                "Wpisz dane w formularzu poniżej i wyślij test"
            ],
            "Jeśli test nie przejdzie, poproś dostawcę hostingu o „dane do wysyłki SMTP z aplikacji” — czasem trzeba ją włączyć w panelu."
        )
    };

    // Instancja zarządzana przez Portal: domyślnie serwer platformy, opcjonalnie własna skrzynka trenera
    // (sprawdzona testem przed włączeniem, z awaryjną wysyłką przez platformę).
    private bool _managed;
    private bool _platformMode;
    private bool _showOwn;
    private (int Limit, int SentToday)? _quota;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        var auth = await AuthState.GetAuthenticationStateAsync();
        _testEmail = auth.User.Identity?.Name ?? "";
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _dto = await SettingsService.GetAsync();
        _platformMode = await EmailService.GetDeliveryModeAsync() == "platform";
        _quota = await EmailService.GetPlatformQuotaAsync();
        _managed = _quota is not null;
        if (_platformMode && string.IsNullOrWhiteSpace(_dto.ReplyTo))
        {
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            _dto.ReplyTo = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? user.Identity?.Name;
        }
    }

    private void OpenOwn()
    {
        _showOwn = true;
        _message = "";
        if (!_providers.ContainsKey(_dto.Provider) || string.IsNullOrWhiteSpace(_dto.SmtpHost)) SelectProvider("GoogleWorkspace");
    }

    private void ToggleOwn()
    {
        _showOwn = !_showOwn;
        _message = "";
    }

    private async Task CancelOwn()
    {
        _showOwn = false;
        _message = "";
        await LoadAsync(); // porzucamy niezapisane zmiany w formularzu
    }

    /// <summary>Test z danymi z formularza (bez zapisu); zapis i włączenie dopiero, gdy serwer przyjmie wiadomość.</summary>
    private async Task VerifyAndEnableAsync()
    {
        if (string.IsNullOrWhiteSpace(_testEmail)) return;
        _testing = true;
        _message = "";
        try
        {
            var (ok, error) = await EmailService.TestOwnAsync(_dto, _testEmail);
            if (!ok)
            {
                _messageOk = false;
                _message = $"Test nie przeszedł: {error} Ustawienia nie zostały zapisane — e-maile wychodzą jak dotąd.";
                return;
            }
            var wasPlatform = _platformMode;
            _dto.IsEnabled = true;
            await SettingsService.SaveAsync(_dto);
            await LoadAsync();
            _showOwn = false;
            _messageOk = true;
            _message = wasPlatform
                ? $"Gotowe! Test wysłany na {_testEmail}. Od teraz e-maile wychodzą z adresu {_dto.FromAddress}."
                : $"Zapisano. Test wysłany na {_testEmail}.";
        }
        catch (Exception ex)
        {
            _messageOk = false;
            _message = $"Błąd: {ex.Message}";
        }
        finally { _testing = false; }
    }

    private async Task ReturnToPlatformAsync()
    {
        _saving = true;
        _message = "";
        try
        {
            // Dane skrzynki zostają zapisane — można do nich wrócić jednym kliknięciem.
            _dto.IsEnabled = false;
            await SettingsService.SaveAsync(_dto);
            await LoadAsync();
            _showOwn = false;
            _messageOk = true;
            _message = "E-maile znów wychodzą przez serwer platformy.";
        }
        catch (Exception ex) { _messageOk = false; _message = $"Błąd zapisu: {ex.Message}"; }
        finally { _saving = false; }
    }

    private void SelectProvider(string key)
    {
        _dto.Provider = key;
        if (key is "GoogleWorkspace" or "Gmail") { _dto.SmtpHost = "smtp.gmail.com"; _dto.SmtpPort = 587; _dto.UseTls = true; }
        if (key == "Microsoft365")    { _dto.SmtpHost = "smtp.office365.com";   _dto.SmtpPort = 587; _dto.UseTls = true; }
        if (key == "Brevo")           { _dto.SmtpHost = "smtp-relay.brevo.com"; _dto.SmtpPort = 587; _dto.UseTls = true; }
        if (key == "Custom")          { _dto.SmtpHost = "";                      _dto.SmtpPort = 587; _dto.UseTls = true; }
        _message = "";
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = "";
        try
        {
            await SettingsService.SaveAsync(_dto);
            _messageOk = true;
            _message = "Ustawienia zapisane pomyślnie.";
        }
        catch (Exception ex)
        {
            _messageOk = false;
            _message = $"Błąd zapisu: {ex.Message}";
        }
        finally { _saving = false; }
    }

    private async Task SavePlatformAsync()
    {
        _saving = true; _message = "";
        try
        {
            // Własny SMTP pozostaje wyłączony — zapisujemy tylko nadawcę i adres odpowiedzi.
            _dto.IsEnabled = false;
            await SettingsService.SaveAsync(_dto);
            _messageOk = true; _message = "Zapisano.";
        }
        catch (Exception ex) { _messageOk = false; _message = $"Błąd zapisu: {ex.Message}"; }
        finally { _saving = false; }
    }

    private async Task TestEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(_testEmail)) return;
        _testing = true;
        _message = "";
        try
        {
            if (_platformMode) _dto.IsEnabled = false;
            await SettingsService.SaveAsync(_dto);
            var (success, error) = await EmailService.TestAsync(_testEmail);
            _messageOk = success;
            _message = success
                ? $"✓ Testowy email wysłany na {_testEmail}. Sprawdź skrzynkę odbiorczą."
                : $"✗ Błąd połączenia: {error}";
        }
        catch (Exception ex)
        {
            _messageOk = false;
            _message = $"Błąd: {ex.Message}";
        }
        finally { _testing = false; }
    }
}
