@page "/admin/backup"
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]
@inject NavigationManager Nav
@inject IBackupService BackupService
@inject IDatabaseMaintenanceService MaintenanceService
@inject ILogger<Backup> Logger
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<PageTitle>Backup / Restore</PageTitle>

<h2>Backup / Restore</h2>
<hr />

<div class="row g-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Eksport (Backup)</h5>
                <p class="text-muted small">
                    Pobiera pełny dump bazy PostgreSQL za pomocą <code>pg_dump</code>.
                    Na serwerze muszą być zainstalowane narzędzia klienta PostgreSQL.
                </p>
                @if (!string.IsNullOrEmpty(exportError))
                {
                    <div class="alert alert-danger py-2 small">@exportError</div>
                }
                <button class="btn btn-success" @onclick="DownloadBackup" disabled="@exportBusy">
                    @if (exportBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                    Pobierz backup (.sql)
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Import (Restore)</h5>
                <p class="text-muted small text-danger fw-semibold">
                    Uwaga: restore nadpisuje dane w bazie. Operacja jest nieodwracalna.
                </p>
                <div class="mb-3">
                    <label class="form-label">Plik .sql</label>
                    <InputFile OnChange="OnFileSelected" accept=".sql" class="form-control" />
                </div>
                @if (!string.IsNullOrEmpty(importMessage))
                {
                    <div class="alert @(importSuccess ? "alert-success" : "alert-danger") py-2 small">
                        @importMessage
                    </div>
                }
                <button class="btn btn-danger" @onclick="Restore"
                        disabled="@(importBusy || selectedFile is null)">
                    @if (importBusy) { <span class="spinner-border spinner-border-sm me-1" /> }
                    Przywróć bazę
                </button>
            </div>
        </div>
    </div>
</div>

<hr class="my-4" />
<h4 class="mb-3"><i class="bi bi-trash3 me-2 text-danger"></i>Reset danych</h4>

<div class="row">
    <div class="col-md-7">
        <div class="card border-danger">
            <div class="card-body">
                <h5 class="card-title text-danger">Wyczyść bazę danych</h5>
                <p class="text-muted small mb-2">
                    Usuwa <strong>wszystkich klientów, sesje, pakiety, notatki i pomiary</strong>.
                    Konta trenerów i administratorów oraz typy sesji zostają zachowane.
                    Przydatne do testów i symulacji nowej instalacji.
                </p>
                <div class="alert alert-warning py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Operacja jest <strong>nieodwracalna</strong>. Zalecamy wykonanie backupu przed czyszczeniem.
                </div>

                @if (clearResult is not null)
                {
                    <div class="alert alert-success py-2 small mb-3">
                        <i class="bi bi-check-circle me-1"></i>Baza wyczyszczona.
                        Usunięto: <strong>@clearResult.Clients klientów</strong>,
                        @clearResult.Sessions sesji, @clearResult.Packages pakietów,
                        @clearResult.Notes notatek, @clearResult.Measurements pomiarów,
                        @clearResult.ClientUsers kont użytkowników.
                    </div>
                }

                @if (!string.IsNullOrEmpty(clearError))
                {
                    <div class="alert alert-danger py-2 small mb-3">@clearError</div>
                }

                @if (!confirmClearVisible)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmClearVisible = true">
                        <i class="bi bi-trash3 me-1"></i>Wyczyść bazę danych...
                    </button>
                }
                else
                {
                    <div class="border border-danger rounded p-3">
                        <p class="small fw-semibold mb-2">Wpisz <code>RESET</code> aby potwierdzić:</p>
                        <div class="input-group input-group-sm mb-2">
                            <input class="form-control" placeholder="RESET" @bind="confirmText" @bind:event="oninput" />
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-danger btn-sm"
                                    disabled="@(confirmText != "RESET" || clearBusy)"
                                    @onclick="ExecuteClear">
                                @if (clearBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-trash3-fill me-1"></i>Tak, wyczyść teraz
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => { confirmClearVisible = false; confirmText = string.Empty; }">
                                Anuluj
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool exportBusy;
    private string exportError = string.Empty;

    private bool importBusy;
    private string importMessage = string.Empty;
    private bool importSuccess;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedFile;

    private bool confirmClearVisible;
    private string confirmText = string.Empty;
    private bool clearBusy;
    private string clearError = string.Empty;
    private ClearDataResult? clearResult;

    private void OnFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importMessage = string.Empty;
    }

    private void DownloadBackup()
    {
        exportError = string.Empty;
        exportBusy = true;
        try
        {
            Nav.NavigateTo("/admin/backup/download", forceLoad: true);
        }
        catch (Exception ex)
        {
            exportError = ex.Message;
        }
        finally
        {
            exportBusy = false;
        }
    }

    private async Task Restore()
    {
        if (selectedFile is null) return;
        importBusy = true;
        importMessage = string.Empty;
        try
        {
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            await BackupService.ImportAsync(stream);
            importSuccess = true;
            importMessage = "Restore zakończony pomyślnie.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restore failed");
            importSuccess = false;
            importMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            importBusy = false;
        }
    }

    private async Task ExecuteClear()
    {
        if (confirmText != "RESET") return;
        clearBusy = true;
        clearError = string.Empty;
        clearResult = null;
        try
        {
            clearResult = await MaintenanceService.ClearAllDataAsync();
            confirmClearVisible = false;
            confirmText = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Database clear failed");
            clearError = $"Błąd: {ex.Message}";
        }
        finally
        {
            clearBusy = false;
        }
    }
}
