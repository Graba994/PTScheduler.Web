@page "/admin/push"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IWebPushService PushService
@inject EntitlementService Entitlements
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Powiadomienia push" />

<div class="cal-shell">
    <div class="cal-topbar">
        <h4 class="mb-0 fw-bold">
            <i class="bi bi-bell-fill me-2"></i>Powiadomienia push (Web Push)
        </h4>
    </div>

    <div class="cal-body">
        <div class="cal-main" style="overflow-y:auto;padding:1.5rem">

            @if (!Entitlements.IsAllowed("PushNotifications"))
            {
                <FeatureGate Flag="PushNotifications" RequiredPlan="Pro"
                             Title="Powiadomienia push są dostępne w planie Pro">
                    <Description>
                        Wysyłaj klientom natychmiastowe powiadomienia w przeglądarce i aplikacji PWA. Odblokuj w planie <strong>Pro</strong> lub wyższym.
                    </Description>
                </FeatureGate>
            }
            else if (_loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else
            {
                <div class="alert alert-success small d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Powiadomienia push są skonfigurowane automatycznie. Klienci włączają je w swoim profilu albo po zainstalowaniu aplikacji.</span>
                </div>

                <div class="card mb-4">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-send-fill me-2"></i>Wyślij testowe powiadomienie
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            Wyślij powiadomienie push do wszystkich subskrybentów, aby sprawdzić czy konfiguracja działa.
                        </p>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Tytuł</label>
                                <input type="text" class="form-control form-control-sm" @bind="_testTitle" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Treść</label>
                                <input type="text" class="form-control form-control-sm" @bind="_testBody" />
                            </div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm" @onclick="SendTestAsync" disabled="@_sendingTest">
                            @if (_sendingTest) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            <i class="bi bi-send me-1"></i>Wyślij test
                        </button>
                    </div>
                </div>

                @if (_message is not null)
                {
                    <div class="alert @(_messageSuccess ? "alert-success" : "alert-danger") small">
                        @_message
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool _loading = true;
    private bool _sendingTest;
    private WebPushSettingsDto _dto = new();
    private string _testTitle = "Test PTScheduler";
    private string _testBody = "Powiadomienia push działają poprawnie!";
    private string? _message;
    private bool _messageSuccess;

    protected override async Task OnInitializedAsync()
    {
        _dto = await PushService.GetSettingsAsync();
        _loading = false;
    }



    private async Task SendTestAsync()
    {
        _sendingTest = true;
        _message = null;
        try
        {
            await PushService.SendToAllAsync(new PushMessageDto
            {
                Title = _testTitle,
                Body = _testBody,
                Url = "/"
            });
            _message = "Powiadomienie testowe wysłane.";
            _messageSuccess = true;
        }
        catch (Exception ex)
        {
            _message = $"Błąd: {ex.Message}";
            _messageSuccess = false;
        }
        finally { _sendingTest = false; }
    }
}
