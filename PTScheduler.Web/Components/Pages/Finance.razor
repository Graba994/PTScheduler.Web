@page "/finance"
@rendermode PTScheduler.Web.RenderModes.Server
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@using PTScheduler.Domain.Constants
@inject ISessionPackageService PackageService
@inject IPaymentService PaymentService
@inject IReceiptService ReceiptService
@inject IFinanceService FinanceService
@inject IPermissionService PermissionService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject EntitlementService Entitlements
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")]

@if (!Entitlements.IsAllowed("FinancialReports"))
{
    <div class="page-header">
        <h4 class="page-title"><i class="bi bi-currency-dollar me-2" style="color:var(--c-primary)"></i>Finanse</h4>
    </div>
    <FeatureGate Flag="FinancialReports" RequiredPlan="Pro"
                 Title="Raporty finansowe są dostępne w planie Pro">
        <Description>
            Analiza przychodów, wydatków, prognozy MRR, raporty podatkowe. Odblokuj w planie <strong>Pro</strong> lub <strong>Studio</strong>.
        </Description>
    </FeatureGate>
}
else if (!_loaded)
{
    <div class="page-header mb-3">
        <div class="skeleton skeleton-line w-40" style="height:24px;margin-bottom:0"></div>
        <div class="skeleton" style="width:100px;height:32px;border-radius:8px"></div>
    </div>
    <div class="row g-3 mb-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-6 col-xl-3">
                <div class="skeleton-stat">
                    <div class="skeleton skeleton-circle" style="width:40px;height:40px"></div>
                    <div style="flex:1">
                        <div class="skeleton skeleton-line w-40" style="height:20px"></div>
                        <div class="skeleton skeleton-line w-75" style="height:10px;margin-bottom:0"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="skeleton-card" style="height:200px"></div>
}
else
{
    <div class="page-header">
        <h4 class="page-title"><i class="bi bi-currency-dollar me-2" style="color:var(--c-primary)"></i>Finanse</h4>
        <div class="d-flex gap-2 align-items-center">
            @if (_canViewHidden)
            {
                <a href="/finance/hidden" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-eye-slash me-1"></i>Ukryte
                </a>
            }
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn @(_months == 6 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(6)">6M</button>
                <button type="button" class="btn @(_months == 12 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(12)">12M</button>
                <button type="button" class="btn @(_months == 24 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(24)">2 lata</button>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="stat-value">@_packages.Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Łączna wartość</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_packages.Where(p => p.IsPaid).Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Opłacone</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-red"><i class="bi bi-exclamation-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_unpaid.Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Nieopłacone</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-blue"><i class="bi bi-box-seam-fill"></i></div>
                <div>
                    <div class="stat-value">@_packages.Count(p => p.Status == PackageStatus.Active)</div>
                    <div class="stat-label">Aktywnych pakietów</div>
                </div>
            </div>
        </div>
    </div>

    @if (_onlineOrders.Count > 0)
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(16,185,129,.12);color:#10b981"><i class="bi bi-cart-check-fill"></i></div>
                    <div>
                        <div class="stat-value">@_onlineOrders.Sum(o => o.Amount).ToString("N0") @(_onlineOrders.FirstOrDefault()?.Currency ?? "PLN")</div>
                        <div class="stat-label">Płatności online</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(99,102,241,.12);color:#6366f1"><i class="bi bi-mortarboard-fill"></i></div>
                    <div>
                        <div class="stat-value">@_onlineOrders.Count(o => o.Kind == "Course")</div>
                        <div class="stat-label">Kupione kursy</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(245,158,11,.12);color:#f59e0b"><i class="bi bi-box-seam-fill"></i></div>
                    <div>
                        <div class="stat-value">@_onlineOrders.Count(o => o.Kind == "Package")</div>
                        <div class="stat-label">Kupione pakiety</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(236,72,153,.12);color:#ec4899"><i class="bi bi-tag-fill"></i></div>
                    <div>
                        <div class="stat-value">@_onlineOrders.Where(o => o.HasDiscount).Sum(o => o.DiscountAmount!.Value).ToString("N0") @(_onlineOrders.FirstOrDefault()?.Currency ?? "PLN")</div>
                        <div class="stat-label">Rabaty (kupony)</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_taxConfig is not null && HasAnyTaxOption(_taxConfig))
    {
        var t = ComputeTax(_packages, _onlineOrders, _taxConfig, _months);
        <div class="card mb-3">
            <div class="card-header py-2 d-flex align-items-center justify-content-between">
                <span class="fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-calculator me-2" style="color:var(--c-primary)"></i>Podsumowanie podatkowe
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showTaxSettings = !_showTaxSettings">
                    <i class="bi bi-gear me-1"></i>Ustawienia
                </button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="text-muted small">Przychód brutto</div>
                        <div class="fw-semibold">@t.Gross.ToString("N2") zł</div>
                    </div>
                    @if (_taxConfig.VatEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">VAT (@_taxConfig.VatRate%)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Vat.ToString("N2") zł</div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">Netto (bez VAT)</div>
                            <div class="fw-semibold">@t.Net.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.IncomeTaxType != "none")
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">@t.TaxLabel</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.IncomeTax.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.ZusEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">ZUS (@_months mies.)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Zus.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.HealthInsuranceEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">Zdrowotne (@_months mies.)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Health.ToString("N2") zł</div>
                        </div>
                    }
                    @if (_taxConfig.CostDeductionsEnabled)
                    {
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="text-muted small">Koszty stałe (@_months mies.)</div>
                            <div class="fw-semibold" style="color:var(--c-danger)">-@t.Costs.ToString("N2") zł</div>
                        </div>
                    }
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="text-muted small fw-bold">Zysk netto</div>
                        <div class="fw-bold fs-5" style="color:@(t.Profit >= 0 ? "var(--c-success)" : "var(--c-danger)")">@t.Profit.ToString("N2") zł</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showTaxSettings && _taxConfig is not null)
    {
        <div class="card mb-3 border-primary">
            <div class="card-header py-2 d-flex align-items-center justify-content-between bg-primary bg-opacity-10">
                <span class="fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-sliders me-2"></i>Ustawienia podatkowe — moduł standardowy
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showTaxSettings = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12"><h6 class="mb-0"><i class="bi bi-receipt me-2"></i>VAT</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="vat-enabled" @bind="_taxConfig.VatEnabled" />
                            <label class="form-check-label" for="vat-enabled">VAT naliczany</label>
                        </div>
                    </div>
                    @if (_taxConfig.VatEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Stawka VAT (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.VatRate" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-bank me-2"></i>Podatek dochodowy (PIT)</h6></div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small">Forma opodatkowania</label>
                        <select class="form-select form-select-sm" @bind="_taxConfig.IncomeTaxType">
                            <option value="none">Brak</option>
                            <option value="scale">Skala podatkowa</option>
                            <option value="flat">Podatek liniowy</option>
                            <option value="lump">Ryczałt</option>
                        </select>
                    </div>
                    @if (_taxConfig.IncomeTaxType == "flat")
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Stawka liniowa (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.FlatTaxRate" />
                        </div>
                    }
                    @if (_taxConfig.IncomeTaxType == "lump")
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Stawka ryczałtu (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.LumpSumRate" />
                        </div>
                    }
                    @if (_taxConfig.IncomeTaxType == "scale")
                    {
                        <div class="col-6 col-md-4">
                            <label class="form-label small">Próg (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="1" @bind="_taxConfig.ScaleTaxThreshold" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small">Stawka do progu (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.ScaleTaxRateLow" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label small">Stawka powyżej (%)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.ScaleTaxRateHigh" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-shield-check me-2"></i>ZUS</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="zus-enabled" @bind="_taxConfig.ZusEnabled" />
                            <label class="form-check-label" for="zus-enabled">Składki ZUS</label>
                        </div>
                    </div>
                    @if (_taxConfig.ZusEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Miesięczna składka ZUS (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.ZusMonthlyAmount" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-heart-pulse me-2"></i>Ubezpieczenie zdrowotne</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="health-enabled" @bind="_taxConfig.HealthInsuranceEnabled" />
                            <label class="form-check-label" for="health-enabled">Składka zdrowotna</label>
                        </div>
                    </div>
                    @if (_taxConfig.HealthInsuranceEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Miesięczna składka zdrowotna (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.HealthInsuranceMonthly" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-wallet2 me-2"></i>Koszty uzyskania przychodu</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="costs-enabled" @bind="_taxConfig.CostDeductionsEnabled" />
                            <label class="form-check-label" for="costs-enabled">Odliczanie kosztów stałych</label>
                        </div>
                    </div>
                    @if (_taxConfig.CostDeductionsEnabled)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label small">Miesięczne koszty stałe (zł)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="_taxConfig.MonthlyFixedCosts" />
                        </div>
                    }

                    <div class="col-12"><h6 class="mb-0 mt-2"><i class="bi bi-hash me-2"></i>Numeracja faktur</h6></div>
                    <div class="col-12 col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="invoice-enabled" @bind="_taxConfig.InvoiceNumberingEnabled" />
                            <label class="form-check-label" for="invoice-enabled">Automatyczna numeracja</label>
                        </div>
                    </div>
                    @if (_taxConfig.InvoiceNumberingEnabled)
                    {
                        <div class="col-6 col-md-3">
                            <label class="form-label small">Prefiks</label>
                            <input type="text" class="form-control form-control-sm" @bind="_taxConfig.InvoicePrefix" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small">Następny numer</label>
                            <input type="number" class="form-control form-control-sm" min="1" @bind="_taxConfig.InvoiceNextNumber" />
                        </div>
                    }

                    <div class="col-12 mt-3">
                        <button class="btn btn-primary btn-sm" @onclick="SaveTaxSettingsAsync" disabled="@_taxSaving">
                            @if (_taxSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Zapisz ustawienia
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-8">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-bar-chart-fill me-2" style="color:var(--c-primary)"></i>Przychody miesięcznie (zł)
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="finance-bar"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-pie-chart-fill me-2" style="color:var(--c-primary)"></i>Status pakietów
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="finance-donut"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Unpaid -->
    <div class="card mb-3">
        <div class="card-header py-2 d-flex align-items-center justify-content-between">
            <span class="fw-semibold" style="font-size:.875rem">
                <i class="bi bi-exclamation-triangle-fill me-2" style="color:var(--c-warning)"></i>Nieopłacone pakiety
            </span>
            @if (_unpaid.Any())
            {
                <span class="badge bg-warning text-dark">@_unpaid.Count</span>
            }
        </div>
        <div class="card-body p-0">
            @if (!_unpaid.Any())
            {
                <div class="text-center text-muted py-4 small">
                    <i class="bi bi-check-circle d-block fs-3 mb-2" style="color:var(--c-success)"></i>Wszystkie pakiety w tym okresie są opłacone
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:.875rem">
                        <thead>
                            <tr>
                                <th>Klient</th>
                                <th>Pakiet</th>
                                <th class="text-center">Sesje</th>
                                <th class="text-end">Wartość</th>
                                <th>Zakup</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _unpaid.OrderByDescending(p => p.TotalPrice))
                            {
                                <tr>
                                    <td><a href="/clients/@p.ClientId" class="text-decoration-none fw-semibold">@p.ClientName</a></td>
                                    <td>@p.Name</td>
                                    <td class="text-center">@p.TotalSessions</td>
                                    <td class="text-end fw-semibold" style="color:var(--c-danger)">@p.TotalPrice.ToString("N0") zł</td>
                                    <td class="text-muted">@p.PurchasedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                    <td><span class="badge @StatusCss(p.Status)">@StatusLabel(p.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold table-light">
                                <td colspan="3">Razem nieopłacone</td>
                                <td class="text-end" style="color:var(--c-danger)">@_unpaid.Sum(p => p.TotalPrice).ToString("N0") zł</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (_onlineOrders.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header py-2 d-flex align-items-center justify-content-between">
                <span class="fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-cart-check-fill me-2" style="color:#10b981"></i>Zamówienia online
                    <span class="badge bg-success ms-1">@_onlineOrders.Count</span>
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:.875rem">
                    <thead class="table-light">
                        <tr>
                            <th>Produkt</th>
                            <th>Typ</th>
                            <th>Bramka</th>
                            <th class="text-end">Kwota</th>
                            <th>Kupon</th>
                            <th>Data płatności</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in _onlineOrders)
                        {
                            <tr>
                                <td class="fw-semibold">@o.ItemTitle</td>
                                <td>
                                    <span class="badge @(o.Kind == "Course" ? "bg-info-subtle text-info-emphasis" : "bg-primary-subtle text-primary-emphasis")">
                                        @(o.Kind == "Course" ? "Kurs" : "Pakiet")
                                    </span>
                                </td>
                                <td class="text-muted small">@(o.Provider ?? "—")</td>
                                <td class="text-end text-nowrap">
                                    @if (o.HasDiscount)
                                    {
                                        <span class="text-muted text-decoration-line-through small">@o.OriginalAmount!.Value.ToString("0.00")</span>
                                        <span class="ms-1">@o.Amount.ToString("0.00") @o.Currency</span>
                                    }
                                    else
                                    {
                                        @($"{o.Amount:0.00} {o.Currency}")
                                    }
                                </td>
                                <td>
                                    @if (o.HasDiscount)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis">@o.CouponCode (−@o.DiscountAmount!.Value.ToString("0.00"))</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-nowrap text-muted">@(o.PaidAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" title="Pobierz potwierdzenie"
                                            @onclick="() => DownloadReceipt(o.Id)" disabled="@(_downloadingReceiptId == o.Id)">
                                        @if (_downloadingReceiptId == o.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold table-light">
                        <tr>
                            <td colspan="3">Razem (@_onlineOrders.Count zamówień)</td>
                            <td class="text-end">@_onlineOrders.Sum(o => o.Amount).ToString("N2") @(_onlineOrders.FirstOrDefault()?.Currency ?? "PLN")</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    <!-- Full history -->
    <div class="card">
        <div class="card-header py-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="fw-semibold me-auto" style="font-size:.875rem">
                <i class="bi bi-clock-history me-2"></i>Historia pakietów
                <span class="badge bg-secondary ms-1">@_historyFiltered.Count</span>
            </span>
            <input class="form-control form-control-sm" style="max-width:180px" placeholder="Szukaj klienta…"
                   @bind="_search" @bind:event="oninput" />
            <select class="form-select form-select-sm" style="max-width:150px" @bind="_statusFilter">
                <option value="">Wszystkie statusy</option>
                <option value="Active">Aktywne</option>
                <option value="Depleted">Wyczerpane</option>
                <option value="Expired">Wygasłe</option>
                <option value="Cancelled">Anulowane</option>
            </select>
            <select class="form-select form-select-sm" style="max-width:140px" @bind="_paidFilter">
                <option value="">Płatność: wszystkie</option>
                <option value="paid">Opłacone</option>
                <option value="unpaid">Nieopłacone</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:.875rem">
                <thead class="table-light">
                    <tr>
                        <th>Klient</th>
                        <th>Pakiet</th>
                        <th class="text-center">Sesje</th>
                        <th class="text-end">Wartość</th>
                        <th>Zakupiony</th>
                        <th>Ważny do</th>
                        <th>Płatność</th>
                        <th>Status</th>
                        @if (_canViewHidden)
                        {
                            <th style="width:40px"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!_historyFiltered.Any())
                    {
                        <tr><td colspan="@(_canViewHidden ? 9 : 8)" class="text-center text-muted py-4 small">Brak wyników dla wybranych filtrów</td></tr>
                    }
                    @foreach (var p in _historyFiltered)
                    {
                        var pkgId = p.Id;
                        <tr>
                            <td>
                                <a href="/clients/@p.ClientId" class="text-decoration-none fw-semibold">@p.ClientName</a>
                            </td>
                            <td>
                                <div>@p.Name</div>
                                <div class="text-muted" style="font-size:.75rem">@p.SessionTypeName · @p.DurationMinutes min</div>
                            </td>
                            <td class="text-center">
                                <span class="fw-semibold">@p.UsedSessions/@p.TotalSessions</span>
                                @if (p.Status == PackageStatus.Active)
                                {
                                    <div class="progress mt-1" style="height:4px;width:50px;margin:0 auto">
                                        <div class="progress-bar bg-primary" style="width:@(p.TotalSessions > 0 ? (int)((double)p.UsedSessions/p.TotalSessions*100) : 0)%"></div>
                                    </div>
                                }
                            </td>
                            <td class="text-end fw-semibold">@p.TotalPrice.ToString("N0") zł</td>
                            <td class="text-nowrap text-muted">@p.PurchasedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-nowrap text-muted">
                                @(p.ExpiresAt.HasValue ? p.ExpiresAt.Value.ToLocalTime().ToString("dd.MM.yyyy") : "—")
                            </td>
                            <td>
                                @if (p.IsPaid)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check me-1"></i>Opłacony</span>
                                    @if (p.PaidAt.HasValue)
                                    {
                                        <div class="text-muted" style="font-size:.7rem">@p.PaidAt.Value.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                    }
                                }
                                else if (p.Status != PackageStatus.Cancelled)
                                {
                                    <span class="badge bg-warning text-dark">Oczekuje</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @StatusCss(p.Status)">@StatusLabel(p.Status)</span></td>
                            @if (_canViewHidden)
                            {
                                <td>
                                    <button class="btn btn-sm btn-link text-muted p-0" title="Ukryj pakiet" @onclick="() => HidePackageAsync(pkgId)">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                @if (_historyFiltered.Any())
                {
                    <tfoot class="fw-bold table-light">
                        <tr>
                            <td colspan="3">Razem (@_historyFiltered.Count)</td>
                            <td class="text-end">@_historyFiltered.Sum(p => p.TotalPrice).ToString("N0") zł</td>
                            <td colspan="@(_canViewHidden ? 5 : 4)"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}

@code {
    private bool _loaded;
    private int _months = 6;
    private string? _trainerUserId;
    private string _userRole = "";
    private bool _canViewHidden;
    private List<SessionPackageDto> _packages = [];
    private List<SessionPackageDto> _allPackages = [];
    private List<SessionPackageDto> _unpaid = [];
    private List<OrderDto> _onlineOrders = [];
    private int? _downloadingReceiptId;
    private bool _chartNeedsRender;
    private FinanceTaxConfigDto? _taxConfig;
    private bool _showTaxSettings;
    private bool _taxSaving;

    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _paidFilter = string.Empty;

    private List<SessionPackageDto> _historyFiltered => _allPackages
        .Where(p =>
            (string.IsNullOrWhiteSpace(_search) || p.ClientName.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_statusFilter) || p.Status.ToString() == _statusFilter) &&
            (_paidFilter switch { "paid" => p.IsPaid, "unpaid" => !p.IsPaid, _ => true })
        )
        .OrderByDescending(p => p.PurchasedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var isAdmin = auth.User.IsInRole(Roles.Admin);
        _trainerUserId = isAdmin ? null : auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _userRole = isAdmin ? Roles.Admin
            : auth.User.IsInRole(Roles.Trainer) ? Roles.Trainer
            : auth.User.IsInRole(Roles.Subordinate) ? Roles.Subordinate
            : "";
        _canViewHidden = await PermissionService.HasPermissionAsync(_userRole, Permissions.ViewHiddenFinance);
        _taxConfig = await FinanceService.GetTaxConfigAsync("standard");
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender)
        {
            _chartNeedsRender = false;
            await RenderChartsAsync();
        }
    }

    private async Task ChangeRange(int months)
    {
        _months = months;
        _loaded = false;
        StateHasChanged();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var from = DateTime.UtcNow.AddMonths(-_months);
        var all = await PackageService.GetAllPackagesAsync(_trainerUserId);
        _allPackages = all.Where(p => !p.IsHidden).ToList();
        _packages = _allPackages.Where(p => p.PurchasedAt >= from).ToList();
        _unpaid = _packages.Where(p => !p.IsPaid && p.Status != PackageStatus.Cancelled).ToList();
        _onlineOrders = await PaymentService.GetPaidOrdersAsync(from);
        _loaded = true;
        _chartNeedsRender = true;
    }

    private async Task HidePackageAsync(int packageId)
    {
        await FinanceService.SetPackageHiddenAsync(packageId, true);
        await LoadDataAsync();
    }

    private async Task SaveTaxSettingsAsync()
    {
        if (_taxConfig is null) return;
        _taxSaving = true;
        StateHasChanged();
        await FinanceService.SaveTaxConfigAsync(_taxConfig);
        _taxSaving = false;
        _showTaxSettings = false;
    }

    private async Task DownloadReceipt(int orderId)
    {
        _downloadingReceiptId = orderId;
        try
        {
            var (bytes, fileName) = await ReceiptService.GenerateReceiptAsync(orderId);
            await JS.InvokeVoidAsync("PTExport.downloadCsv", fileName, bytes);
        }
        catch { }
        finally { _downloadingReceiptId = null; }
    }

    private static bool HasAnyTaxOption(FinanceTaxConfigDto tc) =>
        tc.VatEnabled || tc.IncomeTaxType != "none" || tc.ZusEnabled || tc.HealthInsuranceEnabled || tc.CostDeductionsEnabled;

    private static (decimal Gross, decimal Vat, decimal Net, decimal IncomeTax, string TaxLabel, decimal Zus, decimal Health, decimal Costs, decimal Profit) ComputeTax(
        List<SessionPackageDto> packages, List<OrderDto> onlineOrders, FinanceTaxConfigDto tax, int months)
    {
        var gross = packages.Where(p => p.IsPaid).Sum(p => p.TotalPrice)
                   + onlineOrders.Sum(o => o.Amount);
        decimal vat = 0, net = gross;
        if (tax.VatEnabled && tax.VatRate > 0)
        {
            vat = gross * tax.VatRate / (100 + tax.VatRate);
            net = gross - vat;
        }

        decimal incomeTax = 0;
        string taxLabel = "";
        switch (tax.IncomeTaxType)
        {
            case "flat":
                incomeTax = net * tax.FlatTaxRate / 100;
                taxLabel = $"PIT liniowy ({tax.FlatTaxRate}%)";
                break;
            case "lump":
                incomeTax = net * tax.LumpSumRate / 100;
                taxLabel = $"Ryczałt ({tax.LumpSumRate}%)";
                break;
            case "scale":
                if (net <= tax.ScaleTaxThreshold)
                {
                    incomeTax = net * tax.ScaleTaxRateLow / 100;
                    taxLabel = $"Skala ({tax.ScaleTaxRateLow}%)";
                }
                else
                {
                    incomeTax = tax.ScaleTaxThreshold * tax.ScaleTaxRateLow / 100
                                + (net - tax.ScaleTaxThreshold) * tax.ScaleTaxRateHigh / 100;
                    taxLabel = $"Skala ({tax.ScaleTaxRateLow}%/{tax.ScaleTaxRateHigh}%)";
                }
                break;
        }

        var zus = tax.ZusEnabled ? tax.ZusMonthlyAmount * months : 0;
        var health = tax.HealthInsuranceEnabled ? tax.HealthInsuranceMonthly * months : 0;
        var costs = tax.CostDeductionsEnabled ? tax.MonthlyFixedCosts * months : 0;
        return (gross, vat, net, incomeTax, taxLabel, zus, health, costs, net - incomeTax - zus - health - costs);
    }

    private async Task RenderChartsAsync()
    {
        var monthSlots = Enumerable.Range(0, _months)
            .Select(i => DateTime.Now.AddMonths(-(_months - 1 - i)))
            .Select(d => (Label: d.ToString("MM.yy"), Year: d.Year, Month: d.Month))
            .ToList();

        var barLabels = monthSlots.Select(m => m.Label).ToArray();
        var barRevenue = monthSlots
            .Select(m => (double)_packages
                .Where(p => p.IsPaid
                    && p.PurchasedAt.ToLocalTime().Year == m.Year
                    && p.PurchasedAt.ToLocalTime().Month == m.Month)
                .Sum(p => p.TotalPrice))
            .ToArray();
        var barOnline = monthSlots
            .Select(m => (double)_onlineOrders
                .Where(o => o.PaidAt.HasValue
                    && o.PaidAt.Value.ToLocalTime().Year == m.Year
                    && o.PaidAt.Value.ToLocalTime().Month == m.Month)
                .Sum(o => o.Amount))
            .ToArray();

        var datasets = new List<object> { new { label = "Pakiety (zł)", data = barRevenue } };
        if (barOnline.Any(v => v > 0))
            datasets.Add(new { label = "Online (zł)", data = barOnline });

        await JS.InvokeVoidAsync("PTChart.renderBar", "finance-bar", barLabels, datasets.ToArray());

        var active = _packages.Count(p => p.Status == PackageStatus.Active);
        var depleted = _packages.Count(p => p.Status == PackageStatus.Depleted);
        var expired = _packages.Count(p => p.Status == PackageStatus.Expired);
        var cancelled = _packages.Count(p => p.Status == PackageStatus.Cancelled);

        await JS.InvokeVoidAsync("PTChart.renderDoughnut", "finance-donut",
            new[] { "Aktywne", "Wyczerpane", "Wygasłe", "Anulowane" },
            new double[] { active, depleted, expired, cancelled },
            new[] { "#3B82F6", "#16A34A", "#D97706", "#9CA3AF" });
    }

    private static string StatusCss(PackageStatus s) => s switch
    {
        PackageStatus.Active    => "bg-primary",
        PackageStatus.Depleted  => "bg-success",
        PackageStatus.Expired   => "bg-warning text-dark",
        PackageStatus.Cancelled => "bg-secondary",
        _                       => "bg-secondary"
    };

    private static string StatusLabel(PackageStatus s) => s switch
    {
        PackageStatus.Active    => "Aktywny",
        PackageStatus.Depleted  => "Wyczerpany",
        PackageStatus.Expired   => "Wygasły",
        PackageStatus.Cancelled => "Anulowany",
        _                       => s.ToString()
    };
}
