@page "/finance"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Enums
@using PTScheduler.Domain.Constants
@inject ISessionPackageService PackageService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Trainer},{Roles.Subordinate}")]

@if (!_loaded)
{
    <div class="page-header mb-3">
        <div class="skeleton skeleton-line w-40" style="height:24px;margin-bottom:0"></div>
        <div class="skeleton" style="width:100px;height:32px;border-radius:8px"></div>
    </div>
    <div class="row g-3 mb-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-6 col-xl-3">
                <div class="skeleton-stat">
                    <div class="skeleton skeleton-circle" style="width:40px;height:40px"></div>
                    <div style="flex:1">
                        <div class="skeleton skeleton-line w-40" style="height:20px"></div>
                        <div class="skeleton skeleton-line w-75" style="height:10px;margin-bottom:0"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="skeleton-card" style="height:200px"></div>
}
else
{
    <div class="page-header">
        <h4 class="page-title"><i class="bi bi-currency-dollar me-2" style="color:var(--c-primary)"></i>Finanse</h4>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn @(_months == 6 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(6)">6M</button>
            <button type="button" class="btn @(_months == 12 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(12)">12M</button>
            <button type="button" class="btn @(_months == 24 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ChangeRange(24)">2 lata</button>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="stat-value">@_packages.Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Łączna wartość</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_packages.Where(p => p.IsPaid).Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Opłacone</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-red"><i class="bi bi-exclamation-circle-fill"></i></div>
                <div>
                    <div class="stat-value">@_unpaid.Sum(p => p.TotalPrice).ToString("N0") zł</div>
                    <div class="stat-label">Nieopłacone</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-blue"><i class="bi bi-box-seam-fill"></i></div>
                <div>
                    <div class="stat-value">@_packages.Count(p => p.Status == PackageStatus.Active)</div>
                    <div class="stat-label">Aktywnych pakietów</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-8">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-bar-chart-fill me-2" style="color:var(--c-primary)"></i>Przychody miesięcznie — opłacone pakiety (zł)
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="finance-bar"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold" style="font-size:.875rem">
                    <i class="bi bi-pie-chart-fill me-2" style="color:var(--c-primary)"></i>Status pakietów
                </div>
                <div class="card-body" style="height:220px;position:relative">
                    <canvas id="finance-donut"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Unpaid -->
    <div class="card mb-3">
        <div class="card-header py-2 d-flex align-items-center justify-content-between">
            <span class="fw-semibold" style="font-size:.875rem">
                <i class="bi bi-exclamation-triangle-fill me-2" style="color:var(--c-warning)"></i>Nieopłacone pakiety
            </span>
            @if (_unpaid.Any())
            {
                <span class="badge bg-warning text-dark">@_unpaid.Count</span>
            }
        </div>
        <div class="card-body p-0">
            @if (!_unpaid.Any())
            {
                <div class="text-center text-muted py-4 small">
                    <i class="bi bi-check-circle d-block fs-3 mb-2" style="color:var(--c-success)"></i>Wszystkie pakiety w tym okresie są opłacone
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:.875rem">
                        <thead>
                            <tr>
                                <th>Klient</th>
                                <th>Pakiet</th>
                                <th class="text-center">Sesje</th>
                                <th class="text-end">Wartość</th>
                                <th>Zakup</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _unpaid.OrderByDescending(p => p.TotalPrice))
                            {
                                <tr>
                                    <td><a href="/clients/@p.ClientId" class="text-decoration-none fw-semibold">@p.ClientName</a></td>
                                    <td>@p.Name</td>
                                    <td class="text-center">@p.TotalSessions</td>
                                    <td class="text-end fw-semibold" style="color:var(--c-danger)">@p.TotalPrice.ToString("N0") zł</td>
                                    <td class="text-muted">@p.PurchasedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                    <td><span class="badge @StatusCss(p.Status)">@StatusLabel(p.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold table-light">
                                <td colspan="3">Razem nieopłacone</td>
                                <td class="text-end" style="color:var(--c-danger)">@_unpaid.Sum(p => p.TotalPrice).ToString("N0") zł</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Full history -->
    <div class="card">
        <div class="card-header py-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="fw-semibold me-auto" style="font-size:.875rem">
                <i class="bi bi-clock-history me-2"></i>Historia pakietów
                <span class="badge bg-secondary ms-1">@_historyFiltered.Count</span>
            </span>
            <input class="form-control form-control-sm" style="max-width:180px" placeholder="Szukaj klienta…"
                   @bind="_search" @bind:event="oninput" />
            <select class="form-select form-select-sm" style="max-width:150px" @bind="_statusFilter">
                <option value="">Wszystkie statusy</option>
                <option value="Active">Aktywne</option>
                <option value="Depleted">Wyczerpane</option>
                <option value="Expired">Wygasłe</option>
                <option value="Cancelled">Anulowane</option>
            </select>
            <select class="form-select form-select-sm" style="max-width:140px" @bind="_paidFilter">
                <option value="">Płatność: wszystkie</option>
                <option value="paid">Opłacone</option>
                <option value="unpaid">Nieopłacone</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:.875rem">
                <thead class="table-light">
                    <tr>
                        <th>Klient</th>
                        <th>Pakiet</th>
                        <th class="text-center">Sesje</th>
                        <th class="text-end">Wartość</th>
                        <th>Zakupiony</th>
                        <th>Ważny do</th>
                        <th>Płatność</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_historyFiltered.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4 small">Brak wyników dla wybranych filtrów</td></tr>
                    }
                    @foreach (var p in _historyFiltered)
                    {
                        <tr>
                            <td>
                                <a href="/clients/@p.ClientId" class="text-decoration-none fw-semibold">@p.ClientName</a>
                            </td>
                            <td>
                                <div>@p.Name</div>
                                <div class="text-muted" style="font-size:.75rem">@p.SessionTypeName · @p.DurationMinutes min</div>
                            </td>
                            <td class="text-center">
                                <span class="fw-semibold">@p.UsedSessions/@p.TotalSessions</span>
                                @if (p.Status == PackageStatus.Active)
                                {
                                    <div class="progress mt-1" style="height:4px;width:50px;margin:0 auto">
                                        <div class="progress-bar bg-primary" style="width:@(p.TotalSessions > 0 ? (int)((double)p.UsedSessions/p.TotalSessions*100) : 0)%"></div>
                                    </div>
                                }
                            </td>
                            <td class="text-end fw-semibold">@p.TotalPrice.ToString("N0") zł</td>
                            <td class="text-nowrap text-muted">@p.PurchasedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-nowrap text-muted">
                                @(p.ExpiresAt.HasValue ? p.ExpiresAt.Value.ToLocalTime().ToString("dd.MM.yyyy") : "—")
                            </td>
                            <td>
                                @if (p.IsPaid)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check me-1"></i>Opłacony</span>
                                    @if (p.PaidAt.HasValue)
                                    {
                                        <div class="text-muted" style="font-size:.7rem">@p.PaidAt.Value.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                    }
                                }
                                else if (p.Status != PackageStatus.Cancelled)
                                {
                                    <span class="badge bg-warning text-dark">Oczekuje</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @StatusCss(p.Status)">@StatusLabel(p.Status)</span></td>
                        </tr>
                    }
                </tbody>
                @if (_historyFiltered.Any())
                {
                    <tfoot class="fw-bold table-light">
                        <tr>
                            <td colspan="3">Razem (@_historyFiltered.Count)</td>
                            <td class="text-end">@_historyFiltered.Sum(p => p.TotalPrice).ToString("N0") zł</td>
                            <td colspan="4"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}

@code {
    private bool _loaded;
    private int _months = 6;
    private string? _trainerUserId;
    private List<SessionPackageDto> _packages = [];
    private List<SessionPackageDto> _allPackages = [];
    private List<SessionPackageDto> _unpaid = [];
    private bool _chartNeedsRender;

    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _paidFilter = string.Empty;

    private List<SessionPackageDto> _historyFiltered => _allPackages
        .Where(p =>
            (string.IsNullOrWhiteSpace(_search) || p.ClientName.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_statusFilter) || p.Status.ToString() == _statusFilter) &&
            (_paidFilter switch { "paid" => p.IsPaid, "unpaid" => !p.IsPaid, _ => true })
        )
        .OrderByDescending(p => p.PurchasedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var isAdmin = auth.User.IsInRole(Roles.Admin);
        _trainerUserId = isAdmin ? null : auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartNeedsRender)
        {
            _chartNeedsRender = false;
            await RenderChartsAsync();
        }
    }

    private async Task ChangeRange(int months)
    {
        _months = months;
        _loaded = false;
        StateHasChanged();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var from = DateTime.UtcNow.AddMonths(-_months);
        _allPackages = await PackageService.GetAllPackagesAsync(_trainerUserId);
        _packages = _allPackages.Where(p => p.PurchasedAt >= from).ToList();
        _unpaid = _packages.Where(p => !p.IsPaid && p.Status != PackageStatus.Cancelled).ToList();
        _loaded = true;
        _chartNeedsRender = true;
    }

    private async Task RenderChartsAsync()
    {
        var monthSlots = Enumerable.Range(0, _months)
            .Select(i => DateTime.Now.AddMonths(-(_months - 1 - i)))
            .Select(d => (Label: d.ToString("MM.yy"), Year: d.Year, Month: d.Month))
            .ToList();

        var barLabels = monthSlots.Select(m => m.Label).ToArray();
        var barRevenue = monthSlots
            .Select(m => (double)_packages
                .Where(p => p.IsPaid
                    && p.PurchasedAt.ToLocalTime().Year == m.Year
                    && p.PurchasedAt.ToLocalTime().Month == m.Month)
                .Sum(p => p.TotalPrice))
            .ToArray();

        await JS.InvokeVoidAsync("PTChart.renderBar", "finance-bar", barLabels,
            new object[] { new { label = "Przychód (zł)", data = barRevenue } });

        var active = _packages.Count(p => p.Status == PackageStatus.Active);
        var depleted = _packages.Count(p => p.Status == PackageStatus.Depleted);
        var expired = _packages.Count(p => p.Status == PackageStatus.Expired);
        var cancelled = _packages.Count(p => p.Status == PackageStatus.Cancelled);

        await JS.InvokeVoidAsync("PTChart.renderDoughnut", "finance-donut",
            new[] { "Aktywne", "Wyczerpane", "Wygasłe", "Anulowane" },
            new double[] { active, depleted, expired, cancelled },
            new[] { "#3B82F6", "#16A34A", "#D97706", "#9CA3AF" });
    }

    private static string StatusCss(PackageStatus s) => s switch
    {
        PackageStatus.Active    => "bg-primary",
        PackageStatus.Depleted  => "bg-success",
        PackageStatus.Expired   => "bg-warning text-dark",
        PackageStatus.Cancelled => "bg-secondary",
        _                       => "bg-secondary"
    };

    private static string StatusLabel(PackageStatus s) => s switch
    {
        PackageStatus.Active    => "Aktywny",
        PackageStatus.Depleted  => "Wyczerpany",
        PackageStatus.Expired   => "Wygasły",
        PackageStatus.Cancelled => "Anulowany",
        _                       => s.ToString()
    };
}
