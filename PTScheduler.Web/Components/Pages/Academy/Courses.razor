@page "/academy/courses"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = $"{Roles.Admin},{Roles.Trainer}")]
@inject IAcademyCatalogService Catalog
@inject NavigationManager Nav
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<PageTitle>Kursy</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-mortarboard-fill fs-4 text-primary"></i>
        <h2 class="mb-0">Kursy</h2>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreate">
        <i class="bi bi-plus-lg me-1"></i>Nowy kurs
    </button>
</div>
<hr />

@if (showCreate)
{
    <div class="card mb-4 border-primary">
        <div class="card-body">
            <h5 class="card-title">Nowy kurs</h5>
            <div class="mb-2">
                <label class="form-label">Tytuł</label>
                <input class="form-control" @bind="newTitle" placeholder="np. Mentoring żywieniowy odNowa" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success btn-sm" @onclick="CreateCourse" disabled="@(string.IsNullOrWhiteSpace(newTitle) || busy)">
                    Utwórz
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => showCreate = false">Anuluj</button>
            </div>
        </div>
    </div>
}

@if (courses is null)
{
    <p><span class="spinner-border spinner-border-sm me-2" />Ładowanie...</p>
}
else if (courses.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-mortarboard fs-1 d-block mb-2"></i>
        Nie masz jeszcze żadnego kursu. Kliknij „Nowy kurs”, aby zacząć.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in courses)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-1">@c.Title</h5>
                            @if (c.IsPublished)
                            {
                                <span class="badge bg-success">Opublikowany</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Szkic</span>
                            }
                        </div>
                        <p class="text-muted small flex-grow-1">@(string.IsNullOrWhiteSpace(c.Description) ? "Brak opisu" : c.Description)</p>
                        <div class="d-flex gap-3 text-muted small mb-3">
                            <span><i class="bi bi-collection me-1"></i>@c.ModuleCount modułów</span>
                            <span><i class="bi bi-play-circle me-1"></i>@c.LessonCount lekcji</span>
                            <span><i class="bi bi-people me-1"></i>@c.EnrollmentCount</span>
                        </div>
                        <a href="@($"/academy/courses/{c.Id}")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i>Edytuj
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AcademyCourseDto>? courses;
    private bool showCreate;
    private string newTitle = string.Empty;
    private bool busy;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => courses = await Catalog.GetCoursesAsync();

    private void ShowCreate()
    {
        newTitle = string.Empty;
        showCreate = true;
    }

    private async Task CreateCourse()
    {
        busy = true;
        try
        {
            var id = await Catalog.CreateCourseAsync(new AcademyCourseDto { Title = newTitle.Trim() });
            Nav.NavigateTo($"/academy/courses/{id}");
        }
        finally
        {
            busy = false;
        }
    }
}
