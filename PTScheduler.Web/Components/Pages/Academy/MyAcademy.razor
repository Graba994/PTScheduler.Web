@page "/academy"
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Client)]
@inject IAcademyStudentService Student
@inject AuthenticationStateProvider AuthStateProvider
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<PageTitle>Moje kursy</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-mortarboard-fill fs-4 text-primary"></i>
    <h2 class="mb-0">Moje kursy</h2>
</div>
<hr />

@if (courses is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (courses.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        Nie masz jeszcze dostępu do żadnego kursu.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in courses)
        {
            var pct = c.TotalLessons == 0 ? 0 : (int)Math.Round(100.0 * c.CompletedLessons / c.TotalLessons);
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(c.CoverImageUrl))
                    {
                        <img src="@c.CoverImageUrl" class="card-img-top" style="height:160px;object-fit:cover" alt="@c.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@c.Title</h5>
                        <p class="text-muted small flex-grow-1">@c.Description</p>

                        <div class="mb-2">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Postęp</span>
                                <span>@c.CompletedLessons / @c.TotalLessons</span>
                            </div>
                            <div class="progress" style="height:8px">
                                <div class="progress-bar bg-success" style="width:@(pct)%"></div>
                            </div>
                        </div>

                        @if (c.ExpiresAt.HasValue)
                        {
                            <div class="small text-muted mb-2">
                                <i class="bi bi-clock me-1"></i>Dostęp do @c.ExpiresAt.Value.ToString("dd.MM.yyyy")
                            </div>
                        }

                        <a href="@($"/academy/{c.CourseId}")" class="btn btn-primary btn-sm">
                            <i class="bi bi-play-fill me-1"></i>Otwórz kurs
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MyCourseDto>? courses;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        courses = await Student.GetMyCoursesAsync(userId);
    }
}
