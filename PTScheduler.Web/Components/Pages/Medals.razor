@page "/medale"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Client")]
@using PTScheduler.Domain.Rules
@inject PTScheduler.Web.Services.MedalService MedalSvc
@inject PTScheduler.Application.Interfaces.IClientService ClientService
@inject AuthenticationStateProvider AuthState
@rendermode PTScheduler.Web.RenderModes.Server

@* Gablota klienta: zdobyte medale w kolorze, pozostałe wyszarzone z postępem. *@

<AppTitle Page="Medale" />

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h4 class="page-title mb-0"><i class="bi bi-award-fill me-2" style="color:var(--c-primary)"></i>Medale</h4>
    @if (_items.Count > 0) { <span class="text-muted small">@_items.Count(i => i.EarnedAt is not null) z @_items.Count zdobytych</span> }
</div>

@if (_settings is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (!_settings.Enabled)
{
    <div class="alert alert-secondary">Medale są wyłączone przez trenera.</div>
}
else if (_clientId is null)
{
    <div class="alert alert-warning">Twoje konto nie jest jeszcze powiązane z profilem klienta.</div>
}
else
{
    <p class="text-muted">Medale zdobywasz za regularność, kolejne treningi, rekordy i wspólny czas z trenerem. Zostają na zawsze.</p>
    @foreach (var group in _items.GroupBy(i => Group(i.Medal.Key)))
    {
        <h2 class="medal-group">@group.Key</h2>
        <div class="medal-grid">
            @foreach (var i in group)
            {
                var earned = i.EarnedAt is not null;
                <div class="medal-tile @(earned ? "earned" : "")">
                    <MedalImage Medal="i.Medal" Style="@_settings.Style" Palette="_settings.Palette" Locked="!earned" Size="96" />
                    <b>@i.Medal.Name</b>
                    <span class="small text-muted">@i.Medal.Description</span>
                    @if (earned)
                    {
                        <span class="medal-date"><i class="bi bi-check2-circle me-1"></i>@i.EarnedAt!.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <div class="medal-bar w-100" role="progressbar" aria-valuenow="@((int)(i.Progress * 100))" aria-valuemin="0" aria-valuemax="100" aria-label="@($"Postęp: {i.Current} z {i.Medal.Target}")"><i style="width:@((int)(i.Progress * 100))%"></i></div>
                        <span class="small text-muted">@i.Current z @i.Medal.Target</span>
                    }
                </div>
            }
        </div>
    }
    <NewMedalModal Medals="_unseen" Settings="_settings" OnDone="SeenAsync" />
}

@code {
    private PTScheduler.Web.Services.MedalService.Settings? _settings;
    private List<PTScheduler.Web.Services.MedalService.Item> _items = [];
    private List<MedalRules.Medal> _unseen = [];
    private int? _clientId;

    private static string Group(string key) => key.Split('_')[0] switch
    {
        "treningi" => "Treningi",
        "seria" => "Regularność",
        "rekord" => "Rekordy",
        "staz" => "Razem z trenerem",
        _ => "Zaangażowanie",
    };

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthState.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _clientId = (await ClientService.GetClientByUserIdAsync(userId))?.Id;
        _settings = await MedalSvc.GetSettingsAsync();
        if (_clientId is { } id && _settings.Enabled)
        {
            await MedalSvc.SyncAsync(id);
            _unseen = await MedalSvc.UnseenAsync(id);
            _items = await MedalSvc.CabinetAsync(id);
        }
    }

    private async Task SeenAsync()
    {
        _unseen = [];
        if (_clientId is { } id) await MedalSvc.MarkSeenAsync(id);
    }
}
