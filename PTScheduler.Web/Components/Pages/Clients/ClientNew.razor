@page "/clients/new"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@inject IClientService ClientService
@inject IClientInvitationService Invitations
@inject EntitlementService Entitlements
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject Microsoft.AspNetCore.Identity.UserManager<PTScheduler.Infrastructure.Data.ApplicationUser> UserManager
@inject IUserManagementService UserService
@using PTScheduler.Domain.Rules
@using PTScheduler.Domain.Constants
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Nowy klient" />

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/clients">Klienci</a></li>
        <li class="breadcrumb-item active">Nowy klient</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h5 class="card-title mb-4">
                    <i class="bi bi-person-plus-fill me-2 text-primary"></i>Dodaj nowego klienta
                </h5>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger py-2">@error</div>
                }

                @if (_limitReached)
                {
                    <div class="alert alert-warning py-3">
                        <h6 class="fw-bold mb-2">
                            <i class="bi bi-lock-fill me-1"></i>Osiągnięto limit klientów
                        </h6>
                        <p class="small mb-2">
                            Plan <strong>@Entitlements.Current.Name</strong> obejmuje <strong>@_maxClients</strong> klientów i wszystkie miejsca są zajęte — liczą się klienci wszystkich trenerów w studiu.
                        </p>
                        <a href="/upgrade" class="btn btn-sm btn-primary">
                            <i class="bi bi-arrow-up-circle me-1"></i>Zwiększ plan
                        </a>
                    </div>
                }

                <div class="row g-3">
                    @if (_trainers is not null)
                    {
                        <div class="col-12">
                            <label class="form-label">Trener klienta <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="dto.TrainerUserId">
                                <option value="">— wybierz trenera —</option>
                                @foreach (var t in _trainers)
                                {
                                    <option value="@t.Id">@t.FullName</option>
                                }
                            </select>
                            <div class="form-text">Klient pojawi się na liście tego trenera, a trener dostanie jego wizyty i wiadomości.</div>
                        </div>
                    }
                    <div class="col-6">
                        <label class="form-label">Imię <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="dto.FirstName" placeholder="Jan" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Nazwisko <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="dto.LastName" placeholder="Kowalski" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control @(_emailProblem is not null ? "is-invalid" : _owner is null && _emailChecked ? "is-valid" : "")"
                               @bind="dto.Email" @bind:after="CheckEmailAsync" placeholder="jan@example.com" autocomplete="off" spellcheck="false" />
                        @if (_emailProblem is not null)
                        {
                            <div class="invalid-feedback d-block">
                                @_emailProblem
                                @if (_suggestion is not null)
                                {
                                    <span class="d-block">Czy chodziło o <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="UseSuggestionAsync">@_suggestion</button>?</span>
                                }
                            </div>
                        }
                        else if (_suggestion is not null)
                        {
                            <div class="form-text text-warning-emphasis">
                                <i class="bi bi-magic me-1"></i>Czy chodziło o <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="UseSuggestionAsync">@_suggestion</button>?
                            </div>
                        }
                        else if (_owner is { } o)
                        {
                            <div class="alert @(OwnerBlocks ? "alert-warning" : "alert-info") py-2 small mt-2 mb-0">
                                <i class="bi @(OwnerBlocks ? "bi-exclamation-triangle" : "bi-info-circle") me-1"></i>@OwnerText
                                @if (o.ClientId is { } cid && o.TrainerUserId == dto.TrainerUserId)
                                {
                                    <a href="/clients/@cid" class="alert-link ms-1">Otwórz profil</a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="form-text">Klient użyje tego e-maila do logowania.</div>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label">Telefon</label>
                        <input class="form-control" @bind="dto.Phone" placeholder="+48 123 456 789" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Data urodzenia</label>
                        <input type="date" class="form-control"
                               value="@(dto.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")"
                               @onchange="e => dto.DateOfBirth = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Cel treningowy</label>
                        <textarea class="form-control" rows="2" @bind="dto.TrainingGoal"
                                  placeholder="np. Redukcja wagi, budowa masy, poprawa kondycji..."></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="sendInvite" @bind="_sendInvite" />
                            <label class="form-check-label" for="sendInvite">Wyślij klientowi zaproszenie e-mailem</label>
                        </div>
                        <div class="form-text">Klient dostanie link do ustawienia hasła (ważny @ClientInvite.ValidDays dni). Link możesz też skopiować później w profilu klienta.</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary flex-grow-1" @onclick="Submit" disabled="@(isBusy || _limitReached || OwnerBlocks || (_trainers is not null && string.IsNullOrEmpty(dto.TrainerUserId)))">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Dodaj klienta
                    </button>
                    <a href="/clients" class="btn btn-outline-secondary">Anuluj</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateClientDto dto = new();
    private bool isBusy;
    private string error = string.Empty;
    private bool _limitReached;
    private int _maxClients;
    private bool _sendInvite = true;

    // Administrator wybiera trenera; trener (i asystent — przez swojego trenera) dostaje klienta od razu.
    private List<UserDto>? _trainers;
    private string? _emailProblem;
    private string? _suggestion;
    private EmailOwnerDto? _owner;
    private bool _emailChecked;

    private bool OwnerBlocks => _owner is { Kind: "staff" }
        || (_owner is { Kind: "client", TrainerUserId: { } t } && t != dto.TrainerUserId && !string.IsNullOrEmpty(dto.TrainerUserId));

    private string OwnerText => _owner switch
    {
        { Kind: "staff" } o => $"Ten adres należy do konta zespołu studia ({o.Name}). Klient potrzebuje innego e-maila.",
        { TrainerUserId: null } o => $"{o.Name} jest już w bazie, ale bez trenera — po kliknięciu „Dodaj klienta” trafi na listę.",
        { } o when o.TrainerUserId == dto.TrainerUserId => $"{o.Name} już jest na liście klientów.",
        { } o => $"Ten adres ma już klient trenera {o.TrainerName ?? "z zespołu"}. Trenera zmieni administrator w profilu klienta.",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        var (allowed, _, max) = await Entitlements.CheckClientLimitAsync();
        _limitReached = !allowed;
        _maxClients = max;

        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        var me = await UserManager.GetUserAsync(principal);
        if (principal.IsInRole(Roles.Trainer)) dto.TrainerUserId = me?.Id;
        else if (principal.IsInRole(Roles.Subordinate)) dto.TrainerUserId = me?.SupervisorId ?? me?.Id;
        else
        {
            _trainers = (await UserService.GetTrainersAsync()).OrderBy(t => t.FullName).ToList();
            if (_trainers.Count == 1) dto.TrainerUserId = _trainers[0].Id;
        }
    }

    private async Task CheckEmailAsync()
    {
        _owner = null;
        _emailChecked = false;
        _suggestion = null;
        _emailProblem = string.IsNullOrWhiteSpace(dto.Email) ? null : EmailRules.Problem(dto.Email);
        _suggestion = string.IsNullOrWhiteSpace(dto.Email) ? null : EmailRules.Suggestion(dto.Email);
        if (string.IsNullOrWhiteSpace(dto.Email) || _emailProblem is not null) return;
        _owner = await ClientService.FindEmailOwnerAsync(dto.Email);
        _emailChecked = true;
    }

    private async Task UseSuggestionAsync()
    {
        dto.Email = _suggestion ?? dto.Email;
        await CheckEmailAsync();
    }

    private async Task Submit()
    {
        if (_limitReached) return;
        error = string.Empty;
        if (EmailRules.Problem(dto.Email) is { } problem) { error = problem; return; }
        if (string.IsNullOrWhiteSpace(dto.FirstName) && string.IsNullOrWhiteSpace(dto.LastName))
        { error = "Podaj imię lub nazwisko."; return; }
        if (_trainers is not null && string.IsNullOrEmpty(dto.TrainerUserId)) { error = "Wybierz trenera klienta."; return; }

        // Re-check right before the mutation to close the race window between page load and submit
        var (allowed, _, max) = await Entitlements.CheckClientLimitAsync();
        if (!allowed) { _limitReached = true; _maxClients = max; return; }

        isBusy = true;
        try
        {
            var result = await ClientService.AddClientAsync(dto);
            if (!result.Ok) { error = result.Error ?? "Nie udało się dodać klienta."; isBusy = false; return; }
            var client = result.Client!;
            if (result.Notice is { } notice)
            {
                Nav.NavigateTo($"/clients/{client.Id}?info={Uri.EscapeDataString(notice)}");
                return;
            }
            var invite = "?invite=none";
            if (_sendInvite)
            {
                var r = await Invitations.SendInviteAsync(client.Id, Nav.BaseUri);
                invite = r.EmailSent ? "?invite=sent" : "?invite=failed";
            }
            Nav.NavigateTo($"/clients/{client.Id}{invite}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
            isBusy = false;
        }
    }
}
