@code {
    [Parameter] public int Id { get; set; }

    private ClientDto? client;
    private List<TrainerNoteDto>? notes;
    private List<SessionDto>? sessions;
    private bool notFound;
    private bool isBusy;

    private bool editMode;
    private UpdateClientDto editDto = new();
    private string editError = string.Empty;

    private string newNote = string.Empty;
    private string currentUserId = string.Empty;
    private string currentUserEmail = string.Empty;
    private string currentUserRole = string.Empty;

    private string newPw  = string.Empty;
    private string pwMsg  = string.Empty;
    private bool pwError;

    private bool bookingOpen;
    private CreateSessionDto bookingDto = new();
    private string bookingDate = string.Empty;
    private TimeOnly bookingTime;
    private string bookingError = string.Empty;
    private bool bookingOverlap;   // kolizja terminu wykryta — czeka na potwierdzenie nałożenia
    private List<SessionTypeDto> sessionTypes = [];

    private List<SessionPackageDto>? packages;
    private bool addPackageOpen;
    private CreateSessionPackageDto newPkg = new();
    private string pkgError = string.Empty;

    private bool editPackageOpen;
    private int editPackageId;
    private UpdateSessionPackageDto editPkg = new();
    private string editPkgError = string.Empty;

    private List<BodyMeasurementDto>? measurements;
    private bool addMeasurementOpen;
    private CreateBodyMeasurementDto newMeasurement = new();
    private string measurementError = string.Empty;

    private string _tab = "sessions";
    private int _activeCredits;
    private int _completedCount;
    private decimal _unpaidBalance;
    private DateOnly? _lastMeasDate;

    private readonly Dictionary<string, (string Label, string Unit)> _chartMetrics = new()
    {
        ["weight"] = ("Waga",       "kg"),
        ["fat"]    = ("% tłuszczu", "%"),
        ["waist"]  = ("Talia",      "cm"),
        ["chest"]  = ("Klatka",     "cm"),
        ["hips"]   = ("Biodra",     "cm"),
        ["thigh"]  = ("Udo",        "cm"),
        ["arm"]    = ("Ramię",      "cm"),
    };
    private string _chartMetric = "weight";
    private bool _chartNeedsRender;

    private static readonly System.Globalization.CultureInfo _plCulture = new("pl-PL");
    private string _reportMonth = DateTime.Now.ToString("yyyy-MM");

    private string ReportUrl()
    {
        if (!DateTime.TryParseExact($"{_reportMonth}-01", "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dt))
            dt = DateTime.Now;
        return $"/reports/client/{Id}/monthly?year={dt.Year}&month={dt.Month}";
    }

    private List<(int Id, string FullName)> _clientNav = [];
    private List<int> _clientIds = [];
    private int? _prevId;
    private int? _nextId;
    private string _prevName = string.Empty;
    private string _nextName = string.Empty;
    private int _lastLoadedId;
    private bool _isAdmin;
    private bool _initialized;

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            currentUserEmail = auth.User.Identity?.Name ?? currentUserId;
            _isAdmin = auth.User.IsInRole(PTScheduler.Domain.Constants.Roles.Admin);
            currentUserRole = _isAdmin ? PTScheduler.Domain.Constants.Roles.Admin
                            : auth.User.IsInRole(PTScheduler.Domain.Constants.Roles.Trainer) ? PTScheduler.Domain.Constants.Roles.Trainer
                            : PTScheduler.Domain.Constants.Roles.Subordinate;

            var trainerUserId = _isAdmin ? null : currentUserId;
            var navList = await ClientService.GetClientsAsync(trainerUserId);
            _clientNav = navList.Select(c => (c.Id, c.FullName)).ToList();
            _clientIds = _clientNav.Select(n => n.Id).ToList();

            _initialized = true;
        }

        if (_lastLoadedId == Id) return;

        // Reset state for new client
        notFound = false;
        client = null;
        notes = null;
        sessions = null;
        packages = null;
        measurements = null;
        editMode = false;
        addPackageOpen = false;
        editPackageOpen = false;
        bookingOpen = false;
        addMeasurementOpen = false;
        pwMsg = string.Empty;
        editError = string.Empty;

        UpdateNavIds();
        _lastLoadedId = Id;

        client = await ClientService.GetClientAsync(Id);
        if (client is null) { notFound = true; return; }

        if (!_isAdmin && client.TrainerUserId != currentUserId) { notFound = true; client = null; return; }

        await LoadNotes();
        await LoadSessions();
        if (sessionTypes.Count == 0) await LoadSessionTypes();
        await LoadPackages();
        await LoadMeasurements();
        ComputeStats();
    }

    private void UpdateNavIds()
    {
        var idx = _clientIds.IndexOf(Id);
        _prevId = idx > 0 ? _clientIds[idx - 1] : null;
        _nextId = idx >= 0 && idx < _clientIds.Count - 1 ? _clientIds[idx + 1] : null;
        _prevName = _prevId.HasValue ? _clientNav[idx - 1].FullName : string.Empty;
        _nextName = _nextId.HasValue ? _clientNav[idx + 1].FullName : string.Empty;
    }

    private void GoPrev()
    {
        if (_prevId.HasValue) Nav.NavigateTo($"/clients/{_prevId.Value}");
    }

    private void GoNext()
    {
        if (_nextId.HasValue) Nav.NavigateTo($"/clients/{_nextId.Value}");
    }

    private async Task LoadNotes()
    {
        notes = await ClientService.GetNotesAsync(Id);
    }

    private async Task LoadSessions()
    {
        sessions = await SessionService.GetClientSessionsAsync(Id, 200);
    }

    private async Task LoadSessionTypes()
    {
        sessionTypes = await SessionService.GetSessionTypesAsync();
    }

    private async Task LoadPackages()
    {
        packages = await PackageService.GetPackagesAsync(Id);
    }

    private async Task LoadMeasurements()
    {
        measurements = await MeasurementService.GetAsync(Id);
        _chartNeedsRender = true;
    }

    private void ComputeStats()
    {
        _activeCredits  = packages?.Where(p => p.Status == PackageStatus.Active).Sum(p => p.RemainingCredits) ?? 0;
        _completedCount = sessions?.Count(s => s.Status == PTScheduler.Domain.Enums.SessionStatus.Completed) ?? 0;
        _unpaidBalance  = packages?.Where(p => !p.IsPaid && p.Status != PackageStatus.Cancelled).Sum(p => p.TotalPrice) ?? 0m;
        _lastMeasDate   = measurements?.OrderByDescending(m => m.MeasurementDate).FirstOrDefault()?.MeasurementDate;
    }

    private void SelectTab(string tab)
    {
        _tab = tab;
        if (tab == "measurements" && measurements is { Count: >= 2 })
            _chartNeedsRender = true;
    }

    private async Task SaveMeasurement()
    {
        newMeasurement.ClientId = Id;
        isBusy = true;
        measurementError = string.Empty;
        try
        {
            await MeasurementService.AddAsync(newMeasurement);
            await AuditLogService.LogAsync(currentUserId, currentUserEmail, currentUserRole, "MeasurementAdded", "BodyMeasurement",
                null, $"Klient: {client?.FullName}, data: {newMeasurement.MeasurementDate:dd.MM.yyyy}");
            newMeasurement = new CreateBodyMeasurementDto();
            addMeasurementOpen = false;
            measurements = await MeasurementService.GetAsync(Id);
            _chartNeedsRender = true;
        }
        catch (Exception ex) { measurementError = ex.Message; }
        finally { isBusy = false; }
    }

    private async Task DeleteMeasurement(int id)
    {
        await MeasurementService.DeleteAsync(id);
        await AuditLogService.LogAsync(currentUserId, currentUserEmail, currentUserRole, "MeasurementDeleted", "BodyMeasurement",
            id.ToString(), $"Klient: {client?.FullName}");
        measurements = await MeasurementService.GetAsync(Id);
        _chartNeedsRender = true;
    }

    private DotNetObjectReference<ClientProfile>? _kbRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _kbRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("PTKeyboard.listen", _kbRef, nameof(HandleKeyAsync)); }
            catch { /* JS not yet available — ignore */ }
        }

        if (_chartNeedsRender && measurements is { Count: >= 2 })
        {
            _chartNeedsRender = false;
            await RenderChart();
        }
    }

    /// <summary>
    /// Invoked from JS for ArrowLeft / ArrowRight / Escape (when user is NOT typing
    /// in an input). Esc closes any open modal first; arrows otherwise navigate
    /// between clients in the order shown in <c>/clients</c>.
    /// </summary>
    [JSInvokable]
    public Task HandleKeyAsync(string key)
    {
        // Escape: close modals or cancel edit/booking flows
        if (key == "Escape")
        {
            var anyClosed = false;
            if (addPackageOpen)       { addPackageOpen = false;       anyClosed = true; }
            if (editPackageOpen)      { editPackageOpen = false;      anyClosed = true; }
            if (bookingOpen)          { bookingOpen = false;          anyClosed = true; }
            if (addMeasurementOpen)   { addMeasurementOpen = false;   anyClosed = true; }
            if (editMode)             { editMode = false;             anyClosed = true; }
            if (anyClosed) StateHasChanged();
            return Task.CompletedTask;
        }

        // Don't navigate while a modal is open — would feel jarring.
        if (addPackageOpen || editPackageOpen || bookingOpen || addMeasurementOpen) return Task.CompletedTask;

        switch (key)
        {
            case "ArrowLeft":
                if (_prevId.HasValue) GoPrev();
                break;
            case "ArrowRight":
                if (_nextId.HasValue) GoNext();
                break;
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("PTKeyboard.unlisten"); }
        catch { /* circuit may already be torn down */ }
        _kbRef?.Dispose();
    }

    private async Task SelectMetric(string key)
    {
        _chartMetric = key;
        await RenderChart();
    }

    private async Task RenderChart()
    {
        if (measurements is not { Count: >= 2 }) return;

        var sorted = measurements.OrderBy(m => m.MeasurementDate).ToList();
        var meta = _chartMetrics[_chartMetric];

        var points = sorted
            .Select(m => (
                Date: m.MeasurementDate.ToString("dd.MM.yy"),
                Value: _chartMetric switch
                {
                    "weight" => m.WeightKg,
                    "fat"    => m.BodyFatPercent,
                    "waist"  => m.WaistCm,
                    "chest"  => m.ChestCm,
                    "hips"   => m.HipsCm,
                    "thigh"  => m.ThighCm,
                    "arm"    => m.ArmCm,
                    _        => (decimal?)null
                }))
            .Where(p => p.Value.HasValue)
            .ToList();

        if (points.Count < 2) return;

        await JS.InvokeVoidAsync("PTChart.renderLine",
            $"meas-chart-{Id}",
            points.Select(p => p.Date).ToArray(),
            points.Select(p => (double)p.Value!.Value).ToArray(),
            meta.Label,
            meta.Unit);
    }

    private static RenderFragment MeasCell(decimal? val, decimal? prevVal, string unit, bool upIsGood) => builder =>
    {
        if (val is null) { builder.AddContent(0, "—"); return; }
        builder.AddContent(0, $"{val:0.#} {unit}");
        if (prevVal is null) return;
        var diff = val.Value - prevVal.Value;
        if (diff == 0) return;
        var isPositive = diff > 0;
        var isGood = upIsGood ? isPositive : !isPositive;
        var arrow = isPositive ? "↑" : "↓";
        var color = isGood ? "#16a34a" : "#dc2626";
        builder.AddMarkupContent(1, $" <span style=\"color:{color};font-size:.75rem\">{arrow}</span>");
    };

