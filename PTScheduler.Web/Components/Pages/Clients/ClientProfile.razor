    private async Task SendInvite(bool email)
    {
        if (client is null) return;
        _inviteBusy = true;
        _inviteMsg = string.Empty;
        _inviteCopied = false;
        try
        {
            var r = await Invitations.SendInviteAsync(Id, Nav.BaseUri, sendEmail: email);
            _inviteLink = r.Link;
            if (!r.Success)
            {
                _inviteMsg = r.Error ?? "Nie udało się przygotować zaproszenia.";
                _inviteError = true;
            }
            else if (email && r.EmailSent)
            {
                _inviteMsg = $"Zaproszenie wysłane na {client.Email}.";
                _inviteError = false;
                await AuditLogService.LogAsync(currentUserId, currentUserEmail, currentUserRole, "ClientInviteSent", "Client",
                    Id.ToString(), $"Klient: {client.FullName}");
            }
            else if (email)
            {
                _inviteMsg = r.Error ?? "Nie udało się wysłać e-maila — skopiuj link i wyślij go klientowi.";
                _inviteError = true;
            }
            else
            {
                _inviteMsg = "Link gotowy — wyślij go klientowi SMS-em lub w komunikatorze.";
                _inviteError = false;
                await AuditLogService.LogAsync(currentUserId, currentUserEmail, currentUserRole, "ClientInviteLink", "Client",
                    Id.ToString(), $"Klient: {client.FullName}");
            }
        }
        catch (Exception ex)
        {
            _inviteMsg = ex.Message;
            _inviteError = true;
        }
        finally { _inviteBusy = false; }
    }

    private async Task CopyInviteLink()
    {
        if (string.IsNullOrEmpty(_inviteLink)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _inviteLink);
            _inviteCopied = true;
        }
        catch { _inviteMsg = "Nie udało się skopiować — zaznacz link i skopiuj ręcznie."; _inviteError = true; }
