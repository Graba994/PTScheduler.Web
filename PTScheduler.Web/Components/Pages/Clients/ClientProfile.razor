@page "/clients/{Id:int}"
@implements IAsyncDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@inject IOffPackageService OffPackage
@inject IClientService ClientService
@inject ISessionService SessionService
@inject ISessionPackageService PackageService
@inject IPairService PairService
@inject IUserManagementService UserManagementService
@inject IBodyMeasurementService MeasurementService
@inject IAuditLogService AuditLogService
@inject NavigationManager Nav
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Exceptions
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject EntitlementService Entitlements
@inject IClientInvitationService Invitations
@inject IAppClock Clock
@inject IWorkoutLogService WorkoutLog
@inject ITrainingPlanService PlanService
@inject IProgressionService Progression
@inject ISurveyService Surveys
@inject IChatService Chat
@inject IClientDocumentService DocumentSvc
@rendermode PTScheduler.Web.RenderModes.Server

<PageTitle>@(client?.FullName ?? "Profil klienta")</PageTitle>

@if (client is null && !notFound)
{
    <div class="d-flex align-items-center gap-3 mb-3">
        <div class="skeleton skeleton-circle" style="width:64px;height:64px"></div>
        <div style="flex:1">
            <div class="skeleton skeleton-line w-50" style="height:18px"></div>
            <div class="skeleton skeleton-line w-40" style="height:12px;margin-bottom:0"></div>
        </div>
    </div>
    <div class="ad-kpis">
        @for (var i = 0; i < 4; i++) { <div class="skeleton-card" style="height:110px"></div> }
    </div>
    <div class="skeleton-card" style="height:260px"></div>
}
else if (notFound)
{
    <div class="alert alert-warning">Klient nie został znaleziony.</div>
}
else if (client is not null)
{
    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
        <nav aria-label="breadcrumb" class="m-0 flex-grow-1 min-w-0">
            <ol class="breadcrumb m-0 flex-nowrap">
                <li class="breadcrumb-item"><a href="/clients">Klienci</a></li>
                <li class="breadcrumb-item active text-truncate" style="min-width:0">@client.FullName</li>
            </ol>
        </nav>
        @if (_clientIds.Count > 1)
        {
            <div class="client-paginator d-inline-flex align-items-center flex-shrink-0">
                <button type="button" class="client-paginator-btn" @onclick="GoPrev"
                        disabled="@(_prevId is null)"
                        title="@(_prevId is null ? "Brak poprzedniego klienta" : $"Poprzedni: {_prevName} (←)")">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="client-paginator-counter" title="Użyj ← i → aby przełączać klientów">
                    <span class="pc-current">@(_clientIds.IndexOf(Id) + 1)</span><span class="pc-sep"> / </span><span class="pc-total">@_clientIds.Count</span>
                </span>
                <button type="button" class="client-paginator-btn" @onclick="GoNext"
                        disabled="@(_nextId is null)"
                        title="@(_nextId is null ? "Brak następnego klienta" : $"Następny: {_nextName} (→)")">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        }
    </div>

    @if (client.Status == ClientStatus.Pending)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3 mb-3 flex-wrap">
            <i class="bi bi-hourglass-split fs-4 flex-shrink-0"></i>
            <div class="flex-grow-1">
                <strong>Klient oczekuje na zatwierdzenie.</strong>
                <div class="small">Zarejestrował się samodzielnie. Zatwierdź, aby uzyskał pełny dostęp.</div>
            </div>
            <button class="btn btn-warning btn-sm flex-shrink-0" @onclick="ApproveClient" disabled="@isBusy">
                @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                <i class="bi bi-check-circle me-1"></i>Zatwierdź klienta
            </button>
        </div>
    }

    <!-- Nagłówek: kto to jest i co możesz zrobić -->
    <section class="cp-hero">
        <div class="cp-avatar">
            @if (!string.IsNullOrEmpty(client.ProfilePictureUrl))
            {
                <img src="@client.ProfilePictureUrl" alt="@client.FullName" />
            }
            else
            {
                <span>@(string.IsNullOrEmpty(client.Initials) ? "?" : client.Initials)</span>
            }
        </div>
        <div class="cp-hero-main">
            <h4 class="cp-name">@client.FullName</h4>
            <div class="cp-chips">
                @if (client.Status == ClientStatus.Pending)
                {
                    <span class="cp-chip warn"><i class="bi bi-hourglass-split"></i>Oczekuje</span>
                }
                else
                {
                    <span class="cp-chip ok"><i class="bi bi-circle-fill"></i>Aktywny</span>
                }
                <span class="cp-chip"><i class="bi bi-calendar-heart"></i>Klient od @client.CreatedAt.ToString("MM.yyyy")</span>
                @if (_age is int age) { <span class="cp-chip"><i class="bi bi-person"></i>@age lat</span> }
                @if (client.TrustedForDeferredPayment) { <span class="cp-chip"><i class="bi bi-shield-check"></i>Zaufany</span> }
                @if (_account is { LastLoginUtc: null }) { <span class="cp-chip muted"><i class="bi bi-phone"></i>Nie korzysta z aplikacji</span> }
            </div>
            @if (!string.IsNullOrWhiteSpace(client.TrainingGoal))
            {
                <div class="cp-goal"><i class="bi bi-bullseye"></i><span>@client.TrainingGoal</span></div>
            }
            <div class="cp-contact">
                @if (!string.IsNullOrEmpty(client.Phone))
                {
                    <a href="@($"tel:{client.Phone}")"><i class="bi bi-telephone"></i>@client.Phone</a>
                }
                <a href="@($"mailto:{client.Email}")"><i class="bi bi-envelope"></i>@client.Email</a>
            </div>
        </div>
        <div class="cp-actions">
            <button class="btn btn-primary btn-sm" @onclick="OpenBooking"><i class="bi bi-calendar-plus me-1"></i>Zarezerwuj</button>
            <a class="btn btn-outline-primary btn-sm position-relative" href="@($"/chat?client={Id}")">
                <i class="bi bi-chat-dots me-1"></i>Wiadomość
                @if (_unreadChat > 0) { <span class="cp-dot">@_unreadChat</span> }
            </a>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => { SelectTab("account"); StartEdit(); }'><i class="bi bi-pencil me-1"></i>Edytuj</button>
        </div>
    </section>

    <!-- Najważniejsze liczby -->
    <div class="ad-kpis cp-kpis">
        <button type="button" class="ad-kpi" @onclick='() => SelectTab("sessions")'>
            <span class="ad-kpi-ic"><i class="bi bi-calendar-event"></i></span>
            @if (_nextSession is { } ns)
            {
                <span class="ad-kpi-val cp-kpi-date">@DayLabel(ns.StartTime) <small>@ns.StartTime.ToString("HH:mm")</small></span>
                <span class="ad-kpi-lab">najbliższa wizyta</span>
                <span class="ad-kpi-sub text-truncate">@ns.SessionTypeName</span>
            }
            else
            {
                <span class="ad-kpi-val">—</span>
                <span class="ad-kpi-lab">najbliższa wizyta</span>
                <span class="ad-kpi-sub">nic nie zaplanowano</span>
            }
        </button>
        <button type="button" class="ad-kpi" @onclick='() => SelectTab("packages")'>
            <span class="ad-kpi-ic green"><i class="bi bi-box-seam"></i></span>
            <span class="ad-kpi-val">@_activeCredits</span>
            <span class="ad-kpi-lab">treningów w pakiecie</span>
            <span class="ad-kpi-sub text-truncate @(_activeCredits <= 1 ? "down" : "")">@(_activePackageName ?? "brak aktywnego pakietu")</span>
        </button>
        @if (_plansOn)
        {
            <button type="button" class="ad-kpi" @onclick='() => SelectTab("activity")'>
                <span class="ad-kpi-ic violet"><i class="bi pt-ico-dumbbell"></i></span>
                <span class="ad-kpi-val">@_workouts30</span>
                <span class="ad-kpi-lab">treningów z planu (30 dni)</span>
                <span class="ad-kpi-sub @(_daysSinceWorkout is > 7 ? "down" : "")">@(_lastWorkout is { } lw ? "ostatni " + Ago(lw) : "jeszcze żadnego")</span>
            </button>
        }
        else
        {
            <button type="button" class="ad-kpi" @onclick='() => SelectTab("sessions")'>
                <span class="ad-kpi-ic violet"><i class="bi bi-check2-circle"></i></span>
                <span class="ad-kpi-val">@_completedCount</span>
                <span class="ad-kpi-lab">odbytych wizyt</span>
                <span class="ad-kpi-sub">@(client.LastSessionDate is { } ls ? "ostatnia " + ls.ToString("dd.MM") : "jeszcze żadnej")</span>
            </button>
        }
        <button type="button" class="ad-kpi" @onclick='() => SelectTab("packages")'>
            <span class="ad-kpi-ic amber"><i class="bi bi-wallet2"></i></span>
            @if (_unpaidBalance > 0 || _unpaidOffPackage > 0)
            {
                <span class="ad-kpi-val text-danger">@(_unpaidBalance > 0 ? _unpaidBalance.ToString("N0") : "0") <small>zł</small></span>
                <span class="ad-kpi-lab">do zapłaty</span>
                <span class="ad-kpi-sub down">@(_unpaidOffPackage > 0 ? $"+ {_unpaidOffPackage} trening(i) poza pakietem" : "nieopłacony pakiet")</span>
            }
            else
            {
                <span class="ad-kpi-val text-success"><i class="bi bi-check2"></i></span>
                <span class="ad-kpi-lab">rozliczenia</span>
                <span class="ad-kpi-sub">wszystko opłacone</span>
            }
        </button>
    </div>

    <!-- Zakładki -->
    <nav class="cp-tabs" role="tablist">
        @foreach (var (key, icon, label, count) in Tabs())
        {
            <button type="button" role="tab" class="cp-tab @(_tab == key ? "active" : "")" aria-selected="@(_tab == key)" @onclick="() => SelectTab(key)">
                <i class="bi @icon"></i><span>@label</span>
                @if (count > 0) { <span class="cp-tab-count">@count</span> }
            </button>
        }
    </nav>

    @if (_tab == "overview")
    {
        <div class="cp-grid cp-overview">
            <div class="cp-col">
                <section class="cp-card cp-o1">
                    <h6 class="cp-card-title"><i class="bi bi-bell"></i>Co się dzieje</h6>
                    @if (_attention.Count == 0)
                    {
                        <div class="cp-allgood"><i class="bi bi-emoji-smile"></i><span><b>Wszystko w porządku.</b> Nic nie czeka na Twoją reakcję.</span></div>
                    }
                    else
                    {
                        <div class="cp-att-list">
                            @foreach (var a in _attention)
                            {
                                @if (a.Href is not null)
                                {
                                    <a class="cp-att @a.Level" href="@a.Href"><i class="bi @a.Icon"></i><span>@a.Text</span><i class="bi bi-chevron-right cp-go"></i></a>
                                }
                                else
                                {
                                    <button type="button" class="cp-att @a.Level" @onclick="() => SelectTab(a.Tab!)"><i class="bi @a.Icon"></i><span>@a.Text</span><i class="bi bi-chevron-right cp-go"></i></button>
                                }
                            }
                        </div>
                    }
                </section>

                <section class="cp-card cp-o3">
                    <h6 class="cp-card-title"><i class="bi bi-activity"></i>Ostatnio u klienta</h6>
                    @if (_feed.Count == 0)
                    {
                        <p class="text-muted small mb-0">Jeszcze nic się nie wydarzyło — zarezerwuj pierwszy trening albo przypisz plan.</p>
                    }
                    else
                    {
                        var hidden = _feed.Count - _feedShown;
                        <ol class="cp-feed @(hidden > 0 ? "has-more" : "")">
                            @foreach (var f in _feed.Take(_feedShown))
                            {
                                <li>
                                    <span class="cp-feed-ic @f.Tone"><i class="bi @f.Icon"></i></span>
                                    <div class="cp-feed-body">
                                        @if (f.Tab is not null)
                                        {
                                            <button type="button" class="cp-feed-title" @onclick="() => SelectTab(f.Tab)">@f.Title</button>
                                        }
                                        else
                                        {
                                            <span class="cp-feed-title">@f.Title</span>
                                        }
                                        @if (!string.IsNullOrEmpty(f.Sub)) { <small>@f.Sub</small> }
                                    </div>
                                    <time>@Ago(f.When)</time>
                                </li>
                            }
                        </ol>
                        @if (hidden > 0)
                        {
                            <button type="button" class="cp-feed-more" @onclick="() => _feedShown += 10">
                                <span class="cp-feed-more-ic"><i class="bi bi-chevron-double-down"></i></span>
                                <span>Pokaż starsze <b>(@hidden)</b></span>
                            </button>
                        }
                        else if (_feedShown > FeedStart)
                        {
                            <button type="button" class="cp-feed-more" @onclick="() => _feedShown = FeedStart">
                                <span class="cp-feed-more-ic"><i class="bi bi-chevron-double-up"></i></span>
                                <span>Zwiń</span>
                            </button>
                        }
                    }
                </section>
            </div>

            <div class="cp-col">
                <section class="cp-card cp-o2">
                    <div class="cp-card-head">
                        <h6 class="cp-card-title mb-0"><i class="bi bi-calendar-week"></i>Najbliższe wizyty</h6>
                        <button class="btn btn-link btn-sm p-0" @onclick="OpenBooking"><i class="bi bi-plus-lg me-1"></i>Dodaj</button>
                    </div>
                    @if (Upcoming.Count == 0)
                    {
                        <p class="text-muted small mb-0">Brak zaplanowanych wizyt.</p>
                    }
                    else
                    {
                        @foreach (var s in Upcoming.Take(3))
                        {
                            @SessionRow(s)
                        }
                        @if (Upcoming.Count > 3)
                        {
                            <button class="btn btn-link btn-sm p-0 mt-1" @onclick='() => SelectTab("sessions")'>Wszystkie (@Upcoming.Count)</button>
                        }
                    }
                </section>

                <section class="cp-card cp-o4">
                    <h6 class="cp-card-title"><i class="bi bi-journal-text"></i>Notatki trenera</h6>
                    <div class="cp-note-new">
                        <textarea class="form-control form-control-sm" rows="2" placeholder="Np. boli kolano przy przysiadzie, cel na wakacje…" @bind="newNote"></textarea>
                        <button class="btn btn-outline-primary btn-sm" @onclick="AddNote" disabled="@(string.IsNullOrWhiteSpace(newNote) || isBusy)">
                            <i class="bi bi-plus-lg me-1"></i>Dodaj
                        </button>
                    </div>
                    @if (notes is null)
                    {
                        <div class="text-center"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    }
                    else if (!notes.Any())
                    {
                        <p class="text-muted small mb-0">Brak notatek. Widzisz je tylko Ty i Twój zespół.</p>
                    }
                    else
                    {
                        @foreach (var note in notes)
                        {
                            <div class="cp-note">
                                <div class="cp-note-meta">
                                    <span>@note.TrainerName · @note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                    <button class="btn btn-link btn-sm text-danger p-0" title="Usuń notatkę" @onclick="() => DeleteNote(note.Id)"><i class="bi bi-x-lg"></i></button>
                                </div>
                                <div class="cp-note-text">@note.Content</div>
                            </div>
                        }
                    }
                </section>
            </div>
        </div>
    }

    @if (_tab == "activity")
    {
        <FeatureGate Flag="TrainingPlansEnabled" RequiredPlan="Pro" Title="Treningi z planu">
            <div class="cp-facts">
                <div><small>Ostatni trening</small><b>@(_lastWorkout is { } lw2 ? Ago(lw2) : "—")</b><span>@(_lastWorkout?.ToString("dd.MM.yyyy") ?? "brak zapisanych")</span></div>
                <div><small>7 dni</small><b>@_workouts7</b><span>@Plural(_workouts7, "trening", "treningi", "treningów")</span></div>
                <div><small>30 dni</small><b>@_workouts30</b><span>@Plural(_workouts30, "trening", "treningi", "treningów")</span></div>
                <div><small>Objętość 30 dni</small><b>@_volume30.ToString("N0") kg</b><span>suma ciężaru × powtórzeń</span></div>
            </div>

            <div class="cp-grid">
                <div class="cp-col">
                    <section class="cp-card">
                        <h6 class="cp-card-title"><i class="bi bi-bar-chart"></i>Regularność — ostatnie 12 tygodni</h6>
                        <div class="cp-weeks" role="img" aria-label="Liczba treningów w kolejnych tygodniach">
                            @foreach (var w in _weeks)
                            {
                                <div class="cp-week" title="@($"Tydzień od {w.Start:dd.MM}: {w.Count} {Plural(w.Count, "trening", "treningi", "treningów")}")">
                                    <span class="cp-week-n">@(w.Count > 0 ? w.Count : "")</span>
                                    <span class="cp-week-bar @(w.Count == 0 ? "zero" : "")" style="height:@(Math.Max(6, w.Count * 100 / Math.Max(1, _weeksMax)))%"></span>
                                    <span class="cp-week-lab">@w.Start.ToString("dd.MM")</span>
                                </div>
                            }
                        </div>
                    </section>

                    <ProgressionSuggestions ClientId="Id" UserId="@currentUserId" IsAdmin="_isAdmin" />

                    <section class="cp-card">
                        <div class="cp-card-head">
                            <h6 class="cp-card-title mb-0"><i class="bi bi-journal-check"></i>Dziennik treningów</h6>
                            @if (_journal.Count > JournalShown)
                            {
                                <a class="btn btn-link btn-sm p-0" href="@($"/trainer/activity/{Id}")">Cały dziennik</a>
                            }
                        </div>
                        @if (_journal.Count == 0)
                        {
                            <p class="text-muted small mb-0">Klient nie zapisał jeszcze treningu z planu. Treningi pojawią się tu, gdy klient zakończy je w aplikacji.</p>
                        }
                        else
                        {
                            <p class="text-muted small">Rozwiń dzień, żeby zobaczyć serie i dodać komentarz — klient dostanie powiadomienie.</p>
                            <WorkoutJournal ClientId="Id" Days="_journal.Take(JournalShown).ToList()" AsTrainer="true" CurrentUserId="@currentUserId" Surveys="_postWorkout" />
                        }
                    </section>
                </div>

                <div class="cp-col">
                    <section class="cp-card">
                        <div class="cp-card-head">
                            <h6 class="cp-card-title mb-0"><i class="bi bi-clipboard-check"></i>Plany klienta</h6>
                            <a class="btn btn-link btn-sm p-0" href="/plans/new"><i class="bi bi-plus-lg me-1"></i>Nowy</a>
                        </div>
                        @if (_plans.Count == 0)
                        {
                            <p class="text-muted small mb-0">Brak przypisanego planu. Przypisz plan, a klient zobaczy go w aplikacji i zacznie zapisywać treningi.</p>
                        }
                        else
                        {
                            @foreach (var p in _plans)
                            {
                                <a class="cp-plan" href="@($"/plans/edit/{p.Id}")">
                                    <span class="cp-plan-ic"><i class="bi bi-clipboard-pulse"></i></span>
                                    <span class="min-w-0"><b class="text-truncate d-block">@p.Name</b><small>@p.DayCount @Plural(p.DayCount, "dzień", "dni", "dni") · @p.ExerciseCount @Plural(p.ExerciseCount, "ćwiczenie", "ćwiczenia", "ćwiczeń")</small></span>
                                    <i class="bi bi-chevron-right cp-go"></i>
                                </a>
                            }
                        }
                    </section>

                    <section class="cp-card">
                        <h6 class="cp-card-title"><i class="bi bi-trophy"></i>Rekordy</h6>
                        @if (_records.Count == 0)
                        {
                            <p class="text-muted small mb-0">Rekordy pojawią się po pierwszych treningach z ciężarem.</p>
                        }
                        else
                        {
                            @foreach (var r in _records)
                            {
                                <div class="cp-pr">
                                    <span class="text-truncate">@r.ExerciseName</span>
                                    <b>@r.MaxWeight.ToString("0.##") kg <small>× @r.RepsAtMax</small></b>
                                </div>
                            }
                        }
                    </section>

                    @if (_insights.Count > 0)
                    {
                        <section class="cp-card">
                            <h6 class="cp-card-title"><i class="bi bi-heart-pulse"></i>Z ankiet po treningu</h6>
                            @foreach (var ins in _insights)
                            {
                                <div class="cp-insight @ins.Level.ToString().ToLowerInvariant()"><i class="bi @InsightIcon(ins.Level)"></i><span>@ins.Text</span></div>
                            }
                            <button class="btn btn-link btn-sm p-0 mt-1" @onclick='() => SelectTab("surveys")'>Wszystkie ankiety</button>
                        </section>
                    }
                </div>
            </div>
        </FeatureGate>
    }

    @if (_tab == "sessions")
    {
        <section class="cp-card">
            <div class="cp-card-head">
                <h6 class="cp-card-title mb-0"><i class="bi bi-calendar-week"></i>Zaplanowane</h6>
                <button class="btn btn-primary btn-sm" @onclick="OpenBooking"><i class="bi bi-calendar-plus me-1"></i>Zarezerwuj</button>
            </div>
            @if (sessions is null)
            {
                <div class="text-center py-3"><div class="spinner-border text-primary"></div></div>
            }
            else if (Upcoming.Count == 0)
            {
                <p class="text-muted small mb-0">Brak zaplanowanych wizyt.</p>
            }
            else
            {
                @foreach (var s in Upcoming) { @SessionRow(s) }
            }
        </section>
        <section class="cp-card">
            <h6 class="cp-card-title"><i class="bi bi-clock-history"></i>Historia wizyt <span class="text-muted fw-normal small">(@Past.Count)</span></h6>
            @if (Past.Count == 0)
            {
                <p class="text-muted small mb-0">Brak minionych wizyt.</p>
            }
            else
            {
                @foreach (var s in Past.Take(_pastShown)) { @SessionRow(s) }
                @if (Past.Count > _pastShown)
                {
                    <button class="btn btn-outline-secondary btn-sm w-100 mt-2" @onclick="() => _pastShown += 20">Pokaż więcej</button>
                }
            }
        </section>
    }

    @if (_tab == "surveys")
    {
        <ClientSurveysPanel ClientId="Id" CurrentUserId="@currentUserId" />
    }

    @if (_tab == "photos" && Entitlements.IsAllowed("BodyMeasurements"))
    {
        <ProgressPhotos ClientId="Id" UserId="@currentUserId" IsStaff="true" />
    }

    @if (_tab == "packages")
    {
        <section class="cp-card">
            <div class="cp-card-head">
                <h6 class="cp-card-title mb-0"><i class="bi bi-box-seam"></i>Pakiety</h6>
                <button class="btn btn-outline-primary btn-sm flex-shrink-0" @onclick="OpenAddPackage">
                    <i class="bi bi-plus-lg me-1"></i>Dodaj pakiet
                </button>
            </div>

            @if (packages is null)
            {
                <div class="text-center"><div class="spinner-border spinner-border-sm text-primary"></div></div>
            }
            else if (!packages.Any())
            {
                <div class="empty-state py-3">
                    <div class="empty-state-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="empty-state-title">Brak pakietów</div>
                    <div class="empty-state-desc">Ten klient nie ma jeszcze żadnych pakietów.</div>
                </div>
            }
            else
            {
                @foreach (var pkg in packages)
                {
                    <div class="cp-pkg @(pkg.Status == PackageStatus.Active ? "" : "inactive")">
                        <div class="d-flex justify-content-between align-items-start mb-1 flex-wrap gap-1">
                            <div class="fw-semibold small">
                                @pkg.Name
                                @if (pkg.IsForPair)
                                {
                                    <span class="pair-chip ms-1"><i class="bi bi-people-fill"></i>Wspólny: @(pkg.ClientId == Id ? pkg.PartnerName : pkg.ClientName)</span>
                                }
                            </div>
                            <div class="d-flex gap-1 align-items-center flex-wrap">
                                <span class="badge @PackageBadge(pkg.Status)">@PackageLabel(pkg.Status)</span>
                                @if (pkg.IsPaid)
                                {
                                    <span class="badge bg-success-subtle text-success">Opłacony</span>
                                }
                                else
                                {
                                    <button class="badge bg-warning-subtle text-warning border-0"
                                            style="cursor:pointer" title="Oznacz jako opłacony" @onclick="() => MarkPaid(pkg.Id)">
                                        Nieopłacony ✓
                                    </button>
                                }
                                <button class="btn btn-sm btn-link text-muted p-0 ms-1" title="Edytuj pakiet"
                                        @onclick="() => OpenEditPackage(pkg)">
                                    <i class="bi bi-pencil" style="font-size:.75rem"></i>
                                </button>
                                @if (pkg.Status != PackageStatus.Cancelled)
                                {
                                    <button class="btn btn-sm btn-link text-danger p-0" title="Anuluj pakiet"
                                            @onclick="() => CancelPkg(pkg.Id)">
                                        <i class="bi bi-x-circle" style="font-size:.75rem"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="progress mb-1" style="height:6px">
                            <div class="progress-bar @(pkg.Status == PackageStatus.Depleted ? "bg-secondary" : "bg-primary")"
                                 style="width:@(pkg.TotalSessions > 0 ? pkg.UsedSessions * 100 / pkg.TotalSessions : 0)%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>@pkg.RemainingCredits / @pkg.TotalSessions treningów pozostało</span>
                            <span>@pkg.TotalPrice.ToString("N2") zł</span>
                        </div>
                        @if (pkg.ExpiresAt.HasValue)
                        {
                            <div class="small @(pkg.Status == PackageStatus.Expired ? "text-danger" : "text-muted") mt-1">
                                <i class="bi bi-calendar-x me-1"></i>
                                @if (pkg.Status == PackageStatus.Expired)
                                {
                                    <span>Przepadł @pkg.ExpiresAt.Value.ToString("dd.MM.yyyy")</span>
                                }
                                else
                                {
                                    <span>Ważny do @pkg.ExpiresAt.Value.ToString("dd.MM.yyyy")</span>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </section>
    }

    @if (_tab == "measurements")
    {
    <section class="cp-card">
        <div class="cp-card-head">
            <h6 class="cp-card-title mb-0"><i class="bi bi-rulers"></i>Pomiary ciała</h6>
            <button class="btn btn-outline-primary btn-sm" @onclick="() => { addMeasurementOpen = !addMeasurementOpen; measurementError = string.Empty; }">
                <i class="bi @(addMeasurementOpen ? "bi-x-lg" : "bi-plus-lg") me-1"></i>@(addMeasurementOpen ? "Anuluj" : "Dodaj pomiar")
            </button>
        </div>
        @if (addMeasurementOpen)
        {
            <div class="border rounded p-3 mb-3 bg-light">
                @if (!string.IsNullOrEmpty(measurementError))
                {
                    <div class="alert alert-danger py-2 small mb-2">@measurementError</div>
                }
                <div class="row g-2">
                    <div class="col-12 col-sm-6">
                        <label class="form-label form-label-sm">Data <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm"
                               value="@newMeasurement.MeasurementDate.ToString("yyyy-MM-dd")"
                               @onchange="e => newMeasurement.MeasurementDate = string.IsNullOrEmpty(e.Value?.ToString()) ? DateOnly.FromDateTime(StudioClock.Today) : DateOnly.Parse(e.Value!.ToString()!)" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label form-label-sm">Waga (kg)</label>
                        <input type="number" step="0.1" class="form-control form-control-sm" placeholder="np. 75.5"
                               @bind="newMeasurement.WeightKg" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label form-label-sm">Tk. tłuszczowa (%)</label>
                        <input type="number" step="0.1" class="form-control form-control-sm" placeholder="np. 18.0"
                               @bind="newMeasurement.BodyFatPercent" />
                    </div>
                    <div class="col-6 col-sm-4">
                        <label class="form-label form-label-sm">Klatka (cm)</label>
                        <input type="number" step="0.5" class="form-control form-control-sm"
                               @bind="newMeasurement.ChestCm" />
                    </div>
                    <div class="col-6 col-sm-4">
                        <label class="form-label form-label-sm">Talia (cm)</label>
                        <input type="number" step="0.5" class="form-control form-control-sm"
                               @bind="newMeasurement.WaistCm" />
                    </div>
                    <div class="col-6 col-sm-4">
                        <label class="form-label form-label-sm">Biodra (cm)</label>
                        <input type="number" step="0.5" class="form-control form-control-sm"
                               @bind="newMeasurement.HipsCm" />
                    </div>
                    <div class="col-6 col-sm-4">
                        <label class="form-label form-label-sm">Udo (cm)</label>
                        <input type="number" step="0.5" class="form-control form-control-sm"
                               @bind="newMeasurement.ThighCm" />
                    </div>
                    <div class="col-6 col-sm-4">
                        <label class="form-label form-label-sm">Ramię (cm)</label>
                        <input type="number" step="0.5" class="form-control form-control-sm"
                               @bind="newMeasurement.ArmCm" />
                    </div>
                    <div class="col-12">
                        <label class="form-label form-label-sm">Notatki</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="newMeasurement.Notes"></textarea>
                    </div>
                </div>
                <button class="btn btn-primary btn-sm mt-3 w-100" @onclick="SaveMeasurement" disabled="@isBusy">
                    @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="bi bi-floppy me-1"></i>Zapisz pomiar
                </button>
            </div>
        }

        @if (measurements is null)
        {
            <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
        }
        else if (!measurements.Any())
        {
            <p class="text-muted small text-center mb-0">Brak pomiarów. Dodaj pierwszy pomiar klikając przycisk powyżej.</p>
        }
        else
        {
            @if (measurements!.Count >= 2)
            {
                <div class="mb-4">
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        @foreach (var entry in _chartMetrics)
                        {
                            <button type="button"
                                    class="btn btn-sm @(_chartMetric == entry.Key ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => SelectMetric(entry.Key)">
                                @entry.Value.Label
                            </button>
                        }
                    </div>
                    <div style="height:200px;position:relative">
                        <canvas id="meas-chart-@Id"></canvas>
                    </div>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-sm align-middle" style="font-size:.85rem">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Waga</th>
                            <th>Tk. tłuszcz.</th>
                            <th>Talia</th>
                            <th>Klatka</th>
                            <th>Biodra</th>
                            <th>Udo</th>
                            <th>Ramię</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < measurements.Count; i++)
                        {
                            var m = measurements[i];
                            var prev = i + 1 < measurements.Count ? measurements[i + 1] : null;
                            <tr>
                                <td class="text-nowrap fw-semibold">@m.MeasurementDate.ToString("dd.MM.yyyy") @if (m.AddedByClient) { <span class="badge bg-info-subtle text-info-emphasis fw-normal ms-1" title="Wpisane przez klienta w aplikacji">od klienta</span> }</td>
                                <td>@MeasCell(m.WeightKg, prev?.WeightKg, "kg", false)</td>
                                <td>@MeasCell(m.BodyFatPercent, prev?.BodyFatPercent, "%", false)</td>
                                <td>@MeasCell(m.WaistCm, prev?.WaistCm, "cm", false)</td>
                                <td>@MeasCell(m.ChestCm, prev?.ChestCm, "cm", true)</td>
                                <td>@MeasCell(m.HipsCm, prev?.HipsCm, "cm", true)</td>
                                <td>@MeasCell(m.ThighCm, prev?.ThighCm, "cm", true)</td>
                                <td>@MeasCell(m.ArmCm, prev?.ArmCm, "cm", true)</td>
                                <td>
                                    <button class="btn btn-link btn-sm text-danger p-0"
                                            title="Usuń" @onclick="() => DeleteMeasurement(m.Id)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(m.Notes))
                            {
                                <tr class="table-light">
                                    <td colspan="9" class="py-1 px-3 text-muted small fst-italic">
                                        <i class="bi bi-chat-left-text me-1"></i>@m.Notes
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }

    @if (_tab == "account")
    {
        <div class="cp-grid">
            <div class="cp-col">
                <section class="cp-card">
                    <div class="cp-card-head">
                        <h6 class="cp-card-title mb-0"><i class="bi bi-person-vcard"></i>Dane klienta</h6>
                        @if (!editMode)
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="StartEdit"><i class="bi bi-pencil me-1"></i>Edytuj</button>
                        }
                    </div>
                    @if (!editMode)
                    {
                        <dl class="cp-dl">
                            <dt>E-mail</dt><dd>@client.Email</dd>
                            <dt>Telefon</dt><dd>@(string.IsNullOrEmpty(client.Phone) ? "—" : client.Phone)</dd>
                            <dt>Data urodzenia</dt><dd>@(client.DateOfBirth?.ToString("dd.MM.yyyy") ?? "—")</dd>
                            <dt>Cel treningowy</dt><dd>@(string.IsNullOrWhiteSpace(client.TrainingGoal) ? "—" : client.TrainingGoal)</dd>
                            <dt>Klient od</dt><dd>@client.CreatedAt.ToString("dd.MM.yyyy")</dd>
                        </dl>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(editError))
                        {
                            <div class="alert alert-danger py-2 small">@editError</div>
                        }
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label form-label-sm">Imię</label>
                                <input class="form-control form-control-sm" @bind="editDto.FirstName" />
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">Nazwisko</label>
                                <input class="form-control form-control-sm" @bind="editDto.LastName" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label form-label-sm">Telefon</label>
                                <input class="form-control form-control-sm" @bind="editDto.Phone" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label form-label-sm">Data urodzenia</label>
                                <input type="date" class="form-control form-control-sm"
                                       value="@(editDto.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")"
                                       @onchange="e => editDto.DateOfBirth = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateOnly.Parse(e.Value!.ToString()!)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label form-label-sm">Cel treningowy</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="editDto.TrainingGoal"></textarea>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary btn-sm flex-grow-1" @onclick="SaveEdit" disabled="@isBusy">
                                @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Zapisz
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Anuluj</button>
                        </div>
                    }
                </section>

                <section class="cp-card">
                    <h6 class="cp-card-title"><i class="bi bi-sliders"></i>Rezerwacje i płatności</h6>
                    <div class="cp-switch">
                        <span><b>Samodzielna rezerwacja</b><small>Klient sam umawia wolne terminy w aplikacji.</small></span>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" aria-label="Samodzielna rezerwacja"
                                   checked="@client.AllowSelfBooking" @onchange="ToggleSelfBooking" />
                        </div>
                    </div>
                    <div class="cp-switch">
                        <span><b>Zaufany klient</b><small>„Zapłacę u trenera” bez Twojej akceptacji i bez limitu nieopłaconych treningów.</small></span>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" aria-label="Zaufany klient"
                                   checked="@client.TrustedForDeferredPayment" @onchange="ToggleTrusted" />
                        </div>
                    </div>
                </section>

                <section class="cp-card">
                    <h6 class="cp-card-title"><i class="bi bi-file-earmark-pdf"></i>Raport miesięczny</h6>
                    @if (Entitlements.IsAllowed("ClientReports"))
                    {
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <select class="form-select form-select-sm" style="max-width:200px" @bind="_reportMonth" aria-label="Miesiąc raportu">
                                @for (var m = 0; m < 12; m++)
                                {
                                    var d = StudioClock.Now.AddMonths(-m);
                                    var v = $"{d:yyyy-MM}";
                                    <option value="@v">@d.ToString("MMMM yyyy", _plCulture)</option>
                                }
                            </select>
                            <a class="btn btn-outline-primary btn-sm" href="@ReportUrl()" target="_blank" rel="noopener">
                                <i class="bi bi-download me-1"></i>Pobierz PDF
                            </a>
                        </div>
                        <div class="form-text">Podsumowanie treningów, pomiarów i postępów — do wysłania klientowi.</div>
                    }
                    else
                    {
                        <div class="small text-muted">Podsumowanie postępów w PDF dla klienta <PlanBadge Flag="ClientReports" RequiredPlan="Business" /></div>
                    }
                </section>
                <section class="cp-card">
                    <div class="cp-card-head">
                        <h6 class="cp-card-title mb-0"><i class="bi bi-file-earmark-check"></i>Dokumenty i zgody</h6>
                        <a href="/admin/documents" class="btn btn-link btn-sm p-0">Zarządzaj</a>
                    </div>
                    @if (_documents.Count == 0)
                    {
                        <div class="small text-muted">Nie masz jeszcze dokumentów do akceptacji. Dodaj regulamin albo zgodę na wizerunek — klient zaakceptuje je w aplikacji.</div>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                            @foreach (var d in _documents)
                            {
                                <li class="d-flex align-items-start gap-2">
                                    @if (d.Pending)
                                    {
                                        <i class="bi bi-hourglass-split text-warning"></i>
                                    }
                                    else if (d.Accepted == true)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-secondary"></i>
                                    }
                                    <div>
                                        <div class="fw-semibold">@d.Title</div>
                                        <div class="text-muted">
                                            @if (d.Pending)
                                            {
                                                @(d.DecidedVersion is null ? "Czeka na decyzję klienta" : "Nowa wersja — czeka na decyzję")
                                            }
                                            else
                                            {
                                                @((d.Accepted == true ? (d.Kind == PTScheduler.Domain.Constants.DocumentKinds.Required ? "Zaakceptowano " : "Zgoda udzielona ") : "Brak zgody · ") + Clock.ToWallClock(d.DecidedAtUtc!.Value).ToString("dd.MM.yyyy HH:mm"))
                                            }
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="cp-col">
                <section class="cp-card">
                    <h6 class="cp-card-title"><i class="bi bi-person-badge"></i>Konto w aplikacji</h6>
                    @if (_account is not null)
                    {
                        <div class="small mb-3 d-flex flex-column gap-1">
                            @if (_account.LastLoginUtc is { } lastLogin)
                            {
                                <span><i class="bi bi-check-circle-fill text-success me-1"></i>Ostatnie logowanie: @Clock.ToWallClock(lastLogin).ToString("dd.MM.yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span><i class="bi bi-hourglass-split text-warning me-1"></i>Klient nie korzystał jeszcze z aplikacji</span>
                            }
                            @if (_account.PasskeyCount > 0)
                            {
                                <span><i class="bi bi-fingerprint text-success me-1"></i>Logowanie odciskiem palca / Face ID włączone</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_inviteMsg))
                    {
                        <div class="alert @(_inviteError ? "alert-warning" : "alert-success") py-2 small mb-2">@_inviteMsg</div>
                    }

                    <button class="btn btn-primary btn-sm w-100" @onclick="() => SendInvite(true)" disabled="@_inviteBusy">
                        @if (_inviteBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-envelope-paper me-1"></i>@(_account?.LastLoginUtc is null ? "Wyślij zaproszenie e-mailem" : "Wyślij link do ustawienia hasła")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm w-100 mt-2" @onclick="() => SendInvite(false)" disabled="@_inviteBusy">
                        <i class="bi bi-link-45deg me-1"></i>Przygotuj link (SMS, WhatsApp…)
                    </button>

                    @if (!string.IsNullOrEmpty(_inviteLink))
                    {
                        <div class="input-group input-group-sm mt-2">
                            <input class="form-control" value="@_inviteLink" readonly aria-label="Link zaproszenia" />
                            <button class="btn btn-outline-secondary" @onclick="CopyInviteLink" title="Kopiuj">
                                <i class="bi @(_inviteCopied ? "bi-clipboard-check" : "bi-clipboard")"></i>
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="ShareInviteLink" title="Udostępnij">
                                <i class="bi bi-share"></i>
                            </button>
                        </div>
                        <div class="form-text">Link działa jednorazowo przez @ClientInvite.ValidDays dni.</div>
                    }

                    <details class="mt-3">
                        <summary class="small text-muted">Ustaw hasło ręcznie</summary>
                        <div class="mt-2">
                            @if (!string.IsNullOrEmpty(pwMsg))
                            {
                                <div class="alert @(pwError ? "alert-danger" : "alert-success") py-2 small mb-2">@pwMsg</div>
                            }
                            <div class="mb-2">
                                <input class="form-control form-control-sm" type="password"
                                       @bind="newPw" placeholder="Nowe hasło (min. 8 znaków, w tym cyfra)" autocomplete="new-password" />
                            </div>
                            <button class="btn btn-warning btn-sm w-100" @onclick="ResetClientPassword" disabled="@isBusy">
                                @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-arrow-clockwise me-1"></i>Ustaw nowe hasło
                            </button>
                        </div>
                    </details>
                </section>
            </div>
        </div>
    }
}

<!-- Add package modal -->
@if (addPackageOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-box-seam me-2 text-primary"></i>Nowy pakiet — @client!.FullName</h5>
                    <button type="button" class="btn-close" @onclick="() => addPackageOpen = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(pkgError))
                    {
                        <div class="alert alert-danger py-2 small">@pkgError</div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="pair-toggle">
                                <button type="button" class="@(_pkgForPair ? "" : "active")" @onclick="() => { _pkgForPair = false; newPkg.PartnerClientId = null; UpdatePkgName(); }"><i class="bi bi-person-fill"></i>Tylko @client!.FirstName</button>
                                <button type="button" class="@(_pkgForPair ? "active" : "")" @onclick="SetPkgForPair"><i class="bi bi-people-fill"></i>Dla pary</button>
                            </div>
                            @if (_pkgForPair)
                            {
                                <select class="form-select mt-2" @bind="_pkgPartnerId" @bind:after="UpdatePkgName">
                                    <option value="0">— z kim trenuje? —</option>
                                    @foreach (var c in PartnerChoices)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                                <div class="form-text">Pakiet należy do obojga — oboje widzą go od razu. Za wspólny trening schodzi 1.</div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Typ sesji <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="newPkg.SessionTypeId" @bind:after="UpdatePkgName">
                                <option value="0">— wybierz —</option>
                                @foreach (var t in sessionTypes)
                                {
                                    <option value="@t.Id">@t.Name (@t.DurationMinutes min)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Liczba sesji <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" min="1" @bind="newPkg.TotalSessions" @bind:after="UpdatePkgName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Cena / sesję (zł)</label>
                            <input type="number" class="form-control" min="0" step="0.01" @bind="newPkg.PricePerSession" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nazwa pakietu</label>
                            <input class="form-control" @bind="newPkg.Name" placeholder="auto" />
                            @if (newPkg.PricePerSession > 0 && newPkg.TotalSessions > 0)
                            {
                                <div class="form-text">Łącznie: <strong>@((newPkg.PricePerSession * newPkg.TotalSessions).ToString("N2")) zł</strong></div>
                            }
