        PackageStatus.Active    => "Aktywny",
        PackageStatus.Depleted  => "Wyczerpany",
        PackageStatus.Expired   => "Przepadł",
        PackageStatus.Cancelled => "Anulowany",
        _ => s.ToString()
    };

    private void OpenBooking()
    {
        bookingDto = new CreateSessionDto
        {
            ClientId = Id,
            TrainerUserId = currentUserId
        };
        var now = StudioClock.Now.AddHours(1);
        bookingDate = now.ToString("yyyy-MM-dd");
        bookingTime = new TimeOnly(now.Hour, 0);
        bookingError = string.Empty;
        bookingOverlap = false;
        _bookingWithPartner = false;
        _bookingPartnerId = 0;
        bookingOpen = true;
    }

    private void CloseBooking() => bookingOpen = false;

    private async Task SubmitBooking(bool allowOverlap = false)
    {
        if (bookingDto.SessionTypeId == 0) { bookingError = "Wybierz typ sesji."; return; }
        if (_bookingWithPartner && _bookingPartnerId == 0) { bookingError = "Wybierz, z kim trenuje."; return; }
        if (!DateTime.TryParse($"{bookingDate} {bookingTime:HH:mm}", out var startTime))
        { bookingError = "Nieprawidłowa data lub godzina."; return; }

        bookingDto.StartTime = startTime;
        isBusy = true;
        bookingError = string.Empty;
        try
        {
            var created = _bookingWithPartner
                ? await SessionService.CreatePairSessionAsync(bookingDto, _bookingPartnerId, allowOverlap: allowOverlap)
                : await SessionService.CreateSessionAsync(bookingDto, allowOverlap: allowOverlap);
            await AuditLogService.LogAsync(currentUserId, currentUserEmail, currentUserRole, "SessionBooked", "Session",
                created.Id.ToString(), $"Klient: {created.DisplayName}, termin: {bookingDto.StartTime:dd.MM.yyyy HH:mm}{(allowOverlap ? " (nałożono)" : "")}");
            bookingOverlap = false;
            bookingOpen = false;
            sessions = await SessionService.GetClientSessionsAsync(Id, 200);
            client = await ClientService.GetClientAsync(Id);
            RefreshPanel();
        }
        catch (SlotConflictException ex)
        {
            bookingOverlap = true;
            bookingError = ex.Message;
        }
        catch (Exception ex)
        {
            bookingOverlap = false;
            bookingError = ex.Message;
        }
        finally { isBusy = false; }
    }

    private void StartEdit()
    {
        editDto = new UpdateClientDto
        {
            FirstName = client!.FirstName,
            LastName = client.LastName,
            Phone = client.Phone,
            TrainingGoal = client.TrainingGoal,
            DateOfBirth = client.DateOfBirth
        };
        editError = string.Empty;
        editMode = true;
    }

    private void CancelEdit() => editMode = false;

    private async Task SaveEdit()
    {
        isBusy = true;
        editError = string.Empty;
        try
        {
            await ClientService.UpdateClientAsync(Id, editDto);
            client = await ClientService.GetClientAsync(Id);
            await AuditLogService.LogAsync(currentUserId, currentUserEmail, currentUserRole, "ClientProfileUpdated", "Client",
                Id.ToString(), $"Klient: {client?.FullName}");
            editMode = false;
        }
        catch (Exception ex)
        {
            editError = ex.Message;
        }
        finally { isBusy = false; }
    }

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(newNote)) return;
        isBusy = true;
        try
        {
            await ClientService.AddNoteAsync(Id, currentUserId, newNote.Trim());
            newNote = string.Empty;
            notes = await ClientService.GetNotesAsync(Id);
        }
        finally { isBusy = false; }
    }

    private async Task DeleteNote(int noteId)
    {
        await ClientService.DeleteNoteAsync(noteId);
        notes = await ClientService.GetNotesAsync(Id);
    }

    private async Task ResetClientPassword()
    {
        if (string.IsNullOrWhiteSpace(newPw)) { pwMsg = "Podaj nowe hasło."; pwError = true; return; }
        if (client is null) return;
        isBusy = true; pwMsg = string.Empty;
        try
        {
            var (success, error) = await UserManagementService.ResetPasswordAsync(client.ApplicationUserId, newPw);
            if (success)
            {
                await AuditLogService.LogAsync(currentUserId, currentUserEmail, currentUserRole, "ClientPasswordReset", "Client",
                    Id.ToString(), $"Klient: {client?.FullName}");
                pwMsg = "Hasło klienta zostało zmienione."; pwError = false; newPw = string.Empty;
            }
            else { pwMsg = error ?? "Błąd zmiany hasła."; pwError = true; }
        }
        catch (Exception ex) { pwMsg = ex.Message; pwError = true; }
        finally { isBusy = false; }
    }

