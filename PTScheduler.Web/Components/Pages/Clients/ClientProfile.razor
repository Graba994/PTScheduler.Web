    /// <summary>
    /// Invoked from JS for ArrowLeft / ArrowRight / Escape (when user is NOT typing
    /// in an input). Esc closes any open modal first; arrows otherwise navigate
    /// between clients in the order shown in <c>/clients</c>.
    /// </summary>
    [JSInvokable]
    public Task HandleKeyAsync(string key)
    {
        // Escape: close modals or cancel edit/booking flows
        if (key == "Escape")
        {
            var anyClosed = false;
            if (addPackageOpen)       { addPackageOpen = false;       anyClosed = true; }
            if (editPackageOpen)      { editPackageOpen = false;      anyClosed = true; }
            if (bookingOpen)          { bookingOpen = false;          anyClosed = true; }
            if (addMeasurementOpen)   { addMeasurementOpen = false;   anyClosed = true; }
            if (editMode)             { editMode = false;             anyClosed = true; }
            if (anyClosed) StateHasChanged();
            return Task.CompletedTask;
        }

        // Don't navigate while a modal is open — would feel jarring.
        if (addPackageOpen || editPackageOpen || bookingOpen || addMeasurementOpen) return Task.CompletedTask;

        switch (key)
        {
            case "ArrowLeft":
                if (_prevId.HasValue) GoPrev();
                break;
            case "ArrowRight":
                if (_nextId.HasValue) GoNext();
                break;
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("PTKeyboard.unlisten"); }
        catch { /* circuit may already be torn down */ }
        _kbRef?.Dispose();
    }

