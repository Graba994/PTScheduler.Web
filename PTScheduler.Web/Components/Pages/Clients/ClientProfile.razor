@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "invite")] public string? InviteQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    // ── Panel klienta: „Co się dzieje”, oś zdarzeń i treningi z planu ──

    private sealed record AttentionItem(string Level, string Icon, string Text, string? Tab = null, string? Href = null);
    private sealed record FeedItem(DateTime When, string Icon, string Tone, string Title, string? Sub, string? Tab);
    private sealed record WeekBar(DateOnly Start, int Count);

    private const int JournalShown = 8;
    private bool _plansOn;
    private int? _age;
    private int _unreadChat;
    private string? _lastClientMessage;
    private DateTime? _lastClientMessageAt;
    private string? _activePackageName;
    private int _unpaidOffPackage;
    private int _pastShown = 20;
    private List<AttentionItem> _attention = [];
    private List<FeedItem> _feed = [];
    private const int FeedStart = 5;
    private int _feedShown = FeedStart;

    private List<WorkoutJournalDayDto> _journal = [];
    private List<TrainingPlanListItemDto> _plans = [];
    private List<PersonalRecordDto> _records = [];
    private Dictionary<DateOnly, PTScheduler.Application.Surveys.SurveyResponseDto> _postWorkout = [];
    private PTScheduler.Application.Surveys.SurveyResponseDto? _health;
    private List<PTScheduler.Application.Surveys.SurveyInsight> _insights = [];
    private int _progressionCount;
    private DateOnly? _lastWorkout;
    private int? _daysSinceWorkout;
    private int _workouts7;
    private int _workouts30;
    private decimal _volume30;
    private List<WeekBar> _weeks = [];
    private int _weeksMax = 1;

    private SessionDto? _nextSession => Upcoming.FirstOrDefault();

    private List<SessionDto> Upcoming => sessions?
        .Where(s => s.Status == SessionStatus.Scheduled && s.EndTime >= StudioClock.Now)
        .OrderBy(s => s.StartTime).ToList() ?? [];

    private List<SessionDto> Past => sessions?
        .Where(s => !(s.Status == SessionStatus.Scheduled && s.EndTime >= StudioClock.Now))
        .OrderByDescending(s => s.StartTime).ToList() ?? [];

    private IEnumerable<(string Key, string Icon, string Label, int Count)> Tabs()
    {
        yield return ("overview", "bi-grid-1x2", "Przegląd", _attention.Count(a => a.Level != "info"));
        if (_plansOn) yield return ("activity", "pt-ico-dumbbell", "Aktywność", 0);
        yield return ("sessions", "bi-calendar-week", "Wizyty", Upcoming.Count);
        yield return ("packages", "bi-box-seam", "Pakiety", 0);
        yield return ("measurements", "bi-rulers", "Pomiary", 0);
        if (Entitlements.IsAllowed("BodyMeasurements")) yield return ("photos", "bi-camera", "Zdjęcia", 0);
        yield return ("surveys", "bi-clipboard2-pulse", "Ankiety", 0);
        yield return ("account", "bi-person-gear", "Konto", 0);
    }

    /// <summary>Treningi z planu, ankiety, wiadomości — wszystko, co składa się na obraz klienta.</summary>
    private async Task LoadInsightsAsync()
    {
        _plansOn = Entitlements.IsAllowed("TrainingPlansEnabled");
        _journal = []; _plans = []; _records = []; _postWorkout = []; _health = null; _insights = [];
        _progressionCount = 0; _unreadChat = 0; _lastClientMessage = null; _lastClientMessageAt = null;

        // Każde źródło osobno: brak jednego (np. wyłączony moduł) nie psuje całego panelu.
        if (_plansOn)
        {
            try { _journal = await WorkoutLog.GetJournalAsync(Id, 90); } catch { }
            try { _plans = await PlanService.GetClientPlansAsync(Id); } catch { }
            try { _records = await WorkoutLog.GetPersonalRecordsAsync(Id, 6); } catch { }
            try { _progressionCount = (await Progression.GetSuggestionsAsync(currentUserId, _isAdmin, Id)).Count; } catch { }
        }
        try { _postWorkout = await Surveys.GetPostWorkoutByDateAsync(Id, 120); } catch { }
        try { _health = await Surveys.GetLatestAsync(Id, SurveyKind.HealthIntake); } catch { }
        try
        {
            var stats = await Surveys.GetPostWorkoutStatsAsync(Id);
            _insights = stats.Insights.OrderByDescending(i => i.Level).Take(4).ToList();
        }
        catch { }
        try
        {
            var conv = (await Chat.GetConversationsAsync(_isAdmin ? null : currentUserId)).FirstOrDefault(c => c.ClientId == Id);
            if (conv is not null)
            {
                _unreadChat = conv.Unread;
                if (!conv.LastFromStaff) { _lastClientMessage = conv.LastMessage; _lastClientMessageAt = conv.LastMessageAt; }
            }
        }
        catch { }
    }

    private void ComputeActivity()
    {
        var today = DateOnly.FromDateTime(StudioClock.Today);
        _lastWorkout = _journal.Count > 0 ? _journal.Max(d => d.Date) : null;
        _daysSinceWorkout = _lastWorkout is { } lw ? today.DayNumber - lw.DayNumber : null;
        _workouts7 = _journal.Count(d => today.DayNumber - d.Date.DayNumber < 7);
        _workouts30 = _journal.Count(d => today.DayNumber - d.Date.DayNumber < 30);
        _volume30 = _journal.Where(d => today.DayNumber - d.Date.DayNumber < 30).Sum(d => d.TotalVolume);

        var monday = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        _weeks = Enumerable.Range(0, 12).Reverse()
            .Select(i => monday.AddDays(-7 * i))
            .Select(start => new WeekBar(start, _journal.Count(d => d.Date >= start && d.Date < start.AddDays(7))))
            .ToList();
        _weeksMax = Math.Max(1, _weeks.Max(w => w.Count));
    }

    private void ComputeAttention()
    {
        var list = new List<AttentionItem>();
        var now = StudioClock.Now;

        if (_unreadChat > 0)
            list.Add(new("warn", "bi-chat-dots-fill", $"{_unreadChat} {Plural(_unreadChat, "nieprzeczytana wiadomość", "nieprzeczytane wiadomości", "nieprzeczytanych wiadomości")}", Href: $"/chat?client={Id}"));

        var awaiting = sessions?.Count(s => s.AwaitingApproval && s.Status == SessionStatus.Scheduled) ?? 0;
        if (awaiting > 0)
            list.Add(new("warn", "bi-hourglass-split", $"{awaiting} {Plural(awaiting, "termin czeka", "terminy czekają", "terminów czeka")} na Twoją akceptację", Href: "/sessions"));

        if (_health is { ReviewedAtUtc: null })
            list.Add(new(_health.FlagCount > 0 ? "danger" : "info", "bi-heart-pulse", _health.FlagCount > 0
                ? $"Ankieta zdrowotna: {_health.FlagCount} {Plural(_health.FlagCount, "odpowiedź wymaga", "odpowiedzi wymagają", "odpowiedzi wymaga")} uwagi"
                : "Nowa ankieta zdrowotna do przejrzenia", "surveys"));

        if (_health is null)
            list.Add(new("info", "bi-clipboard2-pulse", "Brak ankiety zdrowotnej — wypełnijcie ją razem na najbliższym spotkaniu", Href: $"/clients/{Id}/ankieta/zdrowie"));

        var flagged = _postWorkout.Values.Count(r => r.FlagCount > 0 && r.ReviewedAtUtc is null);
        if (flagged > 0)
            list.Add(new("danger", "bi-exclamation-octagon", $"{flagged} {Plural(flagged, "ankieta", "ankiety", "ankiet")} po treningu z sygnałem ostrzegawczym (ból, złe samopoczucie)", "surveys"));

        foreach (var ins in _insights.Where(i => i.Level is PTScheduler.Application.Surveys.InsightLevel.Danger or PTScheduler.Application.Surveys.InsightLevel.Warning).Take(1))
            list.Add(new(ins.Level == PTScheduler.Application.Surveys.InsightLevel.Danger ? "danger" : "warn", "bi-speedometer2", ins.Text, "activity"));

        if (_unpaidOffPackage > 0)
            list.Add(new("warn", "bi-cash-coin", $"{_unpaidOffPackage} {Plural(_unpaidOffPackage, "nieopłacony trening", "nieopłacone treningi", "nieopłaconych treningów")} poza pakietem", "sessions"));
        if (_unpaidBalance > 0)
            list.Add(new("warn", "bi-wallet2", $"Nieopłacony pakiet — {_unpaidBalance:N0} zł", "packages"));

        var active = packages?.Where(p => p.Status == PackageStatus.Active).ToList() ?? [];
        if (active.Count > 0 && _activeCredits <= 2)
            list.Add(new("warn", "bi-box-seam", _activeCredits == 0
                ? "Pakiet wykorzystany — zaproponuj kolejny"
                : $"{(_activeCredits == 1 ? "Został 1 trening" : $"Zostały {_activeCredits} treningi")} w pakiecie — dobry moment, żeby zaproponować kolejny", "packages"));
        else if (active.Count == 0 && Upcoming.Count > 0)
            list.Add(new("info", "bi-box-seam", "Klient ma zaplanowane wizyty, ale nie ma aktywnego pakietu", "packages"));
        foreach (var p in active.Where(p => p.ExpiresAt is { } e && e >= DateTime.UtcNow && e <= DateTime.UtcNow.AddDays(14) && p.RemainingCredits > 0))
            list.Add(new("info", "bi-calendar-x", $"„{p.Name}” wygasa {p.ExpiresAt:dd.MM} — zostało {p.RemainingCredits} {Plural(p.RemainingCredits, "trening", "treningi", "treningów")}", "packages"));

        if (_plansOn)
        {
            if (_plans.Count > 0 && _daysSinceWorkout is > 7)
                list.Add(new("warn", "pt-ico-dumbbell", $"Nie ćwiczy z planu od {_daysSinceWorkout} dni — może warto zapytać, jak idzie?", "activity"));
            else if (_plans.Count > 0 && _lastWorkout is null)
                list.Add(new("info", "pt-ico-dumbbell", "Plan przypisany, ale klient nie zapisał jeszcze żadnego treningu", "activity"));
            else if (_plans.Count == 0)
                list.Add(new("info", "bi-clipboard-plus", "Brak planu treningowego — przypisz plan do ćwiczenia między wizytami", "activity"));
            if (_progressionCount > 0)
                list.Add(new("info", "bi-graph-up-arrow", $"{_progressionCount} {Plural(_progressionCount, "propozycja", "propozycje", "propozycji")} zwiększenia ciężaru na podstawie RPE", "activity"));
        }

        if (Upcoming.Count == 0 && client?.Status == ClientStatus.Active)
        {
            var last = Past.FirstOrDefault(s => s.Status == SessionStatus.Completed);
            if (last is not null && (now - last.StartTime).TotalDays > 14)
                list.Add(new("info", "bi-calendar-plus", $"Brak zaplanowanej wizyty — ostatnia była {Ago(last.StartTime)}", "sessions"));
        }

        if (_lastMeasDate is { } lm && DateOnly.FromDateTime(StudioClock.Today).DayNumber - lm.DayNumber > 45)
            list.Add(new("info", "bi-rulers", $"Ostatni pomiar {lm:dd.MM.yyyy} — czas na nowy?", "measurements"));

        if (_account is { LastLoginUtc: null })
            list.Add(new("info", "bi-phone", "Klient nie zalogował się jeszcze do aplikacji — wyślij zaproszenie", "account"));

        var order = new Dictionary<string, int> { ["danger"] = 0, ["warn"] = 1, ["info"] = 2 };
        _attention = list.OrderBy(a => order[a.Level]).ToList();
    }

    private void ComputeFeed()
    {
        var feed = new List<FeedItem>();
        foreach (var s in Past.Take(40))
        {
            feed.Add(s.Status switch
            {
                SessionStatus.Completed => new(s.StartTime, "bi-check2-circle", "ok", s.SessionTypeName, $"odbyta wizyta · {s.StartTime:dd.MM HH:mm} · {s.DurationMinutes} min", "sessions"),
                SessionStatus.Cancelled => new(s.StartTime, "bi-x-circle", "danger", $"Odwołana: {s.SessionTypeName}", s.IsLateCancellation ? "późne odwołanie" + (string.IsNullOrWhiteSpace(s.CancellationReason) ? "" : $" · {s.CancellationReason}") : s.CancellationReason, "sessions"),
                SessionStatus.NoShow => new(s.StartTime, "bi-person-x", "warn", "Nieobecność na wizycie", $"{s.SessionTypeName} · {s.StartTime:dd.MM HH:mm}", "sessions"),
                _ => new(s.StartTime, "bi-calendar", "muted", s.SessionTypeName, null, "sessions")
            });
        }
        foreach (var d in _journal.Take(40))
        {
            var sub = $"{d.Exercises.Count} {Plural(d.Exercises.Count, "ćwiczenie", "ćwiczenia", "ćwiczeń")} · {d.SetCount} serii"
                      + (d.TotalVolume > 0 ? $" · {d.TotalVolume:N0} kg" : "");
            if (_postWorkout.TryGetValue(d.Date, out var survey) && survey.FlagCount > 0) sub += " · ankieta: sygnał ostrzegawczy";
            feed.Add(new(d.Date.ToDateTime(new TimeOnly(12, 0)), "pt-ico-dumbbell", "violet", "Trening z planu", sub, "activity"));
        }
        foreach (var m in measurements?.Take(5) ?? [])
            feed.Add(new(m.MeasurementDate.ToDateTime(new TimeOnly(9, 0)), "bi-rulers", "info", m.AddedByClient ? "Klient wpisał pomiar" : "Nowy pomiar",
                m.WeightKg is { } w ? $"waga {w:0.#} kg" + (m.BodyFatPercent is { } f ? $" · tłuszcz {f:0.#}%" : "") : null, "measurements"));
        foreach (var p in packages?.Take(5) ?? [])
            feed.Add(new(Clock.ToWallClock(p.PurchasedAt), "bi-bag-check", "ok", p.Name, p.IsPaid ? "nowy pakiet · opłacony" : "nowy pakiet · czeka na płatność", "packages"));
        if (_lastClientMessageAt is { } lm && !string.IsNullOrWhiteSpace(_lastClientMessage))
            feed.Add(new(Clock.ToWallClock(lm), "bi-chat-dots", "info", "Wiadomość od klienta", Truncate(_lastClientMessage, 90), null));

        _feed = feed.Where(f => f.When <= StudioClock.Now.AddHours(1)).OrderByDescending(f => f.When).Take(40).ToList();
    }

    private void RefreshPanel()
    {
        ComputeStats();
        ComputeActivity();
        ComputeAttention();
        ComputeFeed();
    }

    private RenderFragment SessionRow(SessionDto s) => __builder =>
    {
        <div class="cp-srow">
            <div class="cp-sdate @(s.Status == SessionStatus.Scheduled ? "" : "past")">
                <b>@s.StartTime.Day</b><small>@s.StartTime.ToString("MMM", _plCulture)</small>
            </div>
            <div class="cp-sbody">
                <div class="cp-stitle">
                    @s.SessionTypeName
                    @if (s.IsPair) { <span class="pair-chip ms-1"><i class="bi bi-people-fill"></i>z: @s.PartnerName</span> }
                </div>
                <small>@DayLabel(s.StartTime), @s.StartTime.ToString("HH:mm") · @s.DurationMinutes min@(string.IsNullOrWhiteSpace(s.Notes) ? "" : " · " + s.Notes)</small>
            </div>
            <div class="cp-sstatus">
                @if (s.AwaitingApproval) { <span class="badge bg-warning-subtle text-warning">Do akceptacji</span> }
                else { <span class="badge @StatusBadge(s.Status)">@StatusLabel(s.Status)</span> }
                @if (s.OffPackagePayment is not null && s.PaidAt is null && s.Status != SessionStatus.Cancelled)
                {
                    <span class="badge bg-danger-subtle text-danger">Nieopłacona</span>
                }
            </div>
        </div>
    };

    private static string DayLabel(DateTime dt)
    {
        var diff = (dt.Date - StudioClock.Today.Date).Days;
        return diff switch
        {
            0 => "dziś",
            1 => "jutro",
            -1 => "wczoraj",
            > 1 and < 7 => dt.ToString("dddd", _plCulture),
            _ => dt.ToString("d MMM", _plCulture)
        };
    }

    private static string Ago(DateOnly d) => Ago(d.ToDateTime(new TimeOnly(12, 0)));

    private static string Ago(DateTime dt)
    {
        var days = (StudioClock.Today.Date - dt.Date).Days;
        return days switch
        {
            <= 0 => "dziś",
            1 => "wczoraj",
            < 7 => $"{days} dni temu",
            < 30 => $"{days / 7} {Plural(days / 7, "tydzień", "tygodnie", "tygodni")} temu",
            _ => dt.ToString("dd.MM.yyyy")
        };
    }

    private static string Plural(int n, string one, string few, string many)
    {
        if (n == 1) return one;
        var d = n % 10; var t = n % 100;
        return d is >= 2 and <= 4 && t is < 12 or > 14 ? few : many;
    }

