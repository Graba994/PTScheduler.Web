        _lastMeasDate   = measurements?.OrderByDescending(m => m.MeasurementDate).FirstOrDefault()?.MeasurementDate;
        _activePackageName = packages?.Where(p => p.Status == PackageStatus.Active).OrderBy(p => p.ExpiresAt ?? DateTime.MaxValue).FirstOrDefault()?.Name;
        _unpaidOffPackage = sessions?.Count(s => s.OffPackagePayment is not null && s.PaidAt is null
                                                && s.Status is SessionStatus.Completed or SessionStatus.Scheduled && !s.AwaitingApproval) ?? 0;
    }

