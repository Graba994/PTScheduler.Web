    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            currentUserEmail = auth.User.Identity?.Name ?? currentUserId;
            _isAdmin = auth.User.IsInRole(PTScheduler.Domain.Constants.Roles.Admin);
            currentUserRole = _isAdmin ? PTScheduler.Domain.Constants.Roles.Admin
                            : auth.User.IsInRole(PTScheduler.Domain.Constants.Roles.Trainer) ? PTScheduler.Domain.Constants.Roles.Trainer
                            : PTScheduler.Domain.Constants.Roles.Subordinate;

            var trainerUserId = _isAdmin ? null : currentUserId;
            var navList = await ClientService.GetClientsAsync(trainerUserId);
            _clientNav = navList.Select(c => (c.Id, c.FullName)).ToList();
            _clientIds = _clientNav.Select(n => n.Id).ToList();

            _initialized = true;
        }

        if (_lastLoadedId == Id) return;

        // Reset state for new client
        notFound = false;
        client = null;
        notes = null;
        sessions = null;
        packages = null;
        measurements = null;
        editMode = false;
        addPackageOpen = false;
        editPackageOpen = false;
        bookingOpen = false;
        addMeasurementOpen = false;
        pwMsg = string.Empty;
        editError = string.Empty;
        _account = null;
        _inviteLink = null;
        _inviteMsg = string.Empty;
        _inviteCopied = false;

        UpdateNavIds();
        _lastLoadedId = Id;

        client = await ClientService.GetClientAsync(Id);
        if (client is null) { notFound = true; return; }

        if (!_isAdmin && client.TrainerUserId != currentUserId) { notFound = true; client = null; return; }

        await LoadNotes();
        await LoadSessions();
        if (sessionTypes.Count == 0) await LoadSessionTypes();
        await LoadPackages();
        await LoadMeasurements();
        await LoadAccount();
        await LoadInsightsAsync();
        _age = client.DateOfBirth is { } dob ? AgeOn(dob) : null;
        _tab = "overview";
        _pastShown = 20;
        _feedShown = FeedStart;
        RefreshPanel();

        // Wynik zaproszenia wysłanego przy zakładaniu klienta (ClientNew → ?invite=…), tylko raz.
        if (InviteQuery is "sent")
        {
            _inviteMsg = $"Klient dodany. Zaproszenie wysłane na {client.Email}.";
            _inviteError = false;
        }
        else if (InviteQuery is "failed")
        {
            _inviteMsg = "Klient dodany, ale e-mail z zaproszeniem nie wyszedł. Użyj „Przygotuj link” i wyślij go klientowi.";
            _inviteError = true;
        }
        InviteQuery = null;

        // Link z powiadomienia / „Wymaga uwagi” (np. ?tab=surveys).
        if (TabQuery is "overview" or "activity" or "account" or "surveys" or "sessions" or "measurements" or "packages" or "photos")
        {
            SelectTab(TabQuery);
            TabQuery = null;
        }
    }

