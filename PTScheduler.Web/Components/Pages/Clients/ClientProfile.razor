    private async Task ShareInviteLink()
    {
        if (string.IsNullOrEmpty(_inviteLink) || client is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.share", new
            {
                title = "Zaproszenie do aplikacji",
                text = $"Cześć {client.FirstName}! Tu ustawisz hasło do aplikacji treningowej:",
