@page "/clients"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Trainer,Subordinate")]
@inject IClientService ClientService
@inject EntitlementService Entitlements
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@using PTScheduler.Domain.Enums
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Klienci" />

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Klienci</h4>
        @if (Entitlements.Current.MaxClients != int.MaxValue && clients is not null)
        {
            <span class="badge @(clients.Count >= Entitlements.Current.MaxClients ? "bg-warning text-dark" : "bg-primary-subtle text-primary-emphasis")">
                @clients.Count / @Entitlements.Current.MaxClients w planie @Entitlements.Current.Name
            </span>
        }
    </div>
    @if (Entitlements.Current.MaxClients != int.MaxValue && clients is not null && clients.Count >= Entitlements.Current.MaxClients)
    {
        <a href="/upgrade" class="btn btn-warning btn-sm flex-shrink-0">
            <i class="bi bi-arrow-up-circle me-1"></i>Zwiększ limit
        </a>
    }
    else
    {
        <div class="d-flex gap-2 flex-shrink-0">
            <button class="btn btn-outline-primary btn-sm" @onclick="() => _showImport = true">
                <i class="bi bi-upload me-1"></i>Import CSV
            </button>
            <a href="/clients/new" class="btn btn-primary btn-sm">
                <i class="bi bi-person-plus-fill me-1"></i>Dodaj klienta
            </a>
        </div>
    }
</div>

@if (clients is null)
{
    <div class="row g-3">
        @for (var i = 0; i < 6; i++)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="skeleton-card d-flex align-items-center gap-3" style="padding:14px">
                    <div class="skeleton skeleton-circle" style="width:40px;height:40px"></div>
                    <div style="flex:1">
                        <div class="skeleton skeleton-line w-75" style="height:13px"></div>
                        <div class="skeleton skeleton-line w-50" style="height:10px;margin-bottom:0"></div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!Filtered.Any())
{
    <div class="empty-state py-5">
        <div class="empty-state-icon">👥</div>
        @if (string.IsNullOrEmpty(search))
        {
            <div class="empty-state-title">Brak klientów</div>
            <div class="empty-state-desc">Dodaj pierwszego klienta, aby rozpocząć pracę z aplikacją.</div>
            <a href="/clients/new" class="empty-state-cta"><i class="bi bi-person-plus"></i>Dodaj klienta</a>
        }
        else
        {
            <div class="empty-state-title">Brak wyników</div>
            <div class="empty-state-desc">Nie znaleziono klientów dla "<strong>@search</strong>".</div>
        }
    </div>
}
else
{
    <div class="mb-3">
        <div class="input-group input-group-sm" style="max-width:320px">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Szukaj klienta..." @bind="search" @bind:event="oninput" />
        </div>
    </div>

    <div class="row g-3">
        @foreach (var c in Filtered)
        {
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card client-card h-100 position-relative" role="button" tabindex="0"
                     @onclick="@(() => Nav.NavigateTo($"/clients/{c.Id}"))"
                     @onkeydown="e => HandleCardKeyDown(e, c.Id)">
                    @if (c.Status == ClientStatus.Pending)
                    {
                        <span class="position-absolute top-0 end-0 m-2 badge bg-warning text-dark" style="font-size:.65rem">Oczekuje</span>
                    }
                    <div class="card-body d-flex gap-3 align-items-center">
                        <div class="avatar-circle flex-shrink-0">
                            @if (!string.IsNullOrEmpty(c.ProfilePictureUrl))
                            {
                                <img src="@c.ProfilePictureUrl" class="rounded-circle" width="52" height="52" style="object-fit:cover" alt="@c.FullName" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrEmpty(c.Initials) ? "?" : c.Initials)</span>
                            }
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold text-truncate">@c.FullName</div>
                            <div class="text-muted small text-truncate">@c.Email</div>
                            @if (!string.IsNullOrEmpty(c.Phone))
                            {
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@c.Phone</div>
                            }
                            @if (!string.IsNullOrEmpty(c.TrainingGoal))
                            {
                                <div class="text-muted small text-truncate mt-1">
                                    <i class="bi bi-bullseye me-1"></i>@c.TrainingGoal
                                </div>
                            }
                        </div>
                        <div class="text-end flex-shrink-0">
                            <div class="badge bg-primary-subtle text-primary rounded-pill">
                                @c.TotalSessions sesji
                            </div>
                            @if (c.LastSessionDate.HasValue)
                            {
                                <div class="text-muted" style="font-size:.7rem;margin-top:4px">
                                    @c.LastSessionDate.Value.ToString("dd.MM.yy")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-muted small mt-3">Łącznie: @Filtered.Count() klientów</div>
}

@if (_showImport)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-upload me-2"></i>Import klientów z CSV</h5>
                    <button type="button" class="btn-close" @onclick="CloseImport"></button>
                </div>
                <div class="modal-body">
                    @if (_importResult is null)
                    {
                        <p class="small text-muted mb-3">
                            Plik CSV rozdzielany średnikiem (<code>;</code>). Wymagane kolumny: <strong>Imię</strong>, <strong>Nazwisko</strong>, <strong>Email</strong>.
                            Opcjonalne: Telefon, Cel treningowy, Data urodzenia (yyyy-MM-dd).
                        </p>
                        <div class="alert alert-info small py-2 mb-3">
                            <i class="bi bi-lightbulb me-1"></i>Użyj eksportu CSV z zakładki Dane → Eksport jako wzorca formatu.
                        </div>
                        <InputFile accept=".csv,text/csv" OnChange="HandleImportFile" />
                        @if (_importing)
                        {
                            <div class="mt-3 text-center">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                                <span class="small">Importuję klientów...</span>
                            </div>
                        }
                        @if (_importError is not null)
                        {
                            <div class="alert alert-danger small mt-3 py-2 mb-0">@_importError</div>
                        }
                    }
                    else
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div class="text-center">
                                <div class="fw-bold fs-4 text-success">@_importResult.Imported</div>
                                <div class="small text-muted">dodanych</div>
                            </div>
                            <div class="text-center">
                                <div class="fw-bold fs-4 text-warning">@_importResult.Skipped</div>
                                <div class="small text-muted">pominiętych</div>
                            </div>
                        </div>
                        @if (_importResult.Errors.Count > 0)
                        {
                            <div class="small" style="max-height:200px;overflow-y:auto">
                                @foreach (var e in _importResult.Errors)
                                {
                                    <div class="text-muted mb-1"><i class="bi bi-dot"></i>@e</div>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseImport">Zamknij</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ClientDto>? clients;
    private string search = string.Empty;
    private bool _showImport;
    private bool _importing;
    private string? _importError;
    private CsvImportResult? _importResult;

    private void HandleCardKeyDown(KeyboardEventArgs e, int clientId)
    {
        if (e.Key is "Enter" or " ") Nav.NavigateTo($"/clients/{clientId}");
    }

    private IEnumerable<ClientDto> Filtered => clients?
        .Where(c => string.IsNullOrEmpty(search) ||
            c.FullName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            c.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            (c.Phone ?? "").Contains(search)) ?? [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var isAdmin = auth.User.IsInRole(Roles.Admin);
        var trainerUserId = isAdmin ? null : auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        clients = await ClientService.GetClientsAsync(trainerUserId);
    }

    private async Task HandleImportFile(InputFileChangeEventArgs e)
    {
        _importing = true;
        _importError = null;
        _importResult = null;
        try
        {
            await using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            _importResult = await ClientService.ImportClientsFromCsvAsync(stream);
            var auth = await AuthState.GetAuthenticationStateAsync();
            var isAdmin = auth.User.IsInRole(Roles.Admin);
            var trainerUserId = isAdmin ? null : auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            clients = await ClientService.GetClientsAsync(trainerUserId);
        }
        catch (Exception ex) { _importError = $"Błąd importu: {ex.Message}"; }
        finally { _importing = false; }
    }

    private void CloseImport()
    {
        _showImport = false;
        _importResult = null;
        _importError = null;
    }
}

