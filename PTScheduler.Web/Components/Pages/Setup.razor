@page "/setup"
@layout PTScheduler.Web.Components.Layout.AuthLayout
@using PTScheduler.Application.Interfaces
@inject ISetupService SetupService
@inject NavigationManager Nav
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Konfiguracja" />

@if (_alreadyDone)
{
    <div class="text-center py-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
        <h5 class="mt-3">Konfiguracja zakończona</h5>
        <p class="text-muted">Aplikacja jest już skonfigurowana.</p>
        <a href="/Account/Login" class="btn btn-primary mt-2">Zaloguj się</a>
    </div>
}
else if (_step == 0)
{
    <!-- Step 0: Choose setup mode -->
    <div class="text-center mb-4">
        <i class="bi bi-rocket-takeoff" style="font-size:2.5rem;color:var(--c-primary)"></i>
        <h4 class="mt-2 fw-bold">Witaj w PTScheduler!</h4>
        <p class="text-muted">Wybierz jak chcesz skonfigurować swoją instancję</p>
    </div>

    <div class="d-flex flex-column gap-3">
        <div class="setup-option" @onclick='() => SelectMode("self")'>
            <div class="d-flex align-items-start gap-3">
                <div class="setup-icon bg-primary-subtle text-primary">
                    <i class="bi bi-tools"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-1">Samodzielna konfiguracja</h6>
                    <p class="text-muted small mb-1">Skonfiguruj wszystko sam — nazwa studia, hasło admina, branding.</p>
                    <span class="badge bg-success-subtle text-success-emphasis">Bezpłatnie</span>
                </div>
                <i class="bi bi-chevron-right text-muted mt-2"></i>
            </div>
        </div>

        <div class="setup-option" @onclick='() => SelectMode("admin")'>
            <div class="d-flex align-items-start gap-3">
                <div class="setup-icon bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-person-gear"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-1">Konfiguracja przez administratora</h6>
                    <p class="text-muted small mb-1">Nasz zespół skonfiguruje wszystko za Ciebie — branding, płatności, domenę.</p>
                    <span class="badge bg-warning-subtle text-warning-emphasis">Płatna usługa</span>
                </div>
                <i class="bi bi-chevron-right text-muted mt-2"></i>
            </div>
        </div>
    </div>
}
else if (_step == 1 && _mode == "admin")
{
    <!-- Admin setup: show contact info -->
    <div class="text-center mb-4">
        <div class="setup-icon-lg bg-warning-subtle text-warning-emphasis mx-auto mb-3">
            <i class="bi bi-headset"></i>
        </div>
        <h5 class="fw-bold">Konfiguracja przez administratora</h5>
        <p class="text-muted small">Skontaktuj się z nami, a my wszystko przygotujemy.</p>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-envelope-fill text-primary"></i>
                <div>
                    <div class="small text-muted">Email</div>
                    <a href="mailto:kontakt@ptscheduler.pl" class="fw-semibold">kontakt@ptscheduler.pl</a>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-chat-dots-fill text-success"></i>
                <div>
                    <div class="small text-muted">Co obejmuje usługa</div>
                    <div class="small">Konfiguracja branding, płatności, domeny, SSL, import danych</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-fill text-info"></i>
                <div>
                    <div class="small text-muted">Czas realizacji</div>
                    <div class="small">Do 24h od zamówienia</div>
                </div>
            </div>
        </div>
    </div>

    <p class="text-muted small text-center">W międzyczasie możesz dokończyć podstawową konfigurację samodzielnie:</p>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary flex-fill" @onclick="() => _step = 0">
            <i class="bi bi-arrow-left me-1"></i>Wróć
        </button>
        <button class="btn btn-primary flex-fill" @onclick='() => { _mode = "admin"; _step = 2; }'>
            Kontynuuj setup<i class="bi bi-arrow-right ms-1"></i>
        </button>
    </div>
}
else if (_step == 2 || (_step == 1 && _mode == "self"))
{
    <!-- Step 2: Basic config form -->
    <div class="text-center mb-4">
        <div class="setup-icon-lg bg-primary-subtle text-primary mx-auto mb-3">
            <i class="bi bi-gear"></i>
        </div>
        <h5 class="fw-bold">Podstawowa konfiguracja</h5>
        <p class="text-muted small">Ustaw nazwę i dane logowania administratora</p>
    </div>

    <EditForm Model="_form" OnValidSubmit="FinishSetup" FormName="setup">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label fw-semibold">Nazwa studia / firmy</label>
            <InputText class="form-control" @bind-Value="_form.CompanyName" placeholder="np. FitStudio Jan Kowalski" />
            <ValidationMessage For="() => _form.CompanyName" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Email administratora</label>
            <InputText class="form-control" type="email" @bind-Value="_form.AdminEmail" placeholder="twoj@email.pl" />
            <ValidationMessage For="() => _form.AdminEmail" />
            <div class="form-text">To będzie Twój login. Zastąpi domyślne root@admin.local</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Nowe hasło</label>
            <InputText class="form-control" type="password" @bind-Value="_form.Password" />
            <ValidationMessage For="() => _form.Password" />
            <div class="form-text">Min. 8 znaków, duża litera, cyfra, znak specjalny</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Potwierdź hasło</label>
            <InputText class="form-control" type="password" @bind-Value="_form.PasswordConfirm" />
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small">@_error</div>
        }

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="() => _step = 0">
                <i class="bi bi-arrow-left me-1"></i>Wróć
            </button>
            <button type="submit" class="btn btn-primary flex-fill" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Zakończ konfigurację
            </button>
        </div>
    </EditForm>
}
else if (_step == 99)
{
    <!-- Done -->
    <div class="text-center py-3">
        <div class="setup-check mx-auto mb-3">
            <i class="bi bi-check-lg"></i>
        </div>
        <h4 class="fw-bold">Gotowe!</h4>
        <p class="text-muted">Twoja instancja PTScheduler jest skonfigurowana.</p>

        @if (_mode == "admin")
        {
            <div class="alert alert-info py-2 small text-start mb-3">
                <i class="bi bi-info-circle me-1"></i>
                Twoje zgłoszenie konfiguracji przez administratora zostało zapisane.
                Skontaktujemy się z Tobą na podany email.
            </div>
        }

        <div class="d-flex flex-column gap-2 mt-3">
            <a href="/Account/Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-1"></i>Zaloguj się
            </a>
            <p class="text-muted small mt-2 mb-0">
                Użyj nowego emaila i hasła, które właśnie ustawiłeś.
            </p>
        </div>
    </div>
}

<style>
    .setup-option {
        border: 2px solid var(--bs-border-color);
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        cursor: pointer;
        transition: border-color .2s, box-shadow .2s, transform .15s;
    }
    .setup-option:hover {
        border-color: var(--c-primary);
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        transform: translateY(-1px);
    }
    .setup-icon {
        width: 44px;
        height: 44px;
        border-radius: .6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .setup-icon-lg {
        width: 60px;
        height: 60px;
        border-radius: .75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }
    .setup-check {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: var(--bs-success);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }
</style>

@code {
    private int _step;
    private string _mode = "self";
    private bool _alreadyDone;
    private bool _saving;
    private string? _error;

    private SetupFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _alreadyDone = await SetupService.IsSetupCompletedAsync();
    }

    private void SelectMode(string mode)
    {
        _mode = mode;
        _step = mode == "self" ? 2 : 1;
    }

    private async Task FinishSetup()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.CompanyName))
        { _error = "Podaj nazwę studia."; return; }

        if (string.IsNullOrWhiteSpace(_form.AdminEmail) || !_form.AdminEmail.Contains('@'))
        { _error = "Podaj prawidłowy email."; return; }

        if (string.IsNullOrWhiteSpace(_form.Password) || _form.Password.Length < 8)
        { _error = "Hasło musi mieć min. 8 znaków."; return; }

        if (_form.Password != _form.PasswordConfirm)
        { _error = "Hasła nie są identyczne."; return; }

        _saving = true;
        try
        {
            await SetupService.CompleteSetupAsync(_mode, _form.CompanyName.Trim(), _form.AdminEmail.Trim(), _form.Password);
            _step = 99;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private class SetupFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        public string CompanyName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Nieprawidłowy email")]
        public string AdminEmail { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Wymagane")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Min. 8 znaków")]
        public string Password { get; set; } = "";

        public string PasswordConfirm { get; set; } = "";
    }
}
