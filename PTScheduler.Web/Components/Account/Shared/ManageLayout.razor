@inherits LayoutComponentBase
@layout PTScheduler.Web.Components.Layout.MainLayout
@inject NavigationManager Nav

@* „Moje konto” to jedna strona z sekcjami; podstrony (hasło, klucze dostępu, 2FA…) mają tylko powrót do niej. *@
<div class="acct-shell">
    @if (!IsHub)
    {
        <a href="/Account/Manage" class="acct-back"><i class="bi bi-chevron-left"></i>Moje konto</a>
    }
    @Body
</div>

@code {
    private bool IsHub
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
            return path.Equals("/Account/Manage", StringComparison.OrdinalIgnoreCase);
        }
    }
}
