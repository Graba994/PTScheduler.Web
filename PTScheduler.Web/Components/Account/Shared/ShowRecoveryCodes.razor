<StatusMessage Message="@StatusMessage" />
<div>
    <h1 class="h4 fw-bold mb-1">Twoje kody zapasowe</h1>
    <p class="text-muted small mb-0">Zapisz je teraz (zrzut ekranu, menedżer haseł, kartka w bezpiecznym miejscu). Nie pokażemy ich ponownie.</p>
</div>
<div class="acct-card">
    <div class="d-grid gap-2" style="grid-template-columns:repeat(auto-fill,minmax(130px,1fr))">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="recovery-code p-2 rounded text-center" style="background:var(--bs-tertiary-bg);font-size:1rem">@recoveryCode</code>
        }
    </div>
    <p class="small text-muted mt-3 mb-0">Każdy kod działa raz — wpisz go przy logowaniu zamiast kodu z aplikacji.</p>
</div>
<a href="Account/Manage/TwoFactorAuthentication" class="btn btn-primary align-self-start">Gotowe, zapisane</a>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
