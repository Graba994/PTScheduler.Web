@page "/Account/Lockout"
@layout PTScheduler.Web.Components.Layout.AuthLayout

<PageTitle>Konto zablokowane</PageTitle>

<div class="card" style="border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,0.10)">
    <div class="card-body p-4 text-center">
        <div class="mb-2" style="font-size:2rem;color:var(--c-danger,#DC2626)"><i class="bi bi-shield-lock"></i></div>
        <h5 class="fw-bold mb-2">Konto tymczasowo zablokowane</h5>
        <p class="text-muted small mb-4">
            Było za dużo nieudanych prób logowania. Odczekaj kilka minut i spróbuj ponownie
            albo zresetuj hasło.
        </p>
        <div class="d-flex flex-column gap-2">
            <a href="Account/Login" class="btn btn-primary">Wróć do logowania</a>
            <a href="Account/ForgotPassword" class="btn btn-link text-muted btn-sm">Nie pamiętam hasła</a>
        </div>
    </div>
</div>
