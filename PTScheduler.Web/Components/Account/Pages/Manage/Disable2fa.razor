@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger

<AppTitle Page="Wyłącz weryfikację dwuetapową" />

<StatusMessage />
<div>
    <h1 class="h4 fw-bold mb-1">Wyłączyć weryfikację dwuetapową?</h1>
    <p class="text-muted small mb-0">Do logowania wystarczy wtedy samo hasło (albo Face ID / odcisk palca).</p>
</div>
<div class="acct-card">
    <p class="small text-muted">Klucz w aplikacji uwierzytelniającej się nie zmieni. Jeśli chcesz go wymienić (np. nowy telefon), <a href="Account/Manage/ResetAuthenticator">zresetuj klucz</a>.</p>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post" class="d-flex gap-2">
        <AntiforgeryToken />
        <button class="btn btn-danger" type="submit">Wyłącz</button>
        <a href="Account/Manage/TwoFactorAuthentication" class="btn btn-outline-secondary">Anuluj</a>
    </form>
</div>

@code {
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            throw new InvalidOperationException("Weryfikacja dwuetapowa nie jest włączona.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Nie udało się wyłączyć weryfikacji dwuetapowej.");
        }

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            "Weryfikacja dwuetapowa wyłączona. Możesz ją włączyć ponownie w każdej chwili.",
            HttpContext);
    }
}
