@page "/Account/Manage"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Dane konta</PageTitle>

<div class="manage-card">
    <h5 class="fw-bold mb-1">Dane konta</h5>
    <p class="text-muted small mb-4">Podstawowe informacje widoczne w systemie.</p>

    <StatusMessage />

    <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label class="form-label fw-semibold">Imię</label>
                <InputText @bind-Value="Input.FirstName" class="form-control" placeholder="Imię" />
                <ValidationMessage For="() => Input.FirstName" class="text-danger small" />
            </div>
            <div class="col-sm-6">
                <label class="form-label fw-semibold">Nazwisko</label>
                <InputText @bind-Value="Input.LastName" class="form-control" placeholder="Nazwisko" />
                <ValidationMessage For="() => Input.LastName" class="text-danger small" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">E-mail</label>
            <input type="text" value="@_email" class="form-control" disabled />
            <div class="form-text">Adres e-mail służy do logowania i nie może być zmieniony tutaj.</div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Numer telefonu</label>
            <InputText @bind-Value="Input.PhoneNumber" class="form-control" placeholder="+48 000 000 000" />
            <ValidationMessage For="() => Input.PhoneNumber" class="text-danger small" />
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Zapisz zmiany
        </button>
    </EditForm>
</div>

<div class="manage-card mt-3">
    <h5 class="fw-bold mb-1">Aplikacja mobilna</h5>
    <p class="text-muted small mb-3">Zainstaluj PTScheduler jako aplikację na swoim urządzeniu.</p>
    <PwaInstall />
    <p class="text-muted" style="font-size:.75rem">
        Aplikacja działa jak natywna — bez przeglądarki, z ikoną na pulpicie.
    </p>
</div>

@code {
    private ApplicationUser? user;
    private string _email = string.Empty;
    private string? phoneNumber;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        _email    = user.Email ?? string.Empty;
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);

        Input.FirstName  ??= user.FirstName ?? string.Empty;
        Input.LastName   ??= user.LastName  ?? string.Empty;
        Input.PhoneNumber ??= phoneNumber;
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        user.FirstName = Input.FirstName?.Trim();
        user.LastName  = Input.LastName?.Trim();
        var updateResult = await UserManager.UpdateAsync(user);
        if (!updateResult.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(
                "Błąd: " + string.Join(" ", updateResult.Errors.Select(e => e.Description)), HttpContext);
            return;
        }

        if (Input.PhoneNumber != phoneNumber)
        {
            var phoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!phoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus(
                    "Błąd: Nie udało się zapisać numeru telefonu.", HttpContext);
                return;
            }
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Dane zostały zaktualizowane.", HttpContext);
    }

    private sealed class InputModel
    {
        [MaxLength(50)]
        public string? FirstName { get; set; }

        [MaxLength(50)]
        public string? LastName { get; set; }

        [Phone(ErrorMessage = "Nieprawidłowy numer telefonu.")]
        [Display(Name = "Phone number")]
        public string? PhoneNumber { get; set; }
    }
}
