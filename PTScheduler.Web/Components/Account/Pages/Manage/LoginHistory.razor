@page "/Account/Manage/LoginHistory"
@rendermode PTScheduler.Web.RenderModes.Server

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PTScheduler.Domain.Entities
@using PTScheduler.Infrastructure.Data
@using System.Security.Claims

@inject AuthenticationStateProvider AuthState
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject PTScheduler.Application.Interfaces.IAppClock Clock

<AppTitle Page="Urządzenia i logowania" />

<div>
    <h1 class="h4 fw-bold mb-1">Urządzenia i logowania</h1>
    <p class="text-muted small mb-0">Ostatnie logowania na Twoje konto. Nie rozpoznajesz któregoś? Wyloguj inne urządzenia i zmień hasło.</p>
</div>

@if (SignedOut == "1")
{
    <div class="alert alert-success py-2 small mb-0">
        <i class="bi bi-check-circle me-1"></i>Gotowe — inne urządzenia zostaną wylogowane najpóźniej w ciągu 5 minut. Na tym urządzeniu nic się nie zmienia.
    </div>
}

<div class="acct-card d-flex align-items-center gap-3 flex-wrap">
    <span class="acct-row-icon red"><i class="bi bi-box-arrow-right"></i></span>
    <div class="flex-grow-1" style="min-width:200px">
        <div class="fw-semibold">Wyloguj ze wszystkich innych urządzeń</div>
        <div class="small text-muted">Np. po zgubieniu telefonu albo logowaniu na cudzym komputerze.</div>
    </div>
    <form method="post" action="/Account/Manage/SignOutOtherDevices" data-enhance="false">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-outline-danger">Wyloguj</button>
    </form>
</div>

@if (_logs == null)
{
    <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
}
else if (_logs.Count == 0)
{
    <div class="acct-card text-center text-muted">
        <i class="bi bi-clock-history" style="font-size:2rem;opacity:.4"></i>
        <p class="mt-2 small mb-0">Brak zarejestrowanych logowań.</p>
    </div>
}
else
{
    <div class="acct-list">
        @foreach (var log in _showAll ? _logs : _logs.Take(10))
        {
            var (icon, device) = Device(log.UserAgent);
            <div class="acct-row">
                <span class="acct-row-icon @(log.Success ? "slate" : "red")"><i class="bi @icon"></i></span>
                <span class="acct-row-main">
                    <span class="acct-row-title d-block">@device</span>
                    <span class="acct-row-sub">@Clock.ToWallClock(log.LoginTime.ToUniversalTime()).ToString("d MMMM yyyy, HH:mm", Pl)@(string.IsNullOrEmpty(log.IpAddress) ? "" : $" · IP {log.IpAddress}")</span>
                </span>
                @if (log.Success)
                {
                    <span class="acct-row-value ok">Udane</span>
                }
                else
                {
                    <span class="acct-row-value" style="color:#DC2626;font-weight:600">Nieudana próba</span>
                }
            </div>
        }
    </div>
    @if (!_showAll && _logs.Count > 10)
    {
        <button class="btn btn-outline-secondary align-self-center" @onclick="() => _showAll = true">Pokaż więcej (@(_logs.Count - 10))</button>
    }
}

@code {
    private bool _showAll;
    private static readonly System.Globalization.CultureInfo Pl = new("pl-PL");
    private List<LoginLog>? _logs;

    [SupplyParameterFromQuery] public string? SignedOut { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        _logs = await db.LoginLogs
            .Where(l => l.UserId == userId)
            .OrderByDescending(l => l.LoginTime)
            .Take(30)
            .ToListAsync();

        StateHasChanged();
    }

    /// <summary>Czytelna nazwa urządzenia z nagłówka przeglądarki, np. „iPhone · Safari”.</summary>
    private static (string Icon, string Label) Device(string? ua)
    {
        if (string.IsNullOrEmpty(ua)) return ("bi-question-circle", "Nieznane urządzenie");
        var browser = ua.Contains("Edg/") ? "Edge"
            : ua.Contains("OPR/") ? "Opera"
            : ua.Contains("Firefox/") ? "Firefox"
            : ua.Contains("Chrome/") ? "Chrome"
            : ua.Contains("Safari/") ? "Safari"
            : "przeglądarka";
        var (icon, os) = ua.Contains("iPhone") ? ("bi-phone", "iPhone")
            : ua.Contains("iPad") ? ("bi-tablet", "iPad")
            : ua.Contains("Android") ? (ua.Contains("Mobile") ? ("bi-phone", "Telefon z Androidem") : ("bi-tablet", "Tablet z Androidem"))
            : ua.Contains("Mac OS X") ? ("bi-laptop", "Mac")
            : ua.Contains("Windows") ? ("bi-pc-display", "Komputer z Windows")
            : ua.Contains("Linux") ? ("bi-pc-display", "Komputer z Linuksem")
            : ("bi-globe", "Urządzenie");
        return (icon, $"{os} · {browser}");
    }
}
