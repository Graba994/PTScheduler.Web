@page "/Account/Manage/Notifications"
@inject INotificationPreferencesService NotifService
@inject AuthenticationStateProvider AuthState
@inject IAuditLogService AuditLogService
@inject EntitlementService Entitlements
@using Microsoft.AspNetCore.Components.Authorization
@using PTScheduler.Application.DTOs
@using PTScheduler.Application.Interfaces
@using PTScheduler.Domain.Constants
@rendermode PTScheduler.Web.RenderModes.Server

<AppTitle Page="Powiadomienia" />

<div>
    <h1 class="h4 fw-bold mb-1">Powiadomienia</h1>
    <p class="text-muted small mb-0">Wybierz, o czym chcesz wiedzieć i jak: e-mailem, powiadomieniem na telefonie@(_showSms ? " albo SMS-em" : ""). Zmiany zapisują się od razu.</p>
</div>

<PushDeviceCard />

@if (_loading)
{
    <div class="text-center py-4"><span class="spinner-border text-primary"></span></div>
}
else
{
    @if (_isAdminRole)
    {
        <div class="alert alert-info small mb-0">
            <i class="bi bi-info-circle me-1"></i>Konto administratora dostaje e-mailem tylko informacje o poważnych błędach systemu.
        </div>
    }
    <div class="acct-list" style="--cols:@_columns.Count">
        <div class="acct-matrix-head">
            <span>Rodzaj</span>
            @foreach (var col in _columns)
            {
                <span>@ColumnLabel(col)</span>
            }
        </div>
        @foreach (var row in _rows)
        {
            <div class="acct-matrix-row">
                <div class="acct-row-main">
                    <div class="acct-row-title">@row.Title</div>
                    <div class="acct-row-sub">@row.Description</div>
                </div>
                @foreach (var col in _columns)
                {
                    var cell = row.Cell(col);
                    <div class="acct-matrix-cell">
                        @if (cell is null)
                        {
                            <span class="acct-matrix-na" title="Ten kanał nie dotyczy tego powiadomienia">—</span>
                        }
                        else
                        {
                            <input class="form-check-input" type="checkbox" role="switch"
                                   aria-label="@($"{row.Title}: {ColumnLabel(col)}")"
                                   checked="@cell.Get()"
                                   @onchange="e => ToggleAsync(cell, e)" />
                        }
                        <span class="acct-matrix-cell-label">@ColumnLabel(col)</span>
                    </div>
                }
            </div>
        }
    </div>
    @if (_showSms)
    {
        <p class="small text-muted mb-0"><i class="bi bi-chat-dots me-1"></i>SMS-y wysyłamy tylko wtedy, gdy trener je włączył i masz podany numer telefonu w Moje konto → Profil.</p>
    }
}

@if (_toast is not null)
{
    <div class="acct-toast" role="status"><i class="bi bi-check-circle-fill"></i>@_toast</div>
}

@code {
    private const string Email = "email", Push = "push", Sms = "sms";

    private string _userId = "", _userEmail = "", _userRole = "";
    private bool _isAdminRole, _loading = true, _showSms;
    private NotificationPreferencesDto _prefs = new();
    private List<string> _columns = [];
    private List<Row> _rows = [];
    private string? _toast;
    private CancellationTokenSource? _toastCts;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _userEmail = user.Identity?.Name ?? "";
        _isAdminRole = user.IsInRole(Roles.Admin);
        var isClient = user.IsInRole(Roles.Client) && !user.IsInRole(Roles.Admin) && !user.IsInRole(Roles.Trainer);
        _userRole = _isAdminRole ? Roles.Admin : user.IsInRole(Roles.Trainer) ? Roles.Trainer : isClient ? Roles.Client : Roles.Subordinate;
        _prefs = await NotifService.GetAsync(_userId);
        _showSms = isClient && Entitlements.IsAllowed("SmsReminders");
        _columns = _showSms ? [Email, Push, Sms] : [Email, Push];
        _rows = isClient ? ClientRows() : StaffRows();
        _loading = false;
    }

    private List<Row> ClientRows() =>
    [
        new("Przypomnienie przed treningiem", "Dzień przed wizytą — godzina i rodzaj treningu",
            email: new(() => _prefs.SessionReminders, v => _prefs.SessionReminders = v),
            push: new(() => _prefs.PushReminders, v => _prefs.PushReminders = v),
            sms: new(() => _prefs.SmsReminders, v => _prefs.SmsReminders = v)),
        new("Rezerwacje i zmiany terminów", "Potwierdzenie wizyty, przesunięcie albo odwołanie przez trenera",
            email: new(() => _prefs.SessionBooked || _prefs.SessionRescheduled || _prefs.SessionCancelledByTrainer,
                       v => _prefs.SessionBooked = _prefs.SessionRescheduled = _prefs.SessionCancelledByTrainer = v),
            push: new(() => _prefs.PushSessions, v => _prefs.PushSessions = v)),
        new("Pakiety i karnety", "Nowy pakiet, kończące się treningi, odnowienie karnetu",
            email: new(() => _prefs.PackageAssigned || _prefs.ExpiringPackages, v => _prefs.PackageAssigned = _prefs.ExpiringPackages = v),
            push: new(() => _prefs.PushPackages, v => _prefs.PushPackages = v)),
        new("Wiadomości i komentarze", "Nowa wiadomość na czacie, komentarz trenera do treningu",
            push: new(() => _prefs.PushMessages, v => _prefs.PushMessages = v)),
        new("Od trenera", "Powitanie, życzenia urodzinowe, zaproszenia do powrotu — czasem z kuponem",
            email: new(() => _prefs.TrainerMessages, v => _prefs.TrainerMessages = v),
            push: new(() => _prefs.PushTrainerMessages, v => _prefs.PushTrainerMessages = v),
            sms: new(() => _prefs.SmsTrainerMessages, v => _prefs.SmsTrainerMessages = v)),
    ];

    private List<Row> StaffRows() =>
    [
        new("Wizyty klientów", "Klient odwołał wizytę albo prosi o termin",
            email: new(() => _prefs.ClientCancelledSession, v => _prefs.ClientCancelledSession = v),
            push: new(() => _prefs.PushSessions, v => _prefs.PushSessions = v)),
        new("Nowy klient czeka", "Ktoś założył konto i czeka na Twoją akceptację",
            email: new(() => _prefs.NewClientPending, v => _prefs.NewClientPending = v)),
        new("Kończące się pakiety klientów", "Klientowi zostały 1–2 treningi albo pakiet wkrótce wygaśnie",
            email: new(() => _prefs.ExpiringPackages, v => _prefs.ExpiringPackages = v),
            push: new(() => _prefs.PushPackages, v => _prefs.PushPackages = v)),
        new("Aktywność klientów", "Ankiety, nowe pomiary, opinie",
            push: new(() => _prefs.PushClientActivity, v => _prefs.PushClientActivity = v)),
        new("Wiadomości i komentarze", "Nowa wiadomość na czacie, komentarz klienta do treningu",
            push: new(() => _prefs.PushMessages, v => _prefs.PushMessages = v)),
    ];

    private async Task ToggleAsync(Cell cell, ChangeEventArgs e)
    {
        cell.Set(e.Value is true || (e.Value is string s && s == "true"));
        await NotifService.SaveAsync(_userId, _prefs);
        try
        {
            await AuditLogService.LogAsync(_userId, _userEmail, _userRole, "NotificationPreferencesSaved",
                "NotificationPreferences", _userId, "Zmieniono ustawienia powiadomień");
        }
        catch { } // audyt to najlepszy wysiłek
        _ = ToastAsync("Zapisano");
    }

    private async Task ToastAsync(string text)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = text;
        StateHasChanged();
        try
        {
            await Task.Delay(1800, token);
            _toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private static string ColumnLabel(string col) => col switch { Email => "E-mail", Push => "Push", _ => "SMS" };

    private sealed class Cell(Func<bool> get, Action<bool> set)
    {
        public Func<bool> Get { get; } = get;
        public Action<bool> Set { get; } = set;
    }

    private sealed class Row(string title, string description, Cell? email = null, Cell? push = null, Cell? sms = null)
    {
        public string Title { get; } = title;
        public string Description { get; } = description;
        public Cell? Cell(string column) => column switch { Email => email, Push => push, _ => sms };
    }
}
