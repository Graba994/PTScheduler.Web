@page "/Account/Manage/ChangePassword"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger
@inject IDbContextFactory<PTScheduler.Infrastructure.Data.ApplicationDbContext> DbFactory
@using Microsoft.EntityFrameworkCore

<PageTitle>Zmiana hasła</PageTitle>

<div class="manage-card">
    <h5 class="fw-bold mb-1">Zmiana hasła</h5>
    @if (Forced == 1)
    {
        <div class="alert alert-warning small">
            <i class="bi bi-shield-lock me-1"></i>Hasło do tego konta nadała inna osoba. Ustaw własne — wtedy będziesz jedyną osobą, która je zna.
        </div>
    }
    <p class="text-muted small mb-4">Hasło musi mieć co najmniej 8 znaków, w tym cyfrę.</p>

    <StatusMessage Message="@message" />

    <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post" data-busy-on-submit>
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label fw-semibold">Aktualne hasło</label>
            <div class="input-group">
                <InputText id="old-pw" type="password" @bind-Value="Input.OldPassword"
                           class="form-control" autocomplete="current-password"
                           aria-required="true" />
                <button type="button" class="btn btn-outline-secondary"
                        onclick="const f=document.getElementById('old-pw');f.type=f.type==='password'?'text':'password';this.querySelector('i').className=f.type==='password'?'bi bi-eye':'bi bi-eye-slash'">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <ValidationMessage For="() => Input.OldPassword" class="text-danger small" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Nowe hasło</label>
            <div class="input-group">
                <InputText id="new-pw" type="password" @bind-Value="Input.NewPassword"
                           class="form-control" autocomplete="new-password"
                           aria-required="true" />
                <button type="button" class="btn btn-outline-secondary"
                        onclick="const f=document.getElementById('new-pw');f.type=f.type==='password'?'text':'password';this.querySelector('i').className=f.type==='password'?'bi bi-eye':'bi bi-eye-slash'">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <ValidationMessage For="() => Input.NewPassword" class="text-danger small" />
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Potwierdź nowe hasło</label>
            <div class="input-group">
                <InputText id="confirm-pw" type="password" @bind-Value="Input.ConfirmPassword"
                           class="form-control" autocomplete="new-password"
                           aria-required="true" />
                <button type="button" class="btn btn-outline-secondary"
                        onclick="const f=document.getElementById('confirm-pw');f.type=f.type==='password'?'text':'password';this.querySelector('i').className=f.type==='password'?'bi bi-eye':'bi bi-eye-slash'">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small" />
        </div>

        <button type="submit" class="btn btn-primary" data-busy-text="Zmieniam hasło…">
            <i class="bi bi-lock me-1"></i>Zmień hasło
        </button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromQuery(Name = "forced")] private int? Forced { get; set; }

    private string? message;
    private ApplicationUser? user;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded && await AlreadyChangedAsync(user.Id) is { } changed)
        {
            // Formularz wysłany drugi raz (podwójne kliknięcie, wolne łącze): pierwsze wysłanie już zmieniło hasło,
            // a drugie trafia na stare hasło („nieprawidłowe”) albo na konflikt zapisu. To nie błąd — hasło jest ustawione.
            await SignInManager.RefreshSignInAsync(changed);
            if (Forced == 1) RedirectManager.RedirectTo("/app");
            else RedirectManager.RedirectToCurrentPageWithStatus("Hasło zostało zmienione.", HttpContext);
            return;
        }
        if (!result.Succeeded)
        {
            message = "Błąd: " + string.Join(" ", result.Errors.Select(e => e.Description));
            // Hasła nie wracają do formularza po błędzie.
            Input.OldPassword = Input.NewPassword = Input.ConfirmPassword = "";
            return;
        }

        var wasForced = user.MustChangePassword;
        if (wasForced)
        {
            user.MustChangePassword = false;
            await UserManager.UpdateAsync(user);
        }
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");
        if (wasForced)
        {
            RedirectManager.RedirectTo("/app");
            return;
        }
        RedirectManager.RedirectToCurrentPageWithStatus("Hasło zostało zmienione.", HttpContext);
    }

    /// <summary>
    /// Świeży odczyt z bazy (nie z obiektu tej prośby): hasło to już nowe hasło, a wymóg zmiany jest zdjęty.
    /// Bez drugiego warunku dałoby się „zmienić” hasło nadane przez Portal na to samo i ominąć wymuszoną zmianę.
    /// </summary>
    private async Task<ApplicationUser?> AlreadyChangedAsync(string userId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var fresh = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);
        if (fresh is null || fresh.MustChangePassword || string.IsNullOrEmpty(fresh.PasswordHash)) return null;
        var check = UserManager.PasswordHasher.VerifyHashedPassword(fresh, fresh.PasswordHash, Input.NewPassword);
        return check == PasswordVerificationResult.Failed ? null : fresh;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Aktualne hasło jest wymagane.")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Nowe hasło jest wymagane.")]
        [StringLength(100, ErrorMessage = "Hasło musi mieć co najmniej {2} znaków.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessage = "Hasła nie są zgodne.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
