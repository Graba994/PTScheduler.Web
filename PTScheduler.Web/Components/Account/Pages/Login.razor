@page "/Account/Login"
@layout PTScheduler.Web.Components.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using PTScheduler.Web.Components.Account
@using PTScheduler.Web.Components.Account.Shared

@using PTScheduler.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject PTScheduler.Infrastructure.Data.ApplicationDbContext DbContext
@inject PTScheduler.Application.Interfaces.IAppClock Clock

<PageTitle>Logowanie</PageTitle>

<div class="card" style="border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,0.10)"
     data-login-card data-login-error="@(string.IsNullOrEmpty(errorMessage) ? null : "1")">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-1 text-center">@(string.IsNullOrWhiteSpace(Branding?.LoginTitle) ? "Zaloguj się" : Branding?.LoginTitle)</h5>
        <p class="text-muted small text-center mb-4">@(string.IsNullOrWhiteSpace(Branding?.LoginSubtitle) ? "Wpisz swoje dane dostępowe" : Branding?.LoginSubtitle)</p>

        <StatusMessage Message="@errorMessage" />

        <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login" data-busy-on-submit>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small mb-3" role="alert" />

            <div class="login-stack">
            <div class="login-password-part">
            <div class="mb-3">
                <label class="form-label" for="Input.Email">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control"
                               type="email" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false"
                               autocomplete="username webauthn" placeholder="jan@example.com" autofocus />
                </div>
                <ValidationMessage For="() => Input.Email" class="text-danger small" />
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label" for="Input.Password">Hasło</label>
                    <a href="Account/ForgotPassword" class="small text-muted">Zapomniałeś hasła?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password"
                               class="form-control" autocomplete="current-password" placeholder="••••••••" />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="Input.Password"
                            aria-label="Pokaż hasło" title="Pokaż hasło">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <ValidationMessage For="() => Input.Password" class="text-danger small" />
            </div>

            <div class="form-check mb-4">
                <InputCheckbox @bind-Value="Input.PublicDevice" class="form-check-input" id="publicDevice" />
                <label class="form-check-label small text-muted" for="publicDevice">Urządzenie publiczne — nie zapamiętuj logowania</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3" data-busy-text="Logowanie…">
                <i class="bi bi-box-arrow-in-right me-1"></i>Zaloguj się
            </button>
            </div>

            @* Klucz dostępu: zwykle dyskretna opcja; na urządzeniu z kluczem (js/auth-forms.js
               dodaje .passkey-first) — główny przycisk, a hasło chowa się pod „Zaloguj hasłem”. *@
            <div class="login-passkey text-center">
                <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email"
                               class="btn btn-sm btn-link text-muted login-passkey-btn">
                    <span class="pk-label-default"><i class="bi bi-key me-1"></i>Zaloguj przez klucz dostępu</span>
                    <span class="pk-label-hero"><i class="bi bi-fingerprint me-1"></i>Zaloguj odciskiem palca / Face ID</span>
                </PasskeySubmit>
            </div>
            <div class="login-password-toggle text-center">
                <button type="button" class="btn btn-link btn-sm text-muted" data-show-password-login>Zaloguj hasłem</button>
            </div>
            </div>
        </EditForm>
    </div>
</div>

<div class="text-center mt-3 small auth-below-card">
    Nie masz konta?
    <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
        Zarejestruj się
    </a>
</div>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private PTScheduler.Application.DTOs.AppBrandingDto? Branding { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        editContext = new EditContext(Input);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
    }

    public async Task LoginUser()
    {
        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            errorMessage = $"Błąd: {Input.Passkey.Error}";
            return;
        }

        var target = LoginSupport.SafeReturnUrl(ReturnUrl, NavigationManager.BaseUri);

        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            await LoginWithPasskeyAsync(Input.Passkey.CredentialJson, target);
            return;
        }

        if (!editContext.Validate()) return;

        var user = await UserManager.FindByEmailAsync(Input.Email);
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, isPersistent: !Input.PublicDevice, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            if (user != null) await Record(user.Id, true);
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(target);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo("Account/LoginWith2fa",
                new() { ["returnUrl"] = target, ["rememberMe"] = !Input.PublicDevice });
        }
        else if (result.IsLockedOut)
        {
            if (user != null) await Record(user.Id, false);
            Logger.LogWarning("User account locked out.");
            errorMessage = "Błąd: " + LoginSupport.LockoutMessage(
                user is null ? null : await UserManager.GetLockoutEndDateAsync(user), Clock.UtcNow);
        }
        else
        {
            if (user != null) await Record(user.Id, false);
            errorMessage = "Błąd: Nieprawidłowy email lub hasło.";
        }
    }

    // Odpowiednik SignInManager.PasskeySignInAsync, ale z trwałym ciasteczkiem (PWA nie może
    // gubić sesji po uśpieniu) i z zapisem w logu logowań — przy kluczu dostępu pole e-mail
    // bywa puste, więc użytkownika bierzemy z wyniku weryfikacji, nie z formularza.
    private async Task LoginWithPasskeyAsync(string credentialJson, string target)
    {
        var assertion = await SignInManager.PerformPasskeyAssertionAsync(credentialJson);
        if (!assertion.Succeeded)
        {
            errorMessage = "Błąd: Nie udało się zalogować kluczem dostępu. Spróbuj ponownie albo użyj hasła.";
            return;
        }

        var user = assertion.User;
        if (await UserManager.IsLockedOutAsync(user))
        {
            await Record(user.Id, false);
            errorMessage = "Błąd: " + LoginSupport.LockoutMessage(await UserManager.GetLockoutEndDateAsync(user), Clock.UtcNow);
            return;
        }
        if (!await SignInManager.CanSignInAsync(user))
        {
            await Record(user.Id, false);
            errorMessage = "Błąd: To konto nie może się jeszcze zalogować (np. niepotwierdzony e-mail).";
            return;
        }

        // Aktualny licznik podpisów klucza — ochrona przed sklonowanym kluczem.
        var update = await UserManager.AddOrUpdatePasskeyAsync(user, assertion.Passkey);
        if (!update.Succeeded)
        {
            errorMessage = "Błąd: Nie udało się zalogować kluczem dostępu.";
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: !Input.PublicDevice, authenticationMethod: "passkey");
        await Record(user.Id, true);
        Logger.LogInformation("User logged in with a passkey.");
        RedirectManager.RedirectTo(target);
    }

    private Task Record(string userId, bool success) =>
        LoginSupport.RecordAsync(DbContext, Clock, Logger, HttpContext, userId, success);

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email jest wymagany.")]
        [EmailAddress(ErrorMessage = "Nieprawidłowy adres email.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Hasło jest wymagane.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        // Logowanie jest domyślnie zapamiętane (trwałe ciasteczko), bo aplikacja
        // działa głównie jako PWA, które po uśpieniu nie może gubić sesji.
        // Użytkownik na cudzym/publicznym komputerze może z tego zrezygnować.
        [Display(Name = "Urządzenie publiczne")]
        public bool PublicDevice { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}
