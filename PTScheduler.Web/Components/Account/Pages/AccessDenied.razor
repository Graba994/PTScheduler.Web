@page "/Account/AccessDenied"

<PageTitle>Brak dostępu — PTScheduler</PageTitle>

<ErrorScreen Emoji="🔒"
             Tone="warm"
             Title="Brak dostępu do tej sekcji"
             Lead="Ta strona jest dostępna tylko dla użytkowników z odpowiednimi uprawnieniami.">
    <Body>
        <p>Jeśli uważasz, że to pomyłka — skontaktuj się ze swoim trenerem lub administratorem aplikacji.</p>
    </Body>
    <Actions>
        <a href="/" class="es-btn">
            <i class="bi bi-house-fill"></i> Strona główna
        </a>
        <a href="/Account/Login" class="es-btn es-btn-ghost">
            <i class="bi bi-box-arrow-in-right"></i> Zaloguj się
        </a>
    </Actions>
</ErrorScreen>
