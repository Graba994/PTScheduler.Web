@* Krótkie „jak to działa” dla treningów w parze — ten sam przekaz w sklepie, grafiku i u trenera. *@
<div class="pair-how @Class">
    <div class="pair-how-title"><i class="bi bi-people-fill"></i>@Title</div>
    <ul>
        @switch (Variant)
        {
            case "shop":
                <li>Kupujesz raz — pakiet należy do Was obojga.</li>
                <li>Za wspólny trening schodzi <strong>1</strong>, nie 2.</li>
                <li>Każde z Was ma swój grafik i przypomnienia.</li>
                <li>Gdy jedno odwoła, drugie może przyjść samo — wtedy też schodzi 1.</li>
                break;
            case "book":
                <li>Oboje dostajecie potwierdzenie i przypomnienie.</li>
                <li>Macie wspólny pakiet? Za trening schodzi 1. Jeśli nie — każde z Was płaci ze swojego.</li>
                <li>Gdy jedno odwoła, drugie trenuje dalej.</li>
                break;
            default:
                <li>Oboje widzą pakiet i wspólne treningi u siebie.</li>
                <li>Pakiet dla pary: za wspólny trening schodzi 1. Zwykłe pakiety — każda osoba płaci ze swojego.</li>
                <li>Gdy jedna osoba odwoła, druga trenuje sama i dostaje o tym wiadomość.</li>
                break;
        }
    </ul>
</div>

@code {
    /// <summary>„shop” — zakup pakietu, „book” — rezerwacja, domyślnie — widok trenera.</summary>
    [Parameter] public string Variant { get; set; } = "trainer";
    [Parameter] public string Title { get; set; } = "Jak działa trening w parze";
    [Parameter] public string? Class { get; set; }
}
