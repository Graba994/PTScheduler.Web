@* „Dziś” (wizyty po kolei z akcjami) i „Pulpit” (liczby, asystent, sprawy) — dwa widoki dnia trenera,
   przełącznik u góry obu ekranów, żeby Pulpit był pod ręką także na telefonie. *@
<nav class="svs day-switch" aria-label="Widok dnia">
    <a class="@(Current == "today" ? "on" : "")" href="/dzis" aria-current="@(Current == "today" ? "page" : null)"><i class="bi bi-sun"></i>Dziś</a>
    <a class="@(Current == "dashboard" ? "on" : "")" href="/app" aria-current="@(Current == "dashboard" ? "page" : null)"><i class="bi bi-grid-1x2"></i>Pulpit</a>
</nav>

@code {
    [Parameter] public string Current { get; set; } = "today";
}
