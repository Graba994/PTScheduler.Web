<span class="cf">
    <label class="cf-swatch" title="Wybierz kolor"
           style="background:@(string.IsNullOrEmpty(Value) ? "repeating-conic-gradient(#c9c9c9 0% 25%, #fff 0% 50%) 50% / 12px 12px" : Value)">
        <input type="color" value="@(Value ?? "#3366ff")" @onchange="OnPick" />
    </label>
    <input class="form-control form-control-sm cf-hex" placeholder="domyślny" value="@Value" @onchange="OnHex" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <button type="button" class="btn btn-sm btn-link text-muted p-0 cf-reset" title="Kolor domyślny" @onclick="Clear">
            <i class="bi bi-arrow-counterclockwise"></i>
        </button>
    }
</span>

<style>
    .cf { display: inline-flex; align-items: center; gap: .4rem; }
    .cf-swatch { position: relative; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; overflow: hidden;
        border: 1px solid var(--bs-border-color, #ced4da); box-shadow: inset 0 0 0 2px #fff; flex: 0 0 auto; }
    .cf-swatch input[type=color] { position: absolute; inset: -4px; width: calc(100% + 8px); height: calc(100% + 8px);
        border: 0; padding: 0; margin: 0; cursor: pointer; background: transparent; }
    .cf-hex { width: 104px; font-family: monospace; }
    .cf-reset { font-size: 1rem; }
</style>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private Task OnPick(ChangeEventArgs e) => Set(e.Value?.ToString());

    private Task OnHex(ChangeEventArgs e)
    {
        var v = e.Value?.ToString()?.Trim();
        return Set(string.IsNullOrWhiteSpace(v) ? null : v);
    }

    private Task Clear() => Set(null);

    private async Task Set(string? v)
    {
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}
