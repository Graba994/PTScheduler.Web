@* Przypomnienie o własnym haśle, gdy konto założyła albo zresetowała inna osoba.
   Bez blokowania aplikacji — klient może najpierw wypełnić ankietę czy zarezerwować wizytę. *@
@using System.Security.Claims

<AuthorizeView>
    <Authorized>
        @if (context.User.HasClaim(PTScheduler.Web.Services.AppClaimsPrincipalFactory.MustChangePasswordClaim, "1") && !_hidden)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 flex-wrap py-2 px-3 mb-3" role="status">
                <i class="bi bi-shield-lock-fill fs-4"></i>
                <div class="flex-grow-1" style="min-width:200px">
                    <div class="fw-semibold">Ustaw własne hasło</div>
                    <div class="small">Obecne hasło nadała Ci inna osoba (np. trener przy zakładaniu konta). Zmień je, żeby znać je tylko Ty.</div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Account/Manage/ChangePassword" class="btn btn-sm btn-warning fw-semibold">Zmień hasło</a>
                    <button type="button" class="btn btn-sm btn-link text-reset" @onclick="() => _hidden = true">Później</button>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private bool _hidden;
}
