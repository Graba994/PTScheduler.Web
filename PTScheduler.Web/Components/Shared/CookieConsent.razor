@rendermode PTScheduler.Web.RenderModes.Server
@inject IJSRuntime JS

@* Informacja o cookies na stronach publicznych i przy logowaniu. Po zalogowaniu jej nie pokazujemy —
   zalogowana osoba zna już zasady (regulamin przy zakładaniu konta), a pasek zasłaniał dół ekranu. *@
@if (_visible)
{
    <div class="cookie-banner" role="region" aria-label="Pliki cookies">
        <div class="cookie-banner-inner">
            <div class="cookie-banner-text">
                <i class="bi bi-cookie" aria-hidden="true"></i>
                <p>Używamy tylko niezbędnych plików cookies. <a href="/legal/cookies">Szczegóły</a></p>
            </div>
            <button class="btn btn-primary btn-sm cookie-banner-btn" @onclick="Accept">OK</button>
        </div>
    </div>
}

@code {
    private bool _visible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var accepted = await JS.InvokeAsync<string?>("localStorage.getItem", "cookie-consent");
                if (accepted != "1")
                {
                    _visible = true;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task Accept()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", "cookie-consent", "1"); } catch { }
        _visible = false;
    }
}
