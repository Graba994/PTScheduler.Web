@* Wyraźna informacja na koncie Administratora: to konto służy do ustawień aplikacji.
   Treningi prowadzi się na profilu trenera — tylko jego widzą klienci i zapisy online. *@
@using PTScheduler.Domain.Constants
@using PTScheduler.Web.Services
@inject AccountSwitchService Switcher
@inject PTScheduler.Application.Interfaces.IUserManagementService Users

<div class="admin-role-banner" role="note">
    <div class="arb-ic"><i class="bi @(_isRoot ? "bi-tools" : "bi-shield-lock-fill")"></i></div>
    <div class="arb-txt">
        <b>@(_isRoot ? "Jesteś na koncie technicznym (root)" : "Jesteś na koncie Administratora")</b>
        @if (_solo is { Enabled: true })
        {
            <span>Pracujesz sam: Twój profil trenera ma już wszystkie uprawnienia — przejdź na niego. To konto zostaje jako zapasowe.</span>
        }
        else if (_trainers.Count > 0)
        {
            <span>Tu ustawiasz aplikację: ceny, płatności, wygląd i konta. Treningi prowadzisz na profilu trenera — tylko on jest widoczny dla klientów w zapisach.
                @if (_solo is { Possible: true, Enabled: false }) { <a href="/admin/users#solo" class="arb-link">Pracujesz sam? Wystarczy jedno konto.</a> }</span>
        }
        else
        {
            <span>To konto jeszcze nie przyjmuje zapisów klientów. Prowadzisz treningi? Włącz to na tym samym koncie — bez drugiego logowania.</span>
        }
    </div>
    <div class="arb-act">
        @if (_trainers.Count == 1 && _canSwitch)
        {
            <form action="Account/SwitchTo" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="userId" value="@_trainers[0].Id" />
                <button type="submit" class="btn btn-sm arb-btn"><i class="bi bi-person-badge me-1"></i>Przełącz na profil trenera</button>
            </form>
        }
        else if (_trainers.Count > 1 && _canSwitch)
        {
            <a href="/switch-account" class="btn btn-sm arb-btn"><i class="bi bi-people me-1"></i>Przełącz na profil trenera</a>
        }
        else if (_trainers.Count > 0)
        {
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="/Account/Login" />
                <button type="submit" class="btn btn-sm arb-btn"><i class="bi bi-person-badge me-1"></i>Zaloguj się jako trener</button>
            </form>
        }
        else
        {
            <a href="/witaj" class="btn btn-sm arb-btn"><i class="bi bi-person-check me-1"></i>Prowadzę treningi</a>
        }
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private List<SwitchCandidate> _trainers = [];
    private bool _canSwitch;
    private bool _isRoot;
    private PTScheduler.Application.Interfaces.SoloModeState? _solo;

    protected override async Task OnInitializedAsync()
    {
        var user = HttpContext?.User;
        if (user is null) return;
        try
        {
            _isRoot = user.IsInRole(Roles.Root);
            _canSwitch = await Switcher.CanUseAsync(user);
            // Przy wyłączonym przełączaniu liczy się tylko, czy profil trenera w ogóle istnieje.
            _trainers = _canSwitch
                ? (await Switcher.GetCandidatesAsync(user)).Where(c => c.Role == Roles.Trainer).ToList()
                : (await Users.GetTrainersAsync()).Select(t => new SwitchCandidate(t.Id, t.Email, t.Email, Roles.Trainer)).ToList();
            _solo = await Users.GetSoloModeAsync();
            // Profil „pracuję sam” ma też rolę administratora, więc na liście kandydatów figuruje jako administrator.
            if (_solo is { Enabled: true, TrainerId: { } sid } && _trainers.All(t => t.Id != sid))
                _trainers.Insert(0, new SwitchCandidate(sid, _solo.TrainerName ?? "", _solo.TrainerEmail ?? "", Roles.Trainer));
        }
        catch { _trainers = []; }
    }
}
