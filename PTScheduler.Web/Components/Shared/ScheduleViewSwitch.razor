@* Kalendarz i lista wizyt to dwa widoki tego samego grafiku — przełącznik zamiast dwóch pozycji w menu. *@
<nav class="svs" aria-label="Widok grafiku">
    <a class="@(Current == "calendar" ? "on" : "")" href="/calendar" aria-current="@(Current == "calendar" ? "page" : null)"><i class="bi bi-calendar3"></i>Kalendarz</a>
    <a class="@(Current == "list" ? "on" : "")" href="/sessions" aria-current="@(Current == "list" ? "page" : null)"><i class="bi bi-list-ul"></i>Lista</a>
</nav>

@code {
    [Parameter] public string Current { get; set; } = "calendar";
}
