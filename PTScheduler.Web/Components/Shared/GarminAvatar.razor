@* Znaczek zegarka Garmin na awatarze klienta (połączony zegarek) — trener widzi go wszędzie, gdzie jest awatar. *@
@if (Connected)
{
    <span class="gm-avatar">
        @ChildContent
        <span class="gm-dot" title="Połączony zegarek Garmin — gotowość i aktywności w karcie klienta" role="img" aria-label="Połączony zegarek Garmin"><i class="bi pt-ico-watch"></i></span>
    </span>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool Connected { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
