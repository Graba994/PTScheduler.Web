@* Przełącznik sylwetki na mapie mięśni (mężczyzna / kobieta). *@
<div class="mm-sex" role="group" aria-label="Sylwetka">
    <button type="button" class="@(Female ? "" : "on")" aria-pressed="@(Female ? "false" : "true")" title="Mężczyzna" @onclick="() => SetAsync(false)"><i class="bi bi-gender-male"></i></button>
    <button type="button" class="@(Female ? "on" : "")" aria-pressed="@(Female ? "true" : "false")" title="Kobieta" @onclick="() => SetAsync(true)"><i class="bi bi-gender-female"></i></button>
</div>

@code {
    [Parameter] public bool Female { get; set; }
    [Parameter] public EventCallback<bool> FemaleChanged { get; set; }

    private Task SetAsync(bool female) => female == Female ? Task.CompletedTask : FemaleChanged.InvokeAsync(female);
}
