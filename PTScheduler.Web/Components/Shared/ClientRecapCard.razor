@using PTScheduler.Application.Progress
@inject PTScheduler.Web.Services.ClientRecapService Recaps
@inject IJSRuntime JS

@* „Twój miesiąc” / „Twój rok” na pulpicie klienta: przez pierwsze dni miesiąca (w styczniu dłużej) —
   treningi, seria, rekordy, medale i krótki tekst asystenta pod marką trenera. *@
@if (_recap is { } r && (Preview || (_hiddenLoaded && !_hidden)))
{
    <section class="rcp-card" aria-label="@r.Result.Title">
        <div class="rcp-hero">
            @if (!Preview)
            {
                <button type="button" class="rcp-close" @onclick="HideAsync" aria-label="Zamknij podsumowanie" title="Zamknij — wróci za miesiąc z nowym podsumowaniem"><i class="bi bi-x-lg"></i></button>
            }
            <div class="rcp-kicker"><i class="bi @(r.IsYear ? "bi-stars" : "bi-calendar-heart")"></i>@r.Result.Subtitle</div>
            <h5 class="rcp-title">@r.Result.Title</h5>
        </div>
        <p class="rcp-text">@r.Text</p>
        <div class="rcp-tiles">
            @foreach (var t in r.Result.Tiles)
            {
                <div class="rcp-tile"><i class="bi @t.Icon"></i><b>@t.Value</b><span>@t.Label</span></div>
            }
        </div>
        @if (r.Result.Highlights.Count > 0)
        {
            <ul class="rcp-highlights">
                @foreach (var h in r.Result.Highlights)
                {
                    <li><i class="bi bi-star-fill"></i>@h</li>
                }
            </ul>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public int ClientId { get; set; }
    /// <summary>Podgląd trenera — karta widoczna każdego dnia, nie tylko na początku miesiąca.</summary>
    [Parameter] public bool Preview { get; set; }

    private PTScheduler.Web.Services.ClientRecapService.Recap? _recap;
    private int _loadedFor = -1;
    // Zamknięte podsumowanie znika do następnego okresu (zapamiętane w przeglądarce klienta).
    private bool _hidden;
    private bool _hiddenLoaded;

    private string HideKey => _recap is { } r ? $"pt-recap-hidden-{r.From:yyyyMM}{(r.IsYear ? "y" : "m")}" : "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_hiddenLoaded || _recap is null || Preview) return;
        try { _hidden = await JS.InvokeAsync<string?>("localStorage.getItem", HideKey) == "1"; }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { return; }
        _hiddenLoaded = true;
        StateHasChanged();
    }

    private async Task HideAsync()
    {
        _hidden = true;
        try { await JS.InvokeVoidAsync("localStorage.setItem", HideKey, "1"); }
        catch (JSException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ClientId) return;
        _loadedFor = ClientId;
        try { _recap = await Recaps.CurrentAsync(ClientId, anyDay: Preview); }
        catch (InvalidOperationException) { _recap = null; } // karta jest dodatkiem
    }
}
