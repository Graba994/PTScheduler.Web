@* Przycisk „Wstecz” jak w aplikacjach mobilnych: wraca do poprzedniej strony,
   a gdy jej nie ma (wejście z linku), przechodzi pod podany adres. *@
<a href="@Href" class="back-link @Class" onclick="if (history.length > 1 && document.referrer.startsWith(location.origin)) { history.back(); return false; }">
    <i class="bi bi-chevron-left"></i><span>@Label</span>
</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "/";
    [Parameter] public string Label { get; set; } = "Wstecz";
    [Parameter] public string? Class { get; set; }
}
