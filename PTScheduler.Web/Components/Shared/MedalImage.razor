@using PTScheduler.Application.Medals
@using PTScheduler.Domain.Rules
@* Medal jako obrazek SVG (data URI — każdy medal to osobny dokument, bez kolizji identyfikatorów gradientów). *@
<img class="medal-img @(Locked ? "locked" : "")" src="@MedalArt.DataUri(Medal, Style, Palette)" alt="@(Locked ? $"{Medal.Name} (jeszcze nie zdobyty)" : Medal.Name)" width="@Size" height="@Size" loading="lazy" />

@code {
    [Parameter, EditorRequired] public MedalRules.Medal Medal { get; set; } = default!;
    [Parameter, EditorRequired] public string Style { get; set; } = "klasyczny";
    [Parameter, EditorRequired] public MedalPalette Palette { get; set; } = default!;
    [Parameter] public bool Locked { get; set; }
    [Parameter] public int Size { get; set; } = 72;
}
