@* „Opłacone: gotówka / przelew” — odhaczenie płatności za trening spoza pakietu. *@
<div class="d-flex gap-2 flex-wrap">
    <button class="btn btn-sm btn-success flex-grow-1" @onclick='() => OnPaid.InvokeAsync("gotówka")' disabled="@Busy"><i class="bi bi-cash me-1"></i>Opłacone gotówką</button>
    <button class="btn btn-sm btn-outline-success flex-grow-1" @onclick='() => OnPaid.InvokeAsync("przelew")' disabled="@Busy"><i class="bi bi-bank me-1"></i>Opłacone przelewem</button>
</div>

@code {
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> OnPaid { get; set; }
}
