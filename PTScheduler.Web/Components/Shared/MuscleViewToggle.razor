@* Widok mapy mięśni: ogólny (17 partii) albo szczegółowy (aktony barków, skośne brzucha…). *@
<div class="mm-view-toggle" role="group" aria-label="Widok mięśni">
    <button type="button" class="@(Detailed ? "" : "on")" aria-pressed="@(Detailed ? "false" : "true")" @onclick="() => SetAsync(false)">Ogólnie</button>
    <button type="button" class="@(Detailed ? "on" : "")" aria-pressed="@(Detailed ? "true" : "false")" @onclick="() => SetAsync(true)">Szczegółowo</button>
</div>

@code {
    [Parameter] public bool Detailed { get; set; }
    [Parameter] public EventCallback<bool> DetailedChanged { get; set; }

    private Task SetAsync(bool detailed) => detailed == Detailed ? Task.CompletedTask : DetailedChanged.InvokeAsync(detailed);
}
