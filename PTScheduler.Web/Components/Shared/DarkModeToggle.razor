@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="theme-pill-wrap" title="@(_dark ? "Przełącz na tryb jasny" : "Przełącz na tryb ciemny")">
    <button class="theme-pill-btn @(_dark ? "" : "active")" @onclick="ToggleAsync" aria-label="Tryb jasny">
        <i class="bi bi-sun-fill"></i>
    </button>
    <button class="theme-pill-btn @(_dark ? "active" : "")" @onclick="ToggleAsync" aria-label="Tryb ciemny">
        <i class="bi bi-moon-stars-fill"></i>
    </button>
</div>

<style>
    .theme-pill-wrap {
        display: flex;
        align-items: center;
        background: var(--bs-secondary-bg, rgba(0,0,0,.06));
        border-radius: 99px;
        padding: 3px;
        gap: 2px;
        border: 1px solid var(--bs-border-color, rgba(0,0,0,.08));
    }
    .theme-pill-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 99px;
        border: none;
        background: transparent;
        color: var(--bs-secondary-color, #94a3b8);
        font-size: .9rem;
        cursor: pointer;
        transition: background .18s ease, color .18s ease, transform .15s ease;
        line-height: 1;
    }
    .theme-pill-btn:hover {
        color: var(--c-primary, #0284c7);
    }
    .theme-pill-btn.active {
        background: var(--c-primary, #0284c7);
        color: #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,.18);
        transform: scale(1.05);
    }
</style>

@code {
    private bool _dark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _dark = await JS.InvokeAsync<bool>("PTTheme.isDark");
            StateHasChanged();
        }
        catch { }
    }

    private async Task ToggleAsync()
    {
        try { _dark = await JS.InvokeAsync<bool>("PTTheme.toggle"); }
        catch { }
    }
}
