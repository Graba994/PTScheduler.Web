@using PTScheduler.Application.Interfaces
@inject IBunnyService Bunny

@if (!string.IsNullOrWhiteSpace(_src))
{
    <div class="ratio ratio-16x9">
        <iframe src="@_src"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
                style="border:0;border-radius:12px"></iframe>
    </div>
}
else if (ShowPlaceholder)
{
    <div class="ratio ratio-16x9 d-flex align-items-center justify-content-center bg-body-secondary rounded text-muted">
        <span><i class="bi bi-camera-video-off me-1"></i>Brak wideo</span>
    </div>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? BunnyVideoId { get; set; }
    [Parameter] public bool ShowPlaceholder { get; set; } = true;

    private string? _src;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(BunnyVideoId))
        {
            var s = await Bunny.GetSettingsAsync();
            if (!string.IsNullOrEmpty(s.LibraryId))
            {
                _src = $"https://iframe.mediadelivery.net/embed/{s.LibraryId}/{BunnyVideoId}";
                return;
            }
        }
        _src = VideoEmbed.ToEmbed(Url);
    }
}
